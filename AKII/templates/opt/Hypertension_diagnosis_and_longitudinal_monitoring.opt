bute_name>protocol</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>ITEM_TREE</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id>at0005</node_id><attributes xsi:type="C_MULTIPLE_ATTRIBUTE"><rm_attribute_name>items</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>ELEMENT</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></occurrences><node_id>at0006</node_id><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>value</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>DV_DATE_TIME</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id/></children></attributes></children><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>CLUSTER</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>0</upper></occurrences><node_id>at0019</node_id></children><cardinality><is_ordered>false</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></interval></cardinality></attributes></children></attributes><archetype_id><value>openEHR-EHR-EVALUATION.medication_summary.v1</value></archetype_id><term_definitions code="at0000"><items id="description">Summary or persistent information about the use of a single medication or group of medications, especially where the pattern of use or cumulative dosage needs to be monitored.</items><items id="text">Medication summary</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0002"><items id="comment">The medication name can be represented as a generic substance, trade name or a group or class of medications. Coding of 'Medication name' with a terminology capable of triggering decision support is strongly recommended where possible. Free text entry should only be used if there is no appropriate terminology available. For example: 'Adriamycin'; 'doxorubicin' or 'anthracyclines'; 'Fosamax', 'alendronate' or 'bisphosphanates'.</items><items id="description">Name of medication or group of medications.</items><items id="text">Medication name</items></term_definitions><term_definitions code="at0005"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0006"><items id="description">The date this medication summary was last updated.</items><items id="text">Last updated</items></term_definitions><term_definitions code="at0007"><items id="comment">For example: "Used between 1996 and 2001 against osteoporosis. Ceased after five years of use to minimise risk of adverse effects."</items><items id="description">Narrative description about the overall use of the medication.</items><items id="text">Clinical description</items></term_definitions><term_definitions code="at0008"><items id="comment">Triggers for closing one episode and commencing a new one can include: &#13;
- a change in dose; &#13;
- or a significant change in the pattern of use</items><items id="description">Details about use of the medication during a specified period of time.</items><items id="text">Episode</items></term_definitions><term_definitions code="at0009"><items id="comment">Can be a partial date, for example, only a year.</items><items id="description">The date when the medication was first administered.</items><items id="text">Onset of use</items></term_definitions><term_definitions code="at0010"><items id="comment">Can be a partial date, for example, only a year.</items><items id="description">The date when the medication was last administered.</items><items id="text">Cessation of use</items></term_definitions><term_definitions code="at0011"><items id="comment">Can be a partial date, for example, only a year.</items><items id="description">The date of the first administration of the medication for this episode.</items><items id="text">Episode onset</items></term_definitions><term_definitions code="at0012"><items id="comment">Can be a partial date, for example, only a year.</items><items id="description">The date of the last administration of the medication for this episode.</items><items id="text">Episode cessation</items></term_definitions><term_definitions code="at0013"><items id="comment">Coding with an external terminology is preferred, where possible. For example: sub-optimal control of diabetes; adverse reaction; or high cost.</items><items id="description">The reason why use of the medication was stopped.</items><items id="text">Episode reason for cessation</items></term_definitions><term_definitions code="at0014"><items id="description">Narrative description about the use of the medication during this episode.</items><items id="text">Description</items></term_definitions><term_definitions code="at0015"><items id="comment">For example: monitoring of the cumulative dose of doxorubicin.&#13;
May be manually calculated or derived via the EHR from multiple sources.&#13;
&#13;
</items><items id="description">Total amount of the medication used over the lifetime of the individual.</items><items id="text">Cumulative dose</items></term_definitions><term_definitions code="at0016"><items id="description">Cumulative dose of the medication used in this episode.</items><items id="text">Episode amount</items></term_definitions><term_definitions code="at0018"><items id="comment">This element and the root level 'Clinical indication' element can potentially be in conflict with each other. In those situations, this element takes precedence over 'Clinical indication' for this episode.&#13;
Coding with an external terminology is preferred, where possible. &#13;
For example: 'Cancer therapy' or 'rheumatoid arthritis for osteoporosis'.</items><items id="description">The clinical indication for the use of the medication during this episode, particularly if this is more specific or differs from the 'Clinical indication', or there is no clinical indication that applies for all episodes.</items><items id="text">Episode indication</items></term_definitions><term_definitions code="at0019"><items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items><items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items><items id="text">Extension</items></term_definitions><term_definitions code="at0020"><items id="comment">Coding with an external terminology, where possible. For example: pain relief; palliative or curative; short term course or life-long antibiotics.</items><items id="description">The therapeutic intent for use of the medication during this episode.</items><items id="text">Therapeutic intent</items></term_definitions><term_definitions code="at0022"><items id="comment">Coding with an external terminology is preferred, where possible. For example: UTI resolved</items><items id="description">The observed response to the treatment with this medication during this episode.</items><items id="text">Therapeutic response</items></term_definitions><term_definitions code="at0027"><items id="comment">May be manually calculated or derived via the EHR from multiple sources.</items><items id="description">The sum of the duration of all episodes.</items><items id="text">Cumulative duration</items></term_definitions><term_definitions code="at0028"><items id="comment">Coding with an external terminology is preferred, where possible. For example: 'Osteoporosis'.</items><items id="description">The overall clinical indication for the use of the medication.</items><items id="text">Clinical indication</items></term_definitions><term_definitions code="at0029"><items id="description">Additional details about medication use during this episode.</items><items id="text">Additional details</items></term_definitions><term_definitions code="at0030"><items id="comment">Coding with an external terminology is preferred, where possible. For example: sub-optimal control of diabetes; adverse reaction; or high cost.</items><items id="description">The reason why all use of the medication was stopped.</items><items id="text">Reason for cessation</items></term_definitions><term_definitions code="at0031"><items id="comment">If 'Episode onset' and 'Episode cessation' are used in systems, this data element may be calculated, or alternatively, be considered redundant in this scenario.</items><items id="description">The duration of the use of the medication in this episode.</items><items id="text">Episode duration</items></term_definitions><term_definitions code="at0032"><items id="comment">For example: 'oral', 'intravenous', or 'topical'. Coding of the route with a terminology is preferred, where possible.</items><items id="description">The route by which the ordered item was, administed during this episode.</items><items id="text">Route</items></term_definitions></children><children xsi:type="C_ARCHETYPE_ROOT"><rm_type_name>EVALUATION</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id>at0000</node_id><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>data</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>ITEM_TREE</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id>at0001</node_id><attributes xsi:type="C_MULTIPLE_ATTRIBUTE"><rm_attribute_name>items</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>ELEMENT</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id>at0002</node_id><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>value</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>DV_TEXT</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id/></children></attributes></children><cardinality><is_ordered>true</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>1</lower></interval></cardinality></attributes></children></attributes><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>protocol</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>ITEM_TREE</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id>at0003</node_id><attributes xsi:type="C_MULTIPLE_ATTRIBUTE"><rm_attribute_name>items</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>CLUSTER</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>0</upper></occurrences><node_id>at0004</node_id></children><cardinality><is_ordered>false</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></interval></cardinality></attributes></children></attributes><archetype_id><value>openEHR-EHR-EVALUATION.clinical_synopsis.v1</value></archetype_id><term_definitions code="at0000"><items id="description">Narrative summary or overview about a patient, specifically from the perspective of a healthcare provider, and with or without associated interpretations.</items><items id="text">Clinical synopsis</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">List</items></term_definitions><term_definitions code="at0002"><items id="description">The summary, assessment, conclusions or evaluation of the clinical findings.</items><items id="text">Synopsis</items></term_definitions><term_definitions code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0004"><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></term_definitions></children><cardinality><is_ordered>true</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></interval></cardinality></attributes><archetype_id><value>openEHR-EHR-COMPOSITION.encounter.v1</value></archetype_id><term_definitions code="at0000"><items id="description">Interaction, contact or care event between a subject of care and healthcare provider(s).</items><items id="text">Encounter</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0002"><items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items><items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items><items id="text">Extension</items></term_definitions></definition><ontology archetype_id="openEHR-EHR-COMPOSITION.encounter.v1"><term_definitions language="ar-sy"><items code="at0000"><items id="description">*Interaction, contact or care event between a subject of care and healthcare provider(s).(en)</items><items id="text">*Encounter(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="description">Interacció, contacte o esdeveniment d’atenció entre un pacient i un o més professionals d'atenció sanitària.</items><items id="text">Encontre</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensió</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="description">Interaktion, Kontakt oder Versorgungsereignis, zwischen einem Versorgungsempfänger und einem Gesundheitsdienstleister.</items><items id="text">Kontakt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Erweiterung</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">Interaction, contact or care event between a subject of care and healthcare provider(s).</items><items id="text">Encounter</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items><items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items><items id="text">Extension</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="description">Interacción, contacto o evento de cuidado entre un paciente y un proveedor de salud.</items><items id="text">Encuentro</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensión</items></items></term_definitions><term_definitions language="es-ar"><items code="at0000"><items id="description">Interacción, contacto o evento de cuidados entre un sujeto de cuidados y uno o más proveedores de cuidados de la salud.</items><items id="text">Encuentro</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensión</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="description">Hoitohenkilön ja terveydenhuollon tarjoajan välinen vuorovaikutus, kontakti- tai hoitotapahtuma.</items><items id="text">Kontakti</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Laajennus</items></items></term_definitions><term_definitions language="fr"><items code="at0000"><items id="description">Interaction, contact ou événement de soins entre un sujet de soins et un ou des prestataires de soins.</items><items id="text">Rencontre</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extension</items></items></term_definitions><term_definitions language="it"><items code="at0000"><items id="description">Interazione, contatto o evento di cura tra un soggetto di cura e il/i fornitore/i di assistenza sanitaria.</items><items id="text">Contatto</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Estensione</items></items></term_definitions><term_definitions language="ko"><items code="at0000"><items id="description">*Interaction, contact or care event between a subject of care and healthcare provider(s).(en)</items><items id="text">*Encounter(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">Interaksjon, kontakt eller omsorgshendelse mellom et individ og helsepersonell.</items><items id="text">Klinisk kontakt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Utvidelse</items></items></term_definitions><term_definitions language="nl"><items code="at0000"><items id="description">Interactie, contact of zorggebeurtenis tussen een onderwerp van zorg en zorgverlener(s).</items><items id="text">Contact</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensie</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="description">Interação, contato ou cuidado entre o sujeito do cuidado e profissional(is) de saúde.</items><items id="text">Encontro</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensão</items></items></term_definitions><term_definitions language="pt-pt"><items code="at0000"><items id="description">Interação, contato ou evento de cuidados entre um sujeito e um provedor de saúde.</items><items id="text">Encontro</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensão</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="description">Kontakt mellan patient och vårdgivare, eller vårdhändelse inom hälso- och sjukvården.</items><items id="text">Vårdkontakt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items><items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="text">Tilläggsinformation</items></items></term_definitions></ontology><component_ontologies archetype_id="openEHR-EHR-EVALUATION.clinical_synopsis.v1"><term_definitions language="ar-sy"><items code="at0000"><items id="description">ملخص بالرواية أو نظرة عامة عن المريض, خاصة من وجهة نظر مقدم الخدمة الصحية, مع إرفاق أو عدم إرفاق تفسيرات </items><items id="text">المختصر السريري</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*List(en)</items></items><items code="at0002"><items id="description">الملخص, التقييم, الاستنتاجات أو التقييم للموجودات السريرية</items><items id="text">المختصر</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0004"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="description">Informe o resum narratiu sobre un pacient, específicament des de la perspectiva d'un professional d’atenció sanitària, i amb o sense interpretacions associades.</items><items id="text">Sinopsi clínica</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0002"><items id="description">El resum, l'avaluació, les conclusions o l'avaluació dels resultats clínics.</items><items id="text">Sinopsi</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="comment">Per exemple: requisits locals d'informació o metadades addicionals per alinear-se amb equivalents de FHIR o CIMI.</items><items id="description">Informació addicional necessària per a expandir el model amb el contingut local o per alinear-se amb altres models/formalismes de referència.</items><items id="text">Extensió</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="description">Zusammenfassung oder Übersicht einer Patientengeschichte, speziell aus der Sicht eines Gesundheitsdienstleisters, evtl. mit dazugehörigen Interpretationen.</items><items id="text">Klinische Synopsis</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*List(en)</items></items><items code="at0002"><items id="description">Die Zusammenfassung, Beurteilung, Aussagen or Auswertung des klinischen Befunds.</items><items id="text">Synopsis</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0004"><items id="comment">Zum Beispiel: lokale Informationsanforderungen oder zusätzliche Metadaten zur Anpassung an FHIR oder CIMI-Äquivalente.</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle / Formalismen.&#13;
</items><items id="text">Erweiterung</items></items></term_definitions><term_definitions language="el"><items code="at0000"><items id="description">Αφηγηματική περίληψη ή επισκόπηση σχετικά με έναν ασθενή, ειδικά από την οπτική γωνία ενός παρόχου υγειονομικής περίθαλψης και με ή χωρίς σχετικές ερμηνείες.</items><items id="text">Κλινική σύνοψη</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0002"><items id="description">Η περίληψη, η αξιολόγηση, τα συμπεράσματα ή η αξιολόγηση των κλινικών ευρημάτων.</items><items id="text">Σύνοψη</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="comment">Για παράδειγμα: απαιτήσεις τοπικών πληροφοριών ή πρόσθετα μεταδεδομένα για ευθυγράμμιση με ισοδύναμα FHIR ή CIMI.</items><items id="description">Πρόσθετες πληροφορίες που απαιτούνται για την καταγραφή τοπικού περιεχομένου ή για την ευθυγράμμιση με άλλα μοντέλα αναφοράς/φορμαλισμούς.</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">Narrative summary or overview about a patient, specifically from the perspective of a healthcare provider, and with or without associated interpretations.</items><items id="text">Clinical synopsis</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0002"><items id="description">The summary, assessment, conclusions or evaluation of the clinical findings.</items><items id="text">Synopsis</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="description">Resumen narrativo o visión general sobre un paciente, específicamente desde la perspectiva de un profesional sanitario, y con o sin interpretaciones asociadas.</items><items id="text">Sinopsis clínica</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0002"><items id="description">El resumen, la valoración, las conclusiones o la evaluación de los hallazgos clínicos.</items><items id="text">Sinopsis</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="comment">Por ejemplo: requisitos locales de información o metadatos adicionales para alinearse con los equivalentes de FHIR o CIMI.</items><items id="description">Información adicional necesaria para captar el contenido local o para alinearse con otros modelos/formalismos de referencia.</items><items id="text">Extensión</items></items></term_definitions><term_definitions language="es-ar"><items code="at0000"><items id="description">Sumario narrativo o visión global acerca de un paciente, específicamente desde la perspectiva de un profesional del cuidado de la salud, con o sin interpretaciones asociadas.</items><items id="text">Sinopsis Clínica</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*List(en)</items></items><items code="at0002"><items id="description">El sumario, la impresión diagnóstica y las conclusiones sobre los hallazgos clínicos.</items><items id="text">Sinopsis</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0004"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="fa"><items code="at0000"><items id="description">خلاصه یا مروری تشریحی دربازه بیمار بویژه از نظز ارایه کننده مراقبت بهداشتی با یا بدون تفسیرهای مربوطه </items><items id="text">خلاصه بالینی</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*List(en)</items></items><items code="at0002"><items id="description">خلاصه ، ارزیابی ، نتیجه ، یا ارزشیابی یافته های بالینی</items><items id="text">خلاصه</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0004"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="fr"><items code="at0000"><items id="description">Résumé narratif ou aperçu concernant un patient, spécifiquement du point de vue d'un professionnel de santé, accompagné ou non d'interprétations associées.</items><items id="text">Synthèse clinique</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0002"><items id="description">Le résumé, l'appréciation, les conclusions ou l'évaluation des résultats cliniques.</items><items id="text">Synthèse</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="comment">Par exemple: exigences d’information locales ou métadonnées supplémentaires permettant l’alignement avec des équivalents FHIR ou CIMI.</items><items id="description">Informations supplémentaires nécessaires pour représenter un contenu local ou pour assurer l’alignement avec d’autres modèles de référence ou formalismes.</items><items id="text">Extension</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">Fritekstsammendrag eller oversikt om en pasient fra helsepersonellets perspektiv, med eller uten tilhørende fortolkninger.</items><items id="text">Klinisk sammendrag</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0002"><items id="description">Oppsummering, vurdering, konklusjoner eller evaluering av de kliniske funnene.</items><items id="text">Sammendrag</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="description">Resumo narrativo ou visão geral sobre um paciente, especificamente a partir da perspectiva de um profissional de saúde, e com ou sem interpretações associadas.</items><items id="text">Sinopse Clínica</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*List(en)</items></items><items code="at0002"><items id="description">O sumário, a avaliação, conclusões ou avaliação dos achados clínicos.</items><items id="text">Sinopse</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0004"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="description">Beskrivande sammanfattning eller överblick av en patient, särskilt ur vårdgivarens perspektiv, med eller utan associerade tolkningar.</items><items id="text">Klinisk synopsis</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0002"><items id="description">Sammanfattning, bedömning, slutsatser eller utvärderingar av de kliniska fynden.</items><items id="text">Synopsis</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="zh-cn"><items code="at0000"><items id="description">从医疗保健服务提供着的角度，手工综合并记录关于患者的叙述型摘要或概述，且带有或没有相关联的解释。</items><items id="text">临床提要</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*List(en)</items></items><items code="at0002"><items id="description">对于临床所见（临床发现）进行的概括、评估、总结或评价。</items><items id="text">提要</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0004"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-EVALUATION.medication_summary.v1"><term_definitions language="de"><items code="at0000"><items id="description">Zusammenfassende oder dauerhafte Informationen über die Anwendung eines einzelnen Medikaments oder einer Medikamentengruppe oder -klasse, insbesondere wenn das Anwendungsmuster oder die kumulative Dosierung überwacht werden muss.</items><items id="text">Zusammenfassung der Medikation</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">Der Medikamentenname kann als generische Substanz, Handelsname oder eine Medikamentengruppe oder -klasse dargestellt werden. Die Codierung des „Name des Medikaments“ mit einer Terminologie, die eine Entscheidungsunterstützung auslösen kann, wird nach Möglichkeit dringend empfohlen. Die Freitexteingabe sollte nur verwendet werden, wenn keine passende Terminologie vorhanden ist. Zum Beispiel: „Adriamycin“, „Doxorubicin“ oder „Anthracycline“, „Fosamax“, „Alendronat“ oder „Bisphosphanate“.</items><items id="description">Name des Medikaments oder der Medikamentengruppe.</items><items id="text">Name des Medikaments</items></items><items code="at0005"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0006"><items id="description">Das Datum der letzten Aktualisierung der Zusammenfassung der Medikation.</items><items id="text">Datum der letzten Aktualisierung</items></items><items code="at0007"><items id="comment">Zum Beispiel: „Zwischen 1996 und 2001 gegen Osteoporose eingesetzt. Nach fünfjähriger Anwendung eingestellt, um das Risiko von Nebenwirkungen zu minimieren.“</items><items id="description">Einfache Beschreibung über die allgemeine Anrwendung des Medikaments.</items><items id="text">Klinische Beschreibung</items></items><items code="at0008"><items id="comment">Auslöser für das Beenden einer Episode und das Beginnen einer neuen können sein:&#13;
- eine Dosisänderung,&#13;
- oder eine wesentliche Änderung des Anwendungsmusters.</items><items id="description">Details zur Anwendung des Medikaments während eines bestimmten Zeitraums.</items><items id="text">Anwendungszeitraum</items></items><items code="at0009"><items id="comment">Kann ein Teildatum sein, zum Beispiel nur ein Jahr.</items><items id="description">Das Datum, an dem das Medikament zum ersten Mal verabreicht wurde.</items><items id="text">Beginn der Anwendung</items></items><items code="at0010"><items id="comment">Kann ein Teildatum sein, zum Beispiel nur ein Jahr.</items><items id="description">Das Datum, an dem das Medikament zuletzt verabreicht wurde.</items><items id="text">Ende der Anwendung</items></items><items code="at0011"><items id="comment">Kann ein Teildatum sein, zum Beispiel nur ein Jahr.</items><items id="description">Das Datum der ersten Verabreichung des Medikaments für diese Episode.</items><items id="text">Beginn des Anwendungszeitraums</items></items><items code="at0012"><items id="comment">Kann ein Teildatum sein, zum Beispiel nur ein Jahr.</items><items id="description">Das Datum der letzten Verabreichung des Medikaments für diese Episode.</items><items id="text">Ende des Anwendungszeitraums</items></items><items code="at0013"><items id="comment">Wenn möglich, wird die Codierung mit einer externen Terminologie bevorzugt. Zum Beispiel: suboptimale Kontrolle von Diabetes; Nebenwirkung oder hohe Kosten.</items><items id="description">Der Grund, warum die Anwendung des Medikaments beendet wurde.</items><items id="text">Grund für das Ende des Anwendungszeitraums</items></items><items code="at0014"><items id="description">Einfache Beschreibung der Anwendung des Medikaments während des definierten Anwendungszeitraums.</items><items id="text">Beschreibung</items></items><items code="at0015"><items id="comment">Zum Beispiel: Überwachung der kumulativen Dosis von Doxorubicin.&#13;
Kann manuell berechnet oder über die EHR aus mehreren Quellen abgeleitet werden.</items><items id="description">Gesamtmenge des über die Lebenszeit der Person angewendeten Medikaments.</items><items id="text">Kumulative Dosis</items></items><items code="at0016"><items id="description">Kumulative Dosis des in dieser Episode verwendeten Medikaments.</items><items id="text">Menge im Anwendungszeitraum</items></items><items code="at0018"><items id="comment">Möglicherweise können dieses Element und das Element auf dem Grundlevel „Klinische Indikation“ miteinander in Konflikt stehen. In diesen Situationen hat dieses Element den Vorrang vor der „Klinischen Indikation“ für diese Episode.&#13;
Wenn möglich, wird die Kodierung mit einer externen Terminologie bevorzugt. Zum Beispiel: „Krebstherapie“ oder „rheumatoide Arthritis bei Osteoporose“.</items><items id="description">Die klinische Indikation für die Anwendung des Medikaments in dem Anwendungszeitraum, insbesondere wenn dieser spezifischer ist oder von der „Klinischen Indikation“ abweicht oder es keine klinische Indikation gibt, die für alle Anwendungszeiträume gilt.</items><items id="text">Indikation für den Anwendungszeitraum</items></items><items code="at0019"><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen.</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="text">Erweiterung</items></items><items code="at0020"><items id="comment">Codierung mit einer externen Terminologie, soweit möglich wird empfohlen. Zum Beispiel: Schmerzlinderung; palliativ oder kurativ; Kurzzeitkurs oder lebenslange Antibiotika.&#13;
	&#13;
&#13;
</items><items id="description">Die therapeutische Absicht für die Anrwendung des Medikaments in diesem Anwendungszeitraum.</items><items id="text">Therapeutische Intention</items></items><items code="at0022"><items id="comment">Wenn möglich, wird die Codierung mit einer externen Terminologie bevorzugt. Zum Beispiel: HWI behoben.</items><items id="description">Das beobachtete Ansprechen der Person auf die Behandlung mit diesem Medikament während des Anwendungszeitraums.</items><items id="text">Therapeutisches Ansprechen</items></items><items code="at0027"><items id="comment">Kann manuell berechnet oder über die EHR aus mehreren Quellen abgeleitet werden.</items><items id="description">Die Gesamtdauer über alle Anwendungszeiträume.</items><items id="text">Kumulative Dauer</items></items><items code="at0028"><items id="comment">Wenn möglich, wird die Codierung mit einer externen Terminologie bevorzugt. Zum Beispiel: „Osteoporose“.</items><items id="description">Die allgemeine klinische Indikation für die Anrwendung des Medikaments.</items><items id="text">Klinische Indikation</items></items><items code="at0029"><items id="description">Zusätzliche Angaben zur Anwendung des Medikaments innerhalb des Anwendungszeitraums.</items><items id="text">Zusätzliche Angaben</items></items><items code="at0030"><items id="comment">Wenn möglich, wird die Codierung mit einer externen Terminologie bevorzugt. Zum Beispiel: suboptimale Kontrolle von Diabetes; Nebenwirkung oder hohe Kosten.</items><items id="description">Der Grund, warum die Anwendung des Medikaments eingestellt wurde.</items><items id="text">Grund für das Ende</items></items><items code="at0031"><items id="comment">Wenn die Elemente „Beginn des Anwendungszeitraums“ und „Ende des Anwendungszeitraums“ in Systemen verwendet werden, kann dieses Datenelement in diesem Szenario berechnet oder alternativ als redundant betrachtet werden.</items><items id="description">Die Dauer der Anwendung des Medikaments in dieser Episode.</items><items id="text">Dauer des Anwendungszeitraums</items></items><items code="at0032"><items id="comment">Zum Beispiel: „oral“, „intravenös“ oder „topisch“. Wenn möglich, ist eine Kodierung des Verabreichungswegs mit einer Terminologie vorzuziehen.</items><items id="description">Der Verabreichungsweg des Medikamentes während dieses Anwendungszeitraumes.</items><items id="text">Verabreichungsweg</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">Summary or persistent information about the use of a single medication or group of medications, especially where the pattern of use or cumulative dosage needs to be monitored.</items><items id="text">Medication summary</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">The medication name can be represented as a generic substance, trade name or a group or class of medications. Coding of 'Medication name' with a terminology capable of triggering decision support is strongly recommended where possible. Free text entry should only be used if there is no appropriate terminology available. For example: 'Adriamycin'; 'doxorubicin' or 'anthracyclines'; 'Fosamax', 'alendronate' or 'bisphosphanates'.</items><items id="description">Name of medication or group of medications.</items><items id="text">Medication name</items></items><items code="at0005"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0006"><items id="description">The date this medication summary was last updated.</items><items id="text">Last updated</items></items><items code="at0007"><items id="comment">For example: "Used between 1996 and 2001 against osteoporosis. Ceased after five years of use to minimise risk of adverse effects."</items><items id="description">Narrative description about the overall use of the medication.</items><items id="text">Clinical description</items></items><items code="at0008"><items id="comment">Triggers for closing one episode and commencing a new one can include: &#13;
- a change in dose; &#13;
- or a significant change in the pattern of use</items><items id="description">Details about use of the medication during a specified period of time.</items><items id="text">Episode</items></items><items code="at0009"><items id="comment">Can be a partial date, for example, only a year.</items><items id="description">The date when the medication was first administered.</items><items id="text">Onset of use</items></items><items code="at0010"><items id="comment">Can be a partial date, for example, only a year.</items><items id="description">The date when the medication was last administered.</items><items id="text">Cessation of use</items></items><items code="at0011"><items id="comment">Can be a partial date, for example, only a year.</items><items id="description">The date of the first administration of the medication for this episode.</items><items id="text">Episode onset</items></items><items code="at0012"><items id="comment">Can be a partial date, for example, only a year.</items><items id="description">The date of the last administration of the medication for this episode.</items><items id="text">Episode cessation</items></items><items code="at0013"><items id="comment">Coding with an external terminology is preferred, where possible. For example: sub-optimal control of diabetes; adverse reaction; or high cost.</items><items id="description">The reason why use of the medication was stopped.</items><items id="text">Episode reason for cessation</items></items><items code="at0014"><items id="description">Narrative description about the use of the medication during this episode.</items><items id="text">Description</items></items><items code="at0015"><items id="comment">For example: monitoring of the cumulative dose of doxorubicin.&#13;
May be manually calculated or derived via the EHR from multiple sources.&#13;
&#13;
</items><items id="description">Total amount of the medication used over the lifetime of the individual.</items><items id="text">Cumulative dose</items></items><items code="at0016"><items id="description">Cumulative dose of the medication used in this episode.</items><items id="text">Episode amount</items></items><items code="at0018"><items id="comment">This element and the root level 'Clinical indication' element can potentially be in conflict with each other. In those situations, this element takes precedence over 'Clinical indication' for this episode.&#13;
Coding with an external terminology is preferred, where possible. &#13;
For example: 'Cancer therapy' or 'rheumatoid arthritis for osteoporosis'.</items><items id="description">The clinical indication for the use of the medication during this episode, particularly if this is more specific or differs from the 'Clinical indication', or there is no clinical indication that applies for all episodes.</items><items id="text">Episode indication</items></items><items code="at0019"><items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items><items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items><items id="text">Extension</items></items><items code="at0020"><items id="comment">Coding with an external terminology, where possible. For example: pain relief; palliative or curative; short term course or life-long antibiotics.</items><items id="description">The therapeutic intent for use of the medication during this episode.</items><items id="text">Therapeutic intent</items></items><items code="at0022"><items id="comment">Coding with an external terminology is preferred, where possible. For example: UTI resolved</items><items id="description">The observed response to the treatment with this medication during this episode.</items><items id="text">Therapeutic response</items></items><items code="at0027"><items id="comment">May be manually calculated or derived via the EHR from multiple sources.</items><items id="description">The sum of the duration of all episodes.</items><items id="text">Cumulative duration</items></items><items code="at0028"><items id="comment">Coding with an external terminology is preferred, where possible. For example: 'Osteoporosis'.</items><items id="description">The overall clinical indication for the use of the medication.</items><items id="text">Clinical indication</items></items><items code="at0029"><items id="description">Additional details about medication use during this episode.</items><items id="text">Additional details</items></items><items code="at0030"><items id="comment">Coding with an external terminology is preferred, where possible. For example: sub-optimal control of diabetes; adverse reaction; or high cost.</items><items id="description">The reason why all use of the medication was stopped.</items><items id="text">Reason for cessation</items></items><items code="at0031"><items id="comment">If 'Episode onset' and 'Episode cessation' are used in systems, this data element may be calculated, or alternatively, be considered redundant in this scenario.</items><items id="description">The duration of the use of the medication in this episode.</items><items id="text">Episode duration</items></items><items code="at0032"><items id="comment">For example: 'oral', 'intravenous', or 'topical'. Coding of the route with a terminology is preferred, where possible.</items><items id="description">The route by which the ordered item was, administed during this episode.</items><items id="text">Route</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">Sammendrag eller varig (persistent) informasjon om all bruk av ett spesifisert legemiddel, gruppe eller klasse av legemidler, spesielt der bruksmønsteret eller kumulativ mengde må overvåkes.</items><items id="text">Legemiddelsammendrag</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">Navn på legemiddel kan representeres som en generisk substans, handelsnavn, gruppe eller klasse av legemidler. Det anbefales å kode "Navn på legemiddel" med en terminologi om mulig, slik at det kan brukes for eksempel i beslutningsstøtte. Fritekst bør bare benyttes der det ikke finnes en passende terminologi.&#13;
For eksempel: '"Adriamycin"; "doxorubicin" eller "anthracycliner"; "Fosamax", "alendronsyre" eller "bifosonater".</items><items id="description">Navn på legemiddel eller gruppe av legemidler.</items><items id="text">Navn på legemiddel</items></items><items code="at0005"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0006"><items id="description">Datoen da legemiddelsammendraget sist ble oppdatert.</items><items id="text">Sist oppdatert</items></items><items code="at0007"><items id="comment">For eksempel: "Brukt i perioden mellom 1996 og 2001 mot osteoporose, avsluttet etter fem år for å redusere risikoen for bivirkninger."</items><items id="description">Fritekstbeskrivelse om den overordnede bruken av legemiddelet.</items><items id="text">Klinisk beskrivelse</items></items><items code="at0008"><items id="comment">Triggere for å lukke en episode og starte en ny kan være en endring av dosering, eller en betydelig endring i bruksmønster.</items><items id="description">Detaljer om bruken av legemiddelet i en spesifisert tidsperiode.</items><items id="text">Periode</items></items><items code="at0009"><items id="comment">Kan være en deldato, for eksempel kun årstall.</items><items id="description">Datoen da legemiddelet først ble administrert.</items><items id="text">Startdato for bruk</items></items><items code="at0010"><items id="comment">Kan være en deldato, for eksempel kun årstall.</items><items id="description">Datoen da legemiddelet sist ble administrert.</items><items id="text">Sluttdato for bruk</items></items><items code="at0011"><items id="comment">Kan være en deldato, for eksempel kun årstall.</items><items id="description">Datoen da legemiddelet først ble administrert i denne perioden.</items><items id="text">Periodens startdato</items></items><items code="at0012"><items id="comment">Kan være en deldato, for eksempel kun årstall.</items><items id="description">Datoen da legemiddelet sist ble administrert i denne perioden.</items><items id="text">Periodens sluttdato</items></items><items code="at0013"><items id="comment">Koding med en terminologi foretrekkes, der det er mulig. For eksempel: Dårlig kontrollert diabetes, overfølsomhetsreaksjoner eller høye kostnader.</items><items id="description">Årsak til at bruken av legemiddelet ble avsluttet i denne perioden.</items><items id="text">Periodens årsak til seponering</items></items><items code="at0014"><items id="description">Fritekstbeskrivelse om bruken av legemiddelet i denne perioden.</items><items id="text">Beskrivelse</items></items><items code="at0015"><items id="comment">For eksempel: monitorering av kumulativ mengde av doxorubicin.&#13;
Kan regnes ut manuelt eller utledes via ulike kilder, som for eksempel kurvesystemet eller andre deler av den elektroniske pasientjournalen.</items><items id="description">Samlet mengde av legemiddelet brukt over individets livstid.</items><items id="text">Kumulativ mengde</items></items><items code="at0016"><items id="description">Kumulativ mengde brukt av legemiddelet i denne perioden.</items><items id="text">Mengde i perioden</items></items><items code="at0018"><items id="comment">Dette dataelementet og dataelementet "Klinisk indikasjon" på arketypens toppnivå, kan potensielt komme i konflikt med hverandre. I disse tilfellene vil dette dataelementet ha forrang over "Klinisk indikasjon". Koding med en terminologi er foretrekkes, der det er mulig. For eksempel: kreftbehandling eller revmatoid artritt ved osteoporose.&#13;
</items><items id="description">Klinisk indikasjon for bruk av legemiddelet i denne perioden, særlig der dette er mer spesifikt eller skiller seg fra informasjonen i dataelementet 'Klinisk indikasjon'. Kan også brukes der det ikke er noen klinisk indikasjon som gjelder for alle episoder.</items><items id="text">Indikasjon for perioden</items></items><items code="at0019"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at0020"><items id="comment">Koding med en terminologi foretrekkes, der det er mulig. For eksempel: smertelindring, palliativ eller kurativ, kur eller livslang behandling med antibiotika.</items><items id="description">Den terapeutiske hensikten for bruken av legemiddelet i denne perioden.</items><items id="text">Terapeutisk hensikt</items></items><items code="at0022"><items id="comment">Koding med en terminologi foretrekkes, der det er mulig. For eksempel: Urinveisinfeksjonen er behandlet.</items><items id="description">Individets respons til behandling med dette legemiddelet i løpet av denne perioden.</items><items id="text">Behandlingsrespons</items></items><items code="at0027"><items id="comment">Kan regnes ut manuelt eller utledes via ulike kilder, som for eksempel kurvesystemet eller andre deler av den elektroniske pasientjournalen.</items><items id="description">Samlet varighet av alle periodene.</items><items id="text">Kumulativ varighet</items></items><items code="at0028"><items id="comment">Koding med en terminologi foretrekkes, der det er mulig. For eksempel: "Osteoporose".</items><items id="description">Overordnet klinisk indikasjon for bruk av legemiddelet.</items><items id="text">Klinisk indikasjon</items></items><items code="at0029"><items id="description">Ytterligere detaljer om legemiddelbruken i denne perioden.</items><items id="text">Ytterligere detaljer</items></items><items code="at0030"><items id="comment">Koding med en terminologi foretrekkes, der det er mulig. For eksempel: Dårlig kontrollert diabetes, overfølsomhetsreaksjoner eller høye kostnader.</items><items id="description">Årsak til at bruken av legemiddelet ble avsluttet.</items><items id="text">Årsak til seponering</items></items><items code="at0031"><items id="comment">Om "Periodens startdato" og "Periodens sluttdato" er brukt i systemer, kan dette dataelementet kalkuleres eller alternativt være overflødig i dette scenariet.</items><items id="description">Varigheten for bruk av legemiddelet i denne perioden.</items><items id="text">Periodens varighet</items></items><items code="at0032"><items id="comment">For eksempel "oral bruk", "intravenøst", "på huden" eller "enteralt". Koding med en terminologi foretrekkes, der det er mulig.</items><items id="description">Administreringsveien for det ordinerte legemiddelet i denne perioden.</items><items id="text">Administreringsvei</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="description">*Summary or persistent information about the use of a single medication or group of medications, especially where the pattern of use or cumulative dosage needs to be monitored. (en)</items><items id="text">Sumário de medicamentos</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*The medication name can be represented as a generic substance, trade name or a group or class of medications. Coding of 'Medication name' with a terminology capable of triggering decision support is strongly recommended where possible. Free text entry should only be used if there is no appropriate terminology available. For example: 'Adriamycin'; 'doxorubicin' or 'anthracyclines'; 'Fosamax', 'alendronate' or 'bisphosphanates'. (en)</items><items id="description">*Name of medication or group of medications. (en)</items><items id="text">Nome do medicamento</items></items><items code="at0005"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0006"><items id="description">A última data em que esse sumário de medicamente foi atualizado.</items><items id="text">Última atualização</items></items><items code="at0007"><items id="comment">*For example: "Used between 1996 and 2001 against osteoporosis. Ceased after five years of use to minimise risk of adverse effects." (en)</items><items id="description">*Changing the description to: Narrative description about the overall use of the medication. (en)</items><items id="text">Descrição clínica</items></items><items code="at0008"><items id="comment">*Triggers for closing one episode and commencing a new one can include: &#13;
- a change in dose; &#13;
- or a significant change in the pattern of use (en)</items><items id="description">*Details about use of the medication during a specified period of time. (en)</items><items id="text">Episódio</items></items><items code="at0009"><items id="comment">*Can be a partial date, for example, only a year. (en)</items><items id="description">*The date when the medication was first administered. (en)</items><items id="text">Início de uso</items></items><items code="at0010"><items id="comment">*Can be a partial date, for example, only a year. (en)</items><items id="description">*The date when the medication was last administered. (en)</items><items id="text">*Cessation of use (en)</items></items><items code="at0011"><items id="comment">*Can be a partial date, for example, only a year. (en)</items><items id="description">*The date of the first administration of the medication for this episode. (en)</items><items id="text">Início do episódio</items></items><items code="at0012"><items id="comment">*Can be a partial date, for example, only a year. (en)</items><items id="description">*The date of the last administration of the medication for this episode. (en)</items><items id="text">Término do episódio</items></items><items code="at0013"><items id="comment">*Coding with an external terminology is preferred, where possible. For example: sub-optimal control of diabetes; adverse reaction; or high cost. (en)</items><items id="description">Razão pela qual esse medicamento foi interrompido.</items><items id="text">*Episode reason for cessation (en)</items></items><items code="at0014"><items id="description">Descrição do uso durante o episódio de uso identificado.</items><items id="text">*Description (en)</items></items><items code="at0015"><items id="comment">*For example: monitoring of the cumulative dose of doxorubicin.&#13;
May be manually calculated or derived via the EHR from multiple sources.&#13;
&#13;
 (en)</items><items id="description">Quantidade total já consumida.</items><items id="text">Dose cumulativa</items></items><items code="at0016"><items id="description">*Cumulative dose of the medication used in this episode. (en)</items><items id="text">*Episode amount (en)</items></items><items code="at0018"><items id="comment">*This element and the root level 'Clinical indication' element can potentially be in conflict with each other. In those situations, this element takes precedence over 'Clinical indication' for this episode.&#13;
Coding with an external terminology is preferred, where possible. &#13;
For example: 'Cancer therapy' or 'rheumatoid arthritis for osteoporosis'. (en)</items><items id="description">*The clinical indication for the administration or consumption of the medication during this episode. (en)</items><items id="text">*Episode indication (en)</items></items><items code="at0019"><items id="comment">Por exemplo: requisitos de informação local ou metadados adicionais para alinhar com equivalentes do FHIR ou CIMI.</items><items id="description">Informação adicional requerida para entender o contexto local ou alinhar com outros modelos de referência/formalismos.</items><items id="text">Extensão</items></items><items code="at0020"><items id="comment">*Coding with an external terminology, where possible. For example: pain relief; palliative or curative; short term course or life-long antibiotics. (en)</items><items id="description">*The therapeutic intent for use of the medication during this episode. (en)</items><items id="text">*Therapeutic intent (en)</items></items><items code="at0022"><items id="comment">*Coding with an external terminology is preferred, where possible. For example: UTI resolved (en)</items><items id="description">*The individual's response to the treatment by this medication during this episode. (en)</items><items id="text">*Therapeutic response (en)</items></items><items code="at0027"><items id="comment">*May be manually calculated or derived via the EHR from multiple sources. (en)</items><items id="description">*The sum of the duration of all episodes. (en)</items><items id="text">*Cumulative duration (en)</items></items><items code="at0028"><items id="comment">*Coding with an external terminology is preferred, where possible. For example: 'Osteoporosis'. (en)</items><items id="description">*The overall clinical indication for the administration or consumption of the medication. (en)</items><items id="text">*Clinical indication (en)</items></items><items code="at0029"><items id="description">*Additional details about medication use during this episode. (en)</items><items id="text">*Additional details (en)</items></items><items code="at0030"><items id="comment">*Coding with an external terminology is preferred, where possible. For example: sub-optimal control of diabetes; adverse reaction; or high cost. (en)</items><items id="description">*The reason why all use of the medication was stopped. (en)</items><items id="text">*Reason for cessation (en)</items></items><items code="at0031"><items id="comment">*If 'Episode onset' and 'Episode cessation' are used in systems, this data element may be calculated, or alternatively, be considered redundant in this scenario. (en)</items><items id="description">*The duration of the use of the medication in this episode.  (en)</items><items id="text">*Episode duration (en)</items></items><items code="at0032"><items id="comment">*For example: 'oral', 'intravenous', or 'topical'. Coding of the route with a terminology is preferred, where possible. (en)</items><items id="description">*The route by which the ordered item was, administed during this episode. (en)</items><items id="text">*Route (en)</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-EVALUATION.problem_diagnosis.v1"><term_definitions language="ar-sy"><items code="at0000"><items id="comment">*Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.(en)</items><items id="description">*Details about a single identified health condition, injury, disability or any other issue which impacts on the physical, mental and/or social well-being of an individual.(en)</items><items id="text">*Problem/Diagnosis(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*structure(en)</items></items><items code="at0002"><items id="comment">*Coding of the name of the problem or diagnosis with a terminology is preferred, where possible.(en)</items><items id="description">*Identification of the problem or diagnosis, by name.(en)</items><items id="text">*Problem/Diagnosis name(en)</items></items><items code="at0003"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support.(en)</items><items id="description">*Estimated or actual date/time the diagnosis or problem was recognised by a healthcare professional.(en)</items><items id="text">*Date/time clinically recognised(en)</items></items><items code="at0005"><items id="comment">*If severity is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant. Note: more specific grading of severity can be recorded using the Specific details SLOT.(en)</items><items id="description">*An assessment of the overall severity of the problem or diagnosis.(en)</items><items id="text">*Severity(en)</items></items><items code="at0009"><items id="comment">*Use to provide background and context, including evolution, episodes or exacerbations, progress and any other relevant details, about the problem or diagnosis.(en)</items><items id="description">*Narrative description about the problem or diagnosis.(en)</items><items id="text">*Clinical description(en)</items></items><items code="at0012"><items id="comment">*Coding of the name of the anatomical location with a terminology is preferred, where possible.&#13;
Use this data element to record precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Structured anatomical location' SLOT in this archetype. Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a rash in multiple locations but where all of the other attributes are identical. If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">*Identification of a simple body site for the location of the problem or diagnosis.(en)</items><items id="text">*Body site(en)</items></items><items code="at0030"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support.(en)</items><items id="description">*Estimated or actual date/time of resolution or remission for this problem or diagnosis, as determined by a healthcare professional.(en)</items><items id="text">*Date/time of resolution(en)</items></items><items code="at0032"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0039"><items id="comment">*Use this SLOT to insert the CLUSTER.anatomical_location or CLUSTER.relative_location archetypes if the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations.&#13;
&#13;
If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, use of this SLOT becomes redundant.(en)</items><items id="description">*A structured anatomical location for the problem or diagnosis.(en)</items><items id="text">*Structured body site(en)</items></items><items code="at0043"><items id="comment">*May include structured detail about the grading or staging of the diagnosis; diagnostic criteria, classification criteria or formal severity assessments such as Common Terminology Criteria for Adverse Events.(en)</items><items id="description">*Details that are additionally required to record as unique attributes of this problem or diagnosis.(en)</items><items id="text">*Specific details(en)</items></items><items code="at0046"><items id="comment">*Use status or context qualifiers with care, as they are variably used in practice and interoperability cannot be assured unless usage is clearly defined with the community of use. For example: active status - active, inactive, resolved, in remission; evolution status - initial, interim/working, final; temporal status - current, past; episodicity status - first, new, ongoing; admission status - admission, discharge; or priority status - primary, secondary.(en)</items><items id="description">*Structured details for location-, domain-, episode- or workflow-specific aspects of the diagnostic process.(en)</items><items id="text">*Status(en)</items></items><items code="at0047"><items id="description">*The problem or diagnosis does not interfere with normal activity.(en)</items><items id="text">*Mild(en)</items></items><items code="at0048"><items id="description">*The problem or diagnosis causes interference with normal activity.(en)</items><items id="text">*Moderate(en)</items></items><items code="at0049"><items id="description">*The problem or diagnosis prevents normal activity.(en)</items><items id="text">*Severe(en)</items></items><items code="at0069"><items id="description">*Additional narrative about the problem or diagnosis not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0070"><items id="description">*The date this problem or diagnosis was last updated.(en)</items><items id="text">*Last updated(en)</items></items><items code="at0071"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0072"><items id="description">*Narrative description about the course of the problem or diagnosis since onset.(en)</items><items id="text">*Course description(en)</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">*The level of confidence in the identification of the diagnosis.(en)</items><items id="text">*Diagnostic certainty(en)</items></items><items code="at0074"><items id="description">*The diagnosis has been identified with a low level of certainty.(en)</items><items id="text">*Suspected(en)</items></items><items code="at0075"><items id="description">*The diagnosis has been identified with a high level of certainty.(en)</items><items id="text">*Probable(en)</items></items><items code="at0076"><items id="description">*The diagnosis has been confirmed against recognised criteria.(en)</items><items id="text">*Confirmed(en)</items></items><items code="at0077"><items id="description">*Estimated or actual date/time that signs or symptoms of the problem/diagnosis were first observed.(en)</items><items id="text">*Date of onset(en)</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="comment">No és fàcil trobar en la pràctica una delineació clara entre l’abast d’un problema versus un diagnòstic. Per a la finalitat d’aquest arquetip, problema i diagnòstic es veuran com un continu, amb l’increment de nivells de detalls i una evidència d’ajuda normalment que doni pes sobre l’etiqueta «diagnòstic».</items><items id="description">Detalls sobre una única condició de salut, lesió, discapacitat o qualsevol altre problema identificat que afecti el benestar físic, mental o social d’una persona. </items><items id="text">Problema/Diagnòstic</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Es recomana programar el nom del problema o diagnòstic amb una terminologia sempre que sigui possible.</items><items id="description">Identificació del problema o diagnòstic pel nom.</items><items id="text">Nom del Problema/Diagnòstic</items></items><items code="at0003"><items id="comment">Les dades parcials són vàlides. Si la persona de la cura té menys d’un any, doncs la data completa o el mínim de mes i any és necessari per permetre càlculs d’edat correctes; per exemple, si s’utilitza per a desviar el suport. La dada capturada/importada com «Edat en el moment del reconeixement clínic» s’ha de convertir en una dada utilitzant les dades de naixement del pacient.</items><items id="description">Data/hora estimada o real en què un professional sanitari va declarar el diagnòstic o problema.</items><items id="text">Data/hora del diagnòstic clínic</items></items><items code="at0005"><items id="comment">Si la gravetat s’inclou al nom del problema/diagnòstic mitjançant codis preordinats, aquest element de dades serà redundant. Observació: es pot registrar una classificació més específica de la gravetat utilitzant el SLOT Detalls específics.</items><items id="description">Una avaluació de la severitat global del problema o diagnòstic.</items><items id="text">Severitat</items></items><items code="at0009"><items id="comment">Utilitzar per a produir un fons i context, inclosos l’evolució, episodis o exacerbacions, progrés i altres detalls rellevants sobre el problema o diagnòstic.</items><items id="description">Informació addicional del problema o diagnòstic.</items><items id="text">Descripció clínica</items></items><items code="at0012"><items id="comment">Es recomana programar la zona anatòmica amb una terminologia sempre que sigui possible. &#13;
Utilitzar aquest element de dades per registrar zones preordinades anatòmiques. Si els requisits per registrar la localització anatòmica es determinen en temps d’execució per l’aplicació o requereixen un modelatge més complex, com les localitzacions relatives, utilitzar CLUSTER.anatomical_location o CLUSTER.relative_location en el SLOT «Structured anatomical location» d’aquest arquetip. Les ocurrències d’aquest element de dades són il·limitades per a permetre escenaris clínics com la descripció d’una erupció en llocs múltiples, però on tots els altres atributs són idèntics. Si la localització anatòmica s’inclou en el nom de problema/diagnòstic mitjançant codis preordinats aquesta dada serà innecessària.</items><items id="description">Identificació de la zona del cos per a la localització del problema o diagnòstic.</items><items id="text">Zona del cos</items></items><items code="at0030"><items id="comment">Les dades parcials són vàlides. Si el pacient de la cura té menys d’un any, doncs la data completa o el mínim de mes i any és necessari per permetre càlculs d’edat acurats. Per exemple, si s’utilitza per desviar el suport. La dada capturada/importada com «Edat en el moment del reconeixement clínic» s’ha de convertir en una dada utilitzant les dades de naixement de la persona.</items><items id="description">Data/hora estimada o real de resolució o remissió d'aquest problema o diagnòstic, determinada per un professional sanitari.</items><items id="text">Data/hora de resolució</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Utilitzar aquest SLOT per a inserir els arquetips CLUSTER.anatomical_location o CLUSTER.relative_location si els requisits per a registrar la localització anatòmica estan determinats en el temps d’execució per l’aplicació o requereix un modelatge més complex com unes localitzacions relatives. &#13;
&#13;
Si la localització anatòmica s’inclou en el problema/diagnòstic via codis preordinats, utilitzar aquest SLOT esdevindria redundant.</items><items id="description">Localització anatòmica estructurada per al problema o diagnòstic.</items><items id="text">Zona del cos estructurada</items></items><items code="at0043"><items id="comment">Pot incloure dades sobre la graduació o estat del diagnòstic; criteris de diagnòstic, criteris de classificació o avaluacions formals de la gravetat, com els Criteris Terminològics Comuns per a Reaccions Adverses.</items><items id="description">Detalls que es requereixen addicionalment per a registrar atributs únics d'aquest problema o diagnòstic.</items><items id="text">Detalls específics</items></items><items code="at0046"><items id="comment">Utilitzar els qualificadors d'estatus o context amb precaució, ja que s’utilitzen de forma variable en la pràctica i la interoperabilitat no es pot garantir almenys que l’ús es trobi clarament definit per la comunitat d’ús. Per exemple: estat actiu – actiu, inactiu, resolt, en remissió; estat d’evolució – inicial, provisional/en curs, final; estat temporal – actual, passat; estat d’episodi – primer, nou, en curs; estat d’admissió – ingrés, alta; o estat de prioritat – primària, secundària.</items><items id="description">Detalls estructurats per a aspectes específics d'ubicació, domini, episodi o flux de treball del procés diagnòstic.</items><items id="text">Estat</items></items><items code="at0047"><items id="description">El problema o diagnòstic no interfereix amb l'activitat normal ni pot causar danys a la salut si no es tracta.</items><items id="text">Lleu</items></items><items code="at0048"><items id="description">El problema o diagnòstic interfereix amb l'activitat normal o pot causar danys a la salut si no es tracta.</items><items id="text">Moderat</items></items><items code="at0049"><items id="description">El problema o diagnòstic impedeix l'activitat normal o causarà danys greus a la salut si no es tracta.</items><items id="text">Greu</items></items><items code="at0069"><items id="description">Informació descriptiva sobre el problema o diagnòstic no registrada en altres camps.</items><items id="text">Comentaris</items></items><items code="at0070"><items id="description">La data en què es va actualitzar per última vegada aquest problema o diagnòstic.</items><items id="text">Darrera actualització</items></items><items code="at0071"><items id="comment">Per exemple: requisits locals d'informació o metadades addicionals per alinear-se amb equivalents de FHIR o CIMI.</items><items id="description">Informació addicional necessària per a recollir el contingut local o per alinear-se amb altres models/formalismes de referència.</items><items id="text">Extensió</items></items><items code="at0072"><items id="description">Informació addicional del curs del problema o diagnòstic des de l'inici.</items><items id="text">Descripció del curs</items></items><items code="at0073"><items id="comment">Si es necessita un conjunt de valors alternatiu, aquests valors es poden afegir al tipus de dades DV_TEXT en una plantilla.</items><items id="description">El nivell de confiança en la identificació del diagnòstic.</items><items id="text">Certesa diagnòstica</items></items><items code="at0074"><items id="description">El diagnòstic s'ha identificat amb un nivell baix de certesa.</items><items id="text">Sospita</items></items><items code="at0075"><items id="description">El diagnòstic s'ha identificat amb un alt nivell de certesa.</items><items id="text">Probable</items></items><items code="at0076"><items id="description">El diagnòstic s'ha confirmat d'acord amb criteris reconeguts.</items><items id="text">Confirmat</items></items><items code="at0077"><items id="comment">Data capturada/importada com «edat durant la primera aparició» es pot convertir en una edat utilitzant la deta de naixemnt del pacient.</items><items id="description">Data/hora estimada o real en què es van observar per primera vegada els signes o símptomes del problema/diagnòstic.</items><items id="text">Data/hora de l’aparició</items></items><items code="at0078"><items id="comment">També conegut com a «etiologia». Es recomana programar amb una terminologia si és possible.</items><items id="description">Una causa, conjunt de causes o el mecanisme causal del problema o diagnòstic.</items><items id="text">Causa</items></items><items code="at0079"><items id="comment">Per exemple: «neuropatia axonal motora aguda», com a variant de la síndrome de Guillain-Barré. Es recomana programar el nom de la variant amb una terminologia sempre que sigui possible.</items><items id="description">Variant o subtipus específic del Diagnòstic, si escau.</items><items id="text">Variant</items></items><items code="at0080"><items id="comment">El mateix diagnòstic, amb la mateixa gravetat, té un impacte diferent en cada pacient. Aquest qualificador de rellevància implica ajustar l'impacte global d'aquest problema de salut segons les característiques del pacient.&#13;
Per exemple: Dos pacients tenen el mateix diagnòstic. Cremada de primer grau.&#13;
Un és una persona sana, l'altre és un pacient diabètic.&#13;
L'impacte d'aquest problema en un pacient diabètic és MÉS ALT (més risc d'infecció..., més temps de curació).&#13;
Aquest element està pensat per permetre múltiples tipus d'impacte, incloent-hi, entre d'altres: tractament clínic, funcionament a casa, activitats de vida diària o vida laboral.</items><items id="description">Avaluació global de l'impacte o rellevància d'un problema de salut per a un pacient concret.</items><items id="text">Impacte</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="comment">Eine klare Abgrenzung zwischen Problem und Diagnose ist in der Praxis nicht einfach zu erreichen. Für die Zwecke der klinischen Dokumentation mit diesem Archetyp werden Problem und Diagnose als ein Kontinuum betrachtet, mit zunehmendem Detaillierungsgrad und unterstützenden Beweisen, die in der Regel dem Etikett "Diagnose" Gewicht verleihen.</items><items id="description">Angaben über einen einzelnen identifizierten Gesundheitszustand, eine Verletzung, eine Behinderung oder ein Problem, welches das körperliche, geistige und/oder soziale Wohlergehen einer Einzelperson beeinträchtigt.</items><items id="text">Diagnose/Symptom</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Structure</items></items><items code="at0002"><items id="comment">Wo möglich, ist die Kodierung des Problems oder der Diagnose über eine Terminologie zu bevorzugen.</items><items id="description">Namentliche Bezeichnung des Symptoms ("medical Problem") oder der Diagnose.</items><items id="text">Diagnose-/Symptombezeichnung</items></items><items code="at0003"><items id="comment">Unvollständige Datumsangaben sind zulässig. Wenn der Patient unter einem Jahr alt ist, dann ist das vollständige Datum oder ein Minimum von Monat und Jahr notwendig, um genaue Altersberechnungen zu ermöglichen - z.B. wenn es zur Entscheidungsunterstützung verwendet wird. Datumswerte, die als "Alter zum Zeitpunkt der klinischen Feststellung" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items><items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der die Diagnose oder das Problem von einer medizinischen Fachkraft festgestellt wurde.</items><items id="text">Datum/Zeitpunkt der klinischen Feststellung</items></items><items code="at0005"><items id="comment">Ist der Schweregrad über vordefinierte Codes im Element "Name des Problems/ der Diagnose" enthalten, wird dieses Datenelement überflüssig. Hinweis: Eine spezifischere Einstufung des Schweregrads kann mit Hilfe des SLOTs "Spezifische Angaben" angegeben werden.</items><items id="description">Eine Gesamtbeurteilung des Schweregrades des Problems oder der Diagnose.</items><items id="text">Schweregrad</items></items><items code="at0009"><items id="comment">Wird verwendet, um Hintergrund und Kontext, einschließlich Entwicklung, Episoden oder Verschlechterungen, Fortschritt und andere relevante Details über das Problem oder die Diagnose zu liefern.</items><items id="description">Beschreibung des Problems oder der Diagnose.</items><items id="text">Klinische Beschreibung</items></items><items code="at0012"><items id="comment">Wo dies möglich ist, ist die Kodierung der anatomischen Lokalisation über eine Terminologie zu bevorzugen. Verwenden Sie dieses Datenelement, um vorab präkoordinierte anatomische Lokalisationen zu erfassen. Wenn die Anforderungen an die Erfassung der anatomischen Lokalisation zur Laufzeit durch die Anwendung bestimmt werden oder komplexere Modellierungen, wie z.B. relative Lokalisationen erforderlich sind, dann verwenden Sie in diesem Archetyp den CLUSTER.anatomical_location oder CLUSTER.relative_location innerhalb des SLOT 'Structured anatomical location'. Die Anzahl für dieses Datenelement ist unbegrenzt, um klinische Szenarien wie die Beschreibung eines Hautausschlags an mehreren Stellen zu ermöglichen, wobei jedoch alle anderen Attribute identisch sind. Falls die anatomische Lage über präkoordinierte Codes im Namen des Problems/Diagnose enthalten ist, wird dieses Datenelement überflüssig.</items><items id="description">Identifikation einer einfachen Körperstelle zur Lokalisierung des Problems oder der Diagnose.</items><items id="text">Körperstelle</items></items><items code="at0030"><items id="comment">Unvollständige Datumsangaben sind zulässig. Wenn der Patient unter einem Jahr alt ist, dann ist das vollständige Datum oder ein Minimum von Monat und Jahr notwendig, um genaue Altersberechnungen zu ermöglichen - z.B. wenn es zur Entscheidungsunterstützung verwendet wird. Datumswerte, die als "Alter zum Zeitpunkt der Genesung" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items><items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der von einer medizinischen Fachkraft die Genesung oder die Remission des Problems oder der Diagnose festgestellt wurde.</items><items id="text">Datum/Zeitpunkt der Genesung</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Verwenden Sie diesen SLOT, um die Archetypen CLUSTER.anatomical_location oder CLUSTER.relative_location einzufügen, wenn die Anforderungen für die Aufnahme der anatomischen Position zur Laufzeit der Anwendung bestimmt werden oder komplexere Modellierungen wie z.B. relative Positionen erforderlich sind. Ist die anatomische Körperstelle über präkoordinierte Codes im Namen des Problems/Diagnose enthalten, wird die Verwendung dieses SLOT überflüssig.</items><items id="description">Eine strukturierte anatomische Beschreibung der Körperstelle, an der das Problem oder die Diagnose auftreten.</items><items id="text">Strukturierte Körperstelle</items></items><items code="at0043"><items id="comment">Hier können strukturierte Angaben über die Einstufung oder das Stadium der Diagnose enthalten sein; diagnostische Kriterien, Klassifizierungskriterien oder formale Bewertungen des Schweregrades wie z.B. "Common Terminology Criteria for Adverse Events".</items><items id="description">Zusätzlich benötigte Angaben, welche als eindeutige Merkmale des Problem/der Diagnose erfasst werden sollten.</items><items id="text">Spezifische Angaben</items></items><items code="at0046"><items id="comment">Verwenden Sie Status- oder Kontext-Merkmale mit Vorsicht, da sie in der Praxis variabel eingesetzt werden und die Interoperabilität nicht gewährleistet werden kann, sofern die Verwendung nicht mit der Nutzungsgemeinschaft klar abgestimmt wird. Beispiel: aktiver Status - aktiv, inaktiv, genesen, in Remission; Entwicklungsstatus - initial, interim/working, final; zeitlicher Status - aktuell, vergangen; Episodenstatus - erstmalig, neu, laufend; Aufnahmestatus - Aufnahme, Entlassung; oder Prioritätsstatus - primär, sekundär.</items><items id="description">Strukturierte Angaben zu standort-, domänen-, episoden- oder workflow-spezifischen Aspekten des diagnostischen Prozesses.</items><items id="text">Status</items></items><items code="at0047"><items id="description">Das Problem oder die Diagnose beeinträchtigt die normale Aktivität nicht, bzw. verursacht nicht bleibende gesundheitliche Schäden, falls es nicht behandelt wird.</items><items id="text">Leicht</items></items><items code="at0048"><items id="description">Das Problem oder die Diagnose beeinträchtigt die normale Aktivität oder verursacht bleibende gesundheitliche Schäden, falls es nicht behandelt wird.</items><items id="text">Mäßig</items></items><items code="at0049"><items id="description">Das Problem oder die Diagnose verhindert die normale Aktivität oder verursacht schwerwiegende gesundheitliche Schäden, falls es nicht behandelt wird.</items><items id="text">Schwer</items></items><items code="at0069"><items id="description">Ergänzende Beschreibung des Problems oder der Diagnose, die nicht anderweitig erfasst wurde.</items><items id="text">Kommentar</items></items><items code="at0070"><items id="description">Datum der letzten Aktualisierung der Diagnose bzw. des Problems.</items><items id="text">Zuletzt aktualisiert</items></items><items code="at0071"><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="text">Erweiterung</items></items><items code="at0072"><items id="description">Beschreibung des Problem-/ Diagnoseverlaufs seit Beginn.</items><items id="text">Beschreibung des Verlaufs</items></items><items code="at0073"><items id="comment">Wenn ein alternativer Wertesatz benötigt wird, können diese Werte in einem Template zum Datentyp DV_TEXT hinzugefügt werden.</items><items id="description">Grad der Sicherheit, mit der die Diagnose festgestellt wurde.</items><items id="text">Diagnostische Sicherheit</items></items><items code="at0074"><items id="description">Die Diagnose wurde mit einem niedrigen Grad an Sicherheit gestellt.</items><items id="text">Vermutet</items></items><items code="at0075"><items id="description">Die Diagnose wurde mit einem hohen Maß an Sicherheit gestellt.</items><items id="text">Wahrscheinlich</items></items><items code="at0076"><items id="description">Die Diagnose wurde anhand anerkannter Kriterien bestätigt.</items><items id="text">Bestätigt</items></items><items code="at0077"><items id="comment">Datumswerte, die als "Alter zu Beginn" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items><items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der die Krankheitsanzeichen oder Symptome zum ersten mal beobachtet wurden.</items><items id="text">Datum des erstmaligen Auftretens</items></items><items code="at0078"><items id="comment">Die Codierung mit einer externen Terminologie wird nach Möglichkeit bevorzugt.</items><items id="description">Die Ursache, eine Reihe von Ursachen oder eine Art und Weise der Verursachung des Problems oder der Diagnose.</items><items id="text">Ätiologie</items></items><items code="at0079"><items id="comment">Zum Beispiel: „Akute motorische axonale Neuropathie“ als Variante des Guillain-Barre-Syndroms. Wo möglich, ist die Kodierung des Namens der Variante über eine Terminologie zu bevorzugen.</items><items id="description">Spezifische Variante oder Subtyp der Diagnose, falls relevant.</items><items id="text">Subtyp</items></items><items code="at0080"><items id="comment">Dieselbe Diagnose mit demselben Schweregrad kann sich bei jedem Patienten unterschiedlich auswirken. Dieser Relevanzfaktor bedeutet, dass die Gesamtbelastung durch dieses Gesundheitsproblem entsprechend den Merkmalen des Patienten angepasst werden muss.&#13;
Beispiel: Zwei Patienten haben dieselbe Diagnose: Verbrennungen ersten Grades.&#13;
Der eine ist gesund, der andere leidet an Diabetes.&#13;
Die Belastung durch dieses Problem ist bei einem Diabetiker GRÖSSER (höheres Infektionsrisiko …, längere Heilungsdauer).&#13;
Dieses Element soll verschiedene Arten von Auswirkungen berücksichtigen, darunter unter anderem: klinische Behandlung, Alltag zu Hause, Berufsleben.</items><items id="description">Gesamtbeurteilung der Auswirkungen der Diagnose/des Symptoms auf den Patienten.</items><items id="text">Auswirkungen</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="comment">Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.</items><items id="description">Details about a single identified health condition, injury, disability or any other issue which impacts on the physical, mental and/or social well-being of an individual.</items><items id="text">Problem/Diagnosis</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Coding of the name of the problem or diagnosis with a terminology is preferred, where possible.</items><items id="description">Identification of the problem or diagnosis, by name.</items><items id="text">Problem/Diagnosis name</items></items><items code="at0003"><items id="comment">Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of clinical recognition" should be converted to a date using the subject's date of birth.</items><items id="description">Estimated or actual date/time the diagnosis or problem was recognised by a healthcare professional.</items><items id="text">Date/time clinically recognised</items></items><items code="at0005"><items id="comment">If severity is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant. Note: more specific grading of severity can be recorded using the Specific details SLOT.</items><items id="description">An assessment of the overall severity of the problem or diagnosis.</items><items id="text">Severity</items></items><items code="at0009"><items id="comment">Use to provide background and context, including evolution, episodes or exacerbations, progress and any other relevant details, about the problem or diagnosis.</items><items id="description">Narrative description about the problem or diagnosis.</items><items id="text">Clinical description</items></items><items code="at0012"><items id="comment">Coding of the name of the anatomical location with a terminology is preferred, where possible.&#13;
Use this data element to record precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Structured anatomical location' SLOT in this archetype. Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a rash in multiple locations but where all of the other attributes are identical. If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant.</items><items id="description">Identification of a simple body site for the location of the problem or diagnosis.</items><items id="text">Body site</items></items><items code="at0030"><items id="comment">Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of resolution" should be converted to a date using the subject's date of birth.&#13;
</items><items id="description">Estimated or actual date/time of resolution or remission for this problem or diagnosis, as determined by a healthcare professional.</items><items id="text">Date/time of resolution</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Use this SLOT to insert the CLUSTER.anatomical_location or CLUSTER.relative_location archetypes if the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations.&#13;
&#13;
If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, use of this SLOT becomes redundant.</items><items id="description">A structured anatomical location for the problem or diagnosis.</items><items id="text">Structured body site</items></items><items code="at0043"><items id="comment">May include structured detail about the grading or staging of the diagnosis; diagnostic criteria, classification criteria or formal severity assessments such as Common Terminology Criteria for Adverse Events.</items><items id="description">Details that are additionally required to record as unique attributes of this problem or diagnosis.</items><items id="text">Specific details</items></items><items code="at0046"><items id="comment">Use status or context qualifiers with care, as they are variably used in practice and interoperability cannot be assured unless usage is clearly defined with the community of use. For example: active status - active, inactive, resolved, in remission; evolution status - initial, interim/working, final; temporal status - current, past; episodicity status - first, new, ongoing; admission status - admission, discharge; or priority status - primary, secondary.</items><items id="description">Structured details for location-, domain-, episode- or workflow-specific aspects of the diagnostic process.</items><items id="text">Status</items></items><items code="at0047"><items id="description">The problem or diagnosis does not interfere with normal activity or may cause damage to health if left untreated.</items><items id="text">Mild</items></items><items code="at0048"><items id="description">The problem or diagnosis causes interference with normal activity or will damage health if left untreated.</items><items id="text">Moderate</items></items><items code="at0049"><items id="description">The problem or diagnosis prevents normal activity or will seriously damage health if left untreated.</items><items id="text">Severe</items></items><items code="at0069"><items id="description">Additional narrative about the problem or diagnosis not captured in other fields.</items><items id="text">Comment</items></items><items code="at0070"><items id="description">The date this problem or diagnosis was last updated.</items><items id="text">Last updated</items></items><items code="at0071"><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></items><items code="at0072"><items id="description">Narrative description about the course of the problem or diagnosis since onset.</items><items id="text">Course description</items></items><items code="at0073"><items id="comment">If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.</items><items id="description">The level of confidence in the identification of the diagnosis.</items><items id="text">Diagnostic certainty</items></items><items code="at0074"><items id="description">The diagnosis has been identified with a low level of certainty.</items><items id="text">Suspected</items></items><items code="at0075"><items id="description">The diagnosis has been identified with a high level of certainty.</items><items id="text">Probable</items></items><items code="at0076"><items id="description">The diagnosis has been confirmed against recognised criteria.</items><items id="text">Confirmed</items></items><items code="at0077"><items id="comment">Data captured/imported as "Age at onset" should be converted to a date using the subject's date of birth.</items><items id="description">Estimated or actual date/time that signs or symptoms of the problem/diagnosis were first observed.</items><items id="text">Date/time of onset</items></items><items code="at0078"><items id="comment">Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.</items><items id="description">A cause, set of causes, or manner of causation of the problem or diagnosis.</items><items id="text">Cause</items></items><items code="at0079"><items id="comment">For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.</items><items id="description">Specific variant or subtype of the Diagnosis, if relevant.</items><items id="text">Variant</items></items><items code="at0080"><items id="comment">The same diagnosis, with the same severity, has a different impact on each patient. This relevance qualifier implies adjusting the overall impact of that health problem according to the patient's characteristics.&#13;
For example: Two patients have the same diagnosis. First-degree burn.&#13;
One is a healthy person, the other is a diabetic patient.&#13;
The impact for that problem in a diabetic patient is HIGHER (more risk of infection..., longuer time healing).&#13;
This element is meant to allow for multiple types of impact, including but not limited to: clinical treatment, home functioning, work life.</items><items id="description">Overall assessment of the impact of a health problem for the specific patient.</items><items id="text">Impact</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="comment">En la práctica, no es fácil distinguir claramente entre el alcance de un problema y el de un diagnóstico. A efectos de la documentación clínica con este arquetipo, el problema y el diagnóstico se consideran un continuo, con niveles crecientes de detalle y evidencia de apoyo que generalmente aportan peso a la etiqueta de "diagnóstico".</items><items id="description">Detalles sobre una única condición de salud, lesión, discapacidad o cualquier otro problema identificado que afecte al bienestar físico, mental y/o social de un individuo.</items><items id="text">Problema/Diagnóstico</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Siempre que sea posible, es preferible codificar el nombre del problema o diagnóstico con una terminología.</items><items id="description">Identificación del problema o diagnóstico, por nombre.</items><items id="text">Nombre del problema/diagnóstico</items></items><items code="at0003"><items id="comment">Se aceptan fechas parciales. Si el sujeto atendido es menor de un año, entonces es necesaria la fecha completa o un mínimo del mes y año para permitir cálculos de edad precisos, por ejemplo, si se utiliza para impulsar el apoyo a la toma de decisiones. Los datos registrados/importados, como "Edad en el momento del reconocimiento clínico", deben convertirse a una fecha utilizando la fecha de nacimiento del sujeto.</items><items id="description">Fecha/hora estimada o real en que un profesional sanitario reconoció el diagnóstico o el problema.</items><items id="text">Fecha/Hora de reconocimiento del problema</items></items><items code="at0005"><items id="comment">Si la gravedad está incluida dentro del nombre del problema/diagnóstico mediante códigos precoordinados, este elemento de datos se vuelve redundante. Nota: Se puede registrar una clasificación de gravedad más específica utilizando el SLOT de detalles específicos.</items><items id="description">Evaluación de la gravedad global del problema o diagnóstico.</items><items id="text">Severidad</items></items><items code="at0009"><items id="comment">Se utiliza para proporcionar antecedentes y contexto, incluida la evolución, los episodios o exacerbaciones, los progresos y cualquier otro detalle pertinente, sobre el problema o el diagnóstico.</items><items id="description">Descripción narrativa del problema o diagnóstico.</items><items id="text">Descripción clínica</items></items><items code="at0012"><items id="comment">Siempre que sea posible, es preferible codificar el nombre de la ubicación anatómica con una terminología.&#13;
Utilice este elemento de datos para registrar ubicaciones anatómicas precoordinadas. Si los requisitos para registrar la ubicación anatómica los determina la aplicación en tiempo de ejecución o requieren un modelado más complejo, como ubicaciones relativas, utilice CLUSTER.anatomical_location o CLUSTER.relative_location, dentro del SLOT 'Structured anatomical location', en este arquetipo. Las ocurrencias de este elemento de datos son ilimitadas para permitir escenarios clínicos, como describir una erupción en múltiples ubicaciones pero donde todos los demás atributos son idénticos. Si la ubicación anatómica se incluye en el nombre del problema/diagnóstico mediante códigos precoordinados, este dato será redundante.</items><items id="description">Identificación de una zona corporal sencilla para la localización del problema o diagnóstico.</items><items id="text">Zona corporal</items></items><items code="at0030"><items id="comment">Se aceptan fechas parciales. Si el sujeto atendido es menor de un año, entonces es necesaria la fecha completa o un mínimo del mes y año para permitir cálculos de edad precisos, por ejemplo, si se utiliza para impulsar el apoyo a la toma de decisiones. Los datos registrados/importados como "Edad en el momento de la resolución" deben convertirse a una fecha utilizando la fecha de nacimiento del sujeto.</items><items id="description">Fecha/hora estimada o real de resolución o remisión de este problema o diagnóstico, determinada por un profesional sanitario.</items><items id="text">Fecha/hora de resolución</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Utilice este SLOT para insertar los arquetipos CLUSTER.anatomical_location o CLUSTER.relative_location si la aplicación determina los requisitos para registrar la ubicación anatómica en tiempo de ejecución o requiere un modelado más complejo, como ubicaciones relativas.&#13;
&#13;
Si la ubicación anatómica se incluye en el nombre del problema/diagnóstico mediante códigos precoordinados, el uso de este SLOT se vuelve redundante.</items><items id="description">Ubicación anatómica estructurada del problema o diagnóstico.</items><items id="text">Zona corporal estructurada</items></items><items code="at0043"><items id="comment">Puede incluir detalles estructurados sobre la clasificación o estadificación del diagnóstico; criterios de diagnóstico, criterios de clasificación o evaluaciones de gravedad formales, como los Criterios Terminológicos Comunes para Eventos Adversos.</items><items id="description">Detalles que es necesario registrar adicionalmente como atributos únicos de este problema o diagnóstico.</items><items id="text">Detalles específicos</items></items><items code="at0046"><items id="comment">Utilice los calificadores de estado o contexto con precaución, ya que se utilizan de forma variable en la práctica y no se puede garantizar la interoperabilidad a menos que su uso esté claramente definido con la comunidad de uso. Por ejemplo: estado activo - activo, inactivo, resuelto, en remisión; estado de evolución - inicial, provisional/en curso, final; estado temporal - actual, pasado; estado de episodicidad - primero, nuevo, en curso; estado de admisión - ingreso, alta; o estado de prioridad - primaria, secundaria.</items><items id="description">Detalles estructurados para aspectos específicos del proceso de diagnóstico de ubicación, dominio, episodio o flujo de trabajo.</items><items id="text">Estado</items></items><items code="at0047"><items id="description">El problema o diagnóstico no interfiere con la actividad normal ni puede causar daños a la salud si no se trata.</items><items id="text">Leve</items></items><items code="at0048"><items id="description">El problema o diagnóstico interfiere en la actividad normal o perjudica la salud si no se trata.</items><items id="text">Moderado</items></items><items code="at0049"><items id="description">El problema o diagnóstico impide la actividad normal o perjudica gravemente la salud si no se trata.</items><items id="text">Severo</items></items><items code="at0069"><items id="description">Información adicional sobre el problema o el diagnóstico no recogida en otros campos.</items><items id="text">Comentarios</items></items><items code="at0070"><items id="description">Fecha de la última actualización de este problema o diagnóstico.</items><items id="text">Última actualización</items></items><items code="at0071"><items id="comment">Por ejemplo: requisitos locales de información o metadatos adicionales para alinearse con los equivalentes de FHIR o CIMI.</items><items id="description">Información adicional necesaria para registrar el contenido local o para alinearse con otros modelos/formalismos de referencia.</items><items id="text">Ampliación</items></items><items code="at0072"><items id="description">Descripción narrativa sobre la evolución del problema o diagnóstico desde su aparición.</items><items id="text">Progreso</items></items><items code="at0073"><items id="comment">Si se necesita un conjunto de valores alternativo, estos valores pueden añadirse al tipo de datos DV_TEXT en una plantilla.</items><items id="description">Nivel de confianza en la identificación del diagnóstico.</items><items id="text">Certeza diagnóstica</items></items><items code="at0074"><items id="description">El diagnóstico se ha identificado con un bajo nivel de certeza.</items><items id="text">Dudoso</items></items><items code="at0075"><items id="description">El diagnóstico se ha identificado con un alto nivel de certeza.</items><items id="text">Probable</items></items><items code="at0076"><items id="description">El diagnóstico se ha confirmado con criterios reconocidos.</items><items id="text">Confirmado</items></items><items code="at0077"><items id="comment">Los datos registrados/importados, como "Edad al inicio", deben convertirse a una fecha utilizando la fecha de nacimiento del sujeto.</items><items id="description">Fecha/hora estimada o real en que se observaron por primera vez los signos o síntomas del problema/diagnóstico.</items><items id="text">Fecha/hora de inicio</items></items><items code="at0078"><items id="comment">También denominada "etiología". Siempre que sea posible, es preferible codificar con una terminología.</items><items id="description">Causa, conjunto de causas o manera de causar el problema o diagnóstico.</items><items id="text">Causa</items></items><items code="at0079"><items id="comment">Por ejemplo: "neuropatía axonal motora aguda" como variante del síndrome de Guillain-Barré. Siempre que sea posible, es preferible codificar el nombre de la variante con una terminología.</items><items id="description">Variante o subtipo específico del Diagnóstico, si procede.</items><items id="text">Variante</items></items><items code="at0080"><items id="comment">El mismo diagnóstico, con la misma gravedad, tiene un impacto diferente en cada paciente. Este factor de relevancia implica ajustar el impacto general de ese problema de salud según las características del paciente.&#13;
Por ejemplo: Dos pacientes tienen el mismo diagnóstico: quemadura de primer grado.&#13;
Uno es una persona sana; el otro, un paciente diabético.&#13;
El impacto de ese problema en un paciente diabético es MAYOR (mayor riesgo de infección, mayor tiempo de recuperación).&#13;
Este elemento está destinado a permitir múltiples tipos de impacto, incluidos pero no limitado a: tratamiento clínico, funcionamiento en el hogar o vida laboral.</items><items id="description">Evaluación global del impacto o relevancia de un problema de salud para un paciente concreto.</items><items id="text">Impacto</items></items></term_definitions><term_definitions language="es-ar"><items code="at0000"><items id="comment">La delineación entre el alcance de un problema versus el diagnóstico puede no ser fácil de lograr en la práctica. A los fines de la documentación clínica mediante este arquetipo, problema y diagnóstico son considerados un continuo, donde niveles incrementales de detalles y evidencia de apoyo otorgan mas peso a la etiqueta de "diagnóstico".</items><items id="description">Detalles acerca de una condición de salud, lesión, incapacidad o cualquier otra cuerstión, univocamente identificadas, que impacta sobre el bienestar físico, mental y/o social de un individuo</items><items id="text">Problema/Diagnóstico</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*structure(en)</items></items><items code="at0002"><items id="comment">Se prefiere la codificación del nombre del problema o diagnóstico mediante una terminología cuando esto sea posible.</items><items id="description">Identificación del problema o diagnóstico, por nombre.</items><items id="text">Nombre del problema/diagnóstico</items></items><items code="at0003"><items id="comment">El uso de fechas parciales es aceptable. Si el sujeto de cuidados tiene menos de un año de edad, se requiere la fecha completa o al menos el año y mes para permitir cálculos adecuados (si por ejemplo se utiliza para guiar un apoyo a la toma de decisiones). Los datos registrados o importados como "Edad a la aparición" deberán ser convertidos a una fecha utilizando la fecha de nacimiento del sujeto.</items><items id="description">Fecha y hora estimadas o confirmadas en las cuales el diagnóstico o problema fue reconocido por el profesional de la salud.</items><items id="text">Fecha y hora del reconocimiento clínico</items></items><items code="at0005"><items id="comment">Si la severidad del problema o diagnóstico esta incluida en su nombre mediante códigos precoordinados, este dato se torna redundante. Nota: una gradación ,as específica de severidad puede ser registrada utilizando el slot de Detalles específicos.</items><items id="description">Una evaluación de la severidad general del problema o diagnóstico.</items><items id="text">Severidad</items></items><items code="at0009"><items id="comment">Utilizar para proveer trasfondo y contexto, incluyendo evolución, episodios o exacerbaciones, progreso y cualquier otro detalles relevante acerca del problema o diagnóstico.</items><items id="description">Descripción narrativa del problema o diagnóstico.</items><items id="text">Descripción clínica</items></items><items code="at0012"><items id="comment">Se prefiere la codificación de la localización anatómica mediante una terminología cuando esto sea posible.&#13;
Utilícese este dato para registrar localizaciones anatómicas precoordinadas. Si los requerimientos para el registro de una localización anatómica son determinadas en tiempo de ejecución por parte de la aplicación, o se requiere un modelado más complejo tal como una localización relativa, utilícese CLUSTER.anatomical_location or CLUSTER.relative_location dentro del slot "localización anatómica estructurada" en este arquetipo. Las ocurrencias de este dato son ilimitadas para así permitir escenarios clínicos tales como la descripción de un rash en múltiples localizaciones pero donde todos los demás atributos son idénticos. Si la localización anatómica esta incluida en el nombre del problema o diagnóstico mediante códigos precoordinados, este dato se torna redundante.</items><items id="description">Identificación de un sitio corporal simple para la localización o el problema.</items><items id="text">Sitio corporal</items></items><items code="at0030"><items id="comment">El uso de fechas parciales es aceptable. Si el sujeto de cuidados tiene menos de un año de edad, se requiere la fecha completa o al menos el año y mes para permitir cálculos adecuados (si por ejemplo se utiliza para guiar un apoyo a la toma de decisiones).</items><items id="description">Fecha y hora estimadas o confirmadas en las cuales este problema o diagnóstico remitió o se resolvió, determinadas de un profesional de la salud.</items><items id="text">Fecha/hora de resolución</items></items><items code="at0032"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0039"><items id="comment">Utilícese este slot para insertar los arqeutipos de CLUSTER.anatomical_location o CLUSTER.relative_location si los requerimientos de registro de la localización anatómica son determinados en tiempo de ejecución por la aplicación o se requiere un modelado más complejo tal como localizaciones relativas.&#13;
Si la localización anatómica está incluida en el nombre del problema o diagnóstico mediante códigos precoordinados, este dato se torna redundante.</items><items id="description">una localización anatómica estructurada para el problema o diagnóstico.</items><items id="text">Sitio corporal estructurado</items></items><items code="at0043"><items id="comment">Puede incluir detalles estructurados acerca del grado o estadificación del diagnóstico, criterios diagnósticos, criterios de clasificación o una evaluación formal de severidad tal como los Criterios Terminológicos Comunes para Eventos Adversos.</items><items id="description">Detalles adicionales requeridos para registrar como atributos unívocos del este problema o diagnóstico.</items><items id="text">Detalles específicos</items></items><items code="at0046"><items id="comment">Los calificadores de estado o contexto con cuidado ya que son variables en su utilización y la interoperabilidad no puede ser garantizada excepto en casos en que se encuentren claramente definidos en el seno de la comunidad de uso. Por ejemplo, el estado de actividad (activo, inactivo, resuelto o en remisión), el estado de evolución (inicial, interino o de trabajo, final), el estado temporal (actual, pasado), el estado episódico (primero, inicial, en curso), el estado de admisión (admisión, egreso) o el estado de prioridad (primario, secundario).</items><items id="description">Detalles estructurados para los aspectos específicos de localización, dominio, episodio o decurso del proceso diagnóstico.</items><items id="text">Estado</items></items><items code="at0047"><items id="description">El problema o diagnóstico no interfiere con la actividad normal o puede causar daños a la salud si no es tratado.</items><items id="text">Leve</items></items><items code="at0048"><items id="description">El problema o diagnóstico interfiere con la actividad normal o puede dañar la salud si no es tratado.</items><items id="text">Moderado</items></items><items code="at0049"><items id="description">El problema o diagnóstico impide la actividad normal o pude dañar seriamente la salud si no es tratado.</items><items id="text">Severo</items></items><items code="at0069"><items id="description">Narrativa adicional acerca del problema o diagnóstico que no ha sido consignada en otros campos.</items><items id="text">Comentario</items></items><items code="at0070"><items id="description">La fecha de la última actualización de este problema o diagnóstico.</items><items id="text">Última actualización.</items></items><items code="at0071"><items id="comment">Por ejemplo: requerimientos de información local o metadatos adicionales para alineamiento con equivalentes en FHIR o CIMI.</items><items id="description">Información adicional requerida para consignar contenidos locales o alinear con otros modelos de referencia o formalismos.</items><items id="text">Extensión</items></items><items code="at0072"><items id="description">Descripción narrativa del curso del problema o diagnóstico desde su aparición.</items><items id="text">Descripción del curso</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">El nivel de certeza de la identificación del diagnóstico.</items><items id="text">Certeza diagnóstica</items></items><items code="at0074"><items id="description">El diagnóstico ha sido identificado con un bajo nivel de certeza.</items><items id="text">Sospechado</items></items><items code="at0075"><items id="description">El diagnóstico ha sido identificado con un alto nivel de certeza.</items><items id="text">Probable</items></items><items code="at0076"><items id="description">El diagnóstico ha sido confirmado en base a criterios reconocidos.</items><items id="text">Confirmado</items></items><items code="at0077"><items id="comment">Los datos registrados o importados como "Edad a la aparición" deberán ser convertidos a una fecha utilizando la fecha de nacimiento del sujeto.</items><items id="description">Fecha y hora estimadas o confirmadas en las cuales los signos o síntomas del problema fueron observados por primera vez.</items><items id="text">Fecha/hora de aparición</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="comment">*Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.(en)</items><items id="description">Yksityiskohdat yksittäisestä tunnistetusta terveystilasta, vammasta, vammasta tai muusta aiheesta, joka vaikuttaa yksilön fyysiseen, henkiseen ja / tai sosiaaliseen hyvinvointiin.</items><items id="text">Ongelma/Diagnoosi</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">*Coding of the name of the problem or diagnosis with a terminology is preferred, where possible.(en)</items><items id="description">Ongelman tai diagnoosin tunnistaminen nimellä.</items><items id="text">Ongelman/Diagnoosin nimi</items></items><items code="at0003"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of clinical recognition" should be converted to a date using the subject's date of birth.(en)</items><items id="description">Arvioitu tai tarkka ajankohta ongelman tai diagnoosin toteamiselle terv.huollon ammattilaisen tekemänä</items><items id="text">Toteamispäivämäärä</items></items><items code="at0005"><items id="comment">*If severity is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant. Note: more specific grading of severity can be recorded using the Specific details SLOT.(en)</items><items id="description">Arvioitu vakavuus oireen tai diagnoosin kohdalla</items><items id="text">Vakavuus</items></items><items code="at0009"><items id="comment">*Use to provide background and context, including evolution, episodes or exacerbations, progress and any other relevant details, about the problem or diagnosis.(en)</items><items id="description">Ongelman tai diagnoosin vapaamuotoinen selitys</items><items id="text">Kliininen kuvaus</items></items><items code="at0012"><items id="comment">*Coding of the name of the anatomical location with a terminology is preferred, where possible.&#13;
Use this data element to record precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Structured anatomical location' SLOT in this archetype. Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a rash in multiple locations but where all of the other attributes are identical. If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">Yksinkertaisen vartalokohdan tunnistaminen ongelman tai diagnoosin sijaintia varten.</items><items id="text">Kehonosa</items></items><items code="at0030"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of resolution" should be converted to a date using the subject's date of birth.(en)</items><items id="description">ongelman tai diagnoosin arvioitu tai todellinen ratkaisemis- tai loppumispäivämäärä / -aika, jonka on määrittänyt terveydenhuollon ammattilainen.</items><items id="text">Toteamise pvm</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">*Use this SLOT to insert the CLUSTER.anatomical_location or CLUSTER.relative_location archetypes if the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations.&#13;
&#13;
If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, use of this SLOT becomes redundant.(en)</items><items id="description">Ongelman tai diagnoosin anatominen alue</items><items id="text">Anatominen alue</items></items><items code="at0043"><items id="comment">*May include structured detail about the grading or staging of the diagnosis; diagnostic criteria, classification criteria or formal severity assessments such as Common Terminology Criteria for Adverse Events.(en)</items><items id="description">Tiedot, joita tarvitaan lisäksi tämän ongelman tai diagnoosin yksilöivinä ominaisuuksina tallentamiseksi.</items><items id="text">Tarkennettu tieto</items></items><items code="at0046"><items id="comment">*Use status or context qualifiers with care, as they are variably used in practice and interoperability cannot be assured unless usage is clearly defined with the community of use. For example: active status - active, inactive, resolved, in remission; evolution status - initial, interim/working, final; temporal status - current, past; episodicity status - first, new, ongoing; admission status - admission, discharge; or priority status - primary, secondary.(en)</items><items id="description">Jäsennellyt yksityiskohdat diagnosointiprosessin sijainti-, alue-, jakso- tai työnkulkukohtaisista näkökohdista.</items><items id="text">Status</items></items><items code="at0047"><items id="description">Ongelma tai diagnoosi ei häiritse normaalia toimintaa tai voi aiheuttaa terveysvaurioita, jos sitä ei hoideta.</items><items id="text">Vähäinen</items></items><items code="at0048"><items id="description">Ongelma tai diagnoosi häiritsee normaalia toimintaa tai vahingoittaa terveyttä, jos sitä jätetään hoitamatta.</items><items id="text">Kohtalainen</items></items><items code="at0049"><items id="description">Ongelma tai diagnoosi estää normaalia toimintaa tai vahingoittaa vakavasti terveyttä, jos sitä jätetään hoitamatta.</items><items id="text">Vakava</items></items><items code="at0069"><items id="description">Lisätietoa ongelmasta tai diagnoosista, jota ei voi asettaa edeltäville tietokentille.</items><items id="text">Kommentti</items></items><items code="at0070"><items id="description">Ongelman tai diagnoosin viimeisin päivityspäivämäärä</items><items id="text">Viimeksi päivitetty</items></items><items code="at0071"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Laajennus</items></items><items code="at0072"><items id="description">Kuvaus ongelman tai diagnoosin etenemisestä alusta.</items><items id="text">Ongelman kulku</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">Diagnoosin tunnistamisen luotettavuus</items><items id="text">Diagnoosin varmuus</items></items><items code="at0074"><items id="description">Diagnoosi on tunnistettu alhaisella varmuustasolla.</items><items id="text">Epäilty</items></items><items code="at0075"><items id="description">Diagnoosi on tunnistettu erittäin varmuudella.</items><items id="text">Mahdollinen</items></items><items code="at0076"><items id="description">Diagnoosi on vahvistettu tunnustettujen kriteerien perusteella.</items><items id="text">Varmistettu</items></items><items code="at0077"><items id="comment">*Data captured/imported as "Age at onset" should be converted to a date using the subject's date of birth.(en)</items><items id="description">Arvioitu tai todellinen päivämäärä / aika, jolloin ongelman / diagnoosin merkkejä tai oireita havaittiin ensimmäisen kerran.</items><items id="text">Alkamis pvm</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="fr"><items code="at0000"><items id="comment">Dans la pratique, il n’est pas facile d’établir une distinction claire entre la portée d’un problème et celle d’un diagnostic. Aux fins de la documentation clinique avec cet archétype, le problème et le diagnostic sont considérés comme un continuum, où des niveaux croissants de détail et de preuves à l’appui confèrent généralement plus de poids à la notion de « diagnostic ».</items><items id="description">Informations détaillées concernant un état de santé, une blessure, un handicap ou tout autre problème identifié ayant une incidence sur le bien-être physique, mental et/ou social d’une personne.</items><items id="text">Problème/Diagnostic</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Dans la mesure du possible, il est préférable de coder le nom du problème ou du diagnostic à l’aide d’une terminologie.</items><items id="description">Identification du problème ou du diagnostic, par son nom.</items><items id="text">Nom du problème/diagnostic</items></items><items code="at0003"><items id="comment">Les dates partielles sont acceptables. Si la personne prise en charge est âgée de moins d’un an, la date complète ou, au minimum, le mois et l’année sont nécessaires pour permettre un calcul précis de l’âge – par exemple, si ces informations sont utilisées pour l’aide à la décision. Les données saisies/importées sous la forme « Âge au moment du diagnostic clinique » doivent être converties en une date à partir de la date de naissance de la personne.</items><items id="description">Date/heure estimées ou réelles auxquelles le diagnostic ou le problème a été reconnue par un professionnel de santé.</items><items id="text">Date/heure de reconnaissance clinique</items></items><items code="at0005"><items id="comment">Si le degré de gravité est inclus dans le nom du problème/diagnostic via des codes précoordonnés, cet élément de données devient redondant. Remarque : une classification plus précise du degré de gravité peut être consignée à l’aide du slot « Détails spécifiques ».</items><items id="description">Évaluation de la gravité globale du problème ou du diagnostic.</items><items id="text">Gravité</items></items><items code="at0009"><items id="comment">À utiliser pour fournir des informations générales et le contexte, notamment l’évolution, les épisodes ou les exacerbations, les progrès et tout autre détail pertinent, concernant le problème ou le diagnostic.</items><items id="description">Description narrative du problème ou du diagnostic.</items><items id="text">Description clinique</items></items><items code="at0012"><items id="comment">Dans la mesure du possible, il est préférable de coder le nom de la localisation anatomique à l’aide d’une terminologie.&#13;
Utilisez cet élément de données pour enregistrer des localisations anatomiques précoordonnées. Si les exigences relatives à l’enregistrement de la localisation anatomique sont déterminées au moment de l’exécution par l’application ou nécessitent une modélisation plus complexe, telle que des localisations relatives, utilisez alors les éléments CLUSTER.anatomical_location ou CLUSTER.relative_location au sein du SLOT « Localisation anatomique structurée » de cet archétype. Le nombre d’occurrences de cet élément de données est illimité afin de permettre des scénarios cliniques tels que la description d’une éruption cutanée à plusieurs emplacements, mais où tous les autres attributs sont identiques. Si l’emplacement anatomique est inclus dans le nom du problème/diagnostic via des codes précoordonnés, cet élément de données devient redondant.</items><items id="description">Identification d’une simple partie du corps où se situe le problème ou le diagnostic.</items><items id="text">Site corporel</items></items><items code="at0030"><items id="comment">Les dates partielles sont acceptables. Si la personne prise en charge est âgée de moins d’un an, la date complète ou, au minimum, le mois et l’année sont nécessaires pour permettre un calcul précis de l’âge – par exemple, si ces informations sont utilisées pour l’aide à la décision. Les données saisies ou importées sous la forme « Âge au moment de la résolution » doivent être converties en date à l’aide de la date de naissance de la personne concernée.</items><items id="description">Date/heure estimées ou réelles de la résolution ou de la rémission de ce problème ou de ce diagnostic, telles que déterminées par un professionnel de santé.</items><items id="text">Date/heure de résolution</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Utilisez ce SLOT pour insérer les archétypes CLUSTER.anatomical_location ou CLUSTER.relative_location si les exigences relatives à l’enregistrement de la localisation anatomique sont déterminées au moment de l’exécution par l’application ou nécessitent une modélisation plus complexe, telle que les localisations relatives.&#13;
&#13;
Si la localisation anatomique est incluse dans le nom du problème/diagnostic via des codes précoordonnés, l’utilisation de ce SLOT devient superflue.</items><items id="description">Localisation anatomique structurée du problème ou du diagnostic.</items><items id="text">Site corporel structuré</items></items><items code="at0043"><items id="comment">Peut inclure des détails structurés concernant la classification ou le stade du diagnostic ; les critères diagnostiques, les critères de classification ou les évaluations formelles de la gravité, telles que les « Common Terminology Criteria for Adverse Events » (Critères terminologiques communs pour les événements indésirables).</items><items id="description">Détails supplémentaires à enregistrer en tant qu’attributs spécifiques à ce problème ou à ce diagnostic.</items><items id="text">Détails spécifiques</items></items><items code="at0046"><items id="comment">Utilisez les qualificatifs de statut ou de contexte avec prudence, car leur usage varie dans la pratique et l’interopérabilité ne peut être garantie que si leur utilisation est clairement définie au sein de la communauté d’utilisateurs. Par exemple : statut d’activité – actif, inactif, résolu, en rémission ; statut d’évolution – initial, intermédiaire/en cours, final ; statut temporel – actuel, passé ; statut d’épisodicité – premier, nouveau, en cours ; statut d’admission – admission, sortie ; ou statut de priorité – primaire, secondaire.</items><items id="description">Informations structurées concernant les aspects du processus diagnostique liés au lieu, au domaine, à l’épisode ou au flux de travail.</items><items id="text">Statut</items></items><items code="at0047"><items id="description">Le problème ou le diagnostic n’entrave pas l’activité normale, mais peut nuire à la santé s’il n’est pas traité.</items><items id="text">Légère</items></items><items code="at0048"><items id="description">Le problème ou le diagnostic perturbe le déroulement normal des activités ou, s’il n’est pas traité, risque de nuire à la santé.</items><items id="text">Modéré</items></items><items code="at0049"><items id="description">Le problème ou le diagnostic empêche l’activité normale ou portera gravement atteinte à la santé s’il n’est pas traité.</items><items id="text">Grave</items></items><items code="at0069"><items id="description">Description complémentaire du problème ou du diagnostic non reprise dans d’autres champs.</items><items id="text">Commentaire</items></items><items code="at0070"><items id="description">Date de la dernière mise à jour de ce problème ou de ce diagnostic.</items><items id="text">Dernière mise à jour</items></items><items code="at0071"><items id="comment">Par exemple: exigences d’information locales ou métadonnées supplémentaires permettant l’alignement avec des équivalents FHIR ou CIMI.</items><items id="description">Informations supplémentaires nécessaires pour représenter un contenu local ou pour assurer l’alignement avec d’autres modèles de référence ou formalismes.</items><items id="text">Extension</items></items><items code="at0072"><items id="description">Description narrative de l'évolution du problème ou du diagnostic depuis son apparition.</items><items id="text">Description du cours</items></items><items code="at0073"><items id="comment">Si un ensemble de valeurs alternatif est nécessaire, ces valeurs peuvent être ajoutées au type de données DV_TEXT dans un template.</items><items id="description">Le niveau de confiance dans l’identification du diagnostic.</items><items id="text">Certitude diagnostique</items></items><items code="at0074"><items id="description">Le diagnostic a été établi avec un faible degré de certitude.</items><items id="text">Soupçonné</items></items><items code="at0075"><items id="description">Le diagnostic a été établi avec un haut degré de certitude.</items><items id="text">Probable</items></items><items code="at0076"><items id="description">Le diagnostic a été confirmé au regard de critères reconnus.</items><items id="text">Confirmé</items></items><items code="at0077"><items id="comment">Les données saisies ou importées sous la rubrique « Âge au moment de l'apparition » doivent être converties en date à partir de la date de naissance de la personne concernée.</items><items id="description">Date/heure estimées ou réelles auxquelles les signes ou symptômes du problème ou du diagnostic ont été observés pour la première fois.</items><items id="text">Date/heure d'apparition</items></items><items code="at0078"><items id="comment">Également appelé « étiologie ». Le codage à l’aide d’une terminologie externe est privilégié, dans la mesure du possible.</items><items id="description">Une cause, un ensemble de causes ou un mécanisme de causalité du problème ou du diagnostic.</items><items id="text">Cause</items></items><items code="at0079"><items id="comment">Par exemple : « neuropathie axonale motrice aiguë » en tant que variante du syndrome de Guillain-Barré. Dans la mesure du possible, il est préférable de coder le nom de la variante à l’aide d’une terminologie.</items><items id="description">Variante ou sous-type spécifique du diagnostic, le cas échéant.</items><items id="text">Variante</items></items><items code="at0080"><items id="comment">Un même diagnostic, d’une même gravité, a un impact différent sur chaque patient. Ce critère de pertinence implique d’ajuster l’impact global de ce problème de santé en fonction des caractéristiques du patient.&#13;
Par exemple : deux patients ont le même diagnostic : une brûlure au premier degré.&#13;
L’un est en bonne santé, l’autre est diabétique.&#13;
L’impact de ce problème chez un patient diabétique est PLUS ÉLEVÉ (risque accru d’infection…, temps de guérison plus long).&#13;
Cet élément vise à prendre en compte plusieurs types d’impact, notamment, mais sans s’y limiter : le traitement clinique, le fonctionnement au quotidien, la vie professionnelle.</items><items id="description">Évaluation globale de l’impact d’un problème de santé sur le patient concerné.</items><items id="text">Impact</items></items></term_definitions><term_definitions language="it"><items code="at0000"><items id="comment">Nella pratica, non è facile fare una distinzione netta tra gli ambiti dei concetti 'problema' e 'diagnosi'. Ai fini della documentazione clinica con questo archetipo, problema e diagnosi sono considerati un continuum, con livelli crescenti di dettagli ed evidenze a supporto a supporto dell'etichetta 'diagnosi'.</items><items id="description">Dettagli su una specifica condizione di salute, una lesione, una disabilità o un qualsiasi altro problema individuato su un individuo che abbia un impatto sul benessere fisico, mentale e/o sociale.</items><items id="text">Problema/Diagnosi</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Si preferisce, ove possibile, la codifica del problema o diagnosi con una terminologia.</items><items id="description">Nome/identificativo del problema o della diagnosi.</items><items id="text">Nome del problema/diagnosi</items></items><items code="at0003"><items id="comment">Sono accettabili le date parziali. Se il soggetto ha età inferiore ad un anno, sono necessari la data completa o almeno il mese e l'anno per permettere un calcolo accurato dell'età - ad esempio, se utilizzato per guidare il supporto decisionale. I dati acquisiti/importati come 'Età al momento del riconoscimento clinico' dovrebbero essere convertiti in una data usando la data di nascita del soggetto.</items><items id="description">Data/ora, stimate o effettive, in cui la diagnosi o il problema sono stati riconosciuti da un operatore sanitario.</items><items id="text">Data/ora di riconoscimento clinico</items></items><items code="at0005"><items id="comment">Se la severità è inclusa nel campo 'Nome del problema/diagnosi' attraverso una codifica prestabilita, questo elemento risulta ridondante. Nota: una classificazione più specifica della severità può essere memorizzata usando lo SLOT 'Dettagli specifici'.</items><items id="description">Una valutazione generale della severità del problema o della diagnosi.</items><items id="text">Severità</items></items><items code="at0009"><items id="comment">Utilizzare questo campo per fornire il background e il contesto, compresa l'evoluzione, gli episodi o le esacerbazioni, i progressi e qualsiasi altro dettaglio rilevante circa il problema o la diagnosi.</items><items id="description">Descrizione narrativa del problema o della diagnosi.</items><items id="text">Descrizione clinica</items></items><items code="at0012"><items id="comment">Si preferisce, ove possibile, la codifica del sito anatomico con una terminologia.  Utilizzare questo campo per memorizzare posizioni anatomiche precoordinate. Se i requisiti per la registrazione della localizzazione sono determinati in fase di esecuzione dell'applicazione  (run-time) o se richiedono una modellazione più complessa, come ad esempio le posizioni relative, allora utilizzare gli archetipi CLUSTER.anatomical_location o CLUSTER.relative_location all'interno dello SLOT di questo archetipo 'Dettagli strutturati del sito corporeo'.  Questo campo non ha limite sulle occorrenze per essere adattabile a scenari clinici come la descrizione di un'eruzione cutanea che coinvolge più siti corporei, ma dove tutti gli altri attributi sono identici. Se la posizione anatomica è inclusa nel campo 'Nome del problema/diagnosi attraverso una codifica prestabilita, questo elemento risulta ridondante.</items><items id="description">Identificativo di un semplice sito corporeo per per la localizzazione del problema o della diagnosi.</items><items id="text">Sito corporeo</items></items><items code="at0030"><items id="comment">Sono accettabili le date parziali. Se il soggetto ha età inferiore ad un anno, sono necessari la data completa o almeno il mese e l'anno per permettere un calcolo accurato dell'età - ad esempio, se utilizzato per guidare il supporto decisionale. I dati acquisiti/importati come 'Età al momento della risoluzione' dovrebbero essere convertiti in una data usando la data di nascita del soggetto.</items><items id="description">Data/ora, stimate o effettive, della risoluzione o remissione del problema o della diagnosi come determinato da un operatore sanitario.</items><items id="text">Data/ora di risoluzione</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Usare questo SLOT per inserire gli archetipi CLUSTER.anatomical_location o CLUSTER.relative_location se i requisiti per la registrazione della localizzazione sono determinati in fase di esecuzione dell'applicazione  (run-time) o se richiedono una modellazione più complessa, come ad esempio per le posizioni relative. Se la posizione anatomica è inclusa nel campo 'Nome del problema/diagnosi attraverso una codifica prestabilita, questo elemento risulta ridondante.</items><items id="description">Una descrizione strutturata della localizzazione anatomica a cui il problema o la diagnosi si riferiscono.</items><items id="text">Dettagli strutturati del sito corporeo</items></items><items code="at0043"><items id="comment">Può includere dettagli strutturati sulla classificazione o la stadiazione della diagnosi; criteri diagnostici, criteri di classificazione o valutazioni formali della severità, come ad esempio CTCAE - Common Terminology Criteria for Adverse Events.</items><items id="description">Ulteriori dettagli richiesti per memorizzare attributi specifici del problema o della diagnosi.</items><items id="text">Ulteriori dettagli</items></items><items code="at0046"><items id="comment">L'uso di qualificatori per indicare lo stato o il contesto dovrebbe essere fatto con attenzione, in quanto il loro utilizzo varia nella pratica e l'interoperabilità non può essere garantita a meno che l'utilizzo di quei codici non sia universalmente accettato dalla comunità. Ad esempio: stato attivo - attivo, inattivo, risolto, in remissione; stato evolutivo - iniziale, intermedio/in progressione, finale; stato temporale - attuale, passato; stato di episodicità - primo, nuovo, in corso; stato di ammissione - ammissione, dimissione; o stato di priorità - primario, secondario.</items><items id="description">Dettagli strutturati per descrivere aspetti del processo diagnostico specifici in relazione alla localizzazione, dominio, episodio o workflow.</items><items id="text">Stato</items></items><items code="at0047"><items id="description">Il problema o la diagnosi non interferiscono con la normale attività o potrebbero causare problemi di salute salute se non trattati.</items><items id="text">Lieve</items></items><items code="at0048"><items id="description">Il problema o la diagnosi interferiscono con la normale attività o causerebbero problemi di salute se non trattati.</items><items id="text">Moderato</items></items><items code="at0049"><items id="description">Il problema o la diagnosi impediscono la normale attività o causerebbero problemi di salute importanti se non trattati.</items><items id="text">Severo</items></items><items code="at0069"><items id="description">Informazioni aggiuntive sul problema o diagnosi non catturate in altri campi.</items><items id="text">Commento</items></items><items code="at0070"><items id="description">La data in cui questo record di Problema/Diagnosi è stato aggiornato l'ultima volta.</items><items id="text">Ultimo aggiornamento</items></items><items code="at0071"><items id="comment">Ad esempio: requisiti informativi locali o metadati addizionali per l'allineamento ai corrispondenti modelli FHIR o CIMI.</items><items id="description">Informazioni aggiuntive necessarie per registrare specifici contenuti locali o per allinearsi con altri modelli/formalismi di riferimento.</items><items id="text">Estensione</items></items><items code="at0072"><items id="description">Descrizione testuale del decorso del problema o della diagnosi a partire dall'insorgenza.</items><items id="text">Decorso</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">Grado di certezza nell'identificazione della diagnosi.</items><items id="text">Certezza diagnostica</items></items><items code="at0074"><items id="description">La diagnosi è identificata con un basso livello di certezza.</items><items id="text">Sospetto</items></items><items code="at0075"><items id="description">La diagnosi è identificata con un alto livello di certezza.</items><items id="text">Probabile</items></items><items code="at0076"><items id="description">La diagnosi è stata confermata in base a criteri riconosciuti.</items><items id="text">Confermato</items></items><items code="at0077"><items id="comment">I dati acquisiti/importati come 'Età al momento dell'insorgenza' dovrebbero essere convertiti in una data usando la data di nascita del soggetto.</items><items id="description">Data/ora, stimate o effettive, in cui sono stati per la prima volta osservati i sintomi del problema/diagnosi.</items><items id="text">Data/ora di insorgenza</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="ko"><items code="at0000"><items id="comment">실무에서 문제와 진단의 범위 간의 명확한 구분을 하기 쉽지 않음. 이 아키타입을 통한 임상 문서의 목적을 위해서, 증가하는 상세내용의 수준과 일반적으로 '진단'의 표시에 대한 무게감을 제공하는 지지할 수 있는 증거를 가지고, 문제와 진단은 연속된 것(a continuum)으로 간주됨.</items><items id="description">한 개인의 신체, 정신 그리고/또는 사회적 웰빙에 영향을 주는 단일한 확인된 건강 성태, 상해, 장애 또는 다른 이슈에 대한 상세내용.</items><items id="text">문제/진단</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">가능하다면, 용어체계를 통한 문제 또는 진단의 명칭을 코딩하는 것이 좋음.</items><items id="description">명칭으로 문제 또는 진단의 식별.</items><items id="text">문제/진단명</items></items><items code="at0003"><items id="comment">부분 날짜도 허용됨. 진료의 주체가 한 살 이하이면, 완전한 날짜 또는 달과 년의 하한이 정확한 나이 계산을 위해 필요함 - 예를 들어, 의사결정지원을 사용하는 경우. \"임상적으로 인지된 시점의 나이\"로 획득/입력된 데이터는 진료의 주체의 생일을 이용해 날짜로 변환되어야 함.</items><items id="description">진단 또는 문가가 헬스케어 전문가에게 인지된 추정 또는 실제 날짜/시간.</items><items id="text">임상적으로 인지된 날짜/시간</items></items><items code="at0005"><items id="comment">중증도가 선조합코드로 문제/진단 내에 포함된다면, 이 데이터 엘레먼트는 중복이 됨. 주의 : 더 상세한 중증도 등급은 Specific details SLOT을 이용해 기록할 수 있음.</items><items id="description">문제 또는 진단의 전반적인 중증도 평가.</items><items id="text">중증도</items></items><items code="at0009"><items id="comment">문제와 진단에 대한 진화(evolution)와 에피소드 또는 악화, 경과를 포함한 배경과 문액 그리고 다른 관련된 상세내용을 제공하는데 사용함.</items><items id="description">문제 또는 진단에 대한 서술 기록.</items><items id="text">임상적 서술</items></items><items code="at0012"><items id="comment">가능하다면, 용어체계를 통한 해부학적 위치의 명칭을 코딩하는 것이 좋음.&#13;
이 데이터 엘리먼트에 선조합된 해부학적 위치를 사용. 해부학적 위치를 기록하기 위한 요구사항이 애플리케이션 실행 때 결정되거나 또는 상대적인 위치와 같은 더 복잡한 모델링을 요구한다면, 이 아키타입의 'Structured anatomical location' SLOT 내의 CLUSTER.anatomical_location 또는 CLUSTER.relative_location를 이용. 이 데이터 엘리먼트을 위한 Occurrences는 여러 위치에 생긴 발진(rash)을 기술하는 것과 같은 임상 시나리오를 허용하는데 제한이 없지만 모든 다른 속성(attributes)은 동일해야 함. 해부학적 위치가 문제/진단명에 선조합코드로 포함된다면 이 데이터 엘리먼트는 중복이 됨.</items><items id="description">문제 또는 진단의 위치를 위해 간단한 신체 위치 확인</items><items id="text">신체 위치</items></items><items code="at0030"><items id="comment">부분 날짜는 허용됨. 진료의 주체가 한 살 이하면, 완전한 날짜 또는 달과 년의 하한이 정확한 나이 계산을 위해 필요함 - 예를 들어, 의사결정지원을 사용하는 경우. \"임상적으로 인지된 시점의 나이\"로 획득/입력된 데이터는 진료의 주체의 생일을 이용해 날짜로 변환되어야 함.</items><items id="description">헬스케어 전문가에 의해 결정된 이 문제나 진단의 추정 또는 실제 완치 또는 관해 날짜시간.</items><items id="text">완치 날짜/시간</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">해부학적 위치를 기록하기 위한 요구사항이 애플리케이션 실행 때 결정되거나 또는 상대적인 위치와 같은 더 복잡한 모델링을 요구한다면, 이 아키타입의 SLOT에 CLUSTER.anatomical_location 또는 CLUSTER.relative_location를 삽입하여 이용&#13;
&#13;
해부학적 위치가 문제/진단명에 선조합코드로 포함된다면 이 슬롯의 사용은 중복이 됨.</items><items id="description">문제 또는 진단을 위한 구조화된 해부학적 위치</items><items id="text">구조화된 신체 위치</items></items><items code="at0043"><items id="comment">진단의 단계(grading 또는 staging)에 대한 구조화된 상세내용을 포함할 수 있음; 진단 기준, 분류 기준 또는 이상 상황(Adverse Events)을 위한 공통 용어체계 기준(Common Terminology Criteria)와 같은 정규적인 중등도 평가.</items><items id="description">이 문제 또는 진단의 유일한 속성으로 기록하는데 필요한 상세내용.</items><items id="text">특정 상세내용</items></items><items code="at0046"><items id="comment">사용법이 사용하는 곳에서 명확히 정의되지 않으면, 실무에서 다양하게 사용되고 상호운용성을 확신할 수 없는 것과 마찬가지로 진료에서 상태 또는 문맥 한정자를 사용. 예를 들어: 활성 상태(active status) - 활성(active), 비활성(inactive), 치료됨(resolved), 관해 상태(in remission); 진화 상태(evolution status) - 초기(initial), 작업중(interim/working), 완료(final); 시간 상태(temporal status) - 현재(current), 과거(past); 에피소드 상태(episodicity status) - 처음(first), 새로(new), 진행중(ongoing); 입퇴원 상태(admission status) - 입원(admission), 퇴원(discharge); 또는 우선순위 상태(priority status) - 일차(primary), 이차(secondary).</items><items id="description">진단 과정의 위치-, 도메인-, 에피소드- 또는 워크플로우-특징적인 측면에 대한 구조화된 상세내용.</items><items id="text">상태</items></items><items code="at0047"><items id="description">문제나 진단이 정상 활동을 방해하지 않거나 치료하지 않으면 건강에 해를 일으킬 수 있음.</items><items id="text">경도</items></items><items code="at0048"><items id="description">문제나 진단이 정상 활동에 방해가 되거나 치료하지 않으면 건강에 해가 됨.</items><items id="text">중등도</items></items><items code="at0049"><items id="description">문제나 진단이 정상 활동을 할 수 없게 하거나 치료하지 않으면 건강에 심각한 해가 됨.</items><items id="text">증증도</items></items><items code="at0069"><items id="description">다른 필드에서 획득되지 않은 문제 또는 진단에 대한 추가적인 서술내용</items><items id="text">코멘트</items></items><items code="at0070"><items id="description">문제 또는 진단이 최종 업데이트된 날짜.</items><items id="text">최종 업데이트 날짜</items></items><items code="at0071"><items id="comment">예: 로컬 정보 요구사항 또는 FHIR 또는 CIMI의 동등한 것과 조율하기위한 추가적인 메타데이터.</items><items id="description">로컬 컨텐트를 획득하거나 다른 참조모델/표기형식과 조율하기 위해 필요한 추가적인 정보.</items><items id="text">확장</items></items><items code="at0072"><items id="description">발병이후 문제 또는 진단의 결과에 대한 서술.</items><items id="text">경과 서술</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">진단을 확인하는 신뢰의 수준.</items><items id="text">진단적 확실성</items></items><items code="at0074"><items id="description">진단이 낮은 확신 수준으로 식별됨.</items><items id="text">의심</items></items><items code="at0075"><items id="description">진단이 높은 확신 수준으로 식별됨.</items><items id="text">추정</items></items><items code="at0076"><items id="description">진단이 인정된 기준에 대해 확진됨.</items><items id="text">확진</items></items><items code="at0077"><items id="comment">\"발병 나이\"로 획득/입력된 데이터는 진료의 주체의 생일을 이용해 날짜로 변환되어 함.</items><items id="description">문제/진단의 증상 또는 징후가 처음 관찰된 추정 또는 실제 날짜/시간.</items><items id="text">발병 날짜/시간</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="comment">Det er i praksis ikke lett å oppnå et klart skille mellom et problem og en diagnose. I klinisk dokumentasjon med denne arketypen ses problem og diagnose som et kontinuum, med økende krav til detaljer og støttende evidens for å underbygge en diagnose.</items><items id="description">Detaljer om én identifisert helsetilstand, skade, funksjonshemming eller annet forhold som påvirker et individs fysiske, mentale og/eller sosiale velvære.</items><items id="text">Problem/diagnose</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Koding av navnet på problemet eller diagnosen med en terminologi er foretrukket hvis mulig.</items><items id="description">Identifisering av problemet eller diagnosen ved hjelp av navn.</items><items id="text">Problem/diagnosenavn</items></items><items code="at0003"><items id="comment">Delvise datoer er tillatt. Dersom individet er under ett år gammel, må komplett dato eller som et minimum måned og år oppgis for å muliggjøre presise beregninger av alder, f.eks. ved bruk i beslutningsstøttesystemer. Data registrert eller importert som "alder ved tidspunkt når diagnosen stilles" bør konverteres til en dato ved hjelp av individets fødselsdato.</items><items id="description">Anslått eller faktisk dato/tid da diagnosen eller problemet ble bekreftet av helsepersonell.</items><items id="text">Dato/tid for klinisk bekreftelse</items></items><items code="at0005"><items id="comment">Dersom alvorlighetsgrad inkluderes i feltet "Problem/diagnosenavn" via prekoordinerte koder blir dette dataelementet overflødig. Merk: Mer spesifikk gradering av alvorlighetsgrad kan registreres ved å bruke SLOTet "Spesifikke detaljer"</items><items id="description">En vurdering av problemet eller diagnosens overordnede alvorlighetsgrad.</items><items id="text">Alvorlighetsgrad</items></items><items code="at0009"><items id="comment">Brukes til å gi bakgrunn og kontekst, inkludert utvikling, episoder eller forverringer, fremgang og alle andre relevante detaljer, om problemet eller diagnosen.</items><items id="description">Fritekstbeskrivelse av problemet eller diagnosen.</items><items id="text">Klinisk beskrivelse</items></items><items code="at0012"><items id="comment">Koding av navnet på den anatomiske lokaliseringen ved hjelp av en terminologi er foretrukket når dette er mulig. &#13;
Bruk dette dataelementet for å registrere prekoordinerte anatomiske lokaliseringer. Dersom behovene for å registrere anatomisk sted bestemmes i applikasjonen eller trenger større grad av kompleksitet som f.eks. relativ lokalisering, er det anbefalt å bruke CLUSTER.anatomical_location eller CLUSTER.relative_location innenfor SLOTet "Strukturert anatomisk lokalisering" i denne arketypen. Dette dataelementet kan ha ubegrenset antall forekomster, for å gjøre det mulig å registrere kliniske scenarier som f.eks. å beskrive et utslett som opptrer flere steder på kroppen, men der alle andre attributter er identiske. Dersom den anatomiske lokaliseringen inkluderes i feltet "Problem/diagnosenavn" via prekoordinerte koder blir dette dataelementet overflødig.</items><items id="description">Registrering av et enkelt og usammensatt anatomisk sted der problemet eller diagnosen er lokalisert.</items><items id="text">Anatomisk lokalisering</items></items><items code="at0030"><items id="comment">Delvise datoer er tillatt. Dersom individet er under ett år gammel, må komplett dato eller som et minimum måned og år oppgis for å muliggjøre presise beregninger av alder, f.eks. ved bruk i beslutningsstøttesystemer.&#13;
Data registrert eller importert som "alder ved bedring" bør konverteres til en dato ved hjelp av individets fødselsdato.</items><items id="description">Estimert eller faktisk dato/tid for bedring eller remisjon av det aktuelle problemet eller diagnosen, fastslått av helsepersonell.</items><items id="text">Dato/tid for bedring/remisjon</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Dersom behovene for å registrere anatomisk sted bestemmes i applikasjonen eller trenger større grad av kompleksitet som f.eks. relativ lokalisering, er det anbefalt å bruke CLUSTER.anatomical_location eller CLUSTER.relative_location i dette SLOTet. &#13;
&#13;
Dersom den anatomiske lokaliseringen inkluderes i feltet "Problem/diagnosenavn" via prekoordinerte koder blir dette dataelementet overflødig.</items><items id="description">SLOT som kan inneholde en eller flere detaljerte og strukturerte anatomiske lokaliseringer.</items><items id="text">Strukturert anatomisk lokalisering</items></items><items code="at0043"><items id="comment">Kan omfatte strukturerte detaljer om klassifisering eller stadier av diagnosen; diagnosiske kriterier, klassifikasjon eller formelle vurderinger av alvorlighetsgrad, som f.eks. Common Terminology Criteria for Adverse Events.</items><items id="description">Detaljer som er nødvendige for å registrere det aktuelle problemet eller diagnosens unike egenskaper.</items><items id="text">Spesifikke detaljer</items></items><items code="at0046"><items id="comment">Bruk status eller kontekstkvalifikatorer med omhu, da bruken varierer og interoperabilitet kan ikke garanteres med mindre bruken er klart definert innen miljøet som bruker dem. F.eks. aktiv status - aktiv, inaktiv, løst, i bedring; utviklingsstatus - første, midlertidig, endelig; tidsstatus - nåværende, tidligere; episodisk status - første, ny, pågående; innleggelsesstatus - innleggelse, utskriving; eller prioritetsstatus - primær, sekundær.</items><items id="description">Strukturerte detaljer for lokalisering-, fagområde-, episode- eller arbeidsflytsspesifikke aspekter av den diagnostiske prosessen.</items><items id="text">Status</items></items><items code="at0047"><items id="description">Problemet eller diagnosen forstyrrer ikke normal aktivitet.</items><items id="text">Mild</items></items><items code="at0048"><items id="description">Problemet eller diagnosen forstyrrer normal aktivitet.</items><items id="text">Moderat</items></items><items code="at0049"><items id="description">Problemet eller diagnosen forhindrer normal aktivitet.</items><items id="text">Alvorlig</items></items><items code="at0069"><items id="description">Utdypende fritekst om problemet eller diagnosen, som ikke passer i andre felt.</items><items id="text">Kommentar</items></items><items code="at0070"><items id="description">Datoen da problemet eller diagnosen sist ble oppdatert.</items><items id="text">Sist oppdatert</items></items><items code="at0071"><items id="comment">For eksempel lokale informasjonsbehov, eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at0072"><items id="description">Fritekstbeskrivelse av forløpet av problemet eller diagnosen siden debut.</items><items id="text">Forløpsbeskrivelse</items></items><items code="at0073"><items id="comment">Hvis et alternativt verdisett er nødvendig, kan disse verdiene legges til DV_TEXT-datatypen i et templat.</items><items id="description">Grad av sikkerhet i identifikasjonen av diagnosen.</items><items id="text">Diagnostisk sikkerhet</items></items><items code="at0074"><items id="description">Diagnoses er identifisert med en lav grad av sikkerhet.</items><items id="text">Mistenkt</items></items><items code="at0075"><items id="description">Diagnosen er identifisert med en stor grad av sikkerhet.</items><items id="text">Sannsynlig</items></items><items code="at0076"><items id="description">Diagnosen er bekreftet opp mot anerkjente kriterier.</items><items id="text">Bekreftet</items></items><items code="at0077"><items id="comment">Data registrert eller importert som "alder ved debut" bør konverteres til en dato ved hjelp av individets fødselsdato.</items><items id="description">Antatt eller faktisk dato/tid da tegn eller symptomer på problemet eller diagnosen først ble observert.</items><items id="text">Dato/ tid for debut</items></items><items code="at0078"><items id="comment">Også kjent som 'etiologi'. Det anbefales å kode "Årsak" med en ekstern terminologi dersom det er mulig.</items><items id="description">En årsak, kjede av årsaker til, eller hendelsesforløp forut for problemet eller diagnosen.</items><items id="text">Årsak</items></items><items code="at0079"><items id="comment">For eksempel "akutt motorisk aksonal nevropati" som en variant av Guillain-Barre Syndrom. Koding av navnet på varianten med en terminologi er foretrukket hvis mulig.</items><items id="description">Spesifikk variant eller subtype av diagnose, hvis det er relevant.</items><items id="text">Variant</items></items><items code="at0080"><items id="comment">Den samme diagnosen, med samme alvorlighetsgrad, kan ha ulik innvirkning på ulike pasienter. Denne relevanskvalifikatoren innebærer å justere den totale påvirkningen av helseproblemet basert på pasientens individuelle medisinske og funksjonelle forutsetninger. For eksempel: To pasienter har samme diagnose – en førstegradsforbrenning. Den ene er frisk, den andre har diabetes. Innvirkningen for en diabetiker er høyere (større risiko for infeksjon, lengre tilhelingstid osv.). Dette elementet er ment å åpne for registrering av flere typer påvirkning, for eksempel innen klinisk behandling, funksjonsevne i hjemmet eller arbeidsliv.</items><items id="description">Overordnet vurdering av innvirkningen et helseproblem har for individet.</items><items id="text">Innvirkning</items></items></term_definitions><term_definitions language="nl"><items code="at0000"><items id="comment">*Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.(en)</items><items id="description">Informatie over een enkele vast te stellen medische aandoening, een letsel, beperking of andere zaak die invloed heeft op de fysieke, mentale en/of het sociale welbevinden van een individu.</items><items id="text">Probleem/Diagnose</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*structure(en)</items></items><items code="at0002"><items id="comment">*Coding of the name of the problem or diagnosis with a terminology is preferred, where possible.(en)</items><items id="description">Identificatie van het probleem of de diagnose bij naam.&#13;
                            </items><items id="text">Naam van het probleem / de diagnose</items></items><items code="at0003"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of clinical recognition" should be converted to a date using the subject's date of birth.(en)</items><items id="description">Geschatte of werkelijke datum/tijd waarop het probleem of de diagnose is herkend door een zorgprofessional.</items><items id="text">Datum/tijd van klinische herkenning</items></items><items code="at0005"><items id="comment">*If severity is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant. Note: more specific grading of severity can be recorded using the Specific details SLOT.(en)</items><items id="description">*An assessment of the overall severity of the problem or diagnosis.(en)</items><items id="text">*Severity(en)</items></items><items code="at0009"><items id="comment">*Use to provide background and context, including evolution, episodes or exacerbations, progress and any other relevant details, about the problem or diagnosis.(en)</items><items id="description">Verhalende beschrijving van het probleem of de diagnose.</items><items id="text">Klinische beschrijving</items></items><items code="at0012"><items id="comment">*Coding of the name of the anatomical location with a terminology is preferred, where possible.&#13;
Use this data element to record precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Structured anatomical location' SLOT in this archetype. Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a rash in multiple locations but where all of the other attributes are identical. If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">Identificatie van een eenvoudig lichaamsdeel voor de lokatie van het probleem of de diagnose.</items><items id="text">Lichaamsdeel</items></items><items code="at0030"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of resolution" should be converted to a date using the subject's date of birth.(en)</items><items id="description">*Estimated or actual date/time of resolution or remission for this problem or diagnosis, as determined by a healthcare professional.(en)</items><items id="text">*Date/time of resolution(en)</items></items><items code="at0032"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0039"><items id="comment">*Use this SLOT to insert the CLUSTER.anatomical_location or CLUSTER.relative_location archetypes if the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations.&#13;
&#13;
If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, use of this SLOT becomes redundant.(en)</items><items id="description">*A structured anatomical location for the problem or diagnosis.(en)</items><items id="text">*Structured body site(en)</items></items><items code="at0043"><items id="comment">*May include structured detail about the grading or staging of the diagnosis; diagnostic criteria, classification criteria or formal severity assessments such as Common Terminology Criteria for Adverse Events.(en)</items><items id="description">*Details that are additionally required to record as unique attributes of this problem or diagnosis.(en)</items><items id="text">*Specific details(en)</items></items><items code="at0046"><items id="comment">*Use status or context qualifiers with care, as they are variably used in practice and interoperability cannot be assured unless usage is clearly defined with the community of use. For example: active status - active, inactive, resolved, in remission; evolution status - initial, interim/working, final; temporal status - current, past; episodicity status - first, new, ongoing; admission status - admission, discharge; or priority status - primary, secondary.(en)</items><items id="description">*Structured details for location-, domain-, episode- or workflow-specific aspects of the diagnostic process.(en)</items><items id="text">*Status(en)</items></items><items code="at0047"><items id="description">*The problem or diagnosis does not interfere with normal activity or may cause damage to health if left untreated.(en)</items><items id="text">*Mild(en)</items></items><items code="at0048"><items id="description">*The problem or diagnosis causes interference with normal activity or will damage health if left untreated.(en)</items><items id="text">*Moderate(en)</items></items><items code="at0049"><items id="description">*The problem or diagnosis prevents normal activity or will seriously damage health if left untreated.(en)</items><items id="text">*Severe(en)</items></items><items code="at0069"><items id="description">*Additional narrative about the problem or diagnosis not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0070"><items id="description">*The date this problem or diagnosis was last updated.(en)</items><items id="text">*Last updated(en)</items></items><items code="at0071"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0072"><items id="description">*Narrative description about the course of the problem or diagnosis since onset.(en)</items><items id="text">*Course description(en)</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">*The level of confidence in the identification of the diagnosis.(en)</items><items id="text">*Diagnostic certainty(en)</items></items><items code="at0074"><items id="description">*The diagnosis has been identified with a low level of certainty.(en)</items><items id="text">*Suspected(en)</items></items><items code="at0075"><items id="description">*The diagnosis has been identified with a high level of certainty.(en)</items><items id="text">*Probable(en)</items></items><items code="at0076"><items id="description">*The diagnosis has been confirmed against recognised criteria.(en)</items><items id="text">*Confirmed(en)</items></items><items code="at0077"><items id="comment">*Data captured/imported as "Age at onset" should be converted to a date using the subject's date of birth.(en)</items><items id="description">Geschatte of precieze datum/tijd dat de eerste tekenen of symptomen van het probleem of de diagnose werden opgemerkt.</items><items id="text">Datum/tijd van aanvang</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="comment">Delimitação clara entre o âmbito de um problema em comparação a um diagnóstico, não é fácil de se conseguir na prática. Para fins de documentação clínica com este arquétipo, problema e diagnóstico são considerados como uma continuidade, com níveis crescentes de detalhes e evidência de apoio, geralmente fornecendo peso para o rótulo de "diagnóstico".</items><items id="description">Detalhes sobre uma única condição de saúde identificada, lesões, deficiência ou qualquer outra questão que tenha impacto sobre o bem-estar físico, mental e / ou social de um indivíduo.</items><items id="text">Problema /Diagnóstico</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Quando possível, é preferível usar a codificação do nome do problema ou diagnóstico com uma terminologia.</items><items id="description">Identificação do problema ou diagnóstico, por nome.</items><items id="text">Nome do Problema / Diagnóstico</items></items><items code="at0003"><items id="comment">Datas parciais são aceitáveis. &#13;
Se o tema do cuidado está com idade inferior a um ano, então a data completa ou no mínimo o mês e o ano são necessários para permitir cálculos de idade precisos, por exemplo, se usado para conduzir apoio à decisão. Os dados capturados / importados como "Idade no momento do reconhecimento clínico" deve ser convertida para uma data usando o sujeito data de nascimento.</items><items id="description">Data / hora, estimada ou real, que o diagnóstico ou o problema foi reconhecido por um profissional de saúde.</items><items id="text">Data / hora da reconhecimento clínico</items></items><items code="at0005"><items id="comment">Se a severidade está incluída no nome do Problema / diagnóstico através de códigos pré-coordenados, este elemento de dados torna-se redundante. &#13;
Nota: a classificação mais específica da gravidade pode ser gravada utilizando os detalhes específicos SLOT.</items><items id="description">Uma avaliação global da severidade do problema ou diagnóstico.</items><items id="text">Severidade</items></items><items code="at0009"><items id="comment">Usar para fornecer conhecimento e contexto, incluindo evolução, episódios ou exacerbações, progresso e quaisquer outros detalhes relevantes, sobre o problema ou diagnóstico.</items><items id="description">Descrição narrativa sobre o problema ou diagnóstico.</items><items id="text">Descrição clínica</items></items><items code="at0012"><items id="comment">A codificação do nome da localização anatômica com uma terminologia é preferível, quando possível.&#13;
Utilize este elemento de dados para gravar localizações anatômicas precoordenadas. Se os requisitos para gravar a localização anatômica são determinados em tempo real através da aplicação ou requerem uma modelagem mais complexa, como localizações relativas, em seguida, use o CLUSTER.anatomical_location ou CLUSTER.relative_location dentro do SLOT 'localização anatômica estruturada' neste arquétipo. Ocorrências para este elemento de dados são ilimitadas para permitir cenários clínicos tais como a descrição de uma erupção cutânea em vários locais, mas em que todos os outros atributos são idênticos. Se a localização anatômica é incluída ao nome do Problema / diagnóstico, através de códigos pré-coordenados, este elemento de dados torna-se redundante.</items><items id="description">Simples identificação de um local do corpo para a localização do problema ou diagnóstico.</items><items id="text">Local do corpo</items></items><items code="at0030"><items id="comment">Datas parciais são aceitáveis. &#13;
Se o tema do cuidado está com idade inferior a um ano, então a data completa ou no mínimo o mês e o ano são necessários para permitir cálculos de idade precisos, por exemplo, se usado para conduzir apoio à decisão. Os dados capturados / importados como "Idade na ocasião da resolução" deve ser convertida para uma data usando o sujeito data de nascimento.</items><items id="description">Data / tempo, estimado ou atual, de resolução ou de dispensa desse problema ou diagnóstico, como determinado por um profissional de saúde.</items><items id="text">Data /tempo de resolução</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree(en)</items></items><items code="at0039"><items id="comment">Use esse SLOT para inserir os arquétipos CLUSTER.anatomical_location ou CLUSTER.relative_location se os requisitos para gravar a localização anatômica são determinados em tempo real através da aplicação ou requer uma modelagem mais complexa, como localizações relativas.&#13;
&#13;
Se a localização anatômica está incluída ao nome Problema / diagnóstico, através de códigos pré-coordenados, o uso deste SLOT torna-se redundante.</items><items id="description">A localização anatômica estruturada para o problema ou diagnóstico.</items><items id="text">Local estruturado do corpo</items></items><items code="at0043"><items id="comment">Pode incluir detalhes estruturados sobre a classificação ou a realização do diagnóstico; critérios de diagnóstico, critérios de classificação ou avaliação formal da severidade, como os critérios de terminologia comum para eventos adversos.</items><items id="description">Detalhes que são adicionalmente necessários para gravar atributos como únicos deste problema ou diagnóstico.</items><items id="text">Detalhes específicos</items></items><items code="at0046"><items id="comment">Use o estado ou os qualificadores contexto com cuidado, pois eles são variáveis quando usados na prática e a interoperabilidade não pode ser assegurada, salvo se o uso está claramente definido com a comunidade de uso. &#13;
Por exemplo: evolução do estado: inicial, inativo, resolvido, em remissão; estado de evolução: inicial, provisório / trabalhando, final; estado temporal: presente, passado; estado do episodio: primeiro, novo, em curso; estado de admissão: admissão, alta; ou estado de prioridade: primário, secundário.</items><items id="description">Detalhes estruturados para localização, domínio, episódio ou aspectos específicos do fluxo de trabalho do processo de diagnóstico.</items><items id="text">Estado</items></items><items code="at0047"><items id="description">O problema ou o diagnóstico não interfere na atividade normal ou causa danos à saúde, se não for tratado.</items><items id="text">Suave</items></items><items code="at0048"><items id="description">O problema ou o diagnóstico interfere na atividade normal ou prejudicará a saúde, se não for tratado.</items><items id="text">Moderado</items></items><items code="at0049"><items id="description">O problema ou diagnóstico impede a atividade normal ou causará sérios danos à saúde se não tratado.</items><items id="text">Severo</items></items><items code="at0069"><items id="description">Narrativa adicional sobre o problema ou diagnóstico, não capturados em outros campos.</items><items id="text">Comentário</items></items><items code="at0070"><items id="description">A data este problema ou diagnóstico foi atualizado pela última vez.</items><items id="text">Ultima atualização</items></items><items code="at0071"><items id="comment">Por exemplo: requisitos de informação locais ou metadados adicionais para alinhar com FHIR ou CIMI equivalentes.</items><items id="description">Informações adicionais necessárias para capturar o conteúdo local ou para alinhar com outros modelos de referência / formalismos.</items><items id="text">Extensão</items></items><items code="at0072"><items id="description">Descrição narrativa sobre o curso do problema ou diagnóstico, desde o início.</items><items id="text">Descrição do curso</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">O nível de confiança da identificação do diagnóstico.</items><items id="text">Certeza do diagnóstico</items></items><items code="at0074"><items id="description">O diagnóstico foi identificado com um nível baixo de convicção.</items><items id="text">Suspeito</items></items><items code="at0075"><items id="description">O diagnóstico foi identificado com um elevado grau de certeza.</items><items id="text">Provável</items></items><items code="at0076"><items id="description">O diagnóstico foi confirmado com base em critérios reconhecidos.</items><items id="text">confirmado</items></items><items code="at0077"><items id="comment">Os dados capturados / importados como "A idade de início" devem ser convertidos para uma data, usando o sujeito data de nascimento.</items><items id="description">Data / tempo, estimada ou real, que os sinais ou sintomas do problema / diagnóstico foram observados pela primeira vez.</items><items id="text">Data / tempo de início</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="comment">Gränsen mellan problem och diagnos är flytande. En ökad detaljnivå och mer stödjande evidens väger normalt över mot att tillståndet benämns diagnos.</items><items id="description">Detaljer om enskilt identifierat hälsotillstånd, skada, funktionshinder eller något annat problem som påverkar individens fysiska, psykiska och eller sociala välbefinnande.</items><items id="text">Problem/Diagnos</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Om möjligt, koda problemet eller diagnosen med en terminologi.</items><items id="description">Problemets eller diagnosens benämning.</items><items id="text">Benämning på problem/diagnos</items></items><items code="at0003"><items id="comment">Partiellt datum är acceptabelt. Om patienten är under ett år, är ett fullständigt datum eller minimum månad och år nödvändigt för korrekta åldersberäkningar, exempelvis om de används för beslutsstöd. Dokumenterad eller importerad "bekräftad debutålder" bör beräknas till ett datum för debut baserat på födelsedatum.</items><items id="description">Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först bekräftades av sjukvårdspersonal.</items><items id="text">Datum och tid för klinisk bekräftelse</items></items><items code="at0005"><items id="comment">Det här fältet är överflödigt om allvarlighetsgraden är inkluderad i benämningen av problemet eller diagnosen med prekoordinerade koder. En mer specifik allvarlighetsgrad kan dokumenteras i SLOT ”Specifika detaljer”.</items><items id="description">En bedömning av problemets eller diagnosens totala allvarlighetsgrad.</items><items id="text">Allvarlighetsgrad</items></items><items code="at0009"><items id="comment">Används för att ge en bakgrund och sammanhang, inklusive utveckling, skov, framsteg och andra relevanta detaljer om problemet eller diagnosen.</items><items id="description">Beskrivning av problemet eller diagnosen.</items><items id="text">Klinisk beskrivning</items></items><items code="at0012"><items id="comment">Om möjligt, koda kroppslokalisationen med en terminologi. Använd det här fältet för att dokumentera prekoordinerade kroppslokalisationer. &#13;
&#13;
Om kraven på dokumentation av den anatomiska lokalisationen bestäms automatiskt av vissa IT-system eller kräver mer komplex modellering, till exempel relativa platser (exempelvis 3 cm ovanför vänster knä), använd CLUSTER.anatomical_location eller CLUSTER.relative_location i SLOT för "Strukturerad kroppslokalisation" i denna arketyp. Förekomster av detta datafält är obegränsat för att möjliggöra kliniska scenarier som att beskriva utslag på flera platser, men där alla andra egenskaper är identiska. Om den anatomiska lokalisationen ingår i "Benämning på problem/diagnos" genom prekoordinerade koder blir detta datafält överflödigt.</items><items id="description">Identifiering av problemets eller diagnosens anatomiska lokalisation.</items><items id="text">Kroppslokalisation</items></items><items code="at0030"><items id="comment">Partiellt datum är acceptabelt. Om patienten är under ett år, är ett fullständigt datum eller minimum månad och år nödvändigt för korrekta åldersberäkningar, exempelvis om de används för beslutsstöd. Dokumenterat eller importerat "bekräftat tillfrisknande" bör beräknas till ett datum för tillfrisknande baserat på födelsedatum.</items><items id="description">Av sjukvårdspersonal uppskattat eller faktiskt datum och tid för tillfrisknande eller remission.</items><items id="text">Datum och tid för tillfrisknande</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Använd denna SLOT för att infoga CLUSTER.anatomical_location- eller CLUSTER.relative_location-arketyper om kroppslokalisationen bestäms automatiskt av vissa IT-system eller kräver mer komplicerad modellering, som exempelvis relativa platser. Det här datafältet är överflödigt om kroppslokalisationen är inkluderad i benämningen av problemet eller diagnosen med prekoordinerade koder.</items><items id="description">En strukturerad anatomisk lokalisation för problemet eller diagnosen.</items><items id="text">Strukturerad kroppslokalisation</items></items><items code="at0043"><items id="comment">Datafältet kan innehålla strukturerade detaljer om klassificering eller stadieindelning av diagnosen, som diagnostiska kriterier, klassificeringskriterier eller formella bedömningar av allvarlighetsgraden, såsom Common Terminology Criteria for Adverse Events.</items><items id="description">Ytterligare detaljer som krävs för att dokumentera de egenskaper som är unika för problemet eller diagnosen.</items><items id="text">Specifika detaljer</items></items><items code="at0046"><items id="comment">Använd datafältet med försiktighet, eftersom användningen varierar i praktiken och interoperabilitet endast kan säkerställas om användningen är tydligt definierad. &#13;
Exempelvis status på:&#13;
- Aktivitet, såsom aktiv, inaktiv, tillfrisknad, i remission&#13;
- Förlopp, såsom initial, interimistisk, preliminär, slutlig&#13;
- Tid, såsom nuvarande, tidigare&#13;
- Episod, såsom första, nytt, pågående&#13;
- Vårdtillfälle, såsom inskrivning, utskrivning&#13;
- Klassificering, såsom primär, sekundär</items><items id="description">Strukturerade specifika detaljer om den diagnostiska processen såsom plats, område, episod eller arbetsflöde.</items><items id="text">Status</items></items><items code="at0047"><items id="description">Problemet eller diagnosen påverkar inte normal aktivitet och kan inte orsaka skador på hälsan utan behandling.</items><items id="text">Lindrig</items></items><items code="at0048"><items id="description">Problemet eller diagnosen stör normal aktivitet och kan skada hälsan utan behandling.</items><items id="text">Måttlig</items></items><items code="at0049"><items id="description">Problemet eller diagnosen förhindrar normal aktivitet och kan allvarligt skada hälsan utan behandling.</items><items id="text">Svår</items></items><items code="at0069"><items id="description">Ytterligare beskrivning av problemet eller diagnosen som inte dokumenterats i andra fält.</items><items id="text">Kommentar</items></items><items code="at0070"><items id="description">Datum då dokumentation om problemet eller diagnosen senast uppdaterades.</items><items id="text">Senast uppdaterad</items></items><items code="at0071"><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items><items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="text">Tilläggsinformation</items></items><items code="at0072"><items id="description">Beskrivning av problemets eller diagnosens förlopp sedan debuten.</items><items id="text">Förlopp</items></items><items code="at0073"><items id="comment">Använd datatypen DV_TEXT i en template om en alternativ graderingsskala krävs.&#13;
&#13;
</items><items id="description">Graden av säkerhet vid fastställande av diagnosen.</items><items id="text">Diagnostisk säkerhet</items></items><items code="at0074"><items id="description">Diagnosen har bekräftats med en låg grad av säkerhet.</items><items id="text">Misstänkt</items></items><items code="at0075"><items id="description">Diagnosen har bekräftats med en hög grad av säkerhet.</items><items id="text">Sannolik</items></items><items code="at0076"><items id="description">Diagnosen har bekräftats utifrån kända kriterier.</items><items id="text">Bekräftad</items></items><items code="at0077"><items id="comment">Dokumenterad eller importerad "debutålder" bör beräknas till ett datum för debut baserat på födelsedatum.</items><items id="description">Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först observerades.</items><items id="text">Datum och tid för debut</items></items><items code="at0078"><items id="comment">Även känt som "etiologi". Om möjligt, koda med en terminologi.</items><items id="description">En eller flera orsaker till problemet eller diagnosen, eller dess uppkomstsätt.</items><items id="text">Orsak</items></items><items code="at0079"><items id="comment">Exempelvis "akut motorisk axonal neuropati" som en specificering av Guillain-Barre-syndromet. Om möjligt, koda specificeringen med en terminologi.</items><items id="description">Specificering av diagnosen, där det är relevant.</items><items id="text">Specificering</items></items><items code="at0080"><items id="comment">Samma diagnos, med samma allvarlighetsgrad, kan ha olika påverkan på olika patienter. Den samlade påverkan av hälsoproblemet justeras i detta datafält utifrån patientens individuella förutsättningar.&#13;
&#13;
Exempel: Två patienter har diagnosen ytlig brännskada. Den ena är frisk, medan den andra har diabetes. För en patient med diabetes är påverkan av problemet större, eftersom risken för infektion är högre och läkningstiden längre.&#13;
&#13;
Detta datafält är avsett att fånga flera typer av påverkan, inklusive men inte begränsat till klinisk behandling, funktion i hemmet och vardagen, arbetsliv och yrkesutövning.</items><items id="description">Övergripande bedömning av hur ett hälsoproblem påverkar patienten.</items><items id="text">Påverkan</items></items></term_definitions><term_definitions language="zh"><items code="at0000"><items id="comment">*Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.(en)</items><items id="description">*Details about a single identified health condition, injury, disability or any other issue which impacts  the physical, mental and/or social wellbeing of an individual.(en)</items><items id="text">问题/诊断</items></items><items code="at0001"><items id="description">@ internal @ (en)</items><items id="text">structure (en)</items></items><items code="at0002"><items id="comment">*Coding of the name of the problem or diagnosis with a terminology is preferred, where possible.(en)</items><items id="description">*Identification of the problem or diagnosis, by name.(en)</items><items id="text">问题/诊断名字</items></items><items code="at0003"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of clinical recognition" should be converted to a date using the subject's date of birth.(en)</items><items id="description">*Estimated or actual date/time the diagnosis or problem was recognised by a healthcare professional.(en)</items><items id="text">临床认可的日期/时间</items></items><items code="at0005"><items id="comment">*If severity is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant. Note: more specific grading of severity can be recorded using the Specific details SLOT.(en)</items><items id="description">*An assessment of the overall severity of the problem or diagnosis.(en)</items><items id="text">严重性</items></items><items code="at0009"><items id="comment">*Use to provide background and context, including evolution, episodes or exacerbations, progress and any other relevant details, about the problem or diagnosis.(en)</items><items id="description">*Narrative description about the problem or diagnosis.(en)</items><items id="text">临床描述</items></items><items code="at0012"><items id="comment">*Coding of the name of the anatomical location with a terminology is preferred, where possible.&#13;
Use this data element to record precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Structured anatomical location' SLOT in this archetype. Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a rash in multiple locations but where all of the other attributes are identical. If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">*Identification of a simple body site for the location of the problem or diagnosis.(en)</items><items id="text">身体位置</items></items><items code="at0030"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of resolution" should be converted to a date using the subject's date of birth.(en)</items><items id="description">*Estimated or actual date/time of resolution or remission for this problem or diagnosis, as determined by a healthcare professional.(en)</items><items id="text">解决的日期/时间</items></items><items code="at0032"><items id="description">@ internal @ (en)</items><items id="text">Tree (en)</items></items><items code="at0039"><items id="comment">*Use this SLOT to insert the CLUSTER.anatomical_location or CLUSTER.relative_location archetypes if the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations.&#13;
&#13;
If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, use of this SLOT becomes redundant.(en)</items><items id="description">*A structured anatomical location for the problem or diagnosis.(en)</items><items id="text">结构化身体位置</items></items><items code="at0043"><items id="comment">*May include structured detail about the grading or staging of the diagnosis; diagnostic criteria, classification criteria or formal severity assessments such as Common Terminology Criteria for Adverse Events.(en)</items><items id="description">*Details that are additionally required to record as unique attributes of this problem or diagnosis.(en)</items><items id="text">详情</items></items><items code="at0046"><items id="comment">谨慎使用状态或上下文状态符，除非社区明确规定了用法，否则会由于在实际应用中的用法差异而无法保证互操作性。比如：活跃状态-活跃、不活跃、已痊愈、病情缓解；演变状态-初期、临时/演变中、终期；时间状态-当前、过去；发作状态-首次、新发、进行中；入院状态-入院、出院；优先级状态-第一、第二</items><items id="description">描述与位置，域，发作或者工作流程等诊断过程中特定方面相关的结构化细节。</items><items id="text">状态</items></items><items code="at0047"><items id="description">*The problem or diagnosis does not interfere with normal activity or may cause damage to health if left untreated.(en)</items><items id="text">Mild (en)</items></items><items code="at0048"><items id="description">*The problem or diagnosis causes interference with normal activity or will damage health if left untreated.(en)</items><items id="text">Moderate (en)</items></items><items code="at0049"><items id="description">*The problem or diagnosis prevents normal activity or will seriously damage health if left untreated.(en)</items><items id="text">Severe (en)</items></items><items code="at0069"><items id="description">*Additional narrative about the problem or diagnosis not captured in other fields.(en)</items><items id="text">备注</items></items><items code="at0070"><items id="description">*The date this problem or diagnosis was last updated.(en)</items><items id="text">最近更新</items></items><items code="at0071"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">其他</items></items><items code="at0072"><items id="description">*Narrative description about the course of the problem or diagnosis since onset.(en)</items><items id="text">过程描述</items></items><items code="at0073"><items id="description">*The level of confidence in the identification of the diagnosis.(en)</items><items id="text">诊断确定性</items></items><items code="at0074"><items id="description">*The diagnosis has been identified with a low level of certainty.(en)</items><items id="text">*Suspected (en)</items></items><items code="at0075"><items id="description">*The diagnosis has been identified with a high level of certainty.(en)</items><items id="text">*Probable (en)</items></items><items code="at0076"><items id="description">*The diagnosis has been confirmed against recognised criteria.(en)</items><items id="text">*Confirmed (en)</items></items><items code="at0077"><items id="comment">*Data captured/imported as "Age at onset" should be converted to a date using the subject's date of birth.(en)</items><items id="description">*Estimated or actual date/time that signs or symptoms of the problem/diagnosis were first observed.(en)</items><items id="text">开始日期/时间</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="zh-cn"><items code="at0000"><items id="comment">在实践当中，问题与诊断范围的明确区分/划定并非易事。对于利用本原始型的临床文档记录目的来说，在此会将问题与诊断视为统一的连续体系，且由问题到诊断，不断增加的细节水平和支持性证据通常会为“诊断”标签带来更大的权重。</items><items id="description">关于单个已明确的健康状况、损伤、残疾或任何其他影响个人身体健康、心理健康和/或社会福祉的问题/事项的详情。</items><items id="text">问题/诊断</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">尽可能首选采用术语标准对问题或诊断的名称进行编码。</items><items id="description">利用名称对问题或诊断的标识。</items><items id="text">问题/诊断名称</items></items><items code="at0003"><items id="comment">可以接受部分型/不完整的日期。如果服务对象未满一周岁，则需要完整的日期或者至少是月份和年份才能准确地计算出年龄 - 比如，在将其用于驱动决策支持之时。应当利用服务/记录对象（患者）的出生日期，将作为临床认定[之时的]年龄（Age at time of clinical recognition）而采集/导入的数据转换成具体的日期。</items><items id="description">医疗保健专业人员认定当前诊断或问题的估计或实际日期/时间。</items><items id="text">临床认定日期/时间</items></items><items code="at0005"><items id="comment">如果是在问题/诊断名称当中利用了先组[配]式代码（ precoordinated code）来记录严重程度，则本数据元就会变得多余。注意：可以利用特有详情槽位 "Specific details" 来记录更为具体的严重程度分级（grading）。</items><items id="description">对于当前问题或诊断的总体严重程度的评估[结果]。</items><items id="text">严重程度</items></items><items code="at0009"><items id="comment">用于提供关于问题或诊断的背景和上下文/语境，包括发展演变、片段或恶化、进展和任何其他相关的详情。</items><items id="description">关于当前问题或诊断的叙述性描述。</items><items id="text">临床描述</items></items><items code="at0012"><items id="comment">尽可能首选采用术语标准对解剖位置的名称进行编码。&#13;
&#13;
请利用本数据元记录先组[配]式（ precoordinated）的解剖位置。如果是由应用程序在运行时来确定关于记录解剖位置的要求，或者是需要更为复杂的建模（如相对位置），则请在本原始型的结构化解剖位置槽位 "Structured anatomical location" 采用群簇型解剖位置原始型 CLUSTER.anatomical_location 或群簇型相对位置原始型 CLUSTER.relative_location。本数据元的基数/出现次数并不受限制，以便能够适应不同的临床场景，如描述同时拥有多个解剖位置的皮疹但所有其他的特征属性全都相同。如果问题/诊断名称之中是利用先组[配]式代码（ precoordinated code）来记录相应的解剖位置，则本数据元就会变得多余。</items><items id="description">明确的是代表当前问题或诊断所处解剖位置的简单的身体部位。</items><items id="text">身体部位</items></items><items code="at0030"><items id="comment">可以接受部分型/不完整的日期。如果服务对象未满一周岁，则需要完整的日期或者至少是月份和年份才能准确地计算出年龄 - 比如，在将其用于驱动决策支持之时。应当利用服务/记录对象（患者）的出生日期，将作为临床认定[之时的]年龄（Age at time of clinical recognition）而采集/导入的数据转换成具体的日期。</items><items id="description">医疗保健专业人员所确定的，当前问题或诊断的估计或实际的解决或缓解日期/时间。</items><items id="text">解决日期/时间</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">如果是由应用程序在运行时来确定关于记录解剖位置的要求，或者是需要更为复杂的建模（如相对位置），则请在当前槽位之中采用群簇型解剖位置原始型 CLUSTER.anatomical_location 或群簇型相对位置原始型 CLUSTER.relative_location。&#13;
&#13;
如果问题/诊断名称之中是利用先组[配]式代码（ precoordinated code）来记录相应的解剖位置，则本数据元就会变得多余。</items><items id="description">当前问题或诊断的结构化解剖位置。</items><items id="text">结构化身体部位</items></items><items code="at0043"><items id="comment">可能包括关于当前诊断的分级或分期、诊断标准、分类标准或正式的严重程度评估（如不良事件通用术语标准）的结构化详情。</items><items id="description">记录当前问题或诊断特有的特征属性时所额外需要的详细信息。</items><items id="text">特有详情</items></items><items code="at0046"><items id="comment">请谨慎使用状态（status）或上下文/语境（context）限定词，因为它们在实际工作中运用会变化不定，除非与相应的运用社区一起明确定义了用法，否则就无法保证互操作性（interoperability）。例如：有效性状态（现行有效、无效、已解决、缓解中）、演变状态（ 初步、临时/工作、最终）、时间状态（当前、过去/既往）、偶发性（episodicity）状态（首次、新近、持续）、入院状态（入院、出院）或者优先级状态（主要、次要）。</items><items id="description">关于诊断过程的位置/场所、领域、服务节段/片段（episode）或工作流的特有方面的结构化详细信息。</items><items id="text">状态</items></items><items code="at0047"><items id="description">如果不加治疗/处理，当前的问题或诊断并不会干扰患者的正常活动或者可能会对其健康造成损害。</items><items id="text">轻度</items></items><items code="at0048"><items id="description">如果不加治疗/处理，当前的问题或诊断会干扰患者的正常活动或者会对其健康造成损害。</items><items id="text">中度</items></items><items code="at0049"><items id="description">如果不加治疗/处理，当前的问题或诊断会妨碍患者的正常活动或者会对其健康造成严重的损害。</items><items id="text">重度</items></items><items code="at0069"><items id="description">其他字段之中并未采集的，关于当前问题或诊断的其他叙述。</items><items id="text">备注</items></items><items code="at0070"><items id="description">最后更新当前问题或诊断时的日期。</items><items id="text">最后更新日期</items></items><items code="at0071"><items id="comment">例如：本地信息需求/要求，或者是与 FHIR 或 CIMI 等效项保持一致时所需的其他元数据。</items><items id="description">采集本地内容或与其他参考模型/形式化体系保持一致时所需的其他信息。</items><items id="text">扩展</items></items><items code="at0072"><items id="description">关于起始/发病以来当前问题或诊断的过程/进程/病程（course）的叙述性描述。</items><items id="text">进程描述</items></items><items code="at0073"><items id="comment">如果需要采用其他备选的取值集合，则可以将这些取值添加到模板当中的文本型数据类型 DV_TEXT 。</items><items id="description">关于确定当前诊断的置信度水平。</items><items id="text">诊断确定性</items></items><items code="at0074"><items id="description">确定当前诊断时的确定性较低。</items><items id="text">疑似</items></items><items code="at0075"><items id="description">确定当前诊断时的确定性较高。</items><items id="text">很可能</items></items><items code="at0076"><items id="description">确定当前诊断时依据的是公认的[诊断]标准/评判准则。</items><items id="text">确诊/确认</items></items><items code="at0077"><items id="comment">应当利用服务/记录对象（患者）的出生日期，将起始/发病年龄（Age at onset）而采集/导入的数据转换成具体的日期。</items><items id="description">首次观察到/发现当前问题/诊断的症状或体征的估计或实际日期/时间。</items><items id="text">起始日期/时间</items></items><items code="at0078"><items id="comment">又称为“病因”（aetiology/etiology）。尽可能首选采用外部术语标准来进行编码。</items><items id="description">问题或诊断的原因、原因集合（成套/成组的原因）或因果作用方式（manner of causation）。</items><items id="text">原因</items></items><items code="at0079"><items id="comment">例如：“急性运动轴突性神经病”（acute motor axonal neuropathy）就属于是吉兰-巴雷综合征（Guillain-Barre Syndrome）的变体。尽可能首选采用术语标准对变体/亚型的名称进行编码。</items><items id="description">当前诊断的特定变体/变异类型或亚型/子类型（如果相关/合适）。</items><items id="text">变体/亚型</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.blood_pressure.v2"><term_definitions language="ar-sy"><items code="at0000"><items id="description">قياس موضعي لضغط الدم الشرياني و الذي يحل محل الضغط الشرياني في الدورة الدموية الجهازية. &#13;
و عادة ما يستخدم مصطلح "ضغط الدم" لللإشارة إلى قياس ضغط دم الشريان العضُدي في أعلى الذراع.</items><items id="text">ضغط الدم</items></items><items code="at0001"><items id="description">العقدة التركيبية للتاريخ</items><items id="text">التاريخ</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">ذروة ضغط الدم الشرياني الجهازي - يتم قياسه في طور الانقباض من دورة القلب</items><items id="text">الانقباضي</items></items><items code="at0005"><items id="description">الحد الأدني لضغط الدم الشرياني الجهازي - يتم قياسها في طور الانبساط - الارتخاء من دورة القلب</items><items id="text">الانبساطي</items></items><items code="at0006"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">موضع الشخص في وقت القياس</items><items id="text">الموضع</items></items><items code="at0011"><items id="description">تركيب القائمة</items><items id="text">تركيب القائمة</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470. </items><items id="description">حجم الكُفَّة المستخدمة في قياس ضغط الدم</items><items id="text">حجم الكُفَّة</items></items><items code="at0014"><items id="description">*Simple body site where blood pressure was measured.(en)</items><items id="text">*Location of measurement(en)</items></items><items code="at0015"><items id="description">كفة تستخدم لفخذ البالغ - مثانة/ كيسة من 20 سينتيمتر * 42 سينتيمتر تقريبا</items><items id="text">فخذ البالغ</items></items><items code="at0016"><items id="description">كفة للبالغين ذوي الأذرع الكبيرة - المثانة/ الكيسة 16 سينتيمتر * 38 سينتيمتر تقريبا</items><items id="text">بالغ كبير</items></items><items code="at0017"><items id="description">كفة عيارية للبالغين - مثانة من 13 سينتيمتر * 30 سينتيمتر تقريبا</items><items id="text">البالغ</items></items><items code="at0025"><items id="description">الذراع الأيمن للشخص</items><items id="text">الذراع الأيمن</items></items><items code="at0026"><items id="description">الذراع الأيسر للشخص</items><items id="text">الذراع الأيسر</items></items><items code="at0027"><items id="description">الفخذ الأيمن للشخص</items><items id="text">الفخذ الأيمن</items></items><items code="at0028"><items id="description">الفخذ الأيسر للشخص</items><items id="text">الفخذ الأيسر</items></items><items code="at0033"><items id="description">*Additional narrative about the measurement, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at1000"><items id="description">الشخص واقف عند القيام بقياس ضغط الدم</items><items id="text">واقف</items></items><items code="at1001"><items id="description">الشخص جالس (مثلا على سرير أو كرسي) عند القيام بقياس ضغط الدم</items><items id="text">جالس</items></items><items code="at1002"><items id="description">الشخص مضطجع عند القيام بقياس ضغط الدم</items><items id="text">مضطجع</items></items><items code="at1003"><items id="description">الشخص مستلقٍ بشكل مستوٍ عند القيام بقياس ضغط الدم</items><items id="text">مستلقٍ</items></items><items code="at1005"><items id="comment">*PLEASE NOTE: '°' is a valid UCUM unit. Please use 'deg' as the correct unit.(en)</items><items id="description">*The craniocaudal tilt of the surface on which the person is lying at the time of measurement.(en)</items><items id="text">*Tilt(en)</items></items><items code="at1006"><items id="description">متوسط الضغط الشرياني الذي يحدث خلال جميع أطوار دورة القلب الواحدة من انقباض و انبساط/ ارتخاء</items><items id="text">متوسط الضغط الشرياني</items></items><items code="at1007"><items id="description">الفرق بين ضغط الدم الانقباضي و الانبساطي</items><items id="text">الضغط عند النبض</items></items><items code="at1008"><items id="description">كفة تستخدم للبالغ الصغير - مثانة/ كيسة من 10 سينتيمتر * 24 سينتيمتر تقريبا</items><items id="text">البالغ الصغير</items></items><items code="at1009"><items id="description">كفة تستخدم للطفل أو البالغ ذي الذراع الرفيعة - من 8 سينتيمتر * 21 سينتيمتر تقريبا</items><items id="text">طفل</items></items><items code="at1010"><items id="description">تستخدم أصوات كورتكوف لتحديد ضغط الدم الانبساطي باستخدام طريقة التسمُّع</items><items id="text">النقطة النهائية الانبساطية/ الارتخائية</items></items><items code="at1011"><items id="description">يتم التعرف على صوت كورتكوف الرابع على أنه تخفيت منفصل</items><items id="text">الطور الرابع</items></items><items code="at1012"><items id="description">يتم التعرف على صوت كورتكوف الخامس بغياب الأصوات حيث ينخفض ضغط الكفة تحت ضغط الدم الانبساطي</items><items id="text">الطور الخامس</items></items><items code="at1014"><items id="description">الشخص مستلق بشكل مستو مع ميل جانبي بزاوية تجاه جانبه الأيسر. عادة ما يُحتاج إلى هذا الوضع في الأثلوث الأخير من الحمل لتخفيف الانضغاط الأبهري الجوفي</items><items id="text">مستلق و مائل لجانبه الأيسر</items></items><items code="at1018"><items id="description">كفة تستخدم للرضيع - مثانة/ كيسة من 5 سينتيمتر * 15 سينتيمتر تقريبا</items><items id="text">رضيع</items></items><items code="at1019"><items id="description">الكفة المستخدمة لحديثي الولادة, على افتراض أن الكفة مناسبة للحجم و النضج و الوزن عند ولادة الطفل</items><items id="text">حديث الولادة</items></items><items code="at1020"><items id="description">الساعد الأيمن للشخص</items><items id="text">الساعد الأيمن</items></items><items code="at1021"><items id="description">الساعد الأيسر للشخص</items><items id="text">الساعد الأيسر</items></items><items code="at1025"><items id="description">تفاصيل حول جهاز ضغط الدم الزئبقي أو جهيزة أخرى تستخدم لقياس ضغط الدم</items><items id="text">الجهيزة</items></items><items code="at1026"><items id="description">الكاحل الأيمن للشخص</items><items id="text">الكاحل الأيمن</items></items><items code="at1030"><items id="description">تفاصيل حول النشاط البدني الذي يتم القيام به في وقت قياس ضغط الدم.</items><items id="text">المجهود</items></items><items code="at1031"><items id="description">الكاحل الأيسر للشخص</items><items id="text">الكاحل الأيسر</items></items><items code="at1032"><items id="description">*A finger of the individual.(en)</items><items id="text">*Finger(en)</items></items><items code="at1035"><items id="description">طريقة قياس ضغط الدم</items><items id="text">الطريقة</items></items><items code="at1036"><items id="description">طريقة خارجية لقياس ضغط الدم, باستخدام سماعة طبيب أو أصوات كوروتكوف</items><items id="text">التسمع</items></items><items code="at1037"><items id="description">طريقة خارجية لقياس ضغط الدم, باستخدام الجس - عادةً الشرايين الذراعية و الكعبري</items><items id="text">الجس</items></items><items code="at1038"><items id="description">الصيغة المستخدمة لقياس متوسط الضغط الشرياني - إذا تم تسجيل بياناتها</items><items id="text">صيغة متوسط الضغط الشرياني</items></items><items code="at1039"><items id="description">طريقة خارجية لقياس ضغط الدم بالستخدام آلة قياس ضغط الدم</items><items id="text">الآلة</items></items><items code="at1040"><items id="description">طريقة داخلية لقيسا ضغط الدم, و ذلك يعني اختراق الجلد/ البشرة داخل الأوعية الدموية</items><items id="text">باضع</items></items><items code="at1042"><items id="description">تقدير متوسط ضغط الدم خلال فترة من 24 ساعة</items><items id="text">المتوسط خلال 24 ساعة</items></items><items code="at1043"><items id="description">حالة النوم - تدعم تفسير قياسات ضغط الدم المِسيارية خلال 24 ساعة</items><items id="text">حالة النوم</items></items><items code="at1044"><items id="description">الشخص واعٍ بشكل كامل</items><items id="text">متنبه و يقظ</items></items><items code="at1045"><items id="description">الشخص في الحالة الطبيعية الخاصة بالراحة الجسدية</items><items id="text">نائم</items></items><items code="at1051"><items id="description">*A toe of the individual.(en)</items><items id="text">*Toe(en)</items></items><items code="at1052"><items id="description">تعليق حول و تسجيل للعوامل الطارئة التي قد تسهم في قياس ضغط الدم. مثلا, مستوى القلق أو متلازمة البالطو الأبيض أو الألم أو الحمى أو التغييرات في الضغط الجوي,, إلى آخره</items><items id="text">العوامل المربكة</items></items><items code="at1053"><items id="description">*Invasive measurement via transducer access line within an artery.(en)</items><items id="text">*Intra-arterial(en)</items></items><items code="at1054"><items id="description">*Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Systolic pressure formula(en)</items></items><items code="at1055"><items id="description">*Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Diastolic pressure formula(en)</items></items><items code="at1056"><items id="description">**(en)</items><items id="text">*Dorsum of foot(en)</items></items><items code="at1057"><items id="description">*Structured anatomical location of where the measurement was taken.(en)</items><items id="text">*Structured measurement location(en)</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">**(en)</items><items id="text">*New element(en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="comment">Majoritàriament, l'ús del terme «pressió arterial» fa referència a la mesura de la pressió de l'artèria braquial a la part superior del braç.</items><items id="description">La mesura local de la pressió arterial, que és una substituta de la pressió arterial a la circulació sistèmica.</items><items id="text">Pressió arterial</items></items><items code="at0001"><items id="description">Node estructural dels antecedents.</items><items id="text">Antecedents</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">blood pressure</items></items><items code="at0004"><items id="description">Pressió arterial sistemàtica màxima - mesurada en la fase sistòlica o de contracció del cicle cardíac.</items><items id="text">Sistòlica</items></items><items code="at0005"><items id="description">Pressió arterial sistemàtica mínima - mesurada en la fase diastòlica o de relaxació del cicle cardíac.</items><items id="text">Diastòlica</items></items><items code="at0006"><items id="description">Esdeveniment predeterminat i no especificat d’un moment específic o interval que es pot definir clarament en una plantilla o en temps d’execució.</items><items id="text">Qualsevol esdeveniment</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">Posició del pacient al moment de la mesura.</items><items id="text">Posició</items></items><items code="at0011"><items id="description">Llistat.</items><items id="text">Esquema</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">Grandària del maneguet utilitzat per a mesurar la pressió arterial.</items><items id="text">Grandària del maneguet</items></items><items code="at0014"><items id="description">Zona del cos on es va mesurar la pressió arterial.</items><items id="text">Zona del mesurament</items></items><items code="at0015"><items id="description">Maneguet utilitzat per a una cuixa adulta (20 cm x 42 cm aprox.).</items><items id="text">Cuixa d'un adult</items></items><items code="at0016"><items id="description">Maneguet utilitzat per a un adult amb braços grans (16 cm x 38 cm aprox.).</items><items id="text">Adult gran</items></items><items code="at0017"><items id="description">Maneguet estàndard per a un adult (13 cm x 30 cm aprox.).</items><items id="text">Adult</items></items><items code="at0025"><items id="description">Braç dret del pacient.</items><items id="text">Braç dret</items></items><items code="at0026"><items id="description">Braç esquerre del pacient.</items><items id="text">Braç esquerre</items></items><items code="at0027"><items id="description">Cuixa dreta del pacient.</items><items id="text">Cuixa dreta</items></items><items code="at0028"><items id="description">Cuixa esquerra del pacient.</items><items id="text">Cuixa esquerra</items></items><items code="at0033"><items id="description">Informació addicional sobre la mesura, no recollida en altres caselles.</items><items id="text">Observacions</items></items><items code="at1000"><items id="description">Persona de peu al moment de la mesura de la pressió arterial.</items><items id="text">Dret</items></items><items code="at1001"><items id="description">Persona asseguda (per exemple, al llit o en una cadira) al moment de la mesura de la pressió arterial.</items><items id="text">Assegut</items></items><items code="at1002"><items id="description">Persona reclinada al moment de la mesura de la pressió arterial.</items><items id="text">Reclinat</items></items><items code="at1003"><items id="description">Persona ajaguda en posició horitzontal al moment de la mesura de la pressió arterial.</items><items id="text">Ajagut</items></items><items code="at1005"><items id="description">La inclinació craniocaudal de la superfície on la persona es ajeu al moment de la mesura.</items><items id="text">Inclinació</items></items><items code="at1006"><items id="description">La mitjana de la pressió arterial que ocorre durant el cicle complet de contracció i relaxació del cor.</items><items id="text">Pressió arterial mitjana</items></items><items code="at1007"><items id="description">Diferència entre la pressió sistòlica i la diastòlica.</items><items id="text">Pressió de pols</items></items><items code="at1008"><items id="description">Maneguet utilitzat per a un adult petit (10 cm x 24 cm aprox.).</items><items id="text">Adult petit</items></items><items code="at1009"><items id="description">Maneguet apropiat per a un infant o adult amb un braç petit (8 cm x 21 cm aprox.).</items><items id="text">Pediàtric/Infants</items></items><items code="at1010"><items id="description">Registra quin so de Korotkoff s'utilitza per a determinar la pressió diastòlica mitjançant el mètode d'auscultació.</items><items id="text">Punt final diastòlic</items></items><items code="at1011"><items id="description">El quart so Korotkoff s'identifica com un amortiment abrupte de sons.</items><items id="text">Fase IV</items></items><items code="at1012"><items id="description">El cinquè so de Korotkoff s'identifica per l'absència de sons quan la pressió del maneguet cau per sota de la pressió arterial diastòlica.</items><items id="text">Fase V</items></items><items code="at1014"><items id="description">Persona ajaguda amb una certa inclinació lateral, generalment en angle cap al costat esquerre. Es requereix normalment durant l'últim trimestre d'embaràs per alleujar la compressió aortocava.</items><items id="text">Ajagut cap a l'esquerra</items></items><items code="at1018"><items id="description">Maneguet utilitzat per a nadons (5 cm x 15 cm aprox.).</items><items id="text">Nadó</items></items><items code="at1019"><items id="description">Maneguet utilitzat per nounats, suposant que el maneguet sigui de la mida adequada per a la maduresa i pes del nounat.</items><items id="text">Nounat</items></items><items code="at1020"><items id="description">Canell dret del pacient.</items><items id="text">Canell dret</items></items><items code="at1021"><items id="description">Canell esquerre del pacient.</items><items id="text">Canell esquerre</items></items><items code="at1025"><items id="description">Dades sobre el tensiòmetre o altre dispositiu utilitzat per a mesurar la pressió arterial.</items><items id="text">Dispositiu</items></items><items code="at1026"><items id="description">Turmell dret del pacient.</items><items id="text">Turmell dret</items></items><items code="at1030"><items id="description">Dades sobre l'activitat física realitzada al moment de la mesura de la pressió arterial.</items><items id="text">Esforç</items></items><items code="at1031"><items id="description">Turmell esquerre del pacient.</items><items id="text">Turmell esquerre</items></items><items code="at1032"><items id="description">Un dit de la mà del pacient.</items><items id="text">Dit de la mà</items></items><items code="at1035"><items id="description">Mètode de la mesura de la pressió arterial.</items><items id="text">Mètode</items></items><items code="at1036"><items id="description">Mètode extern de mesura de la pressió arterial, utilitzant un estetoscopi i sons de Korotkoff.</items><items id="text">Auscultació</items></items><items code="at1037"><items id="description">Mètode extern de mesura de la pressió arterial, utilitzant la palpació, en general de l'artèria braquial o artèries radials.</items><items id="text">Palpació</items></items><items code="at1038"><items id="description">Fórmula utilitzada per a calcular la Pressió Arterial Mitjana (en cas de registrar aquesta dada).</items><items id="text">Fórmula de la pressió arterial mitjana</items></items><items code="at1039"><items id="description">Mètode extern de mesura de la pressió arterial, utilitzant un dispositiu o màquina.</items><items id="text">Màquina</items></items><items code="at1040"><items id="description">Mètode intern de mesura de la pressió arterial que involucra la penetració de la pell i mesurar dins dels vasos sanguinis.</items><items id="text">Invasiu</items></items><items code="at1042"><items id="description">Estimació de la pressió arterial mitjana durant un període de 24 hores.</items><items id="text">Mitjana de 24 hores</items></items><items code="at1043"><items id="description">Estat del son - ajuda a la interpretació dels registres de la pressió arterial ambulatòria de 24 hores.</items><items id="text">Estat del son</items></items><items code="at1044"><items id="description">La persona es troba totalment conscient.</items><items id="text">Despert</items></items><items code="at1045"><items id="description">La persona es troba en un estat natural de repòs corporal.</items><items id="text">Dormit</items></items><items code="at1051"><items id="description">Un dit del peu del pacient.</items><items id="text">Dit del peu</items></items><items code="at1052"><items id="description">Comentar i registrar altres factors incidentals que puguin estar afectant a la mesura de la pressió arterial. Per exemple, nivell d'ansietat o «hipertensió de bata blanca»; dolor o febre; canvis en la pressió atmosfèrica, etc.</items><items id="text">Factors de confusió</items></items><items code="at1053"><items id="description">Mesura invasiva mitjançant un transductor dins d'una artèria.</items><items id="text">Intraarterial</items></items><items code="at1054"><items id="description">Fórmula utilitzada per a calcular la pressió sistòlica a partir de la pressió arterial mitjana (en cas de registrar aquesta dada).</items><items id="text">Fórmula de pressió sistòlica</items></items><items code="at1055"><items id="description">Fórmula utilitzada per a calcular la pressió diastòlica a partir de la pressió arterial mitjana (en cas de registrar aquesta dada).</items><items id="text">Fórmula de pressió diastòlica</items></items><items code="at1056"><items id="description">Dors del peu del pacient.</items><items id="text">Dors del peu</items></items><items code="at1057"><items id="description">Zona anatòmica estructurada d'on es va prendre el mesurament.</items><items id="text">Zona estructurada del mesurament</items></items><items code="at1058"><items id="comment">Per exemple: informació departamental de l'hospital local o metadades addicionals per alinear-se amb equivalents FHIR o CIMI.</items><items id="description">Informació addicional requerida per a capturar el contingut local o per alinear-se amb altres models/formalismes de referència.</items><items id="text">Extensió</items></items><items code="at1059"><items id="description">Una sola paraula, frase o descripció breu que representi el significat clínic i la importància de la mesura de la pressió arterial.</items><items id="text">Interpretació clínica</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="comment">Häufig wird der Ausdruck 'Blutdruck' zur Bezeichung der Messung des brachialen Ateriendrucks im Oberarm verwendet.</items><items id="description">Die lokale Messung des arteriellen Blutdrucks als Surrogat für den arteriellen Druck in der systemischen Zirkulation.</items><items id="text">Blutdruck</items></items><items code="at0001"><items id="description">Historie</items><items id="text">Historie</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Blutdruck</items></items><items code="at0004"><items id="description">Der höchste arterielle Blutdruck eines Zyklus - gemessen in der systolischen oder Kontraktionsphase des Herzens.</items><items id="text">Systolisch</items></items><items code="at0005"><items id="description">Der minimale systemische arterielle Blutdruck eines Zyklus - gemessen in der diastolischen oder Entspannungsphase des Herzens.</items><items id="text">Diastolisch</items></items><items code="at0006"><items id="description">Standardmäßiger, nicht näher beschriebener Zeitpunkt oder Intervall Ereignis welches in einem Template oder bei der Anwendung genauer definiert werden kann.</items><items id="text">Beliebiges Ereignis</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">Die Position der untersuchten Person während der Messung.</items><items id="text">Position</items></items><items code="at0011"><items id="description">Listenstruktur</items><items id="text">Listenstruktur</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">Die Größe der Manschette, die zur Blutdruckmessung benutzt wurde.</items><items id="text">Manschettengröße</items></items><items code="at0014"><items id="description">Einfache Körperstelle an der der Blutdruck gemessen wurde.</items><items id="text">Stelle der Messung</items></items><items code="at0015"><items id="description">Eine Manschette für den Oberschenkel eines Erwachsenen - ca. 20cm x 42cm.</items><items id="text">Oberschenkel eines Erwachsenen</items></items><items code="at0016"><items id="description">Eine Manschette für Erwachsene mit größeren Armen - ca. 16cm x 38cm.</items><items id="text">Großer Erwachsener</items></items><items code="at0017"><items id="description">Eine Standard-Manschette für einen Erwachsenen - ca. 13cm x 30cm.</items><items id="text">Erwachsener</items></items><items code="at0025"><items id="description">Der rechte Arm der Person.</items><items id="text">Rechter Arm</items></items><items code="at0026"><items id="description">Der linke Arm der Person.</items><items id="text">Linker Arm</items></items><items code="at0027"><items id="description">Der rechte Oberschenkel der Person.</items><items id="text">Rechter Oberschenkel</items></items><items code="at0028"><items id="description">Der linke Oberschenkel der Person.</items><items id="text">Linker Oberschenkel</items></items><items code="at0033"><items id="description">Zusätzlicher Freitext über die Messung, der nicht in anderen Felder erfasst werden konnte.</items><items id="text">Kommentar</items></items><items code="at1000"><items id="description">Stehend zum Zeitpunkt der Blutdruckmessung.</items><items id="text">Stehend</items></items><items code="at1001"><items id="description">Sitzend zum Zeitpunkt der Blutdruckmessung (z.B. auf einem Bett oder Stuhl).</items><items id="text">Sitzend</items></items><items code="at1002"><items id="description">Patient zurückgelehnt zum Zeitpunkt der Blutdruckmessung.</items><items id="text">Zurückgelehnt</items></items><items code="at1003"><items id="description">Flach liegend zum Zeitpunkt der Blutdruckmessung.</items><items id="text">Liegend</items></items><items code="at1005"><items id="description">Die kraniokaudale Neigung der Oberfläche auf der die Person zum Zeitpunkt der Messung liegt.</items><items id="text">Neigung</items></items><items code="at1006"><items id="description">Der mittlerer arterielle Druck über den gesamten Verlauf der Konktraktions- und Entspannungsphase des Herzens.</items><items id="text">Mittlerer arterieller Druck</items></items><items code="at1007"><items id="description">Der Abstand zwischen dem systolischen und dem diastolischen Blutdruckwert.</items><items id="text">Pulsdruck</items></items><items code="at1008"><items id="description">Eine Manschette für einen kleinen Erwachsenen - ca. 10cm x 24cm.</items><items id="text">Kleiner Erwachsener</items></items><items code="at1009"><items id="description">Eine Manschette für ein Kind oder auch einen Erwachsenen mit einem schmalen Arm - 8cm x 21cm.</items><items id="text">Pädiatrisch/Kind</items></items><items code="at1010"><items id="description">Dient der Dokumentation des Korotkoff-Geräusches, das verwendet wird, um bei auskultarischer Messung den diastolischen Blutdruck zu bestimmen.</items><items id="text">Diastolischer Endpunkt</items></items><items code="at1011"><items id="description">Das 4. Korotkoff-Geräusch - Die Geräusche klingen plätzlich gedämpft.</items><items id="text">Phase IV</items></items><items code="at1012"><items id="description">Das 5. Korotkoff-Geräusch - die Geräusche verschwinden völlig während der Manschettendruck unter den diastolischen Blutdruck fällt.</items><items id="text">Phase V</items></items><items code="at1014"><items id="description">Flach liegend mit seitlicher Neigung, normalerweise zur linken Seite. Häufig verwendet im letzten Drittel eine Schwangerschaft, um aorto-cavale Kompression zu vermeiden.</items><items id="text">Nach links geneigt liegend</items></items><items code="at1018"><items id="description">Eine Manschette für Kleinkinder und Säuglinge - ca. 5cm x 15cm.</items><items id="text">Kleinkind</items></items><items code="at1019"><items id="description">Eine Manschette für Neugeborene mit passender Größe für die Reife und das Geburtsgewicht des Neugeborenen.</items><items id="text">Neonatal</items></items><items code="at1020"><items id="description">Das rechte Handgelenk der Person.</items><items id="text">Rechtes Handgelenk</items></items><items code="at1021"><items id="description">Das linke Handgelenk der Person.</items><items id="text">Linkes Handgelenk</items></items><items code="at1025"><items id="description">Details über das Sphygmomanometer oder ein anderes Gerät, dass zur Blutdruckmessung verwendet wird.</items><items id="text">Gerät</items></items><items code="at1026"><items id="description">Das rechte Fußgelenk der Person.</items><items id="text">Rechtes Fußgelenk</items></items><items code="at1030"><items id="description">Details über physische Aktivitäten zur Zeit der Blutdruckmessung.</items><items id="text">Anstrengung</items></items><items code="at1031"><items id="description">Das linke Fußgelenk der Person</items><items id="text">Linkes Fußgelenk</items></items><items code="at1032"><items id="description">Ein Finger des Individuums.</items><items id="text">Finger</items></items><items code="at1035"><items id="description">Methode der Messung des Blutdrucks.</items><items id="text">Methode</items></items><items code="at1036"><items id="description">Auskulatorische Messung unter Benutzung eines Stethoskops und der Korotkoff-Geräusche.</items><items id="text">Auskultation</items></items><items code="at1037"><items id="description">Palpatorische Messung, normalerweise an den brachialen oder radialen Arterien.</items><items id="text">Palpation</items></items><items code="at1038"><items id="description">Die Formel die ggf. verwendet wurde, um den mittleren arteriellen Druck zu berechnen.</items><items id="text">Formel für mittleren arterieller Druck</items></items><items code="at1039"><items id="description">Messung durch eine Blutdruckmaschine.</items><items id="text">Machine</items></items><items code="at1040"><items id="description">Invasive Messung des Blutdrucks innerhalb eines Gefäßes.</items><items id="text">Invasiv</items></items><items code="at1042"><items id="description">Schätzung des durchschnittlichen Blutdrucks über einen 24-stündigen Zeitraum.</items><items id="text">24 Stunden Durchschnitt</items></items><items code="at1043"><items id="description">Schlafzustand - unterstützt die Auswertung von 24-stündigen ambulanten Aufzeichnungen des Blutdrucks.</items><items id="text">Schlafzustand</items></items><items code="at1044"><items id="description">Die untersuchte Person ist bei vollem Bewusstsein.</items><items id="text">Aufmerksam und wach</items></items><items code="at1045"><items id="description">Die untersuchte Person schläft.</items><items id="text">Schlafend</items></items><items code="at1051"><items id="description">Ein Zeh des Individuums.</items><items id="text">Zeh</items></items><items code="at1052"><items id="description">Kommentar und Aufzeichung anderer Faktoren die ggf. zu dem Ergebnis der Blutdruckmessung beitragen können. Die kann z.B. bei belastenden Situationen der Fall sein (z.B. sog. Weißkittelhypertonie, Schmerzen, Fieber, Änderungen im atmosphärischen Druck).</items><items id="text">Einflussfaktoren</items></items><items code="at1053"><items id="description">Invasive Messung mittels Transducer über einen arteriellen Zugang.</items><items id="text">Intraarteriell</items></items><items code="at1054"><items id="description">Formel, die benutzt wurde, um den systolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).</items><items id="text">Formel für systolischen Druck</items></items><items code="at1055"><items id="description">Formel, die benutzt wurde, um den distolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).</items><items id="text">Formel für diastolischen Druck</items></items><items code="at1056"><items id="description">Fußrücken des Individuums.</items><items id="text">Fußrücken</items></items><items code="at1057"><items id="description">Strukturierte Körperstelle an der der Blutdruck gemessen wurde.</items><items id="text">Strukturierte Stelle der Messung</items></items><items code="at1058"><items id="comment">Zum Beispiel: Informationen bzgl. der lokalen Krankenhausabteilung oder zusätzliche Metadata zur Anpassung an entsprechende FHIR oder CIMI Gegenstücke.</items><items id="description">Zusätzliche Information, die für die Erfassung des lokalen Kontexts oder für die Anpassung an andere Referenzmodelle/Formalismen benötigt wird.</items><items id="text">Erweiterung</items></items><items code="at1059"><items id="description">Einzelnes Wort, Ausdruck oder Kurzbeschreibung der klinischen Bedeutung und Aussagekraft der Blutdruckmessung.</items><items id="text">Klinische Interpretation</items></items></term_definitions><term_definitions language="el"><items code="at0000"><items id="comment">Συνηθέστερα, η χρήση του όρου «αρτηριακή πίεση» αναφέρεται στη μέτρηση της πίεσης της βραχιόνιας αρτηρίας στο άνω μέρος του βραχίονα.</items><items id="description">Η τοπική μέτρηση της αρτηριακής πίεσης που είναι υποκατάστατο της αρτηριακής πίεσης στη συστηματική κυκλοφορία.</items><items id="text">Πίεση αίματος</items></items><items code="at0001"><items id="description">*History Structural node.(en)</items><items id="text">Ιστορικό</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">blood pressure</items></items><items code="at0004"><items id="description">Μέγιστη συστηματική αρτηριακή πίεση - μετρούμενη σε φάση συστολής ή συστολής του καρδιακού κύκλου.</items><items id="text">Συστολική</items></items><items code="at0005"><items id="description">Ελάχιστη συστηματική αρτηριακή πίεση - μετρούμενη στη διαστολική φάση ή στη φάση χαλάρωσης του καρδιακού κύκλου.</items><items id="text">Διαστολική</items></items><items code="at0006"><items id="description">Προεπιλεγμένο, απροσδιόριστο χρονικό σημείο ή συμβάν διαστήματος που μπορεί να ορίζεται ρητά σε ένα πρότυπο ή κατά το χρόνο εκτέλεσης.</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">Η θέση του ατόμου κατά τη στιγμή της μέτρησης.</items><items id="text">Θέση</items></items><items code="at0011"><items id="description">Δομή λίστας.</items><items id="text">Δομή λίστας</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Προσδιορισμός της ανθρώπινης αρτηριακής πίεσης με σφυγμομανομετρία. Κυκλοφορία 1993; 88;2460-2470.</items><items id="description">Το μέγεθος του περιβραχιονίου που χρησιμοποιείται για τη μέτρηση της αρτηριακής πίεσης.</items><items id="text">Mέγεθος περιβραχιονίου</items></items><items code="at0014"><items id="description">Απλό σημείο του σώματος όπου μετρήθηκε η αρτηριακή πίεση.</items><items id="text">Θέση μέτρησης</items></items><items code="at0015"><items id="description">Ένα περιβραχιόνιο που χρησιμοποιείται για έναν μηρό ενηλίκων.</items><items id="text">Μηρός ενηλίκων</items></items><items code="at0016"><items id="description">Ένα περιβραχιόνιο για ενήλικες με μεγαλύτερα χέρια.</items><items id="text">Μεγάλος ενήλικας</items></items><items code="at0017"><items id="description">Ένα περιβραχιόνιο που είναι στάνταρ για έναν ενήλικα.</items><items id="text">Ενήλικας</items></items><items code="at0025"><items id="description">Το δεξί χέρι του ατόμου.</items><items id="text">Δεξιός βραχίωνας</items></items><items code="at0026"><items id="description">Ο αριστερός βραχίονας του ατόμου.</items><items id="text">Αριστερός βραχίωνας</items></items><items code="at0027"><items id="description">Ο δεξιός μηρός του ατόμου.</items><items id="text">Δεξιός μηρός</items></items><items code="at0028"><items id="description">Ο αριστερός μηρός του ατόμου.</items><items id="text">Αριστερός μηρός</items></items><items code="at0033"><items id="description">Πρόσθετη αφήγηση σχετικά με τη μέτρηση, που δεν αποτυπώνεται σε άλλα πεδία.</items><items id="text">Σχόλιο</items></items><items code="at1000"><items id="description">Στέκεται κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.</items><items id="text">Ορθοστασία</items></items><items code="at1001"><items id="description">Καθιστή θέση (για παράδειγμα στο κρεβάτι ή την καρέκλα) κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.</items><items id="text">Καθιστή θέση</items></items><items code="at1002"><items id="description">Ανάκλιση κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.</items><items id="text">Ανακλινομενη θέση</items></items><items code="at1003"><items id="description">Ξαπλωμένη κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.</items><items id="text">Ξαπλωμένη θέση</items></items><items code="at1005"><items id="description">Η κρανιοουραία κλίση της επιφάνειας στην οποία βρίσκεται το άτομο κατά τη στιγμή της μέτρησης.</items><items id="text">Σε κλίση</items></items><items code="at1006"><items id="description">Η μέση αρτηριακή πίεση που εμφανίζεται καθ 'όλη τη διάρκεια του κύκλου συστολής και χαλάρωσης της καρδιάς.</items><items id="text">Μέση αρτηριακή πίεση</items></items><items code="at1007"><items id="description">Η διαφορά μεταξύ της συστολικής και της διαστολικής πίεσης.</items><items id="text">Παλμική πίεση</items></items><items code="at1008"><items id="description">Ένα περιβραχιόνιο που χρησιμοποιείται για έναν μικρό ενήλικα.</items><items id="text">Μικρός ενήλικας</items></items><items code="at1009"><items id="description">Ένα περιβραχιόνιο που είναι κατάλληλη για παιδί ή ενήλικα με λεπτό χέρι.</items><items id="text">Παιδικό</items></items><items code="at1010"><items id="description">Καταγράψτε ποιος ήχος Korotkoff χρησιμοποιείται για τον προσδιορισμό της διαστολικής πίεσης χρησιμοποιώντας ακουστική μέθοδο.</items><items id="text">Διαστολικό καταληκτικό σημείο</items></items><items code="at1011"><items id="description">Ο τέταρτος ήχος Korotkoff αναγνωρίζεται ως ένα απότομο σιγαστήρα ήχων.</items><items id="text">Phase IV</items></items><items code="at1012"><items id="description">Ο πέμπτος ήχος Korotkoff αναγνωρίζεται από την απουσία ήχων καθώς η πίεση της μανσέτας πέφτει κάτω από τη διαστολική αρτηριακή πίεση.</items><items id="text">Phase V</items></items><items code="at1014"><items id="description">Ξαπλωμένη επίπεδη με κάποια πλευρική κλίση, συνήθως υπό γωνία προς την αριστερή πλευρά. Συνήθως απαιτείται στο τελευταίο τρίμηνο της εγκυμοσύνης για την ανακούφιση της συμπίεσης της αορτοκαβάλης.</items><items id="text">Ξαπλωμένη με κλίση προς τα αριστερά</items></items><items code="at1018"><items id="description">Ένα περιβραχιόνιο για βρέφη</items><items id="text">Βρέφη</items></items><items code="at1019"><items id="description">Ένα περιβραχιόνιο που χρησιμοποιείται για νεογνά</items><items id="text">Νεογνά</items></items><items code="at1020"><items id="description">Ο δεξιός καρπός του ατόμου.</items><items id="text">Δεξιός καρπός</items></items><items code="at1021"><items id="description">Ο αριστερός καρπός του ατόμου.</items><items id="text">Αριστερός καρπός</items></items><items code="at1025"><items id="description">Λεπτομέρειες σχετικά με το σφυγμομανόμετρο ή άλλη συσκευή που χρησιμοποιείται για τη μέτρηση της αρτηριακής πίεσης.</items><items id="text">Συσκευή</items></items><items code="at1026"><items id="description">Ο δεξιός αστράγαλος του ατόμου.</items><items id="text">Δεξιός αστράγαλος</items></items><items code="at1030"><items id="description">*Details about physical activity undertaken at the time of blood pressure measurement.(en)</items><items id="text">*Exertion(en)</items></items><items code="at1031"><items id="description">Ο αριστερός αστράγαλος του ατόμου.</items><items id="text">Αριστερός αστράγαλος</items></items><items code="at1032"><items id="description">Ένα δάχτυλο του ατόμου.</items><items id="text">Δάχτυλο</items></items><items code="at1035"><items id="description">Μέθοδος μέτρησης της αρτηριακής πίεσης.</items><items id="text">Μέθοδος</items></items><items code="at1036"><items id="description">Μέθοδος μέτρησης της αρτηριακής πίεσης εξωτερικά, χρησιμοποιώντας στηθοσκόπιο και ήχους Korotkoff</items><items id="text">Ακρόαση</items></items><items code="at1037"><items id="description">Μέθοδος μέτρησης της αρτηριακής πίεσης εξωτερικά, χρησιμοποιώντας ψηλάφηση (συνήθως των βραχιονίων ή ακτινωτών αρτηριών).</items><items id="text">Ψηλάφιση</items></items><items code="at1038"><items id="description">Τύπος που χρησιμοποιείται για τον υπολογισμό της μέσης αρτηριακής πίεσης (εάν καταγράφεται στα δεδομένα).</items><items id="text">Τύπος μέσης αρτηριακής πίεσης</items></items><items code="at1039"><items id="description">Μέθοδος μέτρησης της αρτηριακής πίεσης εξωτερικά, χρησιμοποιώντας μια μηχανή αρτηριακής πίεσης.</items><items id="text">Μηχανή</items></items><items code="at1040"><items id="description">Μέθοδος μέτρησης της αρτηριακής πίεσης εσωτερικά, δηλαδή περιλαμβάνει διείσδυση του δέρματος και μέτρηση μέσα στα αιμοφόρα αγγεία.</items><items id="text">Επεμβατική</items></items><items code="at1042"><items id="description">Εκτίμηση της μέσης αρτηριακής πίεσης σε μια περίοδο 24 ωρών.</items><items id="text">24ωρος μέσος όρος</items></items><items code="at1043"><items id="description">Κατάσταση ύπνου - υποστηρίζει την ερμηνεία των 24ωρων περιπατητικών αρχείων αρτηριακής πίεσης</items><items id="text">Κατάσταση ύπνου</items></items><items code="at1044"><items id="description">Το άτομο έχει πλήρη συνείδηση.</items><items id="text">Ξύπνια</items></items><items code="at1045"><items id="description">Το άτομο βρίσκεται στη φυσική κατάσταση της σωματικής ανάπαυσης.</items><items id="text">Aνάπαυσης</items></items><items code="at1051"><items id="description">Ένα δάχτυλο του ατόμου.</items><items id="text">Δάχτυλο ποδιού</items></items><items code="at1052"><items id="description">Σχολιάστε και καταγράψτε άλλους τυχαίους παράγοντες που μπορεί να συμβάλλουν στη μέτρηση της αρτηριακής πίεσης. Για παράδειγμα, επίπεδο άγχους ή «σύνδρομο λευκού τριχώματος». πόνος ή πυρετός. αλλαγές στην ατμοσφαιρική πίεση κ. λπ.</items><items id="text">Συγχυτικοί παράγοντες</items></items><items code="at1053"><items id="description">Επεμβατική μέτρηση μέσω γραμμής πρόσβασης μορφοτροπέα εντός μιας αρτηρίας.</items><items id="text">Ενδοαρτηριακή</items></items><items code="at1054"><items id="description">Τύπος που χρησιμοποιείται για τον υπολογισμό της συστολικής πίεσης από τη μέση αρτηριακή πίεση (εάν καταγράφεται στα δεδομένα).</items><items id="text">Τύπος συστολικής πίεσης</items></items><items code="at1055"><items id="description">Τύπος που χρησιμοποιείται για τον υπολογισμό της διαστολικής πίεσης από τη μέση αρτηριακή πίεση (εάν καταγράφεται στα δεδομένα).</items><items id="text">Τύπος διαστολικής πίεσης</items></items><items code="at1056"><items id="description">Η ράχη του ατόμου του ποδιού.</items><items id="text">Ράχη ποδιού</items></items><items code="at1057"><items id="description">Δομημένη ανατομική θέση του σημείου όπου έγινε η μέτρηση.</items><items id="text">Δομημένη τοποθεσία μέτρησης</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">Μία λέξη, φράση ή σύντομη περιγραφή που αντιπροσωπεύει την κλινική έννοια και σημασία της μέτρησης της αρτηριακής πίεσης.</items><items id="text">Κλινική ερμηνεία</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="comment">Most commonly, use of the term 'blood pressure' refers to measurement of brachial artery pressure in the upper arm.</items><items id="description">The local measurement of arterial blood pressure which is a surrogate for arterial pressure in the systemic circulation.</items><items id="text">Blood pressure</items></items><items code="at0001"><items id="description">History Structural node.</items><items id="text">History</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">blood pressure</items></items><items code="at0004"><items id="description">Peak systemic arterial blood pressure  - measured in systolic or contraction phase of the heart cycle.</items><items id="text">Systolic</items></items><items code="at0005"><items id="description">Minimum systemic arterial blood pressure - measured in the diastolic or relaxation phase of the heart cycle.</items><items id="text">Diastolic</items></items><items code="at0006"><items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items><items id="text">Any event</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">The position of the individual at the time of measurement.</items><items id="text">Position</items></items><items code="at0011"><items id="description">List structure.</items><items id="text">Tree</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470. </items><items id="description">The size of the cuff used for blood pressure measurement.</items><items id="text">Cuff size</items></items><items code="at0014"><items id="description">Simple body site where blood pressure was measured.</items><items id="text">Location of measurement</items></items><items code="at0015"><items id="description">A cuff used for an adult thigh.</items><items id="text">Adult Thigh</items></items><items code="at0016"><items id="description">A cuff for adults with larger arms.</items><items id="text">Large Adult</items></items><items code="at0017"><items id="description">A cuff that is standard for an adult.</items><items id="text">Adult</items></items><items code="at0025"><items id="description">The right arm of the person.</items><items id="text">Right arm</items></items><items code="at0026"><items id="description">The left arm of the person.</items><items id="text">Left arm</items></items><items code="at0027"><items id="description">The right thigh of the person.</items><items id="text">Right thigh</items></items><items code="at0028"><items id="description">The left thigh of the person.</items><items id="text">Left thigh</items></items><items code="at0033"><items id="description">Additional narrative about the measurement, not captured in other fields.</items><items id="text">Comment</items></items><items code="at1000"><items id="description">Standing at the time of blood pressure measurement.</items><items id="text">Standing</items></items><items code="at1001"><items id="description">Sitting (for example on bed or chair) at the time of blood pressure measurement.</items><items id="text">Sitting</items></items><items code="at1002"><items id="description">Reclining at the time of blood pressure measurement.</items><items id="text">Reclining</items></items><items code="at1003"><items id="description">Lying flat at the time of blood pressure measurement.</items><items id="text">Lying</items></items><items code="at1005"><items id="description">The craniocaudal tilt of the surface on which the person is lying at the time of measurement.</items><items id="text">Tilt</items></items><items code="at1006"><items id="description">The average arterial pressure that occurs over the entire course of the heart contraction and relaxation cycle.</items><items id="text">Mean arterial pressure</items></items><items code="at1007"><items id="description">The difference between the systolic and diastolic pressure.</items><items id="text">Pulse pressure</items></items><items code="at1008"><items id="description">A cuff used for a small adult.</items><items id="text">Small Adult</items></items><items code="at1009"><items id="description">A cuff that is appropriate for a child or adult with a thin arm.</items><items id="text">Paediatric/Child</items></items><items code="at1010"><items id="description">Record which Korotkoff sound is used for determining diastolic pressure using auscultative method.</items><items id="text">Diastolic endpoint</items></items><items code="at1011"><items id="description">The fourth Korotkoff sound is identified as an abrupt muffling of sounds.</items><items id="text">Phase IV</items></items><items code="at1012"><items id="description">The fifth Korotkoff sound is identified by absence of sounds as the cuff pressure drops below the diastolic blood pressure.</items><items id="text">Phase V</items></items><items code="at1014"><items id="description">Lying flat with some lateral tilt, usually angled towards the left side.   Commonly required in the last trimester of pregnancy to relieve aortocaval compression.</items><items id="text">Lying with tilt to left</items></items><items code="at1018"><items id="description">A cuff used for infants.</items><items id="text">Infant</items></items><items code="at1019"><items id="description">A cuff used for a neonate, assuming cuff is the appropriate size for maturity and birthweight of the neonate.</items><items id="text">Neonatal</items></items><items code="at1020"><items id="description">The right wrist of the individual.</items><items id="text">Right wrist</items></items><items code="at1021"><items id="description">The left wrist of the individual.</items><items id="text">Left wrist</items></items><items code="at1025"><items id="description">Details about sphygmomanometer or other device used to measure the blood pressure.</items><items id="text">Device</items></items><items code="at1026"><items id="description">The right ankle of the individual.</items><items id="text">Right ankle</items></items><items code="at1030"><items id="description">Details about physical activity undertaken at the time of blood pressure measurement.</items><items id="text">Exertion</items></items><items code="at1031"><items id="description">The left ankle of the individual.</items><items id="text">Left ankle</items></items><items code="at1032"><items id="description">A finger of the individual.</items><items id="text">Finger</items></items><items code="at1035"><items id="description">Method of measurement of blood pressure.</items><items id="text">Method</items></items><items code="at1036"><items id="description">Method of measuring blood pressure externally, using a stethoscope and Korotkoff sounds.</items><items id="text">Auscultation</items></items><items code="at1037"><items id="description">Method of measuring blood pressure externally, using palpation (usually of the brachial or radial arteries).</items><items id="text">Palpation</items></items><items code="at1038"><items id="description">Formula used to calculate the Mean Arterial Pressure (if recorded in data).</items><items id="text">Mean arterial pressure formula</items></items><items code="at1039"><items id="description">Method of measuring blood pressure externally, using a blood pressure machine.</items><items id="text">Machine</items></items><items code="at1040"><items id="description">Method of measuring blood pressure internally ie involving penetration of the skin and measuring inside blood vessels.</items><items id="text">Invasive</items></items><items code="at1042"><items id="description">Estimate of the average blood pressure over a 24 hour period.</items><items id="text">24 hour average</items></items><items code="at1043"><items id="description">Sleep status - supports interpretation of 24 hour ambulatory blood pressure records.</items><items id="text">Sleep status</items></items><items code="at1044"><items id="description">The individual is fully conscious.</items><items id="text">Awake</items></items><items code="at1045"><items id="description">The individual is in the natural state of bodily rest.</items><items id="text">Sleeping</items></items><items code="at1051"><items id="description">A toe of the individual.</items><items id="text">Toe</items></items><items code="at1052"><items id="description">Comment on and record other incidental factors that may be contributing to the blood pressure measurement.  For example, level of anxiety or 'white coat syndrome'; pain or fever; changes in atmospheric pressure etc.</items><items id="text">Confounding factors</items></items><items code="at1053"><items id="description">Invasive measurement via transducer access line within an artery.</items><items id="text">Intra-arterial</items></items><items code="at1054"><items id="description">Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).</items><items id="text">Systolic pressure formula</items></items><items code="at1055"><items id="description">Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).</items><items id="text">Diastolic pressure formula</items></items><items code="at1056"><items id="description">The individual's dorsum of the foot.</items><items id="text">Dorsum of foot</items></items><items code="at1057"><items id="description">Structured anatomical location of where the measurement was taken.</items><items id="text">Structured measurement location</items></items><items code="at1058"><items id="comment">For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local context or to align with other reference models/formalisms.</items><items id="text">Extension</items></items><items code="at1059"><items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the blood pressure measurement.</items><items id="text">Clinical interpretation</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="comment">Por lo general, el término «presión arterial» se refiere a la medición de la presión en la arteria braquial, situada en la parte superior del brazo.</items><items id="description">La medición local de la presión arterial, que es un sustituto de la presión arterial en la circulación sistémica.</items><items id="text">Presión arterial</items></items><items code="at0001"><items id="description">Nodo estructural de historia.</items><items id="text">Historia</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">blood pressure</items></items><items code="at0004"><items id="description">Presión arterial sistémica máxima - medida en la fase sistólica o de contracción del ciclo cardíaco.</items><items id="text">Sistólica</items></items><items code="at0005"><items id="description">Presión arterial sistémica mínima - medida en la fase diastólica o de relajación del ciclo cardíaco.</items><items id="text">Diastólica</items></items><items code="at0006"><items id="description">Evento predeterminado, sin especificar en el tiempo o intervalo, que puede definirse explícitamente en una plantilla o en tiempo de ejecución.</items><items id="text">Cualquier evento</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">La posición del individuo en el momento de la medición.</items><items id="text">Posición</items></items><items code="at0011"><items id="description">Estructura de la lista.</items><items id="text">Árbol</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">El tamaño del manguito utilizado para medir la presión arterial.</items><items id="text">Tamaño del manguito</items></items><items code="at0014"><items id="description">Zona del cuerpo donde se midió la presión arterial.</items><items id="text">Localización de la medición</items></items><items code="at0015"><items id="description">Un manguito utilizado para el muslo de un adulto.</items><items id="text">Muslo Adulto</items></items><items code="at0016"><items id="description">Un manguito para adultos con brazos más grandes.</items><items id="text">Adulto Grande</items></items><items code="at0017"><items id="description">Un manguito estándar para adultos.</items><items id="text">Adulto</items></items><items code="at0025"><items id="description">El brazo derecho de la persona.</items><items id="text">Brazo derecho</items></items><items code="at0026"><items id="description">El brazo izquierdo de la persona.</items><items id="text">Brazo izquierdo</items></items><items code="at0027"><items id="description">El muslo derecho de la persona.</items><items id="text">Muslo derecho</items></items><items code="at0028"><items id="description">Muslo izquierdo del paciente</items><items id="text">Muslo izquierdo</items></items><items code="at0033"><items id="description">Información adicional sobre la medición que no se recoge en otros campos.</items><items id="text">Comentario</items></items><items code="at1000"><items id="description">De pie en el momento de la medición de la presión arterial.</items><items id="text">De pie</items></items><items code="at1001"><items id="description">Sentado (por ejemplo, en la cama o en una silla) en el momento de la medición de la presión arterial.</items><items id="text">Sentado</items></items><items code="at1002"><items id="description">Reclinado en el momento de la medición de la presión arterial.</items><items id="text">Reclinado</items></items><items code="at1003"><items id="description">Acostado en el momento de la medición de la presión arterial.</items><items id="text">Acostado</items></items><items code="at1005"><items id="comment">NOTA: "°" es una unidad válida en UCUM. Utilice "deg" como unidad correcta.</items><items id="description">La inclinación craneocaudal de la superficie sobre la que se encuentra la persona en el momento de la medición.</items><items id="text">Inclinación</items></items><items code="at1006"><items id="description">La presión arterial media que se produce a lo largo de todo el ciclo de contracción y relajación del corazón.</items><items id="text">Presión arterial media</items></items><items code="at1007"><items id="description">La diferencia entre la presión sistólica y la presión diastólica.</items><items id="text">Presión del pulso</items></items><items code="at1008"><items id="description">Un manguito utilizado para adultos de complexión pequeña.</items><items id="text">Adulto Pequeño</items></items><items code="at1009"><items id="description">Un manguito adecuado para niños o adultos con brazos delgados.</items><items id="text">Pediátrico/Niños</items></items><items code="at1010"><items id="description">Registre qué sonido de Korotkoff se utiliza para determinar la presión diastólica mediante el método auscultativo.</items><items id="text">Punto final diastólico</items></items><items code="at1011"><items id="description">El cuarto sonido de Korotkoff se identifica como un abrupto amortiguamiento de los sonidos.</items><items id="text">Fase IV</items></items><items code="at1012"><items id="description">El quinto sonido de Korotkoff se identifica por la ausencia de sonidos cuando la presión del manguito desciende por debajo de la presión arterial diastólica.</items><items id="text">Fase V</items></items><items code="at1014"><items id="description">Acostada boca arriba con cierta inclinación lateral, normalmente hacia el lado izquierdo. Se suele requerir en el último trimestre del embarazo para aliviar la compresión aortocava.</items><items id="text">Tumbado con inclinación hacia la izquierda</items></items><items code="at1018"><items id="description">Un manguito utilizado para bebés.</items><items id="text">Bebé</items></items><items code="at1019"><items id="description">Un manguito utilizado para un recién nacido, suponiendo que el manguito sea del tamaño adecuado para la madurez y el peso al nacer del recién nacido.</items><items id="text">Neonatal</items></items><items code="at1020"><items id="description">La muñeca derecha de la persona.</items><items id="text">Muñeca derecha</items></items><items code="at1021"><items id="description">La muñeca izquierda de la persona.</items><items id="text">Muñeca izquierda</items></items><items code="at1025"><items id="description">Detalles sobre el esfigmomanómetro u otro dispositivo utilizado para medir la presión arterial.</items><items id="text">Dispositivo</items></items><items code="at1026"><items id="description">El tobillo derecho de la persona.</items><items id="text">Tobillo derecho</items></items><items code="at1030"><items id="description">Detalles sobre la actividad física realizada en el momento de la medición de la presión arterial.</items><items id="text">Esfuerzo</items></items><items code="at1031"><items id="description">El tobillo izquierdo de la persona.</items><items id="text">Tobillo izquierdo</items></items><items code="at1032"><items id="description">Un dedo de la mano de la persona.</items><items id="text">Dedo de la mano</items></items><items code="at1035"><items id="description">Método de medición de la presión arterial.</items><items id="text">Método</items></items><items code="at1036"><items id="description">Método para medir la presión arterial de forma externa, utilizando un estetoscopio y los sonidos de Korotkoff.</items><items id="text">Auscultación</items></items><items code="at1037"><items id="description">Método para medir la presión arterial de forma externa, mediante palpación (normalmente de las arterias braquial o radial).</items><items id="text">Palpación</items></items><items code="at1038"><items id="description">Fórmula utilizada para calcular la presión arterial media (si se registra en los datos).</items><items id="text">Fórmula de la presión arterial media</items></items><items code="at1039"><items id="description">Método para medir la presión arterial de forma externa, utilizando un tensiómetro.</items><items id="text">Aparato</items></items><items code="at1040"><items id="description">Método para medir la presión arterial internamente, es decir, mediante la penetración de la piel y la medición dentro de los vasos sanguíneos.</items><items id="text">Invasivo</items></items><items code="at1042"><items id="description">Estimación de la presión arterial media durante un periodo de 24 horas.</items><items id="text">Promedio de 24 horas</items></items><items code="at1043"><items id="description">Estado del sueño - permite interpretar los registros de presión arterial ambulatoria de 24 horas.</items><items id="text">Estado del sueño</items></items><items code="at1044"><items id="description">El individuo está plenamente consciente.</items><items id="text">Despierto</items></items><items code="at1045"><items id="description">El individuo se encuentra en un estado natural de reposo corporal.</items><items id="text">Durmiendo</items></items><items code="at1051"><items id="description">Un dedo del pie de la persona.</items><items id="text">Dedo del pie</items></items><items code="at1052"><items id="description">Comente y registre otros factores incidentales que puedan estar contribuyendo a la medición de la presión arterial. Por ejemplo, el nivel de ansiedad o el «síndrome de la bata blanca», dolor o fiebre, cambios en la presión atmosférica, etc.</items><items id="text">Factores de confusión</items></items><items code="at1053"><items id="description">Medición invasiva mediante una línea de acceso al transductor dentro de una arteria.</items><items id="text">Intraarterial</items></items><items code="at1054"><items id="description">Fórmula utilizada para calcular la presión sistólica a partir de la presión arterial media (si se registra en los datos).</items><items id="text">Fórmula de la presión sistólica</items></items><items code="at1055"><items id="description">Fórmula utilizada para calcular la presión diastólica a partir de la presión arterial media (si se registra en los datos).</items><items id="text">Fórmula de la presión diastólica</items></items><items code="at1056"><items id="description">El dorso del pie de la persona.</items><items id="text">Dorso del pie</items></items><items code="at1057"><items id="description">Localización anatómica estructurada del lugar donde se tomó la medida.</items><items id="text">Lugar de medición estructurado</items></items><items code="at1058"><items id="comment">Por ejemplo: información departamental de hospitales locales o metadatos adicionales para alinearse con los equivalentes FHIR o CIMI.</items><items id="description">Información adicional necesaria para captar el contexto local o para alinearse con otros modelos de referencia/formalismos.</items><items id="text">Extensión</items></items><items code="at1059"><items id="description">Palabra, frase o breve descripción que representa el significado clínico y la importancia de la medición de la presión arterial.</items><items id="text">Interpretación clínica</items></items></term_definitions><term_definitions language="es-ar"><items code="at0000"><items id="description">La medición local de la tensión arterial que deriva de la medida de la presión arterial en la circulación sistémica. Comúnmente el uso de 'presión arterial' se refiere a la medida de la presión de la arteria braquial por encima del pliegue del codo.</items><items id="text">Presión Arterial</items></items><items code="at0001"><items id="description">historia Nodo estructural</items><items id="text">historia</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">Presión arterial sistólica pico - medido en sístole o la fase de contracción del ciclo cardíaco</items><items id="text">Sistólica</items></items><items code="at0005"><items id="description">Presión arterial sistémica mínima - medido durante la diástole o fase de relajación del ciclo cardíaco.</items><items id="text">Diástole</items></items><items code="at0006"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">La posición del individuo en el momento del registro.</items><items id="text">Posición</items></items><items code="at0011"><items id="description">estructura tipo lista</items><items id="text">estructura de lista</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Presión arterial humana determinado por esfingomanómetro. Circulation 1993;88;2460-2470.</items><items id="description">El tamaño del manguito usado para la toma de la presión arterial</items><items id="text">Tamaño del manguito</items></items><items code="at0014"><items id="description">*Simple body site where blood pressure was measured.(en)</items><items id="text">*Location of measurement(en)</items></items><items code="at0015"><items id="description">Un manguito usado para el muslo del adulto - cámara de caucho aproximadamente de 20cm x 42 cm</items><items id="text">Muslo Adulto</items></items><items code="at0016"><items id="description">Un manguito para adultos con brazos mas grandes - cámara de caucho aproximadamente de 16cm x 38cm.</items><items id="text">Adulto grande</items></items><items code="at0017"><items id="description">Un manguito estándar para adulto - cámara de caucho approximadamente de 13cm x 30cm.</items><items id="text">Adulto</items></items><items code="at0025"><items id="description">El brazo derecho del individuo</items><items id="text">Brazo derecho</items></items><items code="at0026"><items id="description">El brazo izquierdo del individuo</items><items id="text">Brazo izquierdo</items></items><items code="at0027"><items id="description">El muslo derecho del individuo</items><items id="text">Muslo derecho</items></items><items code="at0028"><items id="description">El muslo izquierdo del individuo</items><items id="text">Muslo izquierdo</items></items><items code="at0033"><items id="description">*Additional narrative about the measurement, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at1000"><items id="description">De pie al momento de la medición de la tensión arterial.</items><items id="text">De pie</items></items><items code="at1001"><items id="description">Sentado (en la cama o en una silla) durante el registro de la presión arterial </items><items id="text">Sentado</items></items><items code="at1002"><items id="description">Reclinado (semisentado) durante el registro de la presión arterial</items><items id="text">Reclinado</items></items><items code="at1003"><items id="description">Acostado horizontal durante la medición de la presión arterial</items><items id="text">Acostado</items></items><items code="at1005"><items id="comment">*PLEASE NOTE: '°' is a valid UCUM unit. Please use 'deg' as the correct unit.(en)</items><items id="description">*The craniocaudal tilt of the surface on which the person is lying at the time of measurement.(en)</items><items id="text">*Tilt(en)</items></items><items code="at1006"><items id="description">La presión arterial promedio que ocurre durante el ciclo entero de la contracción y relajación del corazon</items><items id="text">Presión Arterial Media</items></items><items code="at1007"><items id="description">La diferencia entre la presión sistólica y la presión diastólica</items><items id="text">Presión de Pulso</items></items><items code="at1008"><items id="description">Un manguito usado para adulto pequeño - cámara de caucho approximadamente de 10cm x 24cm.</items><items id="text">Adulto pequeño</items></items><items code="at1009"><items id="description">Un manguito que es apropiado para un niño o un adulto con brazos delgados - cámara de caucho approximadamente 8cm x 21cm.</items><items id="text">Pediátrico/Niño</items></items><items code="at1010"><items id="description">Registro usando los sonidos de Korotkoff para determinar la presión diastólica</items><items id="text">Punto final diastólica</items></items><items code="at1011"><items id="description">El cuarto sonido de Korotkoff se identifica como una abrupta amortiguación de sonidos.</items><items id="text">Fase IV</items></items><items code="at1012"><items id="description">El quinto sonido de Korotkoff se identifica como la ausencia de sonidos a medida que la presión del manguito insuflado cae por debajo de la presión arterial diastólica.</items><items id="text">Fase V</items></items><items code="at1014"><items id="description">Acostado horizontal e inclinado levemente sobre su costado izquierdo. Comúnmente se requiere durante el último trimestre del embarazo para aliviar la compresión aortocava.</items><items id="text">Acostado e inclinado levemente sobre su costado izquierdo</items></items><items code="at1018"><items id="description">Un manguito usado para infantes - cámara de caucho approximadamente de 5cm x 15cm.</items><items id="text">Infantil</items></items><items code="at1019"><items id="description">Un manguito usado para neonatos, asumiendo que es del tamaño adecuado para la madurez y el peso corporal del neonato.</items><items id="text">Neonatal</items></items><items code="at1020"><items id="description">La muñeca derecha del individuo.</items><items id="text">Muñeca derecha</items></items><items code="at1021"><items id="description">La muñeca inquierda del individuo.</items><items id="text">Muñeca izquierda</items></items><items code="at1025"><items id="description">Detalles del esfingomanómetro u otro dispositivo usado para medir la presión arterial.</items><items id="text">Dispositivo</items></items><items code="at1026"><items id="description">El tobillo derecho del individuo.</items><items id="text">Tobillo derecho</items></items><items code="at1030"><items id="description">Detalles de la actividad física realizados durante la medición de la presión arterial </items><items id="text">Ejercicio</items></items><items code="at1031"><items id="description">El tobillo izquierdo del individuo</items><items id="text">Tobillo izquierdo</items></items><items code="at1032"><items id="description">*A finger of the individual.(en)</items><items id="text">*Finger(en)</items></items><items code="at1035"><items id="description">Método de la medición de la presión arterial</items><items id="text">Método</items></items><items code="at1036"><items id="description">Método de la medición de la presión arterial externa, usando un estetoscopio y los sonidos de Korotkoff</items><items id="text">Auscultación</items></items><items code="at1037"><items id="description">Método de medición de la presión arterial externa, usando palpación (normalmente de la arteria humeral o radial).</items><items id="text">Palpación</items></items><items code="at1038"><items id="description">Fórmula usada para calcular la PAM (si se registra en el campo data)</items><items id="text">Fórmula de la Presión Arterial Media (PAM)</items></items><items code="at1039"><items id="description">Método de medición de la presión arterial externa, utilizando un monitor automático (mecánico) de presión arterial</items><items id="text">Máquina</items></items><items code="at1040"><items id="description">Método de medición de la presión arterial interna o sea invasiva: punción de la piel y la introducción de un cateter para medir dentro de un vaso sanguíneo.</items><items id="text">Invasivo</items></items><items code="at1042"><items id="description">Estimativo de la media de la presión arterial sobre un período de 24 horas</items><items id="text">Promedio de 24 horas</items></items><items code="at1043"><items id="description">Estado del sueño - soporta la interpretación de los registros de presión arterial ambulatorios de 24 horas</items><items id="text">Estado del sueño</items></items><items code="at1044"><items id="description">El sujeto esta plenamente consciente</items><items id="text">Alerta y despierto</items></items><items code="at1045"><items id="description">El sujeto esta en un estado natural de sueño corporal</items><items id="text">Dormido</items></items><items code="at1051"><items id="description">*A toe of the individual.(en)</items><items id="text">*Toe(en)</items></items><items code="at1052"><items id="description">Comentario y registro sobre otros factores que pueden incidir sobre la medición de la presión arterial. Por ejemplo: nivel de ansiedad o "síndrome del guardapolvo blanco"; dolor o fiebre; cambios en la presión atmosférica etc.</items><items id="text">Factores confluentes</items></items><items code="at1053"><items id="description">*Invasive measurement via transducer access line within an artery.(en)</items><items id="text">*Intra-arterial(en)</items></items><items code="at1054"><items id="description">*Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Systolic pressure formula(en)</items></items><items code="at1055"><items id="description">*Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Diastolic pressure formula(en)</items></items><items code="at1056"><items id="description">**(en)</items><items id="text">*Dorsum of foot(en)</items></items><items code="at1057"><items id="description">*Structured anatomical location of where the measurement was taken.(en)</items><items id="text">*Structured measurement location(en)</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">**(en)</items><items id="text">*New element(en)</items></items></term_definitions><term_definitions language="fa"><items code="at0000"><items id="description">اندازه گیری موضعی فشار خون وریدی، که جایگزینی برای فشار وریدی در گردش خون کلی است.&#13;
معمولا واژه "فشار خون" به اندازه گیری فشار ورید بازویی در روی بازو گفته می شود</items><items id="text">فشار خون</items></items><items code="at0001"><items id="description">گره ساختاری تاریخچه </items><items id="text">تاریخچه</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">اوج فشار خون وریدی کلی که در سیستولیک یا فاز انقباضی چرخه گردش خون اندازه گیری می شود </items><items id="text">سیستولیک</items></items><items code="at0005"><items id="description">حداقل فشار خون وریدی کلی که در دیاستولیک یا فاز انبساطی چرخه گردش خون اندازه گیری می شود</items><items id="text">دیاستولیک</items></items><items code="at0006"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">موقعیت فرد در زمان اندازه گیری </items><items id="text">موقعیت</items></items><items code="at0011"><items id="description">ساختار لیست </items><items id="text">ساختار لیست</items></items><items code="at0013"><items id="description">اندازه کاف استفاده شده برای اندازه گیری فشار خون</items><items id="text">اندازه کاف</items></items><items code="at0014"><items id="description">*Simple body site where blood pressure was measured.(en)</items><items id="text">*Location of measurement(en)</items></items><items code="at0015"><items id="description">کاف استفاده شده در ران بزرگسال -اندازه مثانه 20 سانتی متر در 42 سانتی متر</items><items id="text">ران بزرگسال</items></items><items code="at0016"><items id="description">کاف بزرگسالان با برآمدگی بازوی بزرگتر در حدود 16 در 38 سانتیمتر</items><items id="text">بزرگسال درشت</items></items><items code="at0017"><items id="description">*A cuff that is standard for an adult - bladder approx 13cm x 30cm.(en)</items><items id="text">*Adult(en)</items></items><items code="at0025"><items id="description">*The right arm of the person.(en)</items><items id="text">*Right arm(en)</items></items><items code="at0026"><items id="description">*The left arm of the person.(en)</items><items id="text">*Left arm(en)</items></items><items code="at0027"><items id="description">*The right thigh of the person.(en)</items><items id="text">*Right thigh(en)</items></items><items code="at0028"><items id="description">*The left thigh of the person.(en)</items><items id="text">*Left thigh(en)</items></items><items code="at0033"><items id="description">*Additional narrative about the measurement, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at1000"><items id="description">ایستاده در زمان اندازه گیری فشار خون</items><items id="text">ایستاده</items></items><items code="at1001"><items id="description">نشسته ( به عنوان مثال روی تخت یا صندلی) در زمان اندازه گیری فشار خون</items><items id="text">نشسته</items></items><items code="at1002"><items id="description">خمیده در زمان اندازه گیری فشار خون</items><items id="text">خمیده</items></items><items code="at1003"><items id="description">خوابیده در زمان اندازه گیری فشار خون</items><items id="text">خوابیده</items></items><items code="at1005"><items id="comment">*PLEASE NOTE: '°' is a valid UCUM unit. Please use 'deg' as the correct unit.(en)</items><items id="description">*The craniocaudal tilt of the surface on which the person is lying at the time of measurement.(en)</items><items id="text">*Tilt(en)</items></items><items code="at1006"><items id="description">متوسط فشار خون وریدی که در کل دوره انقباظ و انبساط قلبی رخ می دهد</items><items id="text">میانگین فشار وریدی</items></items><items code="at1007"><items id="description">تفاوت بین فشار سیستولیک و دیاستولیک</items><items id="text">فشار نبضی</items></items><items code="at1008"><items id="description">*A cuff used for a small adult - bladder approx 10cm x 24cm.(en)</items><items id="text">*Small Adult(en)</items></items><items code="at1009"><items id="description">*A cuff that is appropriate for a child or adult with a thin arm - bladder approx 8cm x 21cm.(en)</items><items id="text">*Paediatric/Child(en)</items></items><items code="at1010"><items id="description">*Record which Korotkoff sound is used for determining diastolic pressure using auscultative method.(en)</items><items id="text">*Diastolic endpoint(en)</items></items><items code="at1011"><items id="description">*The fourth Korotkoff sound is identified as an abrupt muffling of sounds.(en)</items><items id="text">*Phase IV(en)</items></items><items code="at1012"><items id="description">*The fifth Korotkoff sound is identified by absence of sounds as the cuff pressure drops below the diastolic blood pressure.(en)</items><items id="text">*Phase V(en)</items></items><items code="at1014"><items id="description">خوابیدن صاف با کمی تمایل به یک سمت، معمولا به جهت چپ میل کرده و عموما در سه ماهه آخر حاملگی برای تسکین فشار آئورت نیاز به آن است</items><items id="text">خوابیده  به چپ</items></items><items code="at1018"><items id="description">*A cuff used for infants - bladder approx 5cm x 15cm.(en)</items><items id="text">*Infant(en)</items></items><items code="at1019"><items id="description">*A cuff used for a neonate, assuming cuff is the appropriate size for maturity and birthweight of the neonate.(en)</items><items id="text">*Neonatal(en)</items></items><items code="at1020"><items id="description">*The right wrist of the individual.(en)</items><items id="text">*Right wrist(en)</items></items><items code="at1021"><items id="description">*The left wrist of the individual.(en)</items><items id="text">*Left wrist(en)</items></items><items code="at1025"><items id="description">*Details about sphygmomanometer or other device used to measure the blood pressure.(en)</items><items id="text">*Device(en)</items></items><items code="at1026"><items id="description">*The right ankle of the individual.(en)</items><items id="text">*Right ankle(en)</items></items><items code="at1030"><items id="description">جزییاتی درباره فعالیت فیزیکی انجام شده در زمان اندازه گیری فشار خون </items><items id="text">تقلا</items></items><items code="at1031"><items id="description">*The left ankle of the individual.(en)</items><items id="text">*Left ankle(en)</items></items><items code="at1032"><items id="description">*A finger of the individual.(en)</items><items id="text">*Finger(en)</items></items><items code="at1035"><items id="description">*Method of measurement of blood pressure.(en)</items><items id="text">*Method(en)</items></items><items code="at1036"><items id="description">*Method of measuring blood pressure externally, using a stethoscope and Korotkoff sounds.(en)</items><items id="text">*Auscultation(en)</items></items><items code="at1037"><items id="description">*Method of measuring blood pressure externally, using palpation (usually of the brachial or radial arteries).(en)</items><items id="text">*Palpation(en)</items></items><items code="at1038"><items id="description">*Formula used to calculate the MAP (if recorded in data).(en)</items><items id="text">*Mean Arterial Pressure Formula(en)</items></items><items code="at1039"><items id="description">*Method of measuring blood pressure externally, using a blood pressure machine.(en)</items><items id="text">*Machine(en)</items></items><items code="at1040"><items id="description">*Method of measuring blood pressure internally ie involving penetration of the skin and measuring inside blood vessels.(en)</items><items id="text">*Invasive(en)</items></items><items code="at1042"><items id="description">برآورد میانگین فشار خون در دوره زمانی 24 ساعته</items><items id="text">میانگین 24 ساعته</items></items><items code="at1043"><items id="description">وضعیت خواب- به تفسیر ثبتهای صورت گرفته از فشار خون در خانه در طول 24 ساعت کمک می کند </items><items id="text">وضعیت خواب</items></items><items code="at1044"><items id="description">فرد کاملا به هوش است </items><items id="text">هشیار و بیدار</items></items><items code="at1045"><items id="description">فرد در حالت طبیعی استراحت بدنی است</items><items id="text">خوابیده</items></items><items code="at1051"><items id="description">*A toe of the individual.(en)</items><items id="text">*Toe(en)</items></items><items code="at1052"><items id="description">نظردهی و ثبت سایر عوامل ضمنی که ممکن است به اندازه گیری فشار خون کمک کنند . به عنوان مثال سطح اضطراب یا "سندرم روپوش سفید"، درد یا تب ، تغییرات فشار جوی و غیره </items><items id="text">عوامل مبهم</items></items><items code="at1053"><items id="description">*Invasive measurement via transducer access line within an artery.(en)</items><items id="text">*Intra-arterial(en)</items></items><items code="at1054"><items id="description">*Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Systolic pressure formula(en)</items></items><items code="at1055"><items id="description">*Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Diastolic pressure formula(en)</items></items><items code="at1056"><items id="description">**(en)</items><items id="text">*Dorsum of foot(en)</items></items><items code="at1057"><items id="description">*Structured anatomical location of where the measurement was taken.(en)</items><items id="text">*Structured measurement location(en)</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">**(en)</items><items id="text">*New element(en)</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="comment">Yleisimmin termi "verenpaine" viittaa olkavarsivaltimon paineen mittaamiseen yläraajasta.</items><items id="description">Paikallisen valtimopaineen mittaustulos, joka toimii korvikkeena systeemisen verenkierron valtimopaineelle. Termillä "verenpaine" viitataan yleensä olkavarresta tehtävään olkavarsivaltimon paineen mittaustulokseen.</items><items id="text">Verenpaine</items></items><items code="at0001"><items id="description">Historia-rakennesolmu.</items><items id="text">Historia</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">blood pressure</items></items><items code="at0004"><items id="description">Systeemisen verenkierron valtimoverenpaineen huippuarvo – mitataan sydämen supistumisvaiheessa.</items><items id="text">Systolinen</items></items><items code="at0005"><items id="description">Systeemisen verenkierron valtimoverenpaineen pienin arvo – mitataan sydämen lepovaiheessa.</items><items id="text">Diastolinen</items></items><items code="at0006"><items id="description">Oletusarvo, määrittämätön ajanhetki tai aikaväli, joka voidaan nimenomaisesti määritellä templaatilla tai suorituksen aikana.</items><items id="text">Mikä tahansa tapahtuma</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">Henkilön asento mittaushetkellä.</items><items id="text">Asento</items></items><items code="at0011"><items id="description">Luettelon rakenne.</items><items id="text">Puu</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">Verenpaineen mittauksessa käytetyn mansetin koko.</items><items id="text">Mansetin koko</items></items><items code="at0014"><items id="description">Kehon yksinkertaisesti ilmaistu kohta, josta verenpaine mitattiin.</items><items id="text">Mittauskohta</items></items><items code="at0015"><items id="description">Aikuisen reidessä käytettävä mansetti.</items><items id="text">Aikuisen reisi</items></items><items code="at0016"><items id="description">Mansetti aikuisille, joilla on paksut käsivarret.</items><items id="text">Aikuiset, suuri</items></items><items code="at0017"><items id="description">Standardikokoinen mansetti aikuisille.</items><items id="text">Aikuinen</items></items><items code="at0025"><items id="description">Henkilön oikea käsivarsi.</items><items id="text">Oikea käsivarsi</items></items><items code="at0026"><items id="description">Henkilön vasen käsivarsi.</items><items id="text">Vasen käsivarsi</items></items><items code="at0027"><items id="description">Henkilön oikea reisi.</items><items id="text">Oikea reisi</items></items><items code="at0028"><items id="description">Henkilön vasen reisi.</items><items id="text">Vasen reisi</items></items><items code="at0033"><items id="description">Mittauksen kertomusmuodossa olevat lisätiedot, joita ei voida ilmoittaa muissa kentissä.</items><items id="text">Kommentti</items></items><items code="at1000"><items id="description">Verenpaine mitataan henkilön seistessä.</items><items id="text">Seisten</items></items><items code="at1001"><items id="description">Verenpaine mitataan henkilön istuessa (esimerkiksi vuoteella tai tuolissa).</items><items id="text">Istuen</items></items><items code="at1002"><items id="description">Verenpaine mitataan henkilön nojatessa taaksepäin.</items><items id="text">Taaksepäin nojaten</items></items><items code="at1003"><items id="description">Verenpaine mitataan henkilön maatessa.</items><items id="text">Makuulla</items></items><items code="at1005"><items id="description">Kraniokaudaalinen kallistuma alustalla, jolla henkilö makaa mittauksen aikana.</items><items id="text">Kallistuma</items></items><items code="at1006"><items id="description">Keskiarvo valtimopaineesta, joka ilmenee sydämen supistumis- ja rentoutumissyklin aikana.</items><items id="text">Keskivaltimopaine</items></items><items code="at1007"><items id="description">Systolisen ja diastolisen paineen erotus.</items><items id="text">Pulssipaine</items></items><items code="at1008"><items id="description">Pienikokoiselle aikuiselle käytettävä mansetti.</items><items id="text">Aikuiset, pieni</items></items><items code="at1009"><items id="description">Mansetti, joka sopii lapselle tai ohutkäsivartiselle aikuiselle.</items><items id="text">Pediatrinen/lapsi</items></items><items code="at1010"><items id="description">Tieto siitä, minkä Korotkoffin äänen perusteella diastolinen paine määritetään auskultoitaessa.</items><items id="text">Diastolinen päätetapahtuma</items></items><items code="at1011"><items id="description">Neljäs Korotkoffin ääni määrittään äänien äkilliseksi heikkenemiseksi.</items><items id="text">Vaihe IV</items></items><items code="at1012"><items id="description">Viides Korotkoffin ääni määritetään äänien kuulumisen lakkaamiseksi, kun mansetin paine laskee diastolisen verenpaineen alapuolelle.</items><items id="text">Vaihe V</items></items><items code="at1014"><items id="description">Makuulla, hiukan kallellaan kyljen suunnassa, yleensä vasemmalle. Tarvitaan yleensä viimeisellä raskauskolmanneksella supiinioireyhtymän helpottamiseksi.</items><items id="text">Makuulla vasemmalle kallellaan</items></items><items code="at1018"><items id="description">Vauvoille käytettävä mansetti.</items><items id="text">Vauva</items></items><items code="at1019"><items id="description">Vastasyntyneille käytettävä mansetti, mikäli mansetti on oikean kokoinen vastasyntyneen kokoon ja kehitystasoon nähden.</items><items id="text">Vastasyntynyt</items></items><items code="at1020"><items id="description">Tutkittavan oikea ranne.</items><items id="text">Oikea ranne</items></items><items code="at1021"><items id="description">Tutkittavan vasen ranne.</items><items id="text">Vasen ranne</items></items><items code="at1025"><items id="description">Tiedot sfygmomanometrista tai muusta laitteesta, jolla verenpaine mitataan.</items><items id="text">Laite</items></items><items code="at1026"><items id="description">Tutkittavan oikea nilkka.</items><items id="text">Oikea nilkka</items></items><items code="at1030"><items id="description">Tiedot fyysisestä rasituksesta, jolle tutkittava altistettiin verenpaineen mittauksen aikana.</items><items id="text">Rasitus</items></items><items code="at1031"><items id="description">Tutkittavan vasen nilkka.</items><items id="text">Vasen nilkka</items></items><items code="at1032"><items id="description">Tutkittavan sormi.</items><items id="text">Sormi</items></items><items code="at1035"><items id="description">Verenpaineen mittausmenetelmä.</items><items id="text">Menetelmä</items></items><items code="at1036"><items id="description">Menetelmä, jolla verenpaine mitataan ulkoisesti käyttämällä stetoskooppia ja Korotkoffin ääniä.</items><items id="text">Auskultaatio</items></items><items code="at1037"><items id="description">Menetelmä, jolla verenpaine mitataan ulkoisesti palpoimalla (yleensä olkavarsi- tai värttinävaltimosta).</items><items id="text">Palpaatio</items></items><items code="at1038"><items id="description">Keskivaltimopaineen laskennassa käytettävä kaava (jos kirjattu tietoihin).</items><items id="text">Keskivaltimopaineen kaava</items></items><items code="at1039"><items id="description">Menetelmä, jolla verenpaine mitataan ulkoisesti koneella.</items><items id="text">Kone</items></items><items code="at1040"><items id="description">Menetelmä, jolla verenpaine mitataan sisäisesti, eli ihon läpi tunkeutuen ja verisuonen sisältä.</items><items id="text">Invasiivinen</items></items><items code="at1042"><items id="description">Arvio verenpaineen keskiarvosta 24 tunnin ajanjaksona.</items><items id="text">24 tunnin keskiarvo</items></items><items code="at1043"><items id="description">Unitila – tukee 24 tunnin ambulatorisen verenpainemittauksen tulosten tulkintaa.</items><items id="text">Unitila</items></items><items code="at1044"><items id="description">Tutkittava on täysin tajuissaan.</items><items id="text">Valpas ja hereillä</items></items><items code="at1045"><items id="description">Tutkittavan keho on luonnollisessa lepotilassa.</items><items id="text">Nukkuu</items></items><items code="at1051"><items id="description">Tutkittavan varvas.</items><items id="text">Varvas</items></items><items code="at1052"><items id="description">Kommentoi ja kirjaa muita satunnaistekijöitä, jotka saattavat vaikuttaa verenpaineen mittaukseen. Esimerkiksi ahdistuneisuus tai "valkotakkiverenpaine", kipu tai kuume; ilmanpaineen muutokset, jne.</items><items id="text">Sekoittavat tekijät</items></items><items code="at1053"><items id="description">Invasiivinen mittaus valtimoon sijoitetulla katetrinpääanturilla.</items><items id="text">Valtimonsisäinen</items></items><items code="at1054"><items id="description">Kaava jota käytetään systolisen paineen laskemiseen keskivaltimopaineesta (jos kirjattu tietoihin).</items><items id="text">Systolisen paineen kaava</items></items><items code="at1055"><items id="description">Kaava jota käytetään diastolisen paineen laskemiseen keskivaltimopaineesta (jos kirjattu tietoihin).</items><items id="text">Diastolisen paineen kaava</items></items><items code="at1056"><items id="description">Tutkittavan jalanselkä.</items><items id="text">Jalanselkä</items></items><items code="at1057"><items id="description">Rakenteellinen anatominen kohta, josta mittaus tehtiin.</items><items id="text">Rakenteellinen mittauskohta</items></items><items code="at1058"><items id="comment">Esimerkiksi: Paikallisen sairaalan osaston tiedot tai metatiedot FHIR- tai CIMI-vastineiden mukaisiksi.</items><items id="description">Lisätiedot, joita tarvitaan paikallisen asiayhteyden kirjaamiseksi tai yhtenäistämiseksi muiden viitemallien tai formalismien kanssa.</items><items id="text">Laajennus</items></items><items code="at1059"><items id="description">Yksittäinen sana, lause tai lyhyt kuvaus, joka edustaa verenpaineen mittauksen kliinistä merkitystä.</items><items id="text">Kliininen tulkinta</items></items></term_definitions><term_definitions language="ja"><items code="at0000"><items id="comment">ごく一般的には「血圧」という用語は上腕で計測される上腕動脈の圧を示している。</items><items id="description">全身を循環する動脈圧の指標として，局所で測定される血圧。一般的には「血圧」とは上腕で上腕動脈圧を測定したものをさすことが多い。</items><items id="text">血圧</items></items><items code="at0001"><items id="description">履歴構造ノード</items><items id="text">履歴</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">血圧</items></items><items code="at0004"><items id="description">全身の動脈血圧での最高値 - 心機図の収縮期で測定される</items><items id="text">収縮期</items></items><items code="at0005"><items id="description">全身の動脈血圧での最低値 - 心機図の拡張期で測定される</items><items id="text">拡張期</items></items><items code="at0006"><items id="description">デフォルトで、テンプレートや実行時に明示的に定義されていない任意の時点や間隔を示す。</items><items id="text">任意のイベント</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">計測のときの対象者の体位</items><items id="text">体位</items></items><items code="at0011"><items id="description">リスト構造</items><items id="text">ツリー</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">血圧測定のために使われるカフの大きさ.</items><items id="text">カフサイズ</items></items><items code="at0014"><items id="description">血圧が測定された一つの身体部位</items><items id="text">測定部位</items></items><items code="at0015"><items id="description">成人の大腿で血圧を測定するためのカフ。</items><items id="text">成人大腿</items></items><items code="at0016"><items id="description">大柄な成人の腕で測定するためのカフ。</items><items id="text">大柄な成人</items></items><items code="at0017"><items id="description">一般成人のためのカフ</items><items id="text">成人</items></items><items code="at0025"><items id="description">測定対象者の右腕</items><items id="text">右腕</items></items><items code="at0026"><items id="description">測定対象者の左腕</items><items id="text">左腕</items></items><items code="at0027"><items id="description">測定対象者の右大腿</items><items id="text">右大腿</items></items><items code="at0028"><items id="description">測定対象者の左大腿</items><items id="text">左大腿</items></items><items code="at0033"><items id="description">この計測について他に項目に該当しない追加記録</items><items id="text">コメント</items></items><items code="at1000"><items id="description">血圧測定時に立位</items><items id="text">立位</items></items><items code="at1001"><items id="description">血圧測定時に（たとえば、ベッドやイスの上で）坐位</items><items id="text">座位</items></items><items code="at1002"><items id="description">血圧測定時に斜位</items><items id="text">斜位</items></items><items code="at1003"><items id="description">血圧測定時に臥位</items><items id="text">臥位</items></items><items code="at1005"><items id="comment">注意： '°' は適切なUCUM単位である。正しい単位として'deg'(度）を使うこと。</items><items id="description">測定時に対象者が臥床している台の頭尾方向の傾き</items><items id="text">ティルト</items></items><items code="at1006"><items id="description">心臓の収縮拡張サイクルのすべての過程を通した動脈血圧の平均値.</items><items id="text">平均動脈圧</items></items><items code="at1007"><items id="description">1回の収縮サイクルでの血圧の変動</items><items id="text">脈圧</items></items><items code="at1008"><items id="description">小柄な成人のためのカフ</items><items id="text">小柄な成人</items></items><items code="at1009"><items id="description">小児あるいは痩せた成人のためのカフ</items><items id="text">幼児/小児</items></items><items code="at1010"><items id="description">拡張期圧を決めるためにどのコロトコフ音が使用されたかについて記録.</items><items id="text">拡張期終末</items></items><items code="at1011"><items id="description">コロトコフの4音。急速に減弱する時期.</items><items id="text">4期</items></items><items code="at1012"><items id="description">コロトコフの5音が聴取される時期。カフ圧が拡張期圧を下回り音が聴取されなくなる時期</items><items id="text">5期</items></items><items code="at1014"><items id="description">通常は頭から足までを水平にしてから左側に傾けられた状態。一般的には妊娠の第3トリメスターで大動脈・静脈を圧排から解放するために求められる体位である。</items><items id="text">左側臥位</items></items><items code="at1018"><items id="description">幼児のために使われるカフ</items><items id="text">幼児</items></items><items code="at1019"><items id="description">新生児用のカフ 想定されるカフは新生児の生下時体重と成熟度に応じて適切なものであること.</items><items id="text">新生児</items></items><items code="at1020"><items id="description">測定対象者の右手首</items><items id="text">右手首</items></items><items code="at1021"><items id="description">測定対象者の左手首</items><items id="text">左手首</items></items><items code="at1025"><items id="description">水銀血圧計あるいはそのほかの血圧を測定するために使われる機器.</items><items id="text">測定機器</items></items><items code="at1026"><items id="description">測定対象者の右足首</items><items id="text">右足首</items></items><items code="at1030"><items id="description">血圧測定時に行われた肉体的運動についての詳細。</items><items id="text">労作</items></items><items code="at1031"><items id="description">測定対象者の左足首</items><items id="text">左足首</items></items><items code="at1032"><items id="description">測定対象者の手指</items><items id="text">手指</items></items><items code="at1035"><items id="description">血圧の測方法。</items><items id="text">方法</items></items><items code="at1036"><items id="description">聴診器を使いコロトコフ音で外部から血圧を測定する方法.</items><items id="text">聴診</items></items><items code="at1037"><items id="description">脈拍(通常は上腕動脈あるいは橈骨動脈）を触診することにより外部から血圧を測定する方法</items><items id="text">触診</items></items><items code="at1038"><items id="description">平均動脈圧を計算するために使われた式（もしデータに記録されていれば）</items><items id="text">平均動脈圧の計算式</items></items><items code="at1039"><items id="description">血圧測定器を使って外部から血圧を測定する方法.</items><items id="text">機械</items></items><items code="at1040"><items id="description">経皮的に動脈を穿刺し，血管内部から血圧を測定する方法.</items><items id="text">侵襲的</items></items><items code="at1042"><items id="description">24時間での推定平均血圧</items><items id="text">24時間平均</items></items><items code="at1043"><items id="description">睡眠状況 24時間外来血圧記録の解釈を助けるため</items><items id="text">睡眠状況</items></items><items code="at1044"><items id="description">対象の意識は清明である。</items><items id="text">覚醒</items></items><items code="at1045"><items id="description">対象は自然な入眠状態にある</items><items id="text">睡眠中</items></items><items code="at1051"><items id="description">対象者の足尖部</items><items id="text">足尖</items></items><items code="at1052"><items id="description">血圧測定に寄与しうるその他の偶発的な要素についてのコメント。たとえば、不安の程度や「白衣性高血圧」、痛みや発熱、大気圧の変化など。</items><items id="text">交絡因子</items></items><items code="at1053"><items id="description">動脈内に観血的方法で留置したトランスデューサからAラインを経由して測定</items><items id="text">動脈内</items></items><items code="at1054"><items id="description">（もしデータが記録されていれば）平均動脈圧から収縮期血圧を計算した式</items><items id="text">収縮期圧計算式</items></items><items code="at1055"><items id="description">平均動脈圧から拡張期血圧を計算するために使われた式（もしデータに記録されていれば）</items><items id="text">拡張期圧計算式</items></items><items code="at1056"><items id="description">対象者の足背</items><items id="text">足背</items></items><items code="at1057"><items id="description">測定が行われた部位の解剖学的位置について構造化された表現</items><items id="text">構造化された測定部位</items></items><items code="at1058"><items id="comment">例：FHIRやCIMIなどと連携するために病院内で独自に追加して利用されるメターデータ。</items><items id="description">測定時の背景を収集したり、その他の参照モデルや形式と連携するために必要となる追加情報</items><items id="text">拡張領域</items></items><items code="at1059"><items id="description">血圧測定の臨床的意義や重要性についての一言あるいは一文の簡潔な表現。</items><items id="text">臨床的解釈</items></items></term_definitions><term_definitions language="ko"><items code="at0000"><items id="description">체순환에서 동맥압을 대신하는 동맥혈압의 국소 측정. 보통은 '혈압'이라는 용어의 사용은 상완에서 상완동맥의 측정을 의미함.</items><items id="text">혈압</items></items><items code="at0001"><items id="description">*History Structural node.(en)</items><items id="text">*history(en)</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">최대 체동맥 혈압 - 심장 싸이클의 수축기에서 측정.</items><items id="text">수축기</items></items><items code="at0005"><items id="description">최소 체동맥 혈압 - 심장 싸이클의 이완기에서 측정됨.</items><items id="text">이완기</items></items><items code="at0006"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">측정 시에 대상의 자세</items><items id="text">자세</items></items><items code="at0011"><items id="description">*List structure.(en)</items><items id="text">*Tree(en)</items></items><items code="at0013"><items id="description">혈압 측정을 위해 사용되는 cuff의 크기.</items><items id="text">Cuff 크기</items></items><items code="at0014"><items id="description">*Simple body site where blood pressure was measured.(en)</items><items id="text">*Location of measurement(en)</items></items><items code="at0015"><items id="description">성인 허벅지을 위한 cuff - bladder가 약 20cm x 42cm.</items><items id="text">성인 허벅지</items></items><items code="at0016"><items id="description">*큰 팔을 가진 성인을 위한 cuff - bladder가 약 16cm x 38cm.(ko)</items><items id="text">*큰 성인(ko)</items></items><items code="at0017"><items id="description">*성인을 위한 표준인 cuff - bladder가 약 13cm x 30cm.(ko)</items><items id="text">*성인(ko)</items></items><items code="at0025"><items id="description">*사람의 우측 팔.(ko)</items><items id="text">*우측 팔(ko)</items></items><items code="at0026"><items id="description">*사람의 좌측 팔.(ko)</items><items id="text">*좌측 팔(ko)</items></items><items code="at0027"><items id="description">*사람의 우측 허벅지.(ko)</items><items id="text">*우측 허벅지(ko)</items></items><items code="at0028"><items id="description">*사람의 좌측 허벅지.(ko)</items><items id="text">*좌측 허벅지(ko)</items></items><items code="at0033"><items id="description">*Additional narrative about the measurement, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at1000"><items id="description">혈압측정 시에 서있는 자세.</items><items id="text">선 자세</items></items><items code="at1001"><items id="description">혈압 측정시에 앉은 자세(침대 또는 의자).</items><items id="text">앉은 자세</items></items><items code="at1002"><items id="description">혈압 측정시에 비스듬한 자세(reclining).</items><items id="text">비스듬한 자세</items></items><items code="at1003"><items id="description">혈압 측정시에 바로 누운 자세.</items><items id="text">누운 자세</items></items><items code="at1005"><items id="comment">*PLEASE NOTE: '°' is a valid UCUM unit. Please use 'deg' as the correct unit.(en)</items><items id="description">*The craniocaudal tilt of the surface on which the person is lying at the time of measurement.(en)</items><items id="text">*Tilt(en)</items></items><items code="at1006"><items id="description">심장의 수축과 이완 싸이클 전체과정 동안에 발생하는 평균 동맥압.</items><items id="text">평균 동맥압</items></items><items code="at1007"><items id="description">수축기와 이완기 혈압 간의 차이.</items><items id="text">맥압</items></items><items code="at1008"><items id="description">*작은 성인을 위해 사용되는 cuff - bladder가 약 10cm x 24cm.(ko)</items><items id="text">*작은 성인(ko)</items></items><items code="at1009"><items id="description">*아동이나 얋은 팔을 가진 성인에게 적합한 cuff - bladder가 약 8cm x 21cm.(ko)</items><items id="text">*소아/아동(ko)</items></items><items code="at1010"><items id="description">*청진법을 이용하여 이완기 압력을 결정하는데 사용되는 Korotkoff sound를 기록.(ko)</items><items id="text">*이완기 종점(ko)</items></items><items code="at1011"><items id="description">*4번째 Korotkoff sound가 갑작스런 약해지는 소리로 확인된다.(ko)</items><items id="text">*Phase IV(en)</items></items><items code="at1012"><items id="description">*5번째 Korotkoff sound는 cuff 압력이 이완기 혈압 아래로 떨어져 소리가 없어짐으로써 확인된다.(ko)&#13;
&#13;
</items><items id="text">*Phase V(en)</items></items><items code="at1014"><items id="description">보통 왼쪽으로 기울린, 옆쪽으로 기울여 누운 자세. 보통 임신 3기에 동정맥압력을 완화하기위해 필요함.</items><items id="text">왼쪽으로 누운 자세</items></items><items code="at1018"><items id="description">*영아을 위해 사용되는 cuff - bladder가 약 5cm x 15cm.(ko)</items><items id="text">*영아(ko)</items></items><items code="at1019"><items id="description">*신생아를 위해 사용되는 cuff, cuff는 신생아의 성숙도와 몸무게에 대한 적절한 크기가 가정됨.(ko)</items><items id="text">*신생아(ko)</items></items><items code="at1020"><items id="description">*대상의 우측 손목.(ko)</items><items id="text">*우측 손목(ko)</items></items><items code="at1021"><items id="description">*대상의 좌측 손목.(ko)</items><items id="text">*좌측 손목(ko)</items></items><items code="at1025"><items id="description">*혈압을 측정하는데 사용되는 혈압계 또는 기타 장비에 대한 상세내용.(ko)</items><items id="text">*장비(ko)</items></items><items code="at1026"><items id="description">*대상의 우측 발목.(ko)</items><items id="text">*우측 발목(ko)</items></items><items code="at1030"><items id="description">혈압 측정시에 수행 중인 육체활동에 대한 상세내용.</items><items id="text">노력</items></items><items code="at1031"><items id="description">**대상의 좌측 발목.(ko)</items><items id="text">*좌측 발목(ko)</items></items><items code="at1032"><items id="description">*A finger of the individual.(en)</items><items id="text">*Finger(en)</items></items><items code="at1035"><items id="description">*혈압 측정의 방법.(ko)</items><items id="text">*측정 방법(ko)</items></items><items code="at1036"><items id="description">*청진기와 Korotkoff sounds을 사용하여 외부에서 혈압을 측정하는 방법.(ko)</items><items id="text">*청진(ko)</items></items><items code="at1037"><items id="description">*(보통 상완 또는 요골동맥의) 타진을 사용하여 외부에서 혈압을 측정하는 방법.(ko)</items><items id="text">*타진(ko)</items></items><items code="at1038"><items id="description">*(데이터 내에 기록되어 있다면) MAP를 계산하는데 사용되는 공식.(ko)</items><items id="text">*평균 동맥압 공식(ko)</items></items><items code="at1039"><items id="description">*혈압 측정 장비를 사용하여 외부에서 혈압을 측정하는 방법.(ko)</items><items id="text">*장비(ko)</items></items><items code="at1040"><items id="description">*내부에서 즉 피부를 통과하여 혈관 내에서 혈압을 측정하는 방법.(ko)</items><items id="text">*침습적 방법(ko)</items></items><items code="at1042"><items id="description">24시간 동안의 평균 혈압의 추정.</items><items id="text">24시간 평균</items></items><items code="at1043"><items id="description">수면 상태 - 24시간 활동 혈압기록에 대한 해석 지원.</items><items id="text">수면 상태</items></items><items code="at1044"><items id="description">대상은 완전한 의식이 있다.</items><items id="text">각성과 기상 상태</items></items><items code="at1045"><items id="description">대상은 신체적으로 자연적인 휴식 상태에 있다.</items><items id="text">수면 상태</items></items><items code="at1051"><items id="description">*A toe of the individual.(en)</items><items id="text">*Toe(en)</items></items><items code="at1052"><items id="description">혈압측정에 영향을 줄 수 있는 기타 우연한 변수들에 대한 코멘트와 기록. 예를 들어, 불안 또는 '백의신드롬'의 레벨; 통증 또는 발열; 대기압의 변화 등.</items><items id="text">혼란변수</items></items><items code="at1053"><items id="description">*Invasive measurement via transducer access line within an artery.(en)</items><items id="text">*Intra-arterial(en)</items></items><items code="at1054"><items id="description">*Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Systolic pressure formula(en)</items></items><items code="at1055"><items id="description">*Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Diastolic pressure formula(en)</items></items><items code="at1056"><items id="description">**(en)</items><items id="text">*Dorsum of foot(en)</items></items><items code="at1057"><items id="description">*Structured anatomical location of where the measurement was taken.(en)</items><items id="text">*Structured measurement location(en)</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">**(en)</items><items id="text">*New element(en)</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="comment">Vanligvis brukes begrepet "blodtrykk" om måling av brakialt arterietrykk i overarmen.</items><items id="description">Måling av blodtrykket som uttrykk for det arterielle blodtrykk i det systemiske kretsløp.</items><items id="text">Blodtrykk</items></items><items code="at0001"><items id="description">History Structural node.</items><items id="text">Historikk</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">Maksimalt systemisk arterielt blodtrykk - målt i systolen, det vil si i hjertets kontraksjonsfase.</items><items id="text">Systolisk</items></items><items code="at0005"><items id="description">Laveste systemiske arterielle blodtrykk - målt i diastolen, det vil si under hjertets relaksasjonsfase.</items><items id="text">Diastolisk</items></items><items code="at0006"><items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.</items><items id="text">Uspesifisert hendelse</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">Individets posisjon ved tidspunktet for målingen.</items><items id="text">Stilling</items></items><items code="at0011"><items id="description">Struktur liste</items><items id="text">Tre</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">Størrelse på blodtrykkmansjetten som anvendes til måling av blodtrykket. (Cuffstørrelse)</items><items id="text">Mansjettstørrelse</items></items><items code="at0014"><items id="description">Anatomisk sted hvor blodtrykket måles. Bruk listen over interne koder for valg av vanlige målesteder. Bruk fri eller kodet tekst for registrering av mer spesifikke detaljer eller et målested som ikke inngår i listen over vanlige steder. Henvis eventuelt til ekstern terminologi.</items><items id="text">Målested</items></items><items code="at0015"><items id="description">Mansjett for bruk rundt låret til voksne individer.</items><items id="text">Lår voksne</items></items><items code="at0016"><items id="description">En blodtrykksmansjett for voksne med store armer.</items><items id="text">Store voksne</items></items><items code="at0017"><items id="description">En standard blodtrykksmansjett til voksne.</items><items id="text">Voksne</items></items><items code="at0025"><items id="description">Individets høyre overarm.</items><items id="text">Overarm, høyre</items></items><items code="at0026"><items id="description">Individets venstre overarm.</items><items id="text">Overarm, venstre</items></items><items code="at0027"><items id="description">Individets høyre lår.</items><items id="text">Lår, høyre</items></items><items code="at0028"><items id="description">Individets venstre lår.</items><items id="text">Lår, venstre</items></items><items code="at0033"><items id="description">Ytterligere fritekst om målingen, som ikke omfattes av andre felt.</items><items id="text">Kommentar</items></items><items code="at1000"><items id="description">Stående ved tidspunktet for målingen.</items><items id="text">Stående</items></items><items code="at1001"><items id="description">Sittende (for eksempel på en stol eller på en seng med føttene på gulvet) på tidspunkt for blodtrykksmålingen.</items><items id="text">Sittende</items></items><items code="at1002"><items id="description">Sittende tilbakelent ca 45º og med beina hevet til samme høyde som hoften på tidspunkt for blodtrykksmålingen.</items><items id="text">Tilbakelent</items></items><items code="at1003"><items id="description">Liggende flatt på tidspunkt for blodtrykksmålingen.</items><items id="text">Liggende</items></items><items code="at1005"><items id="comment">Negative verdier betegner posisjoner med hodet ned.</items><items id="description">Kranio-caudal tilt av overflaten som individet ligger på på tidspunkt for blodtrykksmåling.</items><items id="text">Tilt</items></items><items code="at1006"><items id="description">Det gjennomsnittlige trykket mot arterieveggen gjennom en enkelt hjertesyklus. Middeltrykk/MAP måles direkte eller beregnes ut fra systolisk og diastolisk trykk ved hjelp av en matematisk formel.</items><items id="text">Middelarterietrykk</items></items><items code="at1007"><items id="description">Differansen mellom det systoliske og diastoliske arterielle blodtrykket.</items><items id="text">Pulstrykk</items></items><items code="at1008"><items id="description">En blodtrykksmansjett for små voksne.</items><items id="text">Små voksne</items></items><items code="at1009"><items id="description">En blodtrykksmansjett til barn eller små voksne med tynne armer.</items><items id="text">Barn</items></items><items code="at1010"><items id="description">Registrering av hvilken av Korotkofflydene som brukes for å bestemme det diastoliske blodtrykket ved hjelp av auskultasjon.</items><items id="text">Diastolisk endepunkt</items></items><items code="at1011"><items id="description">Den fjerde Korotkoff lyd som identifieres som en brå demping av lydene.</items><items id="text">Fase IV</items></items><items code="at1012"><items id="description">Den femte Korotkoff lyd som identifiseres som fraværet av lyder idet mansjettrykket faller under det diastoliske blodtrykket.</items><items id="text">Fase V</items></items><items code="at1014"><items id="description">Liggende flatt med noe lateral tilt, vanligvis vinklet mot venstre side. Vanligvis nødvendig i siste trimester av svangerskapet for å avlaste aortocaval komprimering.</items><items id="text">Liggende lent mot venstre</items></items><items code="at1018"><items id="description">En blodtrykksmansjett til bruk for spedbarn.</items><items id="text">Spedbarn</items></items><items code="at1019"><items id="description">En blodtrykksmansjett til bruk for neonatale, forutsatt at blodtrykksmansjetten er tilpasset i størrelse for modenhet og fødselsvekt.</items><items id="text">Neonatale</items></items><items code="at1020"><items id="description">Individets høyre håndledd.</items><items id="text">Håndledd, høyre</items></items><items code="at1021"><items id="description">Individets venstre håndledd.</items><items id="text">Håndledd, venstre</items></items><items code="at1025"><items id="description">Detaljer om sfygmomanometeret eller annet måleapparat brukt til blodtrykksmåling.</items><items id="text">Måleapparat</items></items><items code="at1026"><items id="description">Individets høyre ankel.</items><items id="text">Ankel, høyre</items></items><items code="at1030"><items id="description">Detaljer om fysisk aktivitet på tidspunkt for blodtrykksmåling.</items><items id="text">Fysisk anstrengelse</items></items><items code="at1031"><items id="description">Individets venstre ankel.</items><items id="text">Ankel, venstre</items></items><items code="at1032"><items id="description">Individets finger. Dersom identifikasjon av den spesifikke fingeren er nødvendig, kan dette legges inn ved hjelp av feltet med fri eller kodet tekst.</items><items id="text">Finger</items></items><items code="at1035"><items id="description">Metode for måling av blodtrykket.</items><items id="text">Målemetode</items></items><items code="at1036"><items id="description">Metode for måling av blodtrykk eksternt, ved hjelp av stetoskop og Korotkofflyder.</items><items id="text">Auskultasjon</items></items><items code="at1037"><items id="description">Metode for måling av blodtrykket eksternt, ved hjelp av palpasjon (vanligvis av arteriene brachialis eller radialis).</items><items id="text">Palpasjon</items></items><items code="at1038"><items id="description">Eventuell formel som er anvendt til beregning av middeltrykket (MAP).</items><items id="text">Formel for beregning av MAP</items></items><items code="at1039"><items id="description">Metode for non-invasiv måling av blodtrykket ved hjelp av en maskin som automatisk måler blodtrykket, for eksempel et måleapparat eller en blodtrykksmåler for hjemmebruk.</items><items id="text">Automatisk, non-invasivt</items></items><items code="at1040"><items id="description">Metode for måling av blodtrykket invasivt med innleggelse av intravasalkateter i en blodåre.</items><items id="text">Automatisk, invasivt</items></items><items code="at1042"><items id="description">Estimert gjennomsnittsblodtrykk over en 24-timers periode.</items><items id="text">24-timers gjennomsnitt</items></items><items code="at1043"><items id="description">Søvnstatus - understøtter tolkning av 24 timers ambulant blodtrykksmåling.</items><items id="text">Søvnstatus</items></items><items code="at1044"><items id="description">Individet er ved full bevissthet.</items><items id="text">Våken</items></items><items code="at1045"><items id="description">Individet er i den naturlige tilstand av kroppslig hvile.</items><items id="text">Sovende</items></items><items code="at1051"><items id="description">Individets tå. Dersom identifikasjon av den spesifikke tåen er nødvendig, kan dette legges inn ved hjelp av feltet med fri eller kodet tekst.</items><items id="text">Tå</items></items><items code="at1052"><items id="description">Kommentar til og registrering av andre faktorer som kan påvirke blodtrykksmålingen. For eksempel angst eller "hvit frakk syndrom", smerter eller feber, endringer i atmosfærisk trykk osv.</items><items id="text">Konfunderende faktorer</items></items><items code="at1053"><items id="description">Invasiv måling i en artiere via en transducer.</items><items id="text">Intra-arterielt</items></items><items code="at1054"><items id="description">Formelen som anvendes til beregning av systolisk blodtrykk dersom det benyttes en maskin som måler middeltrykket og beregner systolisk og diastolisk trykk.</items><items id="text">Formel for beregning av systolisk trykk</items></items><items code="at1055"><items id="description">Formelen som anvendes til beregning av diastolisk blodtrykk dersom det benyttes en maskin som måler middeltrykket og beregner systolisk og diastolisk trykk.</items><items id="text">Formel for beregning av diastolisk trykk</items></items><items code="at1056"><items id="description">Individets fotrygg.</items><items id="text">Fotrygg</items></items><items code="at1057"><items id="description">Strukturert anatomisk lokalisering av stedet målingen ble gjort.</items><items id="text">Strukturert målested</items></items><items code="at1058"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at1059"><items id="description">Enkeltord, frase eller kort beskrivelse som representerer den kliniske betydningen og signifikansen av blodtrykksmålingen.</items><items id="text">Klinisk tolkning</items></items></term_definitions><term_definitions language="nl"><items code="at0000"><items id="comment">Meest gebruikelijk is dat de term 'bloeddruk' refereert aan de meting van de bloeddruk van de arterie brachialis in de bovenarm.</items><items id="description">De lokale meting van de arteriële bloeddruk, welke surrogaat is voor de arteriële druk in de systemische circulatie.</items><items id="text">Bloeddruk</items></items><items code="at0001"><items id="description">Gestructureerde geschiedenismap.</items><items id="text">Geschiedenis</items></items><items code="at0003"><items id="description">*@ internal @</items><items id="text">*Bloeddruk</items></items><items code="at0004"><items id="description">De hoogste (piek) systemische arteriële bloeddruk - gemeten in de systolische of samentrekkingsfase van de hartslag.</items><items id="text">Systolisch</items></items><items code="at0005"><items id="description">De laagste systemische arteriële bloeddruk - gemeten in de diastolische of ontspanningsfase van de hartslag.</items><items id="text">Diastolisch</items></items><items code="at0006"><items id="description">Standaard, niet-gespecificeerd tijdstip of interval gebeurtenis die expliciet in een template of tijdens uitvoering kan worden gedefinieerd.</items><items id="text">Elke gebeurtenis</items></items><items code="at0007"><items id="description">*@ internal @</items><items id="text">*state structure</items></items><items code="at0008"><items id="description">De houding van het individu op het moment van de meting.</items><items id="text">Houding</items></items><items code="at0011"><items id="description">Lijst structuur.</items><items id="text">Structuur</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">De grootte van de manchet gebruikt bij de meting.</items><items id="text">Manchet grootte</items></items><items code="at0014"><items id="description">Lichaamslocatie waar de bloeddruk is gemeten.</items><items id="text">Lichaamslocatie van de meting</items></items><items code="at0015"><items id="description">Een manchet voor een volwassen dijbeen.</items><items id="text">Volwassen dijbeen</items></items><items code="at0016"><items id="description">Een manchet voor volwassenen met grotere armen.</items><items id="text">Grote volwassene</items></items><items code="at0017"><items id="description">De standaard manchet voor een volwassene.</items><items id="text">Volwassene</items></items><items code="at0025"><items id="description">De rechterarm van de persoon.</items><items id="text">Rechterarm</items></items><items code="at0026"><items id="description">De linkerarm van de persoon.</items><items id="text">Linkerarm</items></items><items code="at0027"><items id="description">Het rechterdijbeen van de persoon.</items><items id="text">Rechterdijbeen</items></items><items code="at0028"><items id="description">De linkerdijbeen van de persoon.</items><items id="text">Linkerdijbeen</items></items><items code="at0033"><items id="description">Aanvullend opmerkingen over de meting, niet vastgelegd in andere velden.</items><items id="text">Opmerking</items></items><items code="at1000"><items id="description">Bloeddrukmeting bij staand individu.</items><items id="text">Staand</items></items><items code="at1001"><items id="description">Bloeddrukmeting bij zittend (b.v. op bed of in stoel) individu.</items><items id="text">Zittend</items></items><items code="at1002"><items id="description">Halfzittend op het moment van de bloeddrukmeting.</items><items id="text">Halfzittend</items></items><items code="at1003"><items id="description">Platliggend op het moment van de bloeddrukmeting.</items><items id="text">Liggend</items></items><items code="at1005"><items id="description">De craniaal-caudale kanteling van het oppervlak waarop het individu ligt op het moment van de meting.</items><items id="text">Kanteling</items></items><items code="at1006"><items id="description">De gemiddelde bloeddruk gedurende één cyclus van samentrekken en ontspannen van het hart.</items><items id="text">Gemiddelde arteriële druk</items></items><items code="at1007"><items id="description">Het verschil tussen de systolische en diastolische bloeddruk.</items><items id="text">Polsdruk</items></items><items code="at1008"><items id="description">Een manchet voor een kleine volwassene.</items><items id="text">Kleine volwassene</items></items><items code="at1009"><items id="description">Een manchet voor een kind of volwassene met een dunne arm.</items><items id="text">Pediatrie/kinder</items></items><items code="at1010"><items id="description">Om te registreren welk Korotkoff geluid gebruikt is om de diastolische druk te meten door de auscultatieve methode.</items><items id="text">Diastolisch eindpunt</items></items><items code="at1011"><items id="description">Het vierde Korotkoff geluid wordt gedefinieerd als een abrupte vermindering van geluid.</items><items id="text">Fase IV</items></items><items code="at1012"><items id="description">Het vijfde Korotkoff geluid is geïdentificeerd door afwezigheid van geluiden als de manchetdruk onder diastolische bloeddruk komt.</items><items id="text">Fase V</items></items><items code="at1014"><items id="description">Platliggend met enige laterale kanteling, meestal gekanteld naar de linkerzijde. Gebruikelijk benodigd in het laatste trimester van de zwangerschap om aortacavale compressie te verlichten.</items><items id="text">Liggend met kanteling naar linkerzijde</items></items><items code="at1018"><items id="description">Een manchet voor zuigelingen.</items><items id="text">Zuigeling</items></items><items code="at1019"><items id="description">Een manchet voor een neonaat, er van uitgaande dat de manchet de juiste maat is voor volgroeidheid en geboortegewicht van de neonaat.</items><items id="text">Neonaat</items></items><items code="at1020"><items id="description">De rechterpols van de persoon</items><items id="text">Rechterpols</items></items><items code="at1021"><items id="description">De linkerpols van de persoon.</items><items id="text">Linkerpols</items></items><items code="at1025"><items id="description">Details over sphygmomanometerof ander apparaat om de bloeddruk te meten.</items><items id="text">Apparaat</items></items><items code="at1026"><items id="description">De rechterenkel van de persoon</items><items id="text">Rechterenkel</items></items><items code="at1030"><items id="description">Details over de lichamelijke inspanning die ondernomen wordt op het moment van de bloeddrukmeting.</items><items id="text">Inspanning</items></items><items code="at1031"><items id="description">De linkerenkel van de persoon.</items><items id="text">Linkerenkel</items></items><items code="at1032"><items id="description">Een vinger van de persoon.</items><items id="text">Vinger</items></items><items code="at1035"><items id="description">De methode van de meting van de bloeddruk.</items><items id="text">Methodiek</items></items><items code="at1036"><items id="description">Uitwendige meting van de bloeddruk, met gebruikmaking van een stethoscoop en Korotkoff geluiden.</items><items id="text">Auscultatie</items></items><items code="at1037"><items id="description">Uitwendige meting van de bloeddruk, met gebruikmaking van palpatie (meestal de arterie brachialis of radialis).</items><items id="text">Palpatie</items></items><items code="at1038"><items id="description">Formule om de MAP (mean arterial pressure=gemiddelde arteriële druk) te berekenen (als deze data opgeslagen wordt).</items><items id="text">Gemiddelde arteriële druk formule</items></items><items code="at1039"><items id="description">Uitwendige meting van de bloeddruk, met gebruikmaking van een mechanische bloeddrukmeter.</items><items id="text">Machinaal</items></items><items code="at1040"><items id="description">Inwendige meting van de bloeddruk, inclusief penetratie van de huid en meting in het bloedvat.</items><items id="text">Invasief</items></items><items code="at1042"><items id="description">Inschatting van de gemiddelde bloeddruk over een periode van 24 uur.</items><items id="text">24 uur gemiddelde</items></items><items code="at1043"><items id="description">Slaap/waak toestand, ondersteunt de interpretatie van de 24-uurs bloeddrukmeting.</items><items id="text">Slaap/waak toestand</items></items><items code="at1044"><items id="description">Individu is volledig bij bewustzijn.</items><items id="text">Alert en wakker</items></items><items code="at1045"><items id="description">Individu is in de natuurlijke slaap.</items><items id="text">Slapend</items></items><items code="at1051"><items id="description">Een teen van de persoon.</items><items id="text">Teen</items></items><items code="at1052"><items id="description">Opmerking over en vastleggen van andere incidentele factoren die de bloeddrukmeting zouden kunnen beïnvloeden. Bijvoorbeeld, mate van angst, of 'witte jas syndroom'; pijn of koorts; veranderingen in atmosferische druk etc.</items><items id="text">Beïnvloedende factoren</items></items><items code="at1053"><items id="description">Invasieve meting via een druktransducer in de arterielijn.</items><items id="text">Intra-arterieel</items></items><items code="at1054"><items id="description">Formule om de systolische druk van de MAP (mean arterial pressure=gemiddelde arteriële druk) te berekenen (als deze data opgeslagen wordt).</items><items id="text">Systolische druk formule</items></items><items code="at1055"><items id="description">Formule om de diastolische druk van de MAP (mean arterial pressure=gemiddelde arteriële druk) te berekenen (als deze data opgeslagen wordt).</items><items id="text">Diastolische druk formule</items></items><items code="at1056"><items id="description">De voetzool van de persoon.</items><items id="text">Voetzool</items></items><items code="at1057"><items id="description">Gestructureerde anatomische locatie waar de bloeddruk is gemeten.</items><items id="text">Gestructureerde lichaamslocatie van de meting</items></items><items code="at1058"><items id="comment">Bijvoorbeeld: lokale ziekenhuis of zorginstelling afdelingsinformatie of aanvullende metadata om uit te lijnen met FHIR- of CIMI-equivalenten.</items><items id="description">Aanvullende informatie die vereist is om de lokale context vast te leggen of uit te lijnen met andere referentiemodellen/formalismen.</items><items id="text">Extensie</items></items><items code="at1059"><items id="description">Eén woord, zin of korte beschrijving die de klinische betekenis van de bloeddrukmeting weergeeft.</items><items id="text">Klinische interpretatie</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="comment">*Most commonly, use of the term 'blood pressure' refers to measurement of brachial artery pressure in the upper arm.(en)</items><items id="description">A medida local da pressão sanguínea arterial, a qual é uma substituta da pressão arterial na circulação arterial sistêmica. Mais comumente o uso do termo pressão arterial se refere à medida da pressão da artéria braquial no antebraço.</items><items id="text">Pressão Arterial</items></items><items code="at0001"><items id="description">nodo Estrutural história</items><items id="text">história</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">Pressão arterial sistêmica máxima - medida na fase sistólica ou de contração do ciclo cardíaco.</items><items id="text">Sistólica</items></items><items code="at0005"><items id="description">Pressão arterial sistêmica mínima - medida na fase diastólica ou de dilatação do ciclo cardíaco.</items><items id="text">Diastólica</items></items><items code="at0006"><items id="description">Padrão, ponto especificado no tempo ou evento de intervalo que pode ser explicitamente definido em um modelo ou em tempo de execução.</items><items id="text">Qualquer evento</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">A posição do sujeito na hora da medida.</items><items id="text">Posição</items></items><items code="at0011"><items id="description">estrutura de lista</items><items id="text">estrutura de lista</items></items><items code="at0013"><items id="comment">Sem comentários</items><items id="description">Tamanho da braçadeira usada para medir a pressão arterial.</items><items id="text">Tamanho da braçadeira</items></items><items code="at0014"><items id="description">Local do corpo simples em que a pressão arterial foi medida.</items><items id="text">Localização da medição</items></items><items code="at0015"><items id="description">Uma braçadeira usada na coxa de um aduto - manguito de aproximadamente 20cm x 42cm.</items><items id="text">Coxa de adulto</items></items><items code="at0016"><items id="description">Uma braçadeira para adultos com braço largo - manguito de aproximadamente 16cm x 38cm.</items><items id="text">Adulto Grande</items></items><items code="at0017"><items id="description">Uma braçadeira padrão para adultos - manguito de aproximadamente 13cm x 30cm.</items><items id="text">Adulto</items></items><items code="at0025"><items id="description">O braço direito da pessoa.</items><items id="text">Braço direito</items></items><items code="at0026"><items id="description">O braço esquerdo da pessoa.</items><items id="text">Braço esquerdo</items></items><items code="at0027"><items id="description">A coxa direita da pessoa.</items><items id="text">Coxa direita</items></items><items code="at0028"><items id="description">A coxa esquerda da pessoa.</items><items id="text">Coxa esquerda</items></items><items code="at0033"><items id="description">Narrativa adicional sobre a medição, não capturada em outros campos.</items><items id="text">Comentário</items></items><items code="at1000"><items id="description">Em pé na hora da medida da pressão arterial.</items><items id="text">Em pé</items></items><items code="at1001"><items id="description">Sentado (por exemplo na cama ou em uma cadeira) na hora da medida da pressão arterial.</items><items id="text">Sentado</items></items><items code="at1002"><items id="description">Reclinado na hora da medida da pressão arterial.</items><items id="text">Reclinado</items></items><items code="at1003"><items id="description">Deitado sem reclinação hora da medida da pressão arterial.</items><items id="text">Deitado</items></items><items code="at1005"><items id="comment">* ATENÇÃO: '°' é uma unidade UCUM válida. Por favor, use 'graus' como a unidade correta.</items><items id="description">A inclinação craniocaudal da superfície na qual a pessoa está deitada no momento da medição.</items><items id="text">Inclinado</items></items><items code="at1006"><items id="description">A pressão arterial média que ocorrre ao longo de todo o ciclo de contração e dilatação do coração.</items><items id="text">Pressão arterial Média</items></items><items code="at1007"><items id="description">A diferença entre a pressão sistólica e diastólica.</items><items id="text">Pressão de Pulso</items></items><items code="at1008"><items id="description">Uma braçadeira usada para adultos pequenos -manguito de aproximadamente 10cm x 24cm.</items><items id="text">Adulto pequeno</items></items><items code="at1009"><items id="description">Manguito apropriao para uma criança ou um adulto com um braço fino - bolsa de aproximadamente 8cm x 21cm.</items><items id="text">Criança/Pediátrico</items></items><items code="at1010"><items id="description">Registro do som Korotkoff usado para determinar a pressão arterial diastólica, usando o método auscultativo.</items><items id="text">Final da diástole</items></items><items code="at1011"><items id="description">O quarto som de Korotkoff é identificado como um súbito abafamento dos sons.</items><items id="text">Fhase IV.</items></items><items code="at1012"><items id="description">O quinto som de Korotkoff é identificado pela ausência de sons, pois a pressão da braçadeira cai abaixo da pressão diastólica do sangue.</items><items id="text">Phase V</items></items><items code="at1014"><items id="description">Deitado sem reclinação com alguma inclinação lateral, usualmente com angulação para o lado esquerdo. Comumente requerido no último trimestre da gravidez para aliviar a compressão aortocaval.</items><items id="text">Deitado com inclinação para esquerda</items></items><items code="at1018"><items id="description">Uma braçadeira utilizada em crianças pequenas - manguito de aproximadamente 5cm x 15cm.</items><items id="text">Criança pequena</items></items><items code="at1019"><items id="description">Uma braçadeira usada para um recém-nascido, supondo que o tamanho é apropriado para a maturidade e o peso ao nascer do neonato.</items><items id="text">Neonatal</items></items><items code="at1020"><items id="description">O pulso direito da pessoa.</items><items id="text">Pulso direito</items></items><items code="at1021"><items id="description">O pulso esquerdo da pessoa.</items><items id="text">Pulso esquerdo</items></items><items code="at1025"><items id="description">Detalhes sobre o esfigmomanômetro ou outro aparelho utilizado para medir a pressão sanguínea.</items><items id="text">Aparelho</items></items><items code="at1026"><items id="description">O tornozelo direito da pessoa.</items><items id="text">Tornozelo direito</items></items><items code="at1030"><items id="description">Detalhes sobre atividade física realizada na hora da medida da pressão arterial.</items><items id="text">Esforço físico</items></items><items code="at1031"><items id="description">O tornozelo esquerdo da pessoa.</items><items id="text">Tornozelo esquerdo</items></items><items code="at1032"><items id="description">Um dedo do indivíduo.</items><items id="text">Dedo</items></items><items code="at1035"><items id="description">Método de medida da pressão arterial.</items><items id="text">Método</items></items><items code="at1036"><items id="description">Método de medir a pressão externamente, usando o estetoscópiso e os sons Korotkoff.</items><items id="text">Ausculta</items></items><items code="at1037"><items id="description">Método de medir a pressão arterial externamente, usando a palpação (geralmente artérias braquiais ou radiais).</items><items id="text">Palpação</items></items><items code="at1038"><items id="description">Fórmula usada para calcular a pressão arterial média (PAM), se registrada em dados.</items><items id="text">Fórmula de Pressão Arterial Média</items></items><items code="at1039"><items id="description">Método de medir a pressão arterial externamente, usando o aparelho de pressão arterial.</items><items id="text">Aparelho de pressão</items></items><items code="at1040"><items id="description">Método de medir a pressão arterial internamente, isto é, envolvendo a penetração da pele e a medida interior dos vasos sanguíneos.</items><items id="text">Invasivo</items></items><items code="at1042"><items id="description">Estimativa da pressão arterial média em um período de 24 horas.</items><items id="text">Media de 24 horas</items></items><items code="at1043"><items id="description">Status do sono - apóia a interpretação do registro do mapa de pressão arterial (ambulatorial de 24 horas).</items><items id="text">Status do sono</items></items><items code="at1044"><items id="description">Sujeito está totalmente consciente.</items><items id="text">Alerta e acordado</items></items><items code="at1045"><items id="description">Sujeito está no estado natural de descanso corporal.</items><items id="text">Dormindo</items></items><items code="at1051"><items id="description">Um dedo do pé do indivíduo.</items><items id="text">Dedo do pé</items></items><items code="at1052"><items id="description">Comentários sobre e registros de outros fatores incidentais que possam estar contribuindo na medida da pressão sanguínea. Por exemplo, nível de ansiedade ou "síndrome do jaleco branco"; dor ou febre; mudanças na pressão atmosférica, etc.</items><items id="text">Fatores confundidores</items></items><items code="at1053"><items id="description">Medição invasiva via linha de acesso do transdutor dentro de uma artéria.</items><items id="text">Intra-arterial</items></items><items code="at1054"><items id="description">Fórmula utilizada para calcular a pressão sistólica a partir da pressão arterial média (se registrada nos dados).</items><items id="text">Fórmula de pressão sistólica</items></items><items code="at1055"><items id="description">Fórmula utilizada para calcular a pressão diastólica da pressão arterial média (se registrada nos dados).</items><items id="text">Fórmula da pressão diastólica</items></items><items code="at1056"><items id="description">O dorso do pé do indivíduo.</items><items id="text">Dorso do pé</items></items><items code="at1057"><items id="description">Localização anatômica estruturada de onde a medição foi feita.</items><items id="text">Localização de medição estruturada</items></items><items code="at1058"><items id="comment">Por exemplo: Informações locais de departamentos de hospitais ou metadados adicionais para alinhar a equivalentes FHIR ou CIMI</items><items id="description">Informações adicionais necessárias para capturar o contexto local ou para alinhar com outros modelos / formalismos de referência.</items><items id="text">Extensão</items></items><items code="at1059"><items id="description">Palavra única, frase ou breve descrição que representa o significado clínico e o significado da medida da pressão arterial.</items><items id="text">Interpretação clínica</items></items></term_definitions><term_definitions language="ru"><items code="at0000"><items id="comment">*Most commonly, use of the term 'blood pressure' refers to measurement of brachial artery pressure in the upper arm.(en)</items><items id="description">Локальное измерение артериального давления, которое является суррогатом артериального давления в системном кровотоке. Как правило, термин относится к давления плечевой артерии на предплечье.&#13;
</items><items id="text">АД</items></items><items code="at0001"><items id="description">*History Structural node.(en)</items><items id="text">*History(en)</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">Пик системного артериального давления - измеряется в систолиу или в фазу сокращения сердца</items><items id="text">Систолическое</items></items><items code="at0005"><items id="description">Минимальное системное артериальное давление - измеряется в диастолу или в фазу релаксации сердца.</items><items id="text">Диастолическое</items></items><items code="at0006"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">Поза пациента во время измерения давления.</items><items id="text">Поза</items></items><items code="at0011"><items id="description">*List structure.(en)</items><items id="text">*Tree(en)</items></items><items code="at0013"><items id="comment">*Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470. (en)</items><items id="description">Размер манжеты для измерения кровяного давления.</items><items id="text">Размер манжеты(ru)</items></items><items code="at0014"><items id="description">*Simple body site where blood pressure was measured.(en)</items><items id="text">*Location of measurement(en)</items></items><items code="at0015"><items id="description">Манжеты для бедра  взрослого- пузырь приблизительно 20см х 42см.</items><items id="text">Взрослая для бедра</items></items><items code="at0016"><items id="description">Манжета для руки взрослого, увеличенного объёма -  пузырь приблизительно 16cm x 38cm.</items><items id="text">Взрослая большая</items></items><items code="at0017"><items id="description">Манжета стандартная для взрослого - пузырь приблизительно 13 х 30cm.</items><items id="text">Взрослая</items></items><items code="at0025"><items id="description">Правая рука пациента.</items><items id="text">Правая рука</items></items><items code="at0026"><items id="description">Левая рука пациента.</items><items id="text">Левая рука</items></items><items code="at0027"><items id="description">Правое бедро пациента.</items><items id="text">Правое бедро</items></items><items code="at0028"><items id="description">Левое бедро пациента.</items><items id="text">Левое бедро</items></items><items code="at0033"><items id="description">*Additional narrative about the measurement, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at1000"><items id="description">Пациент стоит во время измерения АД.</items><items id="text">Стоя</items></items><items code="at1001"><items id="description">Пациент сидит во время измерения АД (на стуле, кровати или кресле).</items><items id="text">Сидя</items></items><items code="at1002"><items id="description">Пациент лежит в вынужденной неизменной позе (на реклинации)во время измерения АД.</items><items id="text">Реклинация</items></items><items code="at1003"><items id="description">Пациент лежит во время измерения АД.</items><items id="text">Лёжа</items></items><items code="at1005"><items id="comment">*PLEASE NOTE: '°' is a valid UCUM unit. Please use 'deg' as the correct unit.(en)</items><items id="description">*The craniocaudal tilt of the surface on which the person is lying at the time of measurement.(en)</items><items id="text">*Tilt(en)</items></items><items code="at1006"><items id="description">Среднее артериальное давление на всём протяжении цикла сокращения и релаксации сердца.</items><items id="text">Среднего артериального давления крови</items></items><items code="at1007"><items id="description">Разница между систолическим и диастолическим давлением.</items><items id="text">Пульсовое давление</items></items><items code="at1008"><items id="description">Манжета взрослая малая - пузырь приблизительно 10 x 24cm.</items><items id="text">Взрослая малая</items></items><items code="at1009"><items id="description">Манжета для детей или взрослых с тонкой рукой - пузырь примерно 8см x 21cm.</items><items id="text">Педиатрическая(детская)</items></items><items code="at1010"><items id="description">Запись звука Короткова который используют для определения диастолического давления с помощью метода аускультации.</items><items id="text">Диастолическая конечная точка</items></items><items code="at1011"><items id="description">Четвёртый звук Короткова, определяющийся как резкое приглушение звуков.</items><items id="text">Фаза 4</items></items><items code="at1012"><items id="description">Пятый звук Короткова определяется отсутствием звуков, так как давление в манжете падает ниже диастолического артериального давления.</items><items id="text">Фаза 5</items></items><items code="at1014"><items id="description">Лёжа на плоской поверхности с боковым наклоном, как правило, под углом по направлению с левой стороны. Обычно требуется в последнем триместре беременности, чтобы облегчить сдавление нижней полой вены.</items><items id="text">Лёжа с наклоном влево</items></items><items code="at1018"><items id="description">Манжета для младенцев - пузырь приблизительно 5см x 15cm.</items><items id="text">Для младенцев</items></items><items code="at1019"><items id="description">Манжета для новорожденных, используется в соответствии с весом новорожденного.</items><items id="text">Для новорожденных</items></items><items code="at1020"><items id="description">Правое запястье пациента.</items><items id="text">Правое запястье</items></items><items code="at1021"><items id="description">Левое запястье пациента.</items><items id="text">Левое запястье</items></items><items code="at1025"><items id="description">Информация о сфигмоманометре или другом устройстве, используемом для измерения АД.</items><items id="text">Устройство</items></items><items code="at1026"><items id="description">Правая лодыжка пациента.</items><items id="text">Правая лодыжка</items></items><items code="at1030"><items id="description">Подробная информация о физической деятельности, осуществляемой во время измерения АД.</items><items id="text">Нагрузка</items></items><items code="at1031"><items id="description">Левая лодыжка пациента</items><items id="text">Левая лодыжка</items></items><items code="at1032"><items id="description">*A finger of the individual.(en)</items><items id="text">*Finger(en)</items></items><items code="at1035"><items id="description">Метод измерения кровяного давления.</items><items id="text">Метод</items></items><items code="at1036"><items id="description">Неинвазивный метод измерения АД с использованием стетоскопа и звуков Короткова.</items><items id="text">Аускультация</items></items><items code="at1037"><items id="description">Неинвазивный метод измерения АД с использованием пальпации (обычно плечевой или лучевой артерии).</items><items id="text">Пальпация</items></items><items code="at1038"><items id="description">Формула, используемая для вычисления СрАД (если требуется записывать).</items><items id="text">Формула среднего артериального давления</items></items><items code="at1039"><items id="description">Неинвазивный метод измерения АД с помощью автоматического тонометра.</items><items id="text">Автоматический тонометр</items></items><items code="at1040"><items id="description">Инвазивный метод измерения АД, с помещением датчика внутри кровеносного сосуда.</items><items id="text">Инвазивный</items></items><items code="at1042"><items id="description">Оценка среднего АД за период в 24 часа.</items><items id="text">Среднее за 24 часа</items></items><items code="at1043"><items id="description">Стадия сна - для интерпретации записи амбулаторного измерения АД в течение 42 часов.</items><items id="text">Стадия сна(ru)</items></items><items code="at1044"><items id="description">Пациент полностью в сознании.</items><items id="text">Пробуждение и подъём</items></items><items code="at1045"><items id="description">Пациент находится в состоянии естественного покоя, тело расслаблено.</items><items id="text">Сон</items></items><items code="at1051"><items id="description">*A toe of the individual.(en)</items><items id="text">*Toe(en)</items></items><items code="at1052"><items id="description">Комментарий и записи других случайных факторов, которые могут способствовать измерению артериального давления. Например,"боязнь белого халата" или боль и жар, изменения атмосферного давления т.д.</items><items id="text">Стохастические факторы(ru)</items></items><items code="at1053"><items id="description">*Invasive measurement via transducer access line within an artery.(en)</items><items id="text">*Intra-arterial(en)</items></items><items code="at1054"><items id="description">*Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Systolic pressure formula(en)</items></items><items code="at1055"><items id="description">*Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Diastolic pressure formula(en)</items></items><items code="at1056"><items id="description">*The individual's dorsum of the foot.(en)</items><items id="text">*Dorsum of foot(en)</items></items><items code="at1057"><items id="description">*Structured anatomical location of where the measurement was taken.(en)</items><items id="text">*Structured measurement location(en)</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">*Single word, phrase or brief description that represents the clinical meaning and significance of the blood pressure measurement.(en)</items><items id="text">*Clinical interpretation(en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="comment">Vanligtvis refererar användningen av termen blodtryck till mätningen av brakialartärtrycket i överarmen.</items><items id="description">Den lokala mätningen av artärblodtrycket som är ett substitut för artärtryck i den systemiska cirkulationen.</items><items id="text">Blodtryck</items></items><items code="at0001"><items id="description">Strukturerad anamnes.</items><items id="text">Anamnes</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">Det högsta värdet på systemartärtrycket under systole, det vill säga under sammandragningsfasen av hjärtcykeln.</items><items id="text">Systoliskt</items></items><items code="at0005"><items id="description">Det minsta värdet på systemartärtrycket under diastole, det vill säga under avslappningsfasen av hjärtcykeln.</items><items id="text">Diastoliskt</items></items><items code="at0006"><items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en template eller genereras automatiskt av vissa IT-system.</items><items id="text">Ospecificerad händelse</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0008"><items id="description">Individens kroppsställning under mätningen.</items><items id="text">Ställning</items></items><items code="at0011"><items id="description">Liststruktur</items><items id="text">Träd</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">Storleken på manschetten som används för blodtrycksmätning.</items><items id="text">Manschettstorlek</items></items><items code="at0014"><items id="description">Beskrivning av anatomiskt ställe där blodtrycket mäts.</items><items id="text">Mätställe</items></items><items code="at0015"><items id="description">En lårmanschett för vuxna.</items><items id="text">Vuxet lår</items></items><items code="at0016"><items id="description">En manschett för vuxna med kraftigare armar.</items><items id="text">Stor vuxen</items></items><items code="at0017"><items id="description">En standardmanschett för vuxna.</items><items id="text">Vuxen</items></items><items code="at0025"><items id="description">Individens högra arm.</items><items id="text">Höger arm</items></items><items code="at0026"><items id="description">Individens vänstra arm.</items><items id="text">Vänster arm</items></items><items code="at0027"><items id="description">Individens högra lår.</items><items id="text">Höger lår</items></items><items code="at0028"><items id="description">Individens vänstra lår.</items><items id="text">Vänster lår</items></items><items code="at0033"><items id="description">Ytterligare beskrivning av mätningen som inte beskrivits i andra fält.</items><items id="text">Kommentar</items></items><items code="at1000"><items id="description">Stående upprätt under blodtrycksmätningen.</items><items id="text">Stående</items></items><items code="at1001"><items id="description">Sittande ställning under blodtrycksmätningen, exempelvis på en säng eller stol.</items><items id="text">Sittande</items></items><items code="at1002"><items id="description">Halvliggande ställning under blodtrycksmätningen.</items><items id="text">Halvliggande</items></items><items code="at1003"><items id="description">Liggande raklång under blodtrycksmätningen.</items><items id="text">Liggande</items></items><items code="at1005"><items id="description">Lutning vid huvudet på ytan som individen ligger på vid tidpunkten för mätningen.</items><items id="text">Lutning</items></items><items code="at1006"><items id="description">Det genomsnittliga systemartärtrycket under hela hjärtcykeln, det vill säga under både sammandragningsfas och avslappningsfas.</items><items id="text">Medelartärtryck</items></items><items code="at1007"><items id="description">Differensen mellan systoliskt och diastoliskt blodtryck.</items><items id="text">Pulstryck</items></items><items code="at1008"><items id="description">En manschett för vuxna med smalare armar.</items><items id="text">Liten Vuxen</items></items><items code="at1009"><items id="description">En manschett för barn eller vuxna med smala armar.</items><items id="text">Pediatrisk/Barn</items></items><items code="at1010"><items id="description">Registrerat Korotkoff-ljud som används för att avgöra diastoliskt tryck med hjälp av auskultatorisk metod.</items><items id="text">Diastoliskt effektmått</items></items><items code="at1011"><items id="description">Det fjärde Korotkoff-ljudet identifieras som en plötslig ljuddämpning.</items><items id="text">Fas IV</items></items><items code="at1012"><items id="description">Det femte Korotkoff-ljudet identifieras genom avsaknad av ljud då manschettrycket sjunker under det diastoliska blodtrycket.</items><items id="text">Fas V</items></items><items code="at1014"><items id="description">Liggande raklång med viss lateral lutning, vanligtvis mot vänster sida. Det krävs vanligtvis i graviditetens sista trimester för att lindra aortokaval kompression.</items><items id="text">Liggande i vänster sidoläge</items></items><items code="at1018"><items id="description">En manschett för spädbarn.</items><items id="text">Spädbarn</items></items><items code="at1019"><items id="description">En manschett för nyfödda.</items><items id="text">Nyfödd</items></items><items code="at1020"><items id="description">Individens högra handled.</items><items id="text">Höger handled</items></items><items code="at1021"><items id="description">Individens vänstra handled.</items><items id="text">Vänster handled</items></items><items code="at1025"><items id="description">Detaljer om sfygmomanometer eller annan utrustning som används för att mäta blodtrycket.</items><items id="text">Utrustning</items></items><items code="at1026"><items id="description">Individens högra ankel.</items><items id="text">Höger ankel</items></items><items code="at1030"><items id="description">Detaljer om den fysiska aktiviteten som utförts vid tidpunkten av blodtrycksmätningen.</items><items id="text">Ansträngning</items></items><items code="at1031"><items id="description">Individens vänstra ankel.</items><items id="text">Vänster ankel</items></items><items code="at1032"><items id="description">Individens finger.</items><items id="text">Finger</items></items><items code="at1035"><items id="description">Metod för mätning av blodtryck.</items><items id="text">Metod</items></items><items code="at1036"><items id="description">Metod för icke-invasiv mätning av blodtryck med hjälp av sfygmomanometri, såsom manschett, stetoskop, Korotkoff-ljud.</items><items id="text">Auskultation</items></items><items code="at1037"><items id="description">Metod för att mäta det systoliska blodtrycket med hjälp av palpation, vanligtvis av brakiala eller radiella artärer.</items><items id="text">Palpation</items></items><items code="at1038"><items id="description">Formel som används för att beräkna medelartärtrycket (om det finns registrerat).</items><items id="text">Formel för medelartärtryck</items></items><items code="at1039"><items id="description">Icke-invasiv blodtrycksmätning med hjälp av oscillometri i en halvautomatisk blodtrycksmätare.</items><items id="text">Blodtrycksmaskin</items></items><items code="at1040"><items id="description">Metod för att mäta blodtrycket intravenöst, dvs. genom att penetrera huden och mäta inuti blodkärlen.</items><items id="text">Invasiv</items></items><items code="at1042"><items id="description">Beräkning av det genomsnittliga blodtrycket under en 24-timmarsperiod.</items><items id="text">24 timmars blodtrycksmätning</items></items><items code="at1043"><items id="description">Sömnstatus som stöder tolkningen av 24-timmars ambulatoriska blodtrycksmätningar.</items><items id="text">Sömnstatus</items></items><items code="at1044"><items id="description">Patienten är vid fullt medvetande.</items><items id="text">Alert och vaken</items></items><items code="at1045"><items id="description">Patienten är i det naturliga tillståndet av kroppslig vila.</items><items id="text">Sover</items></items><items code="at1051"><items id="description">Individens tå.</items><items id="text">Tå</items></items><items code="at1052"><items id="description">Andra faktorer som kan påverka blodtrycksmätningen, exempelvis grad av oro, "vitrockseffekt", smärta, feber eller förändringar i lufttryck.</items><items id="text">Möjliga felkällor</items></items><items code="at1053"><items id="description">Invasiv mätning via artärkateter.</items><items id="text">Intraarteriell</items></items><items code="at1054"><items id="description">Formel som används för att beräkna det systoliska trycket från medelartärtrycket (om det finns registrerat).</items><items id="text">Formel för systoliskt tryck</items></items><items code="at1055"><items id="description">Formel som används för att beräkna det diastoliska trycket från medelartärtrycket (om det finns registrerat).</items><items id="text">Formel för diastoliskt tryck</items></items><items code="at1056"><items id="description">Individens fotrygg.</items><items id="text">Fotryggen</items></items><items code="at1057"><items id="description">Strukturerat anatomiskt ställe där mätningen gjordes.</items><items id="text">Strukturerat mätställe</items></items><items code="at1058"><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items><items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="text">Tilläggsinformation</items></items><items code="at1059"><items id="description">Ord, fras eller kort beskrivning som representerar den kliniska betydelsen och signifikansen av blodtrycksmätningen.</items><items id="text">Klinisk tolkning</items></items></term_definitions><term_definitions language="zh-cn"><items code="at0000"><items id="comment">最为常见的情况下是，利用术语“血压”来指称上臂肱动脉压的测量结果。</items><items id="description">代表体循环动脉压的动脉血压的局部测量。</items><items id="text">血压</items></items><items code="at0001"><items id="description">历史结构节点</items><items id="text">历史</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">血压</items></items><items code="at0004"><items id="description">在心动周期的收缩期所测量到的体循环动脉血压峰值。</items><items id="text">收缩压</items></items><items code="at0005"><items id="description">在心动周期的舒张期所测量到的体循环动脉血压最低值（谷值，最小值）。</items><items id="text">舒张压</items></items><items code="at0006"><items id="description">默认，在某一模板之中或在运行时所可能明确定义的未加详细说明的时间点或时段事件。</items><items id="text">任何事件</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">测量时受检对象的体位或者说身体姿势。</items><items id="text">体位</items></items><items code="at0011"><items id="description">列表结构</items><items id="text">树状结构</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">用于血压测量的袖带（臂带，袖套，臂围）的大小或者说尺寸。</items><items id="text">袖带尺寸</items></items><items code="at0014"><items id="description">测量血压时所采用的简单身体部位。</items><items id="text">测量位置</items></items><items code="at0015"><items id="description">适用于成年人大腿的袖带（臂带，袖套，臂围） - 气囊尺寸约为 20cm x 42cm。</items><items id="text">成年人大腿型</items></items><items code="at0016"><items id="description">适用于上肢较为粗大的成年人的袖带（臂带，袖套，臂围） - 气囊尺寸约为16cm x 38cm。</items><items id="text">成年人粗大型</items></items><items code="at0017"><items id="description">适用于成年人的标准袖带（臂带，袖套，臂围） - 气囊尺寸约为13cm x 30cm。</items><items id="text">成年人标准型</items></items><items code="at0025"><items id="description">受检对象的右臂。</items><items id="text">右臂</items></items><items code="at0026"><items id="description">受检对象的左臂。</items><items id="text">左臂</items></items><items code="at0027"><items id="description">受检对象的右腿。</items><items id="text">右腿</items></items><items code="at0028"><items id="description">受检对象的左腿。</items><items id="text">左腿</items></items><items code="at0033"><items id="description">其他字段并未予以记录的，关于当前检测过程的附加文字叙述。</items><items id="text">注释</items></items><items code="at1000"><items id="description">测量血压时身体处于站立体位</items><items id="text">立位</items></items><items code="at1001"><items id="description">测量血压时身体处于坐位，又称为“坐姿”。</items><items id="text">坐位</items></items><items code="at1002"><items id="description">测量血压时身体处于45度角侧卧位或者说采取的是斜靠的姿势。</items><items id="text">侧卧位</items></items><items code="at1003"><items id="description">测量血压时受检者采取的是平躺或者说平卧的姿势，又称为“仰卧位”。</items><items id="text">平卧位</items></items><items code="at1005"><items id="comment">请注意：“°”属于无效的UCUM单位。请采用正确的单位“deg”（度）。</items><items id="description">测量时该人员所卧于的表面的颅尾（头尾）倾角（倾斜角度）。</items><items id="text">倾角</items></items><items code="at1006"><items id="description">又称为“平均动脉血压”，指的是在整个心脏收缩与舒张周期过程中出现的动脉压均值（平均动脉压）。</items><items id="text">平均动脉压</items></items><items code="at1007"><items id="description">收缩压与舒张压之间的差值，又称为“脉压差”或“脉搏压”。</items><items id="text">脉压</items></items><items code="at1008"><items id="description">适用于体型瘦小的成年人的袖带（臂带，袖套，臂围） - 气囊尺寸约为10cm x 24cm。</items><items id="text">成年人细小型</items></items><items code="at1009"><items id="description">适用于儿童或上肢较瘦成年人的袖带（臂带，袖套，臂围） - 气囊尺寸约为8cm x 21cm。</items><items id="text">儿科型/儿童型</items></items><items code="at1010"><items id="description">旨在记录当确定舒张压时所采用的究竟是哪种柯氏音。</items><items id="text">舒张期终点</items></items><items code="at1011"><items id="description">将声音的突然减弱（消音，捂住，低沉）或者说其向捂音的突然转变确定为第IV柯氏音，即柯氏音的第IV时相（变音）。</items><items id="text">第IV时相</items></items><items code="at1012"><items id="description">将声音随着袖带压力降至舒张压以下时声音的消失确定为第V柯氏音，即柯氏音的第V时相。</items><items id="text">第V时相</items></items><items code="at1014"><items id="description">测量血压时受检者采取的是平躺或者说平卧姿势，且有向侧位一定程度的倾斜，通常是斜向左侧。在妊娠晚期，为了缓解主腔静脉压迫（aortocaval compression），常常需要采取这种体位。</items><items id="text">左斜卧位</items></items><items code="at1018"><items id="description">适用于婴幼儿的袖带（臂带，袖套，臂围） - 气囊尺寸约为5cm x 15cm。</items><items id="text">婴幼儿型</items></items><items code="at1019"><items id="description">适用于新生儿的袖带（臂带，袖套，臂围），且假定袖带尺寸适合于新生儿的成熟度和出生体重。</items><items id="text">新生儿型</items></items><items code="at1020"><items id="description">受检对象的右手腕。</items><items id="text">右手腕</items></items><items code="at1021"><items id="description">受检对象的左手腕。</items><items id="text">左手腕</items></items><items code="at1025"><items id="description">关于用于测量血压的血压计或其他装置（仪器，设备）的详情。</items><items id="text">装置</items></items><items code="at1026"><items id="description">受检对象的右踝。</items><items id="text">右踝</items></items><items code="at1030"><items id="description">关于血压测量时所从事的体力活动或者说身体活动的详情。</items><items id="text">体力活动</items></items><items code="at1031"><items id="description">受检对象的左踝。</items><items id="text">左踝</items></items><items code="at1032"><items id="description">检查对象的某一手指。</items><items id="text">手指</items></items><items code="at1035"><items id="description">血压测量方法。</items><items id="text">方法</items></items><items code="at1036"><items id="description">利用听诊器和柯氏音（Korotkoff sounds）在身体外部测量血压的方法。</items><items id="text">听诊法</items></items><items code="at1037"><items id="description">利用触诊（扪诊）在身体外部测量血压的方法（通常采用的是对肱动脉或桡动脉的触诊）。</items><items id="text">触诊法</items></items><items code="at1038"><items id="description">用于计算平均动脉压（Mean Arterial Pressure，MAP，平均动脉血压）的公式（如果在数据之中加以记录的话）。</items><items id="text">平均动脉压公式</items></items><items code="at1039"><items id="description">利用血压测量设备（仪器，装置）在身体外部测量血压的方法。</items><items id="text">仪器法</items></items><items code="at1040"><items id="description">在身体内部测量血压的方法，也就是说涉及到皮肤穿刺和在血管内进行测量。</items><items id="text">有创法</items></items><items code="at1042"><items id="description">24小时期间血压均值的估计</items><items id="text">24小时均值</items></items><items code="at1043"><items id="description">睡眠状态 - 旨在支持对于24小时流动式/门诊血压记录的解释。</items><items id="text">睡眠状态</items></items><items code="at1044"><items id="description">受检对象意识完全清楚。</items><items id="text">警觉且清醒</items></items><items code="at1045"><items id="description">受检对象处在全身休息的自然状态下。</items><items id="text">睡眠状态</items></items><items code="at1051"><items id="description">检查对象的某一脚趾。</items><items id="text">脚趾</items></items><items code="at1052"><items id="description">旨在记录和说明可能影响血压测量结果的偶然因素。例如，焦虑/进展程度或“白大褂综合征（white coat syndrome）”、疼痛、发热、大气压变化等等。</items><items id="text">干扰因素</items></items><items code="at1053"><items id="description">利用位于动脉内的传感器接入通路来进行有创性测量。</items><items id="text">动脉内</items></items><items code="at1054"><items id="description">用于依据平均动脉压（数据之中已有相应记录时）来计算收缩压的公式。</items><items id="text">收缩压公式</items></items><items code="at1055"><items id="description">用于依据平均动脉压（数据之中已有相应记录时）来计算舒张压的公式。</items><items id="text">舒张压公式</items></items><items code="at1056"><items id="description">患者脚部的背面。</items><items id="text">足背</items></items><items code="at1057"><items id="description">进行当前测量时所采用的结构化解剖学位置。</items><items id="text">结构化测量位置</items></items><items code="at1058"><items id="comment">例如：用于与FHIR或CIMI的等价工件进行匹配统一时所需的本地医院科室信息或附加的元数据。</items><items id="description">采集/记录本地语境或者与其他参考模型/形式化体系进行匹配统一时所需的附加信息。</items><items id="text">扩展</items></items><items code="at1059"><items id="description">单个词语、短语或者简要的描述，用于表达当前血压测量结果的临床含义和意义。</items><items id="text">临床解释</items></items></term_definitions><term_bindings terminology="SNOMED-CT"><items code="at0000"><value><terminology_id><value>SNOMED-CT(2003)</value></terminology_id><code_string>364090009</code_string></value></items><items code="at0004"><value><terminology_id><value>SNOMED-CT(2003)</value></terminology_id><code_string>271649006</code_string></value></items><items code="at0005"><value><terminology_id><value>SNOMED-CT(2003)</value></terminology_id><code_string>271650006</code_string></value></items><items code="at0013"><value><terminology_id><value>SNOMED-CT(2003)</value></terminology_id><code_string>246153002</code_string></value></items></term_bindings></component_ontologies></template>