d><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></occurrences><node_id>at0149</node_id><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>value</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>DV_BOOLEAN</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id/></children></attributes></children><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>ELEMENT</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></occurrences><node_id>at0025</node_id><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>value</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>DV_COUNT</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id/></children></attributes></children><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>ELEMENT</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></occurrences><node_id>at0024</node_id><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>value</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>DV_TEXT</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id/></children></attributes></children><cardinality><is_ordered>false</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></interval></cardinality></attributes></children></attributes><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>protocol</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>ITEM_TREE</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id>at0030</node_id><attributes xsi:type="C_MULTIPLE_ATTRIBUTE"><rm_attribute_name>items</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>ELEMENT</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></occurrences><node_id>at0103</node_id><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>value</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>DV_IDENTIFIER</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id/></children><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>DV_TEXT</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id/></children></attributes></children><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>CLUSTER</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>0</upper></occurrences><node_id>at0085</node_id></children><cardinality><is_ordered>false</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>1</lower></interval></cardinality></attributes></children></attributes><archetype_id><value>openEHR-EHR-ACTION.medication.v1</value></archetype_id><term_definitions code="at0000"><items id="comment">This is not limited to activities performed based on medication orders from clinicians, but could also include for example taking over the counter medication.</items><items id="description">Any activity related to the planning, scheduling, prescription management, dispensing, administration, cessation and other use of a medication, vaccine, nutritional product or other therapeutic item.</items><items id="text">Medication management</items></term_definitions><term_definitions code="at0002"><items id="description">A prescription has been issued for the medication.</items><items id="text">Prescription issued</items></term_definitions><term_definitions code="at0003"><items id="description">The ordered medication has been dispensed, for example from a pharmacy to the patient.</items><items id="text">Prescription dispensed</items></term_definitions><term_definitions code="at0004"><items id="description">The medication has been taken by, or administered to, the patient for the first time. Although in some settings this significant date may be computable as the first of several administrations, in other settings, such as primary care, specific administration dates are not readily available.</items><items id="text">Medication course commenced</items></term_definitions><term_definitions code="at0005"><items id="description">The individual medication has been reassessed, for example whether the medication should still be taken. This is not intended to capture review of the medication list.</items><items id="text">Medication reassessed</items></term_definitions><term_definitions code="at0006"><items id="description">A single administration of the medication has taken place.</items><items id="text">Dose administered</items></term_definitions><term_definitions code="at0007"><items id="description">The medication course has been completed as planned.</items><items id="text">Medication course completed</items></term_definitions><term_definitions code="at0008"><items id="description">The prescription has not been dispensed due to a technical or pharamaceutical supply issue.</items><items id="text">Prescription supply delayed</items></term_definitions><term_definitions code="at0009"><items id="description">The administration of the medication has been suspended until further notice. No further doses should be given until the restart date or conditions have been met. When setting the date/conditions for restart after suspending, a step from ‘Administrations suspended’ and back to 'Medication start date/condition set' should be performed.</items><items id="text">Administrations suspended</items></term_definitions><term_definitions code="at0010"><items id="description">A prescription has been re-issued for an existing medication order.</items><items id="text">Prescription re-issued</items></term_definitions><term_definitions code="at0011"><items id="description">Issue of the prescription is awaiting re-authorisation by a clinician.</items><items id="text">Prescription re-authorisation pending</items></term_definitions><term_definitions code="at0012"><items id="description">The planned course of medication has been cancelled prior to any administration.</items><items id="text">Medication course cancelled</items></term_definitions><term_definitions code="at0013"><items id="description">The scheduled medication course has been postponed prior to any administration.</items><items id="text">Medication course postponed</items></term_definitions><term_definitions code="at0015"><items id="description">Administration of the medication has been ceased during the period of the intended course.</items><items id="text">Medication course stopped</items></term_definitions><term_definitions code="at0016"><items id="description">The time to start the medication, or other starting condition, has been set.</items><items id="text">Medication start date/condition set</items></term_definitions><term_definitions code="at0017"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0018"><items id="description">An administration of the medication has been withheld and not given. There is no expectation that it will be given later, though the next dose (if any) should be administered according to the original order.</items><items id="text">Dose administration omitted</items></term_definitions><term_definitions code="at0020"><items id="comment">For example: 'Atenolol 100mg' or 'Tenormin tablets 100mg'. &#13;
It is strongly recommended that the 'Medication item' is coded with a terminology capable of triggering decision support, where possible. The extent of coding may vary from the simple name of the medication item through to structured details about the actual medication pack used. Free text entry should only be used if there is no appropriate terminology available.</items><items id="description">Name of the medication, vaccine or other therapeutic/prescribable item which was the focus of the activity.</items><items id="text">Medication item</items></term_definitions><term_definitions code="at0021"><items id="comment">For example: 'Postponed - Patient not avalable at administration time', 'Cancelled - Adverse reaction'. Note: This is not the reason for the medication instruction, but rather the specific reason that a care step was carried out, and will often be used to document some variance from the original order.</items><items id="description">Reason that the pathway step for the identified medication was carried out.</items><items id="text">Reason</items></term_definitions><term_definitions code="at0024"><items id="comment">For example: 'Patient was in radiology department', 'Accidental injection into blood vessel during IM administration'.</items><items id="description">Additional narrative about the activity or pathway step not captured in other fields, including details of any variance between the intended action and the action actually performed.</items><items id="text">Comment</items></term_definitions><term_definitions code="at0025"><items id="comment">For example: Vaccine sequence number.</items><items id="description">The sequence number specific to the pathway step being recorded.</items><items id="text">Sequence number</items></term_definitions><term_definitions code="at0030"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0033"><items id="comment">For example: 'Avoid grapefruit' , 'Take at least 2 hours before bedtime', 'Take with food'. May be coded with a terminology when clinically appropriate.</items><items id="description">Any guidance, instructions or advice given to the subject of care or personal carer at the time of the pathway step.</items><items id="text">Patient guidance</items></term_definitions><term_definitions code="at0039"><items id="description">A major change to the order was required, resulting in this order being stopped and a replacement order being started.</items><items id="text">Major change to order</items></term_definitions><term_definitions code="at0041"><items id="description">The medication order has been changed in a manner which does not require a new instruction/order to be issued, according to local clinical rules.</items><items id="text">Minor change to order</items></term_definitions><term_definitions code="at0043"><items id="comment">Used to compare variance from actual action time where this is not readily calculable from the original instruction.</items><items id="description">The datetime at which the medication action was scheduled to occur.</items><items id="text">Original scheduled date/time</items></term_definitions><term_definitions code="at0044"><items id="description">An administration of a dose of the medication has been delayed but is expected to be given as soon as possible.</items><items id="text">Dose administration deferred</items></term_definitions><term_definitions code="at0053"><items id="description">Further structured details of the action, possibly specific to a pathway step.</items><items id="text">Additional details</items></term_definitions><term_definitions code="at0085"><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></term_definitions><term_definitions code="at0103"><items id="comment">Comment: This data element allows for multiple occurrences to be defined more explicitly at run-time, if required.</items><items id="description">Unique identifier for the medication order.</items><items id="text">Order ID</items></term_definitions><term_definitions code="at0104"><items id="comment">Use this SLOT where the detailed description of the dispensed, authorised or administered item needs to be explicitly stated. For example: the form, strength, any diluents or mixture of ingredients.</items><items id="description">Structured details about the medication including strength, form and constituent substances.</items><items id="text">Medication details</items></term_definitions><term_definitions code="at0106"><items id="description">The original medication order has been re-authorised to allow repeat prescription or dispensing. In some jurisdictions an entirely new order must be issued in these circumstances.</items><items id="text">Prescription re-authorised</items></term_definitions><term_definitions code="at0109"><items id="description">The medication has been recommended but no steps have been taken to initiate prescribing.</items><items id="text">Medication recommended</items></term_definitions><term_definitions code="at0131"><items id="comment">CLUSTER.dosage is intended to carry details of medication order changes or dose administrations, whilst CLUSTER.medication_supply_amount is intended for details of dispensing-related activity.</items><items id="description">Specific details about the amount of the medication item.</items><items id="text">Amount</items></term_definitions><term_definitions code="at0132"><items id="comment">In many jurisdictions, substitution of an ordered item as a generic form or with a different brand name, which has been determined as bioequivalent, is allowed at the point of dispense or supply. In other cases substitution is assumed and the clinician has to explicitly request non-substitution.</items><items id="description">Subsitution action taken by the person administering or dispensing the drug.</items><items id="text">Substitution</items></term_definitions><term_definitions code="at0133"><items id="comment">For example: "Generic alternative contains a substance that is not tolerated by the patient." May be coded with a terminology when clinically appropriate</items><items id="description">The reason or justification for the substitution action taken.</items><items id="text">Substitution reason</items></term_definitions><term_definitions code="at0138"><items id="description">A medication was substituted which is bioequivalent to that ordered.</items><items id="text">Substitution performed</items></term_definitions><term_definitions code="at0139"><items id="description">Although allowed by the medication order a bioequvalent medication was not substituted.</items><items id="text">Substitution not performed</items></term_definitions><term_definitions code="at0140"><items id="description">Details of body site and administration of the medication.</items><items id="text">Administration details</items></term_definitions><term_definitions code="at0141"><items id="comment">For example: 'left upper arm', 'intravenous catheter right hand'. &#13;
Coding of the body site with a terminology is preferred, where possible.</items><items id="description">Structured description of the site of administration of the ordered item.</items><items id="text">Body site</items></term_definitions><term_definitions code="at0142"><items id="comment">For example: "On the medial skin surface of the left forearm, from 10 cm to 20 cm distally from the point of the elbow".</items><items id="description">Structured description of the site of administration of the medication, vaccine or therapeutic good.</items><items id="text">Structured body site</items></term_definitions><term_definitions code="at0143"><items id="comment">Comment: For example: ' via Z-track injection'; 'via nebuliser'. Coding of the method with a terminology is preferred, where possible.</items><items id="description">The technique or device by which the ordered item was, or is to be, administered.</items><items id="text">Administration method</items></term_definitions><term_definitions code="at0144"><items id="description">Details of the medical device used to assist administration of the medication.</items><items id="text">Administration device</items></term_definitions><term_definitions code="at0145"><items id="description">Draft prescription has been prepared and is awaiting confirmation from an authorised clinician. May be used where reauthorisations are performed as a batch. This careflow_step may have a status of 'planned' or 'active', reflecting the need to to handle new orders as well as re-authorised orders.</items><items id="text">Prescription awaiting authorisation</items></term_definitions><term_definitions code="at0147"><items id="comment">Comment: For example: 'oral', 'intravenous', or 'topical'. Coding of the route with a terminology is preferred, where possible. Multiple potential routes may be specified.</items><items id="description">The route by which the ordered item was, or is to be, administered into the subject's body.</items><items id="text">Route</items></term_definitions><term_definitions code="at0148"><items id="comment">For example: preparation of an intravenous mixture.</items><items id="description">The medication has been physically prepared.</items><items id="text">Medication prepared</items></term_definitions><term_definitions code="at0149"><items id="comment">Details of the individual performing the double-check can be carried in the Reference Model element "Participation".</items><items id="description">The pathway step has been checked by a separate individual.</items><items id="text">Double-checked?</items></term_definitions><term_definitions code="at0150"><items id="description">The prescription was cancelled prior to being issued.</items><items id="text">Prescription cancelled</items></term_definitions><term_definitions code="at0151"><items id="description">Prescription has been invalidated or has expired without being fulfilled.</items><items id="text">Prescription invalid or expired</items></term_definitions><term_definitions code="at0152"><items id="description">The prescription has been fulfilled successfully.</items><items id="text">Prescription fulfilled</items></term_definitions><term_definitions code="at0153"><items id="description">The medication has been formally authorised for use.</items><items id="text">Medication authorised</items></term_definitions><term_definitions code="at0154"><items id="comment">For example: 2017-10-29</items><items id="description">The date/time on which the medication course is set to restart, as per the "Administrations suspended" pathway step.</items><items id="text">Restart date/time</items></term_definitions><term_definitions code="at0155"><items id="comment">For example: "On day 2 after surgery".</items><items id="description">The criterion which triggers the medication course to restart, as per the "Administrations suspended" pathway step.</items><items id="text">Restart criterion</items></term_definitions><term_definitions code="at0156"><items id="comment">For example: 'Angina' or 'Pain'. Coding of the indication with a terminology is preferred, where possible. This data element allows multiple occurrences. If only an ACTION is used to record a medication indication, this data element can be used without additional consideration. However, if a clinical indication is recorded for both the Medication order INSTRUCTION and this Medication management ACTION, be aware that these indications might not be consistent."</items><items id="description">The clinical reason for the medication activity.</items><items id="text">Clinical indication</items></term_definitions><term_definitions code="at0157"><items id="description">The prepared medication has been double checked.</items><items id="text">Medication double checked</items></term_definitions><term_definitions code="at0158"><items id="description">An administration of a dose of the medication was started but was subsequently aborted.</items><items id="text">Dose administration aborted</items></term_definitions></children><cardinality><is_ordered>true</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></interval></cardinality></attributes><archetype_id><value>openEHR-EHR-COMPOSITION.encounter.v1</value></archetype_id><term_definitions code="at0000"><items id="description">Interaction, contact or care event between a subject of care and healthcare provider(s).</items><items id="text">Encounter</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0002"><items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items><items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items><items id="text">Extension</items></term_definitions></definition><ontology archetype_id="openEHR-EHR-COMPOSITION.encounter.v1"><term_definitions language="ar-sy"><items code="at0000"><items id="description">*Interaction, contact or care event between a subject of care and healthcare provider(s).(en)</items><items id="text">*Encounter(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="description">Interacció, contacte o esdeveniment d’atenció entre un pacient i un o més professionals d'atenció sanitària.</items><items id="text">Encontre</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensió</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="description">Interaktion, Kontakt oder Versorgungsereignis, zwischen einem Versorgungsempfänger und einem Gesundheitsdienstleister.</items><items id="text">Kontakt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Erweiterung</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">Interaction, contact or care event between a subject of care and healthcare provider(s).</items><items id="text">Encounter</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items><items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items><items id="text">Extension</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="description">Interacción, contacto o evento de cuidado entre un paciente y un proveedor de salud.</items><items id="text">Encuentro</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensión</items></items></term_definitions><term_definitions language="es-ar"><items code="at0000"><items id="description">Interacción, contacto o evento de cuidados entre un sujeto de cuidados y uno o más proveedores de cuidados de la salud.</items><items id="text">Encuentro</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensión</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="description">Hoitohenkilön ja terveydenhuollon tarjoajan välinen vuorovaikutus, kontakti- tai hoitotapahtuma.</items><items id="text">Kontakti</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Laajennus</items></items></term_definitions><term_definitions language="fr"><items code="at0000"><items id="description">Interaction, contact ou événement de soins entre un sujet de soins et un ou des prestataires de soins.</items><items id="text">Rencontre</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extension</items></items></term_definitions><term_definitions language="it"><items code="at0000"><items id="description">Interazione, contatto o evento di cura tra un soggetto di cura e il/i fornitore/i di assistenza sanitaria.</items><items id="text">Contatto</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Estensione</items></items></term_definitions><term_definitions language="ko"><items code="at0000"><items id="description">*Interaction, contact or care event between a subject of care and healthcare provider(s).(en)</items><items id="text">*Encounter(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">Interaksjon, kontakt eller omsorgshendelse mellom et individ og helsepersonell.</items><items id="text">Klinisk kontakt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Utvidelse</items></items></term_definitions><term_definitions language="nl"><items code="at0000"><items id="description">Interactie, contact of zorggebeurtenis tussen een onderwerp van zorg en zorgverlener(s).</items><items id="text">Contact</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensie</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="description">Interação, contato ou cuidado entre o sujeito do cuidado e profissional(is) de saúde.</items><items id="text">Encontro</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensão</items></items></term_definitions><term_definitions language="pt-pt"><items code="at0000"><items id="description">Interação, contato ou evento de cuidados entre um sujeito e um provedor de saúde.</items><items id="text">Encontro</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensão</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="description">Kontakt mellan patient och vårdgivare, eller vårdhändelse inom hälso- och sjukvården.</items><items id="text">Vårdkontakt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items><items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="text">Tilläggsinformation</items></items></term_definitions></ontology><component_ontologies archetype_id="openEHR-EHR-ACTION.medication.v1"><term_definitions language="ar-sy"><items code="at0000"><items id="comment">*This is not limited to activities performed based on medication orders from clinicians, but could also include for example taking over the counter medication.(en)</items><items id="description">*Any activity related to the planning, scheduling, prescription management, dispensing, administration, cessation and other use of a medication, vaccine, nutritional product or other therapeutic item.(en)</items><items id="text">*Medication management(en)</items></items><items code="at0002"><items id="description">*A prescription has been issued for the medication.(en)</items><items id="text">*Prescription issued(en)</items></items><items code="at0003"><items id="description">*The ordered medication has been dispensed, for example from a pharmacy to the patient.(en)</items><items id="text">*Prescription dispensed(en)</items></items><items code="at0004"><items id="description">*The medication has been taken by, or administered to, the patient for the first time. Although in some settings this significant date may be computable as the first of several administrations, in other settings, such as primary care, specific administration dates are not readily available.(en)</items><items id="text">*Medication course commenced(en)</items></items><items code="at0005"><items id="description">*The specific medication item has been reviewed, as planned. This is not intended to capture review of the whole medication list.(en)</items><items id="text">*Medication course reviewed(en)</items></items><items code="at0006"><items id="description">*A single administration of the medication has taken place.(en)</items><items id="text">*Dose administered(en)</items></items><items code="at0007"><items id="description">*The medication course has been completed as planned.(en)</items><items id="text">*Medication course completed(en)</items></items><items code="at0008"><items id="description">*The prescription has not been dispensed due to a technical or pharamaceutical supply issue.(en)</items><items id="text">*Prescription supply delayed(en)</items></items><items code="at0009"><items id="description">*The administration of the medication has been suspended until further notice. No further doses should be given until the restart date or conditions have been met. When setting the date/conditions for restart after suspending, a step from ‘Administrations suspended’ and back to 'Medication start date/condition set' should be performed.(en)</items><items id="text">*Administrations suspended(en)</items></items><items code="at0010"><items id="description">*A prescription token has been re-issued for an existing medication order.(en)</items><items id="text">*Prescription re-issued(en)</items></items><items code="at0011"><items id="description">*Reissuing of this prescription is not available without some intervention.(en)</items><items id="text">*Prescription re-issue suspended(en)</items></items><items code="at0012"><items id="description">*The planned course of medication has been cancelled prior to any administration.(en)</items><items id="text">*Medication course cancelled(en)</items></items><items code="at0013"><items id="description">*The scheduled medication course has been postponed prior to any administration.(en)</items><items id="text">*Medication course postponed(en)</items></items><items code="at0015"><items id="description">*The administration of this medication has been ceased after the first dose has been administered, but before intended completion of the course.  (en)</items><items id="text">*Medication course stopped(en)</items></items><items code="at0016"><items id="description">*The time to start this medication, or other starting condition, has been set.(en)</items><items id="text">*Medication start date/condition set(en)</items></items><items code="at0017"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0018"><items id="description">*The administration of a medication has been withheld and not given. There is no expectation that it will be given later, though the next dose (if any) should be administered according to the original order.(en)</items><items id="text">*Dose administration omitted(en)</items></items><items code="at0020"><items id="comment">*For example: 'Atenolol 100mg' or 'Tenormin tablets 100mg'. &#13;
It is strongly recommended that the 'Medication item' is coded with a terminology capable of triggering decision support, where possible. The extent of coding may vary from the simple name of the medication item through to structured details about the actual medication pack used. Free text entry should only be used if there is no appropriate terminology available.(en)</items><items id="description">*Name of the medication, vaccine or other therapeutic/prescribable item which was the focus of the activity.(en)</items><items id="text">*Medication item(en)</items></items><items code="at0021"><items id="comment">*For example: 'Postponed - Patient not avalable at administration time', 'Cancelled - Adverse reaction'. Note: This is not the reason for the medication instruction, but rather the specific reason that a care step was carried out, and will often be used to document some variance from the original order.(en)</items><items id="description">*Reason that the pathway step for the identified medication was carried out.(en)</items><items id="text">*Reason(en)</items></items><items code="at0024"><items id="comment">*For example: 'Patient was in radiology department', 'Accidental injection into blood vessel during IM administration'.(en)</items><items id="description">*Additional narrative about the activity or care pathway step not captured in other fields, including details of any variance between the intended action and the action actually performed.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="comment">*For example: Vaccine sequence number. (en)</items><items id="description">*The sequence number specific to the activity being recorded.(en)</items><items id="text">*Sequence number(en)</items></items><items code="at0030"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0033"><items id="comment">*For example: 'Avoid grapefruit' , 'Take at least 2 hours before bedtime', 'Take with food'. May be coded with a terminology when clinically appropriate.(en)</items><items id="description">*Any guidance, instructions or advice given to the subject of care or personal carer at the time of the pathway step.(en)</items><items id="text">*Patient guidance(en)</items></items><items code="at0039"><items id="description">*A major change to the order was required, resulting in this order being stopped and a replacement order being started.(en)</items><items id="text">*Major change to order.(en)</items></items><items code="at0041"><items id="description">*The medication order has been changed in a manner which does not require a new instruction/order to be issued, according to local clinical rules.(en)</items><items id="text">*Minor change to order(en)</items></items><items code="at0043"><items id="comment">*Used to compare variance from actual action time where this is not readily calculable from the original instruction.(en)</items><items id="description">*The datetime at which the medication action was scheduled to occur.(en)</items><items id="text">*Original scheduled date/time(en)</items></items><items code="at0044"><items id="description">*Administration of a dose of mediciation has been delayed but is expected to be given as soon as possible.(en)</items><items id="text">*Dose administration deferred(en)</items></items><items code="at0053"><items id="description">*Further structured details of the action, possibly specific to a pathway step.(en)</items><items id="text">*Additional details(en)</items></items><items code="at0085"><items id="description">**(en)</items><items id="text">*Cluster(en)</items></items><items code="at0103"><items id="comment">*Comment: This data element allows for multiple occurrences to be defined more explicitly at run-time, if required.(en)</items><items id="description">*Unique identifier for the medication order.(en)</items><items id="text">*Order ID(en)</items></items><items code="at0104"><items id="comment">*Use this SLOT where the detailed description of the dispensed, authorised or administered item needs to be explicitly stated. For example: the form, strength, any diluents or mixture of ingredients.(en)</items><items id="description">*Structured details about the medication including strength, form and constituent substances.(en)</items><items id="text">*Medication details(en)</items></items><items code="at0106"><items id="description">*The original medication order has been re-authorised to allow repeat prescription or dispensing. In some jurisdictions an entirely new order must be issued in these circumstances.(en)</items><items id="text">*Prescription re-authorised(en)</items></items><items code="at0109"><items id="description">*The medication has been recommended but no steps have been taken to initiate prescribing.(en)</items><items id="text">*Medication recommended(en)</items></items><items code="at0131"><items id="comment">*Dosage_administration is intended to carry details of medication order changes or dose administrations, whilst medication_supply_amount is intended for details of dispensing-related activity.(en)</items><items id="description">*Specific details about the amount of the medication item.(en)</items><items id="text">*Amount(en)</items></items><items code="at0132"><items id="comment">*In many jurisdictions, substitution of an ordered item as a generic form or with a different brand name, which has been determined as bioequivalent, is allowed at the point of dispense or supply. In other cases substitution is assumed and the clinician has to explicitly request non-substitution.(en)</items><items id="description">*Subsitution action taken by the person administering or dispensing the drug.(en)</items><items id="text">*Substitution(en)</items></items><items code="at0133"><items id="comment">*For example: "Generic alternative contains a substance that is not tolerated by the patient." May be coded with a terminology when clinically appropriate(en)</items><items id="description">*The reason or justification for the substitution action taken.(en)</items><items id="text">*Substitution reason(en)</items></items><items code="at0138"><items id="description">*A medication was substituted which is bioequivalent to that ordered.(en)</items><items id="text">*Substitution performed(en)</items></items><items code="at0139"><items id="description">*Although allowed by the medication order a bioequvalent medication was not substituted.(en)</items><items id="text">*Substitution not performed(en)</items></items><items code="at0140"><items id="description">*Details of body site and administration of the medication.(en)</items><items id="text">*Administration details(en)</items></items><items code="at0141"><items id="comment">*For example: 'left upper arm', 'intravenous catheter right hand'. &#13;
Coding of the body site with a terminology is preferred, where possible.(en)</items><items id="description">*Structured description of the site of administration of the ordered item.(en)</items><items id="text">*Body site(en)</items></items><items code="at0142"><items id="comment">*For example: "On the medial skin surface of the left forearm, from 10 cm to 20 cm distally from the point of the elbow".(en)</items><items id="description">*Structured description of the site of administration of the medication, vaccine or therapeutic good.(en)</items><items id="text">*Structured body site(en)</items></items><items code="at0143"><items id="comment">*Comment: For example: ' via Z-track injection'; 'via nebuliser'. Coding of the method with a terminology is preferred, where possible.(en)</items><items id="description">*The technique or device by which the ordered item was, or is to be, administered.(en)</items><items id="text">*Administration method(en)</items></items><items code="at0144"><items id="description">*Details of the medical device used to assist administration of the medication.(en)</items><items id="text">*Administration device(en)</items></items><items code="at0145"><items id="description">*Draft prescription has been prepared and is awaiting confirmation from an authorised clinician. May be used where reauthorisations are performed as a batch. This careflow_step may have a status of 'planned' or 'active', reflecting the need to to handle new orders as well as re-authorised orders.(en)</items><items id="text">*Prescription awaiting authorisation(en)</items></items><items code="at0147"><items id="comment">*Comment: For example: 'oral', 'intravenous', or 'topical'. Coding of the route with a terminology is preferred, where possible. Multiple potential routes may be specified.(en)</items><items id="description">*The route by which the ordered item was, or is to be, administered into the subject's body.(en)</items><items id="text">*Route(en)</items></items><items code="at0148"><items id="comment">*For example: preparation of an intravenous mixture. (en)</items><items id="description">*The medication has been physically prepared. (en)</items><items id="text">*Medication prepared(en)</items></items><items code="at0149"><items id="comment">*Details of the individual performing the double-check can be carried in the Reference Model element "Participation".(en)</items><items id="description">*The action step has been checked by a separate individual.(en)</items><items id="text">*Double-checked?(en)</items></items><items code="at0150"><items id="description">*The prescription was cancelled prior to being issued.(en)</items><items id="text">*Prescription cancelled(en)</items></items><items code="at0151"><items id="description">*Prescription has been invalidated or has expired without being fulfilled.(en)</items><items id="text">*Prescription invalid or expired(en)</items></items><items code="at0152"><items id="description">*The prescription has been fulfilled successfully.(en)</items><items id="text">*Prescription fulfilled(en)</items></items><items code="at0153"><items id="description">*The medication has been formally authorised for use.(en)</items><items id="text">*Medication authorised(en)</items></items><items code="at0154"><items id="comment">*For example: 2017-10-29(en)</items><items id="description">*The date/time on which the medication course is set to restart, as per the "Medication restart date/condition set" pathway step.(en)</items><items id="text">*Restart date/time(en)</items></items><items code="at0155"><items id="comment">*For example: "On day 2 after surgery".(en)</items><items id="description">*The criterion which triggers the medication course to restart, as per the "Medication restart date/condition set" pathway step.(en)</items><items id="text">*Restart criterion(en)</items></items><items code="at0156"><items id="comment">*For example: 'Angina' or 'Pain'. Coding of the indication with a terminology is preferred, where possible. This data element allows multiple occurrences. If only an ACTION is used to record a medication indication, this data element can be used without additional consideration. However, if a clinical indication is recorded for both the Medication order INSTRUCTION and this Medication management ACTION, be aware that these indications might not be consistent." (en)</items><items id="description">*The clinical reason for the medication activity. (en)</items><items id="text">*Clinical indication (en)</items></items><items code="at0157"><items id="description">*The prepared medication has been double checked. (en)</items><items id="text">*Medication double checked (en)</items></items><items code="at0158"><items id="description">*An administration of a dose of the medication was started but was subsequently aborted. (en)</items><items id="text">*Dose administration aborted (en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="comment">Això no es limita a activitats dutes a terme basades en prescripcions de medicacions per part de metges, sinó que també pot incloure, per exemple, prendre medicació sense recepta.</items><items id="description">Qualsevol activitat relacionada amb la planificació, programació, gestió de prescripció, dispensació, administració, cessació i l’ús alternatiu d’una medicació, vacuna, producte nutricional o altre element terapèutic.</items><items id="text">Gestió de la medicació</items></items><items code="at0002"><items id="description">S’ha emès una prescripció per a la medicació.</items><items id="text">Prescripció emesa</items></items><items code="at0003"><items id="description">S’ha dispensat la medicació prescrita; per exemple, des d’una farmàcia al pacient.</items><items id="text">Prescripció dispensada</items></items><items code="at0004"><items id="description">El pacient ha pres o se li ha administrat la medicació per primera vegada. Encara que en alguns entorns es pugui computar aquesta data significativa com la primera de diverses administracions, en altres entorns, com atenció primària, les dates d’administració específiques no són fàcilment accessibles.</items><items id="text">Curs de la medicació iniciat</items></items><items code="at0005"><items id="description">S’ha reavaluat la medicació concreta; per exemple, si s’ha de continuar prenent. Això no pretén recollir una revisió de la llista de medicació.</items><items id="text">Medicació reavaluada</items></items><items code="at0006"><items id="description">S’ha realitzat una única administració de la medicació.</items><items id="text">Dosi administrada</items></items><items code="at0007"><items id="description">El curs de medicació s'ha completat segons allò previst.</items><items id="text">Curs de la medicació completat</items></items><items code="at0008"><items id="description">No s’ha dispensat la prescripció a causa d'un problema d’abastiment tècnic o farmacèutic.</items><items id="text">Abastiment retardat de la prescripció</items></items><items code="at0009"><items id="description">S’ha suspès l’administració de la medicació fins a nou avís. No s’han d’administrar més dosis fins que no es compleixin la data o les condicions de reinici. Quan s’estableixin les condicions/data de reinici després de la suspensió, cal realitzar una fase des d'«Administració suspesa» i tornar a «Data d’inici de la medicació/condicions establertes».</items><items id="text">Administració suspesa</items></items><items code="at0010"><items id="description">S’ha reemès una prescripció per a una prescripció existent.</items><items id="text">Prescripció reemesa</items></items><items code="at0011"><items id="description">L'expedició de la prescripció està pendent d'una reautorització per part d'un metge.</items><items id="text">Reautorització de la prescripció pendent</items></items><items code="at0012"><items id="description">S'ha cancel·lat el curs de la medicació previst abans de qualsevol administració.</items><items id="text">Curs de la medicació cancel·lat</items></items><items code="at0013"><items id="description">S'ha posposat el curs de la medicació programat abans de qualsevol administració.</items><items id="text">Curs de la medicació posposat</items></items><items code="at0015"><items id="description">S'ha interromput l'administració de la medicació durant el període del curs previst.</items><items id="text">Interrupció de la medicació</items></items><items code="at0016"><items id="description">S'ha fixat l'hora d'inici de la medicació o una altra condició d'inici.</items><items id="text">Data d’inici de la medicació/condició establerta</items></items><items code="at0017"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0018"><items id="description">S’ha retingut i no s’ha administrat un torn d’administració de la medicació. No s’espera que s’administri més tard, encara que la dosi següent (si n’hi hagués) s’ha d’administrar d’acord amb l’ordre original.</items><items id="text">Administració de dosi omesa</items></items><items code="at0020"><items id="comment">Per exemple: «Atenolol 100 mg» o «Tenormin comprimits 100 mg». &#13;
&#13;
Es recomana encaridament que l'«Element terapèutic» es programi amb una terminologia capaç d'activar el suport de la presa de decisions, sempre que sigui possible. L'extensió del codi pot variar des del nom del medicament fins a les dades estructurades sobre l’envàs de la medicació utilitzat. L'entrada de text lliure només caldrà utilitzar-la si no es disposa de la terminologia adequada.</items><items id="description">Nom del medicament, vacuna o altre element terapèutic/prescriptible en què es va centrar l'activitat.</items><items id="text">Medicament</items></items><items code="at0021"><items id="comment">Per exemple: «Posposat - Pacient no disponible al moment de l'administració», «Cancel·lat - Reacció adversa». Nota: aquest no és el motiu de la instrucció de la medicació, sinó del motiu específic pel qual es va fer una fase de cuidats, i sovint s'utilitzarà per a documentar alguna variació de la prescripció original.</items><items id="description">Motiu pel qual es va realitzar la fase de l’itinerari per a la medicació identificada.</items><items id="text">Motiu</items></items><items code="at0024"><items id="comment">Per exemple: «El pacient estava al servei de radiologia», «Injecció accidental en un vas sanguini durant l'administració d'un IM».</items><items id="description">Informació addicional sobre l'activitat o la fase d’itinerari no recollida en altres caselles, inclosos els detalls de qualsevol variació entre l'acció prevista i l'acció que es va realitzar realment.</items><items id="text">Observacions</items></items><items code="at0025"><items id="comment">Per exemple: Nombre de la seqüència de la vacuna.</items><items id="description">El nombre de la seqüència específic de la fase d’itinerari que s'està registrant.</items><items id="text">Nombre de la seqüència</items></items><items code="at0030"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0033"><items id="comment">Per exemple: «Evitar menjar pomelo», «Prendre almenys 2 hores abans d'anar al llit», «Prendre amb menjar». Es pot programar amb una terminologia quan sigui clínicament apropiat.</items><items id="description">Qualsevol orientació, instrucció o consell que s’ha donat al subjecte d'assistència o al cuidador personal al moment de la fase d’itinerari.</items><items id="text">Orientació al pacient</items></items><items code="at0039"><items id="description">Es va requerir un canvi important en la prescripció, raó per la qual es va interrompre aquesta prescripció i es va iniciar una prescripció substituta.</items><items id="text">Canvi important a la prescripció</items></items><items code="at0041"><items id="description">La prescripció s’ha modificat de manera que no requereixi l’emissió d’una nova prescripció/instrucció, d’acord amb les normes clíniques locals.</items><items id="text">Canvi menor a la prescripció</items></items><items code="at0043"><items id="comment">Utilitzar per a comparar la diferència del temps real d’acció quan no es pot calcular fàcilment a partir de les instruccions originals.</items><items id="description">La data o hora en què estava programat que ocorreguera l’acció de medicació.</items><items id="text">Data/hora programada original</items></items><items code="at0044"><items id="description">S’ha ajornat l’administració d’una dosi de la medicació, però s’espera que s’administri com més aviat millor.</items><items id="text">Administració de dosi ajornada</items></items><items code="at0053"><items id="description">Dades estructurades complementàries de l'acció, específics possiblement d'una fase d’itinerari.</items><items id="text">Dades addicionals</items></items><items code="at0085"><items id="comment">Per exemple: requisits locals d'informació o metadades addicionals per alinear-se amb equivalents de FHIR o CIMI.</items><items id="description">Informació addicional necessària per a recollir el contingut local o per alinear-se amb altres models/formalismes de referència.</items><items id="text">Extensió</items></items><items code="at0103"><items id="comment">Observació: Aquest element de dades permet definir diversos esdeveniments de manera més explícita en el temps d'execució, si cal.</items><items id="description">Identificador únic per a la prescripció.</items><items id="text">Identificació de la prescripció</items></items><items code="at0104"><items id="comment">Utilitzar aquest SLOT quan s'hagi d'explicitar la descripció detallada del producte dispensat, autoritzat o administrat. Per exemple: la forma, la concentració, qualsevol diluent o la mescla d'ingredients.</items><items id="description">Dades estructurades sobre la medicació, incloses la concentració, forma i substàncies que la componen.</items><items id="text">Dades de la medicació</items></items><items code="at0106"><items id="description">S’ha reautoritzat la prescripció original per a permetre que es repeteixin tant la prescripció com la dispensació. En algunes jurisdiccions, s’ha d’emetre una prescripció nova en aquestes circumstàncies.</items><items id="text">Prescripció reautoritzada</items></items><items code="at0109"><items id="description">S’ha recomanat la medicació, però no s’ha iniciat cap procés per a començar la prescripció.</items><items id="text">Medicació recomanada</items></items><items code="at0131"><items id="comment">CLUSTER.dosage pretén recollir dades de canvis en les prescripcions o administracions de dosis, mentre que CLUSTER.medication_supply_amount pretén recollir dades de l'activitat relacionada amb la dispensació.</items><items id="description">Dades específiques sobre la quantitat de l’element de medicació.</items><items id="text">Quantitat</items></items><items code="at0132"><items id="comment">En moltes jurisdiccions, es permet la substitució d'un element prescrit com a forma genèrica o amb una marca diferent, que s'hagi determinat com a bioequivalent, al punt de dispensació o abastiment. En altres casos, la substitució s’assumeix i el metge ha de sol·licitar explícitament que no es substitueixi.</items><items id="description">Acció de substitució adoptada per la persona que administra o dispensa el medicament.</items><items id="text">Substitució</items></items><items code="at0133"><items id="comment">Per exemple: «L'alternativa genèrica conté una substància que el pacient no tolera». Es pot programar amb una terminologia quan sigui clínicament apropiat.</items><items id="description">Motiu o justificació de l'acció de substitució adoptada.</items><items id="text">Motiu de la substitució</items></items><items code="at0138"><items id="description">Una medicació es va substituir per una altra bioequivalent a la prescrita.</items><items id="text">Substitució realitzada</items></items><items code="at0139"><items id="description">Encara que la prescripció ho permetia, no es va substituir una medicació bioequivalent.</items><items id="text">Substitució no realitzada</items></items><items code="at0140"><items id="description">Dades sobre la zona del cos i l'administració de la medicació.</items><items id="text">Dades de l'administració</items></items><items code="at0141"><items id="comment">Per exemple: «part superior del braç esquerre», «catèter intravenós a la mà dreta». Es recomana programar la zona del cos amb una terminologia, sempre que sigui possible.</items><items id="description">Descripció estructurada de la zona d'administració de l’element prescrit.</items><items id="text">Zona del cos</items></items><items code="at0142"><items id="comment">Per exemple: «En la superfície cutània medial de l'avantbraç esquerre, de 10 cm a 20 cm de manera distal des de la punta del colze».&#13;
</items><items id="description">Descripció estructurada de la zona d'administració de la medicació, vacuna o producte terapèutic.</items><items id="text">Zona del cos estructurada</items></items><items code="at0143"><items id="comment">Observació. Per exemple: «mitjançant la tècnica d’injecció Z»; «mitjançant un nebulitzador». Es recomana programar el mètode amb una terminologia, sempre que sigui possible.</items><items id="description">Tècnica o dispositiu mitjançant el qual es va administrar o administrarà l’element prescrit.</items><items id="text">Mètode d'administració</items></items><items code="at0144"><items id="description">Dades del dispositiu mèdic utilitzat per ajudar a administrar la medicació.</items><items id="text">Dispositiu d'administració</items></items><items code="at0145"><items id="description">S’ha preparat un esborrany de la prescripció i està pendent de confirmació per part d’un metge autoritzat. Es pot utilitzar quan les reautoritzacions es fan per lots. Aquest careflow_step pot tenir un estat «planificat» o «actiu», cosa que reflecteix la necessitat de gestionar tant prescripcions noves com prescripcions reautoritzades.</items><items id="text">Prescripció en espera per autorització</items></items><items code="at0147"><items id="comment">Observació. Per exemple: «oral», «intravenosa» o «tòpica». Es recomana programar la via amb una terminologia sempre que sigui possible. Es poden especificar múltiples vies possibles.</items><items id="description">Via per la qual l’element prescrit s'ha administrat o s'administrarà en el cos del subjecte.</items><items id="text">Via d'administració</items></items><items code="at0148"><items id="comment">Per exemple: la preparació d’una mescla intravenosa.</items><items id="description">S’ha preparat la medicació físicament.</items><items id="text">Medicació preparada</items></items><items code="at0149"><items id="comment">Dades de la persona que realitza la verificació es poden recollir a l'element de Model de Referència «Participació».</items><items id="description">La fase d’itinerari s'ha comprovat per una persona diferent.</items><items id="text">Verificació</items></items><items code="at0150"><items id="description">La prescripció es cancel·là abans de ser emesa.</items><items id="text">Prescripció cancel·lada</items></items><items code="at0151"><items id="description">S’ha invalidat la prescripció o ha caducat sense completar-se.</items><items id="text">Prescripció no vàlida o caducada</items></items><items code="at0152"><items id="description">La prescripció s'ha finalitzat correctament.</items><items id="text">Prescripció finalitzada</items></items><items code="at0153"><items id="description">S’ha autoritzat formalment l’ús de la medicació.</items><items id="text">Medicació autoritzada</items></items><items code="at0154"><items id="comment">Per exemple: 29-10-2017.</items><items id="description">Data/hora en què el curs de medicació està programat per reiniciar-se, segons la fase de l’itinerari «Administració suspesa».</items><items id="text">Data/hora de reinici</items></items><items code="at0155"><items id="comment">Per exemple: «El segon dia després de l'operació».</items><items id="description">El criteri que provoca el reinici del curs de la medicació, segons la fase de l’itinerari «Administració suspesa».</items><items id="text">Criteri de reinici</items></items><items code="at0156"><items id="comment">Per exemple: «Angina» o «Dolor». Es recomana programar la indicació clínica amb una terminologia quan sigui possible. Aquest element de dades permet múltiples esdeveniments. Si només s'utilitza una ACTION per a registrar una indicació de medicació, aquest element de dades es pot registrar sense més consideració. No obstant això, si una indicació clínica es registra tant per a la INSTRUCTION de Prescripció com per a aquesta ACTION de la Gestió de medicació, s'ha de tindre en compte que aquestes indicacions poden no ser congruents.</items><items id="description">Motiu clínic de l'activitat de medicació.</items><items id="text">Indicació clínica</items></items><items code="at0157"><items id="description">S’ha comprovat la medicació preparada amb minuciositat.</items><items id="text">Medicació verificada</items></items><items code="at0158"><items id="description">*An administration of a dose of the medication was started but was subsequently aborted. (en)</items><items id="text">*Dose administration aborted (en)</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="comment">Dies beschränkt sich nicht nur auf Aktivitäten, die auf der Grundlage von Arzneimittelverordnungen von Ärzten durchgeführt werden, sondern kann sich auch z.B. auf die Einnahme von freiverkäuflichen Medikamenten beziehen.</items><items id="description">Jede Aktivität in Bezug auf die Planung, Vorbereitung, Rezeptverwaltung, Ausgabe, Verabreichung, Einnahme, Absetzung und anderer Verwendung von Arzneimitteln, Impfstoffen, Nahrungsergänzungsmitteln und anderen therapeutischen Mitteln.</items><items id="text">Arzneimittelanwendung</items></items><items code="at0002"><items id="description">Für das Arzneimittel wurde ein Rezept ausgestellt.</items><items id="text">Rezept ausgestellt</items></items><items code="at0003"><items id="description">Das verordnete Arzneimittel ist an einen Patienten ausgegeben worden, z.B. von einer Apotheke.</items><items id="text">Rezept wurde ausgegeben/eingelöst</items></items><items code="at0004"><items id="description">Das Arzneimittel wurde zum ersten Mal von dem Patienten eingenommen oder ihm verabreicht. Obwohl in einigen Situationen das relevante Datum als erste von mehreren Anwendungen errechenbar ist, kann es in der Grundversorgung sein, dass genaue Verabreichungszeit nicht ohne weiteres verfügbar ist.</items><items id="text">Arzneimittelbehandlung hat begonnen</items></items><items code="at0005"><items id="description">Das individuelle Arzneimittel wurde neu bewertet, beispielsweise ob das Arzneimittel noch angewendet werden soll. Eine Überprüfung der Arzneimittelliste soll nicht durchgeführt werden.</items><items id="text">Arzneimittel wurde neu bewertet</items></items><items code="at0006"><items id="description">Eine einzelne Verabreichung des Arzneimittels ist erfolgt.</items><items id="text">Dosis wurde verabreicht</items></items><items code="at0007"><items id="description">Die medikamentöse Behandlung wurde, wie geplant, beendet.</items><items id="text">Arzneimittelbehandlung ist abgeschlossen</items></items><items code="at0008"><items id="description">Das Rezept wurde aufgrund einer technischen oder pharmazeutischen Störung nicht ausgegeben.</items><items id="text">Verzögerung der Rezeptabgabe</items></items><items code="at0009"><items id="description">Die Verabreichung des Arzneimittels wurde bis zum Erhalt weiterer Informationen ausgesetzt. Es sollten keine weiteren Dosen, bis zur Bekanntgabe des neuen Startdatums oder bis die Bedingungen erfüllt sind, verabreicht werden. Wenn Sie das Datum/ die Voraussetzungen für den Neustart nach dem Aussetzen festlegen, sollte ein Schritt von "Verabreichung wurde ausgesetzt" und zurück zu "Arzneimittel Startdatum/Voraussetzung" ausgeführt werden.</items><items id="text">Verabreichung wurde ausgesetzt</items></items><items code="at0010"><items id="description">Ein Rezept wurde für eine vorhandene Arzneimittelverordnung neu ausgestellt.</items><items id="text">Rezept neu ausgestellt</items></items><items code="at0011"><items id="description">Die Ausstellung des Rezeptes wartet auf die erneute Autorisierung durch einen Arzt.</items><items id="text">Re-Autorisierug des Rezepts ausstehend</items></items><items code="at0012"><items id="description">Die geplante Arzneimittelbehandlung wurde vor der Verabreichung abgesagt.</items><items id="text">Arzneimittelbehandlung wurde abgesagt</items></items><items code="at0013"><items id="description">Die geplante Arzneimittelbehandlung wurde vor der Verabreichung verschoben.</items><items id="text">Arzneimittelbehandlung wurde verschoben</items></items><items code="at0015"><items id="description">Die Verabreichung des Arzneimittels wurde während der Dauer der geplanten Behandlung eingestellt.</items><items id="text">Arzneimittelbehandlung gestoppt</items></items><items code="at0016"><items id="description">Das Startdatum der Arzneimittelanwendung oder andere Startbedingungen wurden festgelegt.</items><items id="text">Arzneimittel Startdatum/Voraussetzung</items></items><items code="at0017"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0018"><items id="description">Eine Gabe des Arzneimittels wurde zurückgehalten und nicht gegeben. Es besteht keine Erwartung, dass sie später verabreicht wird, obwohl die nächste Dosis (falls es eine gibt) gemäß der ursprünglichen Verordnung verabreicht werden sollte.</items><items id="text">Verabreichung einer Dosis wurde ausgelassen</items></items><items code="at0020"><items id="comment">Zum Beispiel: "Atenolol 100 mg" oder "Tenormin Tabletten 100 mg".&#13;
Es wird dringend empfohlen, dass das Element "Arzneimittel" mit einer Terminologie kodiert wird, die nach Möglichkeit eine Entscheidungsunterstützung auslösen kann. Der Umfang der Kodierung kann vom einfachen Namen des Arzneimittels bis hin zu strukturierten Details über die tatsächlich verwendete Medikamentenpackung variieren. Die Freitext-Eingabe sollte nur dann verwendet werden, wenn keine entsprechende Terminologie vorhanden ist.</items><items id="description">Name des Arzneimittels, eines Impfstoffs oder eines anderen therapeutischen Mittels, welches im Mittelpunkt der Aktivität steht.</items><items id="text">Arzneimittel</items></items><items code="at0021"><items id="comment">Zum Beispiel: "Verschoben - Patient zur Verabreichungszeit nicht verfügbar", "abgesagt - Nebenwirkung". Merke: Dies ist nicht der Grund für die Verordnung von Arzneimittel, sondern der spezifische Grund, warum ein Prozessschritt durchgeführt wurde. Wird oft verwendet, um Abweichungen von der ursprünglichen Verordnung zu dokumentieren.</items><items id="description">Begründung, warum der Prozessschritt für das identifizierte Arzneimittel durchgeführt wurde.</items><items id="text">Begründung</items></items><items code="at0024"><items id="comment">Zum Beispiel: "Patient war in der Radiologie.", "Versehentliche Punktion der Vene während der i.m. Verabreichung."</items><items id="description">Zur Dokumentation von zusätzlichen Schilderungen über die Aktivitäten oder den Prozessschritt, wenn sie noch nicht in anderen Feldern erfasst wurden. Dabei sollen Einzelheiten zu Abweichungen zwischen durchzuführender Aktion und tatsächlich durchgeführter Aktion erfasst werden.</items><items id="text">Kommentar</items></items><items code="at0025"><items id="comment">Zum Beispiel: Impfsequenznummer.</items><items id="description">Die spezifische Sequenznummer des Prozessschritts wird erfasst.</items><items id="text">Sequenznummer</items></items><items code="at0030"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0033"><items id="comment">Zum Beispiel: "Vermeiden Sie den Konsum von Grapefruits oder grapefruithaltigen Lebensmitteln.", "Die Einnahme sollte mindestens 2 Stunden vor dem Zubettgehen erfolgen.", "Bitte zusammen mit Nahrung einnehmen." Wenn es klinisch zutreffend ist, kann für dieses Item eine Terminologie hinterlegt werden.</items><items id="description">Jede Anweisung, Anleitung oder Empfehlung, die dem Patienten oder der Pflegekraft zum Zeitpunkt eines Prozessschrittes übermittelt wird.</items><items id="text">Patientenanweisung</items></items><items code="at0039"><items id="description">Eine große Änderung der Verordnung war erforderlich, die dazu führte, dass diese Verordnung gestoppt und eine Ersatzverordnung gestartet wurde.</items><items id="text">Größere Änderung der Verordnung</items></items><items code="at0041"><items id="description">Die Arzneimittelverordnung wurde so geändert, dass keine neue Verordnung/neues Rezept nach den lokalen klinischen Regeln ausgestellt werden muss.</items><items id="text">Geringfügige Änderung der Verordnung</items></items><items code="at0043"><items id="comment">Wird verwendet, um die Abweichung von der tatsächlichen Aktionszeit zu vergleichen, wenn diese aus der ursprünglichen Verordnung nicht leicht berechenbar ist.</items><items id="description">Das Datum/die Uhrzeit, an dem die Aktion mit dem Arzneimittel eingeplant war.</items><items id="text">Ursprünglich geplantes Datum/Uhrzeit</items></items><items code="at0044"><items id="description">Die Verabreichung einer Dosis hat sich verzögert, wird aber so schnell wie möglich erfolgen.</items><items id="text">Verabreichung einer Dosis wurde verschoben</items></items><items code="at0053"><items id="description">Weitere strukturierte Details zu der Aktivität, möglicherweise speziell zu einem Prozessschritt.</items><items id="text">Zusätzliche Details</items></items><items code="at0085"><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="text">Erweiterung</items></items><items code="at0103"><items id="comment">Kommentar: Dieses Datenelement ermöglicht zur Laufzeit einer Anwendung eine genauere Spezifikation von Mehrfach-Auftreten, wenn notwendig.</items><items id="description">Eindeutige ID der Arzneimittelverordnung.</items><items id="text">ID der Verordnung</items></items><items code="at0104"><items id="comment">Verwenden Sie diesen SLOT, wenn die detaillierte Beschreibung des ausgegebenen, autorisierten oder verabreichten Arzneimittels ausdrücklich angegeben werden muss. Zum Beispiel: die Form, Stärke, alle Verdünner oder Mischung von Inhaltsstoffen.</items><items id="description">Strukturierte Informationen über das Arzneimittel inklusive Stärke, Form und Inhaltsstoffe.</items><items id="text">Arzneimitteldetails</items></items><items code="at0106"><items id="description">Die ursprüngliche Verordnung des Arzneimittels wurde erneut genehmigt, um eine wiederholte Verschreibung oder Abgabe zu ermöglichen. In einigen Ländern, wie z.B. Deutschland, muss unter diesen Umständen ein völlig neues Rezept ausgestellt werden.</items><items id="text">Rezept ist re-autorisiert</items></items><items code="at0109"><items id="description">Das Arzneimittel wurde empfohlen, aber es wurden keine Schritte unternommen, um die Verschreibung/Verordnung einzuleiten.</items><items id="text">Arzneimittel empfohlen</items></items><items code="at0131"><items id="comment">Der CLUSTER.dosage soll Details zu Änderungen der Arzneimittelverordnung oder der Dosisverabreichungen enthalten, während CLUSTER.medication_supply_amount ist für Details zu Aktivitäten im Zusammenhang mit der Abgabe bestimmt.</items><items id="description">Spezifische Angaben zur Dosis des Arzneimittels.</items><items id="text">Dosis</items></items><items code="at0132"><items id="comment">In vielen Rechtssystemen ist die Substitution eines verordneten Arzneimittels in generischer Form oder mit einem anderen Markennamen, welcher als bioäquivalent bestimmt wurde, zum Zeitpunkt der Ausgabe oder Verabreichung erlaubt. In anderen Fällen wird eine Substitution erwartet und der Arzt muss ausdrücklich die Nicht-Substitution verlangen.</items><items id="description">Substitutionsmaßnahmen, die von der Person ergriffen werden, die das Medikament verabreicht oder ausgibt.</items><items id="text">Substitution</items></items><items code="at0133"><items id="comment">Zum Beispiel: "Generische Alternative beinhaltet eine Substanz, die vom Patient nicht vertragen wird." Kann bei klinischer Eignung mit einer Terminologie codiert werden.</items><items id="description">Die Ursache oder die Begründung für die durchgeführte Substitution.</items><items id="text">Grund für die Substitution</items></items><items code="at0138"><items id="description">Ein Arzneimittel wurde substituiert, welches bioäquivalent zu dem Angeforderten ist.</items><items id="text">Substitution wurde durchgeführt</items></items><items code="at0139"><items id="description">Obwohl es nach der Arzneimittelverordnung erlaubt gewesen wäre, wurde nicht mit einem bioäquivalenten Arzneimittel substituiert.</items><items id="text">Substitution wurde nicht durchgeführt</items></items><items code="at0140"><items id="description">Details über die Körperstelle und über die Verabreichung des Arzneimittels.</items><items id="text">Details zur Verabreichung</items></items><items code="at0141"><items id="comment">Zum Beispiel: "linker Oberarm", "intravenöser Katheter rechte Hand". Die Codierung der Körperstelle mit einer Terminologie, wenn möglich, wird bevorzugt.</items><items id="description">Strukturierte Beschreibung der Körperstelle, an der das Arzneimittel angewendet wird.</items><items id="text">Körperstelle</items></items><items code="at0142"><items id="comment">Zum Beispiel: "Auf der medialen Hautoberfläche des linken Unterarms, 10 cm bis 20 cm distal von der Spitze des Ellbogens entfernt."</items><items id="description">Genaue Beschreibung der Körperstelle, an der das Arzneimittel, der Impfstoff oder ein therapeutisches Produkt angewendet wird.</items><items id="text">Lokalisation</items></items><items code="at0143"><items id="comment">Kommentar: Zum Beispiel: "via Z-track Injektion"; "via Vernebler". Die Codierung der Methode mit einer Terminologie, wenn möglich, wird bevorzugt.</items><items id="description">Die Technik oder das Gerät mit dem das verschriebene Arzneimittel verabreicht wird oder werden soll.</items><items id="text">Methode der Verabreichung</items></items><items code="at0144"><items id="description">Details zu der Vorrichtung mit dem das Arzneimittel verabreicht wird.</items><items id="text">Verabreichungsmittel</items></items><items code="at0145"><items id="description">Der Rezeptentwurf wurde erstellt und wartet auf die Bestätigung durch einen autorisierten Arzt. Kann auch verwendet werden, wenn die Re-autorisierung gebündelt erfolgt. Dieser "careflow_step" hat den Status "geplant" oder "aktiv", was die Notwendigkeit widerspiegelt, sowohl Neuaufträge als auch erneut autorisierte Aufträge zu bearbeiten.</items><items id="text">Rezept wartet auf Genehmigung</items></items><items code="at0147"><items id="comment">Kommentar: Zum Beispiel: "oral", "intravenös" oder "topisch". Die Codierung des Verabreichungswegs wird bevorzugt, wenn möglich. Mehrere potentielle Anwendungsformen können spezifiziert werden.</items><items id="description">Die Angabe darüber, auf welche Art das verordnete Arzneimittel am Körper des Patienten angewendet wird.</items><items id="text">Verabreichungsweg</items></items><items code="at0148"><items id="comment">*For example: preparation of an intravenous mixture. (en)</items><items id="description">*The medication has been physically prepared. (en)</items><items id="text">Arzneimittel wurde vorbereitet</items></items><items code="at0149"><items id="comment">Details zu der Person, die die Überprüfung vornimmt, können in das Referenzmodell "Participations" übertragen werden.</items><items id="description">Der Prozessschritt wurde durch eine unabhängige Person überprüft.</items><items id="text">Nachkontrolliert?</items></items><items code="at0150"><items id="description">Das Rezept wurde vor der Ausstellung widerrufen.</items><items id="text">Rezept wurde widerrufen</items></items><items code="at0151"><items id="description">Das Rezept ist ungültig geworden oder ist abgelaufen, ohne das es eingelöst wurde.</items><items id="text">Rezept ist ungültig oder abgelaufen</items></items><items code="at0152"><items id="description">Das Rezept wurde erfolgreich ausgeführt/eingehalten.</items><items id="text">Rezept wurde ausgeführt</items></items><items code="at0153"><items id="description">Das Arzneimittel ist offiziell zur Anwendung genehmigt.</items><items id="text">Arzneimittel wurde genehmigt</items></items><items code="at0154"><items id="comment">Zum Beispiel: 29.10.2017</items><items id="description">Das Datum/die Uhrzeit an dem die Arzneimittelbehandlung wieder begonnen wird, gemäß dem "Verabreichung wurde ausgesetzt"- Schritt.</items><items id="text">Datum/Uhrzeit des Neustarts</items></items><items code="at0155"><items id="comment">Zum Beispiel: "Am Tag 2 nach der OP."</items><items id="description">Das Kriterium, das den Neustart der Arzneimittelbehandlung auslöst, gemäß dem Schritt "Verabreichung wurde ausgesetzt".</items><items id="text">Kriterium des Neustarts</items></items><items code="at0156"><items id="comment">Zum Beispiel: "Angina" oder "Schmerz". Die Codierung der Indikation mit einer Terminologie wird nach Möglichkeit bevorzugt. Dieses Datenelement ermöglicht mehrere Vorkommen. Wenn nur ein AKTION-Archetyp zur Aufzeichnung einer Medikamentenindikation verwendet wird, kann dieses Datenelement ohne zusätzliche Überlegungen verwendet werden. Wenn jedoch eine klinische Indikation sowohl im INSTRUCTION-Archetyp zur Verordnung von Arzneimittel als auch im AKTION-Archetyp zur Medikamentenanwendung aufgezeichnet wird, beachten Sie, dass diese Indikationen möglicherweise nicht konsistent sind.</items><items id="description">Der klinische Grund für die Aktivität mit dem Arzneimittel.</items><items id="text">Klinische Indikation</items></items><items code="at0157"><items id="description">*The prepared medication has been double checked. (en)</items><items id="text">*Medication double checked (en)</items></items><items code="at0158"><items id="description">*An administration of a dose of the medication was started but was subsequently aborted. (en)</items><items id="text">*Dose administration aborted (en)</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="comment">This is not limited to activities performed based on medication orders from clinicians, but could also include for example taking over the counter medication.</items><items id="description">Any activity related to the planning, scheduling, prescription management, dispensing, administration, cessation and other use of a medication, vaccine, nutritional product or other therapeutic item.</items><items id="text">Medication management</items></items><items code="at0002"><items id="description">A prescription has been issued for the medication.</items><items id="text">Prescription issued</items></items><items code="at0003"><items id="description">The ordered medication has been dispensed, for example from a pharmacy to the patient.</items><items id="text">Prescription dispensed</items></items><items code="at0004"><items id="description">The medication has been taken by, or administered to, the patient for the first time. Although in some settings this significant date may be computable as the first of several administrations, in other settings, such as primary care, specific administration dates are not readily available.</items><items id="text">Medication course commenced</items></items><items code="at0005"><items id="description">The individual medication has been reassessed, for example whether the medication should still be taken. This is not intended to capture review of the medication list.</items><items id="text">Medication reassessed</items></items><items code="at0006"><items id="description">A single administration of the medication has taken place.</items><items id="text">Dose administered</items></items><items code="at0007"><items id="description">The medication course has been completed as planned.</items><items id="text">Medication course completed</items></items><items code="at0008"><items id="description">The prescription has not been dispensed due to a technical or pharamaceutical supply issue.</items><items id="text">Prescription supply delayed</items></items><items code="at0009"><items id="description">The administration of the medication has been suspended until further notice. No further doses should be given until the restart date or conditions have been met. When setting the date/conditions for restart after suspending, a step from ‘Administrations suspended’ and back to 'Medication start date/condition set' should be performed.</items><items id="text">Administrations suspended</items></items><items code="at0010"><items id="description">A prescription has been re-issued for an existing medication order.</items><items id="text">Prescription re-issued</items></items><items code="at0011"><items id="description">Issue of the prescription is awaiting re-authorisation by a clinician.</items><items id="text">Prescription re-authorisation pending</items></items><items code="at0012"><items id="description">The planned course of medication has been cancelled prior to any administration.</items><items id="text">Medication course cancelled</items></items><items code="at0013"><items id="description">The scheduled medication course has been postponed prior to any administration.</items><items id="text">Medication course postponed</items></items><items code="at0015"><items id="description">Administration of the medication has been ceased during the period of the intended course.</items><items id="text">Medication course stopped</items></items><items code="at0016"><items id="description">The time to start the medication, or other starting condition, has been set.</items><items id="text">Medication start date/condition set</items></items><items code="at0017"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0018"><items id="description">An administration of the medication has been withheld and not given. There is no expectation that it will be given later, though the next dose (if any) should be administered according to the original order.</items><items id="text">Dose administration omitted</items></items><items code="at0020"><items id="comment">For example: 'Atenolol 100mg' or 'Tenormin tablets 100mg'. &#13;
It is strongly recommended that the 'Medication item' is coded with a terminology capable of triggering decision support, where possible. The extent of coding may vary from the simple name of the medication item through to structured details about the actual medication pack used. Free text entry should only be used if there is no appropriate terminology available.</items><items id="description">Name of the medication, vaccine or other therapeutic/prescribable item which was the focus of the activity.</items><items id="text">Medication item</items></items><items code="at0021"><items id="comment">For example: 'Postponed - Patient not avalable at administration time', 'Cancelled - Adverse reaction'. Note: This is not the reason for the medication instruction, but rather the specific reason that a care step was carried out, and will often be used to document some variance from the original order.</items><items id="description">Reason that the pathway step for the identified medication was carried out.</items><items id="text">Reason</items></items><items code="at0024"><items id="comment">For example: 'Patient was in radiology department', 'Accidental injection into blood vessel during IM administration'.</items><items id="description">Additional narrative about the activity or pathway step not captured in other fields, including details of any variance between the intended action and the action actually performed.</items><items id="text">Comment</items></items><items code="at0025"><items id="comment">For example: Vaccine sequence number.</items><items id="description">The sequence number specific to the pathway step being recorded.</items><items id="text">Sequence number</items></items><items code="at0030"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0033"><items id="comment">For example: 'Avoid grapefruit' , 'Take at least 2 hours before bedtime', 'Take with food'. May be coded with a terminology when clinically appropriate.</items><items id="description">Any guidance, instructions or advice given to the subject of care or personal carer at the time of the pathway step.</items><items id="text">Patient guidance</items></items><items code="at0039"><items id="description">A major change to the order was required, resulting in this order being stopped and a replacement order being started.</items><items id="text">Major change to order</items></items><items code="at0041"><items id="description">The medication order has been changed in a manner which does not require a new instruction/order to be issued, according to local clinical rules.</items><items id="text">Minor change to order</items></items><items code="at0043"><items id="comment">Used to compare variance from actual action time where this is not readily calculable from the original instruction.</items><items id="description">The datetime at which the medication action was scheduled to occur.</items><items id="text">Original scheduled date/time</items></items><items code="at0044"><items id="description">An administration of a dose of the medication has been delayed but is expected to be given as soon as possible.</items><items id="text">Dose administration deferred</items></items><items code="at0053"><items id="description">Further structured details of the action, possibly specific to a pathway step.</items><items id="text">Additional details</items></items><items code="at0085"><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></items><items code="at0103"><items id="comment">Comment: This data element allows for multiple occurrences to be defined more explicitly at run-time, if required.</items><items id="description">Unique identifier for the medication order.</items><items id="text">Order ID</items></items><items code="at0104"><items id="comment">Use this SLOT where the detailed description of the dispensed, authorised or administered item needs to be explicitly stated. For example: the form, strength, any diluents or mixture of ingredients.</items><items id="description">Structured details about the medication including strength, form and constituent substances.</items><items id="text">Medication details</items></items><items code="at0106"><items id="description">The original medication order has been re-authorised to allow repeat prescription or dispensing. In some jurisdictions an entirely new order must be issued in these circumstances.</items><items id="text">Prescription re-authorised</items></items><items code="at0109"><items id="description">The medication has been recommended but no steps have been taken to initiate prescribing.</items><items id="text">Medication recommended</items></items><items code="at0131"><items id="comment">CLUSTER.dosage is intended to carry details of medication order changes or dose administrations, whilst CLUSTER.medication_supply_amount is intended for details of dispensing-related activity.</items><items id="description">Specific details about the amount of the medication item.</items><items id="text">Amount</items></items><items code="at0132"><items id="comment">In many jurisdictions, substitution of an ordered item as a generic form or with a different brand name, which has been determined as bioequivalent, is allowed at the point of dispense or supply. In other cases substitution is assumed and the clinician has to explicitly request non-substitution.</items><items id="description">Subsitution action taken by the person administering or dispensing the drug.</items><items id="text">Substitution</items></items><items code="at0133"><items id="comment">For example: "Generic alternative contains a substance that is not tolerated by the patient." May be coded with a terminology when clinically appropriate</items><items id="description">The reason or justification for the substitution action taken.</items><items id="text">Substitution reason</items></items><items code="at0138"><items id="description">A medication was substituted which is bioequivalent to that ordered.</items><items id="text">Substitution performed</items></items><items code="at0139"><items id="description">Although allowed by the medication order a bioequvalent medication was not substituted.</items><items id="text">Substitution not performed</items></items><items code="at0140"><items id="description">Details of body site and administration of the medication.</items><items id="text">Administration details</items></items><items code="at0141"><items id="comment">For example: 'left upper arm', 'intravenous catheter right hand'. &#13;
Coding of the body site with a terminology is preferred, where possible.</items><items id="description">Structured description of the site of administration of the ordered item.</items><items id="text">Body site</items></items><items code="at0142"><items id="comment">For example: "On the medial skin surface of the left forearm, from 10 cm to 20 cm distally from the point of the elbow".</items><items id="description">Structured description of the site of administration of the medication, vaccine or therapeutic good.</items><items id="text">Structured body site</items></items><items code="at0143"><items id="comment">Comment: For example: ' via Z-track injection'; 'via nebuliser'. Coding of the method with a terminology is preferred, where possible.</items><items id="description">The technique or device by which the ordered item was, or is to be, administered.</items><items id="text">Administration method</items></items><items code="at0144"><items id="description">Details of the medical device used to assist administration of the medication.</items><items id="text">Administration device</items></items><items code="at0145"><items id="description">Draft prescription has been prepared and is awaiting confirmation from an authorised clinician. May be used where reauthorisations are performed as a batch. This careflow_step may have a status of 'planned' or 'active', reflecting the need to to handle new orders as well as re-authorised orders.</items><items id="text">Prescription awaiting authorisation</items></items><items code="at0147"><items id="comment">Comment: For example: 'oral', 'intravenous', or 'topical'. Coding of the route with a terminology is preferred, where possible. Multiple potential routes may be specified.</items><items id="description">The route by which the ordered item was, or is to be, administered into the subject's body.</items><items id="text">Route</items></items><items code="at0148"><items id="comment">For example: preparation of an intravenous mixture.</items><items id="description">The medication has been physically prepared.</items><items id="text">Medication prepared</items></items><items code="at0149"><items id="comment">Details of the individual performing the double-check can be carried in the Reference Model element "Participation".</items><items id="description">The pathway step has been checked by a separate individual.</items><items id="text">Double-checked?</items></items><items code="at0150"><items id="description">The prescription was cancelled prior to being issued.</items><items id="text">Prescription cancelled</items></items><items code="at0151"><items id="description">Prescription has been invalidated or has expired without being fulfilled.</items><items id="text">Prescription invalid or expired</items></items><items code="at0152"><items id="description">The prescription has been fulfilled successfully.</items><items id="text">Prescription fulfilled</items></items><items code="at0153"><items id="description">The medication has been formally authorised for use.</items><items id="text">Medication authorised</items></items><items code="at0154"><items id="comment">For example: 2017-10-29</items><items id="description">The date/time on which the medication course is set to restart, as per the "Administrations suspended" pathway step.</items><items id="text">Restart date/time</items></items><items code="at0155"><items id="comment">For example: "On day 2 after surgery".</items><items id="description">The criterion which triggers the medication course to restart, as per the "Administrations suspended" pathway step.</items><items id="text">Restart criterion</items></items><items code="at0156"><items id="comment">For example: 'Angina' or 'Pain'. Coding of the indication with a terminology is preferred, where possible. This data element allows multiple occurrences. If only an ACTION is used to record a medication indication, this data element can be used without additional consideration. However, if a clinical indication is recorded for both the Medication order INSTRUCTION and this Medication management ACTION, be aware that these indications might not be consistent."</items><items id="description">The clinical reason for the medication activity.</items><items id="text">Clinical indication</items></items><items code="at0157"><items id="description">The prepared medication has been double checked.</items><items id="text">Medication double checked</items></items><items code="at0158"><items id="description">An administration of a dose of the medication was started but was subsequently aborted.</items><items id="text">Dose administration aborted</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="comment">No se limita a actividades realizadas en base a órdenes de medicación de los clínicos, sino que también podría incluir, por ejemplo, el uso de medicamentos de venta libre.</items><items id="description">Cualquier actividad relacionada con la planificación, programación, gestión de prescripciones, dispensación, administración, cese y otro uso de un medicamento, vacuna, producto nutricional u otro elemento terapéutico.</items><items id="text">Gestión de la medicación</items></items><items code="at0002"><items id="description">Se ha emitido una receta médica para el medicamento.</items><items id="text">Prescripción emitida</items></items><items code="at0003"><items id="description">Se ha dispensado la medicación solicitada, por ejemplo, desde una farmacia al paciente.</items><items id="text">Prescripción dispensada</items></items><items code="at0004"><items id="description">El paciente ha tomado o se le ha administrado el medicamento por primera vez. Aunque en algunos entornos esta fecha significativa puede ser calculada como la primera de varias administraciones, en otros contextos, como la atención primaria, las fechas específicas de administración no están fácilmente disponibles.</items><items id="text">Curso de medicación iniciado</items></items><items code="at0005"><items id="description">Se ha reevaluado la medicación individual, por ejemplo, si debe seguir tomándose. No se trata de revisar la lista de medicamentos.</items><items id="text">Medicación reevaluada</items></items><items code="at0006"><items id="description">Se ha realizado una única administración del medicamento.</items><items id="text">Dosis administrada</items></items><items code="at0007"><items id="description">El curso de medicación se ha completado según lo previsto.</items><items id="text">Curso de medicación completado</items></items><items code="at0008"><items id="description">La receta no se ha dispensado debido a un problema técnico o de suministro farmacéutico.</items><items id="text">Retraso en el suministro de prescripciones</items></items><items code="at0009"><items id="description">La administración del medicamento ha sido suspendida hasta nuevo aviso. No deben administrarse más dosis hasta que se haya restablecido la fecha de reinicio o se hayan cumplido las condiciones necesarias. Al establecer la fecha/condiciones de reinicio tras la suspensión, debe realizarse un paso desde 'Administración suspendida' y volver a 'Fecha de inicio de la medicación/condición establecida'.</items><items id="text">Administración suspendida</items></items><items code="at0010"><items id="description">Se ha vuelto a emitir una receta para una orden de medicación existente.</items><items id="text">Prescripción reexpedida</items></items><items code="at0011"><items id="description">La emisión de la receta médica está pendiente de reautorización por parte de un clínico.</items><items id="text">Reautorización de prescripción pendiente</items></items><items code="at0012"><items id="description">Se ha cancelado la medicación prevista antes de su administración.</items><items id="text">Curso de medicación cancelado</items></items><items code="at0013"><items id="description">Se ha pospuesto el curso de medicación programado antes de cualquier administración.</items><items id="text">Curso de medicación pospuesto</items></items><items code="at0015"><items id="description">Se ha interrumpido la administración del medicamento durante el período del curso previsto.</items><items id="text">Interrupción de la medicación</items></items><items code="at0016"><items id="description">Se ha establecido el momento para comenzar la medicación, o cualquier otra condición de inicio.</items><items id="text">Fecha de inicio de la medicación/condición establecida</items></items><items code="at0017"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0018"><items id="description">Se ha retenido y no administrado una dosis del medicamento. No se espera que se administre más tarde, aunque la siguiente dosis (si la hubiera) debe administrarse de acuerdo con la orden original.</items><items id="text">Administración de dosis omitida</items></items><items code="at0020"><items id="comment">Por ejemplo: "Atenolol 100 mg" o "Tenormin comprimidos 100 mg". &#13;
Se recomienda encarecidamente que 'Medicamento' se codifique con una terminología capaz de activar el apoyo a la toma de decisiones, siempre que sea posible. El grado de codificación puede variar desde el simple nombre del medicamento hasta detalles estructurados sobre el envase utilizado. La entrada de texto libre sólo debe utilizarse si no se dispone de la terminología adecuada.</items><items id="description">Nombre del medicamento, vacuna u otro elemento terapéutico/prescribible foco de la actividad.</items><items id="text">Medicamento</items></items><items code="at0021"><items id="comment">Por ejemplo: "Aplazado - Paciente no disponible en el momento de la administración", "Cancelado - Reacción adversa". Nota: No se trata del motivo de la instrucción de medicación, sino de la razón específica por la que se llevó a cabo un paso asistencial, y a menudo se utilizará para documentar alguna desviación de la orden original.</items><items id="description">Motivo por el que se llevó a cabo la fase de la ruta para el medicamento identificado.</items><items id="text">Motivo</items></items><items code="at0024"><items id="comment">Por ejemplo: "El paciente estaba en el servicio de radiología", "Inyección accidental en un vaso sanguíneo durante la administración de IM".</items><items id="description">Información adicional sobre la actividad o fase del proceso no recogida en otros campos, incluidos los detalles de cualquier variación entre la acción prevista y la acción realmente realizada.</items><items id="text">Comentarios</items></items><items code="at0025"><items id="comment">Por ejemplo: Número de secuencia de la vacuna.</items><items id="description">La secuencia numérica específica de la fase del proceso que se está registrando.</items><items id="text">Secuencia numérica</items></items><items code="at0030"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0033"><items id="comment">Por ejemplo: "Evitar el pomelo", "Tomar al menos 2 horas antes de acostarse", "Tomar con comida". Puede codificarse con una terminología cuando sea clínicamente apropiado.</items><items id="description">Cualquier orientación, instrucción o consejo que se haya dado al sujeto de asistencia o al cuidador personal en el momento de la fase del proceso.</items><items id="text">Orientación al paciente</items></items><items code="at0039"><items id="description">Fue necesario introducir un cambio importante en la orden, lo que obligó a interrumpirlo e iniciar una orden de reemplazo.</items><items id="text">Cambio importante en la orden médica</items></items><items code="at0041"><items id="description">La orden de medicación se ha modificado de manera que no requiere emitir una nueva instrucción/orden, de acuerdo con las normas clínicas locales.</items><items id="text">Cambio menor en la orden</items></items><items code="at0043"><items id="comment">Se utiliza para comparar la desviación del tiempo de acción real cuando no se puede calcular fácilmente a partir de la instrucción original.</items><items id="description">La fecha en la que estaba programada la acción de medicación.</items><items id="text">Fecha/hora programada original</items></items><items code="at0044"><items id="description">Se ha retrasado la administración de una dosis del medicamento, pero se espera que se administre lo antes posible.</items><items id="text">Administración de dosis aplazada</items></items><items code="at0053"><items id="description">Detalles más estructurados de la acción, posiblemente específicos de una etapa del proceso.</items><items id="text">Detalles adicionales</items></items><items code="at0085"><items id="comment">Por ejemplo: requisitos de información local o metadatos adicionales para alinearse con los equivalentes de FHIR o CIMI.</items><items id="description">Información adicional necesaria para registrar el contenido local o para alinearse con otros modelos/formalismos de referencia.</items><items id="text">Ampliación</items></items><items code="at0103"><items id="comment">Este elemento de datos permite definir múltiples ocurrencias de forma más explícita en tiempo de ejecución, si es necesario.</items><items id="description">Identificador único de la orden de medicación.</items><items id="text">ID de la orden</items></items><items code="at0104"><items id="comment">Utilice este SLOT donde se requiera una descripción detallada del producto dispensado, autorizado o administrado de forma explícita. Por ejemplo: la forma, concentración, diluyentes o mezcla de ingredientes, entre otros detalles.</items><items id="description">Detalles estructurados sobre el medicamento, incluida la concentración, la forma y las sustancias que lo componen.</items><items id="text">Detalles del medicamento</items></items><items code="at0106"><items id="description">La orden de medicación original ha sido reautorizada para permitir la repetición de la prescripción o dispensación. En algunas jurisdicciones, en estas circunstancias debe emitirse una orden completamente nueva.</items><items id="text">Prescripción reautorizada</items></items><items code="at0109"><items id="description">La medicación ha sido recomendada, pero no se han tomado medidas para iniciar la prescripción.</items><items id="text">Medicación recomendada</items></items><items code="at0131"><items id="comment">CLUSTER.dosage está pensado para llevar detalles de cambios en la orden de medicación o administraciones de dosis, mientras que CLUSTER.medication_supply_amount está pensado para detalles de actividad relacionada con la dispensación.</items><items id="description">Detalles específicos sobre la cantidad de medicamento.</items><items id="text">Cantidad</items></items><items code="at0132"><items id="comment">En muchas jurisdicciones, se permite la sustitución de un artículo solicitado como forma genérica o con una marca diferente, que se haya determinado como bioequivalente, en el punto de dispensación o suministro. En otros casos, la sustitución se da por supuesta y el médico debe solicitar explícitamente que no se sustituya.</items><items id="description">Medidas de sustitución adoptadas por la persona que administra o dispensa el medicamento.</items><items id="text">Sustitución</items></items><items code="at0133"><items id="comment">Por ejemplo: "La alternativa genérica contiene una sustancia que el paciente no tolera". Puede codificarse con una terminología cuando sea clínicamente apropiado.</items><items id="description">Motivo o justificación de la medida de sustitución adoptada.</items><items id="text">Motivo de la sustitución</items></items><items code="at0138"><items id="description">Se sustituyó por un medicamento bioequivalente al solicitado.</items><items id="text">Sustitución realizada</items></items><items code="at0139"><items id="description">Aunque la orden de medicación lo permitía, no se sustituyó por un medicamento bioequivalente.</items><items id="text">Sustitución no realizada</items></items><items code="at0140"><items id="description">Datos sobre la localización corporal y la administración de la medicación.</items><items id="text">Detalles de la administración</items></items><items code="at0141"><items id="comment">Por ejemplo: "brazo izquierdo", "catéter intravenoso mano derecha". &#13;
Siempre que sea posible, es preferible codificar el lugar del cuerpo con una terminología.</items><items id="description">Descripción estructurada del lugar de administración del producto solicitado.</items><items id="text">Zona corporal</items></items><items code="at0142"><items id="comment">Por ejemplo: "En la superficie cutánea medial del antebrazo izquierdo, de 10 cm a 20 cm distalmente desde la punta del codo".</items><items id="description">Descripción estructurada del lugar de administración del medicamento, vacuna o bien terapéutico.</items><items id="text">Zona corporal estructurada</items></items><items code="at0143"><items id="comment">Por ejemplo: 'mediante inyección de vía Z'; 'a través de nebulizador'. Es preferible codificar el método con una terminología, siempre que sea posible.</items><items id="description">La técnica o el dispositivo mediante el cual se administró o se administrará el artículo solicitado.</items><items id="text">Método de administración</items></items><items code="at0144"><items id="description">Detalles del dispositivo médico utilizado para ayudar a la administración de la medicación.</items><items id="text">Dispositivo de administración</items></items><items code="at0145"><items id="description">Se ha preparado una receta provisional y está pendiente de confirmación por parte de un clínico autorizado. Puede ser utilizada cuando se realicen reautorizaciones de forma conjunta. Este careflow_step puede tener un estado de "planificado" o "activo", reflejando la necesidad de manejar tanto órdenes nuevas como órdenes reautorizadas.</items><items id="text">Prescripción pendiente de autorización</items></items><items code="at0147"><items id="comment">Por ejemplo: "oral", "intravenosa" o "tópica". Es preferible codificar la vía con una terminología, siempre que sea posible. Pueden especificarse múltiples vías potenciales.</items><items id="description">La vía por la que se ha administrado o se va a administrar el producto solicitado al cuerpo del sujeto.</items><items id="text">Vía de administración</items></items><items code="at0148"><items id="comment">*For example: preparation of an intravenous mixture. (en)</items><items id="description">*The medication has been physically prepared. (en)</items><items id="text">Medicación preparada</items></items><items code="at0149"><items id="comment">Los datos de la persona que realiza el doble control pueden figurar en el elemento "Participación" del Modelo de Referencia.</items><items id="description">La fase del proceso ha sido comprobada por otra persona.</items><items id="text">¿Doble comprobación?</items></items><items code="at0150"><items id="description">La receta fue anulada antes de ser emitida.</items><items id="text">Prescripción anulada</items></items><items code="at0151"><items id="description">La receta ha sido invalidada o ha caducado sin ser cumplida.</items><items id="text">Prescripción no válida o caducada</items></items><items code="at0152"><items id="description">La prescripción ha sido cumplida con éxito.</items><items id="text">Prescripción cumplida</items></items><items code="at0153"><items id="description">Se ha autorizado formalmente el uso del medicamento.</items><items id="text">Medicación autorizada</items></items><items code="at0154"><items id="comment">Por ejemplo: 29/10/2017</items><items id="description">La fecha/hora en la que el curso de medicación está programado para reiniciarse, según la fase del proceso "Administración suspendida".</items><items id="text">Fecha/hora de reinicio</items></items><items code="at0155"><items id="comment">Por ejemplo: "El día 2 después de la operación".</items><items id="description">El criterio que desencadena el reinicio del curso de medicación, según la fase del proceso "Administración suspendida".</items><items id="text">Criterio de reinicio</items></items><items code="at0156"><items id="comment">Por ejemplo: "Angina" o "Dolor". Siempre que sea posible, se prefiere codificar la indicación con una terminología. Este dato permite múltiples ocurrencias. Si sólo se utiliza una ACTION para registrar una indicación de medicación, este elemento de datos puede utilizarse sin consideración adicional. Sin embargo, si se registra una indicación clínica tanto para la INSTRUCTION de orden de medicación como para esta ACTION de gestión de la medicación, tenga en cuenta que estas indicaciones podrían no ser coherentes.</items><items id="description">Motivo clínico de la actividad medicamentosa.</items><items id="text">Indicación clínica</items></items><items code="at0157"><items id="description">*The prepared medication has been double checked. (en)</items><items id="text">*Medication double checked (en)</items></items><items code="at0158"><items id="description">*An administration of a dose of the medication was started but was subsequently aborted. (en)</items><items id="text">*Dose administration aborted (en)</items></items></term_definitions><term_definitions language="es-ar"><items code="at0000"><items id="comment">*This is not limited to activities performed based on medication orders from clinicians, but could also include for example taking over the counter medication.(en)</items><items id="description">*Any activity related to the planning, scheduling, prescription management, dispensing, administration, cessation and other use of a medication, vaccine, nutritional product or other therapeutic item.(en)</items><items id="text">*Medication management(en)</items></items><items code="at0002"><items id="description">*A prescription has been issued for the medication.(en)</items><items id="text">*Prescription issued(en)</items></items><items code="at0003"><items id="description">*The ordered medication has been dispensed, for example from a pharmacy to the patient.(en)</items><items id="text">*Prescription dispensed(en)</items></items><items code="at0004"><items id="description">*The medication has been taken by, or administered to, the patient for the first time. Although in some settings this significant date may be computable as the first of several administrations, in other settings, such as primary care, specific administration dates are not readily available.(en)</items><items id="text">*Medication course commenced(en)</items></items><items code="at0005"><items id="description">*The specific medication item has been reviewed, as planned. This is not intended to capture review of the whole medication list.(en)</items><items id="text">*Medication course reviewed(en)</items></items><items code="at0006"><items id="description">*A single administration of the medication has taken place.(en)</items><items id="text">*Dose administered(en)</items></items><items code="at0007"><items id="description">*The medication course has been completed as planned.(en)</items><items id="text">*Medication course completed(en)</items></items><items code="at0008"><items id="description">*The prescription has not been dispensed due to a technical or pharamaceutical supply issue.(en)</items><items id="text">*Prescription supply delayed(en)</items></items><items code="at0009"><items id="description">*The administration of the medication has been suspended until further notice. No further doses should be given until the restart date or conditions have been met. When setting the date/conditions for restart after suspending, a step from ‘Administrations suspended’ and back to 'Medication start date/condition set' should be performed.(en)</items><items id="text">*Administrations suspended(en)</items></items><items code="at0010"><items id="description">*A prescription token has been re-issued for an existing medication order.(en)</items><items id="text">*Prescription re-issued(en)</items></items><items code="at0011"><items id="description">*Reissuing of this prescription is not available without some intervention.(en)</items><items id="text">*Prescription re-issue suspended(en)</items></items><items code="at0012"><items id="description">*The planned course of medication has been cancelled prior to any administration.(en)</items><items id="text">*Medication course cancelled(en)</items></items><items code="at0013"><items id="description">*The scheduled medication course has been postponed prior to any administration.(en)</items><items id="text">*Medication course postponed(en)</items></items><items code="at0015"><items id="description">*The administration of this medication has been ceased after the first dose has been administered, but before intended completion of the course.  (en)</items><items id="text">*Medication course stopped(en)</items></items><items code="at0016"><items id="description">*The time to start this medication, or other starting condition, has been set.(en)</items><items id="text">*Medication start date/condition set(en)</items></items><items code="at0017"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0018"><items id="description">*The administration of a medication has been withheld and not given. There is no expectation that it will be given later, though the next dose (if any) should be administered according to the original order.(en)</items><items id="text">*Dose administration omitted(en)</items></items><items code="at0020"><items id="comment">*For example: 'Atenolol 100mg' or 'Tenormin tablets 100mg'. &#13;
It is strongly recommended that the 'Medication item' is coded with a terminology capable of triggering decision support, where possible. The extent of coding may vary from the simple name of the medication item through to structured details about the actual medication pack used. Free text entry should only be used if there is no appropriate terminology available.(en)</items><items id="description">*Name of the medication, vaccine or other therapeutic/prescribable item which was the focus of the activity.(en)</items><items id="text">*Medication item(en)</items></items><items code="at0021"><items id="comment">*For example: 'Postponed - Patient not avalable at administration time', 'Cancelled - Adverse reaction'. Note: This is not the reason for the medication instruction, but rather the specific reason that a care step was carried out, and will often be used to document some variance from the original order.(en)</items><items id="description">*Reason that the pathway step for the identified medication was carried out.(en)</items><items id="text">*Reason(en)</items></items><items code="at0024"><items id="comment">*For example: 'Patient was in radiology department', 'Accidental injection into blood vessel during IM administration'.(en)</items><items id="description">*Additional narrative about the activity or care pathway step not captured in other fields, including details of any variance between the intended action and the action actually performed.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="comment">*For example: Vaccine sequence number. (en)</items><items id="description">*The sequence number specific to the activity being recorded.(en)</items><items id="text">*Sequence number(en)</items></items><items code="at0030"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0033"><items id="comment">*For example: 'Avoid grapefruit' , 'Take at least 2 hours before bedtime', 'Take with food'. May be coded with a terminology when clinically appropriate.(en)</items><items id="description">*Any guidance, instructions or advice given to the subject of care or personal carer at the time of the pathway step.(en)</items><items id="text">*Patient guidance(en)</items></items><items code="at0039"><items id="description">*A major change to the order was required, resulting in this order being stopped and a replacement order being started.(en)</items><items id="text">*Major change to order.(en)</items></items><items code="at0041"><items id="description">*The medication order has been changed in a manner which does not require a new instruction/order to be issued, according to local clinical rules.(en)</items><items id="text">*Minor change to order(en)</items></items><items code="at0043"><items id="comment">*Used to compare variance from actual action time where this is not readily calculable from the original instruction.(en)</items><items id="description">*The datetime at which the medication action was scheduled to occur.(en)</items><items id="text">*Original scheduled date/time(en)</items></items><items code="at0044"><items id="description">*Administration of a dose of mediciation has been delayed but is expected to be given as soon as possible.(en)</items><items id="text">*Dose administration deferred(en)</items></items><items code="at0053"><items id="description">*Further structured details of the action, possibly specific to a pathway step.(en)</items><items id="text">*Additional details(en)</items></items><items code="at0085"><items id="description">**(en)</items><items id="text">*Cluster(en)</items></items><items code="at0103"><items id="comment">*Comment: This data element allows for multiple occurrences to be defined more explicitly at run-time, if required.(en)</items><items id="description">*Unique identifier for the medication order.(en)</items><items id="text">*Order ID(en)</items></items><items code="at0104"><items id="comment">*Use this SLOT where the detailed description of the dispensed, authorised or administered item needs to be explicitly stated. For example: the form, strength, any diluents or mixture of ingredients.(en)</items><items id="description">*Structured details about the medication including strength, form and constituent substances.(en)</items><items id="text">*Medication details(en)</items></items><items code="at0106"><items id="description">*The original medication order has been re-authorised to allow repeat prescription or dispensing. In some jurisdictions an entirely new order must be issued in these circumstances.(en)</items><items id="text">*Prescription re-authorised(en)</items></items><items code="at0109"><items id="description">*The medication has been recommended but no steps have been taken to initiate prescribing.(en)</items><items id="text">*Medication recommended(en)</items></items><items code="at0131"><items id="comment">*Dosage_administration is intended to carry details of medication order changes or dose administrations, whilst medication_supply_amount is intended for details of dispensing-related activity.(en)</items><items id="description">*Specific details about the amount of the medication item.(en)</items><items id="text">*Amount(en)</items></items><items code="at0132"><items id="comment">*In many jurisdictions, substitution of an ordered item as a generic form or with a different brand name, which has been determined as bioequivalent, is allowed at the point of dispense or supply. In other cases substitution is assumed and the clinician has to explicitly request non-substitution.(en)</items><items id="description">*Subsitution action taken by the person administering or dispensing the drug.(en)</items><items id="text">*Substitution(en)</items></items><items code="at0133"><items id="comment">*For example: "Generic alternative contains a substance that is not tolerated by the patient." May be coded with a terminology when clinically appropriate(en)</items><items id="description">*The reason or justification for the substitution action taken.(en)</items><items id="text">*Substitution reason(en)</items></items><items code="at0138"><items id="description">*A medication was substituted which is bioequivalent to that ordered.(en)</items><items id="text">*Substitution performed(en)</items></items><items code="at0139"><items id="description">*Although allowed by the medication order a bioequvalent medication was not substituted.(en)</items><items id="text">*Substitution not performed(en)</items></items><items code="at0140"><items id="description">*Details of body site and administration of the medication.(en)</items><items id="text">*Administration details(en)</items></items><items code="at0141"><items id="comment">*For example: 'left upper arm', 'intravenous catheter right hand'. &#13;
Coding of the body site with a terminology is preferred, where possible.(en)</items><items id="description">*Structured description of the site of administration of the ordered item.(en)</items><items id="text">*Body site(en)</items></items><items code="at0142"><items id="comment">*For example: "On the medial skin surface of the left forearm, from 10 cm to 20 cm distally from the point of the elbow".(en)</items><items id="description">*Structured description of the site of administration of the medication, vaccine or therapeutic good.(en)</items><items id="text">*Structured body site(en)</items></items><items code="at0143"><items id="comment">*Comment: For example: ' via Z-track injection'; 'via nebuliser'. Coding of the method with a terminology is preferred, where possible.(en)</items><items id="description">*The technique or device by which the ordered item was, or is to be, administered.(en)</items><items id="text">*Administration method(en)</items></items><items code="at0144"><items id="description">*Details of the medical device used to assist administration of the medication.(en)</items><items id="text">*Administration device(en)</items></items><items code="at0145"><items id="description">*Draft prescription has been prepared and is awaiting confirmation from an authorised clinician. May be used where reauthorisations are performed as a batch. This careflow_step may have a status of 'planned' or 'active', reflecting the need to to handle new orders as well as re-authorised orders.(en)</items><items id="text">*Prescription awaiting authorisation(en)</items></items><items code="at0147"><items id="comment">*Comment: For example: 'oral', 'intravenous', or 'topical'. Coding of the route with a terminology is preferred, where possible. Multiple potential routes may be specified.(en)</items><items id="description">*The route by which the ordered item was, or is to be, administered into the subject's body.(en)</items><items id="text">*Route(en)</items></items><items code="at0148"><items id="comment">*For example: preparation of an intravenous mixture. (en)</items><items id="description">*The medication has been physically prepared. (en)</items><items id="text">*Medication prepared(en)</items></items><items code="at0149"><items id="comment">*Details of the individual performing the double-check can be carried in the Reference Model element "Participation".(en)</items><items id="description">*The action step has been checked by a separate individual.(en)</items><items id="text">*Double-checked?(en)</items></items><items code="at0150"><items id="description">*The prescription was cancelled prior to being issued.(en)</items><items id="text">*Prescription cancelled(en)</items></items><items code="at0151"><items id="description">*Prescription has been invalidated or has expired without being fulfilled.(en)</items><items id="text">*Prescription invalid or expired(en)</items></items><items code="at0152"><items id="description">*The prescription has been fulfilled successfully.(en)</items><items id="text">*Prescription fulfilled(en)</items></items><items code="at0153"><items id="description">*The medication has been formally authorised for use.(en)</items><items id="text">*Medication authorised(en)</items></items><items code="at0154"><items id="comment">*For example: 2017-10-29(en)</items><items id="description">*The date/time on which the medication course is set to restart, as per the "Medication restart date/condition set" pathway step.(en)</items><items id="text">*Restart date/time(en)</items></items><items code="at0155"><items id="comment">*For example: "On day 2 after surgery".(en)</items><items id="description">*The criterion which triggers the medication course to restart, as per the "Medication restart date/condition set" pathway step.(en)</items><items id="text">*Restart criterion(en)</items></items><items code="at0156"><items id="comment">*For example: 'Angina' or 'Pain'. Coding of the indication with a terminology is preferred, where possible. This data element allows multiple occurrences. If only an ACTION is used to record a medication indication, this data element can be used without additional consideration. However, if a clinical indication is recorded for both the Medication order INSTRUCTION and this Medication management ACTION, be aware that these indications might not be consistent." (en)</items><items id="description">*The clinical reason for the medication activity. (en)</items><items id="text">*Clinical indication (en)</items></items><items code="at0157"><items id="description">*The prepared medication has been double checked. (en)</items><items id="text">*Medication double checked (en)</items></items><items code="at0158"><items id="description">*An administration of a dose of the medication was started but was subsequently aborted. (en)</items><items id="text">*Dose administration aborted (en)</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="comment">Dette er ikke begrenset til aktiviteter utført på bagrunn av legemiddelordineringer fra klinikere, men kan også omfatte å ta legemidler som ikke er reseptpliktige.</items><items id="description">Detaljer om enhver legemiddelrelatert oppgave som utføres fra et legemiddel er ordinert eller rekvirert til det er utdelt eller eventuelt kassert, for eksempel bestilling, istandgjøring, administrering, ekspedering eller seponering.</items><items id="text">Legemiddelhåndtering</items></items><items code="at0002"><items id="description">Det er utstedt en resept for legemiddelet.</items><items id="text">Resept utstedt</items></items><items code="at0003"><items id="description">Legemiddelet er utdelt, for eksempel fra et apotek til pasienten.</items><items id="text">Resept ekspedert</items></items><items code="at0004"><items id="description">Legemiddelet er inntatt av eller administrert til pasienten for første gang. Selv om dette i noen bruksområder som f.eks. sykehus kan utledes fra den første av en rekke administreringer, må det i andre bruksområder som f.eks. allmennpraksis spesifiseres spesifikt siden administreringer ikke dokumenteres på samme måte.</items><items id="text">Medisinering startet</items></items><items code="at0005"><items id="description">Legemiddelet er revurdert, for eksempel for hvorvidt det fortsatt skal tas. Dette er ikke ment å omfatte gjennomgang av en legemiddelliste.</items><items id="text">Legemiddel revurdert</items></items><items code="at0006"><items id="description">En enkelt administrering av legemiddelet er utført.</items><items id="text">Legemiddel administrert</items></items><items code="at0007"><items id="description">Medisineringen er fullført som ordinert.</items><items id="text">Medisinering fullført</items></items><items code="at0008"><items id="description">Legemiddelet er ikke utdelt fordi det ikke er på lager enda.</items><items id="text">Forsinket levering</items></items><items code="at0009"><items id="description">Administrering av legemiddelet er satt på vent inntil videre, ordinasjonen er "nullet". Ingen ytterligere doser gis før kriterium eller dato for å sette medisineringen i gang igjen er møtt. Når dato eller kriterium for å ny oppstart settes, bør det gjøres et 'suspend_step' tilbake til "Oppstartsdato satt".</items><items id="text">Administrering satt på vent</items></items><items code="at0010"><items id="description">Legemiddelet har fått en fornyet resept for den eksisterende ordineringen.</items><items id="text">Resept fornyet</items></items><items code="at0011"><items id="description">Utstedelse av resept avventer reautorisering av en kliniker. I noen myndighetsområder kan ikke resepter reautoriseres, og det må i disse tilfellene utstedes en helt ny resept.</items><items id="text">Reautorisering av resept satt på vent</items></items><items code="at0012"><items id="description">Den planlagte medisineringen er avbrutt før den første dosen er administrert.</items><items id="text">Planlagt medisinering avbrutt</items></items><items code="at0013"><items id="description">Den planlagte medisineringen er satt på vent før den første dosen er administrert.</items><items id="text">Planlagt medisinering satt på vent</items></items><items code="at0015"><items id="description">Legemiddelet er seponert etter at første dose er administrert, men før planlagt fullførelse av ordineringen.</items><items id="text">Legemiddel seponert</items></items><items code="at0016"><items id="description">Tidspunktet eller vilkår for å starte medisineringen er satt.</items><items id="text">Oppstartsdato satt</items></items><items code="at0017"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0018"><items id="description">En enkeltdose er holdt tilbake og ikke administrert ("nullet"). Det er ingen forventing om at den aktuelle dosen skal gis på et senere tidspunkt, men neste dose administreres i henhold til ordineringen.</items><items id="text">Enkeltdose ikke administrert</items></items><items code="at0020"><items id="comment">For eksempel: 'Atenolol 100mg' eller 'Tenormin 100mg tabletter'. Det anbefales sterkt at "Legemiddel" kodes med en terminologi som understøtter beslutningsstøtte der dette er mulig, f.eks. FEST. Nivå av koding kan variere fra legemiddelnavn til strukturerte detaljer om den aktuelle legemiddelforpakningen som skal brukes. Fritekst bør bare brukes om ingen passende terminologi er tilgjengelig.</items><items id="description">Navnet på legemiddelet, vaksinen eller det medisinske forbruksmateriellet som var fokus for aktiviteten.</items><items id="text">Legemiddel</items></items><items code="at0021"><items id="comment">For eksempel: Dersom administrering er utsatt pga pasienten ikke er tilgjengelig, velges prosesstrinnet "Utsatt administrering", og "Pasienten er ikke tilgjengelig ved administreringstidspunktet" dokumenteres i dette elementet. Dersom legemiddelet seponeres pga legemiddelreaksjon, velges prosesstrinnet "Seponert", og "Legemiddelreaksjon" dokumenteres i dette elementet. NB: Dette er ikke årsaken til legemiddelordineringen, men de spesifikke årsakene til at det aktuelle prosesstrinnet ble utført. Dette vil som regel brukes for å dokumentere varians fra den opprinnelige ordineringen.</items><items id="description">Årsak til at det aktuelle prosesstrinnet ble utført.</items><items id="text">Årsak</items></items><items code="at0024"><items id="comment">For eksempel "Pasienten var på røntgenavdelingen" eller "Utilsiktet intravenøs injeksjon under intramuskulær administrering".</items><items id="description">Ytterligere fritekstdetaljer om aktiviteten eller prosesstrinnet som ikke representeres i andre elementer, inkludert detaljer om varians mellom den planlagte handlingen og handlingen som faktisk ble utført.</items><items id="text">Kommentar</items></items><items code="at0025"><items id="comment">For eksempel: En vaksines sekvensnummer/ nummer i en rekkefølge.</items><items id="description">Sekvensnummeret for den spesifikke handlingen som blir registrert.</items><items id="text">Sekvensnummer</items></items><items code="at0030"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0033"><items id="comment">For eksempel "unngå grapefrukt", "ta minst 2 timer før sengetid" eller "ta med mat". Kan kodes med en terminologi der det er klinisk passende.</items><items id="description">Enhver instruksjon som gis til pasienten eller en omsorgsperson når prosesstrinnet utføres.</items><items id="text">Pasientinstruksjoner</items></items><items code="at0039"><items id="description">Det er utført en større endring i ordineringen, denne ordineringen er stoppet og en ny ordinering er igangsatt.</items><items id="text">Omfattende endring av ordinering</items></items><items code="at0041"><items id="description">Legemiddelordineringen er endret på en slik måte at det etter lokale retningslinjer ikke er behov for en ny ordinering. For eksempel endring av produkt fra tabletter til kapsler.</items><items id="text">Mindre endring av ordinering</items></items><items code="at0043"><items id="comment">Brukes til å sammenligne varians fra faktisk tidspunkt for en aktivitet, der dette ikke er mulig å beregne ut fra den opprinnelige ordineringen.</items><items id="description">Dato/tid for når legemiddelaktiviteten var planlagt å skulle skje.</items><items id="text">Opprinnelig planlagt tid</items></items><items code="at0044"><items id="description">Administrering av legemiddelet er utsatt/forsinket, men legemiddelet forventes administrert så raskt som mulig.</items><items id="text">Administrering utsatt</items></items><items code="at0053"><items id="description">Ytterligere strukturerte detaljer om handlingen, for eksempel spesifikk informasjon for det aktuelle prosesstrinnet.</items><items id="text">Ytterligere detaljer</items></items><items code="at0085"><items id="comment">F.eks. lokale informasjonskrav eller ekstra metadata for å samsvare med FHIR eller CIMI ekvivalenter.</items><items id="description">Ytterligere informasjon som er nødvendig for å sammenstille med andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at0103"><items id="comment">Dette dataelementet tillater flere forekomster som kan defineres mer eksplisitt ved behov.</items><items id="description">Identifikatoren for den opprinnelige ordineringen.</items><items id="text">OrdineringsID</items></items><items code="at0104"><items id="comment">Bruk dette SLOTet til å spesifisere en detaljert beskrivelse av det bestilte, istandgjorte, administrerte, ekspederte eller seponerte produktet. For eksempel form, styrke, fortynningsmiddel eller blandinger av ingredienser.</items><items id="description">Strukturerte detaljer om legemiddelet, blant annet styrke, form og virkestoffene det består av.</items><items id="text">Legemiddeldetaljer</items></items><items code="at0106"><items id="description">En repeterende resept har blitt reautorisert. I noen myndighetsområder må det i disse tilfellene utstedes en helt ny resept.</items><items id="text">Resept reautorisert</items></items><items code="at0109"><items id="description">Medisineringen er anbefalt, men ordinering er ikke iverksatt.</items><items id="text">Anbefalt medisinering</items></items><items code="at0131"><items id="comment">Arketypen CLUSTER.dosage er ment å inneholde detaljer om endringer i legemiddelordinering eller i administrert dose, mens CLUSTER.medication_supply_amount er ment for detaljer rundt ekspedering.</items><items id="description">Spesifikke detaljer om mengden legemiddel.</items><items id="text">Mengde</items></items><items code="at0132"><items id="comment">I mange myndighetsområder er generisk bytte av et ordinert produkt mot et bioekvivalent produkt fra en annen produsent tillatt. I andre områder er bytte forutsatt, og ordinerende kliniker må eksplisitt avslå bytte.</items><items id="description">Generisk bytte utført ved administrering eller ekspedering.</items><items id="text">Generisk bytte</items></items><items code="at0133"><items id="comment">For eksempel "Generiske alternativer inneholder et hjelpestoff som ikke tolereres av pasienten". Kan kodes med en terminologi der det er klinisk passende.</items><items id="description">Årsak eller begrunnelse for at generisk bytte er utført eller ikke utført.</items><items id="text">Årsak for bytte/ikke bytte</items></items><items code="at0138"><items id="description">Det ordinerte produktet ble byttet til et bioekvivalent produkt.</items><items id="text">Generisk bytte utført</items></items><items code="at0139"><items id="description">Det ordinerte produktet ble ikke byttet til et bioekvivalent produkt, til tross for at dette var tillatt i ordineringen.</items><items id="text">Generisk bytte ikke utført</items></items><items code="at0140"><items id="description">Detaljer om administrering av legemiddelet.</items><items id="text">Administreringsdetaljer</items></items><items code="at0141"><items id="comment">For eksempel "venstre overarm", "intravenøst kateter høyre hånd". Det bør om mulig benyttes terminologi, f.eks. SNOMED CT eller EDQM standardtermer, for å kode anatomisk lokalisering.</items><items id="description">Strukturert beskrivelse av hvor i kroppen det ordinerte produktet skal administreres eller ble administrert.</items><items id="text">Anatomisk lokalisering</items></items><items code="at0142"><items id="comment">For eksempel "på hudoverflaten medialt på venstre underarm, fra 10 cm til 20 cm distalt fra albuspissen".</items><items id="description">Strukturert beskrivelse av administreringsstedet for legemiddelet eller vaksinen.</items><items id="text">Strukturert anatomisk lokalisering</items></items><items code="at0143"><items id="comment">For eksempel "via Z-trackinjeksjon", "via forstøver". Koding av administreringsmetoden med en terminologi er anbefalt, der det er mulig.</items><items id="description">Metoden legemiddelet ble administrert eller skal administreres ved.</items><items id="text">Administreringsmetode</items></items><items code="at0144"><items id="description">Detaljer om utstyret som ble brukt for å administrere legemiddelet.</items><items id="text">Administreringsutstyr</items></items><items code="at0145"><items id="description">Det er forberedt et utkast for en resept, og denne avventer godkjenning av en autorisert kliniker. Kan brukes der reseptutstedelse utføres satsvis. Dette prosesstrinnet kan brukes enten med status "planned" eller "active", for å underbygge behovet for å håndtere både nye og reautoriserte ordinasjoner.</items><items id="text">Resept avventer autorisering</items></items><items code="at0147"><items id="comment">For eksempel "oral bruk", "intravenøst" eller "på huden". Det bør om mulig benyttes terminologi, f.eks. FEST, for å angi administreringsvei. Det kan spesifiseres flere mulige administreringsveier.</items><items id="description">Administreringsveien som skal eller ble brukt for legemiddelet.</items><items id="text">Administreringsvei</items></items><items code="at0148"><items id="comment">For eksempel istandgjøring av en intravenøs blanding.</items><items id="description">Legemiddelet er fysisk istandgjort</items><items id="text">Legemiddel istandgjort</items></items><items code="at0149"><items id="comment">Detaljer om individet som utfører dobbeltkontrollen kan registreres som "Participation" i referansemodellen.</items><items id="description">Prosesstrinnet har blitt kontrollert av en annen person enn den som primært utfører det.</items><items id="text">Dobbeltkontrollert?</items></items><items code="at0150"><items id="description">Resepten ble avbrutt før den ble utstedt.</items><items id="text">Resept avbrutt</items></items><items code="at0151"><items id="description">Resepten er ugyldiggjort eller har utgått før den er ferdig ekspedert.</items><items id="text">Resept ugyldig eller utgått</items></items><items code="at0152"><items id="description">Resepten er ferdig ekspedert.</items><items id="text">Resept ferdig ekspedert</items></items><items code="at0153"><items id="description">Legemiddelet er formelt autorisert for bruk.</items><items id="text">Legemiddel autorisert</items></items><items code="at0154"><items id="comment">For eksempel "2017-10-29".</items><items id="description">Datoen eller tidspunktet når medisineringen skal startes opp igjen, i sammenheng med prosesstrinnet "Vilkår satt for å sette medisineringen i gang igjen".</items><items id="text">Dato/tid for ny oppstart</items></items><items code="at0155"><items id="comment">For eksempel "på dag 2 etter kirurgi".</items><items id="description">Kriterium for når medisineringen skal startes opp igjen, i sammenheng med prosesstrinnet "Vilkår satt for å sette medisineringen i gang igjen".</items><items id="text">Kriterium for ny oppstart</items></items><items code="at0156"><items id="comment">For eksempel: "Angina" eller "Smerte". Koding av indikasjonen med en terminologi er foretrukket, om mulig. Dette dataelementet er repeterbart. &#13;
&#13;
Dersom bare denne arketypen blir brukt for å dokumentere legemiddeladministeringen, kan dette dataelementet brukes uten å tenke noe mer på det. Men dersom "Klinisk indikasjon" er registrert i både Legemiddelordinering (INSTRUCTION.medication_order) og denne Legemiddelhåndtering (ACTION.medication), må man være oppmerksom på at det kan være forskjell i registrert indikasjonen.&#13;
</items><items id="description">Den kliniske årsaken til legemiddeladministrasjonen.</items><items id="text">Klinisk indikasjon</items></items><items code="at0157"><items id="description">Det istandgjorte legemiddelet har blitt dobbeltkontrollert.</items><items id="text">Legemiddel dobbeltkontrollert</items></items><items code="at0158"><items id="description">Administrering av en enkeltdose av legemiddelet ble påbegynt men deretter avbrutt.</items><items id="text">Administrering avbrutt</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="comment">Este não é limitado a atividades realizadas sobre solicitação de medicação de clínicos, mas também inclui por exemplo a adquisição de medicamentos de venda livre.</items><items id="description">Qualquer atividade relacionada ao planejamento, agendamento, gestão da prescrição, dispensação, administração, término e outro uso de um medicamento, vacina, produto nutricional ou outro item terapêutico.</items><items id="text">Gestão de medicação</items></items><items code="at0002"><items id="description">Uma prescrição foi emitida para a medicação.</items><items id="text">Prescrição emitida</items></items><items code="at0003"><items id="description">Uma prescrição de medicação foi aviada, por exemplo de uma farmácia ao paciente.</items><items id="text">Prescrição aviada</items></items><items code="at0004"><items id="description">A medicação foi adquirida, ou administrada, ao paciente pela primeira vez. Embora em algumas situações esta data significativa pode ser computada como a primeira de muitas administrações, em outras, como na atenção primária, datas de administração específicas não estão prontamente disponíveis. &#13;
</items><items id="text">Curso da medicação iniciado</items></items><items code="at0005"><items id="description">O item de medicação específico foi revisado, conforme planejado. Este não pretende capturar uma revisão da lista completa de medicação.</items><items id="text">Curso da medicação revisado</items></items><items code="at0006"><items id="description">Dose do medicamento foi administrada.</items><items id="text">Dose administrada</items></items><items code="at0007"><items id="description">O tratamento medicamentoso foi finalizado conforme previsto.</items><items id="text">Final do tratamento medicamentoso</items></items><items code="at0008"><items id="description">A prescrição não foi aviada devido a um problema técnico ou de suprimento farmacêutico.</items><items id="text">Suprimento da prescrição atrasado</items></items><items code="at0009"><items id="description">A administração do medicamento foi suspensa até nova ordem. Doses adicionais não devem ser administradas até que a data de reinício ou condições forem alcançadas. Na configuração de nova data/condições para reinício após a suspensão, deve-se realizar a etapa de suspensão de Administrações suspensas e voltar a Data do início/ Condição de início.</items><items id="text">Administração suspensa</items></items><items code="at0010"><items id="description">Nova liberação de prescrição já existente.</items><items id="text">Nova liberação de prescrição</items></items><items code="at0011"><items id="description">Reemissão da prescrição não está disponível sem alguma intervenção.</items><items id="text">Reemissão da prescrição suspensa</items></items><items code="at0012"><items id="description">O curso planejado da medicação foi cancelado antes de qualquer administração.</items><items id="text">Curso da medicação cancelado</items></items><items code="at0013"><items id="description">O curso planejado da medicação foi adiado antes de qualquer administração.</items><items id="text">Curso da medicação adiado</items></items><items code="at0015"><items id="description">A administração desta medicação foi interrompida após administração da primeira dose, mas antes de completar o curso pretendido.</items><items id="text">Curso da medicação interrompido</items></items><items code="at0016"><items id="description">A hora de começar a medicação, ou outra condição para iniciar o tratamento foi estabelecida.</items><items id="text">Data do início/ Condição de início</items></items><items code="at0017"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0018"><items id="description">A administração de um medicamento foi suspensa e não realizada. Não há expectativa de que será dada mais tarde, embora a próxima dose (se houver) deva ser administrada conforme a prescrição original.</items><items id="text">Omissão da administração da dose</items></items><items code="at0020"><items id="comment">Por exemplo: "Atenolol 100mg" ou "Tenormin comprimidos 100mg". É altamente recomendável que o "Item de medicação" seja codificado com uma terminologia capaz de desencadear suporte à decisão, quando possível. A extensão da codificação pode variar de um simple nome do item de medicação até detalhes estruturados sobre a embalagem de medicamento usada. Entradas em texto livre devem ser usadas apenas e não houver terminologia apropriada disponível.</items><items id="description">Nome do medicamento, vacina ou outro item terapêutico que foi o foco da atividade.</items><items id="text">Item de medicação</items></items><items code="at0021"><items id="comment">Por exemplo: "Adiado - paciente indisponível na hora da administração", "Cancelado - reação adversa". Nota: Esta não é a razão para a instrução da medicação, mas sim o motivo específico para a realização de determinada etapa no processo de cuidado, e será frequentemente usado para documentar alguma variação da solicitação original.</items><items id="description">Motivo pelo qual a etapa para determinada medicação foi realizada.</items><items id="text">Motivo</items></items><items code="at0024"><items id="comment">Por exemplo: "Paciente estava no departamento de radiologia", "Injeção intravenosa acidental durante a administração IM".</items><items id="description">Narrativa adicional sobre a atividade ou etapa do fluxo de cuidado não capturada em outros campos, incluindo detalhes de quaisquer variáveis entre a ação pretendida e a ação realmente realizada.</items><items id="text">Comentário</items></items><items code="at0025"><items id="comment">*For example: Vaccine sequence number. (en)</items><items id="description">O número sequencial específico da atividade registrada.</items><items id="text">Número sequencial</items></items><items code="at0030"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0033"><items id="comment">Por exemplo: "Evitar toranja", "Tomar pelo menos 2 horas antes de deitar", "Tomar com alimento". Pode ser codificado com uma terminologia quando clinicamente apropriado.</items><items id="description">Quaisquer orientações, instruções ou conselhos dados ao sujeito do cuidado ou cuidador no momento</items><items id="text">Orientação ao paciente</items></items><items code="at0039"><items id="description">Foi necessário realizar uma alteração significativa na prescrição, resultando no cancelamento da atual e a substituição por uma nova prescrição.</items><items id="text">Alteração significativa na prescrição</items></items><items code="at0041"><items id="description">A prescrição foi alterada de uma forma que não exige uma nova liberação da prescrição, de acordo com as regras clínicas locais.</items><items id="text">Prescrição com mínimas mudanças</items></items><items code="at0043"><items id="comment">Usado para comparar a variação do tempo real de ação onde este não é prontamente calculado da instrução original.</items><items id="description">Data/hora na qual a foi agendada ação da medicação.</items><items id="text">Data/hora original do agendamento</items></items><items code="at0044"><items id="description">A administração de uma dose de medicamento foi adiada, mas espera-se que seja administrada o mais rápido possível.</items><items id="text">Administração da dose adiada</items></items><items code="at0053"><items id="description">Demais detalhes estruturados da ação, possivelmente específicos à etapa do processo.</items><items id="text">Detalhes adicionais</items></items><items code="at0085"><items id="comment">Por exemplo: requisitos locais de informação ou metadados adicionais para alinhar com os modelos equivalente em FHIR e CIMI.</items><items id="description">Informações adicionais necessárias para capturar o conteúdo local ou para se alinhar com outros modelos de referência / formalismos.</items><items id="text">Extensão</items></items><items code="at0103"><items id="comment">Comentário: este elemento de dado permite a definição de múltiplas ocorrências mais explicitamente em tempo de execução, caso necessário.</items><items id="description">Identificador único para a solicitação de medicação.</items><items id="text">Identificação da solicitação</items></items><items code="at0104"><items id="comment">Use este SLOT quando descrições detalhadas sobre o item dispensado, autorizado ou administrado precisam ser explicitamente citadas. Por exemplo: a forma, concentração, quaisquer diluentes ou mistura de ingredientes.</items><items id="description">Detalhes estruturados sobre a medicação incluindo concentração, forma e componentes.</items><items id="text">Detalhes da medicação</items></items><items code="at0106"><items id="description">A solicitação original da medicação foi reautorização para permitir prescrição ou dispensação repetida. Em algumas jurisdições uma nova solicitação deve ser emitida nestas circunstâncias.</items><items id="text">Prescrição reautorizada</items></items><items code="at0109"><items id="description">Medicamento foi recomendado mas nenhuma ação foi realizada para iniciar a prescrição.</items><items id="text">Medicamento recomendado</items></items><items code="at0131"><items id="comment">CLUSTER.dosage pretende carregar detalhes da solicitação de mudanças da medicação ou administrações da dose, enquanto CLUSTER.medication_supply_amount registra os detalhes da atividade relacionada à dispensação.</items><items id="description">Detalhes específicos sobre a quantidade do item de medicação.</items><items id="text">Quantidade</items></items><items code="at0132"><items id="comment">Em muitas jurisdições, a substituição de um item prescrito como uma forma genérica ou com um nome comercial diferente, que foi determinado como bioequivalente, é permitida no momento da dispensação ou suprimento. Em outros casos assume-se a substituição e o clínico deve requisitar explicitamente a não-substituição.</items><items id="description">Ação de substituição realizada pela pessoa que administrou ou dispensou o medicamento.</items><items id="text">Substituição</items></items><items code="at0133"><items id="comment">Por exemplo: "Alternativa genérica contém uma substância não tolerada pelo paciente". Pode ser codificado com uma terminologia quando clinicamente apropriado.</items><items id="description">O motivo ou justificativa para a ação de substituição realizada.</items><items id="text">Motivo da substituição</items></items><items code="at0138"><items id="description">A medicação substituída é bioequivalente àquela prescrita.</items><items id="text">Substituição realizada</items></items><items code="at0139"><items id="description">Embora permitido pela prescrição da medicação a substituição por um medicamento bioequivalente não foi realizada.</items><items id="text">Substituição não realizada</items></items><items code="at0140"><items id="description">Detalhes do local do corpo e administração da medicação.</items><items id="text">Detalhes da administração</items></items><items code="at0141"><items id="comment">Por exemplo: "braço esquerdo superior", "cateter intravenoso na mão direita". A codificação do local do corpo com uma terminologia é preferível, quando possível.</items><items id="description">Descrição estruturada do local de administração do item prescrito.</items><items id="text">Local do corpo</items></items><items code="at0142"><items id="comment">Por exemplo: "Na superfície medial da pele do antebraço esquerdo, de 10 cm a 20 cm distante da ponta do cotovelo".</items><items id="description">Descrição estruturada do local de administração do medicamento, vacina ou insumo terapêutico.</items><items id="text">Local do corpo estruturado</items></items><items code="at0143"><items id="comment">Comentário: Por exemplo: "injeção com técnica em Z"; "via nebulizador". A codificação do método com uma terminologia é preferível, quando possível.</items><items id="description">A técnica ou dispositivo pelo qual o item foi, ou deve ser, administrado.</items><items id="text">Método de administração</items></items><items code="at0144"><items id="description">Detalhes do dispositivo médico usado para auxiliar a administração do medicamento.</items><items id="text">Dispositivo de administração</items></items><items code="at0145"><items id="description">Rascunho da prescrição foi preparado e está aguardando confirmação de um clínico autorizado. Pode ser usado quando reautorizações são realizadas em lote. Esta etapa do processo de cuidado pode ter um estado de "planejado" ou "ativo", refletindo a necessidade de gerir novas solicitações assim como solicitações reautorizadas.</items><items id="text">Prescrição no aguardo de autorização</items></items><items code="at0147"><items id="comment">Comentário: Por exemplo: "oral", "intravenoso", ou "tópico". Codificar a via com uma terminologia é preferível, quando possível. Múltiplas vias potenciais podem ser especificadas.</items><items id="description">A via pela qual o item prescrito foi, ou deve ser, administrado no corpo do indivíduo.</items><items id="text">Via</items></items><items code="at0148"><items id="comment">*For example: preparation of an intravenous mixture. (en)</items><items id="description">*The medication has been physically prepared. (en)</items><items id="text">Medicamento preparado</items></items><items code="at0149"><items id="comment">Detalhes do indivíduo que realiza a dupla checagem pode ser registrado no elemento "Participação" do Modelo de Referência.</items><items id="description">Uma ação que foi checada por outro indivíduo.</items><items id="text">Dupla checagem?</items></items><items code="at0150"><items id="description">A prescrição foi cancelada antes de ser emitida.</items><items id="text">Prescrição cancelada</items></items><items code="at0151"><items id="description">A prescrição foi invalidada ou expirou sem ser aviada.</items><items id="text">Prescrição inválida ou cancelada</items></items><items code="at0152"><items id="description">A prescrição foi aviada com sucesso.</items><items id="text">Prescrição aviada</items></items><items code="at0153"><items id="description">A medicação foi formalmente autorizada para uso.</items><items id="text">Medicação autorizada</items></items><items code="at0154"><items id="comment">Por exemplo: 2017-10-29</items><items id="description">A data/hora na qual o curso da medicação está configurado para reiniciar, como a etapa "Conjunto de condições para reinício da medicação" do processo.</items><items id="text">Data/hora do reinício</items></items><items code="at0155"><items id="comment">Por exemplo: "No segundo dia após a cirurgia".</items><items id="description">O critério que desencadeia o reinício do curso da medicação, como uma etapa "Conjunto de condições para reinício da medicação" do processo.</items><items id="text">Critério do reinício</items></items><items code="at0156"><items id="comment">*For example: 'Angina' or 'Pain'. Coding of the indication with a terminology is preferred, where possible. This data element allows multiple occurrences. If only an ACTION is used to record a medication indication, this data element can be used without additional consideration. However, if a clinical indication is recorded for both the Medication order INSTRUCTION and this Medication management ACTION, be aware that these indications might not be consistent." (en)</items><items id="description">*The clinical reason for the medication activity. (en)</items><items id="text">*Clinical indication (en)</items></items><items code="at0157"><items id="description">*The prepared medication has been double checked. (en)</items><items id="text">*Medication double checked (en)</items></items><items code="at0158"><items id="description">*An administration of a dose of the medication was started but was subsequently aborted. (en)</items><items id="text">*Dose administration aborted (en)</items></items></term_definitions><term_definitions language="ru"><items code="at0000"><items id="comment">*This is not limited to activities performed based on medication orders from clinicians, but could also include for example taking over the counter medication.(en)</items><items id="description">*Any activity related to the planning, scheduling, prescription management, dispensing, administration, cessation and other use of a medication, vaccine, nutritional product or other therapeutic item.(en)</items><items id="text">*Medication management(en)</items></items><items code="at0002"><items id="description">*A prescription has been issued for the medication.(en)</items><items id="text">*Prescription issued(en)</items></items><items code="at0003"><items id="description">*The ordered medication has been dispensed, for example from a pharmacy to the patient.(en)</items><items id="text">*Prescription dispensed(en)</items></items><items code="at0004"><items id="description">*The medication has been taken by, or administered to, the patient for the first time. Although in some settings this significant date may be computable as the first of several administrations, in other settings, such as primary care, specific administration dates are not readily available.(en)</items><items id="text">*Medication course commenced(en)</items></items><items code="at0005"><items id="description">*The specific medication item has been reviewed, as planned. This is not intended to capture review of the whole medication list.(en)</items><items id="text">*Medication course reviewed(en)</items></items><items code="at0006"><items id="description">*A single administration of the medication has taken place.(en)</items><items id="text">*Dose administered(en)</items></items><items code="at0007"><items id="description">*The medication course has been completed as planned.(en)</items><items id="text">*Medication course completed(en)</items></items><items code="at0008"><items id="description">*The prescription has not been dispensed due to a technical or pharamaceutical supply issue.(en)</items><items id="text">*Prescription supply delayed(en)</items></items><items code="at0009"><items id="description">*The administration of the medication has been suspended until further notice. No further doses should be given until the restart date or conditions have been met. When setting the date/conditions for restart after suspending, a step from ‘Administrations suspended’ and back to 'Medication start date/condition set' should be performed.(en)</items><items id="text">*Administrations suspended(en)</items></items><items code="at0010"><items id="description">*A prescription token has been re-issued for an existing medication order.(en)</items><items id="text">*Prescription re-issued(en)</items></items><items code="at0011"><items id="description">*Reissuing of this prescription is not available without some intervention.(en)</items><items id="text">*Prescription re-issue suspended(en)</items></items><items code="at0012"><items id="description">*The planned course of medication has been cancelled prior to any administration.(en)</items><items id="text">*Medication course cancelled(en)</items></items><items code="at0013"><items id="description">*The scheduled medication course has been postponed prior to any administration.(en)</items><items id="text">*Medication course postponed(en)</items></items><items code="at0015"><items id="description">*The administration of this medication has been ceased after the first dose has been administered, but before intended completion of the course.  (en)</items><items id="text">*Medication course stopped(en)</items></items><items code="at0016"><items id="description">*The time to start this medication, or other starting condition, has been set.(en)</items><items id="text">*Medication start date/condition set(en)</items></items><items code="at0017"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0018"><items id="description">*The administration of a medication has been withheld and not given. There is no expectation that it will be given later, though the next dose (if any) should be administered according to the original order.(en)</items><items id="text">*Dose administration omitted(en)</items></items><items code="at0020"><items id="comment">*For example: 'Atenolol 100mg' or 'Tenormin tablets 100mg'. &#13;
It is strongly recommended that the 'Medication item' is coded with a terminology capable of triggering decision support, where possible. The extent of coding may vary from the simple name of the medication item through to structured details about the actual medication pack used. Free text entry should only be used if there is no appropriate terminology available.(en)</items><items id="description">*Name of the medication, vaccine or other therapeutic/prescribable item which was the focus of the activity.(en)</items><items id="text">*Medication item(en)</items></items><items code="at0021"><items id="comment">*For example: 'Postponed - Patient not avalable at administration time', 'Cancelled - Adverse reaction'. Note: This is not the reason for the medication instruction, but rather the specific reason that a care step was carried out, and will often be used to document some variance from the original order.(en)</items><items id="description">*Reason that the pathway step for the identified medication was carried out.(en)</items><items id="text">*Reason(en)</items></items><items code="at0024"><items id="comment">*For example: 'Patient was in radiology department', 'Accidental injection into blood vessel during IM administration'.(en)</items><items id="description">*Additional narrative about the activity or care pathway step not captured in other fields, including details of any variance between the intended action and the action actually performed.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="comment">*For example: Vaccine sequence number. (en)</items><items id="description">*The sequence number specific to the activity being recorded.(en)</items><items id="text">*Sequence number(en)</items></items><items code="at0030"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0033"><items id="comment">*For example: 'Avoid grapefruit' , 'Take at least 2 hours before bedtime', 'Take with food'. May be coded with a terminology when clinically appropriate.(en)</items><items id="description">*Any guidance, instructions or advice given to the subject of care or personal carer at the time of the pathway step.(en)</items><items id="text">*Patient guidance(en)</items></items><items code="at0039"><items id="description">*A major change to the order was required, resulting in this order being stopped and a replacement order being started.(en)</items><items id="text">*Major change to order.(en)</items></items><items code="at0041"><items id="description">*The medication order has been changed in a manner which does not require a new instruction/order to be issued, according to local clinical rules.(en)</items><items id="text">*Minor change to order(en)</items></items><items code="at0043"><items id="comment">*Used to compare variance from actual action time where this is not readily calculable from the original instruction.(en)</items><items id="description">*The datetime at which the medication action was scheduled to occur.(en)</items><items id="text">*Original scheduled date/time(en)</items></items><items code="at0044"><items id="description">*Administration of a dose of mediciation has been delayed but is expected to be given as soon as possible.(en)</items><items id="text">*Dose administration deferred(en)</items></items><items code="at0053"><items id="description">*Further structured details of the action, possibly specific to a pathway step.(en)</items><items id="text">*Additional details(en)</items></items><items code="at0085"><items id="description">**(en)</items><items id="text">*Cluster(en)</items></items><items code="at0103"><items id="comment">*Comment: This data element allows for multiple occurrences to be defined more explicitly at run-time, if required.(en)</items><items id="description">*Unique identifier for the medication order.(en)</items><items id="text">*Order ID(en)</items></items><items code="at0104"><items id="comment">*Use this SLOT where the detailed description of the dispensed, authorised or administered item needs to be explicitly stated. For example: the form, strength, any diluents or mixture of ingredients.(en)</items><items id="description">*Structured details about the medication including strength, form and constituent substances.(en)</items><items id="text">*Medication details(en)</items></items><items code="at0106"><items id="description">*The original medication order has been re-authorised to allow repeat prescription or dispensing. In some jurisdictions an entirely new order must be issued in these circumstances.(en)</items><items id="text">*Prescription re-authorised(en)</items></items><items code="at0109"><items id="description">*The medication has been recommended but no steps have been taken to initiate prescribing.(en)</items><items id="text">*Medication recommended(en)</items></items><items code="at0131"><items id="comment">*Dosage_administration is intended to carry details of medication order changes or dose administrations, whilst medication_supply_amount is intended for details of dispensing-related activity.(en)</items><items id="description">*Specific details about the amount of the medication item.(en)</items><items id="text">*Amount(en)</items></items><items code="at0132"><items id="comment">*In many jurisdictions, substitution of an ordered item as a generic form or with a different brand name, which has been determined as bioequivalent, is allowed at the point of dispense or supply. In other cases substitution is assumed and the clinician has to explicitly request non-substitution.(en)</items><items id="description">*Subsitution action taken by the person administering or dispensing the drug.(en)</items><items id="text">*Substitution(en)</items></items><items code="at0133"><items id="comment">*For example: "Generic alternative contains a substance that is not tolerated by the patient." May be coded with a terminology when clinically appropriate(en)</items><items id="description">*The reason or justification for the substitution action taken.(en)</items><items id="text">*Substitution reason(en)</items></items><items code="at0138"><items id="description">*A medication was substituted which is bioequivalent to that ordered.(en)</items><items id="text">*Substitution performed(en)</items></items><items code="at0139"><items id="description">*Although allowed by the medication order a bioequvalent medication was not substituted.(en)</items><items id="text">*Substitution not performed(en)</items></items><items code="at0140"><items id="description">*Details of body site and administration of the medication.(en)</items><items id="text">*Administration details(en)</items></items><items code="at0141"><items id="comment">*For example: 'left upper arm', 'intravenous catheter right hand'. &#13;
Coding of the body site with a terminology is preferred, where possible.(en)</items><items id="description">*Structured description of the site of administration of the ordered item.(en)</items><items id="text">*Body site(en)</items></items><items code="at0142"><items id="comment">*For example: "On the medial skin surface of the left forearm, from 10 cm to 20 cm distally from the point of the elbow".(en)</items><items id="description">*Structured description of the site of administration of the medication, vaccine or therapeutic good.(en)</items><items id="text">*Structured body site(en)</items></items><items code="at0143"><items id="comment">*Comment: For example: ' via Z-track injection'; 'via nebuliser'. Coding of the method with a terminology is preferred, where possible.(en)</items><items id="description">*The technique or device by which the ordered item was, or is to be, administered.(en)</items><items id="text">*Administration method(en)</items></items><items code="at0144"><items id="description">*Details of the medical device used to assist administration of the medication.(en)</items><items id="text">*Administration device(en)</items></items><items code="at0145"><items id="description">*Draft prescription has been prepared and is awaiting confirmation from an authorised clinician. May be used where reauthorisations are performed as a batch. This careflow_step may have a status of 'planned' or 'active', reflecting the need to to handle new orders as well as re-authorised orders.(en)</items><items id="text">*Prescription awaiting authorisation(en)</items></items><items code="at0147"><items id="comment">*Comment: For example: 'oral', 'intravenous', or 'topical'. Coding of the route with a terminology is preferred, where possible. Multiple potential routes may be specified.(en)</items><items id="description">*The route by which the ordered item was, or is to be, administered into the subject's body.(en)</items><items id="text">*Route(en)</items></items><items code="at0148"><items id="comment">*For example: preparation of an intravenous mixture. (en)</items><items id="description">*The medication has been physically prepared. (en)</items><items id="text">*Medication prepared(en)</items></items><items code="at0149"><items id="comment">*Details of the individual performing the double-check can be carried in the Reference Model element "Participation".(en)</items><items id="description">*The action step has been checked by a separate individual.(en)</items><items id="text">*Double-checked?(en)</items></items><items code="at0150"><items id="description">*The prescription was cancelled prior to being issued.(en)</items><items id="text">*Prescription cancelled(en)</items></items><items code="at0151"><items id="description">*Prescription has been invalidated or has expired without being fulfilled.(en)</items><items id="text">*Prescription invalid or expired(en)</items></items><items code="at0152"><items id="description">*The prescription has been fulfilled successfully.(en)</items><items id="text">*Prescription fulfilled(en)</items></items><items code="at0153"><items id="description">*The medication has been formally authorised for use.(en)</items><items id="text">*Medication authorised(en)</items></items><items code="at0154"><items id="comment">*For example: 2017-10-29(en)</items><items id="description">*The date/time on which the medication course is set to restart, as per the "Medication restart date/condition set" pathway step.(en)</items><items id="text">*Restart date/time(en)</items></items><items code="at0155"><items id="comment">*For example: "On day 2 after surgery".(en)</items><items id="description">*The criterion which triggers the medication course to restart, as per the "Medication restart date/condition set" pathway step.(en)</items><items id="text">*Restart criterion(en)</items></items><items code="at0156"><items id="comment">*For example: 'Angina' or 'Pain'. Coding of the indication with a terminology is preferred, where possible. This data element allows multiple occurrences. If only an ACTION is used to record a medication indication, this data element can be used without additional consideration. However, if a clinical indication is recorded for both the Medication order INSTRUCTION and this Medication management ACTION, be aware that these indications might not be consistent." (en)</items><items id="description">*The clinical reason for the medication activity. (en)</items><items id="text">*Clinical indication (en)</items></items><items code="at0157"><items id="description">*The prepared medication has been double checked. (en)</items><items id="text">*Medication double checked (en)</items></items><items code="at0158"><items id="description">*An administration of a dose of the medication was started but was subsequently aborted. (en)</items><items id="text">*Dose administration aborted (en)</items></items></term_definitions><term_definitions language="sl"><items code="at0000"><items id="comment">*This is not limited to activities performed based on medication orders from clinicians, but could also include for example taking over the counter medication.(en)</items><items id="description">*Any activity related to the planning, scheduling, prescription management, dispensing, administration, cessation and other use of a medication, vaccine, nutritional product or other therapeutic item.(en)</items><items id="text">*Medication management(en)</items></items><items code="at0002"><items id="description">*A prescription has been issued for the medication.(en)</items><items id="text">*Prescription issued(en)</items></items><items code="at0003"><items id="description">*The ordered medication has been dispensed, for example from a pharmacy to the patient.(en)</items><items id="text">*Prescription dispensed(en)</items></items><items code="at0004"><items id="description">*The medication has been taken by, or administered to, the patient for the first time. Although in some settings this significant date may be computable as the first of several administrations, in other settings, such as primary care, specific administration dates are not readily available.(en)</items><items id="text">*Medication course commenced(en)</items></items><items code="at0005"><items id="description">*The specific medication item has been reviewed, as planned. This is not intended to capture review of the whole medication list.(en)</items><items id="text">*Medication course reviewed(en)</items></items><items code="at0006"><items id="description">*A single administration of the medication has taken place.(en)</items><items id="text">*Dose administered(en)</items></items><items code="at0007"><items id="description">*The medication course has been completed as planned.(en)</items><items id="text">*Medication course completed(en)</items></items><items code="at0008"><items id="description">*The prescription has not been dispensed due to a technical or pharamaceutical supply issue.(en)</items><items id="text">*Prescription supply delayed(en)</items></items><items code="at0009"><items id="description">*The administration of the medication has been suspended until further notice. No further doses should be given until the restart date or conditions have been met. When setting the date/conditions for restart after suspending, a step from ‘Administrations suspended’ and back to 'Medication start date/condition set' should be performed.(en)</items><items id="text">*Administrations suspended(en)</items></items><items code="at0010"><items id="description">*A prescription token has been re-issued for an existing medication order.(en)</items><items id="text">*Prescription re-issued(en)</items></items><items code="at0011"><items id="description">*Reissuing of this prescription is not available without some intervention.(en)</items><items id="text">*Prescription re-issue suspended(en)</items></items><items code="at0012"><items id="description">*The planned course of medication has been cancelled prior to any administration.(en)</items><items id="text">*Medication course cancelled(en)</items></items><items code="at0013"><items id="description">*The scheduled medication course has been postponed prior to any administration.(en)</items><items id="text">*Medication course postponed(en)</items></items><items code="at0015"><items id="description">*The administration of this medication has been ceased after the first dose has been administered, but before intended completion of the course.  (en)</items><items id="text">*Medication course stopped(en)</items></items><items code="at0016"><items id="description">*The time to start this medication, or other starting condition, has been set.(en)</items><items id="text">*Medication start date/condition set(en)</items></items><items code="at0017"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0018"><items id="description">*The administration of a medication has been withheld and not given. There is no expectation that it will be given later, though the next dose (if any) should be administered according to the original order.(en)</items><items id="text">*Dose administration omitted(en)</items></items><items code="at0020"><items id="comment">*For example: 'Atenolol 100mg' or 'Tenormin tablets 100mg'. &#13;
It is strongly recommended that the 'Medication item' is coded with a terminology capable of triggering decision support, where possible. The extent of coding may vary from the simple name of the medication item through to structured details about the actual medication pack used. Free text entry should only be used if there is no appropriate terminology available.(en)</items><items id="description">*Name of the medication, vaccine or other therapeutic/prescribable item which was the focus of the activity.(en)</items><items id="text">*Medication item(en)</items></items><items code="at0021"><items id="comment">*For example: 'Postponed - Patient not avalable at administration time', 'Cancelled - Adverse reaction'. Note: This is not the reason for the medication instruction, but rather the specific reason that a care step was carried out, and will often be used to document some variance from the original order.(en)</items><items id="description">*Reason that the pathway step for the identified medication was carried out.(en)</items><items id="text">*Reason(en)</items></items><items code="at0024"><items id="comment">*For example: 'Patient was in radiology department', 'Accidental injection into blood vessel during IM administration'.(en)</items><items id="description">*Additional narrative about the activity or care pathway step not captured in other fields, including details of any variance between the intended action and the action actually performed.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="comment">*For example: Vaccine sequence number. (en)</items><items id="description">*The sequence number specific to the activity being recorded.(en)</items><items id="text">*Sequence number(en)</items></items><items code="at0030"><items id="description">@ internal @</items><items id="text">Tree(en)</items></items><items code="at0033"><items id="comment">*For example: 'Avoid grapefruit' , 'Take at least 2 hours before bedtime', 'Take with food'. May be coded with a terminology when clinically appropriate.(en)</items><items id="description">*Any guidance, instructions or advice given to the subject of care or personal carer at the time of the pathway step.(en)</items><items id="text">*Patient guidance(en)</items></items><items code="at0039"><items id="description">*A major change to the order was required, resulting in this order being stopped and a replacement order being started.(en)</items><items id="text">*Major change to order.(en)</items></items><items code="at0041"><items id="description">*The medication order has been changed in a manner which does not require a new instruction/order to be issued, according to local clinical rules.(en)</items><items id="text">*Minor change to order(en)</items></items><items code="at0043"><items id="comment">*Used to compare variance from actual action time where this is not readily calculable from the original instruction.(en)</items><items id="description">*The datetime at which the medication action was scheduled to occur.(en)</items><items id="text">*Original scheduled date/time(en)</items></items><items code="at0044"><items id="description">*Administration of a dose of mediciation has been delayed but is expected to be given as soon as possible.(en)</items><items id="text">*Dose administration deferred(en)</items></items><items code="at0053"><items id="description">*Further structured details of the action, possibly specific to a pathway step.(en)</items><items id="text">*Additional details(en)</items></items><items code="at0085"><items id="description">**(en)</items><items id="text">*Cluster(en)</items></items><items code="at0103"><items id="comment">*Comment: This data element allows for multiple occurrences to be defined more explicitly at run-time, if required.(en)</items><items id="description">*Unique identifier for the medication order.(en)</items><items id="text">*Order ID(en)</items></items><items code="at0104"><items id="comment">*Use this SLOT where the detailed description of the dispensed, authorised or administered item needs to be explicitly stated. For example: the form, strength, any diluents or mixture of ingredients.(en)</items><items id="description">*Structured details about the medication including strength, form and constituent substances.(en)</items><items id="text">*Medication details(en)</items></items><items code="at0106"><items id="description">*The original medication order has been re-authorised to allow repeat prescription or dispensing. In some jurisdictions an entirely new order must be issued in these circumstances.(en)</items><items id="text">*Prescription re-authorised(en)</items></items><items code="at0109"><items id="description">*The medication has been recommended but no steps have been taken to initiate prescribing.(en)</items><items id="text">*Medication recommended(en)</items></items><items code="at0131"><items id="comment">*Dosage_administration is intended to carry details of medication order changes or dose administrations, whilst medication_supply_amount is intended for details of dispensing-related activity.(en)</items><items id="description">*Specific details about the amount of the medication item.(en)</items><items id="text">*Amount(en)</items></items><items code="at0132"><items id="comment">*In many jurisdictions, substitution of an ordered item as a generic form or with a different brand name, which has been determined as bioequivalent, is allowed at the point of dispense or supply. In other cases substitution is assumed and the clinician has to explicitly request non-substitution.(en)</items><items id="description">*Subsitution action taken by the person administering or dispensing the drug.(en)</items><items id="text">*Substitution(en)</items></items><items code="at0133"><items id="comment">*For example: "Generic alternative contains a substance that is not tolerated by the patient." May be coded with a terminology when clinically appropriate(en)</items><items id="description">*The reason or justification for the substitution action taken.(en)</items><items id="text">*Substitution reason(en)</items></items><items code="at0138"><items id="description">*A medication was substituted which is bioequivalent to that ordered.(en)</items><items id="text">*Substitution performed(en)</items></items><items code="at0139"><items id="description">*Although allowed by the medication order a bioequvalent medication was not substituted.(en)</items><items id="text">*Substitution not performed(en)</items></items><items code="at0140"><items id="description">*Details of body site and administration of the medication.(en)</items><items id="text">*Administration details(en)</items></items><items code="at0141"><items id="comment">*For example: 'left upper arm', 'intravenous catheter right hand'. &#13;
Coding of the body site with a terminology is preferred, where possible.(en)</items><items id="description">*Structured description of the site of administration of the ordered item.(en)</items><items id="text">*Body site(en)</items></items><items code="at0142"><items id="comment">*For example: "On the medial skin surface of the left forearm, from 10 cm to 20 cm distally from the point of the elbow".(en)</items><items id="description">*Structured description of the site of administration of the medication, vaccine or therapeutic good.(en)</items><items id="text">*Structured body site(en)</items></items><items code="at0143"><items id="comment">*Comment: For example: ' via Z-track injection'; 'via nebuliser'. Coding of the method with a terminology is preferred, where possible.(en)</items><items id="description">*The technique or device by which the ordered item was, or is to be, administered.(en)</items><items id="text">*Administration method(en)</items></items><items code="at0144"><items id="description">*Details of the medical device used to assist administration of the medication.(en)</items><items id="text">*Administration device(en)</items></items><items code="at0145"><items id="description">*Draft prescription has been prepared and is awaiting confirmation from an authorised clinician. May be used where reauthorisations are performed as a batch. This careflow_step may have a status of 'planned' or 'active', reflecting the need to to handle new orders as well as re-authorised orders.(en)</items><items id="text">*Prescription awaiting authorisation(en)</items></items><items code="at0147"><items id="comment">*Comment: For example: 'oral', 'intravenous', or 'topical'. Coding of the route with a terminology is preferred, where possible. Multiple potential routes may be specified.(en)</items><items id="description">*The route by which the ordered item was, or is to be, administered into the subject's body.(en)</items><items id="text">*Route(en)</items></items><items code="at0148"><items id="comment">*For example: preparation of an intravenous mixture. (en)</items><items id="description">*The medication has been physically prepared. (en)</items><items id="text">*Medication prepared(en)</items></items><items code="at0149"><items id="comment">*Details of the individual performing the double-check can be carried in the Reference Model element "Participation".(en)</items><items id="description">*The action step has been checked by a separate individual.(en)</items><items id="text">*Double-checked?(en)</items></items><items code="at0150"><items id="description">*The prescription was cancelled prior to being issued.(en)</items><items id="text">*Prescription cancelled(en)</items></items><items code="at0151"><items id="description">*Prescription has been invalidated or has expired without being fulfilled.(en)</items><items id="text">*Prescription invalid or expired(en)</items></items><items code="at0152"><items id="description">*The prescription has been fulfilled successfully.(en)</items><items id="text">*Prescription fulfilled(en)</items></items><items code="at0153"><items id="description">*The medication has been formally authorised for use.(en)</items><items id="text">*Medication authorised(en)</items></items><items code="at0154"><items id="comment">*For example: 2017-10-29(en)</items><items id="description">*The date/time on which the medication course is set to restart, as per the "Medication restart date/condition set" pathway step.(en)</items><items id="text">*Restart date/time(en)</items></items><items code="at0155"><items id="comment">*For example: "On day 2 after surgery".(en)</items><items id="description">*The criterion which triggers the medication course to restart, as per the "Medication restart date/condition set" pathway step.(en)</items><items id="text">*Restart criterion(en)</items></items><items code="at0156"><items id="comment">*For example: 'Angina' or 'Pain'. Coding of the indication with a terminology is preferred, where possible. This data element allows multiple occurrences. If only an ACTION is used to record a medication indication, this data element can be used without additional consideration. However, if a clinical indication is recorded for both the Medication order INSTRUCTION and this Medication management ACTION, be aware that these indications might not be consistent." (en)</items><items id="description">*The clinical reason for the medication activity. (en)</items><items id="text">*Clinical indication (en)</items></items><items code="at0157"><items id="description">*The prepared medication has been double checked. (en)</items><items id="text">*Medication double checked (en)</items></items><items code="at0158"><items id="description">*An administration of a dose of the medication was started but was subsequently aborted. (en)</items><items id="text">*Dose administration aborted (en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="comment">Ej begränsat till aktiviteter som utförs baserat på läkemedelsbeställningar från kliniker, utan kan även inkludera exempelvis övertagande av läkemedel.</items><items id="description">Aktiviteter relaterade till planering, schemaläggning, recepthantering, dosering, administrering, avbrott från eller användning av läkemedel, vaccinering, näringspreparat eller annan terapeutisk produkt.</items><items id="text">Hantering av läkemedelsregim</items></items><items code="at0002"><items id="description">En ordination av läkemedlet har utfärdats.</items><items id="text">Utfärdad ordination</items></items><items code="at0003"><items id="description">Det ordinerade läkemedlet har dispenserats, exempelvis från ett apotek till patienten.</items><items id="text">Utdelad ordination</items></items><items code="at0004"><items id="description">Läkemedlet har tagits av eller administrerats till patienten för första gången. I vissa fall kan startdatum för varje administrationstillfälle finnas tillgängligt, medan det i andra fall (såsom i primärvården) inte gör det.</items><items id="text">Påbörjad läkemedelsbehandling</items></items><items code="at0005"><items id="description">Omprövning av det enskilda läkemedlet, exempelvis huruvida medicineringen ska fortskrida. Syftet är inte att skapa en översyn av läkemedelslistan.</items><items id="text">Omprövning av läkemedel</items></items><items code="at0006"><items id="description">Engångsadministrering av läkemedlet.</items><items id="text">Administrerad dos</items></items><items code="at0007"><items id="description">Läkemedelsbehandlingen har slutförts som planerat.</items><items id="text">Fullföljd läkemedelsbehandling</items></items><items code="at0008"><items id="description">Ordinationen har inte delats ut på grund av ett teknisk eller faramaceutiskt leveransproblem.</items><items id="text">Försenad receptleverans</items></items><items code="at0009"><items id="description">Administreringen av läkemedlet har avbrutits tills vidare. Inga ytterligare doser ska ges förrän ett nytt startdatum har angivits eller villkoren har uppfyllts. Vid inställning av in datum/villkor för omstart, ska stegen från "Läkemedlets startdatum/fastställda villkor" till "Indragen administrering" utföras på nytt.</items><items id="text">Indragen administrering</items></items><items code="at0010"><items id="description">En ordination har utfärdats på nytt för en befintlig läkemedelsorder.</items><items id="text">Förnyelse av ordination</items></items><items code="at0011"><items id="description">Inväntar återauktorisering för ordination av en läkare.</items><items id="text">Återauktorisering av recept inväntas</items></items><items code="at0012"><items id="description">Schemalagd läkemedelsbehandling som har avbrutits före administrering.</items><items id="text">Avbruten läkemedelsbehandling</items></items><items code="at0013"><items id="description">Schemalagd läkemedelsbehandling som har blivit uppskjuten före administrering.</items><items id="text">Uppskjuten läkemedelsbehandling</items></items><items code="at0015"><items id="description">Administreringen av läkemedlet har avbrutits under det planerade förloppet.</items><items id="text">Avbruten läkemedelsbehandling</items></items><items code="at0016"><items id="description">Tid då medicinering startar, eller vid annat startvillkor.</items><items id="text">Läkemedlets startdatum/fastställda villkor</items></items><items code="at0017"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0018"><items id="description">Nekad administrering av läkemedlet. Denna dos förväntas inte att ges vid senare tillfälle, även om en eventuellt nästa dos ska administreras enligt planerat.</items><items id="text">Utelämnad dos</items></items><items code="at0020"><items id="comment">Till exempel: "Atenolol 100mg" eller "Tenormin 100mg". Om möjligt, benämn läkemedelsartikeln med en terminologi som kan utlösa beslutsstöd. Omfattningen av denna angivelse kan variera från namnet på läkemedelsartikeln till detaljer om det läkemedelspaketet som används. Fri textinmatning bör endast användas om det inte finns någon lämplig terminologi tillgänglig.</items><items id="description">Benämning på läkemedlet, vaccinet eller annan terapeutisk/ordinationsbar artikel som aktiviteten gäller.</items><items id="text">Läkemedelsartikel</items></items><items code="at0021"><items id="comment">Till exempel: "Uppskjutning - Patient inte tillgänglig vid administreringstillfälle", "Avbrott - Biverkning". Obs! Detta utgör inte orsaken bakom själva medicineringsanvisningen, utan snarare anledningen till att ett vårdsteg genomförs. Detta användas generellt för att dokumentera avvikelser från den ursprungliga ordern.</items><items id="description">Anledningen till att steget för det aktuella läkemedlet utfördes.</items><items id="text">Orsak</items></items><items code="at0024"><items id="comment">Till exempel: "Patienten befann sig på röntgenavdelning", "Oavsiktlig injektion i blodkärlet under IM-administrering".</items><items id="description">Kommentarer avseende den aktivitet eller det vårdsteg som inte beskrivs i övriga fält, inklusive detaljer om eventuell avvikelse mellan den avsedda åtgärden och den faktiska utförda åtgärden.</items><items id="text">Kommentar</items></items><items code="at0025"><items id="comment">Exempelvis dosnummer för vaccinering.</items><items id="description">Det specifika sekvensnumret för det aktuella vårdsteget.</items><items id="text">Sekvensnummer</items></items><items code="at0030"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0033"><items id="comment">Till exempel: "Undvik grapefrukt", "Ta minst 2 timmar före sänggåendet", "Ta tillsammans med mat". Om kliniskt lämpligt, benämn med en terminologi.</items><items id="description">Vägledning, instruktioner eller råd som ges till patienten eller dennes personliga vårdgivare vid tidpunkten för vårdsteget.</items><items id="text">Patientvägledning</items></items><items code="at0039"><items id="description">Då en större ändring av ordern krävdes, resulterade detta i att denna order stoppades och en ersättningsorder påbörjades.</items><items id="text">Större orderändring</items></items><items code="at0041"><items id="description">Läkemedelsordern har ändrats på ett sätt som inte kräver att en ny order ska utfärdas, enligt lokala kliniska regler.</items><items id="text">Mindre orderändring</items></items><items code="at0043"><items id="comment">Används för att jämföra avvikelse från faktisk åtgärdstid.</items><items id="description">Tidpunkt då hantering av läkemedelsregim var schemalagd.</items><items id="text">Ursprungligt datum/tid</items></items><items code="at0044"><items id="description">En dos av läkemedlet har försenats men förväntas administreras så snart som möjligt.</items><items id="text">Uppskjuten dos</items></items><items code="at0053"><items id="description">Ytterligare information om åtgärden, eventuellt specifikt för ett särskilt vårdsteg.</items><items id="text">Övrig information</items></items><items code="at0085"><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items><items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="text">Tilläggsinformation</items></items><items code="at0103"><items id="comment">Detta dataelement möjliggör exakt identifiering av flera ordrar samtidigt.</items><items id="description">Unik identifikator för läkemedelsbeställningen.</items><items id="text">Beställnings-ID</items></items><items code="at0104"><items id="comment">Använd denna SLOT när detaljerad beskrivning av den dispenserade, auktoriserade eller administrerade artikeln måste anges explicit. Till exempel: form, styrka, eventuella utspädningsmedel eller blandning av ingredienser.</items><items id="description">Information om läkemedlet inklusive dess styrka, form och beståndsdelar.</items><items id="text">Läkemedelsinformation</items></items><items code="at0106"><items id="description">Den ursprungliga läkemedelsorden har godkänts på nytt för att möjliggöra fortsatt dosering. I vissa jurisdiktioner måste en helt ny order utfärdas.</items><items id="text">Förnyelse av receptbeläggning</items></items><items code="at0109"><items id="description">Rekommenderat läkemedel, ej påbörjad ordination.</items><items id="text">Rekommenderat läkemedel</items></items><items code="at0131"><items id="comment">CLUSTER.dosage är avsedd för information om ändringar av läkemedelsbeställningar eller administrerad dos och CLUSTER.medication_supply_amount är avsedd för information om doseringsrelaterad aktivitet.</items><items id="description">Kvantitet av läkemedelsartikeln.</items><items id="text">Kvantitet</items></items><items code="at0132"><items id="comment">I många jurisdiktioner är det möjligt att vid dispenseringstillfället ersätta en beställd artikel med en generisk sort eller med ett annat varumärke, förutsatt att bioekvivalens är uppnått. I andra fall antas substitution vara tillåtet, såvida en kliniker explicit inte begär annat.</items><items id="description">Substitutionsåtgärder vidtagna av den person som administrerar eller dispenserar läkemedlet.</items><items id="text">Substitution</items></items><items code="at0133"><items id="comment">Till exempel: "Generiskt alternativ innehåller ett ämne som inte tolereras av patienten." Om kliniskt lämpligt, benämn med en terminologi.</items><items id="description">Anledning eller motivering till den vidtagna substitutionsåtgärden.</items><items id="text">Orsak för substitution</items></items><items code="at0138"><items id="description">Ersättning av läkemedel som är bioekvivalent med det som beställts.</items><items id="text">Utförd substitution</items></items><items code="at0139"><items id="description">Trots tillåtelse av läkemedelsordern, ersattes inte ett bioekvivalent läkemedel.</items><items id="text">Ej utförd substitution</items></items><items code="at0140"><items id="description">Information om atomisk lokalisering och administrering av läkemedlet.</items><items id="text">Administreringsinformation</items></items><items code="at0141"><items id="comment">Till exempel: "vänster överarm", "intravenös kateter, höger hand". Om möjligt, benämn den anatomiska lokaliseringen med en terminologi.</items><items id="description">Beskrivning av administrationsstället för den beställda artikeln.</items><items id="text">Anatomisk lokalisering</items></items><items code="at0142"><items id="comment">Till exempel: "På den mediala hudytan på vänster underarm, från 10 cm till 20 cm distalt från armbågens punkt".</items><items id="description">Närmare beskrivning av administrationsstället för läkemedlet, vaccinet eller annan terapeutisk produkt.</items><items id="text">Exakt anatomisk lokalisering</items></items><items code="at0143"><items id="comment">Till exempel: "via Z-teknik"; "via nebulisator". Om möjligt, benämn metoden med en terminologi.</items><items id="description">Den teknik eller utrustning med vilken den beställda artikeln administrerades eller ska administreras.</items><items id="text">Administreringsmetod</items></items><items code="at0144"><items id="description">Information om den medicinska utrustning som används vid administrering av läkemedlet.</items><items id="text">Utrustning för administrering</items></items><items code="at0145"><items id="description">Förslag på ordination har utarbetats och inväntar bekräftelse från en auktoriserad läkare. Kan användas där återauktorisering utförs som en batch. Detta flödessteg kan ha statusen "planerad" eller "aktiv", vilket återspeglar behovet av att hantera nya beställningar såväl som återauktoriserade ordrar.</items><items id="text">Ordination som inväntar tillstånd</items></items><items code="at0147"><items id="comment">Till exempel: "oralt", "intravenöst" eller "lokalt". Om möjligt, benämn administreringsvägen med en terminologi. Flera potentiella administreringsvägar kan specificeras.</items><items id="description">Sättet genom vilken den beställda artikeln administrerades eller ska administreras i patientens kropp.</items><items id="text">Administreringsväg</items></items><items code="at0148"><items id="comment">*For example: preparation of an intravenous mixture. (en)</items><items id="description">*The medication has been physically prepared. (en)</items><items id="text">Förberedelse av läkemedel</items></items><items code="at0149"><items id="comment">Information om den person som utför dubbelkontrollen kan anges i referensmodells-elementet "Deltagande".</items><items id="description">Vårdsteget har dubbelkontrollerats av annan individ.</items><items id="text">Dubbelkontrollerat?</items></items><items code="at0150"><items id="description">Ordinationen avbröts innan det utfärdades.</items><items id="text">Avbruten ordination</items></items><items code="at0151"><items id="description">Receptet har ogiltigförklarats eller upphört att gälla.</items><items id="text">Ogiltigt eller utgånget recept</items></items><items code="at0152"><items id="description">Receptet har framgångsrikt uppfyllts.</items><items id="text">Uppfyllt recept</items></items><items code="at0153"><items id="description">Läkemedlet har formellt godkänts för användning.</items><items id="text">Godkännande av läkemedel</items></items><items code="at0154"><items id="comment">Till exempel: 2017-10-29</items><items id="description">Datum/tid för omstart av läkemedelsbehandling, enligt "Indragen administrering".</items><items id="text">Datum/tid för omstart</items></items><items code="at0155"><items id="comment">Till exempel: "Dag 2 efter operation".</items><items id="description">Kriteriet för omstart av läkemedelsbehandling, enligt "Indragen administrering".</items><items id="text">Omstartskriterium</items></items><items code="at0156"><items id="comment">Exempelvis "Angina pectoris" eller "Smärta". Om möjligt, benämn den kliniska indikationen med en terminologi. Detta dataelement kan förekomma upprepade gånger. Om endast ACTION används för att registrera en klinisk indikation, kan detta dataelement användas utan någon särskild aktning. Om en klinisk indikation i stället registreras för både INSTRUCTION och ACTION, var uppmärksam på att dessa angivelser kanske inte är konsekventa.</items><items id="description">Klinisk orsak till läkemedelsbehandling.</items><items id="text">Klinisk indikation</items></items><items code="at0157"><items id="description">*The prepared medication has been double checked. (en)</items><items id="text">*Medication double checked (en)</items></items><items code="at0158"><items id="description">*An administration of a dose of the medication was started but was subsequently aborted. (en)</items><items id="text">*Dose administration aborted (en)</items></items></term_definitions><term_definitions language="zh-cn"><items code="at0000"><items id="comment">这不仅限于根据临床医生的药物医嘱所执行/开展的活动，还可以包括服用非处方药物之类的情况。</items><items id="description">任何与药物、疫苗、营养产品/制品或其他治疗类制剂（therapeutic item）的计划[编制]、排程/安排、处方管理、配发、施用/给药、停止/停用和其他使用情况相关的活动。又称为用药管理。</items><items id="text">药物管理</items></items><items code="at0002"><items id="description">已经签发/开出了相应药物的处方。</items><items id="text">已签发的处方</items></items><items code="at0003"><items id="description">已经配发医嘱所开立的药物；例如，由药房配发给了相应的患者。</items><items id="text">已配发的处方</items></items><items code="at0004"><items id="description">患者已经首次服用相应的药物，或者说已经对其进行了首次的施用/给药。 尽管在某些场所环境下，这一重要的日期可以作为多次施用/给药之中的第一次而用于计算，而在其他的场所环境下，如初级照护服务（基层医疗服务），具体的施用/给药日期并不容易获得。</items><items id="text">已开始的药物治疗过程</items></items><items code="at0005"><items id="description">已经重新评估了相应的具体药物，如是否仍然应当服用该药物。 这一节点并非旨在用于采集药物清单的审核情况。</items><items id="text">已重新评估的药物</items></items><items code="at0006"><items id="description">已经进行了单独一次的药物施用/给药。</items><items id="text">已施用/给药的剂量</items></items><items code="at0007"><items id="description">已经按计划完成了相应的药物治疗过程。</items><items id="text">已完成的药物治疗过程</items></items><items code="at0008"><items id="description">由于技术或药品供应问题，目前尚未配发相应的处方[药物]。</items><items id="text">已延迟的处方供应</items></items><items code="at0009"><items id="description">已经暂停了相应药物的施用/给药，直至另行通知。 在重新开始日期之前或满足种种条件之前，不应再进行给予更多的剂量药物。 在设置暂停之后的重新开始日期/条件时，应当执行从“已暂停的施用/给药”（Administrations suspended）返回到“已设定的用药开始日期/条件”（Medication start date/condition set）的步骤。</items><items id="text">已暂停的施用/给药</items></items><items code="at0010"><items id="description">已经为现有的药物医嘱重新签发/开出了相应的处方。</items><items id="text">已重新签发的处方</items></items><items code="at0011"><items id="description">处方的签发正在等待临床医务人员的重新授权。</items><items id="text">待处理的处方重新授权</items></items><items code="at0012"><items id="description">在任何的施用/给药之前，已经取消了已计划的药物治疗过程。</items><items id="text">已取消的药物治疗过程</items></items><items code="at0013"><items id="description">在任何的施用/给药之前，已经推迟了已排程/安排的药物治疗过程。</items><items id="text">已推迟的药物治疗过程</items></items><items code="at0015"><items id="description">在预定的治疗过程（疗程）期间，已经停止了相应药物的施用/给药。</items><items id="text">已停止的药物治疗过程</items></items><items code="at0016"><items id="description">已经设定开始用药的时间或其他的起始/开始条件。</items><items id="text">已设定的用药开始日期/条件</items></items><items code="at0017"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0018"><items id="description">已经予以省略/扣除而并未给予的施用/给药。 虽说应该按照原始的医嘱来施用/给予下次剂量的药物（如果有的话），但并不期望后续会再施用/给予所省略/扣除的剂量。</items><items id="text">已省略的剂量管理</items></items><items code="at0020"><items id="comment">例如：“阿替洛尔 100mg”或“特诺明片 100mg”。&#13;
强烈建议尽可能采用能够触发决策支持手段的术语集来编码“用药项”（Medication item）。编码的程度/范围可能各不相同，包括从用药项简称到关于实际使用的药物包装的结构化详情。只有在没有合适的术语集可用的情况下才应当采用自由文本录入的方式。</items><items id="description">作为活动关注焦点的药物、疫苗或其他治疗项/处方项的名称。</items><items id="text">用药项</items></items><items code="at0021"><items id="comment">例如：“已推迟 - 患者在施用/给药时不在场”，“已取消 - 不良反应”。 注意：这不是关于用药医嘱/指令的原因，而是关于执行特定照护服务步骤的具体原因，且往往用于记录相对于原始医嘱的一些偏差。</items><items id="description">关于执行所标识用药/药物治疗路径步骤的原因。</items><items id="text">原因</items></items><items code="at0024"><items id="comment">例如：“患者当时在放射科”、“在肌肉注射给药期间意外注射到了血管内”。</items><items id="description">额外关于其他字段之中并未采集的，关于相应活动或路径步骤的文本叙述型说明，包括关于预期行动与实际所执行的行动之间的任何差异的详情。</items><items id="text">备注</items></items><items code="at0025"><items id="comment">例如：疫苗序列号。</items><items id="description">专门针对当前所记录的路径步骤的顺序编号/序列号/序号。</items><items id="text">顺序编号</items></items><items code="at0030"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0033"><items id="comment">例如：“避免吃葡萄柚”、“睡前至少2小时服用”、“随食物一同服用”。 在临床上合适的情况下，可以采用术语集来编码。</items><items id="description">为照护服务对象（患者）或具体照护人员所提供的任何关于特定路径步骤时的指导[意见]、操作指南/使用说明/指示或建议/忠告。</items><items id="text">患者指导</items></items><items code="at0039"><items id="description">需要对医嘱进行重大变更，导致该医嘱遭到停止并开始启用替代的医嘱。</items><items id="text">医嘱的重大变更</items></items><items code="at0041"><items id="description">根据本地的临床规则，采取并不需要签发新的指令/医嘱的方式，对药物医嘱进行了变更。</items><items id="text">医嘱的微小变更</items></items><items code="at0043"><items id="comment">用于在并不容易获得原始排程/安排日期/时间的情况下，比较它与实际行动日期/时间之间的差异。</items><items id="description">当初所排程/安排的开展药物治疗行动的日期时间。</items><items id="text">原始排程/安排的日期/时间</items></items><items code="at0044"><items id="description">已经推迟一剂药物的施用/给药，但预计会尽快施用/给药。</items><items id="text">已延期的施用/给药</items></items><items code="at0053"><items id="description">进一步关于当前行动的结构化细节，且有可能针对的是特定的路径步骤。</items><items id="text">其他详情</items></items><items code="at0085"><items id="comment">例如：本地信息需求/要求或者是其他旨在与FHIR或CIMI等价元素/结构进行协调统一时所需的元数据。</items><items id="description">采集本地语境/上下文背景或者是与其他的参考模型/形式化体系进行协调统一时所需的其他信息。</items><items id="text">扩展</items></items><items code="at0103"><items id="comment">备注：如果需要，此数据元允许在运行时更为明确地定义其多次的重复出现。</items><items id="description">药物/用药医嘱的唯一性标识符。</items><items id="text">医嘱标识符</items></items><items code="at0104"><items id="comment">在需要明确说明所配发、授权或施用/给予的用药项的详细描述时，应当采用这一槽位（SLOT）。 例如：剂型/形式、规格、任何稀释剂或若干成分的混合物。</items><items id="description">关于相应药物的结构化详情，包括规格、剂型/形式和组成物质。</items><items id="text">药物详情</items></items><items code="at0106"><items id="description">已经对原始的药物医嘱进行了重新授权，以便能够重复利用处方或配发药物。在某些司法管辖区域，在此类的情况下，必须签发/开出全新的医嘱。</items><items id="text">已重新授权的处方</items></items><items code="at0109"><items id="description">已经推荐了相应的药物，但尚未采取任何的措施/步骤来启动处方开立的过程。</items><items id="text">已推荐的药物</items></items><items code="at0131"><items id="comment">剂量群簇CLUSTER.dosage旨在承载关于药物医嘱变更或剂量施用/给药的详情，而 药物供应数量群簇CLUSTER.medication_supply_amount则旨在用于记录关于配发相关的活动的详情。</items><items id="description">关于用药项数量的具体详情。</items><items id="text">数量</items></items><items code="at0132"><items id="comment">在许多的司法管辖区域，在配发或供应药物时，允许将医嘱所开立的用药项替换为已确定具有生物等效性的通用形式/剂型或不同商品名的产品。在其他的情况下，则假定默认可以予以替换，而如果希望不得替换，临床医务人员则必须做出明确的要求。</items><items id="description">负责施用/给药或配发药物的人员所采取的替换行动。</items><items id="text">替换</items></items><items code="at0133"><items id="comment">例如：“非专利/通用替代药物含有患者不能耐受的物质。” 在临床上合适的情况下，可以采用术语集来编码。</items><items id="description">关于所采取的替代行动的原因或理由。</items><items id="text">替换原因</items></items><items code="at0138"><items id="description">已经将医嘱所开立的药物替换成了与之生物等效的药物。</items><items id="text">已执行的替换</items></items><items code="at0139"><items id="description">尽管药物医嘱允许替换，但并未将医嘱所开立的药物替换成生物等效药物。</items><items id="text">未执行的替换</items></items><items code="at0140"><items id="description">关于当前药物治疗的身体部位和施用/给药情况的详情。</items><items id="text">施用/给药详情</items></items><items code="at0141"><items id="comment">例如：“左上臂”、“右手静脉导管”。&#13;
最好采用术语集来编码身体部位。</items><items id="description">关于医嘱所开立用药项的施用/给药部位的结构化描述。</items><items id="text">身体部位</items></items><items code="at0142"><items id="comment">例如：“左前臂内侧皮肤表面，从肘尖远侧10厘米到20厘米”。</items><items id="description">关于药物、疫苗或治疗类产品施用/给药部位的结构化描述。</items><items id="text">结构化身体部位</items></items><items code="at0143"><items id="comment">备注：例如，“采用Z型注射法”（Z径路肌肉注射法）； '采用雾化器'。 最好采用术语集来编码施用/给药方法。</items><items id="description">已经或预定施用医嘱所开立的用药项时所采用的技术方法或装置/器械/设备。</items><items id="text">施用/给药方法</items></items><items code="at0144"><items id="description">关于用来协助施用/给药的医疗装置/器械/设备的详情。</items><items id="text">施用/给药装置</items></items><items code="at0145"><items id="description">已经准备/书写好了处方草稿，正在等待授权临床医务人员的确认。可以用于批量执行重新授权的情况。照护服务流程步骤（careflow_step）的状态可能是“已计划”或“有效”，反映的则是需要处理新的医嘱以及重新授权的医嘱。</items><items id="text">等待授权的处方</items></items><items code="at0147"><items id="comment">备注：例如，“口服”、“静脉注射”或“局部/外用”。 最好尽可能采用术语集来编码途径。 可以指定多个潜在的途径。</items><items id="description">已经或预定将医嘱所开立的用药项施用于服务对象身体时所采用的途径。又称为施用途径或用药途径。</items><items id="text">途径</items></items><items code="at0148"><items id="comment">例如：静脉注射混合液的准备/制备。</items><items id="description">已经实际上/物质上准备/制备好了相应的药物。</items><items id="text">已准备好的药物</items></items><items code="at0149"><items id="comment">可以在参考模型的参与元素“Participation”之中记录关于执行复核的个人的详情。</items><items id="description">另一不同的人员已经检查核对了这一路径步骤。</items><items id="text">复核情况</items></items><items code="at0150"><items id="description">在签发/开出之前取消了处方。</items><items id="text">已取消的处方</items></items><items code="at0151"><items id="description">处方已经失效或过期且并未获得执行。</items><items id="text">无效或过期的处方</items></items><items code="at0152"><items id="description">已经成功地执行了相应的处方。</items><items id="text">已执行的处方</items></items><items code="at0153"><items id="description">已经正式授权使用相应的药物。</items><items id="text">已授权的药物</items></items><items code="at0154"><items id="comment">例如：2017-10-29</items><items id="description">根据“已暂停的施用/给药”（Administrations suspended）路径步骤，设置重新开始药物治疗过程的日期/时间。</items><items id="text">重新开始日期/时间</items></items><items code="at0155"><items id="comment">例如：“术后第2天”。</items><items id="description">根据“已暂停的施用/给药”（Administrations suspended）路径步骤，用于触发药物治疗过程重新开始的评判准则/标准。</items><items id="text">重新开始的评判准则</items></items><items code="at0156"><items id="comment">例如：“心绞痛”或“疼痛”。 最好尽可能采用术语集来编码适应证。此数据元允许多次重复出现。 如果仅仅利用行动（ACTION）来记录药物适应证，则可直接采用这一数据元，而无需做其他的考虑。不过，如果药物医嘱指令（INSTRUCTION）和当前药物管理行动（ACTION）同时都记录了临床适应证，则应当注意两处的适应证可能并不一致。</items><items id="description">用药活性的临床原因。</items><items id="text">临床适应证</items></items><items code="at0157"><items id="description">已经复核了所准备/制备好的相应药物。</items><items id="text">已复核的药物</items></items><items code="at0158"><items id="description">*An administration of a dose of the medication was started but was subsequently aborted. (en)</items><items id="text">*Dose administration aborted (en)</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-ACTION.procedure.v1"><term_definitions language="ar-sy"><items code="at0000"><items id="description">*A clinical activity carried out for screening, investigative, diagnostic, curative, therapeutic, evaluative or palliative purposes.(en)</items><items id="text">*Procedure(en)</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*Coding of the 'Procedure name' with a terminology is recommended, if available. (en)</items><items id="description">*Identification of the procedure by name.(en)</items><items id="text">*Procedure name(en)</items></items><items code="at0003"><items id="description">*Structured information about the procedure. Use to capture detailed, structured information about anatomical location, method &amp; technique, equipment used, devices implanted, results, findings etc.(en)</items><items id="text">*Procedure detail(en)</items></items><items code="at0004"><items id="description">*</items><items id="text">*Procedure planned (en)</items></items><items code="at0005"><items id="description">*Additional narrative about the procedure or care pathway step not captured in other fields. (en)</items><items id="text">*Comment(en)</items></items><items code="at0006"><items id="comment">*Use this data element to record simple terms or precoordinated complications. For example: Hematuria after a kidney biopsy, tissue irritation after insertion of intravenous catheter. If the requirements for recording complication are more complex then use of a specific CLUSTER archetype within the 'Procedure detail' SLOT in this archetype is advised and this data element becomes redundant. (en)</items><items id="description">*Details about any complication arising from the procedure.(en)</items><items id="text">*Complication(en)</items></items><items code="at0007"><items id="description">*</items><items id="text">*Procedure request sent (en)</items></items><items code="at0014"><items id="comment">*For example: the reason for the cancellation or suspension of the procedure.(en)</items><items id="description">*Reason that the activity or care pathway step for the identified procedure was carried out.(en)</items><items id="text">*Reason(en)</items></items><items code="at0034"><items id="description">*The procedure to be undertaken is planned.(en)</items><items id="text">*Procedure planned(en)</items></items><items code="at0035"><items id="description">*Request for procedure sent.(en)</items><items id="text">*Procedure request sent(en)</items></items><items code="at0036"><items id="description">*The procedure has been scheduled.(en)</items><items id="text">*Procedure scheduled(en)</items></items><items code="at0038"><items id="description">*The procedure has been postponed.(en)</items><items id="text">*Procedure postponed(en)</items></items><items code="at0039"><items id="description">*The planned procedure has been cancelled prior to commencement.(en)</items><items id="text">*Procedure cancelled(en)</items></items><items code="at0040"><items id="description">*The procedure has been suspended.(en)</items><items id="text">*Procedure suspended(en)</items></items><items code="at0041"><items id="description">*The procedure has been aborted.(en)</items><items id="text">*Procedure aborted(en)</items></items><items code="at0043"><items id="description">*The procedure has been performed and all associated clinical activities completed.(en)</items><items id="text">*Procedure completed(en)</items></items><items code="at0047"><items id="description">*The procedure, or subprocedure in a multicomponent procedure, has been performed.(en)</items><items id="text">*Procedure performed(en)</items></items><items code="at0048"><items id="comment">*Coding of the 'Outcome' with a terminology is recommended, if available. (en)</items><items id="description">*Outcome of procedure performed.(en)</items><items id="text">*Outcome(en)</items></items><items code="at0049"><items id="comment">*For example: description about the performance and findings from the the procedure, the aborted attempt or the cancellation of the procedure.(en)</items><items id="description">*Narrative description about the procedure, as appropriate for the pathway step.(en)</items><items id="text">*Description(en)</items></items><items code="at0053"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0054"><items id="comment">*This is equivalent to Placer Order Number in HL7 v2 specifications.(en)</items><items id="description">*The local ID assigned to the order by the healthcare provider or organisation requesting the service.(en)</items><items id="text">*Requestor order identifier(en)</items></items><items code="at0055"><items id="description">تفاصيل حول مقدم الخدمة الصحية أو المؤسسة التي تطلب الخدمة</items><items id="text">الطالب</items></items><items code="at0056"><items id="comment">*This is equivalent to Filler Order Number in HL7 v2 specifications.(en)</items><items id="description">*The ID assigned to the order by the healthcare provider or organisation receiving the request for service. This is also referred to as Filler Order Identifier.(en)</items><items id="text">*Receiver order identifier(en)</items></items><items code="at0057"><items id="description">تفاصيل حول مقدم الخدمة الصحية أو المؤسسة التي تستقبل طلب الخدمة.</items><items id="text">المستقبِل</items></items><items code="at0058"><items id="comment">*Coding of the 'Urgency' with a terminology is recommended, if available. (en)</items><items id="description">*Urgency of the procedure.(en)</items><items id="text">*Urgency(en)</items></items><items code="at0060"><items id="comment">*Only for use in association with the 'Procedure performed' pathway step, and in situations where the procedure is repeated on multiple occasions before being completed or there are multiple components to the whole procedure. This may be the same as the RM time attribute for the 'Procedure completed' pathway step.(en)</items><items id="description">*The date or datetime when the entire procedure, or the last component of a multicomponent procedure, was finished. (en)</items><items id="text">*End datetime (en)</items></items><items code="at0061"><items id="comment">*Only for use in association with the 'Procedure completed' pathway steps.(en)</items><items id="description">*The total amount of time taken to complete the procedure, which may include time spent during the active phase of the procedure plus time during which the procedure was suspended.(en)</items><items id="text">*Total duration(en)</items></items><items code="at0062"><items id="description">*Mulitimedia representation of a performed procedure.(en)</items><items id="text">*Multimedia(en)</items></items><items code="at0063"><items id="comment">*Occurrences for this data element are unbounded to allow for clinical scenarios such as removing multiple skin lesions in different places, but where all of the other attributes are identical. Use this data element to record simple terms or precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Procedure detail' SLOT in this archetype. If the anatomical location is included in the 'Procedure name' via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">*Identification of the body site for the procedure.(en)</items><items id="text">*Body site(en)</items></items><items code="at0064"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">*Extension(en)</items></items><items code="at0065"><items id="comment">*Use this data element to record simple terms or a narrative description. If the requirements for recording the method require more complex modelling then this can be represented by additional archetypes within the 'Procedure detail' SLOT in this archetype. If the method is included in the 'Procedure name' via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">*Identification of specific method or technique for the procedure.(en)</items><items id="text">*Method(en)</items></items><items code="at0066"><items id="comment">*Only for use in association with the 'Procedure scheduled' pathway step.(en)</items><items id="description">*The date or datetime on which the procedure is intended to be performed. (en)</items><items id="text">*Scheduled datetime (en)</items></items><items code="at0067"><items id="comment">*This pragmatic data element may be used to support organisation within the user interface.(en)</items><items id="description">*The type of procedure.(en)</items><items id="text">*Procedure type(en)</items></items><items code="at0068"><items id="description">*The procedure, or subprocedure in a multicomponent procedure, has been commenced.(en)</items><items id="text">*Procedure commenced(en)</items></items><items code="at0069"><items id="description">*Difficulties or issues encountered during the procedure.(en)</items><items id="text">*Procedural difficulty(en)</items></items><items code="at0070"><items id="comment">*For example: 'Failed bowel preparation' or 'Bowel cancer screening'. Coding of the 'Indication' with a terminology is recommended, if available.  This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">*The clinical or process-related reason for the procedure. (en)</items><items id="text">*Indication (en)</items></items><items code="at0071"><items id="description"/><items id="text">*DV_TEXT (en)</items></items><items code="at0072"><items id="comment">*For example: An operation with curative intent may be planned, while during the operation it is discovered that curative treatment is not possible and the operation is carried out with a palliative intent instead. Coding of the 'Intent' with a terminology is recommended, if available. This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">*The intended outcome of the procedure. (en)</items><items id="text">*Intent (en)</items></items><items code="at0073"><items id="comment">*For example: the knife to skin time. Only for use in association with the 'Procedure performed', 'Procedure suspended', 'Procedure aborted' or 'Procedure completed' pathway steps. This may be the same as the RM 'time' attribute for the 'Procedure commenced' pathway step. (en)</items><items id="description">*The date or datetime when the entire procedure, or the first component of a multicomponent procedure, was first started. (en)</items><items id="text">*Start datetime (en)</items></items><items code="at0074"><items id="description">*The duration of time between the start of the most recent pathway step for this procedure and the start of the current pathway step. (en)</items><items id="text">*Pathway step duration (en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="description">Activitat clínica duta a terme amb fins de cribratge, investigació, diagnòstic, curatius, terapèutics, d'avaluació o pal·liatius.</items><items id="text">Procediment</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*Coding of the 'Procedure name' with a terminology is recommended, if available. (en)</items><items id="description">Identificació del procediment pel nom.</items><items id="text">Nom del procediment</items></items><items code="at0003"><items id="comment">S'utilitza per recopilar informació detallada i estructurada sobre la localització anatòmica, el mètode i la tècnica, l'equip utilitzat, els dispositius implantats, els resultats, les troballes, etc.</items><items id="description">Informació estructurada sobre el procediment.</items><items id="text">Detalls del procediment</items></items><items code="at0004"><items id="description">Es planifica el procediment que cal dur a terme.</items><items id="text">Procediment planificat</items></items><items code="at0005"><items id="description">*Additional narrative about the procedure or care pathway step not captured in other fields. (en)</items><items id="text">Comentaris</items></items><items code="at0006"><items id="comment">*Use this data element to record simple terms or precoordinated complications. For example: Hematuria after a kidney biopsy, tissue irritation after insertion of intravenous catheter. If the requirements for recording complication are more complex then use of a specific CLUSTER archetype within the 'Procedure detail' SLOT in this archetype is advised and this data element becomes redundant. (en)</items><items id="description">Detalls sobre qualsevol complicació derivada del procediment.</items><items id="text">Complicació</items></items><items code="at0007"><items id="description">Sol·licitud de procediment enviada.</items><items id="text">Sol·licitud de procediment enviada</items></items><items code="at0014"><items id="comment">Per exemple: motiu de la cancel·lació o suspensió del procediment.</items><items id="description">Motiu pel qual es va dur a terme l'activitat o etapa assistencial per al procediment identificat.</items><items id="text">Motiu</items></items><items code="at0034"><items id="comment">(Obsolet: Es planifica el procediment a dur a terme.)</items><items id="description">Aquest apartat ha quedat obsolet, ja que s'associava incorrectament amb l'estat inicial. Utilitzeu el nou apartat "Procediment planificat" (at0004), associat correctament amb l'estat "planificat".</items><items id="text">X - Procediment planificat</items></items><items code="at0035"><items id="comment">(Obsolet: Sol·licitud de procediment enviada.)</items><items id="description">Aquest apartat ha quedat obsolet, ja que s'associava incorrectament amb l'estat inicial. Utilitzeu el nou apartat "Sol·licitud de procediment enviada" (at0004), associat correctament amb l'estat "planificat".</items><items id="text">X - Sol·licitud de procediment enviada</items></items><items code="at0036"><items id="description">El procediment s'ha programat.</items><items id="text">Procediment programat</items></items><items code="at0038"><items id="description">El procediment s'ha posposat.</items><items id="text">Procediment posposat</items></items><items code="at0039"><items id="description">S'ha cancel·lat el procediment previst abans de començar.</items><items id="text">Procediment cancel·lat</items></items><items code="at0040"><items id="description">El procediment s'ha suspès.</items><items id="text">Procediment suspès</items></items><items code="at0041"><items id="description">El procediment s'ha interromput.</items><items id="text">Procediment interromput</items></items><items code="at0043"><items id="description">S'ha fet el procediment i s'han completat totes les activitats clíniques associades.</items><items id="text">Procediment completat</items></items><items code="at0047"><items id="description">El procediment o subprocediment en un procediment multicomponent s'ha realitzat.</items><items id="text">Procediment realitzat</items></items><items code="at0048"><items id="comment">*Coding of the 'Outcome' with a terminology is recommended, if available. (en)</items><items id="description">Resultat del procediment realitzat.</items><items id="text">Resultat</items></items><items code="at0049"><items id="comment">Per exemple: descripció de la realització i resultats del procediment, l'intent interromput o la cancel·lació del procediment.</items><items id="description">Descripció narrativa del procediment, segons correspongui a la fase del procés.</items><items id="text">Descripció</items></items><items code="at0053"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0054"><items id="comment">Equivalent al Placer Order Number a les especificacions HL7 v2.</items><items id="description">L'ID local assignat a l'ordre pel proveïdor sanitari o l'organització que sol·licita el servei.</items><items id="text">Identificador d'ordre del sol·licitant</items></items><items code="at0055"><items id="description">Dades del professional sanitari o organització que sol·licita el servei.</items><items id="text">Sol·licitant</items></items><items code="at0056"><items id="comment">Equivalent al Filler Order Number a les especificacions HL7 v2.</items><items id="description">L'identificador assignat a l'ordre pel proveïdor sanitari o organització que rep la sol·licitud de servei. També s'anomena identificador d'ordre d'emplenament.</items><items id="text">Identificador d'ordre del receptor</items></items><items code="at0057"><items id="description">Dades sobre el proveïdor o organització sanitària que rep la sol·licitud de servei.</items><items id="text">Receptor</items></items><items code="at0058"><items id="comment">*Coding of the 'Urgency' with a terminology is recommended, if available. (en)</items><items id="description">Urgència del procediment.</items><items id="text">Urgència</items></items><items code="at0060"><items id="comment">Només per al seu ús en associació amb l'etapa "Procediment realitzat", i en situacions en què el procediment es repeteix diverses vegades abans de completar-se, o hi ha diversos components en tot el procediment. Pot ser el mateix que l'atribut de temps RM de l'etapa "Procediment completat".</items><items id="description">*The date or datetime when the entire procedure, or the last component of a multicomponent procedure, was finished. (en)</items><items id="text">*End datetime (en)</items></items><items code="at0061"><items id="comment">Només per a ús en associació amb l'etapa "Procediment completat".</items><items id="description">Quantitat total de temps emprat a completar el procediment, que pot incloure el temps emprat durant la fase activa del procediment més el temps durant el qual el procediment va estar suspès.</items><items id="text">Durada</items></items><items code="at0062"><items id="description">Representació multimèdia del procediment realitzat.</items><items id="text">Multimèdia</items></items><items code="at0063"><items id="comment">Les ocurrències d'aquest element de dades són il·limitades per permetre escenaris clínics com l'extirpació de múltiples lesions cutànies a diferents llocs, però on tots els altres atributs són idèntics. Utilitzeu aquest element de dades per registrar termes senzills o localitzacions anatòmiques precoordinades. Si els requisits per registrar la localització anatòmica es determinen en temps d'execució per l'aplicació o requereixen un modelatge més complex, com ara localitzacions relatives, utilitzeu CLUSTER.anatomical_location o CLUSTER.relative_location al SLOT "Detalls del procediment" d'aquest arquetip. Si la localització anatòmica s'inclou al “Nom del procediment” mitjançant codis precoordinats, aquest element de dades serà redundant.</items><items id="description">Identificació de la zona del cos per al procediment.</items><items id="text">Zona corporal</items></items><items code="at0064"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Ampliació</items></items><items code="at0065"><items id="comment">Utilitzeu aquest element de dades per registrar termes senzills o una descripció narrativa. Si els requisits per registrar el mètode requereixen una modelització més complexa, aquesta es pot representar mitjançant arquetips addicionals dins del SLOT "Detall del procediment" d'aquest arquetip. Si el mètode s'inclou al "Nom del procediment" mitjançant codis precoordinats, aquest element de dades serà redundant.</items><items id="description">Identificació del mètode o tècnica específics per al procediment.</items><items id="text">Mètode</items></items><items code="at0066"><items id="comment">Només per utilitzar-lo en associació amb l'etapa "Procediment programat".</items><items id="description">*The date or datetime on which the procedure is intended to be performed. (en)</items><items id="text">*Scheduled datetime (en)</items></items><items code="at0067"><items id="comment">Aquest element de dades es pot utilitzar per donar suport a l'organització dins la interfície d'usuari.</items><items id="description">Tipus de procediment.</items><items id="text">Tipus de procediment</items></items><items code="at0068"><items id="description">El procediment o subprocediment en un procediment multicomponent s'ha iniciat.</items><items id="text">Procediment iniciat</items></items><items code="at0069"><items id="comment">Exemples: El pacient estava agitat, buidat insuficient de l'estómac abans de la gastroscòpia, un tumor a les vies biliars impedia el pas de l'endoscopi.</items><items id="description">Dificultats o problemes trobats durant la realització del procediment.</items><items id="text">Dificultats del procediment</items></items><items code="at0070"><items id="comment">*For example: 'Failed bowel preparation' or 'Bowel cancer screening'. Coding of the 'Indication' with a terminology is recommended, if available.  This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">El motiu, clínic o relacionat amb el procés, del procediment.</items><items id="text">Indicació</items></items><items code="at0071"><items id="comment">El mateix procediment, amb la mateixa gravetat o resultat, pot tenir un impacte diferent a cada pacient. Aquest factor de rellevància implica ajustar l'impacte general d'aquest procediment o del seu resultat, segons les característiques del pacient.&#13;
Per exemple: Dos pacients han estat sotmesos al mateix procediment amb el mateix resultat. Reparació mitjançant osteosíntesi de cinquè dit de mà no dominant.&#13;
Un és un jardiner o un peó d'obra; l'altre, un pianista.&#13;
L'impacte d'aquest procediment al pianista és MAJOR (baixa laboral més llarga, necessitat de rehabilitació funcional completa per ajustar a alts requeriments de motricitat fina en activitat laboral).&#13;
Aquest element està destinat a permetre múltiples tipus d'impacte, inclosos però no limitat a: tractament clínic, funcionament a la llar o vida laboral.</items><items id="description">Avaluació de l'impacte o la rellevància d'un procediment o del seu resultat per a un pacient concret.</items><items id="text">Impacte</items></items><items code="at0072"><items id="comment">*For example: An operation with curative intent may be planned, while during the operation it is discovered that curative treatment is not possible and the operation is carried out with a palliative intent instead. Coding of the 'Intent' with a terminology is recommended, if available. This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">*The intended outcome of the procedure. (en)</items><items id="text">*Intent (en)</items></items><items code="at0073"><items id="comment">*For example: the knife to skin time. Only for use in association with the 'Procedure performed', 'Procedure suspended', 'Procedure aborted' or 'Procedure completed' pathway steps. This may be the same as the RM 'time' attribute for the 'Procedure commenced' pathway step. (en)</items><items id="description">*The date or datetime when the entire procedure, or the first component of a multicomponent procedure, was first started. (en)</items><items id="text">*Start datetime (en)</items></items><items code="at0074"><items id="description">*The duration of time between the start of the most recent pathway step for this procedure and the start of the current pathway step. (en)</items><items id="text">*Pathway step duration (en)</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="description">Eine klinische Aktivität, die zur Früherkennung, Untersuchung, Diagnose, Heilung, Therapie, Bewertung oder in Hinsicht auf palliative Maßnahmen durchgeführt wird.</items><items id="text">Prozedur</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">Wenn möglich wird die Kodierung der spezifischen Prozedur mit einer Terminologie bevorzugt.</items><items id="description">Identifizierung der Prozedur über den Namen.</items><items id="text">Name der Prozedur</items></items><items code="at0003"><items id="comment">Zur Erfassung detaillierter, strukturierter Informationen über die anatomische Lokalisation, Methode und Technik, verwendetes Equipment, implantierte Geräte, Ergebnisse, Befunde usw.</items><items id="description">Strukturierte Informationen über die Prozedur.</items><items id="text">Details zur Prozedur</items></items><items code="at0004"><items id="description">Die Prozedur, die durchgeführt werden soll, ist geplant.</items><items id="text">Geplante Prozedur</items></items><items code="at0005"><items id="description">Zusätzliche Beschreibung der Aktivität oder der "Pathway"-Verlaufsschritte, die in anderen Bereichen nicht erfasst wurden.</items><items id="text">Kommentar</items></items><items code="at0006"><items id="comment">Verwenden Sie dieses Datenelement, um einfache Begriffe oder präkoordinierte Komplikationen zu erfassen. Wenn die Anforderungen an die Erfassung der Komplikationen komplexer sind, wird die Verwendung eines spezifischen CLUSTER-Archetyps innerhalb des Slots "Details zur Prozedur" in diesem Archetyp empfohlen. Dieses Datenelement wird dann redundant. Beispiele: Hämaturie nach einer Nierenbiopsie, Reizungen des Gewebes nach dem Legen eines intravenösen Katheters.</items><items id="description">Details zu allen Komplikationen, die sich aus der Prozedur ergeben haben.</items><items id="text">Komplikationen</items></items><items code="at0007"><items id="description">Der Auftrag für die Prozedur wurde versendet.</items><items id="text">Auftrag für Prozedur versendet</items></items><items code="at0014"><items id="comment">Zum Beispiel: der Grund für den Abbruch oder die Unterbrechung der Prozedur.</items><items id="description">Grund, warum die angegebene Aktivität für diese Prozedur durchgeführt wurde.</items><items id="text">Grund</items></items><items code="at0034"><items id="comment">(War: Die Prozedur, die durchgeführt werden soll, ist geplant.)</items><items id="description">Dieses Element ist veraltet, da es fälschlicherweise mit dem Status "initial" verknüpft war - verwenden Sie das neue Element "Prozedur geplant" (at0004), das korrekt mit dem Status "geplant" verknüpft ist.</items><items id="text">X - Prozedur geplant</items></items><items code="at0035"><items id="comment">(War: Der Auftrag für die Prozedur wurde versendet.)</items><items id="description">Dieses Element ist veraltet, da es fälschlicherweise mit dem Status "initial" verknüpft war - verwenden Sie das neue Element "Geplante Prozedur" (at0007), das korrekt mit dem Status "geplant" verknüpft ist.</items><items id="text">X - Auftrag für Prozedur versendet</items></items><items code="at0036"><items id="description">Ein Termin für die Prozedur wurde geplant.</items><items id="text">geplanter Termin der Prozedur</items></items><items code="at0038"><items id="description">Die Prozedur wurde verschoben.</items><items id="text">Prozedur verschoben</items></items><items code="at0039"><items id="description">Die geplante Prozedur wurde vor Beginn storniert.</items><items id="text">Prozedur storniert</items></items><items code="at0040"><items id="description">Die Prozedur wurde unterbrochen.</items><items id="text">Prozedur unterbrochen</items></items><items code="at0041"><items id="description">Die Prozedur wurde abgebrochen.</items><items id="text">Prozedur abgebrochen</items></items><items code="at0043"><items id="description">Die Prozedur wurde durchgeführt und alle damit verbundenen klinischen Aktivitäten wurden beendet.</items><items id="text">Prozedur beendet</items></items><items code="at0047"><items id="description">Die Prozedur, oder eine Subprozedur in einem mehrstufigen Vorgehen, wurde durchgeführt.</items><items id="text">Prozedur durchgeführt</items></items><items code="at0048"><items id="comment">Wenn möglich wird die Kodierung mit einer Terminologie bevorzugt.</items><items id="description">Ausgang der durchgeführten Prozedur.</items><items id="text">Ausgang</items></items><items code="at0049"><items id="comment">Zum Beispiel: Beschreibung der Durchführung und der Ergebnisse dieser Prozedur, des abgebrochenen Versuchs oder der Stornierung der Prozedur.</items><items id="description">Beschreibung der Prozedur, angepasst an den "Pathway"-Verlaufsschritt.</items><items id="text">Beschreibung</items></items><items code="at0053"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0054"><items id="comment">Dies entspricht der "Placer Order Number" in den Spezifikationen von HL7 v2.</items><items id="description">Die lokale ID, die dem Auftrag vom Gesundheitsdienstleister oder der Organisation, die die Leistung anfordert, zugewiesen wurde.</items><items id="text">Auftragskennung des Antragstellers</items></items><items code="at0055"><items id="description">Angaben über den Gesundheitsdienstleister oder die Organisation, die die Leistung anfordert.</items><items id="text">Antragsteller</items></items><items code="at0056"><items id="comment">Dies entspricht der "Filler Order Number" in den Spezifikationen von HL7 v2.</items><items id="description">Die ID, die dem Auftrag von dem Gesundheitsdienstleister oder der Organisation, die die Leistungsanforderung erhält, zugewiesen wurde. Dies wird auch als "Filler Order Identifier" bezeichnet.</items><items id="text">Auftragskennung des Empfängers</items></items><items code="at0057"><items id="description">Angaben über den Gesundheitsdienstleister oder die Organisation, die die Leistungsanforderung erhält.</items><items id="text">Empfänger</items></items><items code="at0058"><items id="comment">Wenn möglich wird die Kodierung mit einer Terminologie bevorzugt.</items><items id="description">Dringlichkeit der Prozedur.</items><items id="text">Dringlichkeit</items></items><items code="at0060"><items id="comment">Nur zur Verwendung in Verbindung mit dem Element "Prozedur durchgeführt" und in Situationen, in denen die Prozedur vor dem Abschluss mehrmals wiederholt wird oder die Prozedur sich aus mehreren Komponenten zusammensetzt. Dies kann mit dem RM-Zeitattribut des Elements "Prozedur beendet" übereinstimmen.</items><items id="description">Das Datum und/oder die Uhrzeit, an dem die gesamte Prozedur, oder die letzte Komponente einer mehrstufigen Prozedur, beendet wurde.</items><items id="text">Enddatum/-uhrzeit</items></items><items code="at0061"><items id="comment">Nur in Verbindung mit dem Element "Prozedur beendet" verwenden.</items><items id="description">Die Gesamtdauer der Prozedur - diese kann sich aus der aktiven Phase und der Phase, in der die Prozedur unterbrochen wurde, ergeben.</items><items id="text">Gesamtdauer</items></items><items code="at0062"><items id="description">Multimediale Darstellung der durchgeführten Prozedur.</items><items id="text">Multimedia</items></items><items code="at0063"><items id="comment">Das Vorkommen dieses Datenelements ist nicht eingeschränkt. Dies ermöglicht die Darstellung von klinischen Situationen, in denen alle Eigenschaften, ausgenommen die anatomische Lokalisation, identisch sind, wie z.B. das Entfernen mehrerer Hautläsionen an verschiedenen Stellen. Verwenden Sie dieses Datenelement, um einfache Begriffe oder präkoordinierte anatomische Lokalisationen aufzunehmen. Wenn die Anforderungen an die Erfassung der anatomischen Lokalisation zur Laufzeit durch die Anwendung festgelegt werden oder komplexere Modellierungen wie z.B. die relative Lokalisation erforderlich sind, verwenden Sie entweder CLUSTER.anatomical_location oder CLUSTER.relative_location innerhalb des Slots "Details zur Prozedur" in diesem Archetyp. Wird die anatomische Lokalisation über vordefinierte Codes in den Namen der Prozedur aufgenommen, wird dieses Datenelement redundant.</items><items id="description">Anatomische Lokalisation, an der die Prozedur durchgeführt wird.</items><items id="text">Körperstelle</items></items><items code="at0064"><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR- oder CIMI-Äquivalente.</items><items id="description">Zusätzliche Informationen, die erforderlich sind, um lokale Inhalte zu erfassen oder mit anderen Referenzmodellen/Formalismen abzugleichen.</items><items id="text">Erweiterung</items></items><items code="at0065"><items id="comment">Verwenden Sie dieses Datenelement, um einfache Begriffe oder eine Beschreibung zu erfassen. Wenn die Anforderungen an die Erfassung der Methode eine komplexere Modellierung erfordern, kann dies durch zusätzliche Archetypen innerhalb des SLOTs "Details zur Prozedur" in diesem Archetyp dargestellt werden. Wird die Methode über vordefinierte Codes in dem Element "Name der Prozedur" aufgenommen, wird dieses Datenelement redundant.</items><items id="description">Identifizierung der spezifischen Prozedurmethode oder -technik.</items><items id="text">Methode</items></items><items code="at0066"><items id="comment">Nur für die Verwendung in Verbindung mit dem Element "geplanter Termin der Prozedur" .</items><items id="description">Das Datum und/oder die Uhrzeit für die die Prozedur angesetzt ist.</items><items id="text">Geplantes Datum/Uhrzeit</items></items><items code="at0067"><items id="comment">Dieses pragmatische Datenelement kann zur Unterstützung der Gliederung für die Benutzeroberfläche verwendet werden.</items><items id="description">Die Art der Prozedur.</items><items id="text">Art der Prozedur</items></items><items code="at0068"><items id="description">Die Prozedur, oder eine Subprozedur in einem mehrstufigen Vorgehen, wurde begonnen.</items><items id="text">Prozedur begonnen</items></items><items code="at0069"><items id="comment">Beispiele: Der Patient war unruhig; unzureichende Entleerung des Magens vor der Gastroskopie; ein Tumor in den Gallengängen machte es unmöglich, den Bereich zu passieren.</items><items id="description">Schwierigkeiten oder Probleme, die während der Durchführung der Prozedur aufgetreten sind.</items><items id="text">Schwierigkeiten bei der Durchführung der Prozedur</items></items><items code="at0070"><items id="comment">Die Kodierung der Indikation mit einer Terminologie wird nach Möglichkeit bevorzugt. Dieses Datenelement ermöglicht mehrere Vorkommen. Zum Beispiel: "Fehlgeschlagenen Darmvorbereitung" oder "Darmkrebsvorsorge".</items><items id="description">Der klinische oder prozessbezogene Grund für die Prozedur.</items><items id="text">Indikation</items></items><items code="at0071"><items id="comment">Derselbe Eingriff, bei gleichem Schweregrad oder gleichem Ergebnis, kann sich auf jeden Patienten unterschiedlich auswirken. Dieser Relevanzfaktor beinhaltet die Anpassung der Gesamtauswirkungen des Eingriffs oder des Ergebnisses an die individuellen Merkmale des Patienten.&#13;
&#13;
Beispiel: Zwei Patienten haben sich demselben Eingriff mit gleichem Ergebnis unterzogen: einer Osteosynthese des fünften Fingers ihrer nicht-dominanten Hand.&#13;
&#13;
Einer ist Gärtner oder Bauarbeiter, der andere Pianist.&#13;
&#13;
Die Auswirkungen des Eingriffs sind für den Pianisten GRÖSSER (längere Krankschreibung, Notwendigkeit einer umfassenden funktionellen Rehabilitation zur Anpassung an die hohen feinmotorischen Anforderungen seines Berufs).&#13;
&#13;
Dieses Element soll verschiedene Arten von Auswirkungen berücksichtigen, darunter unter anderem die klinische Behandlung, die Alltagsbewältigung und das Berufsleben.</items><items id="description">Beurteilung der Auswirkungen eines Eingriffs oder seines Ergebnisses für einen bestimmten Patienten.</items><items id="text">Auswirkungen</items></items><items code="at0072"><items id="comment">*For example: An operation with curative intent may be planned, while during the operation it is discovered that curative treatment is not possible and the operation is carried out with a palliative intent instead. Coding of the 'Intent' with a terminology is recommended, if available. This data element allows multiple occurrences to enable the user to record multiple responses, if required.(en)</items><items id="description">*The intended outcome of the procedure.(en)</items><items id="text">*Intent(en)</items></items><items code="at0073"><items id="comment">*For example: the knife to skin time. Only for use in association with the 'Procedure performed', 'Procedure suspended', 'Procedure aborted' or 'Procedure completed' pathway steps. This may be the same as the RM 'time' attribute for the 'Procedure commenced' pathway step.(en)</items><items id="description">*The date or datetime when the entire procedure, or the first component of a multicomponent procedure, was first started.(en)</items><items id="text">*Start datetime(en)</items></items><items code="at0074"><items id="description">*The duration of time between the start of the most recent pathway step for this procedure and the start of the current pathway step.(en)</items><items id="text">*Pathway step duration(en)</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">A clinical activity carried out for screening, investigative, diagnostic, curative, therapeutic, evaluative or palliative purposes.</items><items id="text">Procedure</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">Coding of the 'Procedure name' with a terminology is recommended, if available.</items><items id="description">Identification of the procedure by name.</items><items id="text">Procedure name</items></items><items code="at0003"><items id="comment">Use to capture detailed, structured information about anatomical location, method &amp; technique, equipment used, devices implanted, results, findings etc.</items><items id="description">Structured information about the procedure.</items><items id="text">Procedure detail</items></items><items code="at0004"><items id="description">The procedure to be undertaken is planned.</items><items id="text">Procedure planned</items></items><items code="at0005"><items id="description">Additional narrative about the procedure or care pathway step not captured in other fields.</items><items id="text">Comment</items></items><items code="at0006"><items id="comment">Use this data element to record simple terms or precoordinated complications. For example: Hematuria after a kidney biopsy, tissue irritation after insertion of intravenous catheter. If the requirements for recording complication are more complex then use of a specific CLUSTER archetype within the 'Procedure detail' SLOT in this archetype is advised and this data element becomes redundant.</items><items id="description">Details about any complication arising from the procedure.</items><items id="text">Complication</items></items><items code="at0007"><items id="description">Request for procedure sent.</items><items id="text">Procedure request sent</items></items><items code="at0014"><items id="comment">For example: the reason for the cancellation or suspension of the procedure.</items><items id="description">Reason that the activity or care pathway step for the identified procedure was carried out.</items><items id="text">Reason</items></items><items code="at0034"><items id="comment">(Was: The procedure to be undertaken is planned.)</items><items id="description">This pathway step has been deprecated as it was incorrectly associated with 'initial' status - use the new 'Procedure planned' (at0004) pathway step  which is correctly associated with 'planned' status.</items><items id="text">X - Procedure planned</items></items><items code="at0035"><items id="comment">(Was: Request for procedure sent.)</items><items id="description">This pathway step has been deprecated as it was incorrectly associated with 'initial' status - use the new 'Procedure request sent' (at0007) pathway step  which is correctly associated with 'planned' status.</items><items id="text">X - Procedure request sent</items></items><items code="at0036"><items id="description">The procedure has been scheduled.</items><items id="text">Procedure scheduled</items></items><items code="at0038"><items id="description">The procedure has been postponed.</items><items id="text">Procedure postponed</items></items><items code="at0039"><items id="description">The planned procedure has been cancelled prior to commencement.</items><items id="text">Procedure cancelled</items></items><items code="at0040"><items id="description">The procedure has been suspended.</items><items id="text">Procedure suspended</items></items><items code="at0041"><items id="description">The procedure has been aborted.</items><items id="text">Procedure aborted</items></items><items code="at0043"><items id="description">The procedure has been performed and all associated clinical activities completed.</items><items id="text">Procedure completed</items></items><items code="at0047"><items id="description">The procedure, or subprocedure in a multicomponent procedure, has been performed.</items><items id="text">Procedure performed</items></items><items code="at0048"><items id="comment">Coding of the 'Outcome' with a terminology is recommended, if available.</items><items id="description">Outcome of procedure performed.</items><items id="text">Outcome</items></items><items code="at0049"><items id="comment">For example: description about the performance and findings from the the procedure, the aborted attempt or the cancellation of the procedure.</items><items id="description">Narrative description about the procedure, as appropriate for the pathway step.</items><items id="text">Description</items></items><items code="at0053"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0054"><items id="comment">This is equivalent to Placer Order Number in HL7 v2 specifications.</items><items id="description">The local ID assigned to the order by the healthcare provider or organisation requesting the service.</items><items id="text">Requestor order identifier</items></items><items code="at0055"><items id="description">Details about the healthcare provider or organisation requesting the service.</items><items id="text">Requestor</items></items><items code="at0056"><items id="comment">This is equivalent to Filler Order Number in HL7 v2 specifications.</items><items id="description">The ID assigned to the order by the healthcare provider or organisation receiving the request for service. This is also referred to as Filler Order Identifier.</items><items id="text">Receiver order identifier</items></items><items code="at0057"><items id="description">Details about the healthcare provider or organisation receiving the request for service.</items><items id="text">Receiver</items></items><items code="at0058"><items id="comment">Coding of the 'Urgency' with a terminology is recommended, if available.</items><items id="description">Urgency of the procedure.</items><items id="text">Urgency</items></items><items code="at0060"><items id="comment">Only for use in association with the 'Procedure performed' pathway step, and in situations where the procedure is repeated on multiple occasions before being completed or there are multiple components to the whole procedure. This may be the same as the RM time attribute for the 'Procedure completed' pathway step.</items><items id="description">The date or datetime when the entire procedure, or the last component of a multicomponent procedure, was finished.</items><items id="text">End datetime</items></items><items code="at0061"><items id="comment">Only for use in association with the 'Procedure completed' pathway steps.</items><items id="description">The total amount of time taken to complete the procedure, which may include time spent during the active phase of the procedure plus time during which the procedure was suspended.</items><items id="text">Total duration</items></items><items code="at0062"><items id="description">Mulitimedia representation of a performed procedure.</items><items id="text">Multimedia</items></items><items code="at0063"><items id="comment">Occurrences for this data element are unbounded to allow for clinical scenarios such as removing multiple skin lesions in different places, but where all of the other attributes are identical. Use this data element to record simple terms or precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Procedure detail' SLOT in this archetype. If the anatomical location is included in the 'Procedure name' via precoordinated codes, this data element becomes redundant.</items><items id="description">Identification of the body site for the procedure.</items><items id="text">Body site</items></items><items code="at0064"><items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items><items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items><items id="text">Extension</items></items><items code="at0065"><items id="comment">Use this data element to record simple terms or a narrative description. If the requirements for recording the method require more complex modelling then this can be represented by additional archetypes within the 'Procedure detail' SLOT in this archetype. If the method is included in the 'Procedure name' via precoordinated codes, this data element becomes redundant.</items><items id="description">Identification of specific method or technique for the procedure.</items><items id="text">Method</items></items><items code="at0066"><items id="comment">Only for use in association with the 'Procedure scheduled' pathway step.</items><items id="description">The date or datetime on which the procedure is intended to be performed.</items><items id="text">Scheduled datetime</items></items><items code="at0067"><items id="comment">This pragmatic data element may be used to support organisation within the user interface.</items><items id="description">The type of procedure.</items><items id="text">Procedure type</items></items><items code="at0068"><items id="description">The procedure, or subprocedure in a multicomponent procedure, has been commenced.</items><items id="text">Procedure commenced</items></items><items code="at0069"><items id="comment">Examples: The patient was agitated, insufficient emptying of the stomach before gastroscopy, a tumour in the bile ducts made it impossible to pass the scope through.</items><items id="description">Difficulties or issues encountered during performance of the procedure.</items><items id="text">Procedural difficulty</items></items><items code="at0070"><items id="comment">For example: 'Failed bowel preparation' or 'Bowel cancer screening'. Coding of the 'Indication' with a terminology is recommended, if available.  This data element allows multiple occurrences to enable the user to record multiple responses, if required.</items><items id="description">The clinical or process-related reason for the procedure.</items><items id="text">Indication</items></items><items code="at0071"><items id="comment">The same procedure, with the same severity or outcome, can have a different impact on each patient. This relevance factor involves adjusting the overall impact of that procedure or outcome according to the patient's characteristics.&#13;
&#13;
For example: Two patients have undergone the same procedure with the same outcome: osteosynthesis repair of the fifth finger of their non-dominant hand.&#13;
&#13;
One is a gardener or construction worker; the other, a pianist.&#13;
&#13;
The impact of that procedure on the pianist is GREATER (longer sick leave, need for full functional rehabilitation to adapt to the high fine motor demands of work).&#13;
&#13;
This element is intended to allow for multiple types of impact, including but not limited to: clinical treatment, home functioning, or work life.</items><items id="description">Assessment of the impact of a procedure or its outcome for a specific patient.</items><items id="text">Impact</items></items><items code="at0072"><items id="comment">For example: An operation with curative intent may be planned, while during the operation it is discovered that curative treatment is not possible and the operation is carried out with a palliative intent instead. Coding of the 'Intent' with a terminology is recommended, if available. This data element allows multiple occurrences to enable the user to record multiple responses, if required.</items><items id="description">The intended outcome of the procedure.</items><items id="text">Intent</items></items><items code="at0073"><items id="comment">For example: the knife to skin time. Only for use in association with the 'Procedure performed', 'Procedure suspended', 'Procedure aborted' or 'Procedure completed' pathway steps. This may be the same as the RM 'time' attribute for the 'Procedure commenced' pathway step.</items><items id="description">The date or datetime when the entire procedure, or the first component of a multicomponent procedure, was first started.</items><items id="text">Start datetime</items></items><items code="at0074"><items id="description">The duration of time between the start of the most recent pathway step for this procedure and the start of the current pathway step.</items><items id="text">Pathway step duration</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="description">Actividad clínica llevada a cabo con fines de cribado, investigación, diagnóstico, curativos, terapéuticos, de evaluación o paliativos.</items><items id="text">Procedimiento</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*Coding of the 'Procedure name' with a terminology is recommended, if available. (en)</items><items id="description">Identificación del procedimiento por su nombre.</items><items id="text">Nombre del procedimiento</items></items><items code="at0003"><items id="comment">Se utiliza para recopilar información detallada y estructurada sobre la localización anatómica, el método y la técnica, el equipo utilizado, los dispositivos implantados, los resultados, los hallazgos, etc.</items><items id="description">Información estructurada sobre el procedimiento.</items><items id="text">Detalles del procedimiento</items></items><items code="at0004"><items id="description">Se planifica el procedimiento a llevar a cabo.</items><items id="text">Procedimiento planificado</items></items><items code="at0005"><items id="description">*Additional narrative about the procedure or care pathway step not captured in other fields. (en)</items><items id="text">Comentarios</items></items><items code="at0006"><items id="comment">*Use this data element to record simple terms or precoordinated complications. For example: Hematuria after a kidney biopsy, tissue irritation after insertion of intravenous catheter. If the requirements for recording complication are more complex then use of a specific CLUSTER archetype within the 'Procedure detail' SLOT in this archetype is advised and this data element becomes redundant. (en)</items><items id="description">Detalles sobre cualquier complicación derivada del procedimiento.</items><items id="text">Complicación</items></items><items code="at0007"><items id="description">Solicitud de procedimiento enviada.</items><items id="text">Solicitud de procedimiento enviada</items></items><items code="at0014"><items id="comment">Por ejemplo: motivo de la cancelación o suspensión del procedimiento.</items><items id="description">Motivo por el que se llevó a cabo la actividad o etapa asistencial para el procedimiento identificado.</items><items id="text">Motivo</items></items><items code="at0034"><items id="comment">(Obsoleto: Se planifica el procedimiento a llevar a cabo.)</items><items id="description">Este apartado ha quedado obsoleto, ya que se asociaba incorrectamente con el estado "inicial". Utilice el nuevo apartado "Procedimiento planificado" (at0004), asociado correctamente con el estado "planificado".</items><items id="text">X - Procedimiento planificado</items></items><items code="at0035"><items id="comment">(Obsoleto: Solicitud de procedimiento enviada.)</items><items id="description">Este apartado ha quedado obsoleto, ya que se asociaba incorrectamente con el estado "inicial". Utilice el nuevo apartado "Solicitud de procedimiento enviada" (at0004), asociado correctamente con el estado "planificado".</items><items id="text">X - Solicitud de procedimiento enviada</items></items><items code="at0036"><items id="description">Se ha programado el procedimiento.</items><items id="text">Procedimiento programado</items></items><items code="at0038"><items id="description">El procedimiento se ha pospuesto.</items><items id="text">Procedimiento pospuesto</items></items><items code="at0039"><items id="description">El procedimiento previsto se ha cancelado antes de comenzar.</items><items id="text">Procedimiento cancelado</items></items><items code="at0040"><items id="description">Se ha suspendido el procedimiento.</items><items id="text">Procedimiento suspendido</items></items><items code="at0041"><items id="description">Se ha interrumpido el procedimiento.</items><items id="text">Procedimiento interrumpido</items></items><items code="at0043"><items id="description">Se ha realizado el procedimiento y se han completado todas las actividades clínicas asociadas.</items><items id="text">Procedimiento completado</items></items><items code="at0047"><items id="description">El procedimiento, o subprocedimiento en un procedimiento multicomponente, se ha realizado.</items><items id="text">Procedimiento realizado</items></items><items code="at0048"><items id="comment">*Coding of the 'Outcome' with a terminology is recommended, if available. (en)</items><items id="description">Resultado del procedimiento realizado.</items><items id="text">Resultado</items></items><items code="at0049"><items id="comment">Por ejemplo: descripción de la realización y los resultados del procedimiento, el intento interrumpido o la cancelación del procedimiento.</items><items id="description">Descripción narrativa sobre el procedimiento, según corresponda a la fase del proceso.</items><items id="text">Descripción</items></items><items code="at0053"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0054"><items id="comment">Equivalente al Placer Order Number en las especificaciones HL7 v2.</items><items id="description">El ID local asignado a la orden por el proveedor sanitario o la organización que solicita el servicio.</items><items id="text">Identificador de orden del solicitante</items></items><items code="at0055"><items id="description">Datos del profesional sanitario u organización que solicita el servicio.</items><items id="text">Solicitante</items></items><items code="at0056"><items id="comment">Equivalente al Placer Order Number en las especificaciones HL7 v2.</items><items id="description">El identificador asignado a la orden por el proveedor sanitario o la organización que recibe la solicitud de servicio. También se denomina Identificador de Orden de Cumplimentación.</items><items id="text">Identificador de orden del receptor</items></items><items code="at0057"><items id="description">Datos sobre el proveedor u organización sanitaria que recibe la solicitud de servicio.</items><items id="text">Receptor</items></items><items code="at0058"><items id="comment">*Coding of the 'Urgency' with a terminology is recommended, if available. (en)</items><items id="description">Urgencia del procedimiento.</items><items id="text">Urgencia</items></items><items code="at0060"><items id="comment">Sólo para su uso en asociación con la etapa "Procedimiento realizado", y en situaciones en las que el procedimiento se repite en varias ocasiones antes de completarse, o hay varios componentes en todo el procedimiento. Puede ser el mismo que el atributo de tiempo RM de la etapa "Procedimiento completado".</items><items id="description">*The date or datetime when the entire procedure, or the last component of a multicomponent procedure, was finished. (en)</items><items id="text">*End datetime (en)</items></items><items code="at0061"><items id="comment">Sólo para su uso en asociación con la etapa "Procedimiento completado".</items><items id="description">Cantidad total de tiempo empleado en completar el procedimiento, que puede incluir el tiempo empleado durante la fase activa del procedimiento más el tiempo durante el cual el procedimiento estuvo suspendido.</items><items id="text">Duración</items></items><items code="at0062"><items id="description">Representación multimedia del procedimiento realizado.</items><items id="text">Multimedia</items></items><items code="at0063"><items id="comment">Las ocurrencias de este elemento de datos son ilimitadas para permitir escenarios clínicos como la extirpación de múltiples lesiones cutáneas en diferentes lugares, pero donde todos los demás atributos son idénticos. Utilice este elemento de datos para registrar términos sencillos o localizaciones anatómicas precoordinadas. Si los requisitos para registrar la localización anatómica se determinan en tiempo de ejecución por la aplicación o requieren un modelado más complejo, como localizaciones relativas, utilice CLUSTER.anatomical_location o CLUSTER.relative_location en el SLOT "Detalles del procedimiento" de este arquetipo. Si la localización anatómica se incluye en el "Nombre del procedimiento" mediante códigos precoordinados, este elemento de datos será redundante.</items><items id="description">Identificación de la zona del cuerpo para el procedimiento.</items><items id="text">Zona corporal</items></items><items code="at0064"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Ampliación</items></items><items code="at0065"><items id="comment">Utilice este elemento de datos para registrar términos sencillos o una descripción narrativa. Si los requisitos para registrar el método requieren una modelización más compleja, ésta puede representarse mediante arquetipos adicionales dentro del SLOT "Detalle del procedimiento", de este arquetipo. Si el método se incluye en el "Nombre del procedimiento" mediante códigos precoordinados, este elemento de datos será redundante.</items><items id="description">Identificación del método o técnica específicos para el procedimiento.</items><items id="text">Método</items></items><items code="at0066"><items id="comment">Sólo para su uso en asociación con la etapa "Procedimiento programado".</items><items id="description">*The date or datetime on which the procedure is intended to be performed. (en)</items><items id="text">*Scheduled datetime (en)</items></items><items code="at0067"><items id="comment">Este elemento de datos puede utilizarse para dar soporte a la organización dentro de la interfaz de usuario.</items><items id="description">Tipo de procedimiento.</items><items id="text">Tipo de procedimiento</items></items><items code="at0068"><items id="description">El procedimiento, o subprocedimiento en un procedimiento multicomponente, se ha iniciado.</items><items id="text">Procedimiento iniciado</items></items><items code="at0069"><items id="comment">Ejemplos: El paciente estaba agitado, vaciado insuficiente del estómago antes de la gastroscopia, un tumor en las vías biliares impedía el paso del endoscopio.</items><items id="description">Dificultades o problemas encontrados durante la realización del procedimiento.</items><items id="text">Dificultades del procedimiento</items></items><items code="at0070"><items id="comment">*For example: 'Failed bowel preparation' or 'Bowel cancer screening'. Coding of the 'Indication' with a terminology is recommended, if available.  This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">El motivo, clínico o relacionado con el proceso, del procedimiento.</items><items id="text">Indicación</items></items><items code="at0071"><items id="comment">El mismo procedimiento, con la misma gravedad o resultado, puede tener un impacto diferente en cada paciente. Este factor de relevancia implica ajustar el impacto general de ese procedimiento o de su resultado, según las características del paciente.&#13;
Por ejemplo: Dos pacientes se han sometido al mismo procedimiento con el mismo resultado. Reparación mediante osteosíntesis de quinto dedo de mano no dominante. &#13;
&#13;
Uno es una jardinero o un peon de obra; el otro, un pianista.&#13;
El impacto de ese procedimiento en el pianista es MAYOR (baja laboral mas larga, necesidad de rehabilitación funcional completa para ajustar a altos requerimientos de motricidad fina en actividad laboral ).&#13;
Este elemento está destinado a permitir múltiples tipos de impacto, incluidos pero no limitado a: tratamiento clínico, funcionamiento en el hogar o vida laboral.</items><items id="description">Evaluación global del impacto o relevancia de un procedimiento o su resultado para un paciente concreto.</items><items id="text">Impacto</items></items><items code="at0072"><items id="comment">*For example: An operation with curative intent may be planned, while during the operation it is discovered that curative treatment is not possible and the operation is carried out with a palliative intent instead. Coding of the 'Intent' with a terminology is recommended, if available. This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">*The intended outcome of the procedure. (en)</items><items id="text">*Intent (en)</items></items><items code="at0073"><items id="comment">*For example: the knife to skin time. Only for use in association with the 'Procedure performed', 'Procedure suspended', 'Procedure aborted' or 'Procedure completed' pathway steps. This may be the same as the RM 'time' attribute for the 'Procedure commenced' pathway step. (en)</items><items id="description">*The date or datetime when the entire procedure, or the first component of a multicomponent procedure, was first started. (en)</items><items id="text">*Start datetime (en)</items></items><items code="at0074"><items id="description">*The duration of time between the start of the most recent pathway step for this procedure and the start of the current pathway step. (en)</items><items id="text">*Pathway step duration (en)</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">En klinisk aktivitet som er utført i undersøkende, diagnostisk, kurativ, terapeutisk, evaluerende, prognostisk eller palliativ hensikt.</items><items id="text">Prosedyre</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">Det anbefales å kode "Prosedyrenavn" med en terminologi, om mulig.</items><items id="description">Navnet på prosedyren.</items><items id="text">Prosedyrenavn</items></items><items code="at0003"><items id="comment">Bruk for å registrere detaljert, strukturert informasjon om anatomisk lokalisering, metode og teknikker, utstyr som ble benyttet, medisinsk utstyr som ble implantert, funn, etc.</items><items id="description">Strukturert informasjon om prosedyren.</items><items id="text">Prosedyredetaljer</items></items><items code="at0004"><items id="description">Prosedyren er planlagt.</items><items id="text">Prosedyre planlagt</items></items><items code="at0005"><items id="description">Ytterligere fritekst om prosedyren eller prosesstrinnet som ikke er registrert i andre felt.</items><items id="text">Kommentar</items></items><items code="at0006"><items id="comment">Bruk dette dataelementet til å registrere enkle termer eller prekoordinerte komplikasjoner. For eksempel hematuri etter nyrebiopsi eller vevsirritasjon etter innlegging av intravenøst kateter. Dersom kravene til registrering av komplikasjoner er mer komplekse, anbefales bruk av en spesifikk CLUSTER‑arketype i "Prosedyredetaljer"-SLOTet i denne arketypen, og dette dataelementet blir da overflødig.</items><items id="description">Detaljer om komplikasjoner oppstått under gjennomføring av prosedyren.</items><items id="text">Komplikasjon</items></items><items code="at0007"><items id="description">Det er sendt rekvisisjon for prosedyren.</items><items id="text">Prosedyrerekvisisjon sendt</items></items><items code="at0014"><items id="comment">For eksempel grunnen til at prosedyren ble avlyst eller midlertidig stanset.</items><items id="description">Begrunnelse for at aktiviteten eller prosesstrinnet for den aktuelle prosedyren ble utført.</items><items id="text">Begrunnelse</items></items><items code="at0034"><items id="comment">(Var: Prosedyren er planlagt.)</items><items id="description">Dette prosesstrinnet er satt ut av bruk, siden det ved en feil hadde statusen "initial". Bruk det nye prosesstrinnet "Prosedyre planlagt" (at0004) som har den korrekte statusen "planned".</items><items id="text">X - Prosedyre planlagt</items></items><items code="at0035"><items id="comment">(Var: Det er sendt rekvisisjon for prosedyren.)</items><items id="description">Dette prosesstrinnet er satt ut av bruk, siden det ved en feil hadde statusen "initial". Bruk det nye prosesstrinnet "Prosedyre planlagt" (at0007) som har den korrekte statusen "planned".</items><items id="text">X - Prosedyrerekvisisjon sendt</items></items><items code="at0036"><items id="description">Tidspunkt for prosedyre er fastsatt.</items><items id="text">Fastsatt tidspunkt for prosedyre</items></items><items code="at0038"><items id="description">Prosedyren er utsatt.</items><items id="text">Prosedyre utsatt</items></items><items code="at0039"><items id="description">Den planlagte prosedyren har blitt avlyst før den ble igangsatt.</items><items id="text">Prosedyre avlyst</items></items><items code="at0040"><items id="description">Prosedyren er suspendert/ midlertidig stanset.</items><items id="text">Prosedyre midlertidig stanset</items></items><items code="at0041"><items id="description">Prosedyren har blitt avbrutt.</items><items id="text">Prosedyre avbrutt</items></items><items code="at0043"><items id="description">Prosedyren er utført og alle tilknyttede kliniske handlinger er fullførte.</items><items id="text">Prosedyre fullført</items></items><items code="at0047"><items id="description">Prosedyren eller en del av en prosedyre som består av flere delprosedyrer er utført.</items><items id="text">Prosedyre utført</items></items><items code="at0048"><items id="comment">Det anbefales å kode "Resultat" med en terminologi, om mulig.</items><items id="description">Resultatet av den utførte prosedyren.</items><items id="text">Resultat</items></items><items code="at0049"><items id="comment">For eksempel en beskrivelse av utførelsen og funnene fra prosedyren, det avbrutte forsøket, eller avlysningen av prosedyren.</items><items id="description">Fritekstbeskrivelse av prosedyren, tilpasset det aktuelle prosesstrinnet.</items><items id="text">Beskrivelse</items></items><items code="at0053"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0054"><items id="comment">Tilsvarer "Placer Order Number" i HL7 v2-spesifikasjonene.</items><items id="description">Den lokale IDen tilordnet rekvisisjonen av helsepersonellet eller organisasjonen som rekvirerer prosedyren.</items><items id="text">Rekvisisjonsidentifikator</items></items><items code="at0055"><items id="description">Detaljer om helsepersonellet eller organisasjonen som har rekvirert prosedyren.</items><items id="text">Rekvirent</items></items><items code="at0056"><items id="comment">Tilsvarer "Filler Order Number" i HL7 v2-spesifikasjonene.</items><items id="description">IDen tilordnet rekvisisjonen av helsepersonellet eller organisasjonen som mottar rekvisisjonen.</items><items id="text">Mottakers rekvisisjonsidentifikator</items></items><items code="at0057"><items id="description">Detaljer om helsepersonellet eller organisasjonen som mottar prosedyrerekvisisjonen.</items><items id="text">Mottaker</items></items><items code="at0058"><items id="comment">Det anbefales å kode "Hastegrad" med en terminologi, om mulig.</items><items id="description">Prosedyrens hastegrad.</items><items id="text">Hastegrad</items></items><items code="at0060"><items id="comment">Kun for bruk i forbindelse med prosesstrinnet "Prosedyre utført" og i situasjoner der prosedyren gjentas flere ganger før den fullføres, eller det finnes flere komponenter i prosedyren. Dette kan være det samme som RM-attributtet "time" for prosesstrinnet "Prosedyre utført".</items><items id="description">Dato eller datotid da hele prosedyren, eller den siste komponenten i en flerkomponentprosedyre, ble avsluttet.</items><items id="text">Slutt datotid</items></items><items code="at0061"><items id="comment">Kun for bruk i forbindelse med prosesstrinnet "Prosedyre fullført".</items><items id="description">Den totale tiden som ble brukt til å fullføre prosedyren. Dette kan omfatte tidsbruk under den aktive fasen av prosedyren, og i tillegg tid da prosedyren var midlertidig stanset.</items><items id="text">Total varighet</items></items><items code="at0062"><items id="description">Multimediarepresentasjon av en utført prosedyre.</items><items id="text">Multimedia</items></items><items code="at0063"><items id="comment">Forekomster for dette dataelementet er satt ubegrenset for å tillate kliniske scenarier som f.eks. å fjerne flere hudlesjoner på forskjellige steder, men der alle de andre attributtene er identiske. Bruk dette dataelementet til å registrere enkle termer eller prekoordinerte anatomiske lokaliseringer. Dersom behovene for registrering av anatomisk lokalisering bestemmes først av applikasjonen eller krever mer kompleks modellering som f.eks. relative lokaliseringer, kan arketypene CLUSTER.anatomical_location eller CLUSTER.relative_location brukes i SLOTet "Prosedyredetaljer" i denne arketypen. Dersom den anatomiske lokaliseringen inkluderes som en del av "Prosedyrenavn"-elementet ved hjelp av prekoordinerte koder blir dette dataelementet overflødig.</items><items id="description">Stedet på kroppen der prosedyren er utført.</items><items id="text">Kroppssted</items></items><items code="at0064"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller eller formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at0065"><items id="comment">Bruk dette dataelementet til å registrere enkle termer eller en fritekstlig beskrivelse. Dersom behovene for beskrivelse av metoden krever mer kompleks modellering, kan dette representeres ved hjelp av tilleggsarketyper i SLOTet "Prosedyredetaljer" i denne arketypen. Dersom metoden inkluderes som en del av "Prosedyrenavn"-elementet ved hjelp av prekoordinerte koder blir dette dataelementet overflødig.</items><items id="description">Den spesifikke metoden eller teknikken for prosedyren.</items><items id="text">Metode</items></items><items code="at0066"><items id="comment">Kun til bruk i forbindelse med prosesstrinnet "Fastsatt tidspunkt for prosedyre".</items><items id="description">Dato eller datotid for når prosedyren er planlagt utført.</items><items id="text">Planlagt datotid</items></items><items code="at0067"><items id="comment">Dette dataelementet kan brukes til å støtte organisering innenfor brukergrensesnittet.</items><items id="description">Typen prosedyre.</items><items id="text">Prosedyretype</items></items><items code="at0068"><items id="description">Prosedyren eller en del av en prosedyre som består av flere delprosedyrer er påbegynt.</items><items id="text">Prosedyre påbegynt</items></items><items code="at0069"><items id="comment">Eksempler: Pasienten var urolig, magen var ikke skikkelig tømt før gastroskopi, en svulst i gallegangene gjorde det umulig å få skopet gjennom.</items><items id="description">Vanskeligheter eller problemer som det ble støtt på under prosedyren.</items><items id="text">Problem ved prosedyre</items></items><items code="at0070"><items id="comment">For eksempel "Mislykket tarmtømming" eller "Tarmkreftscreening". Det anbefales å kode "Indikasjon" med en terminologi, om mulig. Dette dataelementet tillater flere forekomster, for å tillate brukeren å registrere flere svar ved behov.</items><items id="description">Den kliniske eller prosessrelaterte årsaken til prosedyren.</items><items id="text">Indikasjon</items></items><items code="at0071"><items id="comment">Samme prosedyre, med samme alvorlighetsgrad eller utfall, kan ha ulik konsekvens for hver enkelt pasient. Denne relevansfaktoren innebærer å justere den samlede påvirkningen av prosedyren eller utfallet i henhold til pasientens individuelle kjennetegn.&#13;
&#13;
For eksempel: To pasienter har gjennomgått samme prosedyre med samme resultat: osteosyntese av femte finger på ikke-dominant hånd.&#13;
&#13;
Den ene er gartner eller bygningsarbeider, den andre er pianist.&#13;
&#13;
Inngrepets konsekvens for pianisten er STØRRE (lengre sykmelding, behov for full funksjonell rehabilitering for å tilpasse seg de høye kravene til finmotorikk i arbeidet).&#13;
&#13;
Dette elementet er ment å ta høyde for flere typer konsekvenser, inkludert klinisk behandling, funksjon i hjemmet og arbeidsliv.</items><items id="description">Vurdering av prosedyrens konsekvens eller resultat for individet.</items><items id="text">Konsekvens</items></items><items code="at0072"><items id="comment">For eksempel kan en operasjon planlegges med kurativ hensikt, men under operasjonen blir det oppdaget at kurativ behandling ikke er mulig, og operasjonen utføres med palliativ hensikt i stedet. Det anbefales å kode "Hensikt" med en terminologi, om mulig. Dette dataelementet tillater flere forekomster, for å tillate brukeren å registrere flere svar ved behov.</items><items id="description">Det ønskede resultatet av prosedyren.</items><items id="text">Hensikt</items></items><items code="at0073"><items id="comment">For eksempel tidspunktet for første snitt. Kun til bruk i sammenheng med prosesstrinnene "Prosedyre utført", "Prosedyre midlertidig stanset", "Prosedyre avbrutt" eller "Prosedyre fullført". Dette kan være det samme som RM-attributtet "time" for prosesstrinnet "Prosedyre påbegynt".</items><items id="description">Dato eller datotid da hele prosedyren, eller den første komponenten i en flerkomponentprosedyre, først ble startet.</items><items id="text">Start datotid</items></items><items code="at0074"><items id="description">Tidsrommet mellom starten på det forrige prosesstrinnet for denne prosedyren og starten på gjeldende prosesstrinn.</items><items id="text">Varighet av prosesstrinn</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="description">A atividade clínica realizada para rastreamento , investigação , diagnóstico , cura , terapêutica, avaliação ou finalidade paliativos.</items><items id="text">Procedimento</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*Coding of the 'Procedure name' with a terminology is recommended, if available. (en)</items><items id="description">Identificação do procedimento pelo nome.</items><items id="text">Nome do procedimento</items></items><items code="at0003"><items id="comment">Use para capturar informações detalhadas , estruturadas sobre a localização anatômica , método e técnica , os equipamentos utilizados , dispositivos implantados , os resultados , as conclusões, etc.</items><items id="description">São as informações estruturadas sobre o procedimento.</items><items id="text">Detalhes do Procedimento</items></items><items code="at0004"><items id="description">*</items><items id="text">*Procedure planned (en)</items></items><items code="at0005"><items id="description">*Additional narrative about the procedure or care pathway step not captured in other fields. (en)</items><items id="text">Comentários</items></items><items code="at0006"><items id="comment">*Use this data element to record simple terms or precoordinated complications. For example: Hematuria after a kidney biopsy, tissue irritation after insertion of intravenous catheter. If the requirements for recording complication are more complex then use of a specific CLUSTER archetype within the 'Procedure detail' SLOT in this archetype is advised and this data element becomes redundant. (en)</items><items id="description">Detalhes sobre alguma complicação decorrente do procedimento</items><items id="text">Complicações</items></items><items code="at0007"><items id="description">*</items><items id="text">*Procedure request sent (en)</items></items><items code="at0014"><items id="comment">Por exemplo: o motivo do cancelamento ou suspensão de um procedimento.</items><items id="description">Razão pela qual a atividade ou cuidado foi identificada para que o procedimento fosse realizado.</items><items id="text">Justificativa</items></items><items code="at0034"><items id="description">O procedimento a ser realizado é planejado</items><items id="text">Plano de procedimento</items></items><items code="at0035"><items id="description">Pedido de procedimento enviado.</items><items id="text">Procedimento pedido enviado</items></items><items code="at0036"><items id="description">O procedimento foi agendado.</items><items id="text">Procedimento agendado</items></items><items code="at0038"><items id="description">O procedimento foi adiado.</items><items id="text">Procedimento adiado</items></items><items code="at0039"><items id="description">O procedimento planejado foi cancelado antes do início.</items><items id="text">Procedimento cancelado</items></items><items code="at0040"><items id="description">O procedimento foi suspenso.</items><items id="text">Procedimento suspenso</items></items><items code="at0041"><items id="description">O procedimento foi abortado.</items><items id="text">Procedimento abortado</items></items><items code="at0043"><items id="description">O procedimento foi realizado e todas as atividades clínicas associadas concluídas.</items><items id="text">Procedimento concluído</items></items><items code="at0047"><items id="description">O procedimento, ou procedimento secundário no caso de procedimentos sequenciado, foi realizado.</items><items id="text">Procedimento realizado</items></items><items code="at0048"><items id="comment">*Coding of the 'Outcome' with a terminology is recommended, if available. (en)</items><items id="description">Resultado do procedimento realizado.</items><items id="text">Resultado</items></items><items code="at0049"><items id="comment">Por exemplo : Descrição sobre o desempenho e os resultados do procedimento, a tentativa abortada ou a anulação do procedimento.</items><items id="description">Descrição narrativa sobre o procedimento, conforme apropriado para a etapa.</items><items id="text">Descrição</items></items><items code="at0053"><items id="description">@ internal @</items><items id="text">Tree(en)</items></items><items code="at0054"><items id="comment">Isto é equivalente ao "Placer Order Number" nas especificações do HL7 v2.</items><items id="description">O ID local atribuído ao pedido realizado pelo profissional de saúde ou organização solicitando o serviço.</items><items id="text">Identificador do pedido do solicitante</items></items><items code="at0055"><items id="description">Detalhes sobre o profissional ou organização de saúde que solicitou o serviço.</items><items id="text">Solicitante</items></items><items code="at0056"><items id="comment">Isto é equivalente ao "Placer Order Number" nas especificações do HL7 v2.</items><items id="description">O ID atribuído ao pedido pelo provedor de cuidados de saúde ou organização que recebe o pedido de serviço. Isto é também relacionado ao preenchimento da identificação do pedido.</items><items id="text">Identificador do pedido do destinatário</items></items><items code="at0057"><items id="description">Detalhes sobre o profissional ou organização de saúde que recebeu o requerimento para o serviço.</items><items id="text">Destinatário</items></items><items code="at0058"><items id="comment">*Coding of the 'Urgency' with a terminology is recommended, if available. (en)</items><items id="description">Urgência do procedimento.</items><items id="text">Urgência</items></items><items code="at0060"><items id="comment">Apenas para utilização em associação com o "Procedimento realizado" da etapa, e em situações em que o procedimento é repetido em várias ocasiões antes de ser concluído ou houver vários componentes para todo o processo. Este pode ser o mesmo que o atributo para o tempo de RM "Processo concluído".</items><items id="description">*The date or datetime when the entire procedure, or the last component of a multicomponent procedure, was finished. (en)</items><items id="text">*End datetime (en)</items></items><items code="at0061"><items id="comment">Apenas para utilização em associação com o "Procedimento concluído".</items><items id="description">A quantidade total de tempo necessária para concluir o procedimento, o que pode incluir o tempo gasto durante a fase ativa do procedimento mais o tempo durante o qual o procedimento foi suspenso.</items><items id="text">Duração Total</items></items><items code="at0062"><items id="description">Representação multimídia de um procedimento realizado.</items><items id="text">Multimidia</items></items><items code="at0063"><items id="comment">Ocorrências para este elemento de dados são ilimitadas para permitir cenários clínicos, tais como a remoção de lesões da pele em múltiplos locais diferentes , mas em que todos os outros atributos são idênticos . Utilize este elemento de dados para gravar termos simples ou localizações anatômicas padrão. Se as condições de gravação da localização anatômica são determinados em tempo de execução pelo aplicativo ou exigir modelagem mais complexa, como localizações relativas , em seguida, usar o CLUSTER.anatomical_location ou CLUSTER.relative_location dentro do campo "detalhes do procedimento" neste arquétipo. Se a localização anatômica estiver incluída no "Nome do procedimento" através de códigos padronizados, este elemento de dados torna-se redundante.</items><items id="description">Identificação do local no corpo onde será realizado o procedimento.</items><items id="text">Localização no corpo</items></items><items code="at0064"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensão</items></items><items code="at0065"><items id="comment">Utilize este elemento de dados para registrar termos simples ou uma descrição narrativa . Se as condições de registro do método requer uma modelagem mais complexa , então isso pode ser representado por arquétipos adicionais dentro do campo "Detalhes do procedimento" deste arquétipo. Se o método está incluído no "Nome do procedimento" através de códigos padrão , este elemento de dados torna-se redundante.</items><items id="description">Identificação do método específico ou técnica do procedimento.</items><items id="text">Método</items></items><items code="at0066"><items id="comment">Apenas para utilização em associação com o " Procedimento Programado ' para a etapa em curso.</items><items id="description">*The date or datetime on which the procedure is intended to be performed. (en)</items><items id="text">*Scheduled datetime (en)</items></items><items code="at0067"><items id="comment">Esse elemento de dados pragmático pode ser usado para apoiar a organização dentro da interface do usuário.</items><items id="description">O tipo do procedimento.</items><items id="text">Tipo do procedimento</items></items><items code="at0068"><items id="description">O procedimento, ou procedimento secundário, no caso de procedimentos sequenciados, foi iniciado.</items><items id="text">Procedimento Iniciou</items></items><items code="at0069"><items id="description">*Difficulties or issues encountered during the procedure.(en)</items><items id="text">*Procedural difficulty(en)</items></items><items code="at0070"><items id="comment">*For example: 'Failed bowel preparation' or 'Bowel cancer screening'. Coding of the 'Indication' with a terminology is recommended, if available.  This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">*The clinical or process-related reason for the procedure. (en)</items><items id="text">*Indication (en)</items></items><items code="at0071"><items id="description"/><items id="text">*DV_TEXT (en)</items></items><items code="at0072"><items id="comment">*For example: An operation with curative intent may be planned, while during the operation it is discovered that curative treatment is not possible and the operation is carried out with a palliative intent instead. Coding of the 'Intent' with a terminology is recommended, if available. This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">*The intended outcome of the procedure. (en)</items><items id="text">*Intent (en)</items></items><items code="at0073"><items id="comment">*For example: the knife to skin time. Only for use in association with the 'Procedure performed', 'Procedure suspended', 'Procedure aborted' or 'Procedure completed' pathway steps. This may be the same as the RM 'time' attribute for the 'Procedure commenced' pathway step. (en)</items><items id="description">*The date or datetime when the entire procedure, or the first component of a multicomponent procedure, was first started. (en)</items><items id="text">*Start datetime (en)</items></items><items code="at0074"><items id="description">*The duration of time between the start of the most recent pathway step for this procedure and the start of the current pathway step. (en)</items><items id="text">*Pathway step duration (en)</items></items></term_definitions><term_definitions language="pt-pt"><items code="at0000"><items id="description">Atividade clínica realizada para fins de rastreio, investigação, diagnóstico, cura, tratamento, avaliação ou cuidados paliativos.</items><items id="text">Procedimento</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*Coding of the 'Procedure name' with a terminology is recommended, if available. (en)</items><items id="description">Identificação do procedimento pelo nome.</items><items id="text">Nome do procedimento</items></items><items code="at0003"><items id="comment">Use para capturar informações detalhadas e estruturadas sobre localização anatómica, método e técnica, equipamentos usados, dispositivos implantados, resultados, descobertas, etc.</items><items id="description">Informação estruturada sobre o procedimento.</items><items id="text">Detalhe do procedimento</items></items><items code="at0004"><items id="description">O procedimento a ser realizado está planeado.</items><items id="text">Procedimento Planeado</items></items><items code="at0005"><items id="description">*Additional narrative about the procedure or care pathway step not captured in other fields. (en)</items><items id="text">Comentário</items></items><items code="at0006"><items id="comment">*Use this data element to record simple terms or precoordinated complications. For example: Hematuria after a kidney biopsy, tissue irritation after insertion of intravenous catheter. If the requirements for recording complication are more complex then use of a specific CLUSTER archetype within the 'Procedure detail' SLOT in this archetype is advised and this data element becomes redundant. (en)</items><items id="description">Detalhes sobre qualquer complicação decorrente do procedimento.</items><items id="text">Complicação</items></items><items code="at0007"><items id="description">Pedido para o procedimento enviado.</items><items id="text">Pedido de procedimento enviado</items></items><items code="at0014"><items id="comment">Por exemplo: o motivo do cancelamento ou suspensão do procedimento.</items><items id="description">Motivo pelo qual foi realizada a etapa da atividade ou da via de cuidado para o procedimento identificado.</items><items id="text">Motivo</items></items><items code="at0034"><items id="comment">(Era: O procedimento a ser realizado está planeado.)</items><items id="description">Esta etapa de caminho foi preterida, pois foi incorretamente associada ao estado 'inicial' - use a nova etapa de caminho 'Procedimento planeado' (at0004) que está corretamente associada ao estado 'planeado'.</items><items id="text">X - Procedimento planeado</items></items><items code="at0035"><items id="comment">(Foi: Pedido de procedimento enviado.)</items><items id="description">Esta etapa de caminho foi preterida, pois foi incorretamente associada ao estado 'inicial' - use a nova etapa de caminho 'Pedido de procedimento enviado' (at0007) que está corretamente associada ao estado 'planeado'.</items><items id="text">X - Solicitação de procedimento enviada</items></items><items code="at0036"><items id="description">O procedimento foi agendado.</items><items id="text">Procedimento programado</items></items><items code="at0038"><items id="description">O procedimento foi adiado.</items><items id="text">Procedimento Adiado</items></items><items code="at0039"><items id="description">O procedimento previsto foi cancelado antes do início.</items><items id="text">Procedimento Cancelado</items></items><items code="at0040"><items id="description">O procedimento foi suspenso.</items><items id="text">Procedimento suspenso</items></items><items code="at0041"><items id="description">O procedimento foi abortado.</items><items id="text">Procedimento abortado</items></items><items code="at0043"><items id="description">O procedimento foi realizado e todas as atividades clínicas associadas foram concluídas.</items><items id="text">Procedimento concluído</items></items><items code="at0047"><items id="description">O procedimento, ou subprocedimento num procedimento com vários componentes, foi realizado.</items><items id="text">Procedimento realizado</items></items><items code="at0048"><items id="comment">*Coding of the 'Outcome' with a terminology is recommended, if available. (en)</items><items id="description">Resultado do procedimento realizado.</items><items id="text">Resultado</items></items><items code="at0049"><items id="comment">Por exemplo: descrição do desempenho e resultados do procedimento, da tentativa abortada ou do cancelamento do procedimento.</items><items id="description">Descrição narrativa sobre o procedimento, conforme apropriado para a etapa do caminho.</items><items id="text">Descrição</items></items><items code="at0053"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0054"><items id="comment">Isto é equivalente ao número de ordem Placer em HL7 v2 especificações.</items><items id="description">O documento de identificação local atribuído ao pedido pelo prestador de cuidados de saúde ou organização que solicita o serviço.</items><items id="text">Identificador do requerente do pedido</items></items><items code="at0055"><items id="description">Detalhes sobre o prestador de cuidados de saúde ou a organização que solicita o serviço.</items><items id="text">Requerente</items></items><items code="at0056"><items id="comment">Isso é equivalente ao número Filler Order Identifier nas especificações HL7 v2.</items><items id="description">O ID atribuído à encomenda pelo prestador de cuidados de saúde ou organização que recebe o pedido de serviço. Isto também é referido como Filler Order Identifier.</items><items id="text">Identificador do destinatário do pedido</items></items><items code="at0057"><items id="description">Informações sobre o prestador de cuidados de saúde ou a organização que recebe o pedido de assistência.</items><items id="text">Recetor</items></items><items code="at0058"><items id="comment">*Coding of the 'Urgency' with a terminology is recommended, if available. (en)</items><items id="description">Urgência do procedimento.</items><items id="text">Urgência</items></items><items code="at0060"><items id="comment">Apenas para utilização em associação com a etapa da via 'Procedimento realizado' e em situações em que o procedimento é repetido em várias ocasiões antes de ser concluído ou há vários componentes em todo o procedimento. Isso pode ser o mesmo que o atributo de tempo RM para a etapa de caminho 'Procedimento concluído'.</items><items id="description">*The date or datetime when the entire procedure, or the last component of a multicomponent procedure, was finished. (en)</items><items id="text">*End datetime (en)</items></items><items code="at0061"><items id="comment">Apenas para utilização em associação com as etapas do caminho 'Procedimento concluído'.</items><items id="description">O tempo total necessário para concluir o procedimento, que pode incluir o tempo gasto durante a fase ativa do procedimento e o tempo durante o qual o procedimento foi suspenso.</items><items id="text">Duração total</items></items><items code="at0062"><items id="description">Representação multimédia de um procedimento realizado.</items><items id="text">Multimédia</items></items><items code="at0063"><items id="comment">As ocorrências para este elemento de dados são ilimitadas para permitir cenários clínicos tais como a remoção de lesões de pele múltiplas em lugares diferentes, mas onde todos os outros atributos são idênticos. Use esse elemento de dados para registar termos simples ou localizações anatómicas pré-ordenadas. Se os requisitos para o registo da localização anatómica forem determinados no CLUSTER.anatomical_location ou CLUSTER.relative_location dentro do SLOT 'Detalhe do procedimento' neste arquétipo. Se a localização anatómica for incluída no 'Nome do procedimento' por meio de códigos pré-ordenados, esse elemento de dados ficará redundante.</items><items id="description">Identificação do local do corpo para o procedimento.</items><items id="text">Local do corpo</items></items><items code="at0064"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensão</items></items><items code="at0065"><items id="comment">Use esse elemento de dados para registar termos simples ou uma descrição narrativa. Se os requisitos para o registo do método exigirem uma modelagem mais complexa, isso pode ser representado por arquétipos adicionais dentro do SLOT 'Detalhes do procedimento' neste arquétipo. Se o método for incluído no 'Nome do procedimento' com códigos pré-ordenados, esse elemento de dados ficará redundante.</items><items id="description">Identificação do método ou técnica específica para o procedimento.</items><items id="text">Método</items></items><items code="at0066"><items id="comment">Apenas para utilização em associação com a etapa de caminho 'Procedimento agendado'.</items><items id="description">*The date or datetime on which the procedure is intended to be performed. (en)</items><items id="text">*Scheduled datetime (en)</items></items><items code="at0067"><items id="comment">Este elemento de dados pragmáticos pode ser usado para apoiar a organização dentro da interface do/a utilizador/a.</items><items id="description">O tipo de procedimento.</items><items id="text">Tipo de procedimento</items></items><items code="at0068"><items id="description">O procedimento, ou subprocedimento num procedimento com vários componentes, foi iniciado.</items><items id="text">Procedimento iniciado</items></items><items code="at0069"><items id="comment">Exemplos: O doente estava agitado, esvaziamento insuficiente do estômago antes da gastroscopia, um tumor nos ductos biliares impossibilitou a passagem da sonda.</items><items id="description">Dificuldades ou problemas encontrados durante a execução do procedimento.</items><items id="text">Dificuldade processual</items></items><items code="at0070"><items id="comment">*For example: 'Failed bowel preparation' or 'Bowel cancer screening'. Coding of the 'Indication' with a terminology is recommended, if available.  This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">A razão clínica ou relacionada ao processo para o procedimento.</items><items id="text">indicação</items></items><items code="at0071"><items id="comment">The same diagnosis, with the same severity, has a different impact on each patient. This relevance qualifier implies adjusting the overall impact of that health problem according to the patient's characteristics.&#13;
For example: Two patients have the same diagnosis. First-degree burn.&#13;
One is a healthy person, the other is a diabetic patient.&#13;
The impact for that problem in a diabetic patient is HIGHER (more risk of infection..., longuer time healing).&#13;
This element is meant to allow for multiple types of impact, including but not limited to: clinical treatment, home functioning, work life.</items><items id="description">Overall assessment of the impact of a health problem for the specific patient. </items><items id="text">Impact</items></items><items code="at0072"><items id="comment">*For example: An operation with curative intent may be planned, while during the operation it is discovered that curative treatment is not possible and the operation is carried out with a palliative intent instead. Coding of the 'Intent' with a terminology is recommended, if available. This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">*The intended outcome of the procedure. (en)</items><items id="text">*Intent (en)</items></items><items code="at0073"><items id="comment">*For example: the knife to skin time. Only for use in association with the 'Procedure performed', 'Procedure suspended', 'Procedure aborted' or 'Procedure completed' pathway steps. This may be the same as the RM 'time' attribute for the 'Procedure commenced' pathway step. (en)</items><items id="description">*The date or datetime when the entire procedure, or the first component of a multicomponent procedure, was first started. (en)</items><items id="text">*Start datetime (en)</items></items><items code="at0074"><items id="description">*The duration of time between the start of the most recent pathway step for this procedure and the start of the current pathway step. (en)</items><items id="text">*Pathway step duration (en)</items></items></term_definitions><term_definitions language="ru"><items code="at0000"><items id="description">*A clinical activity carried out for screening, investigative, diagnostic, curative, therapeutic, evaluative or palliative purposes.(en)</items><items id="text">*Procedure(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0002"><items id="comment">*Coding of the 'Procedure name' with a terminology is recommended, if available. (en)</items><items id="description">*Identification of the procedure by name.(en)</items><items id="text">*Procedure name(en)</items></items><items code="at0003"><items id="description">*Structured information about the procedure. Use to capture detailed, structured information about anatomical location, method &amp; technique, equipment used, devices implanted, results, findings etc.(en)</items><items id="text">*Procedure detail(en)</items></items><items code="at0004"><items id="description">*</items><items id="text">*Procedure planned (en)</items></items><items code="at0005"><items id="description">*Additional narrative about the procedure or care pathway step not captured in other fields. (en)</items><items id="text">*Comment(en)</items></items><items code="at0006"><items id="comment">*Use this data element to record simple terms or precoordinated complications. For example: Hematuria after a kidney biopsy, tissue irritation after insertion of intravenous catheter. If the requirements for recording complication are more complex then use of a specific CLUSTER archetype within the 'Procedure detail' SLOT in this archetype is advised and this data element becomes redundant. (en)</items><items id="description">*Details about any complication arising from the procedure.(en)</items><items id="text">*Complication(en)</items></items><items code="at0007"><items id="description">*</items><items id="text">*Procedure request sent (en)</items></items><items code="at0014"><items id="comment">*For example: the reason for the cancellation or suspension of the procedure.(en)</items><items id="description">*Reason that the activity or care pathway step for the identified procedure was carried out.(en)</items><items id="text">*Reason(en)</items></items><items code="at0034"><items id="description">*The procedure to be undertaken is planned.(en)</items><items id="text">*Procedure planned(en)</items></items><items code="at0035"><items id="description">*Request for procedure sent.(en)</items><items id="text">*Procedure request sent(en)</items></items><items code="at0036"><items id="description">*The procedure has been scheduled.(en)</items><items id="text">*Procedure scheduled(en)</items></items><items code="at0038"><items id="description">*The procedure has been postponed.(en)</items><items id="text">*Procedure postponed(en)</items></items><items code="at0039"><items id="description">*The planned procedure has been cancelled prior to commencement.(en)</items><items id="text">*Procedure cancelled(en)</items></items><items code="at0040"><items id="description">*The procedure has been suspended.(en)</items><items id="text">*Procedure suspended(en)</items></items><items code="at0041"><items id="description">*The procedure has been aborted.(en)</items><items id="text">*Procedure aborted(en)</items></items><items code="at0043"><items id="description">*The procedure has been performed and all associated clinical activities completed.(en)</items><items id="text">*Procedure completed(en)</items></items><items code="at0047"><items id="description">*The procedure, or subprocedure in a multicomponent procedure, has been performed.(en)</items><items id="text">*Procedure performed(en)</items></items><items code="at0048"><items id="comment">*Coding of the 'Outcome' with a terminology is recommended, if available. (en)</items><items id="description">*Outcome of procedure performed.(en)</items><items id="text">*Outcome(en)</items></items><items code="at0049"><items id="comment">*For example: description about the performance and findings from the the procedure, the aborted attempt or the cancellation of the procedure.(en)</items><items id="description">*Narrative description about the procedure, as appropriate for the pathway step.(en)</items><items id="text">*Description(en)</items></items><items code="at0053"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0054"><items id="comment">*This is equivalent to Placer Order Number in HL7 v2 specifications.(en)</items><items id="description">*The local ID assigned to the order by the healthcare provider or organisation requesting the service.(en)</items><items id="text">*Requestor order identifier(en)</items></items><items code="at0055"><items id="description">Подробности о заказчике (организации), запросившей услугу</items><items id="text">Заказчик</items></items><items code="at0056"><items id="comment">*This is equivalent to Filler Order Number in HL7 v2 specifications.(en)</items><items id="description">*The ID assigned to the order by the healthcare provider or organisation receiving the request for service. This is also referred to as Filler Order Identifier.(en)</items><items id="text">*Receiver order identifier(en)</items></items><items code="at0057"><items id="description">Подробные сведение об организации, получившей заявку на выполнение процедуры</items><items id="text">Исполнитель</items></items><items code="at0058"><items id="comment">*Coding of the 'Urgency' with a terminology is recommended, if available. (en)</items><items id="description">*Urgency of the procedure.(en)</items><items id="text">*Urgency(en)</items></items><items code="at0060"><items id="comment">*Only for use in association with the 'Procedure performed' pathway step, and in situations where the procedure is repeated on multiple occasions before being completed or there are multiple components to the whole procedure. This may be the same as the RM time attribute for the 'Procedure completed' pathway step.(en)</items><items id="description">*The date or datetime when the entire procedure, or the last component of a multicomponent procedure, was finished. (en)</items><items id="text">*End datetime (en)</items></items><items code="at0061"><items id="comment">*Only for use in association with the 'Procedure completed' pathway steps.(en)</items><items id="description">*The total amount of time taken to complete the procedure, which may include time spent during the active phase of the procedure plus time during which the procedure was suspended.(en)</items><items id="text">*Total duration(en)</items></items><items code="at0062"><items id="description">*Mulitimedia representation of a performed procedure.(en)</items><items id="text">*Multimedia(en)</items></items><items code="at0063"><items id="comment">*Occurrences for this data element are unbounded to allow for clinical scenarios such as removing multiple skin lesions in different places, but where all of the other attributes are identical. Use this data element to record simple terms or precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Procedure detail' SLOT in this archetype. If the anatomical location is included in the 'Procedure name' via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">*Identification of the body site for the procedure.(en)</items><items id="text">*Body site(en)</items></items><items code="at0064"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">*Extension(en)</items></items><items code="at0065"><items id="comment">*Use this data element to record simple terms or a narrative description. If the requirements for recording the method require more complex modelling then this can be represented by additional archetypes within the 'Procedure detail' SLOT in this archetype. If the method is included in the 'Procedure name' via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">*Identification of specific method or technique for the procedure.(en)</items><items id="text">*Method(en)</items></items><items code="at0066"><items id="comment">*Only for use in association with the 'Procedure scheduled' pathway step.(en)</items><items id="description">*The date or datetime on which the procedure is intended to be performed. (en)</items><items id="text">*Scheduled datetime (en)</items></items><items code="at0067"><items id="comment">*This pragmatic data element may be used to support organisation within the user interface.(en)</items><items id="description">*The type of procedure.(en)</items><items id="text">*Procedure type(en)</items></items><items code="at0068"><items id="description">*The procedure, or subprocedure in a multicomponent procedure, has been commenced.(en)</items><items id="text">*Procedure commenced(en)</items></items><items code="at0069"><items id="description">*Difficulties or issues encountered during the procedure.(en)</items><items id="text">*Procedural difficulty(en)</items></items><items code="at0070"><items id="comment">*For example: 'Failed bowel preparation' or 'Bowel cancer screening'. Coding of the 'Indication' with a terminology is recommended, if available.  This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">*The clinical or process-related reason for the procedure. (en)</items><items id="text">*Indication (en)</items></items><items code="at0071"><items id="comment">The same diagnosis, with the same severity, has a different impact on each patient. This relevance qualifier implies adjusting the overall impact of that health problem according to the patient's characteristics.&#13;
For example: Two patients have the same diagnosis. First-degree burn.&#13;
One is a healthy person, the other is a diabetic patient.&#13;
The impact for that problem in a diabetic patient is HIGHER (more risk of infection..., longuer time healing).&#13;
This element is meant to allow for multiple types of impact, including but not limited to: clinical treatment, home functioning, work life.</items><items id="description">Overall assessment of the impact of a health problem for the specific patient. </items><items id="text">Impact</items></items><items code="at0072"><items id="comment">*For example: An operation with curative intent may be planned, while during the operation it is discovered that curative treatment is not possible and the operation is carried out with a palliative intent instead. Coding of the 'Intent' with a terminology is recommended, if available. This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">*The intended outcome of the procedure. (en)</items><items id="text">*Intent (en)</items></items><items code="at0073"><items id="comment">*For example: the knife to skin time. Only for use in association with the 'Procedure performed', 'Procedure suspended', 'Procedure aborted' or 'Procedure completed' pathway steps. This may be the same as the RM 'time' attribute for the 'Procedure commenced' pathway step. (en)</items><items id="description">*The date or datetime when the entire procedure, or the first component of a multicomponent procedure, was first started. (en)</items><items id="text">*Start datetime (en)</items></items><items code="at0074"><items id="description">*The duration of time between the start of the most recent pathway step for this procedure and the start of the current pathway step. (en)</items><items id="text">*Pathway step duration (en)</items></items></term_definitions><term_definitions language="sl"><items code="at0000"><items id="description">*A clinical activity carried out for screening, investigative, diagnostic, curative, therapeutic, evaluative or palliative purposes.(en)</items><items id="text">*Procedure(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0002"><items id="comment">*Coding of the 'Procedure name' with a terminology is recommended, if available. (en)</items><items id="description">*Identification of the procedure by name.(en)</items><items id="text">*Procedure name(en)</items></items><items code="at0003"><items id="description">*Structured information about the procedure. Use to capture detailed, structured information about anatomical location, method &amp; technique, equipment used, devices implanted, results, findings etc.(en)</items><items id="text">*Procedure detail(en)</items></items><items code="at0004"><items id="description">*</items><items id="text">*Procedure planned (en)</items></items><items code="at0005"><items id="description">*Additional narrative about the procedure or care pathway step not captured in other fields. (en)</items><items id="text">*Comment(en)</items></items><items code="at0006"><items id="comment">*Use this data element to record simple terms or precoordinated complications. For example: Hematuria after a kidney biopsy, tissue irritation after insertion of intravenous catheter. If the requirements for recording complication are more complex then use of a specific CLUSTER archetype within the 'Procedure detail' SLOT in this archetype is advised and this data element becomes redundant. (en)</items><items id="description">*Details about any complication arising from the procedure.(en)</items><items id="text">*Complication(en)</items></items><items code="at0007"><items id="description">*</items><items id="text">*Procedure request sent (en)</items></items><items code="at0014"><items id="comment">*For example: the reason for the cancellation or suspension of the procedure.(en)</items><items id="description">*Reason that the activity or care pathway step for the identified procedure was carried out.(en)</items><items id="text">*Reason(en)</items></items><items code="at0034"><items id="description">*The procedure to be undertaken is planned.(en)</items><items id="text">*Procedure planned(en)</items></items><items code="at0035"><items id="description">*Request for procedure sent.(en)</items><items id="text">*Procedure request sent(en)</items></items><items code="at0036"><items id="description">*The procedure has been scheduled.(en)</items><items id="text">*Procedure scheduled(en)</items></items><items code="at0038"><items id="description">*The procedure has been postponed.(en)</items><items id="text">*Procedure postponed(en)</items></items><items code="at0039"><items id="description">*The planned procedure has been cancelled prior to commencement.(en)</items><items id="text">*Procedure cancelled(en)</items></items><items code="at0040"><items id="description">*The procedure has been suspended.(en)</items><items id="text">*Procedure suspended(en)</items></items><items code="at0041"><items id="description">*The procedure has been aborted.(en)</items><items id="text">*Procedure aborted(en)</items></items><items code="at0043"><items id="description">*The procedure has been performed and all associated clinical activities completed.(en)</items><items id="text">*Procedure completed(en)</items></items><items code="at0047"><items id="description">*The procedure, or subprocedure in a multicomponent procedure, has been performed.(en)</items><items id="text">*Procedure performed(en)</items></items><items code="at0048"><items id="comment">*Coding of the 'Outcome' with a terminology is recommended, if available. (en)</items><items id="description">*Outcome of procedure performed.(en)</items><items id="text">*Outcome(en)</items></items><items code="at0049"><items id="comment">*For example: description about the performance and findings from the the procedure, the aborted attempt or the cancellation of the procedure.(en)</items><items id="description">*Narrative description about the procedure, as appropriate for the pathway step.(en)</items><items id="text">*Description(en)</items></items><items code="at0053"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0054"><items id="comment">*This is equivalent to Placer Order Number in HL7 v2 specifications.(en)</items><items id="description">*The local ID assigned to the order by the healthcare provider or organisation requesting the service.(en)</items><items id="text">*Requestor order identifier(en)</items></items><items code="at0055"><items id="description">Kdo je naročil aktivnost, posameznik ali organizacija</items><items id="text">Naročnik</items></items><items code="at0056"><items id="comment">*This is equivalent to Filler Order Number in HL7 v2 specifications.(en)</items><items id="description">*The ID assigned to the order by the healthcare provider or organisation receiving the request for service. This is also referred to as Filler Order Identifier.(en)</items><items id="text">*Receiver order identifier(en)</items></items><items code="at0057"><items id="description">Prejemnik naročila za izvedbo aktivnosti</items><items id="text">Prejemnik</items></items><items code="at0058"><items id="comment">*Coding of the 'Urgency' with a terminology is recommended, if available. (en)</items><items id="description">*Urgency of the procedure.(en)</items><items id="text">*Urgency(en)</items></items><items code="at0060"><items id="comment">*Only for use in association with the 'Procedure performed' pathway step, and in situations where the procedure is repeated on multiple occasions before being completed or there are multiple components to the whole procedure. This may be the same as the RM time attribute for the 'Procedure completed' pathway step.(en)</items><items id="description">*The date or datetime when the entire procedure, or the last component of a multicomponent procedure, was finished. (en)</items><items id="text">*End datetime (en)</items></items><items code="at0061"><items id="comment">*Only for use in association with the 'Procedure completed' pathway steps.(en)</items><items id="description">*The total amount of time taken to complete the procedure, which may include time spent during the active phase of the procedure plus time during which the procedure was suspended.(en)</items><items id="text">*Total duration(en)</items></items><items code="at0062"><items id="description">*Mulitimedia representation of a performed procedure.(en)</items><items id="text">*Multimedia(en)</items></items><items code="at0063"><items id="comment">*Occurrences for this data element are unbounded to allow for clinical scenarios such as removing multiple skin lesions in different places, but where all of the other attributes are identical. Use this data element to record simple terms or precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Procedure detail' SLOT in this archetype. If the anatomical location is included in the 'Procedure name' via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">*Identification of the body site for the procedure.(en)</items><items id="text">*Body site(en)</items></items><items code="at0064"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">*Extension(en)</items></items><items code="at0065"><items id="comment">*Use this data element to record simple terms or a narrative description. If the requirements for recording the method require more complex modelling then this can be represented by additional archetypes within the 'Procedure detail' SLOT in this archetype. If the method is included in the 'Procedure name' via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">*Identification of specific method or technique for the procedure.(en)</items><items id="text">*Method(en)</items></items><items code="at0066"><items id="comment">*Only for use in association with the 'Procedure scheduled' pathway step.(en)</items><items id="description">*The date or datetime on which the procedure is intended to be performed. (en)</items><items id="text">*Scheduled datetime (en)</items></items><items code="at0067"><items id="comment">*This pragmatic data element may be used to support organisation within the user interface.(en)</items><items id="description">*The type of procedure.(en)</items><items id="text">*Procedure type(en)</items></items><items code="at0068"><items id="description">*The procedure, or subprocedure in a multicomponent procedure, has been commenced.(en)</items><items id="text">*Procedure commenced(en)</items></items><items code="at0069"><items id="description">*Difficulties or issues encountered during the procedure.(en)</items><items id="text">*Procedural difficulty(en)</items></items><items code="at0070"><items id="comment">*For example: 'Failed bowel preparation' or 'Bowel cancer screening'. Coding of the 'Indication' with a terminology is recommended, if available.  This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">*The clinical or process-related reason for the procedure. (en)</items><items id="text">*Indication (en)</items></items><items code="at0071"><items id="comment">The same diagnosis, with the same severity, has a different impact on each patient. This relevance qualifier implies adjusting the overall impact of that health problem according to the patient's characteristics.&#13;
For example: Two patients have the same diagnosis. First-degree burn.&#13;
One is a healthy person, the other is a diabetic patient.&#13;
The impact for that problem in a diabetic patient is HIGHER (more risk of infection..., longuer time healing).&#13;
This element is meant to allow for multiple types of impact, including but not limited to: clinical treatment, home functioning, work life.</items><items id="description">Overall assessment of the impact of a health problem for the specific patient. </items><items id="text">Impact</items></items><items code="at0072"><items id="comment">*For example: An operation with curative intent may be planned, while during the operation it is discovered that curative treatment is not possible and the operation is carried out with a palliative intent instead. Coding of the 'Intent' with a terminology is recommended, if available. This data element allows multiple occurrences to enable the user to record multiple responses, if required. (en)</items><items id="description">*The intended outcome of the procedure. (en)</items><items id="text">*Intent (en)</items></items><items code="at0073"><items id="comment">*For example: the knife to skin time. Only for use in association with the 'Procedure performed', 'Procedure suspended', 'Procedure aborted' or 'Procedure completed' pathway steps. This may be the same as the RM 'time' attribute for the 'Procedure commenced' pathway step. (en)</items><items id="description">*The date or datetime when the entire procedure, or the first component of a multicomponent procedure, was first started. (en)</items><items id="text">*Start datetime (en)</items></items><items code="at0074"><items id="description">*The duration of time between the start of the most recent pathway step for this procedure and the start of the current pathway step. (en)</items><items id="text">*Pathway step duration (en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="description">En klinisk aktivitet utförd för screening-, undersökande, diagnostiska, botande, terapeutiska, utvärderande eller palliativa ändamål.</items><items id="text">Åtgärd</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">Om möjligt, koda "benämning på åtgärd" med en terminologi.</items><items id="description">Åtgärdens benämning.</items><items id="text">Benämning på åtgärd</items></items><items code="at0003"><items id="comment">Används för att fånga detaljerad, strukturerad information om anatomisk plats, metod och teknik, utrustning som används, implanterat såsom enheter eller utrustning, resultat, fynd m.m.</items><items id="description">Strukturerad information om åtgärden.</items><items id="text">Åtgärdsdetaljer</items></items><items code="at0004"><items id="description">Den åtgärd som ska genomföras är planerad.</items><items id="text">Åtgärd planerad</items></items><items code="at0005"><items id="description">Kommentarer om åtgärden eller processteget som inte beskrivs i övriga datafält.</items><items id="text">Kommentar</items></items><items code="at0006"><items id="comment">Använd detta datafält för att registrera enkla eller prekoordinerade termer för komplikationer.&#13;
&#13;
Exempelvis hematuri efter njurbiopsi eller vävnadsirritation efter insättning av en intravenös kateter. Om komplikationen behöver dokumenteras mer detaljerat rekommenderas användning av en specifik CLUSTER-arketyp i SLOT "Åtgärdsdetaljer". I sådana fall behöver detta datafält inte användas.</items><items id="description">Detaljer om eventuella komplikationer som uppstår från åtgärden.</items><items id="text">Komplikation</items></items><items code="at0007"><items id="description">Förfrågan om åtgärd är skickad.&#13;
</items><items id="text">Förfrågan om åtgärd skickad</items></items><items code="at0014"><items id="comment">Exempelvis anledningen till att åtgärden är i processteget pausad eller avbruten.</items><items id="description">Anledning till att nytt processteg för åtgärden dokumenterats.</items><items id="text">Anledning</items></items><items code="at0034"><items id="comment">(Var: Den åtgärd som ska utföras är planerad.)</items><items id="description">Detta steg har upphört att gälla eftersom det felaktigt var associerat med status "initial". Använd det nya steget "Åtgärd planerad" (at0004) som är korrekt associerat med status "planerad" . &#13;
</items><items id="text">X - Åtgärd planerad</items></items><items code="at0035"><items id="comment">(Var: Åtgärdsförfrågan skickad.)</items><items id="description">Detta steg har upphört att gälla eftersom det felaktigt var associerat med status "initial". Använd det nya steget "Åtgärdsförfrågan skickad" (at0007) som är korrekt associerat med status "planerad".</items><items id="text">X - Förfrågan om åtgärd skickad</items></items><items code="at0036"><items id="description">Åtgärden är bokad.</items><items id="text">Åtgärd bokad</items></items><items code="at0038"><items id="description">Åtgärden är uppskjuten.&#13;
</items><items id="text">Åtgärd uppskjuten</items></items><items code="at0039"><items id="description">Den planerade åtgärden är inställd.</items><items id="text">Åtgärd inställd</items></items><items code="at0040"><items id="description">Åtgärden är pausad.</items><items id="text">Åtgärd pausad</items></items><items code="at0041"><items id="description">Åtgärden är avbruten.&#13;
</items><items id="text">Åtgärd avbruten</items></items><items code="at0043"><items id="description">Åtgärden och alla tillhörande kliniska aktiviteter är slutförda.</items><items id="text">Åtgärd slutförd</items></items><items code="at0047"><items id="description">Åtgärden är utförd.</items><items id="text">Åtgärd utförd</items></items><items code="at0048"><items id="comment">Om möjligt, koda "resultat" med en terminologi.</items><items id="description">Resultat av genomförd åtgärd.</items><items id="text">Resultat</items></items><items code="at0049"><items id="comment">Exempelvis, en beskrivning av åtgärdens utförande och dess fynd, den avbrutna åtgärden eller den inställda åtgärden.</items><items id="description">Beskrivning av åtgärden, anpassad till det aktuella processteget.</items><items id="text">Beskrivning</items></items><items code="at0053"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0054"><items id="comment">Detta motsvarar Place Order Number i specifikationerna för HL7 v2.</items><items id="description">Beställnings-ID definierat av den aktör som är avsändare av förfrågan av tjänst.</items><items id="text">Beställnings-ID hos avsändare</items></items><items code="at0055"><items id="description">Detaljer om den aktör som efterfrågar tjänsten.</items><items id="text">Beställare</items></items><items code="at0056"><items id="comment">Detta motsvarar Filler Order Number i specifikationerna för HL7 v2.</items><items id="description">Beställnings-ID definierat av den aktör som tar emot förfrågan av tjänsten.</items><items id="text">Betällnings-ID hos mottagare</items></items><items code="at0057"><items id="description">Detaljer om den aktör som tar emot förfrågan av tjänsten.</items><items id="text">Mottagare</items></items><items code="at0058"><items id="comment">Om möjligt, koda "brådskandegrad" med en terminologi.</items><items id="description">Åtgärdens brådskandegrad.</items><items id="text">Brådskandegrad</items></items><items code="at0060"><items id="comment">Kan endast användas i samband med steget "Åtgärd utförd" och i situationer där åtgärden upprepas vid flera tillfällen innan den avslutas eller om det finns flera delåtgärder i hela åtgärden. Detta kan vara detsamma som referensmodellens attribut för steget "Åtgärd slutförd".</items><items id="description">Det datum eller den tidpunkt, då hela åtgärden avslutades eller det sista delmomentet i en åtgärd som består av flera delmoment.</items><items id="text">Sluttidpunkt</items></items><items code="at0061"><items id="comment">Kan endast användas i samband med steget "Åtgärd slutförd".</items><items id="description">Den totala tid som krävs för att utföra åtgärden, vilket kan inkludera tid som tillbringats under den aktiva fasen av åtgärden plus den tid under vilken åtgärden pausades.</items><items id="text">Total varaktighet</items></items><items code="at0062"><items id="description">Multimedierepresentation av utförd åtgärd.</items><items id="text">Multimedia</items></items><items code="at0063"><items id="comment">Förekomsten av detta datafält är obegränsat för att möjliggöra kliniska scenarier som att ta bort flera hudförändringar på olika lokalisationer, men där alla andra attribut är identiska. Använd detta datafält för att dokumentera enkla termer eller prekoordinerade kroppslokalisationer. Om kraven på dokumentation av den lokalisationen bestäms vid körning av applikationen eller kräver mer komplex modellering, till exempel relativa lokalisationer (exempelvis 3 cm ovanför vänster knä), använd CLUSTER.anatomical_location eller CLUSTER.relative_location i SLOT "Åtgärdsdetaljer" i denna arketyp. Om kroppslokalisationen ingår i "Benämning på åtgärd" genom prekoordinerade koder blir detta datafält överflödigt.</items><items id="description">Identifiering av anatomisk plats för åtgärden.</items><items id="text">Kroppslokalisation</items></items><items code="at0064"><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items><items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="text">Tilläggsinformation</items></items><items code="at0065"><items id="comment">Använd detta datafält för att dokumentera metoden. Om kraven för dokumentation av metoden kräver mer komplex modellering kan detta representeras av ytterligare arketyper i SLOT "Åtgärdsdetalj" i denna arketyp. Om metoden ingår i "Benämning på åtgärd" genom prekoordinerade koder blir detta datafält överflödigt.</items><items id="description">Identifiering av specifik metod eller teknik för åtgärden.</items><items id="text">Metod</items></items><items code="at0066"><items id="comment">Ska endast användas i samband med steget "Åtgärd bokad".</items><items id="description">Det datum eller den tidpunkt som åtgärden är planerad att utföras.</items><items id="text">Planerad tidpunkt</items></items><items code="at0067"><items id="comment">Detta datafält kan användas för att tydliggöra användargränssnittets struktur.</items><items id="description">Typ av åtgärd.</items><items id="text">Åtgärdstyp</items></items><items code="at0068"><items id="description">Åtgärden är påbörjad.</items><items id="text">Åtgärd påbörjad</items></items><items code="at0069"><items id="comment">Exempelvis patienten var upprörd, otillräcklig tömning av magsäcken före gastroskopi, en tumör i gallgångarna gjorde det omöjligt att passera igenom med gastroskop.</items><items id="description">Svårigheter eller problem som uppstår under genomförandet av åtgärden.</items><items id="text">Svårigheter med åtgärd</items></items><items code="at0070"><items id="comment">Exempelvis "Misslyckad tarmförberedelse" eller "Screening för kolorektalcancer". Om möjligt, koda "indikation" till en terminologi. Detta datafält kan vid behov registreras flera gånger för att möjliggöra dokumentation av flera indikationer.</items><items id="description">Den kliniska eller processrelaterade orsaken till åtgärden.</items><items id="text">Indikation</items></items><items code="at0071"><items id="comment">Samma åtgärd, med samma svårighetsgrad eller resultat, kan ha olika påverkan för olika patienter. Denna relevansfaktor innebär att den samlade påverkan av åtgärden eller resultatet bedöms utifrån patientens individuella förutsättningar.&#13;
&#13;
Exempelvis kan två patienter ha genomgått samma åtgärd med samma resultat: osteosyntes av lillfingret på den icke-dominanta handen. Den ena patienten arbetar som trädgårdsarbetare eller byggnadsarbetare, den andra är pianist. Påverkan av åtgärden är större för pianisten, exempelvis genom längre sjukskrivning och behov av full funktionell rehabilitering för att kunna återgå till arbetet som har höga krav på finmotorik.&#13;
&#13;
Detta datafält är avsett att möjliggöra registrering av olika typer av påverkan, inklusive men inte begränsat till påverkan på behandling, funktion i hemmet eller arbetsliv.</items><items id="description">Bedömning av vilken påverkan en åtgärd eller dess resultat har på den enskilda patienten.</items><items id="text">Påverkan</items></items><items code="at0072"><items id="comment">Exempelvis en operation med kurativ avsikt kan planeras, men under operationen visar det sig att kurativ behandling inte är möjlig och att ingreppet istället genomförs med palliativ avsikt. Om möjligt, koda "avsikt" med en terminologi. Detta datafält kan vid behov registreras flera gånger för att möjliggöra dokumentation av flera indikationer.</items><items id="description">Det avsedda resultatet av åtgärden.</items><items id="text">Avsikt</items></items><items code="at0073"><items id="comment">Exempelvis tidpunkten för första incisionen ("knife-to-skin time"). Används endast tillsammans med processtegen "Åtgärd utförd", "Åtgärd pausad", "Åtgärd avbruten" eller "Åtgärd slutförd". Detta värde kan vara detsamma som referensmodellens attribut "time" för processteget "Åtgärd påbörjad".</items><items id="description">Det datum eller den tidpunkt, då hela åtgärden påbörjades eller den första delen av en åtgärd som består av flera delmoment.</items><items id="text">Starttidpunkt</items></items><items code="at0074"><items id="description">Tidsperioden mellan starten av det senast registrerade processteget för denna åtgärd och starten av det aktuella processteget.</items><items id="text">Duration för processteg</items></items></term_definitions><term_definitions language="zh-cn"><items code="at0000"><items id="description">为了实现评估类、探查类、筛查类、诊断类、治愈类、疗法类或姑息治疗类等目的而开展的临床活动。</items><items id="text">操作</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">如果可用，建议采用统一的术语集对“操作名称”加以编码。</items><items id="description">利用名称对于此项操作进行的标识。</items><items id="text">操作名称</items></items><items code="at0003"><items id="comment">用于记录操作相关的详细的结构化信息，包括解剖学位置、方法与技术方法、所采用的设备、所植入的器械/装置、结果、发现/所见等。</items><items id="description">关于此项操作的结构化信息。</items><items id="text">操作详情</items></items><items code="at0004"><items id="description">计划有待开展/执行/实施的操作。</items><items id="text">操作已编制计划</items></items><items code="at0005"><items id="description">额外关于此项操作或照护路径步骤的，其他字段并未涵盖的叙述性说明。</items><items id="text">注释</items></items><items code="at0006"><items id="comment">利用此数据元来记录简单的术语或先组配型的并发症。例如：肾活检后血尿、静脉导管置入后组织刺激。如果记录并发症的需求更为复杂，则建议在此原始型的操作详情槽位“Procedure detail”之中使用特定的群簇型（CLUSTER）原始型，而此时则不再需要本数据元。</items><items id="description">关于此项操作所引发的任何并发症的详情。</items><items id="text">并发症</items></items><items code="at0007"><items id="description">已发送关于当前操作的请求。</items><items id="text">操作请求已发送</items></items><items code="at0014"><items id="comment">例如：关于取消或暂停当前操作的原因。</items><items id="description">关于针对当前操作实际开展/执行此项活动或照护服务路径步骤的原因。</items><items id="text">原因</items></items><items code="at0034"><items id="comment">（原描述：计划有待开展/执行/实施的操作。）</items><items id="description">目前已弃用此路径步骤，因其错误地关联了“初始”（initial）状态 —— 请采用新的“操作已编制计划”（Procedure planned，编码：at0004）路径步骤，该步骤正确地关联了“已计划”（planned）状态。</items><items id="text">X - 操作已编制计划</items></items><items code="at0035"><items id="comment">（原描述：已发送关于当前操作的请求。）</items><items id="description">目前已弃用此路径步骤，因其错误地关联了“初始”（initial）状态 —— 请采用新的“操作请求已发送”（Procedure request sent，编码：at0007）路径步骤，该步骤正确地关联了“已计划”（planned）状态。</items><items id="text">X - 操作请求已发送</items></items><items code="at0036"><items id="description">目前已对此项操作进行了排程。</items><items id="text">操作已排程</items></items><items code="at0038"><items id="description">目前已延期此项操作。</items><items id="text">操作已延期</items></items><items code="at0039"><items id="description">已计划的操作在开始之前已被取消。</items><items id="text">操作已取消</items></items><items code="at0040"><items id="description">目前已暂停此项操作。</items><items id="text">操作已暂停</items></items><items code="at0041"><items id="description">目前已中止此项操作。</items><items id="text">操作已中止</items></items><items code="at0043"><items id="description">目前已执行此项操作，且所有相关的临床活动均已完成。</items><items id="text">操作已完成</items></items><items code="at0047"><items id="description">目前已执行此项操作（或多组成部分操作之中的此项子操作）。</items><items id="text">操作已执行</items></items><items code="at0048"><items id="comment">如果可用，建议采用统一的术语集对“紧急程度”加以编码。</items><items id="description">已执行操作的结局。</items><items id="text">结局</items></items><items code="at0049"><items id="comment">例如：关于此项操作的执行情况与发现/所见、已中止的尝试或此项操作的取消的描述。</items><items id="description">对于此项操作进行的，适合于当前路径步骤的叙述性描述。</items><items id="text">描述</items></items><items code="at0053"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0054"><items id="comment">该标识符等同于HL7 v2标准中的“申请方医嘱编号”（Placer Order Number）。</items><items id="description">申请此项服务的健康医疗服务提供方或机构为此项医嘱所分配的本地标识符。</items><items id="text">申请方医嘱标识符</items></items><items code="at0055"><items id="description">关于申请此项服务的健康医疗服务提供方或机构的相关详情。</items><items id="text">申请方</items></items><items code="at0056"><items id="comment">该标识符等同于 HL7 v2 标准之中的“执行方医嘱编号”（Filler Order Number）。</items><items id="description">由接收服务请求的健康医疗服务提供方或机构为此项医嘱所分配的标识符，也称为“执行方医嘱标识符”（Filler Order Identifier）。</items><items id="text">接收方医嘱标识符</items></items><items code="at0057"><items id="description">关于接收服务请求的健康医疗服务提供方或机构的相关详情。</items><items id="text">接收方</items></items><items code="at0058"><items id="comment">如果可用，建议采用统一的术语集对“紧急程度”加以编码。</items><items id="description">此项操作的紧急程度。</items><items id="text">紧急程度</items></items><items code="at0060"><items id="comment">仅仅旨在与“操作已执行”路径步骤联合运用，且适用于以下场景：操作在完成之前需多次重复进行，或整个操作包含多个组成部分。该时间可能与“操作已完成”路径步骤的参考模型（RM）时间属性“time”相同。</items><items id="description">整个操作完成/结束时的日期或日期时间，或者是多组成部分操作之中最后一个组成部分完成/结束时的日期或日期时间。</items><items id="text">结束日期时间</items></items><items code="at0061"><items id="comment">仅仅旨在与“操作已完成”（Procedure completed）路径步骤联合运用。</items><items id="description">完成此项操作所实际花费的总时间，可能包括操作执行阶段所花费的时间以及操作暂停期间所流逝的时间。</items><items id="text">总时长</items></items><items code="at0062"><items id="description">关于所执行的操作的多媒体呈现资料。</items><items id="text">多媒体</items></items><items code="at0063"><items id="comment">该数据元的出现次数不限，以便适配需对不同部位进行相同操作的临床场景（例如，切除不同部位的多个皮肤病变，而操作的其余所有属性均相同）。请采用本数据元来记录简单的术语或先组配型的解剖学位置。若解剖学位置的记录需求需要的是应用程序在运行时确定，或者是需更为复杂的建模（如相对位置），则应当采用本原始型操作详情槽位（Procedure detail）之中的群簇类解剖学位置原始型（CLUSTER.anatomical_location）或群簇类相对位置原始型（CLUSTER.relative_location）。若已经利用先组配型代码将解剖学位置信息包含在“操作名称”数据元当中，则无需填写本数据元。</items><items id="description">对于此项操作所针对的身体部位的标识。</items><items id="text">身体部位</items></items><items code="at0064"><items id="comment">例如：本地信息需求；或用于与FHIR保持一致时所需的额外元数据。</items><items id="description">为了利益本地内容来扩展模型或与其他参考模型或形式化体系保持一致时所需的附加信息。&#13;
&#13;
</items><items id="text">扩展</items></items><items code="at0065"><items id="comment">请采用本数据元来记录简单的术语或叙述性的描述。若方法的记录需求需要更为复杂的建模，则可在本原始型之中的操作详情槽位（Procedure detail）内利用其他的原始型来表达。若已经利用先组配型代码将方法信息包含在“操作名称”数据元当中，则无需填写本数据元。</items><items id="description">对于此项操作所采用的特定方法或技术方法的标识。</items><items id="text">方法</items></items><items code="at0066"><items id="comment">仅仅旨在与“已排程的操作”（Procedure scheduled）路径步骤联合运用。</items><items id="description">预定执行此项操作的日期或日期时间。</items><items id="text">预定日期时间</items></items><items code="at0067"><items id="comment">这一实用性数据元可用于支持实现用户界面之中的内容分类组织。</items><items id="description">此项操作的类型。</items><items id="text">操作类型</items></items><items code="at0068"><items id="description">此项操作（或多组成部分操作之中的此项子操作）目前已开始。</items><items id="text">操作已开始</items></items><items code="at0069"><items id="comment">示例：患者烦躁不安、胃镜检查前胃排空不充分、胆管内肿瘤导致内镜无法通过。</items><items id="description">执行此项操作过程中所遇到的困难或问题。</items><items id="text">操作难度</items></items><items code="at0070"><items id="comment">例如：“肠道准备失败”或“结直肠癌筛查”。如果可用，建议采用统一的术语集对“适应证”加以编码。如果需要，此数据元还允许出现多次，以便用户记录多个答案选项/应答。</items><items id="description">此项操作的临床原因/理由或流程相关原因/理由。</items><items id="text">适应证</items></items><items code="at0071"><items id="comment">相同的操作，即便具有相同的严重程度或结局，对每位患者的影响也可能有所不同。这一相关因素涉及到依据患者的特点/特征来调整此项操作或其结局的整体影响程度。&#13;
&#13;
例如：两名患者接受了相同的操作，并获得了相同的结局：对这两位患者的非优势手第五指均进行的是骨缝合修复术（osteosynthesis repair）。&#13;
&#13;
其中，一位患者是园丁或建筑工人，而另一位则是钢琴家。&#13;
&#13;
此项操作对钢琴家的影响更大（病假时间更长，需要完全的功能康复，以适应工作对精细动作的高要求）。&#13;
&#13;
此数据元旨在允许记录多种类型的影响，包括但不仅限于：临床治疗、居家功能发挥或工作生活。</items><items id="description">对于某一操作或其结局对特定患者所产生影响的评估。</items><items id="text">影响</items></items><items code="at0072"><items id="comment">例如：原本可能计划进行的是以治愈/根治为目的的手术，但在手术过程中却发现无法进行根治性治疗，于是改为以姑息性目的进行手术。如果可用，建议采用统一的术语集对“目的”加以编码。如果需要，此数据元还允许出现多次，以便用户记录多个答案选项/应答。</items><items id="description">操作的预期结果。</items><items id="text">目的</items></items><items code="at0073"><items id="comment">例如：手术切皮时间。仅仅旨在用于与“操作已执行”、“操作已暂停”、“操作已中止”或“操作已完成”路径步骤联合运用。此时间可能与“操作已开始”路径步骤的参考模型（RM）时间属性“time”相同。</items><items id="description">整个操作开始时的日期或日期时间，或者是多组成部分操作之中第一个组成部分的首次开始日期或日期时间。</items><items id="text">开始日期时间</items></items><items code="at0074"><items id="description">此项操作最新一个路径步骤的开始时间与当前路径步骤的开始时间之间的持续时长。</items><items id="text">路径步骤持续时长</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-EVALUATION.problem_diagnosis.v1"><term_definitions language="ar-sy"><items code="at0000"><items id="comment">*Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.(en)</items><items id="description">*Details about a single identified health condition, injury, disability or any other issue which impacts on the physical, mental and/or social well-being of an individual.(en)</items><items id="text">*Problem/Diagnosis(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*structure(en)</items></items><items code="at0002"><items id="comment">*Coding of the name of the problem or diagnosis with a terminology is preferred, where possible.(en)</items><items id="description">*Identification of the problem or diagnosis, by name.(en)</items><items id="text">*Problem/Diagnosis name(en)</items></items><items code="at0003"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support.(en)</items><items id="description">*Estimated or actual date/time the diagnosis or problem was recognised by a healthcare professional.(en)</items><items id="text">*Date/time clinically recognised(en)</items></items><items code="at0005"><items id="comment">*If severity is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant. Note: more specific grading of severity can be recorded using the Specific details SLOT.(en)</items><items id="description">*An assessment of the overall severity of the problem or diagnosis.(en)</items><items id="text">*Severity(en)</items></items><items code="at0009"><items id="comment">*Use to provide background and context, including evolution, episodes or exacerbations, progress and any other relevant details, about the problem or diagnosis.(en)</items><items id="description">*Narrative description about the problem or diagnosis.(en)</items><items id="text">*Clinical description(en)</items></items><items code="at0012"><items id="comment">*Coding of the name of the anatomical location with a terminology is preferred, where possible.&#13;
Use this data element to record precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Structured anatomical location' SLOT in this archetype. Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a rash in multiple locations but where all of the other attributes are identical. If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">*Identification of a simple body site for the location of the problem or diagnosis.(en)</items><items id="text">*Body site(en)</items></items><items code="at0030"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support.(en)</items><items id="description">*Estimated or actual date/time of resolution or remission for this problem or diagnosis, as determined by a healthcare professional.(en)</items><items id="text">*Date/time of resolution(en)</items></items><items code="at0032"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0039"><items id="comment">*Use this SLOT to insert the CLUSTER.anatomical_location or CLUSTER.relative_location archetypes if the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations.&#13;
&#13;
If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, use of this SLOT becomes redundant.(en)</items><items id="description">*A structured anatomical location for the problem or diagnosis.(en)</items><items id="text">*Structured body site(en)</items></items><items code="at0043"><items id="comment">*May include structured detail about the grading or staging of the diagnosis; diagnostic criteria, classification criteria or formal severity assessments such as Common Terminology Criteria for Adverse Events.(en)</items><items id="description">*Details that are additionally required to record as unique attributes of this problem or diagnosis.(en)</items><items id="text">*Specific details(en)</items></items><items code="at0046"><items id="comment">*Use status or context qualifiers with care, as they are variably used in practice and interoperability cannot be assured unless usage is clearly defined with the community of use. For example: active status - active, inactive, resolved, in remission; evolution status - initial, interim/working, final; temporal status - current, past; episodicity status - first, new, ongoing; admission status - admission, discharge; or priority status - primary, secondary.(en)</items><items id="description">*Structured details for location-, domain-, episode- or workflow-specific aspects of the diagnostic process.(en)</items><items id="text">*Status(en)</items></items><items code="at0047"><items id="description">*The problem or diagnosis does not interfere with normal activity.(en)</items><items id="text">*Mild(en)</items></items><items code="at0048"><items id="description">*The problem or diagnosis causes interference with normal activity.(en)</items><items id="text">*Moderate(en)</items></items><items code="at0049"><items id="description">*The problem or diagnosis prevents normal activity.(en)</items><items id="text">*Severe(en)</items></items><items code="at0069"><items id="description">*Additional narrative about the problem or diagnosis not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0070"><items id="description">*The date this problem or diagnosis was last updated.(en)</items><items id="text">*Last updated(en)</items></items><items code="at0071"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0072"><items id="description">*Narrative description about the course of the problem or diagnosis since onset.(en)</items><items id="text">*Course description(en)</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">*The level of confidence in the identification of the diagnosis.(en)</items><items id="text">*Diagnostic certainty(en)</items></items><items code="at0074"><items id="description">*The diagnosis has been identified with a low level of certainty.(en)</items><items id="text">*Suspected(en)</items></items><items code="at0075"><items id="description">*The diagnosis has been identified with a high level of certainty.(en)</items><items id="text">*Probable(en)</items></items><items code="at0076"><items id="description">*The diagnosis has been confirmed against recognised criteria.(en)</items><items id="text">*Confirmed(en)</items></items><items code="at0077"><items id="description">*Estimated or actual date/time that signs or symptoms of the problem/diagnosis were first observed.(en)</items><items id="text">*Date of onset(en)</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="comment">No és fàcil trobar en la pràctica una delineació clara entre l’abast d’un problema versus un diagnòstic. Per a la finalitat d’aquest arquetip, problema i diagnòstic es veuran com un continu, amb l’increment de nivells de detalls i una evidència d’ajuda normalment que doni pes sobre l’etiqueta «diagnòstic».</items><items id="description">Detalls sobre una única condició de salut, lesió, discapacitat o qualsevol altre problema identificat que afecti el benestar físic, mental o social d’una persona. </items><items id="text">Problema/Diagnòstic</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Es recomana programar el nom del problema o diagnòstic amb una terminologia sempre que sigui possible.</items><items id="description">Identificació del problema o diagnòstic pel nom.</items><items id="text">Nom del Problema/Diagnòstic</items></items><items code="at0003"><items id="comment">Les dades parcials són vàlides. Si la persona de la cura té menys d’un any, doncs la data completa o el mínim de mes i any és necessari per permetre càlculs d’edat correctes; per exemple, si s’utilitza per a desviar el suport. La dada capturada/importada com «Edat en el moment del reconeixement clínic» s’ha de convertir en una dada utilitzant les dades de naixement del pacient.</items><items id="description">Data/hora estimada o real en què un professional sanitari va declarar el diagnòstic o problema.</items><items id="text">Data/hora del diagnòstic clínic</items></items><items code="at0005"><items id="comment">Si la gravetat s’inclou al nom del problema/diagnòstic mitjançant codis preordinats, aquest element de dades serà redundant. Observació: es pot registrar una classificació més específica de la gravetat utilitzant el SLOT Detalls específics.</items><items id="description">Una avaluació de la severitat global del problema o diagnòstic.</items><items id="text">Severitat</items></items><items code="at0009"><items id="comment">Utilitzar per a produir un fons i context, inclosos l’evolució, episodis o exacerbacions, progrés i altres detalls rellevants sobre el problema o diagnòstic.</items><items id="description">Informació addicional del problema o diagnòstic.</items><items id="text">Descripció clínica</items></items><items code="at0012"><items id="comment">Es recomana programar la zona anatòmica amb una terminologia sempre que sigui possible. &#13;
Utilitzar aquest element de dades per registrar zones preordinades anatòmiques. Si els requisits per registrar la localització anatòmica es determinen en temps d’execució per l’aplicació o requereixen un modelatge més complex, com les localitzacions relatives, utilitzar CLUSTER.anatomical_location o CLUSTER.relative_location en el SLOT «Structured anatomical location» d’aquest arquetip. Les ocurrències d’aquest element de dades són il·limitades per a permetre escenaris clínics com la descripció d’una erupció en llocs múltiples, però on tots els altres atributs són idèntics. Si la localització anatòmica s’inclou en el nom de problema/diagnòstic mitjançant codis preordinats aquesta dada serà innecessària.</items><items id="description">Identificació de la zona del cos per a la localització del problema o diagnòstic.</items><items id="text">Zona del cos</items></items><items code="at0030"><items id="comment">Les dades parcials són vàlides. Si el pacient de la cura té menys d’un any, doncs la data completa o el mínim de mes i any és necessari per permetre càlculs d’edat acurats. Per exemple, si s’utilitza per desviar el suport. La dada capturada/importada com «Edat en el moment del reconeixement clínic» s’ha de convertir en una dada utilitzant les dades de naixement de la persona.</items><items id="description">Data/hora estimada o real de resolució o remissió d'aquest problema o diagnòstic, determinada per un professional sanitari.</items><items id="text">Data/hora de resolució</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Utilitzar aquest SLOT per a inserir els arquetips CLUSTER.anatomical_location o CLUSTER.relative_location si els requisits per a registrar la localització anatòmica estan determinats en el temps d’execució per l’aplicació o requereix un modelatge més complex com unes localitzacions relatives. &#13;
&#13;
Si la localització anatòmica s’inclou en el problema/diagnòstic via codis preordinats, utilitzar aquest SLOT esdevindria redundant.</items><items id="description">Localització anatòmica estructurada per al problema o diagnòstic.</items><items id="text">Zona del cos estructurada</items></items><items code="at0043"><items id="comment">Pot incloure dades sobre la graduació o estat del diagnòstic; criteris de diagnòstic, criteris de classificació o avaluacions formals de la gravetat, com els Criteris Terminològics Comuns per a Reaccions Adverses.</items><items id="description">Detalls que es requereixen addicionalment per a registrar atributs únics d'aquest problema o diagnòstic.</items><items id="text">Detalls específics</items></items><items code="at0046"><items id="comment">Utilitzar els qualificadors d'estatus o context amb precaució, ja que s’utilitzen de forma variable en la pràctica i la interoperabilitat no es pot garantir almenys que l’ús es trobi clarament definit per la comunitat d’ús. Per exemple: estat actiu – actiu, inactiu, resolt, en remissió; estat d’evolució – inicial, provisional/en curs, final; estat temporal – actual, passat; estat d’episodi – primer, nou, en curs; estat d’admissió – ingrés, alta; o estat de prioritat – primària, secundària.</items><items id="description">Detalls estructurats per a aspectes específics d'ubicació, domini, episodi o flux de treball del procés diagnòstic.</items><items id="text">Estat</items></items><items code="at0047"><items id="description">El problema o diagnòstic no interfereix amb l'activitat normal ni pot causar danys a la salut si no es tracta.</items><items id="text">Lleu</items></items><items code="at0048"><items id="description">El problema o diagnòstic interfereix amb l'activitat normal o pot causar danys a la salut si no es tracta.</items><items id="text">Moderat</items></items><items code="at0049"><items id="description">El problema o diagnòstic impedeix l'activitat normal o causarà danys greus a la salut si no es tracta.</items><items id="text">Greu</items></items><items code="at0069"><items id="description">Informació descriptiva sobre el problema o diagnòstic no registrada en altres camps.</items><items id="text">Comentaris</items></items><items code="at0070"><items id="description">La data en què es va actualitzar per última vegada aquest problema o diagnòstic.</items><items id="text">Darrera actualització</items></items><items code="at0071"><items id="comment">Per exemple: requisits locals d'informació o metadades addicionals per alinear-se amb equivalents de FHIR o CIMI.</items><items id="description">Informació addicional necessària per a recollir el contingut local o per alinear-se amb altres models/formalismes de referència.</items><items id="text">Extensió</items></items><items code="at0072"><items id="description">Informació addicional del curs del problema o diagnòstic des de l'inici.</items><items id="text">Descripció del curs</items></items><items code="at0073"><items id="comment">Si es necessita un conjunt de valors alternatiu, aquests valors es poden afegir al tipus de dades DV_TEXT en una plantilla.</items><items id="description">El nivell de confiança en la identificació del diagnòstic.</items><items id="text">Certesa diagnòstica</items></items><items code="at0074"><items id="description">El diagnòstic s'ha identificat amb un nivell baix de certesa.</items><items id="text">Sospita</items></items><items code="at0075"><items id="description">El diagnòstic s'ha identificat amb un alt nivell de certesa.</items><items id="text">Probable</items></items><items code="at0076"><items id="description">El diagnòstic s'ha confirmat d'acord amb criteris reconeguts.</items><items id="text">Confirmat</items></items><items code="at0077"><items id="comment">Data capturada/importada com «edat durant la primera aparició» es pot convertir en una edat utilitzant la deta de naixemnt del pacient.</items><items id="description">Data/hora estimada o real en què es van observar per primera vegada els signes o símptomes del problema/diagnòstic.</items><items id="text">Data/hora de l’aparició</items></items><items code="at0078"><items id="comment">També conegut com a «etiologia». Es recomana programar amb una terminologia si és possible.</items><items id="description">Una causa, conjunt de causes o el mecanisme causal del problema o diagnòstic.</items><items id="text">Causa</items></items><items code="at0079"><items id="comment">Per exemple: «neuropatia axonal motora aguda», com a variant de la síndrome de Guillain-Barré. Es recomana programar el nom de la variant amb una terminologia sempre que sigui possible.</items><items id="description">Variant o subtipus específic del Diagnòstic, si escau.</items><items id="text">Variant</items></items><items code="at0080"><items id="comment">El mateix diagnòstic, amb la mateixa gravetat, té un impacte diferent en cada pacient. Aquest qualificador de rellevància implica ajustar l'impacte global d'aquest problema de salut segons les característiques del pacient.&#13;
Per exemple: Dos pacients tenen el mateix diagnòstic. Cremada de primer grau.&#13;
Un és una persona sana, l'altre és un pacient diabètic.&#13;
L'impacte d'aquest problema en un pacient diabètic és MÉS ALT (més risc d'infecció..., més temps de curació).&#13;
Aquest element està pensat per permetre múltiples tipus d'impacte, incloent-hi, entre d'altres: tractament clínic, funcionament a casa, activitats de vida diària o vida laboral.</items><items id="description">Avaluació global de l'impacte o rellevància d'un problema de salut per a un pacient concret.</items><items id="text">Impacte</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="comment">Eine klare Abgrenzung zwischen Problem und Diagnose ist in der Praxis nicht einfach zu erreichen. Für die Zwecke der klinischen Dokumentation mit diesem Archetyp werden Problem und Diagnose als ein Kontinuum betrachtet, mit zunehmendem Detaillierungsgrad und unterstützenden Beweisen, die in der Regel dem Etikett "Diagnose" Gewicht verleihen.</items><items id="description">Angaben über einen einzelnen identifizierten Gesundheitszustand, eine Verletzung, eine Behinderung oder ein Problem, welches das körperliche, geistige und/oder soziale Wohlergehen einer Einzelperson beeinträchtigt.</items><items id="text">Diagnose/Symptom</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Structure</items></items><items code="at0002"><items id="comment">Wo möglich, ist die Kodierung des Problems oder der Diagnose über eine Terminologie zu bevorzugen.</items><items id="description">Namentliche Bezeichnung des Symptoms ("medical Problem") oder der Diagnose.</items><items id="text">Diagnose-/Symptombezeichnung</items></items><items code="at0003"><items id="comment">Unvollständige Datumsangaben sind zulässig. Wenn der Patient unter einem Jahr alt ist, dann ist das vollständige Datum oder ein Minimum von Monat und Jahr notwendig, um genaue Altersberechnungen zu ermöglichen - z.B. wenn es zur Entscheidungsunterstützung verwendet wird. Datumswerte, die als "Alter zum Zeitpunkt der klinischen Feststellung" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items><items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der die Diagnose oder das Problem von einer medizinischen Fachkraft festgestellt wurde.</items><items id="text">Datum/Zeitpunkt der klinischen Feststellung</items></items><items code="at0005"><items id="comment">Ist der Schweregrad über vordefinierte Codes im Element "Name des Problems/ der Diagnose" enthalten, wird dieses Datenelement überflüssig. Hinweis: Eine spezifischere Einstufung des Schweregrads kann mit Hilfe des SLOTs "Spezifische Angaben" angegeben werden.</items><items id="description">Eine Gesamtbeurteilung des Schweregrades des Problems oder der Diagnose.</items><items id="text">Schweregrad</items></items><items code="at0009"><items id="comment">Wird verwendet, um Hintergrund und Kontext, einschließlich Entwicklung, Episoden oder Verschlechterungen, Fortschritt und andere relevante Details über das Problem oder die Diagnose zu liefern.</items><items id="description">Beschreibung des Problems oder der Diagnose.</items><items id="text">Klinische Beschreibung</items></items><items code="at0012"><items id="comment">Wo dies möglich ist, ist die Kodierung der anatomischen Lokalisation über eine Terminologie zu bevorzugen. Verwenden Sie dieses Datenelement, um vorab präkoordinierte anatomische Lokalisationen zu erfassen. Wenn die Anforderungen an die Erfassung der anatomischen Lokalisation zur Laufzeit durch die Anwendung bestimmt werden oder komplexere Modellierungen, wie z.B. relative Lokalisationen erforderlich sind, dann verwenden Sie in diesem Archetyp den CLUSTER.anatomical_location oder CLUSTER.relative_location innerhalb des SLOT 'Structured anatomical location'. Die Anzahl für dieses Datenelement ist unbegrenzt, um klinische Szenarien wie die Beschreibung eines Hautausschlags an mehreren Stellen zu ermöglichen, wobei jedoch alle anderen Attribute identisch sind. Falls die anatomische Lage über präkoordinierte Codes im Namen des Problems/Diagnose enthalten ist, wird dieses Datenelement überflüssig.</items><items id="description">Identifikation einer einfachen Körperstelle zur Lokalisierung des Problems oder der Diagnose.</items><items id="text">Körperstelle</items></items><items code="at0030"><items id="comment">Unvollständige Datumsangaben sind zulässig. Wenn der Patient unter einem Jahr alt ist, dann ist das vollständige Datum oder ein Minimum von Monat und Jahr notwendig, um genaue Altersberechnungen zu ermöglichen - z.B. wenn es zur Entscheidungsunterstützung verwendet wird. Datumswerte, die als "Alter zum Zeitpunkt der Genesung" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items><items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der von einer medizinischen Fachkraft die Genesung oder die Remission des Problems oder der Diagnose festgestellt wurde.</items><items id="text">Datum/Zeitpunkt der Genesung</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Verwenden Sie diesen SLOT, um die Archetypen CLUSTER.anatomical_location oder CLUSTER.relative_location einzufügen, wenn die Anforderungen für die Aufnahme der anatomischen Position zur Laufzeit der Anwendung bestimmt werden oder komplexere Modellierungen wie z.B. relative Positionen erforderlich sind. Ist die anatomische Körperstelle über präkoordinierte Codes im Namen des Problems/Diagnose enthalten, wird die Verwendung dieses SLOT überflüssig.</items><items id="description">Eine strukturierte anatomische Beschreibung der Körperstelle, an der das Problem oder die Diagnose auftreten.</items><items id="text">Strukturierte Körperstelle</items></items><items code="at0043"><items id="comment">Hier können strukturierte Angaben über die Einstufung oder das Stadium der Diagnose enthalten sein; diagnostische Kriterien, Klassifizierungskriterien oder formale Bewertungen des Schweregrades wie z.B. "Common Terminology Criteria for Adverse Events".</items><items id="description">Zusätzlich benötigte Angaben, welche als eindeutige Merkmale des Problem/der Diagnose erfasst werden sollten.</items><items id="text">Spezifische Angaben</items></items><items code="at0046"><items id="comment">Verwenden Sie Status- oder Kontext-Merkmale mit Vorsicht, da sie in der Praxis variabel eingesetzt werden und die Interoperabilität nicht gewährleistet werden kann, sofern die Verwendung nicht mit der Nutzungsgemeinschaft klar abgestimmt wird. Beispiel: aktiver Status - aktiv, inaktiv, genesen, in Remission; Entwicklungsstatus - initial, interim/working, final; zeitlicher Status - aktuell, vergangen; Episodenstatus - erstmalig, neu, laufend; Aufnahmestatus - Aufnahme, Entlassung; oder Prioritätsstatus - primär, sekundär.</items><items id="description">Strukturierte Angaben zu standort-, domänen-, episoden- oder workflow-spezifischen Aspekten des diagnostischen Prozesses.</items><items id="text">Status</items></items><items code="at0047"><items id="description">Das Problem oder die Diagnose beeinträchtigt die normale Aktivität nicht, bzw. verursacht nicht bleibende gesundheitliche Schäden, falls es nicht behandelt wird.</items><items id="text">Leicht</items></items><items code="at0048"><items id="description">Das Problem oder die Diagnose beeinträchtigt die normale Aktivität oder verursacht bleibende gesundheitliche Schäden, falls es nicht behandelt wird.</items><items id="text">Mäßig</items></items><items code="at0049"><items id="description">Das Problem oder die Diagnose verhindert die normale Aktivität oder verursacht schwerwiegende gesundheitliche Schäden, falls es nicht behandelt wird.</items><items id="text">Schwer</items></items><items code="at0069"><items id="description">Ergänzende Beschreibung des Problems oder der Diagnose, die nicht anderweitig erfasst wurde.</items><items id="text">Kommentar</items></items><items code="at0070"><items id="description">Datum der letzten Aktualisierung der Diagnose bzw. des Problems.</items><items id="text">Zuletzt aktualisiert</items></items><items code="at0071"><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="text">Erweiterung</items></items><items code="at0072"><items id="description">Beschreibung des Problem-/ Diagnoseverlaufs seit Beginn.</items><items id="text">Beschreibung des Verlaufs</items></items><items code="at0073"><items id="comment">Wenn ein alternativer Wertesatz benötigt wird, können diese Werte in einem Template zum Datentyp DV_TEXT hinzugefügt werden.</items><items id="description">Grad der Sicherheit, mit der die Diagnose festgestellt wurde.</items><items id="text">Diagnostische Sicherheit</items></items><items code="at0074"><items id="description">Die Diagnose wurde mit einem niedrigen Grad an Sicherheit gestellt.</items><items id="text">Vermutet</items></items><items code="at0075"><items id="description">Die Diagnose wurde mit einem hohen Maß an Sicherheit gestellt.</items><items id="text">Wahrscheinlich</items></items><items code="at0076"><items id="description">Die Diagnose wurde anhand anerkannter Kriterien bestätigt.</items><items id="text">Bestätigt</items></items><items code="at0077"><items id="comment">Datumswerte, die als "Alter zu Beginn" erfasst/importiert werden, sollten anhand des Geburtsdatums der Person in ein Datum umgewandelt werden.</items><items id="description">Geschätzte oder exakte Zeit (bzw. Datum), zu der die Krankheitsanzeichen oder Symptome zum ersten mal beobachtet wurden.</items><items id="text">Datum des erstmaligen Auftretens</items></items><items code="at0078"><items id="comment">Die Codierung mit einer externen Terminologie wird nach Möglichkeit bevorzugt.</items><items id="description">Die Ursache, eine Reihe von Ursachen oder eine Art und Weise der Verursachung des Problems oder der Diagnose.</items><items id="text">Ätiologie</items></items><items code="at0079"><items id="comment">Zum Beispiel: „Akute motorische axonale Neuropathie“ als Variante des Guillain-Barre-Syndroms. Wo möglich, ist die Kodierung des Namens der Variante über eine Terminologie zu bevorzugen.</items><items id="description">Spezifische Variante oder Subtyp der Diagnose, falls relevant.</items><items id="text">Subtyp</items></items><items code="at0080"><items id="comment">Dieselbe Diagnose mit demselben Schweregrad kann sich bei jedem Patienten unterschiedlich auswirken. Dieser Relevanzfaktor bedeutet, dass die Gesamtbelastung durch dieses Gesundheitsproblem entsprechend den Merkmalen des Patienten angepasst werden muss.&#13;
Beispiel: Zwei Patienten haben dieselbe Diagnose: Verbrennungen ersten Grades.&#13;
Der eine ist gesund, der andere leidet an Diabetes.&#13;
Die Belastung durch dieses Problem ist bei einem Diabetiker GRÖSSER (höheres Infektionsrisiko …, längere Heilungsdauer).&#13;
Dieses Element soll verschiedene Arten von Auswirkungen berücksichtigen, darunter unter anderem: klinische Behandlung, Alltag zu Hause, Berufsleben.</items><items id="description">Gesamtbeurteilung der Auswirkungen der Diagnose/des Symptoms auf den Patienten.</items><items id="text">Auswirkungen</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="comment">Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.</items><items id="description">Details about a single identified health condition, injury, disability or any other issue which impacts on the physical, mental and/or social well-being of an individual.</items><items id="text">Problem/Diagnosis</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Coding of the name of the problem or diagnosis with a terminology is preferred, where possible.</items><items id="description">Identification of the problem or diagnosis, by name.</items><items id="text">Problem/Diagnosis name</items></items><items code="at0003"><items id="comment">Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of clinical recognition" should be converted to a date using the subject's date of birth.</items><items id="description">Estimated or actual date/time the diagnosis or problem was recognised by a healthcare professional.</items><items id="text">Date/time clinically recognised</items></items><items code="at0005"><items id="comment">If severity is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant. Note: more specific grading of severity can be recorded using the Specific details SLOT.</items><items id="description">An assessment of the overall severity of the problem or diagnosis.</items><items id="text">Severity</items></items><items code="at0009"><items id="comment">Use to provide background and context, including evolution, episodes or exacerbations, progress and any other relevant details, about the problem or diagnosis.</items><items id="description">Narrative description about the problem or diagnosis.</items><items id="text">Clinical description</items></items><items code="at0012"><items id="comment">Coding of the name of the anatomical location with a terminology is preferred, where possible.&#13;
Use this data element to record precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Structured anatomical location' SLOT in this archetype. Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a rash in multiple locations but where all of the other attributes are identical. If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant.</items><items id="description">Identification of a simple body site for the location of the problem or diagnosis.</items><items id="text">Body site</items></items><items code="at0030"><items id="comment">Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of resolution" should be converted to a date using the subject's date of birth.&#13;
</items><items id="description">Estimated or actual date/time of resolution or remission for this problem or diagnosis, as determined by a healthcare professional.</items><items id="text">Date/time of resolution</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Use this SLOT to insert the CLUSTER.anatomical_location or CLUSTER.relative_location archetypes if the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations.&#13;
&#13;
If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, use of this SLOT becomes redundant.</items><items id="description">A structured anatomical location for the problem or diagnosis.</items><items id="text">Structured body site</items></items><items code="at0043"><items id="comment">May include structured detail about the grading or staging of the diagnosis; diagnostic criteria, classification criteria or formal severity assessments such as Common Terminology Criteria for Adverse Events.</items><items id="description">Details that are additionally required to record as unique attributes of this problem or diagnosis.</items><items id="text">Specific details</items></items><items code="at0046"><items id="comment">Use status or context qualifiers with care, as they are variably used in practice and interoperability cannot be assured unless usage is clearly defined with the community of use. For example: active status - active, inactive, resolved, in remission; evolution status - initial, interim/working, final; temporal status - current, past; episodicity status - first, new, ongoing; admission status - admission, discharge; or priority status - primary, secondary.</items><items id="description">Structured details for location-, domain-, episode- or workflow-specific aspects of the diagnostic process.</items><items id="text">Status</items></items><items code="at0047"><items id="description">The problem or diagnosis does not interfere with normal activity or may cause damage to health if left untreated.</items><items id="text">Mild</items></items><items code="at0048"><items id="description">The problem or diagnosis causes interference with normal activity or will damage health if left untreated.</items><items id="text">Moderate</items></items><items code="at0049"><items id="description">The problem or diagnosis prevents normal activity or will seriously damage health if left untreated.</items><items id="text">Severe</items></items><items code="at0069"><items id="description">Additional narrative about the problem or diagnosis not captured in other fields.</items><items id="text">Comment</items></items><items code="at0070"><items id="description">The date this problem or diagnosis was last updated.</items><items id="text">Last updated</items></items><items code="at0071"><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></items><items code="at0072"><items id="description">Narrative description about the course of the problem or diagnosis since onset.</items><items id="text">Course description</items></items><items code="at0073"><items id="comment">If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.</items><items id="description">The level of confidence in the identification of the diagnosis.</items><items id="text">Diagnostic certainty</items></items><items code="at0074"><items id="description">The diagnosis has been identified with a low level of certainty.</items><items id="text">Suspected</items></items><items code="at0075"><items id="description">The diagnosis has been identified with a high level of certainty.</items><items id="text">Probable</items></items><items code="at0076"><items id="description">The diagnosis has been confirmed against recognised criteria.</items><items id="text">Confirmed</items></items><items code="at0077"><items id="comment">Data captured/imported as "Age at onset" should be converted to a date using the subject's date of birth.</items><items id="description">Estimated or actual date/time that signs or symptoms of the problem/diagnosis were first observed.</items><items id="text">Date/time of onset</items></items><items code="at0078"><items id="comment">Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.</items><items id="description">A cause, set of causes, or manner of causation of the problem or diagnosis.</items><items id="text">Cause</items></items><items code="at0079"><items id="comment">For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.</items><items id="description">Specific variant or subtype of the Diagnosis, if relevant.</items><items id="text">Variant</items></items><items code="at0080"><items id="comment">The same diagnosis, with the same severity, has a different impact on each patient. This relevance qualifier implies adjusting the overall impact of that health problem according to the patient's characteristics.&#13;
For example: Two patients have the same diagnosis. First-degree burn.&#13;
One is a healthy person, the other is a diabetic patient.&#13;
The impact for that problem in a diabetic patient is HIGHER (more risk of infection..., longuer time healing).&#13;
This element is meant to allow for multiple types of impact, including but not limited to: clinical treatment, home functioning, work life.</items><items id="description">Overall assessment of the impact of a health problem for the specific patient.</items><items id="text">Impact</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="comment">En la práctica, no es fácil distinguir claramente entre el alcance de un problema y el de un diagnóstico. A efectos de la documentación clínica con este arquetipo, el problema y el diagnóstico se consideran un continuo, con niveles crecientes de detalle y evidencia de apoyo que generalmente aportan peso a la etiqueta de "diagnóstico".</items><items id="description">Detalles sobre una única condición de salud, lesión, discapacidad o cualquier otro problema identificado que afecte al bienestar físico, mental y/o social de un individuo.</items><items id="text">Problema/Diagnóstico</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Siempre que sea posible, es preferible codificar el nombre del problema o diagnóstico con una terminología.</items><items id="description">Identificación del problema o diagnóstico, por nombre.</items><items id="text">Nombre del problema/diagnóstico</items></items><items code="at0003"><items id="comment">Se aceptan fechas parciales. Si el sujeto atendido es menor de un año, entonces es necesaria la fecha completa o un mínimo del mes y año para permitir cálculos de edad precisos, por ejemplo, si se utiliza para impulsar el apoyo a la toma de decisiones. Los datos registrados/importados, como "Edad en el momento del reconocimiento clínico", deben convertirse a una fecha utilizando la fecha de nacimiento del sujeto.</items><items id="description">Fecha/hora estimada o real en que un profesional sanitario reconoció el diagnóstico o el problema.</items><items id="text">Fecha/Hora de reconocimiento del problema</items></items><items code="at0005"><items id="comment">Si la gravedad está incluida dentro del nombre del problema/diagnóstico mediante códigos precoordinados, este elemento de datos se vuelve redundante. Nota: Se puede registrar una clasificación de gravedad más específica utilizando el SLOT de detalles específicos.</items><items id="description">Evaluación de la gravedad global del problema o diagnóstico.</items><items id="text">Severidad</items></items><items code="at0009"><items id="comment">Se utiliza para proporcionar antecedentes y contexto, incluida la evolución, los episodios o exacerbaciones, los progresos y cualquier otro detalle pertinente, sobre el problema o el diagnóstico.</items><items id="description">Descripción narrativa del problema o diagnóstico.</items><items id="text">Descripción clínica</items></items><items code="at0012"><items id="comment">Siempre que sea posible, es preferible codificar el nombre de la ubicación anatómica con una terminología.&#13;
Utilice este elemento de datos para registrar ubicaciones anatómicas precoordinadas. Si los requisitos para registrar la ubicación anatómica los determina la aplicación en tiempo de ejecución o requieren un modelado más complejo, como ubicaciones relativas, utilice CLUSTER.anatomical_location o CLUSTER.relative_location, dentro del SLOT 'Structured anatomical location', en este arquetipo. Las ocurrencias de este elemento de datos son ilimitadas para permitir escenarios clínicos, como describir una erupción en múltiples ubicaciones pero donde todos los demás atributos son idénticos. Si la ubicación anatómica se incluye en el nombre del problema/diagnóstico mediante códigos precoordinados, este dato será redundante.</items><items id="description">Identificación de una zona corporal sencilla para la localización del problema o diagnóstico.</items><items id="text">Zona corporal</items></items><items code="at0030"><items id="comment">Se aceptan fechas parciales. Si el sujeto atendido es menor de un año, entonces es necesaria la fecha completa o un mínimo del mes y año para permitir cálculos de edad precisos, por ejemplo, si se utiliza para impulsar el apoyo a la toma de decisiones. Los datos registrados/importados como "Edad en el momento de la resolución" deben convertirse a una fecha utilizando la fecha de nacimiento del sujeto.</items><items id="description">Fecha/hora estimada o real de resolución o remisión de este problema o diagnóstico, determinada por un profesional sanitario.</items><items id="text">Fecha/hora de resolución</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Utilice este SLOT para insertar los arquetipos CLUSTER.anatomical_location o CLUSTER.relative_location si la aplicación determina los requisitos para registrar la ubicación anatómica en tiempo de ejecución o requiere un modelado más complejo, como ubicaciones relativas.&#13;
&#13;
Si la ubicación anatómica se incluye en el nombre del problema/diagnóstico mediante códigos precoordinados, el uso de este SLOT se vuelve redundante.</items><items id="description">Ubicación anatómica estructurada del problema o diagnóstico.</items><items id="text">Zona corporal estructurada</items></items><items code="at0043"><items id="comment">Puede incluir detalles estructurados sobre la clasificación o estadificación del diagnóstico; criterios de diagnóstico, criterios de clasificación o evaluaciones de gravedad formales, como los Criterios Terminológicos Comunes para Eventos Adversos.</items><items id="description">Detalles que es necesario registrar adicionalmente como atributos únicos de este problema o diagnóstico.</items><items id="text">Detalles específicos</items></items><items code="at0046"><items id="comment">Utilice los calificadores de estado o contexto con precaución, ya que se utilizan de forma variable en la práctica y no se puede garantizar la interoperabilidad a menos que su uso esté claramente definido con la comunidad de uso. Por ejemplo: estado activo - activo, inactivo, resuelto, en remisión; estado de evolución - inicial, provisional/en curso, final; estado temporal - actual, pasado; estado de episodicidad - primero, nuevo, en curso; estado de admisión - ingreso, alta; o estado de prioridad - primaria, secundaria.</items><items id="description">Detalles estructurados para aspectos específicos del proceso de diagnóstico de ubicación, dominio, episodio o flujo de trabajo.</items><items id="text">Estado</items></items><items code="at0047"><items id="description">El problema o diagnóstico no interfiere con la actividad normal ni puede causar daños a la salud si no se trata.</items><items id="text">Leve</items></items><items code="at0048"><items id="description">El problema o diagnóstico interfiere en la actividad normal o perjudica la salud si no se trata.</items><items id="text">Moderado</items></items><items code="at0049"><items id="description">El problema o diagnóstico impide la actividad normal o perjudica gravemente la salud si no se trata.</items><items id="text">Severo</items></items><items code="at0069"><items id="description">Información adicional sobre el problema o el diagnóstico no recogida en otros campos.</items><items id="text">Comentarios</items></items><items code="at0070"><items id="description">Fecha de la última actualización de este problema o diagnóstico.</items><items id="text">Última actualización</items></items><items code="at0071"><items id="comment">Por ejemplo: requisitos locales de información o metadatos adicionales para alinearse con los equivalentes de FHIR o CIMI.</items><items id="description">Información adicional necesaria para registrar el contenido local o para alinearse con otros modelos/formalismos de referencia.</items><items id="text">Ampliación</items></items><items code="at0072"><items id="description">Descripción narrativa sobre la evolución del problema o diagnóstico desde su aparición.</items><items id="text">Progreso</items></items><items code="at0073"><items id="comment">Si se necesita un conjunto de valores alternativo, estos valores pueden añadirse al tipo de datos DV_TEXT en una plantilla.</items><items id="description">Nivel de confianza en la identificación del diagnóstico.</items><items id="text">Certeza diagnóstica</items></items><items code="at0074"><items id="description">El diagnóstico se ha identificado con un bajo nivel de certeza.</items><items id="text">Dudoso</items></items><items code="at0075"><items id="description">El diagnóstico se ha identificado con un alto nivel de certeza.</items><items id="text">Probable</items></items><items code="at0076"><items id="description">El diagnóstico se ha confirmado con criterios reconocidos.</items><items id="text">Confirmado</items></items><items code="at0077"><items id="comment">Los datos registrados/importados, como "Edad al inicio", deben convertirse a una fecha utilizando la fecha de nacimiento del sujeto.</items><items id="description">Fecha/hora estimada o real en que se observaron por primera vez los signos o síntomas del problema/diagnóstico.</items><items id="text">Fecha/hora de inicio</items></items><items code="at0078"><items id="comment">También denominada "etiología". Siempre que sea posible, es preferible codificar con una terminología.</items><items id="description">Causa, conjunto de causas o manera de causar el problema o diagnóstico.</items><items id="text">Causa</items></items><items code="at0079"><items id="comment">Por ejemplo: "neuropatía axonal motora aguda" como variante del síndrome de Guillain-Barré. Siempre que sea posible, es preferible codificar el nombre de la variante con una terminología.</items><items id="description">Variante o subtipo específico del Diagnóstico, si procede.</items><items id="text">Variante</items></items><items code="at0080"><items id="comment">El mismo diagnóstico, con la misma gravedad, tiene un impacto diferente en cada paciente. Este factor de relevancia implica ajustar el impacto general de ese problema de salud según las características del paciente.&#13;
Por ejemplo: Dos pacientes tienen el mismo diagnóstico: quemadura de primer grado.&#13;
Uno es una persona sana; el otro, un paciente diabético.&#13;
El impacto de ese problema en un paciente diabético es MAYOR (mayor riesgo de infección, mayor tiempo de recuperación).&#13;
Este elemento está destinado a permitir múltiples tipos de impacto, incluidos pero no limitado a: tratamiento clínico, funcionamiento en el hogar o vida laboral.</items><items id="description">Evaluación global del impacto o relevancia de un problema de salud para un paciente concreto.</items><items id="text">Impacto</items></items></term_definitions><term_definitions language="es-ar"><items code="at0000"><items id="comment">La delineación entre el alcance de un problema versus el diagnóstico puede no ser fácil de lograr en la práctica. A los fines de la documentación clínica mediante este arquetipo, problema y diagnóstico son considerados un continuo, donde niveles incrementales de detalles y evidencia de apoyo otorgan mas peso a la etiqueta de "diagnóstico".</items><items id="description">Detalles acerca de una condición de salud, lesión, incapacidad o cualquier otra cuerstión, univocamente identificadas, que impacta sobre el bienestar físico, mental y/o social de un individuo</items><items id="text">Problema/Diagnóstico</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*structure(en)</items></items><items code="at0002"><items id="comment">Se prefiere la codificación del nombre del problema o diagnóstico mediante una terminología cuando esto sea posible.</items><items id="description">Identificación del problema o diagnóstico, por nombre.</items><items id="text">Nombre del problema/diagnóstico</items></items><items code="at0003"><items id="comment">El uso de fechas parciales es aceptable. Si el sujeto de cuidados tiene menos de un año de edad, se requiere la fecha completa o al menos el año y mes para permitir cálculos adecuados (si por ejemplo se utiliza para guiar un apoyo a la toma de decisiones). Los datos registrados o importados como "Edad a la aparición" deberán ser convertidos a una fecha utilizando la fecha de nacimiento del sujeto.</items><items id="description">Fecha y hora estimadas o confirmadas en las cuales el diagnóstico o problema fue reconocido por el profesional de la salud.</items><items id="text">Fecha y hora del reconocimiento clínico</items></items><items code="at0005"><items id="comment">Si la severidad del problema o diagnóstico esta incluida en su nombre mediante códigos precoordinados, este dato se torna redundante. Nota: una gradación ,as específica de severidad puede ser registrada utilizando el slot de Detalles específicos.</items><items id="description">Una evaluación de la severidad general del problema o diagnóstico.</items><items id="text">Severidad</items></items><items code="at0009"><items id="comment">Utilizar para proveer trasfondo y contexto, incluyendo evolución, episodios o exacerbaciones, progreso y cualquier otro detalles relevante acerca del problema o diagnóstico.</items><items id="description">Descripción narrativa del problema o diagnóstico.</items><items id="text">Descripción clínica</items></items><items code="at0012"><items id="comment">Se prefiere la codificación de la localización anatómica mediante una terminología cuando esto sea posible.&#13;
Utilícese este dato para registrar localizaciones anatómicas precoordinadas. Si los requerimientos para el registro de una localización anatómica son determinadas en tiempo de ejecución por parte de la aplicación, o se requiere un modelado más complejo tal como una localización relativa, utilícese CLUSTER.anatomical_location or CLUSTER.relative_location dentro del slot "localización anatómica estructurada" en este arquetipo. Las ocurrencias de este dato son ilimitadas para así permitir escenarios clínicos tales como la descripción de un rash en múltiples localizaciones pero donde todos los demás atributos son idénticos. Si la localización anatómica esta incluida en el nombre del problema o diagnóstico mediante códigos precoordinados, este dato se torna redundante.</items><items id="description">Identificación de un sitio corporal simple para la localización o el problema.</items><items id="text">Sitio corporal</items></items><items code="at0030"><items id="comment">El uso de fechas parciales es aceptable. Si el sujeto de cuidados tiene menos de un año de edad, se requiere la fecha completa o al menos el año y mes para permitir cálculos adecuados (si por ejemplo se utiliza para guiar un apoyo a la toma de decisiones).</items><items id="description">Fecha y hora estimadas o confirmadas en las cuales este problema o diagnóstico remitió o se resolvió, determinadas de un profesional de la salud.</items><items id="text">Fecha/hora de resolución</items></items><items code="at0032"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0039"><items id="comment">Utilícese este slot para insertar los arqeutipos de CLUSTER.anatomical_location o CLUSTER.relative_location si los requerimientos de registro de la localización anatómica son determinados en tiempo de ejecución por la aplicación o se requiere un modelado más complejo tal como localizaciones relativas.&#13;
Si la localización anatómica está incluida en el nombre del problema o diagnóstico mediante códigos precoordinados, este dato se torna redundante.</items><items id="description">una localización anatómica estructurada para el problema o diagnóstico.</items><items id="text">Sitio corporal estructurado</items></items><items code="at0043"><items id="comment">Puede incluir detalles estructurados acerca del grado o estadificación del diagnóstico, criterios diagnósticos, criterios de clasificación o una evaluación formal de severidad tal como los Criterios Terminológicos Comunes para Eventos Adversos.</items><items id="description">Detalles adicionales requeridos para registrar como atributos unívocos del este problema o diagnóstico.</items><items id="text">Detalles específicos</items></items><items code="at0046"><items id="comment">Los calificadores de estado o contexto con cuidado ya que son variables en su utilización y la interoperabilidad no puede ser garantizada excepto en casos en que se encuentren claramente definidos en el seno de la comunidad de uso. Por ejemplo, el estado de actividad (activo, inactivo, resuelto o en remisión), el estado de evolución (inicial, interino o de trabajo, final), el estado temporal (actual, pasado), el estado episódico (primero, inicial, en curso), el estado de admisión (admisión, egreso) o el estado de prioridad (primario, secundario).</items><items id="description">Detalles estructurados para los aspectos específicos de localización, dominio, episodio o decurso del proceso diagnóstico.</items><items id="text">Estado</items></items><items code="at0047"><items id="description">El problema o diagnóstico no interfiere con la actividad normal o puede causar daños a la salud si no es tratado.</items><items id="text">Leve</items></items><items code="at0048"><items id="description">El problema o diagnóstico interfiere con la actividad normal o puede dañar la salud si no es tratado.</items><items id="text">Moderado</items></items><items code="at0049"><items id="description">El problema o diagnóstico impide la actividad normal o pude dañar seriamente la salud si no es tratado.</items><items id="text">Severo</items></items><items code="at0069"><items id="description">Narrativa adicional acerca del problema o diagnóstico que no ha sido consignada en otros campos.</items><items id="text">Comentario</items></items><items code="at0070"><items id="description">La fecha de la última actualización de este problema o diagnóstico.</items><items id="text">Última actualización.</items></items><items code="at0071"><items id="comment">Por ejemplo: requerimientos de información local o metadatos adicionales para alineamiento con equivalentes en FHIR o CIMI.</items><items id="description">Información adicional requerida para consignar contenidos locales o alinear con otros modelos de referencia o formalismos.</items><items id="text">Extensión</items></items><items code="at0072"><items id="description">Descripción narrativa del curso del problema o diagnóstico desde su aparición.</items><items id="text">Descripción del curso</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">El nivel de certeza de la identificación del diagnóstico.</items><items id="text">Certeza diagnóstica</items></items><items code="at0074"><items id="description">El diagnóstico ha sido identificado con un bajo nivel de certeza.</items><items id="text">Sospechado</items></items><items code="at0075"><items id="description">El diagnóstico ha sido identificado con un alto nivel de certeza.</items><items id="text">Probable</items></items><items code="at0076"><items id="description">El diagnóstico ha sido confirmado en base a criterios reconocidos.</items><items id="text">Confirmado</items></items><items code="at0077"><items id="comment">Los datos registrados o importados como "Edad a la aparición" deberán ser convertidos a una fecha utilizando la fecha de nacimiento del sujeto.</items><items id="description">Fecha y hora estimadas o confirmadas en las cuales los signos o síntomas del problema fueron observados por primera vez.</items><items id="text">Fecha/hora de aparición</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="comment">*Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.(en)</items><items id="description">Yksityiskohdat yksittäisestä tunnistetusta terveystilasta, vammasta, vammasta tai muusta aiheesta, joka vaikuttaa yksilön fyysiseen, henkiseen ja / tai sosiaaliseen hyvinvointiin.</items><items id="text">Ongelma/Diagnoosi</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">*Coding of the name of the problem or diagnosis with a terminology is preferred, where possible.(en)</items><items id="description">Ongelman tai diagnoosin tunnistaminen nimellä.</items><items id="text">Ongelman/Diagnoosin nimi</items></items><items code="at0003"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of clinical recognition" should be converted to a date using the subject's date of birth.(en)</items><items id="description">Arvioitu tai tarkka ajankohta ongelman tai diagnoosin toteamiselle terv.huollon ammattilaisen tekemänä</items><items id="text">Toteamispäivämäärä</items></items><items code="at0005"><items id="comment">*If severity is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant. Note: more specific grading of severity can be recorded using the Specific details SLOT.(en)</items><items id="description">Arvioitu vakavuus oireen tai diagnoosin kohdalla</items><items id="text">Vakavuus</items></items><items code="at0009"><items id="comment">*Use to provide background and context, including evolution, episodes or exacerbations, progress and any other relevant details, about the problem or diagnosis.(en)</items><items id="description">Ongelman tai diagnoosin vapaamuotoinen selitys</items><items id="text">Kliininen kuvaus</items></items><items code="at0012"><items id="comment">*Coding of the name of the anatomical location with a terminology is preferred, where possible.&#13;
Use this data element to record precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Structured anatomical location' SLOT in this archetype. Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a rash in multiple locations but where all of the other attributes are identical. If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">Yksinkertaisen vartalokohdan tunnistaminen ongelman tai diagnoosin sijaintia varten.</items><items id="text">Kehonosa</items></items><items code="at0030"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of resolution" should be converted to a date using the subject's date of birth.(en)</items><items id="description">ongelman tai diagnoosin arvioitu tai todellinen ratkaisemis- tai loppumispäivämäärä / -aika, jonka on määrittänyt terveydenhuollon ammattilainen.</items><items id="text">Toteamise pvm</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">*Use this SLOT to insert the CLUSTER.anatomical_location or CLUSTER.relative_location archetypes if the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations.&#13;
&#13;
If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, use of this SLOT becomes redundant.(en)</items><items id="description">Ongelman tai diagnoosin anatominen alue</items><items id="text">Anatominen alue</items></items><items code="at0043"><items id="comment">*May include structured detail about the grading or staging of the diagnosis; diagnostic criteria, classification criteria or formal severity assessments such as Common Terminology Criteria for Adverse Events.(en)</items><items id="description">Tiedot, joita tarvitaan lisäksi tämän ongelman tai diagnoosin yksilöivinä ominaisuuksina tallentamiseksi.</items><items id="text">Tarkennettu tieto</items></items><items code="at0046"><items id="comment">*Use status or context qualifiers with care, as they are variably used in practice and interoperability cannot be assured unless usage is clearly defined with the community of use. For example: active status - active, inactive, resolved, in remission; evolution status - initial, interim/working, final; temporal status - current, past; episodicity status - first, new, ongoing; admission status - admission, discharge; or priority status - primary, secondary.(en)</items><items id="description">Jäsennellyt yksityiskohdat diagnosointiprosessin sijainti-, alue-, jakso- tai työnkulkukohtaisista näkökohdista.</items><items id="text">Status</items></items><items code="at0047"><items id="description">Ongelma tai diagnoosi ei häiritse normaalia toimintaa tai voi aiheuttaa terveysvaurioita, jos sitä ei hoideta.</items><items id="text">Vähäinen</items></items><items code="at0048"><items id="description">Ongelma tai diagnoosi häiritsee normaalia toimintaa tai vahingoittaa terveyttä, jos sitä jätetään hoitamatta.</items><items id="text">Kohtalainen</items></items><items code="at0049"><items id="description">Ongelma tai diagnoosi estää normaalia toimintaa tai vahingoittaa vakavasti terveyttä, jos sitä jätetään hoitamatta.</items><items id="text">Vakava</items></items><items code="at0069"><items id="description">Lisätietoa ongelmasta tai diagnoosista, jota ei voi asettaa edeltäville tietokentille.</items><items id="text">Kommentti</items></items><items code="at0070"><items id="description">Ongelman tai diagnoosin viimeisin päivityspäivämäärä</items><items id="text">Viimeksi päivitetty</items></items><items code="at0071"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Laajennus</items></items><items code="at0072"><items id="description">Kuvaus ongelman tai diagnoosin etenemisestä alusta.</items><items id="text">Ongelman kulku</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">Diagnoosin tunnistamisen luotettavuus</items><items id="text">Diagnoosin varmuus</items></items><items code="at0074"><items id="description">Diagnoosi on tunnistettu alhaisella varmuustasolla.</items><items id="text">Epäilty</items></items><items code="at0075"><items id="description">Diagnoosi on tunnistettu erittäin varmuudella.</items><items id="text">Mahdollinen</items></items><items code="at0076"><items id="description">Diagnoosi on vahvistettu tunnustettujen kriteerien perusteella.</items><items id="text">Varmistettu</items></items><items code="at0077"><items id="comment">*Data captured/imported as "Age at onset" should be converted to a date using the subject's date of birth.(en)</items><items id="description">Arvioitu tai todellinen päivämäärä / aika, jolloin ongelman / diagnoosin merkkejä tai oireita havaittiin ensimmäisen kerran.</items><items id="text">Alkamis pvm</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="fr"><items code="at0000"><items id="comment">Dans la pratique, il n’est pas facile d’établir une distinction claire entre la portée d’un problème et celle d’un diagnostic. Aux fins de la documentation clinique avec cet archétype, le problème et le diagnostic sont considérés comme un continuum, où des niveaux croissants de détail et de preuves à l’appui confèrent généralement plus de poids à la notion de « diagnostic ».</items><items id="description">Informations détaillées concernant un état de santé, une blessure, un handicap ou tout autre problème identifié ayant une incidence sur le bien-être physique, mental et/ou social d’une personne.</items><items id="text">Problème/Diagnostic</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Dans la mesure du possible, il est préférable de coder le nom du problème ou du diagnostic à l’aide d’une terminologie.</items><items id="description">Identification du problème ou du diagnostic, par son nom.</items><items id="text">Nom du problème/diagnostic</items></items><items code="at0003"><items id="comment">Les dates partielles sont acceptables. Si la personne prise en charge est âgée de moins d’un an, la date complète ou, au minimum, le mois et l’année sont nécessaires pour permettre un calcul précis de l’âge – par exemple, si ces informations sont utilisées pour l’aide à la décision. Les données saisies/importées sous la forme « Âge au moment du diagnostic clinique » doivent être converties en une date à partir de la date de naissance de la personne.</items><items id="description">Date/heure estimées ou réelles auxquelles le diagnostic ou le problème a été reconnue par un professionnel de santé.</items><items id="text">Date/heure de reconnaissance clinique</items></items><items code="at0005"><items id="comment">Si le degré de gravité est inclus dans le nom du problème/diagnostic via des codes précoordonnés, cet élément de données devient redondant. Remarque : une classification plus précise du degré de gravité peut être consignée à l’aide du slot « Détails spécifiques ».</items><items id="description">Évaluation de la gravité globale du problème ou du diagnostic.</items><items id="text">Gravité</items></items><items code="at0009"><items id="comment">À utiliser pour fournir des informations générales et le contexte, notamment l’évolution, les épisodes ou les exacerbations, les progrès et tout autre détail pertinent, concernant le problème ou le diagnostic.</items><items id="description">Description narrative du problème ou du diagnostic.</items><items id="text">Description clinique</items></items><items code="at0012"><items id="comment">Dans la mesure du possible, il est préférable de coder le nom de la localisation anatomique à l’aide d’une terminologie.&#13;
Utilisez cet élément de données pour enregistrer des localisations anatomiques précoordonnées. Si les exigences relatives à l’enregistrement de la localisation anatomique sont déterminées au moment de l’exécution par l’application ou nécessitent une modélisation plus complexe, telle que des localisations relatives, utilisez alors les éléments CLUSTER.anatomical_location ou CLUSTER.relative_location au sein du SLOT « Localisation anatomique structurée » de cet archétype. Le nombre d’occurrences de cet élément de données est illimité afin de permettre des scénarios cliniques tels que la description d’une éruption cutanée à plusieurs emplacements, mais où tous les autres attributs sont identiques. Si l’emplacement anatomique est inclus dans le nom du problème/diagnostic via des codes précoordonnés, cet élément de données devient redondant.</items><items id="description">Identification d’une simple partie du corps où se situe le problème ou le diagnostic.</items><items id="text">Site corporel</items></items><items code="at0030"><items id="comment">Les dates partielles sont acceptables. Si la personne prise en charge est âgée de moins d’un an, la date complète ou, au minimum, le mois et l’année sont nécessaires pour permettre un calcul précis de l’âge – par exemple, si ces informations sont utilisées pour l’aide à la décision. Les données saisies ou importées sous la forme « Âge au moment de la résolution » doivent être converties en date à l’aide de la date de naissance de la personne concernée.</items><items id="description">Date/heure estimées ou réelles de la résolution ou de la rémission de ce problème ou de ce diagnostic, telles que déterminées par un professionnel de santé.</items><items id="text">Date/heure de résolution</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Utilisez ce SLOT pour insérer les archétypes CLUSTER.anatomical_location ou CLUSTER.relative_location si les exigences relatives à l’enregistrement de la localisation anatomique sont déterminées au moment de l’exécution par l’application ou nécessitent une modélisation plus complexe, telle que les localisations relatives.&#13;
&#13;
Si la localisation anatomique est incluse dans le nom du problème/diagnostic via des codes précoordonnés, l’utilisation de ce SLOT devient superflue.</items><items id="description">Localisation anatomique structurée du problème ou du diagnostic.</items><items id="text">Site corporel structuré</items></items><items code="at0043"><items id="comment">Peut inclure des détails structurés concernant la classification ou le stade du diagnostic ; les critères diagnostiques, les critères de classification ou les évaluations formelles de la gravité, telles que les « Common Terminology Criteria for Adverse Events » (Critères terminologiques communs pour les événements indésirables).</items><items id="description">Détails supplémentaires à enregistrer en tant qu’attributs spécifiques à ce problème ou à ce diagnostic.</items><items id="text">Détails spécifiques</items></items><items code="at0046"><items id="comment">Utilisez les qualificatifs de statut ou de contexte avec prudence, car leur usage varie dans la pratique et l’interopérabilité ne peut être garantie que si leur utilisation est clairement définie au sein de la communauté d’utilisateurs. Par exemple : statut d’activité – actif, inactif, résolu, en rémission ; statut d’évolution – initial, intermédiaire/en cours, final ; statut temporel – actuel, passé ; statut d’épisodicité – premier, nouveau, en cours ; statut d’admission – admission, sortie ; ou statut de priorité – primaire, secondaire.</items><items id="description">Informations structurées concernant les aspects du processus diagnostique liés au lieu, au domaine, à l’épisode ou au flux de travail.</items><items id="text">Statut</items></items><items code="at0047"><items id="description">Le problème ou le diagnostic n’entrave pas l’activité normale, mais peut nuire à la santé s’il n’est pas traité.</items><items id="text">Légère</items></items><items code="at0048"><items id="description">Le problème ou le diagnostic perturbe le déroulement normal des activités ou, s’il n’est pas traité, risque de nuire à la santé.</items><items id="text">Modéré</items></items><items code="at0049"><items id="description">Le problème ou le diagnostic empêche l’activité normale ou portera gravement atteinte à la santé s’il n’est pas traité.</items><items id="text">Grave</items></items><items code="at0069"><items id="description">Description complémentaire du problème ou du diagnostic non reprise dans d’autres champs.</items><items id="text">Commentaire</items></items><items code="at0070"><items id="description">Date de la dernière mise à jour de ce problème ou de ce diagnostic.</items><items id="text">Dernière mise à jour</items></items><items code="at0071"><items id="comment">Par exemple: exigences d’information locales ou métadonnées supplémentaires permettant l’alignement avec des équivalents FHIR ou CIMI.</items><items id="description">Informations supplémentaires nécessaires pour représenter un contenu local ou pour assurer l’alignement avec d’autres modèles de référence ou formalismes.</items><items id="text">Extension</items></items><items code="at0072"><items id="description">Description narrative de l'évolution du problème ou du diagnostic depuis son apparition.</items><items id="text">Description du cours</items></items><items code="at0073"><items id="comment">Si un ensemble de valeurs alternatif est nécessaire, ces valeurs peuvent être ajoutées au type de données DV_TEXT dans un template.</items><items id="description">Le niveau de confiance dans l’identification du diagnostic.</items><items id="text">Certitude diagnostique</items></items><items code="at0074"><items id="description">Le diagnostic a été établi avec un faible degré de certitude.</items><items id="text">Soupçonné</items></items><items code="at0075"><items id="description">Le diagnostic a été établi avec un haut degré de certitude.</items><items id="text">Probable</items></items><items code="at0076"><items id="description">Le diagnostic a été confirmé au regard de critères reconnus.</items><items id="text">Confirmé</items></items><items code="at0077"><items id="comment">Les données saisies ou importées sous la rubrique « Âge au moment de l'apparition » doivent être converties en date à partir de la date de naissance de la personne concernée.</items><items id="description">Date/heure estimées ou réelles auxquelles les signes ou symptômes du problème ou du diagnostic ont été observés pour la première fois.</items><items id="text">Date/heure d'apparition</items></items><items code="at0078"><items id="comment">Également appelé « étiologie ». Le codage à l’aide d’une terminologie externe est privilégié, dans la mesure du possible.</items><items id="description">Une cause, un ensemble de causes ou un mécanisme de causalité du problème ou du diagnostic.</items><items id="text">Cause</items></items><items code="at0079"><items id="comment">Par exemple : « neuropathie axonale motrice aiguë » en tant que variante du syndrome de Guillain-Barré. Dans la mesure du possible, il est préférable de coder le nom de la variante à l’aide d’une terminologie.</items><items id="description">Variante ou sous-type spécifique du diagnostic, le cas échéant.</items><items id="text">Variante</items></items><items code="at0080"><items id="comment">Un même diagnostic, d’une même gravité, a un impact différent sur chaque patient. Ce critère de pertinence implique d’ajuster l’impact global de ce problème de santé en fonction des caractéristiques du patient.&#13;
Par exemple : deux patients ont le même diagnostic : une brûlure au premier degré.&#13;
L’un est en bonne santé, l’autre est diabétique.&#13;
L’impact de ce problème chez un patient diabétique est PLUS ÉLEVÉ (risque accru d’infection…, temps de guérison plus long).&#13;
Cet élément vise à prendre en compte plusieurs types d’impact, notamment, mais sans s’y limiter : le traitement clinique, le fonctionnement au quotidien, la vie professionnelle.</items><items id="description">Évaluation globale de l’impact d’un problème de santé sur le patient concerné.</items><items id="text">Impact</items></items></term_definitions><term_definitions language="it"><items code="at0000"><items id="comment">Nella pratica, non è facile fare una distinzione netta tra gli ambiti dei concetti 'problema' e 'diagnosi'. Ai fini della documentazione clinica con questo archetipo, problema e diagnosi sono considerati un continuum, con livelli crescenti di dettagli ed evidenze a supporto a supporto dell'etichetta 'diagnosi'.</items><items id="description">Dettagli su una specifica condizione di salute, una lesione, una disabilità o un qualsiasi altro problema individuato su un individuo che abbia un impatto sul benessere fisico, mentale e/o sociale.</items><items id="text">Problema/Diagnosi</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Si preferisce, ove possibile, la codifica del problema o diagnosi con una terminologia.</items><items id="description">Nome/identificativo del problema o della diagnosi.</items><items id="text">Nome del problema/diagnosi</items></items><items code="at0003"><items id="comment">Sono accettabili le date parziali. Se il soggetto ha età inferiore ad un anno, sono necessari la data completa o almeno il mese e l'anno per permettere un calcolo accurato dell'età - ad esempio, se utilizzato per guidare il supporto decisionale. I dati acquisiti/importati come 'Età al momento del riconoscimento clinico' dovrebbero essere convertiti in una data usando la data di nascita del soggetto.</items><items id="description">Data/ora, stimate o effettive, in cui la diagnosi o il problema sono stati riconosciuti da un operatore sanitario.</items><items id="text">Data/ora di riconoscimento clinico</items></items><items code="at0005"><items id="comment">Se la severità è inclusa nel campo 'Nome del problema/diagnosi' attraverso una codifica prestabilita, questo elemento risulta ridondante. Nota: una classificazione più specifica della severità può essere memorizzata usando lo SLOT 'Dettagli specifici'.</items><items id="description">Una valutazione generale della severità del problema o della diagnosi.</items><items id="text">Severità</items></items><items code="at0009"><items id="comment">Utilizzare questo campo per fornire il background e il contesto, compresa l'evoluzione, gli episodi o le esacerbazioni, i progressi e qualsiasi altro dettaglio rilevante circa il problema o la diagnosi.</items><items id="description">Descrizione narrativa del problema o della diagnosi.</items><items id="text">Descrizione clinica</items></items><items code="at0012"><items id="comment">Si preferisce, ove possibile, la codifica del sito anatomico con una terminologia.  Utilizzare questo campo per memorizzare posizioni anatomiche precoordinate. Se i requisiti per la registrazione della localizzazione sono determinati in fase di esecuzione dell'applicazione  (run-time) o se richiedono una modellazione più complessa, come ad esempio le posizioni relative, allora utilizzare gli archetipi CLUSTER.anatomical_location o CLUSTER.relative_location all'interno dello SLOT di questo archetipo 'Dettagli strutturati del sito corporeo'.  Questo campo non ha limite sulle occorrenze per essere adattabile a scenari clinici come la descrizione di un'eruzione cutanea che coinvolge più siti corporei, ma dove tutti gli altri attributi sono identici. Se la posizione anatomica è inclusa nel campo 'Nome del problema/diagnosi attraverso una codifica prestabilita, questo elemento risulta ridondante.</items><items id="description">Identificativo di un semplice sito corporeo per per la localizzazione del problema o della diagnosi.</items><items id="text">Sito corporeo</items></items><items code="at0030"><items id="comment">Sono accettabili le date parziali. Se il soggetto ha età inferiore ad un anno, sono necessari la data completa o almeno il mese e l'anno per permettere un calcolo accurato dell'età - ad esempio, se utilizzato per guidare il supporto decisionale. I dati acquisiti/importati come 'Età al momento della risoluzione' dovrebbero essere convertiti in una data usando la data di nascita del soggetto.</items><items id="description">Data/ora, stimate o effettive, della risoluzione o remissione del problema o della diagnosi come determinato da un operatore sanitario.</items><items id="text">Data/ora di risoluzione</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Usare questo SLOT per inserire gli archetipi CLUSTER.anatomical_location o CLUSTER.relative_location se i requisiti per la registrazione della localizzazione sono determinati in fase di esecuzione dell'applicazione  (run-time) o se richiedono una modellazione più complessa, come ad esempio per le posizioni relative. Se la posizione anatomica è inclusa nel campo 'Nome del problema/diagnosi attraverso una codifica prestabilita, questo elemento risulta ridondante.</items><items id="description">Una descrizione strutturata della localizzazione anatomica a cui il problema o la diagnosi si riferiscono.</items><items id="text">Dettagli strutturati del sito corporeo</items></items><items code="at0043"><items id="comment">Può includere dettagli strutturati sulla classificazione o la stadiazione della diagnosi; criteri diagnostici, criteri di classificazione o valutazioni formali della severità, come ad esempio CTCAE - Common Terminology Criteria for Adverse Events.</items><items id="description">Ulteriori dettagli richiesti per memorizzare attributi specifici del problema o della diagnosi.</items><items id="text">Ulteriori dettagli</items></items><items code="at0046"><items id="comment">L'uso di qualificatori per indicare lo stato o il contesto dovrebbe essere fatto con attenzione, in quanto il loro utilizzo varia nella pratica e l'interoperabilità non può essere garantita a meno che l'utilizzo di quei codici non sia universalmente accettato dalla comunità. Ad esempio: stato attivo - attivo, inattivo, risolto, in remissione; stato evolutivo - iniziale, intermedio/in progressione, finale; stato temporale - attuale, passato; stato di episodicità - primo, nuovo, in corso; stato di ammissione - ammissione, dimissione; o stato di priorità - primario, secondario.</items><items id="description">Dettagli strutturati per descrivere aspetti del processo diagnostico specifici in relazione alla localizzazione, dominio, episodio o workflow.</items><items id="text">Stato</items></items><items code="at0047"><items id="description">Il problema o la diagnosi non interferiscono con la normale attività o potrebbero causare problemi di salute salute se non trattati.</items><items id="text">Lieve</items></items><items code="at0048"><items id="description">Il problema o la diagnosi interferiscono con la normale attività o causerebbero problemi di salute se non trattati.</items><items id="text">Moderato</items></items><items code="at0049"><items id="description">Il problema o la diagnosi impediscono la normale attività o causerebbero problemi di salute importanti se non trattati.</items><items id="text">Severo</items></items><items code="at0069"><items id="description">Informazioni aggiuntive sul problema o diagnosi non catturate in altri campi.</items><items id="text">Commento</items></items><items code="at0070"><items id="description">La data in cui questo record di Problema/Diagnosi è stato aggiornato l'ultima volta.</items><items id="text">Ultimo aggiornamento</items></items><items code="at0071"><items id="comment">Ad esempio: requisiti informativi locali o metadati addizionali per l'allineamento ai corrispondenti modelli FHIR o CIMI.</items><items id="description">Informazioni aggiuntive necessarie per registrare specifici contenuti locali o per allinearsi con altri modelli/formalismi di riferimento.</items><items id="text">Estensione</items></items><items code="at0072"><items id="description">Descrizione testuale del decorso del problema o della diagnosi a partire dall'insorgenza.</items><items id="text">Decorso</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">Grado di certezza nell'identificazione della diagnosi.</items><items id="text">Certezza diagnostica</items></items><items code="at0074"><items id="description">La diagnosi è identificata con un basso livello di certezza.</items><items id="text">Sospetto</items></items><items code="at0075"><items id="description">La diagnosi è identificata con un alto livello di certezza.</items><items id="text">Probabile</items></items><items code="at0076"><items id="description">La diagnosi è stata confermata in base a criteri riconosciuti.</items><items id="text">Confermato</items></items><items code="at0077"><items id="comment">I dati acquisiti/importati come 'Età al momento dell'insorgenza' dovrebbero essere convertiti in una data usando la data di nascita del soggetto.</items><items id="description">Data/ora, stimate o effettive, in cui sono stati per la prima volta osservati i sintomi del problema/diagnosi.</items><items id="text">Data/ora di insorgenza</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="ko"><items code="at0000"><items id="comment">실무에서 문제와 진단의 범위 간의 명확한 구분을 하기 쉽지 않음. 이 아키타입을 통한 임상 문서의 목적을 위해서, 증가하는 상세내용의 수준과 일반적으로 '진단'의 표시에 대한 무게감을 제공하는 지지할 수 있는 증거를 가지고, 문제와 진단은 연속된 것(a continuum)으로 간주됨.</items><items id="description">한 개인의 신체, 정신 그리고/또는 사회적 웰빙에 영향을 주는 단일한 확인된 건강 성태, 상해, 장애 또는 다른 이슈에 대한 상세내용.</items><items id="text">문제/진단</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">가능하다면, 용어체계를 통한 문제 또는 진단의 명칭을 코딩하는 것이 좋음.</items><items id="description">명칭으로 문제 또는 진단의 식별.</items><items id="text">문제/진단명</items></items><items code="at0003"><items id="comment">부분 날짜도 허용됨. 진료의 주체가 한 살 이하이면, 완전한 날짜 또는 달과 년의 하한이 정확한 나이 계산을 위해 필요함 - 예를 들어, 의사결정지원을 사용하는 경우. \"임상적으로 인지된 시점의 나이\"로 획득/입력된 데이터는 진료의 주체의 생일을 이용해 날짜로 변환되어야 함.</items><items id="description">진단 또는 문가가 헬스케어 전문가에게 인지된 추정 또는 실제 날짜/시간.</items><items id="text">임상적으로 인지된 날짜/시간</items></items><items code="at0005"><items id="comment">중증도가 선조합코드로 문제/진단 내에 포함된다면, 이 데이터 엘레먼트는 중복이 됨. 주의 : 더 상세한 중증도 등급은 Specific details SLOT을 이용해 기록할 수 있음.</items><items id="description">문제 또는 진단의 전반적인 중증도 평가.</items><items id="text">중증도</items></items><items code="at0009"><items id="comment">문제와 진단에 대한 진화(evolution)와 에피소드 또는 악화, 경과를 포함한 배경과 문액 그리고 다른 관련된 상세내용을 제공하는데 사용함.</items><items id="description">문제 또는 진단에 대한 서술 기록.</items><items id="text">임상적 서술</items></items><items code="at0012"><items id="comment">가능하다면, 용어체계를 통한 해부학적 위치의 명칭을 코딩하는 것이 좋음.&#13;
이 데이터 엘리먼트에 선조합된 해부학적 위치를 사용. 해부학적 위치를 기록하기 위한 요구사항이 애플리케이션 실행 때 결정되거나 또는 상대적인 위치와 같은 더 복잡한 모델링을 요구한다면, 이 아키타입의 'Structured anatomical location' SLOT 내의 CLUSTER.anatomical_location 또는 CLUSTER.relative_location를 이용. 이 데이터 엘리먼트을 위한 Occurrences는 여러 위치에 생긴 발진(rash)을 기술하는 것과 같은 임상 시나리오를 허용하는데 제한이 없지만 모든 다른 속성(attributes)은 동일해야 함. 해부학적 위치가 문제/진단명에 선조합코드로 포함된다면 이 데이터 엘리먼트는 중복이 됨.</items><items id="description">문제 또는 진단의 위치를 위해 간단한 신체 위치 확인</items><items id="text">신체 위치</items></items><items code="at0030"><items id="comment">부분 날짜는 허용됨. 진료의 주체가 한 살 이하면, 완전한 날짜 또는 달과 년의 하한이 정확한 나이 계산을 위해 필요함 - 예를 들어, 의사결정지원을 사용하는 경우. \"임상적으로 인지된 시점의 나이\"로 획득/입력된 데이터는 진료의 주체의 생일을 이용해 날짜로 변환되어야 함.</items><items id="description">헬스케어 전문가에 의해 결정된 이 문제나 진단의 추정 또는 실제 완치 또는 관해 날짜시간.</items><items id="text">완치 날짜/시간</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">해부학적 위치를 기록하기 위한 요구사항이 애플리케이션 실행 때 결정되거나 또는 상대적인 위치와 같은 더 복잡한 모델링을 요구한다면, 이 아키타입의 SLOT에 CLUSTER.anatomical_location 또는 CLUSTER.relative_location를 삽입하여 이용&#13;
&#13;
해부학적 위치가 문제/진단명에 선조합코드로 포함된다면 이 슬롯의 사용은 중복이 됨.</items><items id="description">문제 또는 진단을 위한 구조화된 해부학적 위치</items><items id="text">구조화된 신체 위치</items></items><items code="at0043"><items id="comment">진단의 단계(grading 또는 staging)에 대한 구조화된 상세내용을 포함할 수 있음; 진단 기준, 분류 기준 또는 이상 상황(Adverse Events)을 위한 공통 용어체계 기준(Common Terminology Criteria)와 같은 정규적인 중등도 평가.</items><items id="description">이 문제 또는 진단의 유일한 속성으로 기록하는데 필요한 상세내용.</items><items id="text">특정 상세내용</items></items><items code="at0046"><items id="comment">사용법이 사용하는 곳에서 명확히 정의되지 않으면, 실무에서 다양하게 사용되고 상호운용성을 확신할 수 없는 것과 마찬가지로 진료에서 상태 또는 문맥 한정자를 사용. 예를 들어: 활성 상태(active status) - 활성(active), 비활성(inactive), 치료됨(resolved), 관해 상태(in remission); 진화 상태(evolution status) - 초기(initial), 작업중(interim/working), 완료(final); 시간 상태(temporal status) - 현재(current), 과거(past); 에피소드 상태(episodicity status) - 처음(first), 새로(new), 진행중(ongoing); 입퇴원 상태(admission status) - 입원(admission), 퇴원(discharge); 또는 우선순위 상태(priority status) - 일차(primary), 이차(secondary).</items><items id="description">진단 과정의 위치-, 도메인-, 에피소드- 또는 워크플로우-특징적인 측면에 대한 구조화된 상세내용.</items><items id="text">상태</items></items><items code="at0047"><items id="description">문제나 진단이 정상 활동을 방해하지 않거나 치료하지 않으면 건강에 해를 일으킬 수 있음.</items><items id="text">경도</items></items><items code="at0048"><items id="description">문제나 진단이 정상 활동에 방해가 되거나 치료하지 않으면 건강에 해가 됨.</items><items id="text">중등도</items></items><items code="at0049"><items id="description">문제나 진단이 정상 활동을 할 수 없게 하거나 치료하지 않으면 건강에 심각한 해가 됨.</items><items id="text">증증도</items></items><items code="at0069"><items id="description">다른 필드에서 획득되지 않은 문제 또는 진단에 대한 추가적인 서술내용</items><items id="text">코멘트</items></items><items code="at0070"><items id="description">문제 또는 진단이 최종 업데이트된 날짜.</items><items id="text">최종 업데이트 날짜</items></items><items code="at0071"><items id="comment">예: 로컬 정보 요구사항 또는 FHIR 또는 CIMI의 동등한 것과 조율하기위한 추가적인 메타데이터.</items><items id="description">로컬 컨텐트를 획득하거나 다른 참조모델/표기형식과 조율하기 위해 필요한 추가적인 정보.</items><items id="text">확장</items></items><items code="at0072"><items id="description">발병이후 문제 또는 진단의 결과에 대한 서술.</items><items id="text">경과 서술</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">진단을 확인하는 신뢰의 수준.</items><items id="text">진단적 확실성</items></items><items code="at0074"><items id="description">진단이 낮은 확신 수준으로 식별됨.</items><items id="text">의심</items></items><items code="at0075"><items id="description">진단이 높은 확신 수준으로 식별됨.</items><items id="text">추정</items></items><items code="at0076"><items id="description">진단이 인정된 기준에 대해 확진됨.</items><items id="text">확진</items></items><items code="at0077"><items id="comment">\"발병 나이\"로 획득/입력된 데이터는 진료의 주체의 생일을 이용해 날짜로 변환되어 함.</items><items id="description">문제/진단의 증상 또는 징후가 처음 관찰된 추정 또는 실제 날짜/시간.</items><items id="text">발병 날짜/시간</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="comment">Det er i praksis ikke lett å oppnå et klart skille mellom et problem og en diagnose. I klinisk dokumentasjon med denne arketypen ses problem og diagnose som et kontinuum, med økende krav til detaljer og støttende evidens for å underbygge en diagnose.</items><items id="description">Detaljer om én identifisert helsetilstand, skade, funksjonshemming eller annet forhold som påvirker et individs fysiske, mentale og/eller sosiale velvære.</items><items id="text">Problem/diagnose</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Koding av navnet på problemet eller diagnosen med en terminologi er foretrukket hvis mulig.</items><items id="description">Identifisering av problemet eller diagnosen ved hjelp av navn.</items><items id="text">Problem/diagnosenavn</items></items><items code="at0003"><items id="comment">Delvise datoer er tillatt. Dersom individet er under ett år gammel, må komplett dato eller som et minimum måned og år oppgis for å muliggjøre presise beregninger av alder, f.eks. ved bruk i beslutningsstøttesystemer. Data registrert eller importert som "alder ved tidspunkt når diagnosen stilles" bør konverteres til en dato ved hjelp av individets fødselsdato.</items><items id="description">Anslått eller faktisk dato/tid da diagnosen eller problemet ble bekreftet av helsepersonell.</items><items id="text">Dato/tid for klinisk bekreftelse</items></items><items code="at0005"><items id="comment">Dersom alvorlighetsgrad inkluderes i feltet "Problem/diagnosenavn" via prekoordinerte koder blir dette dataelementet overflødig. Merk: Mer spesifikk gradering av alvorlighetsgrad kan registreres ved å bruke SLOTet "Spesifikke detaljer"</items><items id="description">En vurdering av problemet eller diagnosens overordnede alvorlighetsgrad.</items><items id="text">Alvorlighetsgrad</items></items><items code="at0009"><items id="comment">Brukes til å gi bakgrunn og kontekst, inkludert utvikling, episoder eller forverringer, fremgang og alle andre relevante detaljer, om problemet eller diagnosen.</items><items id="description">Fritekstbeskrivelse av problemet eller diagnosen.</items><items id="text">Klinisk beskrivelse</items></items><items code="at0012"><items id="comment">Koding av navnet på den anatomiske lokaliseringen ved hjelp av en terminologi er foretrukket når dette er mulig. &#13;
Bruk dette dataelementet for å registrere prekoordinerte anatomiske lokaliseringer. Dersom behovene for å registrere anatomisk sted bestemmes i applikasjonen eller trenger større grad av kompleksitet som f.eks. relativ lokalisering, er det anbefalt å bruke CLUSTER.anatomical_location eller CLUSTER.relative_location innenfor SLOTet "Strukturert anatomisk lokalisering" i denne arketypen. Dette dataelementet kan ha ubegrenset antall forekomster, for å gjøre det mulig å registrere kliniske scenarier som f.eks. å beskrive et utslett som opptrer flere steder på kroppen, men der alle andre attributter er identiske. Dersom den anatomiske lokaliseringen inkluderes i feltet "Problem/diagnosenavn" via prekoordinerte koder blir dette dataelementet overflødig.</items><items id="description">Registrering av et enkelt og usammensatt anatomisk sted der problemet eller diagnosen er lokalisert.</items><items id="text">Anatomisk lokalisering</items></items><items code="at0030"><items id="comment">Delvise datoer er tillatt. Dersom individet er under ett år gammel, må komplett dato eller som et minimum måned og år oppgis for å muliggjøre presise beregninger av alder, f.eks. ved bruk i beslutningsstøttesystemer.&#13;
Data registrert eller importert som "alder ved bedring" bør konverteres til en dato ved hjelp av individets fødselsdato.</items><items id="description">Estimert eller faktisk dato/tid for bedring eller remisjon av det aktuelle problemet eller diagnosen, fastslått av helsepersonell.</items><items id="text">Dato/tid for bedring/remisjon</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Dersom behovene for å registrere anatomisk sted bestemmes i applikasjonen eller trenger større grad av kompleksitet som f.eks. relativ lokalisering, er det anbefalt å bruke CLUSTER.anatomical_location eller CLUSTER.relative_location i dette SLOTet. &#13;
&#13;
Dersom den anatomiske lokaliseringen inkluderes i feltet "Problem/diagnosenavn" via prekoordinerte koder blir dette dataelementet overflødig.</items><items id="description">SLOT som kan inneholde en eller flere detaljerte og strukturerte anatomiske lokaliseringer.</items><items id="text">Strukturert anatomisk lokalisering</items></items><items code="at0043"><items id="comment">Kan omfatte strukturerte detaljer om klassifisering eller stadier av diagnosen; diagnosiske kriterier, klassifikasjon eller formelle vurderinger av alvorlighetsgrad, som f.eks. Common Terminology Criteria for Adverse Events.</items><items id="description">Detaljer som er nødvendige for å registrere det aktuelle problemet eller diagnosens unike egenskaper.</items><items id="text">Spesifikke detaljer</items></items><items code="at0046"><items id="comment">Bruk status eller kontekstkvalifikatorer med omhu, da bruken varierer og interoperabilitet kan ikke garanteres med mindre bruken er klart definert innen miljøet som bruker dem. F.eks. aktiv status - aktiv, inaktiv, løst, i bedring; utviklingsstatus - første, midlertidig, endelig; tidsstatus - nåværende, tidligere; episodisk status - første, ny, pågående; innleggelsesstatus - innleggelse, utskriving; eller prioritetsstatus - primær, sekundær.</items><items id="description">Strukturerte detaljer for lokalisering-, fagområde-, episode- eller arbeidsflytsspesifikke aspekter av den diagnostiske prosessen.</items><items id="text">Status</items></items><items code="at0047"><items id="description">Problemet eller diagnosen forstyrrer ikke normal aktivitet.</items><items id="text">Mild</items></items><items code="at0048"><items id="description">Problemet eller diagnosen forstyrrer normal aktivitet.</items><items id="text">Moderat</items></items><items code="at0049"><items id="description">Problemet eller diagnosen forhindrer normal aktivitet.</items><items id="text">Alvorlig</items></items><items code="at0069"><items id="description">Utdypende fritekst om problemet eller diagnosen, som ikke passer i andre felt.</items><items id="text">Kommentar</items></items><items code="at0070"><items id="description">Datoen da problemet eller diagnosen sist ble oppdatert.</items><items id="text">Sist oppdatert</items></items><items code="at0071"><items id="comment">For eksempel lokale informasjonsbehov, eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at0072"><items id="description">Fritekstbeskrivelse av forløpet av problemet eller diagnosen siden debut.</items><items id="text">Forløpsbeskrivelse</items></items><items code="at0073"><items id="comment">Hvis et alternativt verdisett er nødvendig, kan disse verdiene legges til DV_TEXT-datatypen i et templat.</items><items id="description">Grad av sikkerhet i identifikasjonen av diagnosen.</items><items id="text">Diagnostisk sikkerhet</items></items><items code="at0074"><items id="description">Diagnoses er identifisert med en lav grad av sikkerhet.</items><items id="text">Mistenkt</items></items><items code="at0075"><items id="description">Diagnosen er identifisert med en stor grad av sikkerhet.</items><items id="text">Sannsynlig</items></items><items code="at0076"><items id="description">Diagnosen er bekreftet opp mot anerkjente kriterier.</items><items id="text">Bekreftet</items></items><items code="at0077"><items id="comment">Data registrert eller importert som "alder ved debut" bør konverteres til en dato ved hjelp av individets fødselsdato.</items><items id="description">Antatt eller faktisk dato/tid da tegn eller symptomer på problemet eller diagnosen først ble observert.</items><items id="text">Dato/ tid for debut</items></items><items code="at0078"><items id="comment">Også kjent som 'etiologi'. Det anbefales å kode "Årsak" med en ekstern terminologi dersom det er mulig.</items><items id="description">En årsak, kjede av årsaker til, eller hendelsesforløp forut for problemet eller diagnosen.</items><items id="text">Årsak</items></items><items code="at0079"><items id="comment">For eksempel "akutt motorisk aksonal nevropati" som en variant av Guillain-Barre Syndrom. Koding av navnet på varianten med en terminologi er foretrukket hvis mulig.</items><items id="description">Spesifikk variant eller subtype av diagnose, hvis det er relevant.</items><items id="text">Variant</items></items><items code="at0080"><items id="comment">Den samme diagnosen, med samme alvorlighetsgrad, kan ha ulik innvirkning på ulike pasienter. Denne relevanskvalifikatoren innebærer å justere den totale påvirkningen av helseproblemet basert på pasientens individuelle medisinske og funksjonelle forutsetninger. For eksempel: To pasienter har samme diagnose – en førstegradsforbrenning. Den ene er frisk, den andre har diabetes. Innvirkningen for en diabetiker er høyere (større risiko for infeksjon, lengre tilhelingstid osv.). Dette elementet er ment å åpne for registrering av flere typer påvirkning, for eksempel innen klinisk behandling, funksjonsevne i hjemmet eller arbeidsliv.</items><items id="description">Overordnet vurdering av innvirkningen et helseproblem har for individet.</items><items id="text">Innvirkning</items></items></term_definitions><term_definitions language="nl"><items code="at0000"><items id="comment">*Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.(en)</items><items id="description">Informatie over een enkele vast te stellen medische aandoening, een letsel, beperking of andere zaak die invloed heeft op de fysieke, mentale en/of het sociale welbevinden van een individu.</items><items id="text">Probleem/Diagnose</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*structure(en)</items></items><items code="at0002"><items id="comment">*Coding of the name of the problem or diagnosis with a terminology is preferred, where possible.(en)</items><items id="description">Identificatie van het probleem of de diagnose bij naam.&#13;
                            </items><items id="text">Naam van het probleem / de diagnose</items></items><items code="at0003"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of clinical recognition" should be converted to a date using the subject's date of birth.(en)</items><items id="description">Geschatte of werkelijke datum/tijd waarop het probleem of de diagnose is herkend door een zorgprofessional.</items><items id="text">Datum/tijd van klinische herkenning</items></items><items code="at0005"><items id="comment">*If severity is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant. Note: more specific grading of severity can be recorded using the Specific details SLOT.(en)</items><items id="description">*An assessment of the overall severity of the problem or diagnosis.(en)</items><items id="text">*Severity(en)</items></items><items code="at0009"><items id="comment">*Use to provide background and context, including evolution, episodes or exacerbations, progress and any other relevant details, about the problem or diagnosis.(en)</items><items id="description">Verhalende beschrijving van het probleem of de diagnose.</items><items id="text">Klinische beschrijving</items></items><items code="at0012"><items id="comment">*Coding of the name of the anatomical location with a terminology is preferred, where possible.&#13;
Use this data element to record precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Structured anatomical location' SLOT in this archetype. Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a rash in multiple locations but where all of the other attributes are identical. If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">Identificatie van een eenvoudig lichaamsdeel voor de lokatie van het probleem of de diagnose.</items><items id="text">Lichaamsdeel</items></items><items code="at0030"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of resolution" should be converted to a date using the subject's date of birth.(en)</items><items id="description">*Estimated or actual date/time of resolution or remission for this problem or diagnosis, as determined by a healthcare professional.(en)</items><items id="text">*Date/time of resolution(en)</items></items><items code="at0032"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0039"><items id="comment">*Use this SLOT to insert the CLUSTER.anatomical_location or CLUSTER.relative_location archetypes if the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations.&#13;
&#13;
If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, use of this SLOT becomes redundant.(en)</items><items id="description">*A structured anatomical location for the problem or diagnosis.(en)</items><items id="text">*Structured body site(en)</items></items><items code="at0043"><items id="comment">*May include structured detail about the grading or staging of the diagnosis; diagnostic criteria, classification criteria or formal severity assessments such as Common Terminology Criteria for Adverse Events.(en)</items><items id="description">*Details that are additionally required to record as unique attributes of this problem or diagnosis.(en)</items><items id="text">*Specific details(en)</items></items><items code="at0046"><items id="comment">*Use status or context qualifiers with care, as they are variably used in practice and interoperability cannot be assured unless usage is clearly defined with the community of use. For example: active status - active, inactive, resolved, in remission; evolution status - initial, interim/working, final; temporal status - current, past; episodicity status - first, new, ongoing; admission status - admission, discharge; or priority status - primary, secondary.(en)</items><items id="description">*Structured details for location-, domain-, episode- or workflow-specific aspects of the diagnostic process.(en)</items><items id="text">*Status(en)</items></items><items code="at0047"><items id="description">*The problem or diagnosis does not interfere with normal activity or may cause damage to health if left untreated.(en)</items><items id="text">*Mild(en)</items></items><items code="at0048"><items id="description">*The problem or diagnosis causes interference with normal activity or will damage health if left untreated.(en)</items><items id="text">*Moderate(en)</items></items><items code="at0049"><items id="description">*The problem or diagnosis prevents normal activity or will seriously damage health if left untreated.(en)</items><items id="text">*Severe(en)</items></items><items code="at0069"><items id="description">*Additional narrative about the problem or diagnosis not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0070"><items id="description">*The date this problem or diagnosis was last updated.(en)</items><items id="text">*Last updated(en)</items></items><items code="at0071"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0072"><items id="description">*Narrative description about the course of the problem or diagnosis since onset.(en)</items><items id="text">*Course description(en)</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">*The level of confidence in the identification of the diagnosis.(en)</items><items id="text">*Diagnostic certainty(en)</items></items><items code="at0074"><items id="description">*The diagnosis has been identified with a low level of certainty.(en)</items><items id="text">*Suspected(en)</items></items><items code="at0075"><items id="description">*The diagnosis has been identified with a high level of certainty.(en)</items><items id="text">*Probable(en)</items></items><items code="at0076"><items id="description">*The diagnosis has been confirmed against recognised criteria.(en)</items><items id="text">*Confirmed(en)</items></items><items code="at0077"><items id="comment">*Data captured/imported as "Age at onset" should be converted to a date using the subject's date of birth.(en)</items><items id="description">Geschatte of precieze datum/tijd dat de eerste tekenen of symptomen van het probleem of de diagnose werden opgemerkt.</items><items id="text">Datum/tijd van aanvang</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="comment">Delimitação clara entre o âmbito de um problema em comparação a um diagnóstico, não é fácil de se conseguir na prática. Para fins de documentação clínica com este arquétipo, problema e diagnóstico são considerados como uma continuidade, com níveis crescentes de detalhes e evidência de apoio, geralmente fornecendo peso para o rótulo de "diagnóstico".</items><items id="description">Detalhes sobre uma única condição de saúde identificada, lesões, deficiência ou qualquer outra questão que tenha impacto sobre o bem-estar físico, mental e / ou social de um indivíduo.</items><items id="text">Problema /Diagnóstico</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Quando possível, é preferível usar a codificação do nome do problema ou diagnóstico com uma terminologia.</items><items id="description">Identificação do problema ou diagnóstico, por nome.</items><items id="text">Nome do Problema / Diagnóstico</items></items><items code="at0003"><items id="comment">Datas parciais são aceitáveis. &#13;
Se o tema do cuidado está com idade inferior a um ano, então a data completa ou no mínimo o mês e o ano são necessários para permitir cálculos de idade precisos, por exemplo, se usado para conduzir apoio à decisão. Os dados capturados / importados como "Idade no momento do reconhecimento clínico" deve ser convertida para uma data usando o sujeito data de nascimento.</items><items id="description">Data / hora, estimada ou real, que o diagnóstico ou o problema foi reconhecido por um profissional de saúde.</items><items id="text">Data / hora da reconhecimento clínico</items></items><items code="at0005"><items id="comment">Se a severidade está incluída no nome do Problema / diagnóstico através de códigos pré-coordenados, este elemento de dados torna-se redundante. &#13;
Nota: a classificação mais específica da gravidade pode ser gravada utilizando os detalhes específicos SLOT.</items><items id="description">Uma avaliação global da severidade do problema ou diagnóstico.</items><items id="text">Severidade</items></items><items code="at0009"><items id="comment">Usar para fornecer conhecimento e contexto, incluindo evolução, episódios ou exacerbações, progresso e quaisquer outros detalhes relevantes, sobre o problema ou diagnóstico.</items><items id="description">Descrição narrativa sobre o problema ou diagnóstico.</items><items id="text">Descrição clínica</items></items><items code="at0012"><items id="comment">A codificação do nome da localização anatômica com uma terminologia é preferível, quando possível.&#13;
Utilize este elemento de dados para gravar localizações anatômicas precoordenadas. Se os requisitos para gravar a localização anatômica são determinados em tempo real através da aplicação ou requerem uma modelagem mais complexa, como localizações relativas, em seguida, use o CLUSTER.anatomical_location ou CLUSTER.relative_location dentro do SLOT 'localização anatômica estruturada' neste arquétipo. Ocorrências para este elemento de dados são ilimitadas para permitir cenários clínicos tais como a descrição de uma erupção cutânea em vários locais, mas em que todos os outros atributos são idênticos. Se a localização anatômica é incluída ao nome do Problema / diagnóstico, através de códigos pré-coordenados, este elemento de dados torna-se redundante.</items><items id="description">Simples identificação de um local do corpo para a localização do problema ou diagnóstico.</items><items id="text">Local do corpo</items></items><items code="at0030"><items id="comment">Datas parciais são aceitáveis. &#13;
Se o tema do cuidado está com idade inferior a um ano, então a data completa ou no mínimo o mês e o ano são necessários para permitir cálculos de idade precisos, por exemplo, se usado para conduzir apoio à decisão. Os dados capturados / importados como "Idade na ocasião da resolução" deve ser convertida para uma data usando o sujeito data de nascimento.</items><items id="description">Data / tempo, estimado ou atual, de resolução ou de dispensa desse problema ou diagnóstico, como determinado por um profissional de saúde.</items><items id="text">Data /tempo de resolução</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree(en)</items></items><items code="at0039"><items id="comment">Use esse SLOT para inserir os arquétipos CLUSTER.anatomical_location ou CLUSTER.relative_location se os requisitos para gravar a localização anatômica são determinados em tempo real através da aplicação ou requer uma modelagem mais complexa, como localizações relativas.&#13;
&#13;
Se a localização anatômica está incluída ao nome Problema / diagnóstico, através de códigos pré-coordenados, o uso deste SLOT torna-se redundante.</items><items id="description">A localização anatômica estruturada para o problema ou diagnóstico.</items><items id="text">Local estruturado do corpo</items></items><items code="at0043"><items id="comment">Pode incluir detalhes estruturados sobre a classificação ou a realização do diagnóstico; critérios de diagnóstico, critérios de classificação ou avaliação formal da severidade, como os critérios de terminologia comum para eventos adversos.</items><items id="description">Detalhes que são adicionalmente necessários para gravar atributos como únicos deste problema ou diagnóstico.</items><items id="text">Detalhes específicos</items></items><items code="at0046"><items id="comment">Use o estado ou os qualificadores contexto com cuidado, pois eles são variáveis quando usados na prática e a interoperabilidade não pode ser assegurada, salvo se o uso está claramente definido com a comunidade de uso. &#13;
Por exemplo: evolução do estado: inicial, inativo, resolvido, em remissão; estado de evolução: inicial, provisório / trabalhando, final; estado temporal: presente, passado; estado do episodio: primeiro, novo, em curso; estado de admissão: admissão, alta; ou estado de prioridade: primário, secundário.</items><items id="description">Detalhes estruturados para localização, domínio, episódio ou aspectos específicos do fluxo de trabalho do processo de diagnóstico.</items><items id="text">Estado</items></items><items code="at0047"><items id="description">O problema ou o diagnóstico não interfere na atividade normal ou causa danos à saúde, se não for tratado.</items><items id="text">Suave</items></items><items code="at0048"><items id="description">O problema ou o diagnóstico interfere na atividade normal ou prejudicará a saúde, se não for tratado.</items><items id="text">Moderado</items></items><items code="at0049"><items id="description">O problema ou diagnóstico impede a atividade normal ou causará sérios danos à saúde se não tratado.</items><items id="text">Severo</items></items><items code="at0069"><items id="description">Narrativa adicional sobre o problema ou diagnóstico, não capturados em outros campos.</items><items id="text">Comentário</items></items><items code="at0070"><items id="description">A data este problema ou diagnóstico foi atualizado pela última vez.</items><items id="text">Ultima atualização</items></items><items code="at0071"><items id="comment">Por exemplo: requisitos de informação locais ou metadados adicionais para alinhar com FHIR ou CIMI equivalentes.</items><items id="description">Informações adicionais necessárias para capturar o conteúdo local ou para alinhar com outros modelos de referência / formalismos.</items><items id="text">Extensão</items></items><items code="at0072"><items id="description">Descrição narrativa sobre o curso do problema ou diagnóstico, desde o início.</items><items id="text">Descrição do curso</items></items><items code="at0073"><items id="comment">*If an alternative valueset is required, these values can be added to the DV_TEXT data type in a template.(en)</items><items id="description">O nível de confiança da identificação do diagnóstico.</items><items id="text">Certeza do diagnóstico</items></items><items code="at0074"><items id="description">O diagnóstico foi identificado com um nível baixo de convicção.</items><items id="text">Suspeito</items></items><items code="at0075"><items id="description">O diagnóstico foi identificado com um elevado grau de certeza.</items><items id="text">Provável</items></items><items code="at0076"><items id="description">O diagnóstico foi confirmado com base em critérios reconhecidos.</items><items id="text">confirmado</items></items><items code="at0077"><items id="comment">Os dados capturados / importados como "A idade de início" devem ser convertidos para uma data, usando o sujeito data de nascimento.</items><items id="description">Data / tempo, estimada ou real, que os sinais ou sintomas do problema / diagnóstico foram observados pela primeira vez.</items><items id="text">Data / tempo de início</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="comment">Gränsen mellan problem och diagnos är flytande. En ökad detaljnivå och mer stödjande evidens väger normalt över mot att tillståndet benämns diagnos.</items><items id="description">Detaljer om enskilt identifierat hälsotillstånd, skada, funktionshinder eller något annat problem som påverkar individens fysiska, psykiska och eller sociala välbefinnande.</items><items id="text">Problem/Diagnos</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">Om möjligt, koda problemet eller diagnosen med en terminologi.</items><items id="description">Problemets eller diagnosens benämning.</items><items id="text">Benämning på problem/diagnos</items></items><items code="at0003"><items id="comment">Partiellt datum är acceptabelt. Om patienten är under ett år, är ett fullständigt datum eller minimum månad och år nödvändigt för korrekta åldersberäkningar, exempelvis om de används för beslutsstöd. Dokumenterad eller importerad "bekräftad debutålder" bör beräknas till ett datum för debut baserat på födelsedatum.</items><items id="description">Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först bekräftades av sjukvårdspersonal.</items><items id="text">Datum och tid för klinisk bekräftelse</items></items><items code="at0005"><items id="comment">Det här fältet är överflödigt om allvarlighetsgraden är inkluderad i benämningen av problemet eller diagnosen med prekoordinerade koder. En mer specifik allvarlighetsgrad kan dokumenteras i SLOT ”Specifika detaljer”.</items><items id="description">En bedömning av problemets eller diagnosens totala allvarlighetsgrad.</items><items id="text">Allvarlighetsgrad</items></items><items code="at0009"><items id="comment">Används för att ge en bakgrund och sammanhang, inklusive utveckling, skov, framsteg och andra relevanta detaljer om problemet eller diagnosen.</items><items id="description">Beskrivning av problemet eller diagnosen.</items><items id="text">Klinisk beskrivning</items></items><items code="at0012"><items id="comment">Om möjligt, koda kroppslokalisationen med en terminologi. Använd det här fältet för att dokumentera prekoordinerade kroppslokalisationer. &#13;
&#13;
Om kraven på dokumentation av den anatomiska lokalisationen bestäms automatiskt av vissa IT-system eller kräver mer komplex modellering, till exempel relativa platser (exempelvis 3 cm ovanför vänster knä), använd CLUSTER.anatomical_location eller CLUSTER.relative_location i SLOT för "Strukturerad kroppslokalisation" i denna arketyp. Förekomster av detta datafält är obegränsat för att möjliggöra kliniska scenarier som att beskriva utslag på flera platser, men där alla andra egenskaper är identiska. Om den anatomiska lokalisationen ingår i "Benämning på problem/diagnos" genom prekoordinerade koder blir detta datafält överflödigt.</items><items id="description">Identifiering av problemets eller diagnosens anatomiska lokalisation.</items><items id="text">Kroppslokalisation</items></items><items code="at0030"><items id="comment">Partiellt datum är acceptabelt. Om patienten är under ett år, är ett fullständigt datum eller minimum månad och år nödvändigt för korrekta åldersberäkningar, exempelvis om de används för beslutsstöd. Dokumenterat eller importerat "bekräftat tillfrisknande" bör beräknas till ett datum för tillfrisknande baserat på födelsedatum.</items><items id="description">Av sjukvårdspersonal uppskattat eller faktiskt datum och tid för tillfrisknande eller remission.</items><items id="text">Datum och tid för tillfrisknande</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">Använd denna SLOT för att infoga CLUSTER.anatomical_location- eller CLUSTER.relative_location-arketyper om kroppslokalisationen bestäms automatiskt av vissa IT-system eller kräver mer komplicerad modellering, som exempelvis relativa platser. Det här datafältet är överflödigt om kroppslokalisationen är inkluderad i benämningen av problemet eller diagnosen med prekoordinerade koder.</items><items id="description">En strukturerad anatomisk lokalisation för problemet eller diagnosen.</items><items id="text">Strukturerad kroppslokalisation</items></items><items code="at0043"><items id="comment">Datafältet kan innehålla strukturerade detaljer om klassificering eller stadieindelning av diagnosen, som diagnostiska kriterier, klassificeringskriterier eller formella bedömningar av allvarlighetsgraden, såsom Common Terminology Criteria for Adverse Events.</items><items id="description">Ytterligare detaljer som krävs för att dokumentera de egenskaper som är unika för problemet eller diagnosen.</items><items id="text">Specifika detaljer</items></items><items code="at0046"><items id="comment">Använd datafältet med försiktighet, eftersom användningen varierar i praktiken och interoperabilitet endast kan säkerställas om användningen är tydligt definierad. &#13;
Exempelvis status på:&#13;
- Aktivitet, såsom aktiv, inaktiv, tillfrisknad, i remission&#13;
- Förlopp, såsom initial, interimistisk, preliminär, slutlig&#13;
- Tid, såsom nuvarande, tidigare&#13;
- Episod, såsom första, nytt, pågående&#13;
- Vårdtillfälle, såsom inskrivning, utskrivning&#13;
- Klassificering, såsom primär, sekundär</items><items id="description">Strukturerade specifika detaljer om den diagnostiska processen såsom plats, område, episod eller arbetsflöde.</items><items id="text">Status</items></items><items code="at0047"><items id="description">Problemet eller diagnosen påverkar inte normal aktivitet och kan inte orsaka skador på hälsan utan behandling.</items><items id="text">Lindrig</items></items><items code="at0048"><items id="description">Problemet eller diagnosen stör normal aktivitet och kan skada hälsan utan behandling.</items><items id="text">Måttlig</items></items><items code="at0049"><items id="description">Problemet eller diagnosen förhindrar normal aktivitet och kan allvarligt skada hälsan utan behandling.</items><items id="text">Svår</items></items><items code="at0069"><items id="description">Ytterligare beskrivning av problemet eller diagnosen som inte dokumenterats i andra fält.</items><items id="text">Kommentar</items></items><items code="at0070"><items id="description">Datum då dokumentation om problemet eller diagnosen senast uppdaterades.</items><items id="text">Senast uppdaterad</items></items><items code="at0071"><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items><items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="text">Tilläggsinformation</items></items><items code="at0072"><items id="description">Beskrivning av problemets eller diagnosens förlopp sedan debuten.</items><items id="text">Förlopp</items></items><items code="at0073"><items id="comment">Använd datatypen DV_TEXT i en template om en alternativ graderingsskala krävs.&#13;
&#13;
</items><items id="description">Graden av säkerhet vid fastställande av diagnosen.</items><items id="text">Diagnostisk säkerhet</items></items><items code="at0074"><items id="description">Diagnosen har bekräftats med en låg grad av säkerhet.</items><items id="text">Misstänkt</items></items><items code="at0075"><items id="description">Diagnosen har bekräftats med en hög grad av säkerhet.</items><items id="text">Sannolik</items></items><items code="at0076"><items id="description">Diagnosen har bekräftats utifrån kända kriterier.</items><items id="text">Bekräftad</items></items><items code="at0077"><items id="comment">Dokumenterad eller importerad "debutålder" bör beräknas till ett datum för debut baserat på födelsedatum.</items><items id="description">Uppskattat eller reellt datum och tid när problemets eller diagnosens tecken eller symtom först observerades.</items><items id="text">Datum och tid för debut</items></items><items code="at0078"><items id="comment">Även känt som "etiologi". Om möjligt, koda med en terminologi.</items><items id="description">En eller flera orsaker till problemet eller diagnosen, eller dess uppkomstsätt.</items><items id="text">Orsak</items></items><items code="at0079"><items id="comment">Exempelvis "akut motorisk axonal neuropati" som en specificering av Guillain-Barre-syndromet. Om möjligt, koda specificeringen med en terminologi.</items><items id="description">Specificering av diagnosen, där det är relevant.</items><items id="text">Specificering</items></items><items code="at0080"><items id="comment">Samma diagnos, med samma allvarlighetsgrad, kan ha olika påverkan på olika patienter. Den samlade påverkan av hälsoproblemet justeras i detta datafält utifrån patientens individuella förutsättningar.&#13;
&#13;
Exempel: Två patienter har diagnosen ytlig brännskada. Den ena är frisk, medan den andra har diabetes. För en patient med diabetes är påverkan av problemet större, eftersom risken för infektion är högre och läkningstiden längre.&#13;
&#13;
Detta datafält är avsett att fånga flera typer av påverkan, inklusive men inte begränsat till klinisk behandling, funktion i hemmet och vardagen, arbetsliv och yrkesutövning.</items><items id="description">Övergripande bedömning av hur ett hälsoproblem påverkar patienten.</items><items id="text">Påverkan</items></items></term_definitions><term_definitions language="zh"><items code="at0000"><items id="comment">*Clear delineation between the scope of a problem versus a diagnosis is not easy to achieve in practice. For the purposes of clinical documentation with this archetype, problem and diagnosis are regarded as a continuum, with increasing levels of detail and supportive evidence usually providing weight towards the label of 'diagnosis'.(en)</items><items id="description">*Details about a single identified health condition, injury, disability or any other issue which impacts  the physical, mental and/or social wellbeing of an individual.(en)</items><items id="text">问题/诊断</items></items><items code="at0001"><items id="description">@ internal @ (en)</items><items id="text">structure (en)</items></items><items code="at0002"><items id="comment">*Coding of the name of the problem or diagnosis with a terminology is preferred, where possible.(en)</items><items id="description">*Identification of the problem or diagnosis, by name.(en)</items><items id="text">问题/诊断名字</items></items><items code="at0003"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of clinical recognition" should be converted to a date using the subject's date of birth.(en)</items><items id="description">*Estimated or actual date/time the diagnosis or problem was recognised by a healthcare professional.(en)</items><items id="text">临床认可的日期/时间</items></items><items code="at0005"><items id="comment">*If severity is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant. Note: more specific grading of severity can be recorded using the Specific details SLOT.(en)</items><items id="description">*An assessment of the overall severity of the problem or diagnosis.(en)</items><items id="text">严重性</items></items><items code="at0009"><items id="comment">*Use to provide background and context, including evolution, episodes or exacerbations, progress and any other relevant details, about the problem or diagnosis.(en)</items><items id="description">*Narrative description about the problem or diagnosis.(en)</items><items id="text">临床描述</items></items><items code="at0012"><items id="comment">*Coding of the name of the anatomical location with a terminology is preferred, where possible.&#13;
Use this data element to record precoordinated anatomical locations. If the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the 'Structured anatomical location' SLOT in this archetype. Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a rash in multiple locations but where all of the other attributes are identical. If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, this data element becomes redundant.(en)</items><items id="description">*Identification of a simple body site for the location of the problem or diagnosis.(en)</items><items id="text">身体位置</items></items><items code="at0030"><items id="comment">*Partial dates are acceptable. If the subject of care is under the age of one year, then the complete date or a minimum of the month and year is necessary to enable accurate age calculations - for example, if used to drive decision support. Data captured/imported as "Age at time of resolution" should be converted to a date using the subject's date of birth.(en)</items><items id="description">*Estimated or actual date/time of resolution or remission for this problem or diagnosis, as determined by a healthcare professional.(en)</items><items id="text">解决的日期/时间</items></items><items code="at0032"><items id="description">@ internal @ (en)</items><items id="text">Tree (en)</items></items><items code="at0039"><items id="comment">*Use this SLOT to insert the CLUSTER.anatomical_location or CLUSTER.relative_location archetypes if the requirements for recording the anatomical location are determined at run-time by the application or require more complex modelling such as relative locations.&#13;
&#13;
If the anatomical location is included in the Problem/diagnosis name via precoordinated codes, use of this SLOT becomes redundant.(en)</items><items id="description">*A structured anatomical location for the problem or diagnosis.(en)</items><items id="text">结构化身体位置</items></items><items code="at0043"><items id="comment">*May include structured detail about the grading or staging of the diagnosis; diagnostic criteria, classification criteria or formal severity assessments such as Common Terminology Criteria for Adverse Events.(en)</items><items id="description">*Details that are additionally required to record as unique attributes of this problem or diagnosis.(en)</items><items id="text">详情</items></items><items code="at0046"><items id="comment">谨慎使用状态或上下文状态符，除非社区明确规定了用法，否则会由于在实际应用中的用法差异而无法保证互操作性。比如：活跃状态-活跃、不活跃、已痊愈、病情缓解；演变状态-初期、临时/演变中、终期；时间状态-当前、过去；发作状态-首次、新发、进行中；入院状态-入院、出院；优先级状态-第一、第二</items><items id="description">描述与位置，域，发作或者工作流程等诊断过程中特定方面相关的结构化细节。</items><items id="text">状态</items></items><items code="at0047"><items id="description">*The problem or diagnosis does not interfere with normal activity or may cause damage to health if left untreated.(en)</items><items id="text">Mild (en)</items></items><items code="at0048"><items id="description">*The problem or diagnosis causes interference with normal activity or will damage health if left untreated.(en)</items><items id="text">Moderate (en)</items></items><items code="at0049"><items id="description">*The problem or diagnosis prevents normal activity or will seriously damage health if left untreated.(en)</items><items id="text">Severe (en)</items></items><items code="at0069"><items id="description">*Additional narrative about the problem or diagnosis not captured in other fields.(en)</items><items id="text">备注</items></items><items code="at0070"><items id="description">*The date this problem or diagnosis was last updated.(en)</items><items id="text">最近更新</items></items><items code="at0071"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">其他</items></items><items code="at0072"><items id="description">*Narrative description about the course of the problem or diagnosis since onset.(en)</items><items id="text">过程描述</items></items><items code="at0073"><items id="description">*The level of confidence in the identification of the diagnosis.(en)</items><items id="text">诊断确定性</items></items><items code="at0074"><items id="description">*The diagnosis has been identified with a low level of certainty.(en)</items><items id="text">*Suspected (en)</items></items><items code="at0075"><items id="description">*The diagnosis has been identified with a high level of certainty.(en)</items><items id="text">*Probable (en)</items></items><items code="at0076"><items id="description">*The diagnosis has been confirmed against recognised criteria.(en)</items><items id="text">*Confirmed (en)</items></items><items code="at0077"><items id="comment">*Data captured/imported as "Age at onset" should be converted to a date using the subject's date of birth.(en)</items><items id="description">*Estimated or actual date/time that signs or symptoms of the problem/diagnosis were first observed.(en)</items><items id="text">开始日期/时间</items></items><items code="at0078"><items id="comment">*Also known as 'aetiology' or 'etiology'. Coding with an external terminology is preferred, where possible.(en)</items><items id="description">*A cause, set of causes, or manner of causation of the problem or diagnosis.(en)</items><items id="text">*Cause (en)</items></items><items code="at0079"><items id="comment">*For example: 'acute motor axonal neuropathy' as a variant of Guillain-Barre Syndrome. Coding of the name of the variant with a terminology is preferred, where possible.  (en)</items><items id="description">*Specific variant or subtype of the Diagnosis, if relevant. (en)</items><items id="text">*Variant (en)</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions><term_definitions language="zh-cn"><items code="at0000"><items id="comment">在实践当中，问题与诊断范围的明确区分/划定并非易事。对于利用本原始型的临床文档记录目的来说，在此会将问题与诊断视为统一的连续体系，且由问题到诊断，不断增加的细节水平和支持性证据通常会为“诊断”标签带来更大的权重。</items><items id="description">关于单个已明确的健康状况、损伤、残疾或任何其他影响个人身体健康、心理健康和/或社会福祉的问题/事项的详情。</items><items id="text">问题/诊断</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">structure</items></items><items code="at0002"><items id="comment">尽可能首选采用术语标准对问题或诊断的名称进行编码。</items><items id="description">利用名称对问题或诊断的标识。</items><items id="text">问题/诊断名称</items></items><items code="at0003"><items id="comment">可以接受部分型/不完整的日期。如果服务对象未满一周岁，则需要完整的日期或者至少是月份和年份才能准确地计算出年龄 - 比如，在将其用于驱动决策支持之时。应当利用服务/记录对象（患者）的出生日期，将作为临床认定[之时的]年龄（Age at time of clinical recognition）而采集/导入的数据转换成具体的日期。</items><items id="description">医疗保健专业人员认定当前诊断或问题的估计或实际日期/时间。</items><items id="text">临床认定日期/时间</items></items><items code="at0005"><items id="comment">如果是在问题/诊断名称当中利用了先组[配]式代码（ precoordinated code）来记录严重程度，则本数据元就会变得多余。注意：可以利用特有详情槽位 "Specific details" 来记录更为具体的严重程度分级（grading）。</items><items id="description">对于当前问题或诊断的总体严重程度的评估[结果]。</items><items id="text">严重程度</items></items><items code="at0009"><items id="comment">用于提供关于问题或诊断的背景和上下文/语境，包括发展演变、片段或恶化、进展和任何其他相关的详情。</items><items id="description">关于当前问题或诊断的叙述性描述。</items><items id="text">临床描述</items></items><items code="at0012"><items id="comment">尽可能首选采用术语标准对解剖位置的名称进行编码。&#13;
&#13;
请利用本数据元记录先组[配]式（ precoordinated）的解剖位置。如果是由应用程序在运行时来确定关于记录解剖位置的要求，或者是需要更为复杂的建模（如相对位置），则请在本原始型的结构化解剖位置槽位 "Structured anatomical location" 采用群簇型解剖位置原始型 CLUSTER.anatomical_location 或群簇型相对位置原始型 CLUSTER.relative_location。本数据元的基数/出现次数并不受限制，以便能够适应不同的临床场景，如描述同时拥有多个解剖位置的皮疹但所有其他的特征属性全都相同。如果问题/诊断名称之中是利用先组[配]式代码（ precoordinated code）来记录相应的解剖位置，则本数据元就会变得多余。</items><items id="description">明确的是代表当前问题或诊断所处解剖位置的简单的身体部位。</items><items id="text">身体部位</items></items><items code="at0030"><items id="comment">可以接受部分型/不完整的日期。如果服务对象未满一周岁，则需要完整的日期或者至少是月份和年份才能准确地计算出年龄 - 比如，在将其用于驱动决策支持之时。应当利用服务/记录对象（患者）的出生日期，将作为临床认定[之时的]年龄（Age at time of clinical recognition）而采集/导入的数据转换成具体的日期。</items><items id="description">医疗保健专业人员所确定的，当前问题或诊断的估计或实际的解决或缓解日期/时间。</items><items id="text">解决日期/时间</items></items><items code="at0032"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0039"><items id="comment">如果是由应用程序在运行时来确定关于记录解剖位置的要求，或者是需要更为复杂的建模（如相对位置），则请在当前槽位之中采用群簇型解剖位置原始型 CLUSTER.anatomical_location 或群簇型相对位置原始型 CLUSTER.relative_location。&#13;
&#13;
如果问题/诊断名称之中是利用先组[配]式代码（ precoordinated code）来记录相应的解剖位置，则本数据元就会变得多余。</items><items id="description">当前问题或诊断的结构化解剖位置。</items><items id="text">结构化身体部位</items></items><items code="at0043"><items id="comment">可能包括关于当前诊断的分级或分期、诊断标准、分类标准或正式的严重程度评估（如不良事件通用术语标准）的结构化详情。</items><items id="description">记录当前问题或诊断特有的特征属性时所额外需要的详细信息。</items><items id="text">特有详情</items></items><items code="at0046"><items id="comment">请谨慎使用状态（status）或上下文/语境（context）限定词，因为它们在实际工作中运用会变化不定，除非与相应的运用社区一起明确定义了用法，否则就无法保证互操作性（interoperability）。例如：有效性状态（现行有效、无效、已解决、缓解中）、演变状态（ 初步、临时/工作、最终）、时间状态（当前、过去/既往）、偶发性（episodicity）状态（首次、新近、持续）、入院状态（入院、出院）或者优先级状态（主要、次要）。</items><items id="description">关于诊断过程的位置/场所、领域、服务节段/片段（episode）或工作流的特有方面的结构化详细信息。</items><items id="text">状态</items></items><items code="at0047"><items id="description">如果不加治疗/处理，当前的问题或诊断并不会干扰患者的正常活动或者可能会对其健康造成损害。</items><items id="text">轻度</items></items><items code="at0048"><items id="description">如果不加治疗/处理，当前的问题或诊断会干扰患者的正常活动或者会对其健康造成损害。</items><items id="text">中度</items></items><items code="at0049"><items id="description">如果不加治疗/处理，当前的问题或诊断会妨碍患者的正常活动或者会对其健康造成严重的损害。</items><items id="text">重度</items></items><items code="at0069"><items id="description">其他字段之中并未采集的，关于当前问题或诊断的其他叙述。</items><items id="text">备注</items></items><items code="at0070"><items id="description">最后更新当前问题或诊断时的日期。</items><items id="text">最后更新日期</items></items><items code="at0071"><items id="comment">例如：本地信息需求/要求，或者是与 FHIR 或 CIMI 等效项保持一致时所需的其他元数据。</items><items id="description">采集本地内容或与其他参考模型/形式化体系保持一致时所需的其他信息。</items><items id="text">扩展</items></items><items code="at0072"><items id="description">关于起始/发病以来当前问题或诊断的过程/进程/病程（course）的叙述性描述。</items><items id="text">进程描述</items></items><items code="at0073"><items id="comment">如果需要采用其他备选的取值集合，则可以将这些取值添加到模板当中的文本型数据类型 DV_TEXT 。</items><items id="description">关于确定当前诊断的置信度水平。</items><items id="text">诊断确定性</items></items><items code="at0074"><items id="description">确定当前诊断时的确定性较低。</items><items id="text">疑似</items></items><items code="at0075"><items id="description">确定当前诊断时的确定性较高。</items><items id="text">很可能</items></items><items code="at0076"><items id="description">确定当前诊断时依据的是公认的[诊断]标准/评判准则。</items><items id="text">确诊/确认</items></items><items code="at0077"><items id="comment">应当利用服务/记录对象（患者）的出生日期，将起始/发病年龄（Age at onset）而采集/导入的数据转换成具体的日期。</items><items id="description">首次观察到/发现当前问题/诊断的症状或体征的估计或实际日期/时间。</items><items id="text">起始日期/时间</items></items><items code="at0078"><items id="comment">又称为“病因”（aetiology/etiology）。尽可能首选采用外部术语标准来进行编码。</items><items id="description">问题或诊断的原因、原因集合（成套/成组的原因）或因果作用方式（manner of causation）。</items><items id="text">原因</items></items><items code="at0079"><items id="comment">例如：“急性运动轴突性神经病”（acute motor axonal neuropathy）就属于是吉兰-巴雷综合征（Guillain-Barre Syndrome）的变体。尽可能首选采用术语标准对变体/亚型的名称进行编码。</items><items id="description">当前诊断的特定变体/变异类型或亚型/子类型（如果相关/合适）。</items><items id="text">变体/亚型</items></items><items code="at0080"><items id="description"/><items id="text">*DV_TEXT (en)</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.body_weight.v2"><term_definitions language="ar-sy"><items code="at0000"><items id="description">قياس وزن الجسم للشخص</items><items id="text">وزن الجسم</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0004"><items id="description">وزن الشخص</items><items id="text">الوزن</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">*Description of the state of dress of the person at the time of weighing.(en)</items><items id="text">*State of dress(en)</items></items><items code="at0010"><items id="description">الشخص يرتدي ملابس قد تزيد الوزن بشكل مؤثر, بما في ذلك الأحذية.</items><items id="text">ملابس كاملة, بما في ذلك الأحذية</items></items><items code="at0011"><items id="description">ملابس لا تزيد الوزن بشكل مؤثر</items><items id="text">ملابس خفيفة/ ملابس داخلية</items></items><items code="at0013"><items id="description">لا يرتدي أي ملابس</items><items id="text">مُعَرَّى</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">الشخص يرتدي حفاظة فقط - و قد يزيد ذلك من الوزن بشكل مؤثر</items><items id="text">حفاظة</items></items><items code="at0020"><items id="description">تفاصيل حول الجهيزة المستخدمة في القياس</items><items id="text">الجهيزة</items></items><items code="at0024"><items id="description">*Additional narrative about the measurement of Body weight, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="description">*Record any issues or factors that may impact on the measurement of body weight eg timing in menstrual cycle, timing of recent bowel motion or noting of amputation.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0026"><items id="description">*Usually the first weight, measured soon after birth. This event will only be used once per health record&#13;
.(en)</items><items id="text">*Birth(en)</items></items><items code="at0027"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0028"><items id="description">*Clothing which may add significantly to weight. (en)</items><items id="text">*Fully clothed, without shoes (en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="description">Mesura del pes corporal d'un pacient.</items><items id="text">Pes corporal</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Esdeveniment predeterminat i no especificat d’un moment donat específic o interval que es pot definir explícitament en una plantilla o en temps d’execució.</items><items id="text">Qualsevol esdeveniment</items></items><items code="at0004"><items id="description">Pes del pacient.</items><items id="text">Pes</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Descripció de la vestimenta del pacient al moment de la mesura del pes corporal.</items><items id="text">Vestimenta</items></items><items code="at0010"><items id="description">La indumentària, incloent-hi calçat, que pot incrementar significativament el pes.</items><items id="text">Totalment vestit/da, incloent calçat</items></items><items code="at0011"><items id="description">Vestimenta que no incrementa significativament el pes.</items><items id="text">Indumentària lleugera/Roba interior</items></items><items code="at0013"><items id="description">Sense roba.</items><items id="text">Nu/a</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Únicament amb bolquers, la qual cosa pot incrementar significativament el pes.</items><items id="text">Bolquers</items></items><items code="at0020"><items id="description">Detalls sobre el dispositiu de pesatge.</items><items id="text">Dispositiu</items></items><items code="at0024"><items id="description">Informació addicional sobre la mesura del Pes corporal, no recollida en altres caselles.</items><items id="text">Observacions</items></items><items code="at0025"><items id="description">Registrar qualsevol problema o factor que pugui afectar la mesura del pes corporal; per exemple, en el cicle menstrual, moviment intestinal recent o registre d'una amputació.</items><items id="text">Factors de confusió</items></items><items code="at0026"><items id="description">Generalment, la primera mesura de pes corporal, presa poc després del naixement. Aquest esdeveniment només es farà servir una vegada per registre mèdic.</items><items id="text">Naixement</items></items><items code="at0027"><items id="comment">Per exemple: requisits locals d'informació o metadades addicionals per alinear-se amb equivalents de FHIR o CIMI.</items><items id="description">Informació addicional necessària per a recollir el contingut local o per alinear-se amb altres models/formalismes de referència.</items><items id="text">Extensió</items></items><items code="at0028"><items id="description">La vestimenta, sense calçat, que pot incrementar significativament el pes.</items><items id="text">Totalment vestit/da, sense calçat</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="description">Messung des Körpergewichts eines Individuums.</items><items id="text">Körpergewicht</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">History</items></items><items code="at0003"><items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items><items id="text">Beliebiges Ereignis</items></items><items code="at0004"><items id="description">Das Gewicht eines Individuums.</items><items id="text">Gewicht</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">State structure</items></items><items code="at0009"><items id="description">Beschreibung des Kleidungszustands der Person zum Zeitpunkt des Wiegens.</items><items id="text">Status der Bekleidung</items></items><items code="at0010"><items id="description">Bekleidung, die signifikant zum Gewicht beiträgt, mit Schuhen.</items><items id="text">Voll bekleidet, mit Schuhen</items></items><items code="at0011"><items id="description">Bekleidung, die nicht signifikant zum Gewicht beiträgt.</items><items id="text">Leicht bekleidet / Unterwäsche</items></items><items code="at0013"><items id="description">Ohne Kleidung.</items><items id="text">Unbekleidet</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">Protocol structure</items></items><items code="at0017"><items id="description">Trägt Windel; kann signifikant zum Gewicht beitragen.</items><items id="text">Windel</items></items><items code="at0020"><items id="description">Details über die benutzte Waage.</items><items id="text">Gerät</items></items><items code="at0024"><items id="description">Zusätzliche Darstellung der Messung des Körpergewichts, die in anderen Bereichen nicht erfasst wurde.&#13;
	</items><items id="text">Kommentar</items></items><items code="at0025"><items id="description">Beschreibung aller Probleme oder Faktoren, die sich auf die Messung des Körpergewichts auswirken können, z. B. das Timing im Menstruationszyklus, das Timing des letzten Stuhlgangs oder das Feststellen einer Amputation.</items><items id="text">Einflussfaktoren</items></items><items code="at0026"><items id="description">Normalerweise das erste Gewicht, gemessen kurz nach der Geburt. Dieses Ereignis wird nur einmal pro Gesundheitsakte verwendet.</items><items id="text">Geburt</items></items><items code="at0027"><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="text">Erweiterung</items></items><items code="at0028"><items id="description">Bekleidung, die signifikant zum Gewicht beiträgt.</items><items id="text">Voll bekleidet, ohne Schuhen</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">Measurement of the body weight of an individual.</items><items id="text">Body weight</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items><items id="text">Any event</items></items><items code="at0004"><items id="description">The weight of the individual.</items><items id="text">Weight</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Description of the state of dress of the person at the time of weighing.</items><items id="text">State of dress</items></items><items code="at0010"><items id="description">Clothing which may add significantly to weight, including shoes.</items><items id="text">Fully clothed, including shoes</items></items><items code="at0011"><items id="description">Clothing which will not add to weight significantly.</items><items id="text">Lightly clothed/underwear</items></items><items code="at0013"><items id="description">Without any clothes.</items><items id="text">Naked</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Wearing only a nappy - which may add significantly to weight.</items><items id="text">Nappy/diaper</items></items><items code="at0020"><items id="description">Details about the weighing device.</items><items id="text">Device</items></items><items code="at0024"><items id="description">Additional narrative about the measurement of Body weight, not captured in other fields.</items><items id="text">Comment</items></items><items code="at0025"><items id="description">Record any issues or factors that may impact on the measurement of body weight eg timing in menstrual cycle, timing of recent bowel motion or noting of amputation.</items><items id="text">Confounding factors</items></items><items code="at0026"><items id="description">Usually the first weight, measured soon after birth. This event will only be used once per health record&#13;
.</items><items id="text">Birth</items></items><items code="at0027"><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></items><items code="at0028"><items id="description">Clothing which may add significantly to weight.</items><items id="text">Fully clothed, without shoes</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="description">Medición del peso corporal de un individuo.</items><items id="text">Peso corporal</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Simple(en)</items></items><items code="at0002"><items id="description">*@ internal @(en)</items><items id="text">*history(en)</items></items><items code="at0003"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0004"><items id="description">Peso del individuo.</items><items id="text">Peso</items></items><items code="at0008"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0009"><items id="description">*Description of the state of dress of the person at the time of weighing.(en)</items><items id="text">*State of dress(en)</items></items><items code="at0010"><items id="description">La indumentaria, incluyendo calzado, puede incrementar el peso de forma significativa.</items><items id="text">Totalmente vestido incluyendo calzado</items></items><items code="at0011"><items id="description">La indumentaria no genera un incremento significativo del peso.</items><items id="text">Indumentaria ligera/Ropa interior</items></items><items code="at0013"><items id="description">Sin ropa.</items><items id="text">Desnudo</items></items><items code="at0015"><items id="description">*@ internal @(en)</items><items id="text">*protocol structure(en)</items></items><items code="at0017"><items id="description">Únicamente con un pañal. Puede incrementar el peso de forma significativa.</items><items id="text">Pañales</items></items><items code="at0020"><items id="description">Detalles acerca del dispositivo de pesada.</items><items id="text">Dispositivo</items></items><items code="at0024"><items id="description">*Additional narrative about the measurement of Body weight, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="description">*Record any issues or factors that may impact on the measurement of body weight eg timing in menstrual cycle, timing of recent bowel motion or noting of amputation.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0026"><items id="description">*Usually the first weight, measured soon after birth. This event will only be used once per health record&#13;
.(en)</items><items id="text">*Birth(en)</items></items><items code="at0027"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0028"><items id="description">*Clothing which may add significantly to weight. (en)</items><items id="text">*Fully clothed, without shoes (en)</items></items></term_definitions><term_definitions language="fa"><items code="at0000"><items id="description">اندازه گیری وزن بدن فرد</items><items id="text">وزن بدن</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0004"><items id="description">وزن فرد</items><items id="text">وزن</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">*Description of the state of dress of the person at the time of weighing.(en)</items><items id="text">*State of dress(en)</items></items><items code="at0010"><items id="description">لباسی که ممکن است بطور قابل توجهی به وزن بیافزاید شامل کفش ها</items><items id="text">کاملا لباس پوشیده ، از جمله کفش</items></items><items code="at0011"><items id="description">لباسی که بطور قابل توجهی وزن را افزایش ندهد</items><items id="text">لباس سبک یا لباس زیر</items></items><items code="at0013"><items id="description">بدون هر گونه لباس</items><items id="text">لخت</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">پوشیدن فقط یک پوشک که می تواند وزن را بطور قابل توجهی افزایش دهد</items><items id="text">کهنه بچه یا پوشک</items></items><items code="at0020"><items id="description">توصیف تجهیز استفاده شده برای اندازه گیری وزن</items><items id="text">تجهیز</items></items><items code="at0024"><items id="description">*Additional narrative about the measurement of Body weight, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="description">*Record any issues or factors that may impact on the measurement of body weight eg timing in menstrual cycle, timing of recent bowel motion or noting of amputation.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0026"><items id="description">*Usually the first weight, measured soon after birth. This event will only be used once per health record&#13;
.(en)</items><items id="text">*Birth(en)</items></items><items code="at0027"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0028"><items id="description">*Clothing which may add significantly to weight. (en)</items><items id="text">*Fully clothed, without shoes (en)</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="description">Henkilön painon mittaustulos.</items><items id="text">Paino</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Oletusarvo, määrittämätön ajanhetki tai aikaväli, joka voidaan nimenomaisesti määritellä templaatilla tai suorituksen aikana.</items><items id="text">Mikä tahansa tapahtuma</items></items><items code="at0004"><items id="description">Henkilön paino.</items><items id="text">Paino</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Kuvaus henkilön vaatetuksesta painon mittaushetkellä.</items><items id="text">Vaatetus</items></items><items code="at0010"><items id="description">Vaatetus, joka voi merkittävästi lisätä painoa, sisältäen kengät.</items><items id="text">Vaatteet päällä, kengät jalassa</items></items><items code="at0011"><items id="description">Vaatetus, joka ei merkittävästi lisää painoa.</items><items id="text">Kevyt vaatetus/alusvaatteet</items></items><items code="at0013"><items id="description">Ilman vaatteita.</items><items id="text">Alasti</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Päällä ainoastaan vaippa - voi lisätä merkittävästi painoa.</items><items id="text">Vaippa</items></items><items code="at0020"><items id="description">Lisätietoja käytetystä mittalaitteesta.</items><items id="text">Laite</items></items><items code="at0024"><items id="description">Lisätietoa liittyen Painon mittaamiseen, jota ei ole tallennettu muissa kentissä.</items><items id="text">Kommentti</items></items><items code="at0025"><items id="description">Kirjaa tekijät, jotka voivat vaikuttaa painon mittaustulokseen. Esimerkiksi kuukautiskierron vaihe, suolen toiminnan edellinen ajankohta tai amputaation huomioiminen.</items><items id="text">Sekoittavat tekijät</items></items><items code="at0026"><items id="description">Ensimmäinen painotieto, joka on mitattu pian syntymän jälkeen. Kyseinen tieto kirjataan vain yhden kerran henkilön terveystietoihin.</items><items id="text">Syntymä</items></items><items code="at0027"><items id="comment">Esimerkki: paikallisia tietovaatimuksia tai metadataa yhdistettäväksi FHIR tai CIMI tietomalleihin.</items><items id="description">Lisätietoja joita on tarvittu mittaustuloksen tallentamiseen tai yhdistämiseen toisiin referenssimalleihin.</items><items id="text">Laajennus</items></items><items code="at0028"><items id="description">Vaatetus, joka voi merkittävästi lisätä painoa.</items><items id="text">Vaatteet päällä, ilman kenkiä.</items></items></term_definitions><term_definitions language="fr"><items code="at0000"><items id="description">Mesure du poids corporel d'un individu.</items><items id="text">Poids corporel</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Événement par défaut, à un moment ou à un intervalle non spécifié, qui peut être explicitement défini dans un modèle ou au moment de l'exécution.</items><items id="text">*Any event(en)</items></items><items code="at0004"><items id="description">Le poids de l'individu.</items><items id="text">Poids</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Description de l'état vestimentaire de la personne au moment de la pesée.</items><items id="text">État de la tenue vestimentaire</items></items><items code="at0010"><items id="description">Les vêtements qui peuvent augmenter considérablement le poids, y compris les chaussures.</items><items id="text">Entièrement habillé, y compris les chaussures</items></items><items code="at0011"><items id="description">Des vêtements qui n'augmentent pas le poids de manière significative.</items><items id="text">Légèrement vêtu/en sous-vêtement</items></items><items code="at0013"><items id="description">Sans vêtements.</items><items id="text">Nu</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Ne porter qu'une couche - ce qui peut augmenter considérablement le poids.</items><items id="text">Couche-culotte</items></items><items code="at0020"><items id="description">Détails sur le dispositif de pesage.</items><items id="text">Dispositif</items></items><items code="at0024"><items id="description">Narration supplémentaire sur la mesure du poids corporel, non saisie dans d'autres domaines.</items><items id="text">Commentaire</items></items><items code="at0025"><items id="description">Enregistrez toutes les questions ou facteurs qui peuvent avoir un impact sur la mesure du poids corporel, par exemple le moment du cycle menstruel, le moment de la défécation récente ou la constatation d'une amputation.</items><items id="text">Facteurs de confusion</items></items><items code="at0026"><items id="description">Habituellement, le premier poids, mesuré peu après la naissance. Cet événement ne sera utilisé qu'une seule fois par dossier de santé</items><items id="text">Naissance</items></items><items code="at0027"><items id="comment">Par exemple : exigences locales en matière d'information ou métadonnées supplémentaires à aligner sur les équivalents FHIR ou CIMI.</items><items id="description">Informations supplémentaires requises pour saisir le contenu local ou pour s'aligner sur d'autres modèles/formalismes de référence.</items><items id="text">Extension</items></items><items code="at0028"><items id="description">Les vêtements qui peuvent augmenter considérablement le poids.</items><items id="text">Entièrement vêtu, sans chaussures</items></items></term_definitions><term_definitions language="ja"><items code="at0000"><items id="description">個人の体重を測定したもの</items><items id="text">体重</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Simple(en)</items></items><items code="at0002"><items id="description">*@ internal @(en)</items><items id="text">*history(en)</items></items><items code="at0003"><items id="description">デフォルトではテンプレートや実行時に明示的に定義される特定されていない時点あるいは間隔でのイベント</items><items id="text">任意のイベント</items></items><items code="at0004"><items id="description">個人の重量</items><items id="text">重量</items></items><items code="at0008"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0009"><items id="description">体重測定時の着衣状態についての記述￥</items><items id="text">着衣状態</items></items><items code="at0010"><items id="description">靴を含めて、体重測定に大きく関与するような着衣状態</items><items id="text">靴も履いている着衣状態</items></items><items code="at0011"><items id="description">体重測定にあまり寄与しない着衣</items><items id="text">軽装／下着</items></items><items code="at0013"><items id="description">何も着衣していない</items><items id="text">全裸</items></items><items code="at0015"><items id="description">*@ internal @(en)</items><items id="text">*protocol structure(en)</items></items><items code="at0017"><items id="description">おむつだけをはいている状態。体重測定に関与しうる。</items><items id="text">おむつを付けている状態</items></items><items code="at0020"><items id="description">測定に使用された機器についての詳細な記録</items><items id="text">測定機器</items></items><items code="at0024"><items id="description">他のフィールドには記載されない体重の計測についての叙述的記録</items><items id="text">コメント</items></items><items code="at0025"><items id="description">体重計測に影響を与えうるすべての要素や問題。例えば、月経周期や直近の排便時、四肢切断の有無。</items><items id="text">交絡因子</items></items><items code="at0026"><items id="description">一般的には誕生後最初に計測される体重。このイベントは一生に1回だけ記録される。</items><items id="text">生下時</items></items><items code="at0027"><items id="comment">例えば、FHIRやCIMIと同等に割り当てられるメタデータやローカルの情報要件</items><items id="description">ローカルの内容や他の参照モデル、形式に割り当ててデータを取得する追加情報</items><items id="text">拡張領域</items></items><items code="at0028"><items id="description">体重計測に影響を与えうる着衣状態</items><items id="text">靴を脱いだ着衣状態</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">Individets kroppsvekt.</items><items id="text">Kroppsvekt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.</items><items id="text">Uspesifisert hendelse</items></items><items code="at0004"><items id="description">Et individs totale kroppsmasse.</items><items id="text">Kroppsvekt</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Beskrivelse av personens påkledning på måletidspunktet.</items><items id="text">Påkledning</items></items><items code="at0010"><items id="description">Påkledning som kan øke vekten signifikant, inklusive sko.</items><items id="text">Fullt påkledt inklusive sko</items></items><items code="at0011"><items id="description">Påkledning som ikke endrer vekten signifikant.</items><items id="text">Lette klær / undertøy</items></items><items code="at0013"><items id="description">Uten klær.</items><items id="text">Naken</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Bare ikledt bleie - kan legge til signifikant vekt.</items><items id="text">Bleie</items></items><items code="at0020"><items id="description">Detaljer om måleapparatet brukt til vektmålingen.</items><items id="text">Måleapparat</items></items><items code="at0024"><items id="description">Ytterligere beskrivelse av målingen av kroppsvekt som ikke dekkes i andre felt.</items><items id="text">Kommentar</items></items><items code="at0025"><items id="description">Registering av emner eller faktorer som kan ha betydning for måling av kroppsvekten, f.eks. inntak av mat og drikke, stort saltinntak, menstruasjonssyklus, tidspunkt for avføring, ødem eller uke av graviditet.</items><items id="text">Konfunderende faktorer</items></items><items code="at0026"><items id="description">Den første vekten målt etter fødselen. Denne hendelsen skal kun benyttes én gang per journal.</items><items id="text">Fødsel</items></items><items code="at0027"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at0028"><items id="description">Påkledning som kan øke vekten signifikant.</items><items id="text">Fullt påkledt, uten sko</items></items></term_definitions><term_definitions language="nl"><items code="at0000"><items id="description">Meting van het lichaamsgewicht van een individu.</items><items id="text">Lichaamsgewicht</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Simple(en)</items></items><items code="at0002"><items id="description">*@ internal @(en)</items><items id="text">*history(en)</items></items><items code="at0003"><items id="description">Standaard, ongespecificeerd moment in de tijd of een interval dat expliciet vastgelegd kan worden in een template terwijl de applicatie draait.</items><items id="text">Elke gebeurtenis</items></items><items code="at0004"><items id="description">Het gewicht van het individu.</items><items id="text">Gewicht</items></items><items code="at0008"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0009"><items id="description">Beschrijving van de kleding die de persoon draagt op het moment van wegen.</items><items id="text">Kleding</items></items><items code="at0010"><items id="description">Kleren die een significante bijdrage hebben aan het gewicht, inclusief schoenen.</items><items id="text">Volledig gekleed, inclusief schoenen</items></items><items code="at0011"><items id="description">Kleding die niet significant het gewicht beïnvloedt.</items><items id="text">Lichte kleding/ondergoed</items></items><items code="at0013"><items id="description">Zonder kleding.</items><items id="text">Naakt</items></items><items code="at0015"><items id="description">*@ internal @(en)</items><items id="text">*protocol structure(en)</items></items><items code="at0017"><items id="description">Individu draagt alleen een luier - die significant aan het gewicht kan bijdragen.</items><items id="text">Luier</items></items><items code="at0020"><items id="description">Details over het apparaat waarmee gewogen is.</items><items id="text">Apparaat</items></items><items code="at0024"><items id="description">Extra informatie over de meting van het lichaamsgewicht, die niet past binnen andere velden.</items><items id="text">Opmerking</items></items><items code="at0025"><items id="description">Leg elke gegeven of factor vast die invloed heeft op de meting van het lichaamsgewicht, bijvoorbeeld moment in de menstruele cyclus, tijd sinds recente ontlasting of een amputatie.</items><items id="text">Beïnvloedende factoren.</items></items><items code="at0026"><items id="description">Normaal het eerste gewicht na geboorte. Deze waarde slechts eenmalig worden vastgelegd per elektronisch dossier.</items><items id="text">Geboorte</items></items><items code="at0027"><items id="comment">Bijvoorbeeld: lokale informatie eisen of extra metadata om te verbinden met FHIR of CIMI vergelijkbare systemen.</items><items id="description">Extra informatie die nodig is om lokale informatie vast te leggen of om te verbinden met andere referentiemodulen.</items><items id="text">Uitbreiding</items></items><items code="at0028"><items id="description">Kleding die het gewicht significant beïnvloedt.</items><items id="text">Volledig gekleed maar, zonder schoenen.</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="description">A medição do peso corporal de um indivíduo.</items><items id="text">Peso corporal</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Padrão, ponto específico no tempo ou intervalo que pode ser explicitamente definido em template ou em tempo de execução.</items><items id="text">Qualquer evento</items></items><items code="at0004"><items id="description">O peso do indivíduo.</items><items id="text">Peso</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Descrição da situação do vestuário do indivíduo no momento da pesagem.</items><items id="text">Situação do vestuário</items></items><items code="at0010"><items id="description">Roupas que podem aumentar significativamente o peso, incluindo sapatos.</items><items id="text">Totalmente vestida, incluindo sapatos</items></items><items code="at0011"><items id="description">Roupas que não irão acrescentar ao peso de forma significativa.</items><items id="text">Levemente vestido / roupa íntimas</items></items><items code="at0013"><items id="description">Sem nenhuma roupa.</items><items id="text">Despido</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Vestindo apenas uma fralda - pode adicionar peso significativo.</items><items id="text">Fralda</items></items><items code="at0020"><items id="description">Detalhes sobre o dispositivo de pesagem.</items><items id="text">Dispositivo</items></items><items code="at0024"><items id="description">Narrativa adicional sobre a medida de peso corporal, não capturado em outros campos.</items><items id="text">Comentário</items></items><items code="at0025"><items id="description">Registra qualquer problemas ou fatores que impactam na medida do peso corporal pe período menstrual, período recente de movimento peristáltico e observação de amputação.</items><items id="text">Fatores de confundimento</items></items><items code="at0026"><items id="description">Normalmente o primeiro peso, medido ao nascer.</items><items id="text">Nascimento</items></items><items code="at0027"><items id="comment">Por exemplo: informações locais necessárias ou metadados adicionais para alinhamento ao FHIR ou outras iniciativas equivalentes de modelagem do conhecimento clínico.</items><items id="description">Informação adicional requerida para capturar conteúdo local ou para alinhar a outros modelos de referência/formalismos.</items><items id="text">Extensão</items></items><items code="at0028"><items id="description">Roupas que podem aumentar significativamente o peso.</items><items id="text">Totalmente vestida, sem sapatos</items></items></term_definitions><term_definitions language="ru"><items code="at0000"><items id="description">Измерение актуальной массы тела человека.</items><items id="text">Масса тела</items></items><items code="at0001"><items id="description">Bнутренний элемент.</items><items id="text">Простой</items></items><items code="at0002"><items id="description">Bнутренний элемент.</items><items id="text">История</items></items><items code="at0003"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0004"><items id="description">Актуальный вес человека.</items><items id="text">Вес</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">*Description of the state of dress of the person at the time of weighing.(en)</items><items id="text">*State of dress(en)</items></items><items code="at0010"><items id="description">Одежда может добавить значительный вес.</items><items id="text">В одежде без обуви</items></items><items code="at0011"><items id="description">Одежда, не добавляющая значительный вес.</items><items id="text">В лёгкой одежде или раздевшись до белья</items></items><items code="at0013"><items id="description">Без какой-либо одежды и белья.</items><items id="text">Обнажен</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Одет(а) только в памперс - может добавить значительный вес.</items><items id="text">В памперсе</items></items><items code="at0020"><items id="description">Весы (устройство, на котором производилось взвешивание): информация.</items><items id="text">Устройство</items></items><items code="at0024"><items id="description">*Additional narrative about the measurement of Body weight, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="description">*Record any issues or factors that may impact on the measurement of body weight eg timing in menstrual cycle, timing of recent bowel motion or noting of amputation.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0026"><items id="description">*Usually the first weight, measured soon after birth. This event will only be used once per health record&#13;
.(en)</items><items id="text">*Birth(en)</items></items><items code="at0027"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0028"><items id="description">*Clothing which may add significantly to weight. (en)</items><items id="text">*Fully clothed, without shoes (en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="description">Mätning av en individs kroppsvikt.</items><items id="text">Kroppsvikt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items><items id="text">Ospecificerad händelse</items></items><items code="at0004"><items id="description">Individens vikt.</items><items id="text">Vikt</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Beskrivning av individens klädsel vid tidpunkten för vägning.</items><items id="text">Klädsel</items></items><items code="at0010"><items id="description">Kläder, inklusive skor, som kan öka vikten avsevärt.</items><items id="text">Fullt påklädd, inklusive skor</items></items><items code="at0011"><items id="description">Kläder som inte ökar vikten avsevärt.</items><items id="text">Lätt klädd/underkläder</items></items><items code="at0013"><items id="description">Inga kläder alls.</items><items id="text">Naken</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Iklädd endast blöja, som kan öka vikten avsevärt.</items><items id="text">Blöja</items></items><items code="at0020"><items id="description">Detaljer om den utrustning som används för att mäta vikten.</items><items id="text">Utrustning</items></items><items code="at0024"><items id="description">Kommentarer avseende mätningen av kroppsvikt, som inte beskrivs i övriga datafält.</items><items id="text">Kommentar</items></items><items code="at0025"><items id="description">Beskrivning av faktorer och felkällor som kan påverka mätningen av kroppsvikt, exempelvis tidpunkt i menstruationscykeln, tid sedan senaste tarmtömning eller amputation.</items><items id="text">Möjliga felkällor</items></items><items code="at0026"><items id="description">Vanligtvis den första vägningen av barnet, strax efter födseln. Den här händelsen registreras endast en gång per patientjournal.</items><items id="text">Födelse</items></items><items code="at0027"><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items><items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="text">Tilläggsinformation</items></items><items code="at0028"><items id="description">Kläder som kan öka vikten avsevärt.</items><items id="text">Fullt påklädd, utan skor</items></items></term_definitions><term_definitions language="zh-cn"><items code="at0000"><items id="description">个人体重（身体重量）的测量。</items><items id="text">体重</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Simple(en)</items></items><items code="at0002"><items id="description">*@ internal @(en)</items><items id="text">*history(en)</items></items><items code="at0003"><items id="description">任何事件。</items><items id="text">任何事件</items></items><items code="at0004"><items id="description">个人的身体重量。</items><items id="text">重量</items></items><items code="at0008"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0009"><items id="description">关于称重时受检人员的衣着状态</items><items id="text">衣着状态</items></items><items code="at0010"><items id="description">包括鞋子在内，所穿着衣物可能显著增加重量。</items><items id="text">衣着整齐，包括鞋子</items></items><items code="at0011"><items id="description">所穿着衣物并不会显著增加重量。</items><items id="text">衣着轻便/仅内衣</items></items><items code="at0013"><items id="description">没有穿着任何衣物。</items><items id="text">裸体</items></items><items code="at0015"><items id="description">*@ internal @(en)</items><items id="text">*protocol structure(en)</items></items><items code="at0017"><items id="description">仅有尿布/尿不湿 - 有可能显著增加重量。</items><items id="text">尿布/尿不湿</items></items><items code="at0020"><items id="description">关于称重装置的详细信息。</items><items id="text">装置</items></items><items code="at0024"><items id="description">其他字段之中并未记录的，额外关于体重测量指标的叙述型文本。</items><items id="text">备注</items></items><items code="at0025"><items id="description">用于记录任何可能对体重测量造成影响的问题或因素，如月经周期所处时间阶段、最近排便的时间安排情况或者截肢情况说明。</items><items id="text">干扰因素</items></items><items code="at0026"><items id="description">通常为出生之后短时间内所首次测量的体重。在每份健康档案当中将仅仅使用一次该事件。</items><items id="text">出生</items></items><items code="at0027"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)&#13;
例如，与FHIR或CIMI对等要素进行协调统一时所需的本地信息需求或附加的元数据。</items><items id="description">记录本地内容时或者是与其他的参考模型/形式化体系进行协调统一时所需的附加信息。</items><items id="text">扩展</items></items><items code="at0028"><items id="description">可能会显著增加重量的衣物。</items><items id="text">衣着整齐，不包括鞋子</items></items></term_definitions><term_bindings terminology="LOINC"><items code="at0004"><value><terminology_id><value>LOINC</value></terminology_id><code_string>29463-7</code_string></value></items></term_bindings></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.fluid_output.v1"><term_definitions language="de"><items code="at0000"><items id="description">Die Messung von Flüssigkeit, die über einen beliebigen Mechanismus aus dem Körper verloren geht oder ausgeschieden wird.</items><items id="text">Flüssigkeitsausscheidung</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items><items id="text">Beliebiges Ereignis</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">Die Flüssigkeitsmenge wurde geschätzt.</items><items id="text">Geschätzt</items></items><items code="at0019"><items id="description">Die Flüssigkeitsmenge wurde direkt gemessen.</items><items id="text">Gemessen</items></items><items code="at0028"><items id="comment">Zum Beispiel: Harnableitungsbeutel.</items><items id="description">Details des Geräts zur Messung des Flüssigkeitsabgangs.</items><items id="text">Messgerät</items></items><items code="at0031"><items id="description">Die angewendete Vorgehensweise zur Quantifizierung der Flüssigkeitsmenge.</items><items id="text">Methode</items></items><items code="at0032"><items id="description">Zusätzliche Informationen über die Flüssigkeit, die nicht in anderen Bereichen dargestellt wurden.</items><items id="text">Kommentar</items></items><items code="at0033"><items id="comment">Zum Beispiel: ein Harnkatheter oder eine Kanüle.</items><items id="description">Details der Vorrichtung, mit der die Flüssigkeit gesammelt wurde.</items><items id="text">Ablaufvorrichtung</items></items><items code="at0035"><items id="comment">Wenn absorbierendes Material wie Windeln und Verbände im Rahmen des Managements der Schätzungen des Flüssigkeitsverlusts gewogen werden, muss zur Erfassung das Gewicht in die Menge umgerechnet werden.</items><items id="description">Die Menge der Flüssigkeit.</items><items id="text">Menge</items></items><items code="at0036"><items id="comment">Zum Beispiel: Urin oder Erbrechen. Wenn möglich, wird die Codierung des Flüssigkeitsnamens mit einer Terminologie bevorzugt.</items><items id="description">Identifizierung der verlorenen oder ausgeschiedenen Flüssigkeit.</items><items id="text">Bezeichnung der Flüssigkeit</items></items><items code="at0038"><items id="comment">Zum Beispiel: die Farbe des Urins.</items><items id="description">Zusätzliche detaillierte Angaben zur Flüssigkeit, einschließlich des makroskopischen Erscheinungsbilds oder anderer Prüfungen, die derzeit nicht in den strukturierten Daten erfasst sind.</items><items id="text">Flüssigkeitsdetails</items></items><items code="at0040"><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="text">Erweiterung</items></items><items code="at0041"><items id="comment">Zum Beispiel: Kanüle; Harnkatheter oder Nasopharyngalschlauch. Wenn in einer klinischen Anwendung dieselbe Art von Flüssigkeit aus zwei oder mehr Quellen wie mehreren Abflüssen aus derselben Wunde beobachtet wird, kann die Quelle als "Kanüle 1" und "Kanüle 2" beschrieben werden. Wenn möglich, wird die Codierung der Quelle mit einer Terminologie bevorzugt.</items><items id="description">Die Quelle, aus der die Flüssigkeit verloren geht oder ausgeschieden wird.</items><items id="text">Quelle</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">The measurement of fluid lost or excreted from the body via any mechanism.</items><items id="text">Fluid output</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items><items id="text">Any event</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">The fluid volume has been estimated.</items><items id="text">Estimated</items></items><items code="at0019"><items id="description">The fluid volume has been directly measured.</items><items id="text">Measured</items></items><items code="at0028"><items id="comment">For example: Urinary drainage bag.</items><items id="description">Details of the device used to measure the fluid output.</items><items id="text">Measurement device</items></items><items code="at0031"><items id="description">The approach used to quantify the volume of fluid.</items><items id="text">Method</items></items><items code="at0032"><items id="description">Additional narrative about the fluid output not captured in other fields.</items><items id="text">Comment</items></items><items code="at0033"><items id="comment">For example: a urinary catheter or a drain tube.</items><items id="description">Details of the device that was used to collect the fluid.</items><items id="text">Output device</items></items><items code="at0035"><items id="comment">If absorbant material, such as diapers and dressings, are weighed as part of managing fluid loss estimates, the weight will need to be converted to a volume for recording.</items><items id="description">The volume of fluid.</items><items id="text">Volume</items></items><items code="at0036"><items id="comment">For example: urine or vomit. Coding of fluid name with a terminology is preferred, if possible.</items><items id="description">Identification of the fluid lost or excreted.</items><items id="text">Fluid name</items></items><items code="at0038"><items id="comment">For example: the colour of the urine.&#13;
</items><items id="description">Additional details about the fluid, including macroscopic appearance or other tests not currently captured in the structured data.</items><items id="text">Fluid details</items></items><items code="at0040"><items id="comment">e.g. Local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></items><items code="at0041"><items id="comment">For example: drain tube; urinary catheter or nasopharyngal tube. In a clinical application, if the same type of fluid is being observed from two or more sources such as multiple drains from the same wound, the source may be described as “Drain tube 1” and “Drain tube 2”. Coding of the source with a terminology is preferred, where possible.</items><items id="description">The source from which the fluid is lost or excreted.</items><items id="text">Source</items></items></term_definitions><term_definitions language="es-ar"><items code="at0000"><items id="description">La medición del fluido perdido o excretados del cuerpo por cualquier mecanismo.</items><items id="text">Egreso de fluido</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Punto en el tiempo o intervalo de un evento que puede ser explícitamente definido en una plantilla o en tiempo de ejecución, por defecto.</items><items id="text">Cualquier evento</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">El volumen del fluido ha sido estimado.</items><items id="text">Estimado</items></items><items code="at0019"><items id="description">El volumen del fluido ha sido medido directamente.</items><items id="text">Medido</items></items><items code="at0028"><items id="comment">Por ejemplo: bolsa de orina.</items><items id="description">El dispositivo utilizado para medir el volumen del fluido.</items><items id="text">Dispositivo de medición</items></items><items code="at0031"><items id="description">El enfoque utilizado para cuantificar el volumen del fluido.</items><items id="text">Método</items></items><items code="at0032"><items id="description">Narrativa adicional acerca del egreso de fluido que no haya sido capturada en otros campos.</items><items id="text">Comentario</items></items><items code="at0033"><items id="comment">Por ejemplo: un catéter urinario o un tubo de drenaje.</items><items id="description">Detalles del dispositivo utilizado para recolectar el líquido.</items><items id="text">Dispositivo de egreso</items></items><items code="at0035"><items id="comment">Si se trata de un material absorbente como pañales o apósitos, se los pesa como parte de la estimación de la perdida del fluido y el peso debe ser convertido a volumen para su registro.</items><items id="description">El volumen del fluido.</items><items id="text">Volumen</items></items><items code="at0036"><items id="comment">Por ejemplo: orina o vómito. Se prefiere la codificación del fluido mediante una terminología si esto es posible.</items><items id="description">Identificación del fluido eliminado o excretado.</items><items id="text">Denominación del fluido</items></items><items code="at0038"><items id="comment">Por ejemplo: el color de la orina.</items><items id="description">Detalles adicionales del fluido, incluyendo el aspecto macroscópico u otros exámenes no registrados mediante datos estructurados.</items><items id="text">Detalles del fluido</items></items><items code="at0040"><items id="comment">Ej.: Requerimientos locales de información o metadatos adicionales para el alineamiento con FHIR, CIMI o equivalentes.</items><items id="description">Información adicional requerida para la captura de contenido locales o el alineamiento con otros modelos o formalismos de referencia.</items><items id="text">Extensión</items></items><items code="at0041"><items id="comment">Por ejemplo: tubo de drenaje; catéter urinario o nasofaringeo. En una aplicación clínica, si el mismo tipo de fluido esta siendo observado a partir de dos o mas fuentes, como en el caso de drenajes múltiples de una misma herida, la fuente será descrita como "tubo de drenaje 1" y "tubo de drenaje 2". Se codificará la fuente mediante una terminología si esto es posible.</items><items id="description">La fuente de pérdida o excreción del fluido.</items><items id="text">Fuente</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="description">Kehon millä tahansa tavalla menettämien tai erittämien nesteiden mittaaminen.</items><items id="text">Nesteiden menetys</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Oletusarvoinen, määrittämättömänä ajanhetkenä tai ajanjaksolla ilmenevä tapahtuma, joka voi olla määritetty tarkasti jossakin mallissa tai suorituksen aikana.</items><items id="text">Mikä tahansa tapahtuma</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">Nesteiden tilavuus on arvioitu.</items><items id="text">Arvio</items></items><items code="at0019"><items id="description">Nesteiden tilavuus on mitattu suoraan.</items><items id="text">Mitattu</items></items><items code="at0028"><items id="comment">For example: Urinary drainage bag.</items><items id="description">Nesteiden menetyksen mittaamiseen käytettävän laitteen tiedot.</items><items id="text">Mittalaite</items></items><items code="at0031"><items id="description">Nesteen tilavuuden mittaamiseen käytettävä menetelmä.</items><items id="text">Menetelmä</items></items><items code="at0032"><items id="description">Nesteiden menetykseen liittyvät kertomusmuodossa olevat lisätiedot, joita ei voida ilmoittaa muissa kentissä.</items><items id="text">Kommentti</items></items><items code="at0033"><items id="comment">For example: a urinary catheter or a drain tube.</items><items id="description">Tiedot nesteen keräämiseen käytetystä laitteesta.</items><items id="text">Erityksen keruulaite</items></items><items code="at0035"><items id="comment">If absorbant material, such as diapers and dressings, are weighed as part of managing fluid loss estimates, the weight will need to be converted to a volume for recording.</items><items id="description">Nesteen tilavuus.</items><items id="text">Tilavuus</items></items><items code="at0036"><items id="comment">For example: urine or vomit. Coding of fluid name with a terminology is preferred, if possible.</items><items id="description">Menetetyn tai eritetyn nesteen nimi.</items><items id="text">Nesteen nimi</items></items><items code="at0038"><items id="comment">For example: the colour of the urine.&#13;
</items><items id="description">Lisätietoja nesteestä, mukaan lukien paljaalla silmällä näkyvä ulkoasu tai muita kokeita, joita ei tällä hetkellä voida kirjata rakenteisiin tietoihin.</items><items id="text">Nesteen lisätiedot</items></items><items code="at0040"><items id="comment">e.g. Local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Lisätiedot, joita tarvitaan paikallisen sisällön kirjaamiseksi tai yhtenäistämiseksi muiden viitemallien tai formalismien kanssa.</items><items id="text">Laajennus</items></items><items code="at0041"><items id="comment">For example: drain tube; urinary catheter or nasopharyngal tube. In a clinical application, if the same type of fluid is being observed from two or more sources such as multiple drains from the same wound, the source may be described as “Drain tube 1” and “Drain tube 2”. Coding of the source with a terminology is preferred, where possible.</items><items id="description">Lähde, josta neste menetetään tai eritetään.</items><items id="text">Lähde</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">Målingen av væske som er utskilt eller utsondret fra kroppen, uavhengig av mekanisme.</items><items id="text">Væsketap</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en template eller i en applikasjon.</items><items id="text">Uspesifisert hendelse</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">Mengden væsketap er estimert.</items><items id="text">Estimert</items></items><items code="at0019"><items id="description">Mengden væsketap er direkte observert og målt.</items><items id="text">Målt</items></items><items code="at0028"><items id="comment">For eksempel drenpose, timediuresesett, urinflaske eller vekt.</items><items id="description">Detaljer om måleutstyret som er brukt for å måle væsketapet.</items><items id="text">Måleutstyr</items></items><items code="at0031"><items id="description">Metoden man har brukt til å kvantifisere mengden av væske.</items><items id="text">Målemetode</items></items><items code="at0032"><items id="description">Ytterligere fritekst om væsketapet som ikke er registrert i andre felt.</items><items id="text">Kommentar</items></items><items code="at0033"><items id="comment">For eksempel urinkateter, sårdren, absorpsjonskompress eller bleie.</items><items id="description">Detaljer om utstyret man har brukt til å samle væsken.</items><items id="text">Utstyr</items></items><items code="at0035"><items id="comment">Dersom man veier et absorberende materiale, som bleie eller kompress for å anslå mengden væske, må man konvertere fra vektenhet til væskeenhet ved registrering.</items><items id="description">Mengden væske som er utskilt.</items><items id="text">Mengde</items></items><items code="at0036"><items id="comment">For eksempel urin eller oppkast. Væskenavn bør kodes med en terminologi om mulig.</items><items id="description">Identifisering av væsken som er utskilt.</items><items id="text">Navn på væsken</items></items><items code="at0038"><items id="comment">For eksempel fargen på urin.</items><items id="description">Ytterligere data om væsken, inkludert utseende eller annet som ikke fremkommer strukturert i andre elementer.</items><items id="text">Ytterligere detaljer om væsken</items></items><items code="at0040"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at0041"><items id="comment">For eksempel dren, urinkateter eller ventrikkelsonde. Hvis samme type væske blir observert fra flere kilder - som flere dren fra samme sår, kan en i et klinisk system kalle kilden "Dren 1" og "Dren 2". Koding med en terminologi er ønskelig, der det er mulig.</items><items id="description">Kilden væsken kommer fra.</items><items id="text">Kilde</items></items></term_definitions><term_definitions language="sl"><items code="at0000"><items id="description">*The measurement of fluid lost or excreted from the body via any mechanism.(en)</items><items id="text">*Fluid output(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Event Series(en)</items></items><items code="at0002"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*List(en)</items></items><items code="at0008"><items id="description">*@ internal @(en)</items><items id="text">*List(en)</items></items><items code="at0018"><items id="description">*The fluid volume has been estimated.(en)</items><items id="text">*Estimated(en)</items></items><items code="at0019"><items id="description">*The fluid volume has been directly measured.(en)</items><items id="text">*Measured(en)</items></items><items code="at0028"><items id="comment">*For example: Urinary drainage bag.(en)</items><items id="description">*Details of device used to measure the fluid output.(en)</items><items id="text">*Measurement device(en)</items></items><items code="at0031"><items id="description">*The approach used to quantify the volume of fluid.(en)</items><items id="text">*Method(en)</items></items><items code="at0032"><items id="description">*Additional narrative about the fluid output not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0033"><items id="comment">*For example: a urinary catheter or a drain tube.(en)</items><items id="description">*Details of the device that was used to collect the fluid.(en)</items><items id="text">*Output device(en)</items></items><items code="at0035"><items id="comment">*If absorbant material, such as diapers and dressings, are weighed as part of managing fluid loss estimates, the weight will need to be converted to a volume for recording.(en)</items><items id="description">*The volume of fluid.(en)</items><items id="text">*Volume(en)</items></items><items code="at0036"><items id="comment">*For example: urine or vomit.(en)</items><items id="description">*Identification of the fluid lost or excreted.(en)</items><items id="text">*Fluid name(en)</items></items><items code="at0038"><items id="comment">*For example: the colour of the urine.&#13;
(en)</items><items id="description">*Additional details about the fluid, including macroscopic appearance or other tests not currently captured in the structured data.(en)</items><items id="text">*Fluid details(en)</items></items><items code="at0040"><items id="description">**(en)</items><items id="text">*Cluster(en)</items></items><items code="at0041"><items id="comment">*For example: drain tube; urinary catheter or nasopharyngal tube. In a clinical application, if the same type of fluid is being observed from two or more sources such as multiple drains from the same wound, the source may be described as “Drain tube 1” and “Drain tube 2”. Coding of the source with a terminology is preferred, where possible. (en)</items><items id="description">*The source from which the fluid is lost or excreted.(en)</items><items id="text">*Source(en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="description">Mätning av vätska som förloras eller utsöndras från kroppen via någon mekanism.</items><items id="text">Vätskeutsöndring</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Standardval, händelse i ospecificerad tidpunkt eller intervall som explicit kan definieras i en mall eller vid körning av program.</items><items id="text">Ospecificerad händelse</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">Vätskevolymen är uppskattad.</items><items id="text">Uppskattad</items></items><items code="at0019"><items id="description">Vätskevolymen har uppmätts direkt.</items><items id="text">Uppmätt</items></items><items code="at0028"><items id="comment">Exempelvis: Dräneringspåse för urin.</items><items id="description">Information om den utrustning som används för att mäta vätskeutsöndringen.</items><items id="text">Mätutrustning</items></items><items code="at0031"><items id="description">Den metod som används för att mäta volymen av vätska.</items><items id="text">Metod</items></items><items code="at0032"><items id="description">Ytterligare beskrivning om vätskeproduktionen som inte tagits med i andra fält.</items><items id="text">Kommentar</items></items><items code="at0033"><items id="comment">Exempelvis: en urinkateter eller ett dränrör.</items><items id="description">Information om den utrustning som användes för att samla ihop vätskan.</items><items id="text">Utsöndringsutrustning</items></items><items code="at0035"><items id="comment">Om absorberande material, såsom blöjor och omslag, vägs som en del i hanteraringen av vätskeförlust-beräkningar, kommer vikten att behöva omvandlas till en volym för registrering.</items><items id="description">Vätskans volym.</items><items id="text">Volym</items></items><items code="at0036"><items id="comment">Exempelvis: urin eller kräkning. Kodning av vätskenamn med en terminologi är att föredra, om möjligt.</items><items id="description">Identifiering av den vätska som försvinner eller utsöndras.</items><items id="text">Vätskenamn</items></items><items code="at0038"><items id="comment">Exempelvis: färgen på urinen.</items><items id="description">Ytterligare information om vätskan, inklusive makroskopiskt utseende eller andra tester som för närvarande inte inkluderats i strukturerade data.</items><items id="text">Vätskedetaljer</items></items><items code="at0040"><items id="comment">Exempelvis lokala informationskrav eller ytterligare metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items><items id="description">Ytterligare information som krävs för att samla in lokalt innehåll eller för anpassning till andra referens modeller och formalismer.</items><items id="text">Extra information</items></items><items code="at0041"><items id="comment">Exempelvis: dränrör, urinkateter eller *nasofaryngeal-rör*. I klinisk tillämpning, om samma typ av vätska observeras från två eller flera källor såsom flera dränage från samma sår, kan källan beskrivas som "Dränrör 1" och "Dranrör 2". Kodning av källa med en terminologi föredras där det är möjligt.</items><items id="description">Källan från vilken vätskan försvinner eller utsöndras. &#13;
</items><items id="text">Källa</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.laboratory_test_result.v1"><term_definitions language="ar-sy"><items code="at0000"><items id="description">*The result, including findings and interpretation, of a laboratory investigation performed on specimens from individuals or related materials(en)</items><items id="text">*Laboratory test result(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Event Series(en)</items></items><items code="at0002"><items id="description">إحدى الوقائع</items><items id="text">إحدى الوقائع</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0004"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0005"><items id="comment">*A test result may be for a single analyte, or a group of items, including panel tests. It is strongly recommended that 'Test name' be coded with a terminology, for example LOINC or SNOMED CT. For example: 'Glucose', 'Urea and Electrolytes', 'Swab', 'Cortisol (am)', 'Potassium in perspiration' or 'Melanoma histopathology'. The name may sometimes include specimen type and patient state, for example 'Fasting blood glucose' or include other information, as 'Potassium (PNA blood gas)'. (en)</items><items id="description">*Name of the laboratory investigation performed on the specimen(s). (en)</items><items id="text">*Test name(en)</items></items><items code="at0017"><items id="comment">*This slot is intended to carry details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.&#13;
&#13;
The receiving laboratory may either perform the test or refer it to another laboratory. Where a different laboratory is responsible for performing the testing on specific analytes, it would be expected that these details would be carried in the 'Analyte result detail' SLOT within the CLUSTER.laboratory_test_analyte archetype.&#13;
&#13;
 (en)</items><items id="description">*Details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.(en)</items><items id="text">*Receiving laboratory(en)</items></items><items code="at0035"><items id="comment">*The 'Distribution list' is for information-only, and that the primary recipient of the report is the person intended to act on the information.(en)</items><items id="description">*Details of additional clinicians or organisations who require a copy of the test result.(en)</items><items id="text">*Distribution list(en)</items></items><items code="at0037"><items id="description">*This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.(en)</items><items id="text">*Partial(en)</items></items><items code="at0038"><items id="description">*The Test result is complete and verified by an authorised person.(en)</items><items id="text">*Final(en)</items></items><items code="at0040"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist, and result data has been changed.(en)</items><items id="text">*Amended(en)</items></items><items code="at0057"><items id="comment">*For example: 'Pattern suggests significant renal impairment'. The content of the conclusion will vary, depending on the investigation performed. This conclusion should be aligned with the coded 'Test diagnosis'. (en)</items><items id="description">*Narrative description of the key findings. (en)</items><items id="fhir_mapping">*DiagnosticReport.conclusion(en)</items><items id="text">*Conclusion(en)</items></items><items code="at0062"><items id="comment">*Equivalent to the HL7 Placer Order Identifier.(en)</items><items id="description">*The local ID assigned to the test order by the order requester.(en)</items><items id="text">*Requester Order Identifier(en)</items></items><items code="at0063"><items id="comment">*Assigning an identifier to a request by the Laboratory lnformation System (LIS) enables tracking progress of the request and enables linking results to requests. It also provides a reference to assist with enquiries and it is usually equivalent to the HL7 Filler Order Identifier.(en)</items><items id="description">*The local ID assigned to the test order by the order filler, usually by the Laboratory Information System (LIS).(en)</items><items id="text">*Receiver Order Identifier(en)</items></items><items code="at0065"><items id="comment">*If the specimen type is sufficiently specified with a code in the Test name, then this additional data is not required. If there are multiple specimens, these may be represented per 'Result group'.(en)</items><items id="description">*Details about the physical substance that has been analysed, in the situation where all results in this test are derived from the same specimen.(en)</items><items id="text">*Specimen detail(en)</items></items><items code="at0068"><items id="comment">*This identifier is an internal tracking number assigned by the LIS, and it not intended to be the name of the test. (en)</items><items id="description">*A local identifier assigned by the receiving Laboratory Information System (LIS) to track the test process. (en)</items><items id="text">*Laboratory internal identifier(en)</items></items><items code="at0073"><items id="comment">*The values have been specifically chosen to match those in the HL7 FHIR Diagnostic report, historically derived from HL7v2 practice. Other local codes/terms can be used via the Text 'choice'.&#13;
&#13;
This element is multiple occurrence to cater for the use cases where statuses for different aspects of the result have been split into several elements. (en)</items><items id="description">*The status of the laboratory test result as a whole.(en)</items><items id="text">*Overall test status(en)</items></items><items code="at0074"><items id="description">*The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').(en)</items><items id="text">*Cancelled(en)</items></items><items code="at0075"><items id="description">*The date and/or time that ‘Overall test status’ was issued.(en)</items><items id="text">*Overall test status timestamp(en)</items></items><items code="at0077"><items id="comment">*This is intended to be a general categorisation and not to capture the organisational name of the laboratory. For example: anatomical pathology, immunology and transfusion medicine, medical microbiology, clinical pharmacology, medical genetics, medical biochemistry. Alternatively more granular sub categories or sub disciplines, such as endocrinology, haematology, and allergology services, may be used. This may assist clinicians in filtering between categories of results. Coding with a terminology is desirable, where possible.  (en)</items><items id="description">*The diagnostic service or discipline that is responsible for the laboratory test result. (en)</items><items id="text">*Diagnostic service category(en)</items></items><items code="at0090"><items id="description">*Details of the clinician or organisation requesting the laboratory test result.(en)</items><items id="text">*Requester(en)</items></items><items code="at0094"><items id="comment">*In most situations there is one test request and a single corresponding test result, however this repeating cluster allows for the situation where there may be multiple test requests reported using a single test result. As an example: 'a clinician asks for blood glucose in one request and Urea/electrolytes in a second request, but the lab analyser does both and the lab wishes to report these together'.(en)</items><items id="description">*Details about the test request.(en)</items><items id="text">*Test request details(en)</items></items><items code="at0097"><items id="comment">*This SLOT may carry an individual analyte, a group, panel or battery of multiple analytes, or a more complex and specific structure. (en)</items><items id="description">*Results of the test performed on the specimen(s). (en)</items><items id="text">*Test result (en)</items></items><items code="at0098"><items id="comment">*For example: 'Severe hepatic impairment', 'Salmonella contamination'. Coding of the diagnosis with a terminology is strongly recommended, where possible. This diagnosis should be aligned with the narrative in the 'Conclusion'. (en)</items><items id="description">*Single word, phrase or brief description that represents the clinical meaning and significance of the laboratory test result. (en)</items><items id="text">*Test diagnosis(en)</items></items><items code="at0100"><items id="comment">*This data element may include a link to the original clinical information provided in the test request.(en)</items><items id="description">*Description of clinical information available at the time of interpretation of results.(en)</items><items id="fhir_mapping">*DiagnosticReport.requestDetail.clinicalNotes(en)</items><items id="text">*Clinical information provided(en)</items></items><items code="at0101"><items id="description">*Additional narrative about the test result not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0106"><items id="comment">*This data element is to be used when the test requested differs from the test actually performed by the laboratory. (en)</items><items id="description">*Name of the original laboratory test requested. (en)</items><items id="text">*Original test requested name(en)</items></items><items code="at0107"><items id="description">*The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.(en)</items><items id="text">*Registered(en)</items></items><items code="at0110"><items id="comment">*For example: 'details of ELISA/nephelometry'.(en)</items><items id="description">*Structured details about the method of analysis, device or interpretation used.(en)</items><items id="text">*Testing details (en)</items></items><items code="at0111"><items id="comment">*True if the test was performed directly at Point-of-Care (POCT).(en)</items><items id="description">*This indicates whether the test was performed directly at Point-of-Care (POCT) as opposed to a formal result from a laboratory or other service delivery organisation.(en)</items><items id="text">*Point-of-care test(en)</items></items><items code="at0112"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0113"><items id="comment">*'Confounding factors' should be reserved for uncontrolled/unplanned issues of patient state/physiology that might affect interpretation, for example 'recent exercise' or 'recent tobacco smoking'.&#13;
&#13;
Known or required preconditions, such as 'fasting' should be carried in the 'Sampling conditions' element within the CLUSTER.specimen archetype . In some cases preconditions are captured as part of the test name, for example 'Fasting blood glucose'.&#13;
&#13;
Known issues with specimen collection or handling, such as 'prolonged use of tourniquet' or 'sample haemolysed', should be carried in the 'Specimen quality' elements within CLUSTER.specimen archetype.&#13;
&#13;
Coding with a terminology is desirable, where possible.  (en)</items><items id="description">*Issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0114"><items id="comment">*For example: Last Normal Menstrual Period (LNMP). (en)</items><items id="description">*Details of patient state that may alter interpretation of the laboratory test.(en)</items><items id="text">*Structured confounding factors (en)</items></items><items code="at0115"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist. This is a sub-category of 'Amended'.(en)</items><items id="text">*Corrected(en)</items></items><items code="at0116"><items id="description">*The Test Result has been withdrawn following previous Final release.(en)</items><items id="text">*Entered in error(en)</items></items><items code="at0117"><items id="description">*Slot to allow extension to support localisation or alignment with other standards/ reference models.(en)</items><items id="text">*Extension(en)</items></items><items code="at0118"><items id="comment">*Multiple formats are allowed but they should represent equivalent clinical content.(en)</items><items id="description">*Digital image, video or diagram representing the test result.(en)</items><items id="fhir_mapping">*DiagnosticReport.presentedForm(en)</items><items id="text">*Multimedia representation(en)</items></items><items code="at0119"><items id="description">*Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.(en)</items><items id="text">*Appended(en)</items></items><items code="at0120"><items id="description">*Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.(en)</items><items id="text">*Preliminary(en)</items></items><items code="at0121"><items id="comment">*Coding with a terminology is desirable, where possible.  (en)</items><items id="description">*</items><items id="text">*Test method (en)</items></items><items code="at0122"><items id="comment">*For example: Anatomical pathology diagnoses consisting of several different axes such as morphology, etiology and function. (en)</items><items id="description">*A structured or complex diagnosis for the laboratory test. (en)</items><items id="text">*Structured test diagnosis (en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="description">El resultat, incloses les conclusions i la interpretació del laboratori, d'una investigació realitzada amb mostres recollides o relacionades amb una persona.</items><items id="text">Resultat de proves de laboratori</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Esdeveniment predeterminat, no especificat, en un punt del temps o interval que es pot definir explícitament en una plantilla o en temps d'execució.</items><items id="text">Qualsevol esdeveniment</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">El resultat d'una prova pot correspondre a un únic analit o grup d'elements, incloses les proves de panell. Es recomana que "Nom de la prova" es codifiqui amb una terminologia, per exemple LOINC o SNOMED CT. Per exemple: "Glucosa", "Urea i electròlits", "Hisop", "Cortisol (am)", "Potasi en la transpiració" o "Histopatologia del melanoma". El nom pot incloure de vegades el tipus de mostra i l'estat del pacient, per exemple 'Glucosa en sang en dejú' o incloure una altra informació, com 'Potasi (gasometria PNA)'.</items><items id="description">Nom de la investigació de laboratori realitzada a la(es) mostra(s).</items><items id="text">Nom de la prova</items></items><items code="at0017"><items id="comment">Aquest slot està destinat a portar les dades del laboratori que va rebre la sol·licitud i té la responsabilitat general de gestionar la notificació de la prova, encara que altres laboratoris facin aspectes específics.&#13;
&#13;
El laboratori receptor pot fer la prova o remetre-la a un altre laboratori. En cas que un laboratori diferent sigui responsable de fer les proves d'analits específics, s'espera que aquestes dades s'incloguin a l'slot "Detall del resultat de l'analit" de l'arquetip CLUSTER.laboratory_test_analyte.</items><items id="description">Dades del laboratori que ha rebut la sol·licitud i té la responsabilitat general de gestionar la notificació de la prova, encara que altres laboratoris facin aspectes específics.</items><items id="text">Laboratori receptor</items></items><items code="at0035"><items id="comment">La "Llista de distribució" és merament informativa i el destinatari principal de l'informe és la persona destinada a actuar en funció de la informació.</items><items id="description">Detalls de metges o organitzacions addicionals que requereixen una còpia del resultat de la prova.</items><items id="text">Llista de distribució</items></items><items code="at0037"><items id="description">És un resultat parcial (per exemple, inicial, provisional o preliminar): les dades del resultat poden estar incomplets o sense verificar.</items><items id="text">Parcial</items></items><items code="at0038"><items id="description">El resultat de la prova és complet i ha estat verificat per una persona autoritzada.</items><items id="text">Definitiu</items></items><items code="at0040"><items id="description">El resultat ha estat modificat amb posterioritat a ser definitiu, i està complet i verificat pel patòleg responsable, i les dades del resultat han estat modificades.</items><items id="text">Modificat</items></items><items code="at0057"><items id="comment">Per exemple: “El patró suggereix una insuficiència renal significativa”. El contingut de la conclusió variarà en funció de la investigació realitzada. Aquesta conclusió ha de coincidir amb el “Diagnòstic de la prova” codificat.</items><items id="description">Descripció narrativa de les conclusions principals.</items><items id="text">Conclusió</items></items><items code="at0062"><items id="comment">Equivalent al Dipòsit d'identificador d'ordre d'HL7.</items><items id="description">L'identificador local assignat pel sistema clínic sol·licitant.</items><items id="text">Identificador de la comanda del sol·licitant</items></items><items code="at0063"><items id="comment">L'assignació d'un identificador a una sol·licitud per part del Sistema d'Informació de Laboratori (SIL) permet seguir el progrés de la sol·licitud i relacionar els resultats amb les sol·licituds. També proporciona una referència per ajudar amb les consultes i sol ser equivalent a l'identificador HL7 Filler Order Identifier.</items><items id="description">L'identificador local assignat a l'ordre de prova per l'emplenador de l'ordre, normalment pel Sistema d'Informació del Laboratori (SIL).</items><items id="text">Identificador de l'ordre del receptor</items></items><items code="at0065"><items id="comment">Si el tipus de mostra està suficientment especificat amb un codi al nom de la prova, aquestes dades addicionals no són necessàries. La vinculació dels resultats a mostres específiques es pot registrar utilitzant elements de "Identificador de mostra" tant a CLUSTER.specimen com als diferents arquetips CLUSTER de resultats.</items><items id="description">Detalls sobre la substància física analitzada.</items><items id="text">Detalls de la mostra</items></items><items code="at0068"><items id="comment">Aquest identificador és un número de seguiment intern assignat pel SIL, i no vol ser el nom de la prova.</items><items id="description">Identificador local assignat pel sistema d'informació del laboratori receptor (SIL) per seguir el procés de la prova.</items><items id="text">Identificador intern del laboratori</items></items><items code="at0073"><items id="comment">Els valors han estat escollits específicament perquè coincideixin amb els de l'informe HL7 FHIR Diagnostic, derivats històricament de la pràctica HL7v2. Poden utilitzar altres codis/termes locals mitjançant el text "choice".&#13;
&#13;
Aquest element és de ocurrència múltiple per atendre els casos d'ús en què els estats per a diferents aspectes del resultat s'han dividit en diversos elements.</items><items id="description">L'estat del resultat de la prova de laboratori en conjunt.</items><items id="text">Estat general de les proves</items></items><items code="at0074"><items id="description">El resultat no està disponible perquè la prova no s'ha iniciat o no s'ha completat (de vegades també s'anomena “avortada”).</items><items id="text">Cancel·lat</items></items><items code="at0075"><items id="description">La data i/o hora en què es va emetre l'estat general de les proves.</items><items id="text">Registre de temps de l'estat general de la prova</items></items><items code="at0077"><items id="comment">És una categorització general i no del nom organitzatiu del laboratori. Per exemple: anatomia patològica, immunologia i medicina transfusional, microbiologia mèdica, farmacologia clínica, genètica mèdica, bioquímica mèdica. També es poden utilitzar subcategories o subdisciplines més granulars, com ara endocrinologia, hematologia i serveis d'al·lergologia. Això pot ajudar els clínics a filtrar entre categories de resultats. Sempre que sigui possible, és desitjable codificar amb una terminologia.</items><items id="description">El servei o la disciplina de diagnòstic responsable del resultat de la prova de laboratori.</items><items id="text">Especialitat mèdica/clínica</items></items><items code="at0090"><items id="description">Detalls del metge o organització que sol·licita el resultat de la prova de laboratori.</items><items id="text">Sol·licitant</items></items><items code="at0094"><items id="comment">En la majoria de situacions hi ha una sol·licitud de prova i un únic resultat de prova corresponent, però, aquest grup de repetició permet la situació en què hi pot haver diverses sol·licituds de prova notificades utilitzant un únic resultat de prova.&#13;
&#13;
Per exemple: "un clínic sol·licita glucosa en sang en una petició i urea/electròlits en una segona petició, però el tècnic del laboratori realitza totes dues i el laboratori vol notificar-les juntes".</items><items id="description">Detalls sobre la sol·licitud de la prova.</items><items id="text">Detalls de la sol·licitud de la prova</items></items><items code="at0097"><items id="comment">Aquest SLOT pot transportar un analit individual, un grup, panell o bateria de múltiples analits, o una estructura més complexa i específica.</items><items id="description">Resultats de la prova realitzada a la(es) mostra(s).</items><items id="text">Resultat de la prova</items></items><items code="at0098"><items id="comment">Per exemple: 'Insuficiència hepàtica greu', 'Contaminació per Salmonella'. Es recomana encaridament codificar el diagnòstic amb una terminologia, sempre que sigui possible. Aquest diagnòstic ha d'estar alineat amb la informació registrada a la 'Conclusió'.</items><items id="description">Paraula única, frase o breu descripció que representa el significat clínic i la importància del resultat de la prova de laboratori.</items><items id="text">Dignòstic de la prova</items></items><items code="at0100"><items id="comment">Aquest element de dades pot incloure un enllaç a la informació clínica original facilitada a la sol·licitud de prova.</items><items id="description">Descripció de la informació clínica disponible al moment de la interpretació dels resultats.</items><items id="text">Informació clínica facilitada</items></items><items code="at0101"><items id="description">Informació addicional sobre el resultat de la prova no recollida a altres camps.</items><items id="text">Comentaris</items></items><items code="at0106"><items id="comment">Aquesta dada s'utilitza quan la prova sol·licitada difereixi de la prova realment realitzada pel laboratori.</items><items id="description">Nom de la prova de laboratori original sol·licitada.</items><items id="text">Nom de la prova original sol·licitada</items></items><items code="at0107"><items id="description">L'existència de la prova està registrada al Sistema d'Informació del Laboratori, però encara no hi ha res disponible.</items><items id="text">Registrat</items></items><items code="at0110"><items id="comment">Per exemple: 'detalls d'ELISA/nefelometria'.</items><items id="description">Detalls estructurats sobre el mètode danàlisi, dispositiu o interpretació utilitzat.</items><items id="text">Detalls de la prova</items></items><items code="at0111"><items id="comment">'Verdadero' si la prova es va realitzar directament al punt d'atenció.</items><items id="description">Indica si la prova es va fer directament al punt d'atenció (POCT), en contraposició a un resultat formal d'un laboratori o una altra organització de prestació de serveis.</items><items id="text">Prova al punt d'atenció sanitària</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">Els "factors de confusió" s'han de reservar per a qüestions no controlades/no planificades de l'estat/fisiologia del pacient que puguin afectar la interpretació, per exemple "exercici recent" o "tabaquisme recent".&#13;
&#13;
Les condicions prèvies conegudes o requerides, com "dejuni", s'han d'incloure a l'element "Condicions de mostreig" de l'arquetip CLUSTER.specimen. En alguns casos, les condicions prèvies formen part del nom de la prova, per exemple "Glucosa en sang en dejú".&#13;
&#13;
Els problemes coneguts de recollida o manipulació de mostres, com "ús prolongat de torniquet" o "mostra hemolitzada", s'han d'incloure als elements "Qualitat de la mostra" de l'arquetip CLUSTER.specimen.&#13;
&#13;
Sempre que sigui possible, és desitjable codificar amb una terminologia.</items><items id="description">Qüestions o circumstàncies que influeixen en la interpretació exacta del mesurament o del resultat de la prova.</items><items id="text">Factors de confusió</items></items><items code="at0114"><items id="comment">Per exemple: Última menstruació normal (LNMP).</items><items id="description">Detalls dels problemes o circumstàncies que influeixen en la interpretació exacta de la mesura o del resultat de l'assaig.</items><items id="text">Factors de confusió estructurats</items></items><items code="at0115"><items id="description">El resultat ha estat modificat amb posterioritat a ser definitiu, i està complet i verificat pel patòleg responsable. Es tracta d'una subcategoria de "modificat".</items><items id="text">Corregit</items></items><items code="at0116"><items id="description">El resultat de la prova ha estat retirat després de la publicació final anterior.</items><items id="text">Afegit per error</items></items><items code="at0117"><items id="comment">Per exemple: requisits locals d'informació o metadades addicionals per alinear-se amb els equivalents de FHIR o CIMI.</items><items id="description">Informació addicional necessària per captar el contingut local o per alinear-se amb altres models/formalismes de referència.</items><items id="text">Ampliació</items></items><items code="at0118"><items id="comment">Es permeten múltiples formats, però han de representar continguts clínics equivalents.</items><items id="description">Imatge digital, vídeo o diagrama que representa el resultat de la prova.</items><items id="text">Representació multimèdia</items></items><items code="at0119"><items id="description">Després de ser definitiu, l'informe s'ha modificat afegint-hi continguts nous. No s'ha modificat el contingut existent. Es tracta d'una subcategoria de "modificat".</items><items id="text">Annex</items></items><items code="at0120"><items id="description">Es disposen de resultats preliminars verificats, però no tots els resultats són definitius. Es tracta d'una subcategoria de “Parcial”.</items><items id="text">Preliminar</items></items><items code="at0121"><items id="comment">Sempre que sigui possible, és desitjable codificar amb una terminologia.</items><items id="description">Descripció sobre el mètode utilitzat per fer la prova.</items><items id="text">Mètode de prova</items></items><items code="at0122"><items id="comment">Per exemple: Diagnòstics anatomopatològics que consten de diversos eixos diferents, com ara la morfologia, l'etiologia i la funció.</items><items id="description">Un diagnòstic estructurat o complex per a la prova de laboratori.</items><items id="text">Diagnòstic de prova estructurat</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="description">Das Ergebnis - einschließlich der Befunde und der Interpretation des Labors - einer Untersuchung, die an Proben durchgeführt wurde, die von einer Einzelperson stammen oder mit dieser Person zusammenhängen.</items><items id="text">Laborergebnis</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Jeder Zeitpunkt oder jedes Intervall, das in einem Template oder zur Laufzeit definiert werden kann.</items><items id="text">Jedes Ereignis</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">Ein Laborergebnis kann sich auf ein einzelnes Analyt oder eine Analytgruppe beziehen. Dazu zählen auch komplette Panel an Parametern. &#13;
Es wird dringend empfohlen, die "Labortest-Bezeichnung" anhand einer Terminologie zu kodiereren, wie zum Beispiel LOINC oder SNOMED CT. Beispiel: "Glukose", "Harnstoff", "Abstrich", "Cortisol", "Leberbiopsie". Der Name kann u.U. auch das Probenmaterial oder den Patientenstatus (z.B. "Blutzuckerspiegel nüchtern") oder andere Informationen beinhalten wie "Kalium (Blutgas)".</items><items id="description">Name der Laboruntersuchung, die an der/den Probe(n) durchgeführt wurde.</items><items id="text">Labortest-Bezeichnung</items></items><items code="at0017"><items id="comment">Dieser Slot gibt die Details des Labors an, dass die Anforderung erhalten hat und die Gesamtverantwortung für die Berichterstellung des Tests trägt, selbst wenn andere Labore bestimmte Aspekte ausführen.&#13;
&#13;
Das Empfangslabor kann den Test entweder durchführen oder an ein anderes Labor verweisen. Wenn ein anderes Labor für die Durchführung der Tests mit bestimmten Analyten zuständig ist, ist zu erwarten, dass diese Details im SLOT 'Analyte result detail' innerhalb des Archetyps CLUSTER.laboratory_test_analyte enthalten sind.</items><items id="description">Angaben zu dem Labor, das die Anfrage erhalten hat und die Hauptverantwortung für die Verwaltung der Berichterstattung über den Test trägt, auch wenn andere Labore bestimmte Aspekte ausführen.</items><items id="text">Labor, welches den Untersuchungsauftrag annimmt</items></items><items code="at0035"><items id="comment">Die "Verteilerliste" dient nur zu Informationszwecken. Der Hauptempfänger des Berichts ist die Person, die dazu bestimmt ist, auf die Information zu reagieren.</items><items id="description">Details über weitere Kliniker oder Organisationen, die eine Kopie der Analyseergebnisse benötigen.</items><items id="text">Verteilerliste</items></items><items code="at0037"><items id="description">Das Testergebnis ist als ein Teilergebnis (z.B. Initial, vorübergehend oder vorläufig) bestätigt: Daten im Testergebnis können unvollständig oder nicht verifiziert sein.</items><items id="text">Teilweise</items></items><items code="at0038"><items id="description">Das Testergebnis ist vollständig und durch eine autorisierte Person bestätigt.</items><items id="text">Final</items></items><items code="at0040"><items id="description">Das Ergebnis wurde nach der Finalisierung modifiziert und ist vollständig von dem verantwortlichen Untersucher verifiziert. Die Ergebnisdaten wurden geändert.</items><items id="text">Abgeändert</items></items><items code="at0057"><items id="comment">Zum Beispiel: "Das Muster lässt auf eine erhebliche Nierenfunktionsstörung schließen". Der Inhalt der Zusammenfassung unterscheidet sich je nach durchgeführter Untersuchung. Diese Zusammenfassung sollte mit der kodierten "Testdiagnose" übereinstimmen.</items><items id="description">Beschreibung der wichtigsten Ergebnisse.</items><items id="text">Schlussfolgerung</items></items><items code="at0062"><items id="comment">Äquivalent zur "HL7 Placer Order Identifier".</items><items id="description">Lokale Auftrags-ID des anfordernden/einsendenden Systems.</items><items id="text">Auftrags-ID des anfordernden/einsendenden Systems</items></items><items code="at0063"><items id="comment">Die Vergabe einer solchen ID ermöglicht das Nachverfolgen des Auftragsstatus und das Verlinken der Ergebnisse zum Auftrag. Es erlaubt auch das Verwalten von weiteren Erkundigungen und Nachfragen und ist äquivalent zum "HL7 Filler Order Identifier".</items><items id="description">Lokale Auftrags-ID, die vom auftragsempfangendem System, gewöhnlich dem Laborinformationssystem (LIS) zugewiesen wird.</items><items id="text">Auftrags-ID (Empfänger)</items></items><items code="at0065"><items id="comment">Wenn der Probentyp mit einem Code in der Testbezeichnung ausreichend spezifiziert ist, sind diese zusätzlichen Daten nicht erforderlich. Die Verknüpfung von Ergebnissen mit bestimmten Proben kann sowohl in einem CLUSTER.Probe als auch in den verschiedenen CLUSTER Archetypen mit Hilfe von Elementen mit der Bezeichnung "Probe" dokumentiert werden.&#13;
</items><items id="description">Angaben über die Beschaffenheit der analysierten Probe.</items><items id="text">Probendetail</items></items><items code="at0068"><items id="comment">Diese Kennung ist eine vom LIS vergebene interne Trackingnummer und ist nicht als Bezeichnung für den Test gedacht.</items><items id="description">Eine lokale Kennung, die vom empfangenden Laborinformationssystem (LIS) vergeben wird, um den Testvorgang zu verfolgen.</items><items id="text">Laborinterne Kennzeichnung</items></items><items code="at0073"><items id="comment">Die Werte wurden so ausgewählt, dass sie mit denen im HL7 FHIR Diagnosebericht übereinstimmen, der historisch aus der HL7v2Praxis stammt. Andere lokale Codes/Begriffe können über den Text "Auswahl" verwendet werden. &#13;
&#13;
Dieses Element kann mehrfach vorkommen, um Fälle abzudecken, bei denen der Status für verschiedene Aspekte des Ergebnisses in mehrere Elemente unterteilt wurde.&#13;
</items><items id="description">Der Status des gesamten Laborprüfergebnisses.</items><items id="text">Gesamtteststatus</items></items><items code="at0074"><items id="description">Das Ergebnis ist nicht verfügbar, weil der Test nicht gestartet oder nicht abgeschlossen wurde (manchmal auch als "gescheitert" bezeichnet).</items><items id="text">Abgebrochen</items></items><items code="at0075"><items id="description">Zeitpunkt an dem das Ergebnis für den oben genannten "Gesamtteststatus" ausgegeben wurde.</items><items id="text">Zeitstempel des gesamten Teststatus</items></items><items code="at0077"><items id="comment">Dies soll eine allgemeine Kategorisierung sein und nicht den organisatorischen Namen des Labors erfassen. Zum Beispiel anatomische Pathologie, Immunologie und Transfusionsmedizin, medizinische Mikrobiologie, klinische Pharmakologie, medizinische Genetik, medizinische Biochemie. Alternativ noch granuläre Subkategorien, wie z.B. Hormone/Endokrinologie, Hämatologie, Autoantikörper, Allergologie. Diese Datenelemente helfen bei der Filterung nach breiten Kategorien von Ergebnissen gemäß den lokalen Gegebenheiten. Dieses Datenelement sollte, wenn möglich, mit einer Terminologie kodiert werden.</items><items id="description">Die diagnostische Organisationseinheit oder die Labordisziplin, die für das Laborergebnis verantwortlich ist.</items><items id="text">Diagnostische Organisationseinheit</items></items><items code="at0090"><items id="description">Details über den Kliniker oder die Abteilung, die das Labortestergebnis angefordert hat.</items><items id="text">Einsender</items></items><items code="at0094"><items id="comment">In den meisten Fällen gibt es eine Testanfrage und ein einzelnes entsprechendes Testergebnis. Jedoch ermöglicht dieser wiederholte Cluster die Situation, dass mehrere Testanfragen mit einem einzigen Testergebnis gemeldet werden können.&#13;
&#13;
Als Beispiel: "Ein Arzt fordert in einer Anfrage Blutzucker und in einer zweiten Anfrage Harnstoff/Elektrolyte an, aber das Laboranalysegerät führt beides durch und das Labor möchte diese zusammen melden".</items><items id="description">Details zur Testanforderung.</items><items id="text">Details der Testanforderung</items></items><items code="at0097"><items id="comment">Dieser SLOT kann einen einzelnen Analyt, eine Gruppe, ein Panel oder eine Reihe von mehreren Analyten oder eine komplexere und spezifischere Struktur tragen.</items><items id="description">Ergebnisse der durchgeführten Untersuchungen an der/den Probe(n).</items><items id="text">Testergebnis</items></items><items code="at0098"><items id="comment">Zum Beispiel: "Schwere hepatische Beeinträchtigung", "Salmonellenbefall". Die Kodierung der Diagnose mit einer Terminologie, wird nach Möglichkeit dringend empfohlen. Die Diagnose soll zu der Beschreibung im Datenelement "Zusammenfassung" passen.</items><items id="description">Kurze Beschreibung der klinischen Bedeutung und der Aussagekraft des Laborergebnisses.</items><items id="text">Testdiagnose</items></items><items code="at0100"><items id="comment">Dieses Datenelement kann einen Link zu den ursprünglichen klinischen Informationen enthalten, die in der Testanforderung angegeben sind.</items><items id="description">Beschreibung der klinischen Informationen, die zum Zeitpunkt der Auswertung der Ergebnisse verfügbar sind.</items><items id="text">Vorhandene klinische Information</items></items><items code="at0101"><items id="description">Weitere Informationen über das Laborergebnis, welche bisher nicht in den anderen Feldern erfasst wurden.</items><items id="text">Kommentar</items></items><items code="at0106"><items id="comment">Dieses Datenelement ist zu verwenden, wenn die angeforderte Testung von der tatsächlich vom Labor durchgeführten Testung abweicht.</items><items id="description">Name des ursprünglich angeforderten Tests.</items><items id="text">Originaler Name der angeforderten Testung</items></items><items code="at0107"><items id="description">Der Labortest wurde im Laborinformationssystem registriert, aber es ist derzeit noch nichts verfügbar.</items><items id="text">Registriert</items></items><items code="at0110"><items id="comment">Zum Beispiel: "Details der ELISA/Nephelometrie".</items><items id="description">Strukturierte Details über die beim Labortest verwendete Methodik, das Gerät oder die Auswertung.</items><items id="text">Test Details</items></items><items code="at0111"><items id="comment">Wahr, wenn der Test direkt am Point-of-Care (POCT) durchgeführt wurde.</items><items id="description">Dies gibt an, ob der Test direkt am Point-of-Care (POCT) durchgeführt wurde, im Gegensatz zu einem formalen Ergebnis eines Labors oder einer anderen Dienstleistungsorganisation.</items><items id="text">Point-of-care Test</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">"Störfaktoren", die die Interpretation beeinflussen könnten wie z.B. "kürzliches Training" oder "neuer Tabakkonsum" sollten für unkontrollierte/ungeplante Probleme des Patientenzustands/ der Physiologie vorgesehen werden.&#13;
&#13;
Bekannte oder erforderliche Voraussetzungen, wie z.B. "Fasten", sollten im Element "Probenbedingungen" innerhalb des CLUSTER.Probe-Archetyps aufgeführt werden. In einigen Fällen werden Voraussetzungen als Teil des Testnamens erfasst, z.B. "Nüchternblutzucker".&#13;
&#13;
Bekannte Schwierigkeiten bei der Probenentnahme oder -behandlung, wie z.B. die "verlängerte Anwendung von Tourniquet" oder "hämolysierte Probe", sollten in den Elementen "Probenqualität" innerhalb des CLUSTER.Probe-Archetyps aufgeführt werden.</items><items id="description">Probleme oder Umstände, die sich auf die genaue Interpretation der Messung oder des Testergebnisses auswirken.</items><items id="text">Störfaktoren</items></items><items code="at0114"><items id="comment">Zum Beispiel: Letzte normale Menstruationsperiode (LNMP).</items><items id="description">Einzelheiten zu Problemen oder Umständen, die sich auf die genaue Interpretation der Messung oder des Prüfergebnisses auswirken.</items><items id="text">Strukturierte Erfassung der Störfaktoren</items></items><items code="at0115"><items id="description">Das Ergebnis wurde nach der Finalisierung modifiziert und ist vollständig vom verantwortlichen Untersucher verifiziert. Dies ist eine Unterkategorie von "Abgeändert".</items><items id="text">Korrigiert</items></items><items code="at0116"><items id="description">Das Testergebnis wurde nach der vorherigen Endfreigabe zurückgezogen.</items><items id="text">Irrtümlich eingegeben</items></items><items code="at0117"><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten, um ein Mapping auf FHIR oder CIMI Modelle zu ermöglichen.</items><items id="description">Weitere Informationen, die erforderlich sind, um lokale Inhalte abzubilden oder das Modell an andere Referenzmodelle anzupassen.</items><items id="text">Erweiterung</items></items><items code="at0118"><items id="comment">Mehrere Formate sind erlaubt - diese sollten aber einen äquivalenten klinischen Inhalt darstellen.</items><items id="description">Bild, Video oder Diagramm zur Visualisierung des Testergebnisses.</items><items id="text">Multimedia-Darstellung</items></items><items code="at0119"><items id="description">Nach der endgültigen Fassung wurde der Bericht durch Hinzufügen neuer Inhalte aktualisiert. Der bestehende Inhalt bleibt unverändert. Dies ist eine Unterkategorie von "Abgeändert".</items><items id="text">Hinzugefügt</items></items><items code="at0120"><items id="description">Es sind erste, bestätigte Ergebnisse verfügbar, aber nicht alle Ergebnisse sind final. Dies ist eine Unterkategorie von "Teilweise".</items><items id="text">Vorläufig</items></items><items code="at0121"><items id="comment">Wenn möglich, ist eine Kodierung mit einer Terminologie wünschenswert.</items><items id="description">Die Beschreibung der Methode, mit dem der Test durchgeführt wurde.</items><items id="text">Testmethode</items></items><items code="at0122"><items id="comment">Zum Beispiel: Anatomische Pathologiediagnosen, die aus mehreren verschiedenen Schwerpunkten wie Morphologie, Ätiologie und Funktion zusammengesetzt sind.</items><items id="description">Eine strukturierte oder komplexe Diagnose für die Laboruntersuchung.</items><items id="text">Strukturierte Testdiagnostik</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">The result, including findings and the laboratory's interpretation, of an investigation performed on specimens collected from an individual or related to that individual.</items><items id="text">Laboratory test result</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items><items id="text">Any event</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">A test result may be for a single analyte, or a group of items, including panel tests. It is strongly recommended that 'Test name' be coded with a terminology, for example LOINC or SNOMED CT. For example: 'Glucose', 'Urea and Electrolytes', 'Swab', 'Cortisol (am)', 'Potassium in perspiration' or 'Melanoma histopathology'. The name may sometimes include specimen type and patient state, for example 'Fasting blood glucose' or include other information, as 'Potassium (PNA blood gas)'.</items><items id="description">Name of the laboratory investigation performed on the specimen(s).</items><items id="text">Test name</items></items><items code="at0017"><items id="comment">This slot is intended to carry details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.&#13;
&#13;
The receiving laboratory may either perform the test or refer it to another laboratory. Where a different laboratory is responsible for performing the testing on specific analytes, it would be expected that these details would be carried in the 'Analyte result detail' SLOT within the CLUSTER.laboratory_test_analyte archetype.&#13;
&#13;
</items><items id="description">Details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.</items><items id="text">Receiving laboratory</items></items><items code="at0035"><items id="comment">The 'Distribution list' is for information-only, and that the primary recipient of the report is the person intended to act on the information.</items><items id="description">Details of additional clinicians or organisations who require a copy of the test result.</items><items id="text">Distribution list</items></items><items code="at0037"><items id="description">This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.</items><items id="text">Partial</items></items><items code="at0038"><items id="description">The Test result is complete and verified by an authorised person.</items><items id="text">Final</items></items><items code="at0040"><items id="description">The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist, and result data has been changed.</items><items id="text">Amended</items></items><items code="at0057"><items id="comment">For example: 'Pattern suggests significant renal impairment'. The content of the conclusion will vary, depending on the investigation performed. This conclusion should be aligned with the coded 'Test diagnosis'.</items><items id="description">Narrative description of the key findings.</items><items id="text">Conclusion</items></items><items code="at0062"><items id="comment">Equivalent to the HL7 Placer Order Identifier.</items><items id="description">The local identifier assigned by the requesting clinical system.</items><items id="text">Requester order identifier</items></items><items code="at0063"><items id="comment">Assigning an identifier to a request by the Laboratory lnformation System (LIS) enables tracking progress of the request and enables linking results to requests. It also provides a reference to assist with enquiries and it is usually equivalent to the HL7 Filler Order Identifier.</items><items id="description">The local identifier assigned to the test order by the order filler, usually by the Laboratory Information System (LIS).</items><items id="text">Receiver order identifier</items></items><items code="at0065"><items id="comment">If the specimen type is sufficiently specified with a code in the Test name, then this additional data is not required. Linking results to specific specimens may be recorded using 'Specimen identifier' elements in both the CLUSTER.specimen and the various results CLUSTER archetypes.</items><items id="description">Details about the physical substance that has been analysed.</items><items id="text">Specimen detail</items></items><items code="at0068"><items id="comment">This identifier is an internal tracking number assigned by the LIS, and it not intended to be the name of the test.</items><items id="description">A local identifier assigned by the receiving Laboratory Information System (LIS) to track the test process.</items><items id="text">Laboratory internal identifier</items></items><items code="at0073"><items id="comment">The values have been specifically chosen to match those in the HL7 FHIR Diagnostic report, historically derived from HL7v2 practice. Other local codes/terms can be used via the Text 'choice'.&#13;
&#13;
This element is multiple occurrence to cater for the use cases where statuses for different aspects of the result have been split into several elements.</items><items id="description">The status of the laboratory test result as a whole.</items><items id="text">Overall test status</items></items><items code="at0074"><items id="description">The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').</items><items id="text">Cancelled</items></items><items code="at0075"><items id="description">The date and/or time that ‘Overall test status’ was issued.</items><items id="text">Overall test status timestamp</items></items><items code="at0077"><items id="comment">This is intended to be a general categorisation and not to capture the organisational name of the laboratory. For example: anatomical pathology, immunology and transfusion medicine, medical microbiology, clinical pharmacology, medical genetics, medical biochemistry. Alternatively more granular sub categories or sub disciplines, such as endocrinology, haematology, and allergology services, may be used. This may assist clinicians in filtering between categories of results. Coding with a terminology is desirable, where possible.</items><items id="description">The diagnostic service or discipline that is responsible for the laboratory test result.</items><items id="text">Diagnostic service category</items></items><items code="at0090"><items id="description">Details of the clinician or organisation requesting the laboratory test result.</items><items id="text">Requester</items></items><items code="at0094"><items id="comment">In most situations there is one test request and a single corresponding test result, however this repeating cluster allows for the situation where there may be multiple test requests reported using a single test result.&#13;
&#13;
As an example: 'a clinician asks for blood glucose in one request and Urea/electrolytes in a second request, but the lab analyser does both and the lab wishes to report these together'.</items><items id="description">Details about the test request.</items><items id="text">Test request details</items></items><items code="at0097"><items id="comment">This SLOT may carry an individual analyte, a group, panel or battery of multiple analytes, or a more complex and specific structure.</items><items id="description">Results of the test performed on the specimen(s).</items><items id="text">Test result</items></items><items code="at0098"><items id="comment">For example: 'Severe hepatic impairment', 'Salmonella contamination'. Coding of the diagnosis with a terminology is strongly recommended, where possible. This diagnosis should be aligned with the narrative in the 'Conclusion'.</items><items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the laboratory test result.</items><items id="text">Test diagnosis</items></items><items code="at0100"><items id="comment">This data element may include a link to the original clinical information provided in the test request.</items><items id="description">Description of clinical information available at the time of interpretation of results.</items><items id="text">Clinical information provided</items></items><items code="at0101"><items id="description">Additional narrative about the test result not captured in other fields.</items><items id="text">Comment</items></items><items code="at0106"><items id="comment">This data element is to be used when the test requested differs from the test actually performed by the laboratory.</items><items id="description">Name of the original laboratory test requested.</items><items id="text">Original test requested name</items></items><items code="at0107"><items id="description">The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.</items><items id="text">Registered</items></items><items code="at0110"><items id="comment">For example: 'details of ELISA/nephelometry'.</items><items id="description">Structured details about the method of analysis, device or interpretation used.</items><items id="text">Testing details</items></items><items code="at0111"><items id="comment">True if the test was performed directly at Point-of-Care (POCT).</items><items id="description">This indicates whether the test was performed directly at Point-of-Care (POCT) as opposed to a formal result from a laboratory or other service delivery organisation.</items><items id="text">Point-of-care test</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">'Confounding factors' should be reserved for uncontrolled/unplanned issues of patient state/physiology that might affect interpretation, for example 'recent exercise' or 'recent tobacco smoking'.&#13;
&#13;
Known or required preconditions, such as 'fasting' should be carried in the 'Sampling conditions' element within the CLUSTER.specimen archetype . In some cases preconditions are captured as part of the test name, for example 'Fasting blood glucose'.&#13;
&#13;
Known issues with specimen collection or handling, such as 'prolonged use of tourniquet' or 'sample haemolysed', should be carried in the 'Specimen quality' elements within CLUSTER.specimen archetype.&#13;
&#13;
Coding with a terminology is desirable, where possible.</items><items id="description">Issues or circumstances that impact on the accurate interpretation of the measurement or test result.</items><items id="text">Confounding factors</items></items><items code="at0114"><items id="comment">For example: Last Normal Menstrual Period (LNMP).</items><items id="description">Details of issues or circumstances that impact on the accurate interpretation of the measurement or test result.</items><items id="text">Structured confounding factors</items></items><items code="at0115"><items id="description">The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist. This is a sub-category of 'Amended'.</items><items id="text">Corrected</items></items><items code="at0116"><items id="description">The Test Result has been withdrawn following previous Final release.</items><items id="text">Entered in error</items></items><items code="at0117"><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></items><items code="at0118"><items id="comment">Multiple formats are allowed but they should represent equivalent clinical content.</items><items id="description">Digital image, video or diagram representing the test result.</items><items id="text">Multimedia representation</items></items><items code="at0119"><items id="description">Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.</items><items id="text">Appended</items></items><items code="at0120"><items id="description">Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.</items><items id="text">Preliminary</items></items><items code="at0121"><items id="comment">Coding with a terminology is desirable, where possible.</items><items id="description">Description about the method used to perform the test.</items><items id="text">Test method</items></items><items code="at0122"><items id="comment">For example: Anatomical pathology diagnoses consisting of several different axes such as morphology, etiology and function.</items><items id="description">A structured or complex diagnosis for the laboratory test.</items><items id="text">Structured test diagnosis</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="description">El resultado, incluidas las conclusiones y la interpretación del laboratorio, de una investigación realizada con muestras recogidas de una persona o relacionadas con ella.</items><items id="text">Resultado de pruebas de laboratorio</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Evento predeterminado, no especificado, en un punto del tiempo o intervalo que puede definirse explícitamente en una plantilla o en tiempo de ejecución.</items><items id="text">Cualquier evento</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">El resultado de una prueba puede corresponder a un único analito o a un grupo de elementos, incluidas las pruebas de panel. Se recomienda encarecidamente que "Nombre de la prueba" se codifique con una terminología, por ejemplo LOINC o SNOMED CT. Por ejemplo: "Glucosa", "Urea y electrolitos", "Hisopo", "Cortisol (am)", "Potasio en la transpiración" o "Histopatología del melanoma". El nombre puede incluir a veces el tipo de muestra y el estado del paciente, por ejemplo 'Glucosa en sangre en ayunas' o incluir otra información, como 'Potasio (gasometría PNA)'.</items><items id="description">Nombre de la investigación de laboratorio realizada en la(s) muestra(s).</items><items id="text">Nombre de la prueba</items></items><items code="at0017"><items id="comment">Este slot está destinado a llevar los datos del laboratorio que recibió la solicitud y tiene la responsabilidad general de gestionar la notificación de la prueba, aunque otros laboratorios realicen aspectos específicos.&#13;
&#13;
El laboratorio receptor puede realizar la prueba o remitirla a otro laboratorio. En caso de que un laboratorio diferente sea responsable de realizar las pruebas de analitos específicos, se espera que estos datos se incluyan en el slot "Detalle del resultado del analito" del arquetipo CLUSTER.laboratory_test_analyte.</items><items id="description">Datos del laboratorio que ha recibido la solicitud y tiene la responsabilidad general de gestionar la notificación de la prueba, aunque otros laboratorios realicen aspectos específicos.</items><items id="text">Laboratorio receptor</items></items><items code="at0035"><items id="comment">La "Lista de distribución" es meramente informativa, y el destinatario principal del informe es la persona destinada a actuar en función de la información.</items><items id="description">Datos de otros médicos u organizaciones que necesiten una copia del resultado de la prueba.</items><items id="text">Lista de distribución</items></items><items code="at0037"><items id="description">Se trata de un resultado parcial (por ejemplo, inicial, provisional o preliminar): los datos del resultado pueden estar incompletos o sin verificar.</items><items id="text">Parcial</items></items><items code="at0038"><items id="description">El resultado de la prueba está completo y ha sido verificado por una persona autorizada.</items><items id="text">Definitivo</items></items><items code="at0040"><items id="description">El resultado ha sido modificado con posterioridad a ser Definitivo, y está completo y verificado por el patólogo responsable, y los datos del resultado han sido modificados.</items><items id="text">Modificado</items></items><items code="at0057"><items id="comment">Por ejemplo: "El patrón sugiere una insuficiencia renal significativa". El contenido de la conclusión variará en función de la investigación realizada. Esta conclusión debe coincidir con el "Diagnóstico de la prueba" codificado.</items><items id="description">Descripción narrativa de las principales conclusiones.</items><items id="text">Conclusión</items></items><items code="at0062"><items id="comment">Equivalente al Depósito de Identificador de Orden de HL7.</items><items id="description">El identificador local asignado por el sistema clínico solicitante.</items><items id="text">Identificador del pedido del solicitante</items></items><items code="at0063"><items id="comment">La asignación de un identificador a una solicitud por parte del Sistema de Información de Laboratorio (SIL) permite seguir el progreso de la solicitud y relacionar los resultados con las solicitudes. También proporciona una referencia para ayudar con las consultas y suele ser equivalente al identificador HL7 Filler Order Identifier.</items><items id="description">El identificador local asignado a la orden de prueba por el cumplimentador de la orden, normalmente por el Sistema de Información del Laboratorio (SIL).</items><items id="text">Identificador de la orden del receptor</items></items><items code="at0065"><items id="comment">Si el tipo de muestra está suficientemente especificado con un código en el nombre de la prueba, estos datos adicionales no son necesarios. La vinculación de los resultados a muestras específicas puede registrarse utilizando elementos de "Identificador de muestra" tanto en CLUSTER.specimen como en los distintos arquetipos CLUSTER de resultados.</items><items id="description">Datos sobre la sustancia física analizada.</items><items id="text">Detalles de la muestra</items></items><items code="at0068"><items id="comment">Este identificador es un número de seguimiento interno asignado por el SIL, y no pretende ser el nombre de la prueba.</items><items id="description">Identificador local asignado por el Sistema de Información del Laboratorio receptor (SIL) para seguir el proceso de la prueba.</items><items id="text">Identificador interno del laboratorio</items></items><items code="at0073"><items id="comment">&#13;
Los valores se han elegido específicamente para que coincidan con los del informe HL7 FHIR Diagnostic, derivados históricamente de la práctica HL7v2. Pueden utilizarse otros códigos/términos locales mediante el texto "choice".&#13;
&#13;
Este elemento es de ocurrencia múltiple para atender a los casos de uso en los que los estados para diferentes aspectos del resultado se han dividido en varios elementos.</items><items id="description">El estado del resultado de la prueba de laboratorio en su conjunto.</items><items id="text">Estado general de las pruebas</items></items><items code="at0074"><items id="description">El resultado no está disponible porque la prueba no se ha iniciado o no se ha completado (a veces también se denomina "abortada").</items><items id="text">Cancelado</items></items><items code="at0075"><items id="description">La fecha y/o la hora en que se emitió el "Estado general de las pruebas".</items><items id="text">Registro de tiempo del estado general de la prueba</items></items><items code="at0077"><items id="comment">Se trata de una categorización general y no del nombre organizativo del laboratorio. Por ejemplo: anatomía patológica, inmunología y medicina transfusional, microbiología médica, farmacología clínica, genética médica, bioquímica médica. También pueden utilizarse subcategorías o subdisciplinas más granulares, como endocrinología, hematología y servicios de alergología. Esto puede ayudar a los clínicos a filtrar entre categorías de resultados. Siempre que sea posible, es deseable codificar con una terminología.</items><items id="description">El servicio o disciplina de diagnóstico responsable del resultado de la prueba de laboratorio.</items><items id="text">Especialidad médica/clínica</items></items><items code="at0090"><items id="description">Datos del clínico u organización que solicita el resultado de la prueba de laboratorio.</items><items id="text">Solicitante</items></items><items code="at0094"><items id="comment">En la mayoría de las situaciones hay una solicitud de prueba y un único resultado de prueba correspondiente, sin embargo, este grupo de repetición permite la situación en la que puede haber varias solicitudes de prueba notificadas utilizando un único resultado de prueba.&#13;
&#13;
Por ejemplo: "un clínico solicita glucosa en sangre en una petición y urea/electrolitos en una segunda petición, pero el técnico del laboratorio realiza ambas y el laboratorio desea notificarlas juntas".</items><items id="description">Detalles sobre la solicitud de la prueba.</items><items id="text">Detalles de la solicitud de la prueba</items></items><items code="at0097"><items id="comment">Este SLOT puede transportar un analito individual, un grupo, panel o batería de múltiples analitos, o una estructura más compleja y específica.</items><items id="description">Resultados de la prueba realizada en la(s) muestra(s).</items><items id="text">Resultado de la prueba</items></items><items code="at0098"><items id="comment">Por ejemplo: 'Insuficiencia hepática grave', 'Contaminación por Salmonella'. Se recomienda encarecidamente codificar el diagnóstico con una terminología, siempre que sea posible. Este diagnóstico debe estar alineado con la información registrada en la 'Conclusión'.</items><items id="description">Palabra única, frase o breve descripción que representa el significado clínico y la importancia del resultado de la prueba de laboratorio.</items><items id="text">Dignóstico de la prueba</items></items><items code="at0100"><items id="comment">Este elemento de datos puede incluir un enlace a la información clínica original facilitada en la solicitud de prueba.</items><items id="description">Descripción de la información clínica disponible en el momento de la interpretación de los resultados.</items><items id="text">Información clínica facilitada</items></items><items code="at0101"><items id="description">Información adicional sobre el resultado de la prueba no recogida en otros campos.</items><items id="text">Comentarios</items></items><items code="at0106"><items id="comment">Este dato se utilizará cuando la prueba solicitada difiera de la prueba realmente realizada por el laboratorio.</items><items id="description">Nombre de la prueba de laboratorio original solicitada.</items><items id="text">Nombre de la prueba original solicitada</items></items><items code="at0107"><items id="description">La existencia de la prueba está registrada en el Sistema de Información del Laboratorio, pero aún no hay nada disponible.</items><items id="text">Registrado</items></items><items code="at0110"><items id="comment">Por ejemplo: 'detalles de ELISA/nefelometría'.</items><items id="description">Detalles estructurados sobre el método de análisis, dispositivo o interpretación utilizado.</items><items id="text">Detalles de la prueba</items></items><items code="at0111"><items id="comment">Verdadero si la prueba se realizó directamente en el punto de atención (POCT).</items><items id="description">Indica si la prueba se realizó directamente en el punto de atención (POCT), en contraposición a un resultado formal de un laboratorio u otra organización de prestación de servicios.</items><items id="text">Prueba en el punto de atención sanitaria</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">Los "factores de confusión" deben reservarse para cuestiones no controladas/no planificadas del estado/fisiología del paciente que puedan afectar a la interpretación, por ejemplo "ejercicio reciente" o "tabaquismo reciente".&#13;
&#13;
Las condiciones previas conocidas o requeridas, como "ayuno", deben incluirse en el elemento "Condiciones de muestreo" del arquetipo CLUSTER.specimen. En algunos casos, las condiciones previas forman parte del nombre de la prueba, por ejemplo "Glucosa en sangre en ayunas".&#13;
&#13;
Los problemas conocidos de recogida o manipulación de muestras, como "uso prolongado de torniquete" o "muestra hemolizada", deben incluirse en los elementos "Calidad de la muestra" del arquetipo CLUSTER.specimen.&#13;
&#13;
Siempre que sea posible, es deseable codificar con una terminología.</items><items id="description">Cuestiones o circunstancias que influyen en la interpretación exacta de la medición o del resultado de la prueba.</items><items id="text">Factores de confusión</items></items><items code="at0114"><items id="comment">Por ejemplo: Última menstruación normal (LNMP).</items><items id="description">Detalles de los problemas o circunstancias que influyen en la interpretación exacta de la medición o del resultado del ensayo.</items><items id="text">Factores de confusión estructurados</items></items><items code="at0115"><items id="description">El resultado ha sido modificado con posterioridad a ser Definitivo, y está completo y verificado por el patólogo responsable. Se trata de una subcategoría de "Modificado".</items><items id="text">Corregida</items></items><items code="at0116"><items id="description">El resultado de la prueba se ha retirado tras la publicación final anterior.</items><items id="text">Añadido por error</items></items><items code="at0117"><items id="comment">Por ejemplo: requisitos locales de información o metadatos adicionales para alinearse con los equivalentes de FHIR o CIMI.</items><items id="description">Información adicional necesaria para captar el contenido local o para alinearse con otros modelos/formalismos de referencia.</items><items id="text">Ampliación</items></items><items code="at0118"><items id="comment">Se permiten múltiples formatos, pero deben representar contenidos clínicos equivalentes.</items><items id="description">Imagen digital, vídeo o diagrama que representa el resultado de la prueba.</items><items id="text">Representación multimedia</items></items><items code="at0119"><items id="description">Tras ser definitivo, el informe se ha modificado añadiendo nuevos contenidos. El contenido existente no se ha modificado. Se trata de una subcategoría de "Modificado".</items><items id="text">Anexo</items></items><items code="at0120"><items id="description">Se dispone de resultados preliminares verificados, pero no todos los resultados son definitivos. Se trata de una subcategoría de "Parcial".</items><items id="text">Preliminar</items></items><items code="at0121"><items id="comment">En la medida de lo posible, es deseable codificar con una terminología.</items><items id="description">Descripción del método utilizado para realizar la prueba.</items><items id="text">Método de prueba</items></items><items code="at0122"><items id="comment">Por ejemplo: Diagnósticos anatomopatológicos que constan de varios ejes diferentes, como la morfología, la etiología y la función.</items><items id="description">Un diagnóstico estructurado o complejo para la prueba de laboratorio.</items><items id="text">Diagnóstico de prueba estructurado</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="description">*The result, including findings and the laboratory's interpretation, of an investigation performed on specimens collected from an individual or related to that individual.(en)</items><items id="text">Laboratoriokokeen tulos</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">Mikä tahansa tapahtuma</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">*A test result may be for a single analyte, or a group of items, including panel tests. It is strongly recommended that 'Test name' be coded with a terminology, for example LOINC or SNOMED CT. For example: 'Glucose', 'Urea and Electrolytes', 'Swab', 'Cortisol (am)', 'Potassium in perspiration' or 'Melanoma histopathology'. The name may sometimes include specimen type and patient state, for example 'Fasting blood glucose' or include other information, as 'Potassium (PNA blood gas)'.(en)</items><items id="description">*Name of the laboratory investigation performed on the specimen(s).(en)</items><items id="text">Tutkimusnimi</items></items><items code="at0017"><items id="comment">*This slot is intended to carry details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.&#13;
&#13;
The receiving laboratory may either perform the test or refer it to another laboratory. Where a different laboratory is responsible for performing the testing on specific analytes, it would be expected that these details would be carried in the 'Analyte result detail' SLOT within the CLUSTER.laboratory_test_analyte archetype.&#13;
&#13;
(en)</items><items id="description">*Details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.(en)</items><items id="text">*Receiving laboratory(en)</items></items><items code="at0035"><items id="comment">*The 'Distribution list' is for information-only, and that the primary recipient of the report is the person intended to act on the information.(en)</items><items id="description">*Details of additional clinicians or organisations who require a copy of the test result.(en)</items><items id="text">*Distribution list(en)</items></items><items code="at0037"><items id="description">*This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.(en)</items><items id="text">*Partial(en)</items></items><items code="at0038"><items id="description">*The Test result is complete and verified by an authorised person.(en)</items><items id="text">*Final(en)</items></items><items code="at0040"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist, and result data has been changed.(en)</items><items id="text">*Amended(en)</items></items><items code="at0057"><items id="comment">*For example: 'Pattern suggests significant renal impairment'. The content of the conclusion will vary, depending on the investigation performed. This conclusion should be aligned with the coded 'Test diagnosis'.(en)</items><items id="description">*Narrative description of the key findings.(en)</items><items id="text">*Conclusion(en)</items></items><items code="at0062"><items id="comment">*Equivalent to the HL7 Placer Order Identifier.(en)</items><items id="description">*The local identifier assigned by the requesting clinical system.(en)</items><items id="text">*Requester order identifier(en)</items></items><items code="at0063"><items id="comment">*Assigning an identifier to a request by the Laboratory lnformation System (LIS) enables tracking progress of the request and enables linking results to requests. It also provides a reference to assist with enquiries and it is usually equivalent to the HL7 Filler Order Identifier.(en)</items><items id="description">*The local identifier assigned to the test order by the order filler, usually by the Laboratory Information System (LIS).(en)</items><items id="text">*Receiver order identifier(en)</items></items><items code="at0065"><items id="comment">*If the specimen type is sufficiently specified with a code in the Test name, then this additional data is not required. Linking results to specific specimens may be recorded using 'Specimen identifier' elements in both the CLUSTER.specimen and the various results CLUSTER archetypes.(en)</items><items id="description">*Details about the physical substance that has been analysed.(en)</items><items id="text">*Specimen detail(en)</items></items><items code="at0068"><items id="comment">*This identifier is an internal tracking number assigned by the LIS, and it not intended to be the name of the test.(en)</items><items id="description">*A local identifier assigned by the receiving Laboratory Information System (LIS) to track the test process.(en)</items><items id="text">*Laboratory internal identifier(en)</items></items><items code="at0073"><items id="comment">*The values have been specifically chosen to match those in the HL7 FHIR Diagnostic report, historically derived from HL7v2 practice. Other local codes/terms can be used via the Text 'choice'.&#13;
&#13;
This element is multiple occurrence to cater for the use cases where statuses for different aspects of the result have been split into several elements.(en)</items><items id="description">*The status of the laboratory test result as a whole.(en)</items><items id="text">*Overall test status(en)</items></items><items code="at0074"><items id="description">*The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').(en)</items><items id="text">*Cancelled(en)</items></items><items code="at0075"><items id="description">*The date and/or time that ‘Overall test status’ was issued.(en)</items><items id="text">*Overall test status timestamp(en)</items></items><items code="at0077"><items id="comment">*This is intended to be a general categorisation and not to capture the organisational name of the laboratory. For example: anatomical pathology, immunology and transfusion medicine, medical microbiology, clinical pharmacology, medical genetics, medical biochemistry. Alternatively more granular sub categories or sub disciplines, such as endocrinology, haematology, and allergology services, may be used. This may assist clinicians in filtering between categories of results. Coding with a terminology is desirable, where possible.(en)</items><items id="description">*The diagnostic service or discipline that is responsible for the laboratory test result.(en)</items><items id="text">*Diagnostic service category(en)</items></items><items code="at0090"><items id="description">*Details of the clinician or organisation requesting the laboratory test result.(en)</items><items id="text">*Requester(en)</items></items><items code="at0094"><items id="comment">*In most situations there is one test request and a single corresponding test result, however this repeating cluster allows for the situation where there may be multiple test requests reported using a single test result.&#13;
&#13;
As an example: 'a clinician asks for blood glucose in one request and Urea/electrolytes in a second request, but the lab analyser does both and the lab wishes to report these together'.(en)</items><items id="description">*Details about the test request.(en)</items><items id="text">*Test request details(en)</items></items><items code="at0097"><items id="comment">*This SLOT may carry an individual analyte, a group, panel or battery of multiple analytes, or a more complex and specific structure.(en)</items><items id="description">*Results of the test performed on the specimen(s).(en)</items><items id="text">Tutkimustulos</items></items><items code="at0098"><items id="comment">*For example: 'Severe hepatic impairment', 'Salmonella contamination'. Coding of the diagnosis with a terminology is strongly recommended, where possible. This diagnosis should be aligned with the narrative in the 'Conclusion'.(en)</items><items id="description">*Single word, phrase or brief description that represents the clinical meaning and significance of the laboratory test result.(en)</items><items id="text">*Test diagnosis(en)</items></items><items code="at0100"><items id="comment">*This data element may include a link to the original clinical information provided in the test request.(en)</items><items id="description">*Description of clinical information available at the time of interpretation of results.(en)</items><items id="text">*Clinical information provided(en)</items></items><items code="at0101"><items id="description">*Additional narrative about the test result not captured in other fields.(en)</items><items id="text">Kommentti</items></items><items code="at0106"><items id="comment">*This data element is to be used when the test requested differs from the test actually performed by the laboratory.(en)</items><items id="description">*Name of the original laboratory test requested.(en)</items><items id="text">*Original test requested name(en)</items></items><items code="at0107"><items id="description">*The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.(en)</items><items id="text">*Registered(en)</items></items><items code="at0110"><items id="comment">*For example: 'details of ELISA/nephelometry'.(en)</items><items id="description">*Structured details about the method of analysis, device or interpretation used.(en)</items><items id="text">*Testing details(en)</items></items><items code="at0111"><items id="comment">*True if the test was performed directly at Point-of-Care (POCT).(en)</items><items id="description">*This indicates whether the test was performed directly at Point-of-Care (POCT) as opposed to a formal result from a laboratory or other service delivery organisation.(en)</items><items id="text">*Point-of-care test(en)</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">*'Confounding factors' should be reserved for uncontrolled/unplanned issues of patient state/physiology that might affect interpretation, for example 'recent exercise' or 'recent tobacco smoking'.&#13;
&#13;
Known or required preconditions, such as 'fasting' should be carried in the 'Sampling conditions' element within the CLUSTER.specimen archetype . In some cases preconditions are captured as part of the test name, for example 'Fasting blood glucose'.&#13;
&#13;
Known issues with specimen collection or handling, such as 'prolonged use of tourniquet' or 'sample haemolysed', should be carried in the 'Specimen quality' elements within CLUSTER.specimen archetype.&#13;
&#13;
Coding with a terminology is desirable, where possible.(en)</items><items id="description">*Issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">Haittaavat tekijät</items></items><items code="at0114"><items id="comment">*For example: Last Normal Menstrual Period (LNMP).(en)</items><items id="description">*Details of issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Structured confounding factors(en)</items></items><items code="at0115"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist. This is a sub-category of 'Amended'.(en)</items><items id="text">*Corrected(en)</items></items><items code="at0116"><items id="description">*The Test Result has been withdrawn following previous Final release.(en)</items><items id="text">*Entered in error(en)</items></items><items code="at0117"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0118"><items id="comment">*Multiple formats are allowed but they should represent equivalent clinical content.(en)</items><items id="description">*Digital image, video or diagram representing the test result.(en)</items><items id="text">*Multimedia representation(en)</items></items><items code="at0119"><items id="description">*Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.(en)</items><items id="text">*Appended(en)</items></items><items code="at0120"><items id="description">*Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.(en)</items><items id="text">*Preliminary(en)</items></items><items code="at0121"><items id="comment">*Coding with a terminology is desirable, where possible.(en)</items><items id="description">*Description about the method used to perform the test.(en)</items><items id="text">*Test method(en)</items></items><items code="at0122"><items id="comment">*For example: Anatomical pathology diagnoses consisting of several different axes such as morphology, etiology and function.(en)</items><items id="description">*A structured or complex diagnosis for the laboratory test.(en)</items><items id="text">*Structured test diagnosis(en)</items></items></term_definitions><term_definitions language="fr"><items code="at0000"><items id="description">Le résultat, y compris les conclusions et l'interprétation du laboratoire, d'un examen réalisé sur des échantillons prélevés sur une personne ou liés à celle-ci.</items><items id="text">Résultat d'un examen de laboratoire</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Par défaut, événement ponctuel ou d’intervalle non spécifié, pouvant être défini explicitement dans un template ou au moment de l’exécution.</items><items id="text">Tout événement</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">Un résultat d’analyse peut concerner un seul analyte ou un ensemble d’éléments, y compris des panels d’analyses. Il est fortement recommandé de coder le « nom de l’analyse » à l’aide d’une terminologie, par exemple LOINC ou SNOMED CT. Par exemple : « Glucose », « Urée et électrolytes », « Prélèvement par écouvillon », « Cortisol (matin) », « Potassium dans la transpiration » ou « Histopathologie du mélanome ». Le nom peut parfois inclure le type d’échantillon et l’état du patient, par exemple « Glycémie à jeun », ou comporter d’autres informations, comme « Potassium (gaz sanguin PNA) ».</items><items id="description">Nom de l'examen de laboratoire effectué sur le ou les échantillons.</items><items id="text">Nom de l'analyse</items></items><items code="at0017"><items id="comment">Ce slot est destiné à contenir les coordonnées du laboratoire qui a reçu la demande et qui assume la responsabilité globale de la gestion de la communication des résultats de l'analyse, même si d'autres laboratoires se chargent de certains aspects spécifiques.&#13;
&#13;
Le laboratoire destinataire peut soit réaliser l’examen lui-même, soit le transmettre à un autre laboratoire. Lorsqu’un autre laboratoire est chargé de réaliser les analyses portant sur des analytes spécifiques, ces informations devraient figurer dans le slot « Détails du résultat de l’analyte » de l’archétype CLUSTER.laboratory_test_analyte.</items><items id="description">Coordonnées du laboratoire qui a reçu la demande et qui assume la responsabilité globale de la gestion de la communication des résultats de l'examen, même si d'autres laboratoires se chargent de certains aspects spécifiques.</items><items id="text">Laboratoire destinataire</items></items><items code="at0035"><items id="comment">La « liste de diffusion » est fournie à titre indicatif uniquement, et le destinataire principal du rapport est la personne censée donner suite à ces informations.</items><items id="description">Coordonnées des autres professionnels de santé ou organismes devant recevoir une copie du résultat de l'examen.</items><items id="text">Liste de diffusion</items></items><items code="at0037"><items id="description">Il s'agit d'un résultat d'analyse partiel (par exemple, initial, intermédiaire ou préliminaire) : les données figurant dans ce résultat d'analyse peuvent être incomplètes ou non vérifiées.</items><items id="text">Partiel</items></items><items code="at0038"><items id="description">Le résultat de l'examen est complet et a été vérifié par une personne autorisée.</items><items id="text">Final</items></items><items code="at0040"><items id="description">Le résultat a été modifié après avoir été déclaré « définitif » ; il est complet et a été vérifié par le pathologue responsable, et les données du résultat ont été modifiées.</items><items id="text">Modifié</items></items><items code="at0057"><items id="comment">Par exemple : « Les résultats suggèrent une insuffisance rénale significative ». Le contenu de la conclusion variera en fonction de l'examen réalisé. Cette conclusion doit correspondre au « diagnostic d'examen » codé.</items><items id="description">Description narrative des principaux résultats.</items><items id="text">Conclusion</items></items><items code="at0062"><items id="comment">Équivalent à l'identifiant de demande « Placer » de la norme HL7.</items><items id="description">L'identifiant local attribué par le système clinique demandeur.</items><items id="text">Identifiant de la demande</items></items><items code="at0063"><items id="comment">L'attribution d'un identifiant à une demande par le système d'information de laboratoire (LIS) permet de suivre l'avancement de la demande et d'associer les résultats aux demandes. Il sert également de référence pour faciliter les demandes de renseignements et correspond généralement à l'identifiant de demande HL7 (Filler Order Identifier).</items><items id="description">Identifiant local attribué à la demande d'analyse par le responsable du traitement des demandes, généralement par le système d'information de laboratoire (LIS).</items><items id="text">Identifiant de la demande du destinataire</items></items><items code="at0065"><items id="comment">Si le type d’échantillon est suffisamment précisé par un code dans le nom de l'analyse, ces données supplémentaires ne sont pas requises. L’association des résultats à des échantillons spécifiques peut être enregistrée à l’aide des éléments « Identifiant de l’échantillon » tant dans l’archétype CLUSTER.specimen que dans les différents archétypes CLUSTER relatifs aux résultats.</items><items id="description">Informations détaillées sur la substance physique qui a été analysée.</items><items id="text">Détails de l'échantillon</items></items><items code="at0068"><items id="comment">Cet identifiant est un numéro de suivi interne attribué par le LIS ; il ne s'agit pas du nom de l'analyse.</items><items id="description">Identifiant local attribué par le système d'information de laboratoire (LIS) destinataire afin d'assurer le suivi du processus d'analyse.</items><items id="text">Identifiant interne du laboratoire</items></items><items code="at0073"><items id="comment">Les valeurs ont été spécifiquement choisies pour correspondre à celles du rapport diagnostique HL7 FHIR, issues historiquement de la norme HL7v2. D’autres codes ou termes locaux peuvent être utilisés via l’option « Texte ».&#13;
&#13;
Cet élément peut apparaître plusieurs fois afin de répondre aux cas d’utilisation où les statuts relatifs à différents aspects du résultat ont été répartis en plusieurs éléments.</items><items id="description">Statut global du résultat de l'analyse de laboratoire.</items><items id="text">Statut global de l'analyse</items></items><items code="at0074"><items id="description">Le résultat n'est pas disponible car le test n'a pas été lancé ou n'a pas été mené à terme (ce que l'on appelle parfois « test interrompu »).</items><items id="text">Annulé</items></items><items code="at0075"><items id="description">Date et/ou heure à laquelle le « Statut global de l'analyse » a été établi.</items><items id="text">Horodatage du statut global de l'analyse</items></items><items code="at0077"><items id="comment">Il s’agit d’une classification générale qui ne vise pas à mentionner le nom de l’organisation gestionnaire du laboratoire. Par exemple : anatomopathologie, immunologie et médecine transfusionnelle, microbiologie médicale, pharmacologie clinique, génétique médicale, biochimie médicale. Il est également possible d’utiliser des sous-catégories ou des sous-disciplines plus précises, telles que les services d’endocrinologie, d’hématologie et d’allergologie. Cela peut aider les cliniciens à filtrer les résultats par catégorie. Dans la mesure du possible, il est souhaitable d’utiliser une terminologie spécifique pour le codage.</items><items id="description">Le service ou la discipline de diagnostic responsable du résultat de l'examen de laboratoire.</items><items id="text">Catégorie du service de diagnostic</items></items><items code="at0090"><items id="description">Coordonnées du clinicien ou de l'organisation ayant demandé le résultat de l'analyse de laboratoire.</items><items id="text">Demandeur</items></items><items code="at0094"><items id="comment">Dans la plupart des cas, il y a une seule demande d’analyse et un seul résultat correspondant ; toutefois, ce groupe répétitif permet de prendre en compte les situations où plusieurs demandes d’analyse peuvent être rapportées à l’aide d’un seul résultat d’analyse.&#13;
&#13;
Par exemple : « un clinicien demande une glycémie dans une première demande et un dosage de l’urée et des électrolytes dans une deuxième demande, mais l’analyseur du laboratoire effectue les deux analyses et le laboratoire souhaite les rapporter ensemble ».</items><items id="description">Détails concernant la demande d'examen.</items><items id="text">Détails de la demande d'analyse</items></items><items code="at0097"><items id="comment">Ce slot peut porter sur un analyte individuel, un groupe, un panel ou une batterie de plusieurs analytes, ou encore une structure plus complexe et spécifique.</items><items id="description">Résultats de l'examen réalisé sur le ou les échantillons.</items><items id="text">Résultat de l'analyse</items></items><items code="at0098"><items id="comment">Par exemple : « Insuffisance hépatique sévère », « Contamination par Salmonella ». Il est fortement recommandé, dans la mesure du possible, de coder le diagnostic à l’aide d’une terminologie. Ce diagnostic doit correspondre au texte figurant dans la rubrique « Conclusion ».</items><items id="description">Mot, expression ou brève description représentant la signification et l'importance cliniques du résultat d'un examen de laboratoire.</items><items id="text">Diagnostic de l'analyse</items></items><items code="at0100"><items id="comment">Cet élément de données peut inclure un lien vers les informations cliniques d'origine fournies dans la demande d'analyse.</items><items id="description">Description des informations cliniques disponibles au moment de l'interprétation des résultats.</items><items id="text">Informations cliniques fournies</items></items><items code="at0101"><items id="description">Commentaire supplémentaire concernant le résultat de l'examen qui n'est pas renseigné dans d'autres champs.</items><items id="text">Remarque</items></items><items code="at0106"><items id="comment">Cet élément de données doit être utilisé lorsque l'examen demandé diffère de celui effectivement réalisé par le laboratoire.</items><items id="description">Nom de l'examen de laboratoire initial demandé.</items><items id="text">Nom initial de l'examen demandé</items></items><items code="at0107"><items id="description">L'existence de l'examen est enregistrée dans le système d'information du laboratoire, mais aucun résultat n'est encore disponible.</items><items id="text">Enregistré</items></items><items code="at0110"><items id="comment">Par exemple : « détails du test ELISA/néphélométrie ».</items><items id="description">Informations structurées concernant la méthode d'analyse, le dispositif ou l'interprétation utilisés.</items><items id="text">Détails de l'analyse</items></items><items code="at0111"><items id="comment">Vrai si le test a été réalisé directement au point de soins (POCT).</items><items id="description">Cela permet d’indiquer si l'analyse a été réalisé directement au point de soins (POCT), par opposition à un résultat officiel provenant d’un laboratoire ou d’un autre prestataire de services.</items><items id="text">Analyse au chevet du patient</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">Le terme « facteurs de confusion » doit être réservé aux éléments non contrôlés ou imprévus liés à l’état ou à la physiologie du patient susceptibles d’influencer l’interprétation, par exemple « effort physique récent » ou « consommation récente de tabac ».&#13;
&#13;
Les conditions préalables connues ou requises, telles que « à jeun », doivent être indiquées dans l’élément « Conditions de prélèvement » de l’archétype CLUSTER.specimen. Dans certains cas, les conditions préalables sont intégrées au nom de  l'analyse, par exemple « glycémie à jeun ».&#13;
&#13;
Les problèmes connus liés au prélèvement ou à la manipulation de l’échantillon, tels que « utilisation prolongée d’un garrot » ou « échantillon hémolysé », doivent être indiqués dans les éléments « Problèmes de qualité de l'échantillon » de l’archétype CLUSTER.specimen.&#13;
&#13;
Dans la mesure du possible, il est souhaitable d’utiliser une terminologie standardisée pour le codage.</items><items id="description">Problèmes ou circonstances ayant une incidence sur l'interprétation exacte de la mesure ou du résultat de l'analyse.</items><items id="text">Facteurs de confusion</items></items><items code="at0114"><items id="comment">Par exemple : date des dernières règles (LNMP).</items><items id="description">Détails des problèmes ou circonstances ayant une incidence sur l'interprétation précise de la mesure ou du résultat de l'analyse.</items><items id="text">Facteurs de confusion structurés</items></items><items code="at0115"><items id="description">Le résultat a été modifié après avoir été déclaré « définitif » ; il est complet et a été vérifié par le pathologue responsable. Il s'agit d'une sous-catégorie de « Modifié ».</items><items id="text">Corrigé</items></items><items code="at0116"><items id="description">Le résultat de l'analyse a été retiré après sa publication définitive.</items><items id="text">Saisi par erreur</items></items><items code="at0117"><items id="comment">Par exemple: exigences d’information locales ou métadonnées supplémentaires permettant l’alignement avec des équivalents FHIR ou CIMI.</items><items id="description">Informations supplémentaires nécessaires pour représenter un contenu local ou pour assurer l’alignement avec d’autres modèles de référence ou formalismes.</items><items id="text">Extension</items></items><items code="at0118"><items id="comment">Plusieurs formats sont autorisés, mais ils doivent présenter un contenu clinique équivalent.</items><items id="description">Image numérique, vidéo ou schéma représentant le résultat de l'analyse.</items><items id="text">Représentation multimédia</items></items><items code="at0119"><items id="description">Après avoir été finalisé, le rapport a été modifié par l'ajout de nouveaux éléments. Le contenu existant reste inchangé. Il s'agit d'une sous-catégorie de « Modifié ».</items><items id="text">Ajouté</items></items><items code="at0120"><items id="description">Des résultats préliminaires vérifiés sont disponibles, mais tous les résultats ne sont pas définitifs. Il s'agit d'une sous-catégorie de « Partiel ».</items><items id="text">Preliminaire</items></items><items code="at0121"><items id="comment">Dans la mesure du possible, il est souhaitable d'utiliser une terminologie de codage.</items><items id="description">Description de la méthode utilisée pour réaliser le test.</items><items id="text">Méthode d'analyse</items></items><items code="at0122"><items id="comment">Par exemple : les diagnostics de pathologie anatomique comprenant plusieurs aspects différents, tels que la morphologie, l’étiologie et la fonction.</items><items id="description">Diagnostic structuré ou complexe issu de l'examen de laboratoire.</items><items id="text">Diagnostic par test structuré</items></items></term_definitions><term_definitions language="it"><items code="at0000"><items id="description">L'esito, inclusi i risultati e l'interpretazione, di una indagine di laboratorio effettuata su campioni provenienti da individui o relativi materiali.</items><items id="text">Risultato di esame di laboratorio</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Predefinito, non specificato istante o intervallo di tempo, che può essere esplicitamente dettagliato in un template o in esecuzione (tempo reale)</items><items id="text">Qualunque evento</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">Il risultato di un esame può essere relativo ad un singolo analita, oppure and un gruppo di elementi, inclusi i panel test. Si raccomanda vivamente di codificare il nome dell'esame tramite utilizzo di una terminologia, come ad esempio LOINC o SNOMED CT. Ad esempio: 'Glucosio', 'Urea ed elettroliti', 'Tampone', 'Cortisolo (am)', 'Potassio nella traspirazione' o 'Istopatologia del melanoma'. Il nome può talvolta includere il tipo di campione e lo stato del paziente, ad esempio 'Glucosio a digiuno' o includere altre informazioni, come 'Potassio (gas sanguigni PNA).</items><items id="description">Nome dell' indagine di laboratorio effettuata sul campione/i.</items><items id="text">Nome dell'esame</items></items><items code="at0017"><items id="comment">Questo campo viene utilizzato per indicare i dettagli riguardanti il laboratorio che ha ricevuto la richiesta ed ha la piena responsabilità di gestione del risultato dell'esame, anche nel caso  in cui altri laboratori ne abbiano eseguito delle specifiche parti. Il laboratorio ricevente potrebbe sia effettuare l'esame, oppure delegarlo verso un altro laboratorio. Quando un altro laboratorio è responsabile dell'esecuzione del test su degli specifici analiti, ci si aspetta che  i relativi dettagli vengano riportati nello SLOT "Dettagli del risultato dell'analita", all'interno dell'archetipo CLUSTER.laboratory_test_analyte.</items><items id="description">Dettagli riguardanti il laboratorio che ha ricevuto la richiesta ed ha la piena responsabilità di gestione del risultato dell'esame, anche nel caso in cui altri laboratori abbiano  eseguito specifiche parti.</items><items id="text">Laboratorio ricevente</items></items><items code="at0035"><items id="comment">La "Lista di distribuzione" ha soltanto scopo informativo, ed il destinatario principale della lista è la persona ritenuta quella preposta ad agire sulle informazioni.</items><items id="description">Dettagli su eventuale altro personale sanitario o organismi che hanno richiesto una copia del risultato dell'esame. </items><items id="text">Lista di distribuzione</items></items><items code="at0037"><items id="description">E' un risltato parziale(iniziale, provvisorio o preliminare) dell'esame: la data nel risultato dell'esame potrebbe essere incompleta, oppure non verificata.</items><items id="text">Parziale</items></items><items code="at0038"><items id="description">Il risultato dell'esame è completo ed è stato verificato da una persona autorizzata. </items><items id="text">Definitivo</items></items><items code="at0040"><items id="description">Il risultato è stato modificato dopo essere stato dichiarato come Definitivo, ed è completo e verificato dal patologo responsabile e data dell'esito è stata cambiata. </items><items id="text">Modificato</items></items><items code="at0057"><items id="comment">Per esempio: "l'esito indica una significativa compromissione renale". Il contenuto delle conclusioni può variare, a seconda dell'indagine effettuata. Queste conclusioni dovrebbero essere allineate con quanto riportato nel campo "Diagnosi dell'esame".</items><items id="description">Descrizione relativa agli esiti principali. </items><items id="text">Conclusioni</items></items><items code="at0062"><items id="comment">E' equivalente al campo HL7 "Placer Order Identifier"</items><items id="description">ID locale assegnato all'ordine dell'esame dal sistema che lo ha richiesto </items><items id="text">Identificativo del richiedente l'ordine</items></items><items code="at0063"><items id="comment">L'identificativo assegnato alla richiesta dal Sistema Informativo di Laboratorio (LIS) permette di tracciare lo stato di avanzamento della richiesta e di associare i risultati alle richieste. Fornisce anche un riferimento utile nelle indagini e di solito è equivalente al campo HL7 "Filler Order Identifier".</items><items id="description">Identificativo locale assegnato all'ordine dell'esame dall'order filler, solitamente dal Sistema Informativo di Laboratorio (LIS).</items><items id="text">Identificativo del ricevente l'ordine</items></items><items code="at0065"><items id="comment">Se il tipo del campione è specificato in maniera esaustiva all'interno del nome dell'esame, allora non è richiesto alcun dettaglio. Nel caso di campioni multipli, questi possono essere rappresentati mediante "gruppo di risultati" ("Result group").</items><items id="description">Dettagli sulla sostanza fisica che è stata analizzata. </items><items id="text">Dettagli sul campione</items></items><items code="at0068"><items id="comment">Questo identivicativo è un numero di tracciabilità interno assegnato dal LIS, e non il nome dell'esame. </items><items id="description">Identificativo locale assegnato dal Sistema Informativo di Laboratorio (LIS) ricevente, allo scopo di tracciare il processo dell'esame. </items><items id="text">Identificativo interno del laboratorio</items></items><items code="at0073"><items id="comment">I valori sono stati specificatamente scelti in moto tale da corrispondere a quelli del "FHIR Diagnostic Report" di HL7, a loro volta storicamente derivanti dal HL7 v2. Altre codifiche/terminologie locali possono essere utilizzare tramite la scelta "Text". Questo elemento ha occorrenze multiple al fine di soddisfare le esigenze di quegli use case in cui gli stati relativi a differenti aspetti del risultato sono stati divisi in più componenti.</items><items id="description">Lo stato relativo all'esame di laboratorio nel suo complesso. </items><items id="text">Stato complessivo dell'esame</items></items><items code="at0074"><items id="description">Il risultato non è disponibile perché il test non è stato avviato o non è stato completato (talvolta chiamato anche 'abortito').</items><items id="text">Cancellato</items></items><items code="at0075"><items id="description">La data e/o l'ora in cui è stato rilasciato lo "Stato complessivo dell'esame". </items><items id="text">Timestamp dello stato generale del test</items></items><items code="at0077"><items id="comment">Questa vuole essere una categorizzazione generale e non registrare il nome organizzativo del laboratorio. Per esempio: anatomia patologica, immunologia e medicina trasfusionale, microbiologia medica, farmacologia clinica, genetica medica, biochimica medica. In alternativa possono essere utilizzate sottocategorie o sottodiscipline più granulari, come endocrinologia, ematologia e servizi di allergologia. Questo può aiutare i medici a filtrare tra le categorie di risultati. La codifica con una terminologia è auspicabile, ove possibile.</items><items id="description">Il servizio diagnostico o la disciplina che è responsabile del risultato del test di laboratorio.</items><items id="text">Categoria di servizio diagnostico</items></items><items code="at0090"><items id="description">Dettagli del clinico o dell'organizzazione che richiede il risultato dell'esame di laboratorio.</items><items id="text">Richiedente</items></items><items code="at0094"><items id="comment">Nella maggior parte delle situazioni c'è una richiesta di test e un singolo risultato di test corrispondente, tuttavia questo cluster di ripetizione permette la situazione in cui ci possano essere richieste di test multipli segnalati utilizzando un singolo risultato di test.&#13;
&#13;
Come esempio: "un clinico chiede il glucosio nel sangue in una richiesta e gli urei/elettroliti in una seconda richiesta, ma l'analizzatore di laboratorio fa entrambe le cose e il laboratorio desidera riportare queste richieste insieme".</items><items id="description">Dettagli sulla richiesta di test.</items><items id="text">Dettagli della richiesta di test</items></items><items code="at0097"><items id="comment">Questo SLOT può riportare un singolo analita, un gruppo, un pannello o una batteria di più analiti, o una struttura più complessa e specifica.</items><items id="description">Risultati del test eseguito sul campione o sui campioni.</items><items id="text">Risultati del test</items></items><items code="at0098"><items id="comment">Per esempio: 'Grave insufficienza epatica', 'Contaminazione da Salmonella'. Si raccomanda vivamente, ove possibile, di codificare la diagnosi con una terminologia. Questa diagnosi dovrebbe essere allineata con la narrazione nella 'Conclusione'.</items><items id="description">Singola parola, frase o breve descrizione che rappresenta il significato clinico e la significatività del risultato del test di laboratorio.</items><items id="text">Diagnosi del test</items></items><items code="at0100"><items id="comment">Questo elemento di dati può includere un link alle informazioni cliniche originali fornite nella richiesta di test.</items><items id="description">Descrizione delle informazioni cliniche disponibili al momento dell'interpretazione dei risultati.</items><items id="text">Informazioni cliniche fornite</items></items><items code="at0101"><items id="description">Narrativa aggiuntiva sul risultato del test non catturato in altri campi.</items><items id="text">Commento</items></items><items code="at0106"><items id="comment">Questo elemento deve essere utilizzato quando il test richiesto differisce da quello effettivamente eseguito dal laboratorio.</items><items id="description">Nome del test di laboratorio originale richiesto.</items><items id="text">Nome del test originale richiesto</items></items><items code="at0107"><items id="description">L'esistenza del test è registrata nel Sistema Informativo di Laboratorio, ma non c'è ancora nulla di disponibile. </items><items id="text">Registrato</items></items><items code="at0110"><items id="comment">Ad esempio: 'dettagli di ELISA/nefelometria'.</items><items id="description">Dettagli strutturati sul metodo utilizzato relativamente ad analisi, dispositivi o interpretazione. </items><items id="text">Dettagli del test</items></items><items code="at0111"><items id="comment">Vero se il test è stato eseguito direttamente al punto di assistenza (Point-of-Care, POCT).</items><items id="description">Questo elemento indica se il test è stato eseguito direttamente presso il punto di assistenza (Point-of-Care, POCT), rispetto a un risultato formale di un laboratorio o di un'altra organizzazione che fornisce servizi.</items><items id="text">Test al punto di assistenza</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">I "fattori di confusione" dovrebbero essere riservati a questioni incontrollate/non pianificate di stato del paziente/fisiologia che potrebbero influenzare l'interpretazione, ad esempio "esercizio fisico recente" o "fumo di tabacco recente".&#13;
&#13;
Le precondizioni conosciute o richieste, come ad esempio il "digiuno", dovrebbero essere riportati nell'elemento "Condizioni di campionamento" all'interno dell'archetipo CLUSTER.specimen archetype. In alcuni casi le precondizioni vengono catturate come parte del nome del test, ad esempio "Glucosio nel sangue a digiuno".&#13;
&#13;
Problemi noti di raccolta o manipolazione dei campioni, come "uso prolungato del laccio emostatico" o "campione emolizzato", devono essere riportati negli elementi "Qualità del campione" all'interno di CLUSTER.specimen archetype.&#13;
Ove possibile, è auspicabile una codifica con una terminologia.</items><items id="description">Problemi o circostanze che influiscono sull'interpretazione accurata del risultato della misurazione o del test.</items><items id="text">Fattori di confusione</items></items><items code="at0114"><items id="comment">Per esempio: Ultimo periodo mestruale normale (Last Normal Menstrual Period, LNMP).</items><items id="description">Dettagli dello stato del paziente che possono alterare l'interpretazione del test di laboratorio.</items><items id="text">Fattori di confusione strutturati</items></items><items code="at0115"><items id="description">Il risultato è stato modificato in seguito all'essere stato dichiarato definitivo, ed è completo e verificato dal patologo responsabile. Questa è una sottocategoria di "Modificato"</items><items id="text">Corretto</items></items><items code="at0116"><items id="description">Il Risultato del Test è stato ritirato dopo un precedente rilascio Finale.</items><items id="text">Inserito in errore</items></items><items code="at0117"><items id="comment">Ad esempio: requisiti informativi locali o metadati aggiuntivi per allinearsi agli equivalenti FHIR o CIMI.</items><items id="description">Informazioni aggiuntive necessarie per acquisire contenuti locali o per allinearsi con altri modelli/formalismi di riferimento.</items><items id="text">Estensione</items></items><items code="at0118"><items id="comment">Sono consentiti più formati, ma dovrebbero rappresentare un contenuto clinico equivalente.</items><items id="description">Immagine digitale, video o diagramma che rappresenta il risultato del test.</items><items id="text">Rappresentazione multimediale</items></items><items code="at0119"><items id="description">Dopo essere stato dichiarato definitivo, il rapporto è stato modificato con l'aggiunta di nuovi contenuti. Il contenuto pre-esistente è rimasto invariato. Questa è una sottocategoria di "Modificato".</items><items id="text">Addizionato</items></items><items code="at0120"><items id="description">I primi risultati verificati sono disponibili, ma non tutti i risultati sono definitivi. Questa è una sottocategoria di 'Parziale'.</items><items id="text">Preliminare</items></items><items code="at0121"><items id="comment">E' auspicabile, ove possibile, codificare con una terminologia.</items><items id="description">Descrizione del metodo utilizzato per eseguire il test.</items><items id="text">Metodo di test</items></items><items code="at0122"><items id="comment">Per esempio: Le diagnosi di anatomia patologica che consistono in molteplici assi diversi, come la morfologia, l'eziologia e la funzione. </items><items id="description">Una diagnosi strutturata o complessa per il test di laboratorio.</items><items id="text">Diagnosi strutturata per il test</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">Resultat, inkludert funn og laboratoriets tolkning, av en laboratorieundersøkelse utført på prøvemateriale fra et individ eller relatert til individet.</items><items id="text">Laboratorieresultat</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en templat eller i en applikasjon.</items><items id="text">Uspesifisert hendelse</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">Undersøkelsesnavnet kan dekke ett enkelt resultat eller en gruppe av resultater. Undersøkelsesnavnet kan kodes med medisinsk kodeverk som for eksempel NLK (Norsk laboratoriekodeverk), LOINC, SNOMED CT eller lokale laboratoriekodeverk. Eksempler kan være "Glukose", "Elektrolytter", "Blodgass", "Differensialtelling", "Dyrkning", "Kortisol (morgen)" eller "histologi melanom". Navnet kan noen ganger inneholde typen prøvemateriale og/eller pasientstatus, for eksempel "fastende blodglukose" "Kalium i svette", eller inneholde annen informasjon, som "Kalium (PNA blodgass)".</items><items id="description">Navn på laboratorieundersøkelsen som er utført på prøvematerialet.</items><items id="text">Undersøkelsesnavn</items></items><items code="at0017"><items id="comment">Dette SLOTet er ment for detaljer om laboratoriet som mottok rekvisisjonen og har det overordnede ansvaret for å sende en svarrapport, selv om andre laboratorier utfører spesifikke deler av den.&#13;
&#13;
Det ansvarlige laboratoriet kan enten utføre undersøkelsene selv, eller videresende til andre laboratorier. Hvis et annet laboratorium har utført spesifikke undersøkelser bør informasjon om dette bli beskrevet i SLOTet "Detaljer om analyseresultat" i arketypen "Analyseresultat".&#13;
&#13;
"Ansvarlig laboratorium" kalles ofte "Tjenesteyter".</items><items id="description">Detaljer om laboratoriet som mottok den opprinnelige rekvisisjonen og har det overordnede ansvaret for prøven, selv om det er andre laboratorier som utfører de enkelte analysene.</items><items id="text">Ansvarlig laboratorium</items></items><items code="at0035"><items id="comment">Personene eller organisasjonene på distribusjonslisten mottar svaret kun til informasjon, og det er hovedmottakeren av rapporten som forventes å agere på den.</items><items id="description">Detaljert informasjon knyttet til kliniker eller organisatorisk enhet som skal motta en kopi av laboratoriesvaret.</items><items id="text">Kopimottakere</items></items><items code="at0037"><items id="description">Dette er et delvis (dvs initalt, foreløpig eller preliminært) svar: Data i svaret kan være ukomplett eller ubekreftet.</items><items id="text">Ufullstendig</items></items><items code="at0038"><items id="description">Svaret er komplett og er bekreftet av ansvarlig person.</items><items id="text">Endelig</items></items><items code="at0040"><items id="description">Svaret har blitt modifisert etter å ha vært i status "Endelig", og er komplett og verifisert av ansvarlig person, og svardata er endret.</items><items id="text">Revidert</items></items><items code="at0057"><items id="comment">For eksempel "mønsteret indikerer betydelig nedsatt nyrefunksjon". Innholdet av konklusjonen vil variere, basert på hvilken undersøkelse som er utført. Konklusjonen bør være i overensstemmelse med kodene brukt i elementet "Diagnose".</items><items id="description">Fritekstbeskrivelse av de viktigste funnene.</items><items id="text">Konklusjon</items></items><items code="at0062"><items id="comment">Tilsvarende HL7 "Placer Order Identifier".</items><items id="description">Rekvirentens/bestillers lokale ID for rekvisisjonen.</items><items id="text">Rekvirentens rekvisisjonsID</items></items><items code="at0063"><items id="comment">Når Laboratorieinformasjonssystemet (LIMS) tildeler en identifikator, åpnes det for sporing av fremdriften/prosessforløpet på bestillingen av undersøkelsen/rekvisisjonen og for å koble undersøkelsesresultatet til rekvisisjonen/bestillingen. Som regel tilsvarer dette HL7 "Filler Order Identifier".&#13;
&#13;
Denne identifikatoren kalles også ofte "rekvisisjonsnummer" eller "remissenummer".</items><items id="description">Bestillingens/rekvisisjonens lokale identifikator/referansenummer tildelt av tjenesteyter/mottaker, som regel av LIMS.</items><items id="text">Rekvisisjonsmottakers rekvisisjonsID</items></items><items code="at0065"><items id="comment">Hvis prøvematerialet er tilstrekkelig spesifisert med en kode i analysenavnet er ikke dette dataelementet nødvendig. Det er mulig å koble svar med spesifikke prøver ved hjelp av elementene "ID for prøvemateriale" i både CLUSTER.specimen og de forskjellige CLUSTER-arketypene for laboratoriesvar.</items><items id="description">Detaljer om den fysiske substansen som er analysert.</items><items id="text">Prøvedetaljer</items></items><items code="at0068"><items id="comment">Denne identifikatoren er et internt sporingsnummer tildelt av LIMS, og det er ikke ment å være navnet på undersøkelsen.</items><items id="description">En lokal identifikator tildelt av det mottagende laboratoriesystemet (LIMS), for å kunne spore analyseprosessen.</items><items id="text">Laboratorieintern identifikator</items></items><items code="at0073"><items id="comment">Verdiene er valgt spesifikt for å samsvare med verdiene i HL7 FHIR-ressursen "Diagnostic report", som historisk sett kommer fra HL7 v2. Andre lokale koder eller termer kan brukes ved å bruke datatypen "Fri eller kodet tekst.&#13;
&#13;
Dette elementet kan repeteres for å understøtte bruksområdene der statuser for forskjellige aspekter av resultatet er delt opp i flere elementer. Et eksempel på dette er de norske standard labsvarmeldingene i HIS 1.4-standarden, der status for svaret og status for laboratorieprosessen håndteres separat.</items><items id="description">Den overordnede statusen for hele laboratorieresultatet/prøven.</items><items id="text">Overordnet resultatstatus</items></items><items code="at0074"><items id="description">Svaret er utilgjengelig fordi analysen ikke ble påbegynt eller ferdigstilt (også kalt "avbrutt").</items><items id="text">Kansellert</items></items><items code="at0075"><items id="description">Tidspunktet for utstedelsen av "Overordnet resultatstatus".</items><items id="text">Tidsangivelse for overordnet resultatstatus</items></items><items code="at0077"><items id="comment">Dette er ikke ment for å gjenspeile laboratoriets interne organisering, men for å angi hvilken laboratoriedisiplin analysene tilhører. For eksempel patologi, immunologi og transfusjonsmedisin, medisinsk mikrobiologi, klinisk farmakologi, medisinsk genetikk og medisinsk biokjemi. Eventuelt enda mer findelte subkategorier eller subdisipliner som f.eks. hormoner/endokrinologi, hematologi, allergologi. Dette hjelper klinikere med å filtrere mellom resultatkategorier i henhold til lokalt oppsett. Koding med en terminologi er ønskelig, der det er mulig.</items><items id="description">Laboratoriefagområdet, -disiplinen eller subdisiplinen som er ansvarlig for resultatet.</items><items id="text">Laboratoriedisiplin</items></items><items code="at0090"><items id="description">Detaljert informasjon knyttet til kliniker eller organisatorisk enhet som har rekvirert/bestilt analysen.</items><items id="text">Rekvirent</items></items><items code="at0094"><items id="comment">I de fleste situasjoner finnes det én rekvisisjon og ett korresponderende svar, men under noen omstendigheter kan flere rekvisisjoner representeres ved hjelp av en enkelt laboratorieresultat-arketype.&#13;
&#13;
For eksempel kan en kliniker bestille "glukose" i en rekvisisjon og "urea og elektrolytter" i en ytterligere rekvisisjon, mens laboratoriet utfører begge analysene og sender en samlet rapport.</items><items id="description">Detaljer knyttet til rekvisisjonen.</items><items id="text">Rekvisisjonsdetaljer</items></items><items code="at0097"><items id="comment">Dette SLOTet kan inneholde resultat for ett enkelt analyseresultat, for en gruppe analyseresultater, eller for en mer kompleks og spesifikk struktur.</items><items id="description">Resultat av undersøkelsen som er utført på prøvematerialet.</items><items id="text">Undersøkelsesresultat</items></items><items code="at0098"><items id="comment">For eksempel "Betydelig nedsatt leverfunksjon" eller "Salmonella". Koding med en terminologi foretrekkes, der det er mulig. Diagnosen bør være i overensstemmelse med teksten i "Konklusjon".</items><items id="description">Enkeltord, frase eller kort beskrivelse som representerer den kliniske betydningen og signifikansen av laboratorieresultatet.</items><items id="text">Diagnose</items></items><items code="at0100"><items id="comment">Dette dataelementet kan inkludere en lenke til den opprinnelige kliniske informasjonen som ble angitt i rekvisisjonen.</items><items id="description">Beskrivelse av klinisk informasjon som er tilgjengelig på tolkningstidspunktet.</items><items id="text">Tilgjengelig klinisk informasjon</items></items><items code="at0101"><items id="description">Tekstlig tilleggsinformasjon om analyseresultatet, som ikke er registrert i andre felt.</items><items id="text">Kommentar</items></items><items code="at0106"><items id="comment">Dette dataelementet er tenkt brukt dersom det er forskjell mellom undersøkelsen som er rekvirert og den som faktisk er utført.</items><items id="description">Navn på undersøkelsen som opprinnelig ble rekvirert.</items><items id="text">Navn på opprinnelig rekvirert analyse</items></items><items code="at0107"><items id="description">Analysen er registrert i laboratoriesystemet, men svaret er ikke tilgjengelig per nå.</items><items id="text">Registrert</items></items><items code="at0110"><items id="comment">For eksempel "detaljer om ELISA/nefelometri".</items><items id="description">Strukturert tilleggsinformasjon om hvilken analysemetode, utstyr eller tolkning som er benyttet.</items><items id="text">Undersøkelsesdetaljer</items></items><items code="at0111"><items id="comment">Sann dersom analysen ble utført ved pasientnær analysering (PNA).</items><items id="description">Dette indikerer hvorvidt analysen ble utført gjennom pasientnær analysering (PNA) i stedet for en mer formell laboratorietjeneste.</items><items id="text">Pasientnær analysering</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">"Konfunderende faktorer" bør være reservert for ukontrollerte eller uplanlagte forhold hos pasienten som kan påvirke tolkningen av laboratorieresultatet. For eksempel "nylig fysisk aktivitet", "nylig røykt tobakk". &#13;
&#13;
Kjente forutsetninger som "fastende" bør dokumenteres i elementet "Prøvetakingsforhold" i arketypen CLUSTER.specimen. I noen tilfeller er slike forutsetninger del av undersøkelsesnavnet, for eksempel "Fastende blodsukker".&#13;
&#13;
Kjente forhold knyttet til prøvetaking eller håndtering av prøven, som "langvarig stase" eller "hemolyse" (preanalytiske forhold) bør dokumenteres i elementet "Prøvekvalitet" i arketypen CLUSTER.specimen.&#13;
&#13;
Koding med en terminologi er ønskelig, der det er mulig.</items><items id="description">Forhold eller omstendigheter som påvirker tolkningen av laboratorieresultatet.</items><items id="text">Konfunderende faktorer</items></items><items code="at0114"><items id="comment">For eksempel siste normale menstruasjonsperiode.</items><items id="description">Ytterligere detaljer om forhold i tilstand eller omstendigheter som kan påvirke tolkningen av laboratorieresultatet.</items><items id="text">Strukturerte konfunderende faktorer</items></items><items code="at0115"><items id="description">Svaret har blitt modifisert etter å ha vært i status "Endelig" og er komplett og verifisert. Dette er en underkategori til "Revidert".</items><items id="text">Korrigert</items></items><items code="at0116"><items id="description">Analysesvaret har blitt trukket tilbake etter å ha vært i status "Endelig".</items><items id="text">Feilregistrert</items></items><items code="at0117"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at0118"><items id="comment">Flere formater tillates, men innholdet i de forskjellige formatene må representere det samme innholdet.</items><items id="description">Digitalt bilde, video eller diagram som representerer analyseresultatet.</items><items id="text">Multimediarepresentasjon</items></items><items code="at0119"><items id="description">Etter å ha vært satt som status "Endelig", har det blitt lagt nytt innhold til rapporten. Det eksisterende innholdet er uendret. Dette er en underkategori av "Revidert".</items><items id="text">Tillegg</items></items><items code="at0120"><items id="description">Verifiserte tidlige svar er tilgjengelige, men ikke alle svar er endelige. Dette er en underkategori av "Ufullstendig".</items><items id="text">Foreløpig</items></items><items code="at0121"><items id="comment">Koding med en terminologi er ønskelig, der det er mulig.</items><items id="description">Beskrivelse av metoden som ble brukt for å utføre undersøkelsen.</items><items id="text">Undersøkelsesmetode</items></items><items code="at0122"><items id="comment">For eksempel patologidiagnoser bestående av flere forskjellige akser som morfologi, etiologi og funksjon.</items><items id="description">En strukturert eller kompleks diagnose for laboratorieundersøkelsen.</items><items id="text">Strukturert diagnose</items></items></term_definitions><term_definitions language="nl"><items code="at0000"><items id="description">*The result, including findings and the laboratory's interpretation, of an investigation performed on specimens collected from an individual or related to that individual.(en)</items><items id="text">*Laboratory test result(en)</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="description">Naam van het laboratorium onderzoek dat vericht is op het specimen.</items><items id="text">Naam van de Test</items></items><items code="at0017"><items id="description">*Details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.(en)</items><items id="text">*Receiving laboratory(en)</items></items><items code="at0035"><items id="description">*Details of additional clinicians or organisations who require a copy of the test result.(en)</items><items id="text">*Distribution list(en)</items></items><items code="at0037"><items id="description">*This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.(en)</items><items id="text">*Partial(en)</items></items><items code="at0038"><items id="description">*The Test result is complete and verified by an authorised person.(en)</items><items id="text">*Final(en)</items></items><items code="at0040"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist, and result data has been changed.(en)</items><items id="text">*Amended(en)</items></items><items code="at0057"><items id="description">*Narrative description of the key findings.(en)</items><items id="text">*Conclusion(en)</items></items><items code="at0062"><items id="description">*The local identifier assigned by the requesting clinical system.(en)</items><items id="text">*Requester order identifier(en)</items></items><items code="at0063"><items id="description">*The local identifier assigned to the test order by the order filler, usually by the Laboratory Information System (LIS).(en)</items><items id="text">*Receiver order identifier(en)</items></items><items code="at0065"><items id="description">*Details about the physical substance that has been analysed.(en)</items><items id="text">*Specimen detail(en)</items></items><items code="at0068"><items id="description">*A local identifier assigned by the receiving Laboratory Information System (LIS) to track the test process.(en)</items><items id="text">*Laboratory internal identifier(en)</items></items><items code="at0073"><items id="description">*The status of the laboratory test result as a whole.(en)</items><items id="text">*Overall test status(en)</items></items><items code="at0074"><items id="description">*The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').(en)</items><items id="text">*Cancelled(en)</items></items><items code="at0075"><items id="description">*The date and/or time that ‘Overall test status’ was issued.(en)</items><items id="text">*Overall test status timestamp(en)</items></items><items code="at0077"><items id="description">*The diagnostic service or discipline that is responsible for the laboratory test result.(en)</items><items id="text">*Diagnostic service category(en)</items></items><items code="at0090"><items id="description">*Details of the clinician or organisation requesting the laboratory test result.(en)</items><items id="text">*Requester(en)</items></items><items code="at0094"><items id="description">*Details about the test request.(en)</items><items id="text">*Test request details(en)</items></items><items code="at0097"><items id="description">*Results of the test performed on the specimen(s).(en)</items><items id="text">*Test result(en)</items></items><items code="at0098"><items id="description">*Single word, phrase or brief description that represents the clinical meaning and significance of the laboratory test result.(en)</items><items id="text">*Test diagnosis(en)</items></items><items code="at0100"><items id="description">*Description of clinical information available at the time of interpretation of results.(en)</items><items id="text">*Clinical information provided(en)</items></items><items code="at0101"><items id="description">*Additional narrative about the test result not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0106"><items id="description">*Name of the original laboratory test requested.(en)</items><items id="text">*Original test requested name(en)</items></items><items code="at0107"><items id="description">*The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.(en)</items><items id="text">*Registered(en)</items></items><items code="at0110"><items id="description">*Structured details about the method of analysis, device or interpretation used.(en)</items><items id="text">*Testing details(en)</items></items><items code="at0111"><items id="description">*This indicates whether the test was performed directly at Point-of-Care (POCT) as opposed to a formal result from a laboratory or other service delivery organisation.(en)</items><items id="text">*Point-of-care test(en)</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="description">*Issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0114"><items id="description">*Details of issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Structured confounding factors(en)</items></items><items code="at0115"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist. This is a sub-category of 'Amended'.(en)</items><items id="text">*Corrected(en)</items></items><items code="at0116"><items id="description">*The Test Result has been withdrawn following previous Final release.(en)</items><items id="text">*Entered in error(en)</items></items><items code="at0117"><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0118"><items id="description">*Digital image, video or diagram representing the test result.(en)</items><items id="text">*Multimedia representation(en)</items></items><items code="at0119"><items id="description">*Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.(en)</items><items id="text">*Appended(en)</items></items><items code="at0120"><items id="description">*Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.(en)</items><items id="text">*Preliminary(en)</items></items><items code="at0121"><items id="description">*Description about the method used to perform the test.(en)</items><items id="text">*Test method(en)</items></items><items code="at0122"><items id="description">*A structured or complex diagnosis for the laboratory test.(en)</items><items id="text">*Structured test diagnosis(en)</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="description">O resultado, incluindo achados e a interpretação do laboratório, de uma investigação realizada em amostras coletadas de um indivíduo ou relacionadas a esse indivíduo.</items><items id="text">Resultado de exame de laboratório</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">*A test result may be for a single analyte, or a group of items, including panel tests. It is strongly recommended that 'Test name' be coded with a terminology, for example LOINC or SNOMED CT. For example: 'Glucose', 'Urea and Electrolytes', 'Swab', 'Cortisol (am)', 'Potassium in perspiration' or 'Melanoma histopathology'. The name may sometimes include specimen type and patient state, for example 'Fasting blood glucose' or include other information, as 'Potassium (PNA blood gas)'.(en)</items><items id="description">*Name of the laboratory investigation performed on the specimen(s).(en)</items><items id="text">*Test name(en)</items></items><items code="at0017"><items id="comment">*This slot is intended to carry details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.&#13;
&#13;
The receiving laboratory may either perform the test or refer it to another laboratory. Where a different laboratory is responsible for performing the testing on specific analytes, it would be expected that these details would be carried in the 'Analyte result detail' SLOT within the CLUSTER.laboratory_test_analyte archetype.&#13;
&#13;
(en)</items><items id="description">*Details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.(en)</items><items id="text">*Receiving laboratory(en)</items></items><items code="at0035"><items id="comment">*The 'Distribution list' is for information-only, and that the primary recipient of the report is the person intended to act on the information.(en)</items><items id="description">*Details of additional clinicians or organisations who require a copy of the test result.(en)</items><items id="text">*Distribution list(en)</items></items><items code="at0037"><items id="description">*This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.(en)</items><items id="text">*Partial(en)</items></items><items code="at0038"><items id="description">*The Test result is complete and verified by an authorised person.(en)</items><items id="text">*Final(en)</items></items><items code="at0040"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist, and result data has been changed.(en)</items><items id="text">*Amended(en)</items></items><items code="at0057"><items id="comment">*For example: 'Pattern suggests significant renal impairment'. The content of the conclusion will vary, depending on the investigation performed. This conclusion should be aligned with the coded 'Test diagnosis'.(en)</items><items id="description">*Narrative description of the key findings.(en)</items><items id="text">*Conclusion(en)</items></items><items code="at0062"><items id="comment">*Equivalent to the HL7 Placer Order Identifier.(en)</items><items id="description">*The local identifier assigned by the requesting clinical system.(en)</items><items id="text">*Requester order identifier(en)</items></items><items code="at0063"><items id="comment">*Assigning an identifier to a request by the Laboratory lnformation System (LIS) enables tracking progress of the request and enables linking results to requests. It also provides a reference to assist with enquiries and it is usually equivalent to the HL7 Filler Order Identifier.(en)</items><items id="description">*The local identifier assigned to the test order by the order filler, usually by the Laboratory Information System (LIS).(en)</items><items id="text">*Receiver order identifier(en)</items></items><items code="at0065"><items id="comment">*If the specimen type is sufficiently specified with a code in the Test name, then this additional data is not required. Linking results to specific specimens may be recorded using 'Specimen identifier' elements in both the CLUSTER.specimen and the various results CLUSTER archetypes.(en)</items><items id="description">*Details about the physical substance that has been analysed.(en)</items><items id="text">*Specimen detail(en)</items></items><items code="at0068"><items id="comment">*This identifier is an internal tracking number assigned by the LIS, and it not intended to be the name of the test.(en)</items><items id="description">*A local identifier assigned by the receiving Laboratory Information System (LIS) to track the test process.(en)</items><items id="text">*Laboratory internal identifier(en)</items></items><items code="at0073"><items id="comment">*The values have been specifically chosen to match those in the HL7 FHIR Diagnostic report, historically derived from HL7v2 practice. Other local codes/terms can be used via the Text 'choice'.&#13;
&#13;
This element is multiple occurrence to cater for the use cases where statuses for different aspects of the result have been split into several elements.(en)</items><items id="description">*The status of the laboratory test result as a whole.(en)</items><items id="text">*Overall test status(en)</items></items><items code="at0074"><items id="description">*The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').(en)</items><items id="text">*Cancelled(en)</items></items><items code="at0075"><items id="description">*The date and/or time that ‘Overall test status’ was issued.(en)</items><items id="text">*Overall test status timestamp(en)</items></items><items code="at0077"><items id="comment">*This is intended to be a general categorisation and not to capture the organisational name of the laboratory. For example: anatomical pathology, immunology and transfusion medicine, medical microbiology, clinical pharmacology, medical genetics, medical biochemistry. Alternatively more granular sub categories or sub disciplines, such as endocrinology, haematology, and allergology services, may be used. This may assist clinicians in filtering between categories of results. Coding with a terminology is desirable, where possible.(en)</items><items id="description">*The diagnostic service or discipline that is responsible for the laboratory test result.(en)</items><items id="text">*Diagnostic service category(en)</items></items><items code="at0090"><items id="description">*Details of the clinician or organisation requesting the laboratory test result.(en)</items><items id="text">*Requester(en)</items></items><items code="at0094"><items id="comment">*In most situations there is one test request and a single corresponding test result, however this repeating cluster allows for the situation where there may be multiple test requests reported using a single test result.&#13;
&#13;
As an example: 'a clinician asks for blood glucose in one request and Urea/electrolytes in a second request, but the lab analyser does both and the lab wishes to report these together'.(en)</items><items id="description">*Details about the test request.(en)</items><items id="text">*Test request details(en)</items></items><items code="at0097"><items id="comment">*This SLOT may carry an individual analyte, a group, panel or battery of multiple analytes, or a more complex and specific structure.(en)</items><items id="description">*Results of the test performed on the specimen(s).(en)</items><items id="text">*Test result(en)</items></items><items code="at0098"><items id="comment">*For example: 'Severe hepatic impairment', 'Salmonella contamination'. Coding of the diagnosis with a terminology is strongly recommended, where possible. This diagnosis should be aligned with the narrative in the 'Conclusion'.(en)</items><items id="description">*Single word, phrase or brief description that represents the clinical meaning and significance of the laboratory test result.(en)</items><items id="text">*Test diagnosis(en)</items></items><items code="at0100"><items id="comment">*This data element may include a link to the original clinical information provided in the test request.(en)</items><items id="description">*Description of clinical information available at the time of interpretation of results.(en)</items><items id="text">*Clinical information provided(en)</items></items><items code="at0101"><items id="description">*Additional narrative about the test result not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0106"><items id="comment">*This data element is to be used when the test requested differs from the test actually performed by the laboratory.(en)</items><items id="description">*Name of the original laboratory test requested.(en)</items><items id="text">*Original test requested name(en)</items></items><items code="at0107"><items id="description">*The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.(en)</items><items id="text">*Registered(en)</items></items><items code="at0110"><items id="comment">*For example: 'details of ELISA/nephelometry'.(en)</items><items id="description">*Structured details about the method of analysis, device or interpretation used.(en)</items><items id="text">*Testing details(en)</items></items><items code="at0111"><items id="comment">*True if the test was performed directly at Point-of-Care (POCT).(en)</items><items id="description">*This indicates whether the test was performed directly at Point-of-Care (POCT) as opposed to a formal result from a laboratory or other service delivery organisation.(en)</items><items id="text">*Point-of-care test(en)</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">*'Confounding factors' should be reserved for uncontrolled/unplanned issues of patient state/physiology that might affect interpretation, for example 'recent exercise' or 'recent tobacco smoking'.&#13;
&#13;
Known or required preconditions, such as 'fasting' should be carried in the 'Sampling conditions' element within the CLUSTER.specimen archetype . In some cases preconditions are captured as part of the test name, for example 'Fasting blood glucose'.&#13;
&#13;
Known issues with specimen collection or handling, such as 'prolonged use of tourniquet' or 'sample haemolysed', should be carried in the 'Specimen quality' elements within CLUSTER.specimen archetype.&#13;
&#13;
Coding with a terminology is desirable, where possible.(en)</items><items id="description">*Issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0114"><items id="comment">*For example: Last Normal Menstrual Period (LNMP).(en)</items><items id="description">*Details of issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Structured confounding factors(en)</items></items><items code="at0115"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist. This is a sub-category of 'Amended'.(en)</items><items id="text">*Corrected(en)</items></items><items code="at0116"><items id="description">*The Test Result has been withdrawn following previous Final release.(en)</items><items id="text">*Entered in error(en)</items></items><items code="at0117"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0118"><items id="comment">*Multiple formats are allowed but they should represent equivalent clinical content.(en)</items><items id="description">*Digital image, video or diagram representing the test result.(en)</items><items id="text">*Multimedia representation(en)</items></items><items code="at0119"><items id="description">*Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.(en)</items><items id="text">*Appended(en)</items></items><items code="at0120"><items id="description">*Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.(en)</items><items id="text">*Preliminary(en)</items></items><items code="at0121"><items id="comment">*Coding with a terminology is desirable, where possible.(en)</items><items id="description">*Description about the method used to perform the test.(en)</items><items id="text">*Test method(en)</items></items><items code="at0122"><items id="comment">*For example: Anatomical pathology diagnoses consisting of several different axes such as morphology, etiology and function.(en)</items><items id="description">*A structured or complex diagnosis for the laboratory test.(en)</items><items id="text">*Structured test diagnosis(en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="description">Resultatet av en undersökning, inklusive fynd och laboratoriets tolkning, utförd på provmaterial från en individ eller relaterad till individen. Exempel på provmaterial relaterat till individen kan vara fostervattenprov där provet tas från mammans kropp men provet avser fostret.</items><items id="text">Laboratorieresultat</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items><items id="text">Ospecificerad händelse</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">Undersökningsnamnet kan täcka ett enda resultat eller en grupp resultat. Analysnamnet kan kodas med medicinska kodningssystem som NPU, LOINC, SNOMED CT eller lokala laboratoriekodningssystem. Exempel kan vara "P-Glukos", "Blodgas", "Klorid i svett", "Kortisol (morgon)" eller "Histopatologi malignt melanom". Namnet kan ibland innehålla typen av provmaterial och patientstatus, såsom "fP-Glukos" eller innehålla annan information, såsom "pO2 (PNA-blodgas)".</items><items id="description">Namnet på den laboratorieundersökning eller -analys som utförts på provmaterialet.</items><items id="text">Undersökningsnamn</items></items><items code="at0017"><items id="comment">Denna SLOT är avsedd för detaljer om det laboratorium som har mottagit beställningen och som har det övergripande ansvaret för att lämna in en resultatrapport, även om andra laboratorier utför specifika delar av den.&#13;
&#13;
Det ansvariga laboratoriet kan antingen utföra undersökningarna själv eller vidarebefordra dem till andra laboratorier. Om ett annat laboratorium har utfört specifika undersökningar ska information om detta beskrivas i SLOT "Detaljer om analysresultat" i arketypen CLUSTER.laboratory_test_analyte.&#13;
</items><items id="description">Detaljer om det laboratorium som har mottagit beställningen och som har det övergripande ansvaret för att hantera rapporteringen av undersökningen, även om andra laboratorier utför specifika delar av beställningen.</items><items id="text">Ansvarigt laboratorium</items></items><items code="at0035"><items id="comment">Personerna eller organisationerna på distributionslistan får endast svaret för information, och det är huvudmottagaren av rapporten som förväntas agera på den.</items><items id="description">Detaljer om ytterligare kliniker eller organisationer som behöver en kopia av undersökningsresultatet.</items><items id="text">Distributionslista</items></items><items code="at0037"><items id="description">Detta är ett partiellt undersökningsresultat, dvs. initialt, interim eller preliminärt. Resultatdata kan vara ofullständiga eller obekräftade.</items><items id="text">Partiell</items></items><items code="at0038"><items id="description">Undersökningsresultatet är fullständigt och verifierat av ansvarig person alternativt autoverifierat maskinellt.</items><items id="text">Slutgiltig</items></items><items code="at0040"><items id="description">Det slutgiltiga undersökningsresultatet har reviderats. Denna status har underkategorierna "Rättad" och "Utökad".</items><items id="text">Reviderad</items></items><items code="at0057"><items id="comment">Till exempel "resultat indikerar signifikant nedsatt njurfunktion". Tolkningen av resultatet kommer att variera beroende på vilken undersökning som har genomförts. Slutsatsen ska vara i enlighet med de koder som används i dataelementet "Undersökningsdiagnos".</items><items id="description">Berättande textuell beskrivning av de viktigaste resultaten.</items><items id="text">Tolkning av resultat</items></items><items code="at0062"><items id="comment">Denna identifierare benämns ofta som remissidentifierare, och motsvarar HL7 "Placer Order Identifier".</items><items id="description">Den lokala identifierare som tilldelats av det begärande kliniska systemet.</items><items id="text">Beställarens beställningsidentifierare</items></items><items code="at0063"><items id="comment">Tilldelningen av en identifierare i LIS möjliggör spårning av beställningens status och länkning av resultaten till beställningen. Det tillåter också hantering av ytterligare förfrågningar och motsvarar "HL7 Filler Order Identifier".</items><items id="description">Den lokala identifierare som tilldelats beställningen av ordermottagningssystemet, vanligtvis av laboratorieinformationssystemet (LIS).</items><items id="text">Mottagarens beställningsidenitifierare</items></items><items code="at0065"><items id="comment">Om provmaterialet är tillräckligt specificerat med en kod i undersökningssnamnet är detta dataelement inte nödvändigt. Det är möjligt att länka svar till specifika prover med hjälp av dataelementen för prov-ID i både CLUSTER.Specimen och olika CLUSTER-arketyper för laboratoriesvar.</items><items id="description">Detaljer om det provmaterial som har analyserats.</items><items id="text">Detaljer om provmaterialet</items></items><items code="at0068"><items id="comment">Denna identifierare är ett internt spårningsnummer som tilldelats av LIS och är inte avsett att vara namnet på undersökningen.</items><items id="description">En lokal identifierare som tilldelats av det mottagande laboratorieinformationssystemet (LIS) för att spåra analysprocessen.</items><items id="text">Laboratoriets interna identifierare</items></items><items code="at0073"><items id="comment">Värdena har valts specifikt för att motsvara värdena i HL7 FHIR-resursen "Diagnostic Report", som historiskt kommer från HL7 v2. Andra lokala koder eller termer kan användas med datatypen "Fri eller kodad text".&#13;
&#13;
Detta element kan upprepas för att stödja applikationer där status för olika aspekter av resultatet delas in i flera element.</items><items id="description">Status för undersökningsresultaten som helhet.</items><items id="text">Status undersökningsresultat</items></items><items code="at0074"><items id="description">Resultatet är inte tillgängligt eftersom undersökningen inte har startats eller inte slutförts.</items><items id="text">Avbruten</items></items><items code="at0075"><items id="description">Datum och tid för utfärdandet av övergripande resultatstatus.</items><items id="text">Tidpunkt för status undersökningsresultat</items></items><items code="at0077"><items id="comment">Detta är tänkt att vara en allmän kategorisering och inte att fånga laboratoriets interna organisation. Till exempel: patologi, immunologi och transfusionsmedicin, medicinsk mikrobiologi, klinisk farmakologi, medicinsk genetik, medicinsk biokemi. Alternativt kan mer detaljerade underkategorier eller underdiscipliner såsom endokrinologi, hematologi och allergologitjänster användas. Detta kan hjälpa kliniker att filtrera mellan resultatkategorier. Kodning med en terminologi är önskvärd, där det är möjligt.&#13;
</items><items id="description">Den diagnostiska organisationsenhet, laboratoriedisciplin eller underdisciplin som ansvarar för laboratorieresultatet.&#13;
</items><items id="text">Laboratoriedisciplin</items></items><items code="at0090"><items id="description">Uppgifter om den kliniker eller organisation som beställt undersökningen.</items><items id="text">Beställare</items></items><items code="at0094"><items id="comment">I de flesta situationer finns det en beställning och ett motsvarande svar, men under vissa omständigheter kan flera beställningar representeras med en enda arketyp för laboratorieresultat.&#13;
&#13;
Till exempel kan en kliniker beställa "glukos" och "urea och elektrolyter" i separata beställningar och laboratoriet utför båda analyserna, men skickar endast en övergripande resultatrapport.</items><items id="description">Detaljer om beställningen.</items><items id="text">Beställningsdetaljer</items></items><items code="at0097"><items id="comment">Denna SLOT kan innehålla resultat för en enda analys, för en grupp analyser eller för en mer komplex och specifik struktur.</items><items id="description">Resultatet av den undersökning eller analys som utförts på provmaterialet.</items><items id="text">Undersökningsresultat</items></items><items code="at0098"><items id="comment">Till exempel: "Allvarligt nedsatt leverfunktion", "Akut hepatit B". Kodning med en terminologi är att föredra där det är möjligt. Undersökningsdiagnosen bör vara i enlighet med texten i "Tolkning av resultat".&#13;
&#13;
</items><items id="description">Ett ord, en fras eller en kort beskrivning som representerar den kliniska betydelsen eller konsekvensen av laboratorietestresultatet.&#13;
</items><items id="text">Undersökningsdiagnos</items></items><items code="at0100"><items id="comment">Detta dataelement kan innehålla en länk till den ursprungliga kliniska informationen i beställningen.&#13;
&#13;
</items><items id="description">Beskrivning av den kliniska information som finns tillgänglig vid tolkningen av resultaten.</items><items id="text">Tillgänglig klinisk information</items></items><items code="at0101"><items id="description">Ytterligare textuell beskrivning som inte registrerats i andra fält.</items><items id="text">Kommentar</items></items><items code="at0106"><items id="comment">Detta dataelement ska användas när den begärda undersökningen eller analysen skiljer sig från det som faktiskt har utförts av laboratoriet.&#13;
</items><items id="description">Namn på den ursprungligen beställda undersökningen eller analysen.</items><items id="text">Ursprungligt undersökningsnamn</items></items><items code="at0107"><items id="description">Undersökningen är registrerad i laboratorieinformationssystemet, men resultatet finns för närvarande inte.&#13;
&#13;
</items><items id="text">Registrerad</items></items><items code="at0110"><items id="comment">Exempelvis "detaljer om ELISA-analys".</items><items id="description">Strukturerade detaljer om undersökningsmetoden, utrustningen eller tolkningen.</items><items id="text">Detaljer om undersökningsmetod</items></items><items code="at0111"><items id="comment">Sant om analysen utfördes genom patientnära analys (PNA).</items><items id="description">Indikerar om analysen utfördes som en patientnära analys (PNA), det vill säga på vårdenhet, istället för en mer formell laboratorietjänst.</items><items id="text">Patientnära analys</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">"Möjliga felkällor" bör reserveras för okontrollerade eller oplanerade förhållanden hos patienten som kan påverka tolkningen av laboratorieresultatet. Till exempel "nyligen fysisk aktivitet", "nyligen rökt tobak".&#13;
&#13;
Kända antaganden såsom "fasta" bör dokumenteras i dataelementet "Provtagningskontext" i arketypen CLUSTER.specimen. I vissa fall är sådana antaganden en del av studiens namn, såsom "Fastande blodglukos".&#13;
&#13;
Kända förhållanden relaterade till provtagning eller hantering av provet, såsom "förlängd stas" eller "hemolys" bör dokumenteras i elementet "Provkvalitet" i arketypen CLUSTER.specimen.&#13;
&#13;
Kodning med en terminologi är önskvärt där det är möjligt.&#13;
</items><items id="description">Villkor eller omständigheter som påverkar tolkningen av laboratorieresultatet.</items><items id="text">Möjliga felkällor</items></items><items code="at0114"><items id="comment">Till exempel den sista normala menstruationsperioden.</items><items id="description">Mer information om problem eller omständigheter som kan påverka tolkningen av mätningen eller testresultatet.</items><items id="text">Strukturerade möjliga felkällor</items></items><items code="at0115"><items id="description">Det slutgiltiga undersökningsresultatet har rättats. Detta är en underkategori av "Reviderad".</items><items id="text">Rättad</items></items><items code="at0116"><items id="description">Undersökningsresultatet har dragits tillbaka efter att ha varit i status "Slutgiltig".</items><items id="text">Felregistrerad</items></items><items code="at0117"><items id="comment">Exempelvis lokala informationsbehov eller ytterligare metadata för att möjliggöra mappning till FHIR- eller CIMI-modeller.&#13;
</items><items id="description">Ytterligare information som krävs för att registrera lokalt definierat innehåll eller för anpassning till andra referensmodeller.&#13;
</items><items id="text">Ytterligare information</items></items><items code="at0118"><items id="comment">Flera format är tillåtna, men innehållet i de olika formaten måste representera samma kliniska innehåll.</items><items id="description">Digital bild, video eller diagram som representerar undersökningsresultatet.</items><items id="text">Multimedia</items></items><items code="at0119"><items id="description">Det slutgiltiga undersökningsresultatet har ändrats genom att nytt innehåll har inkluderats. Det befintliga innehållet är oförändrat. Detta är en underkategori av "Reviderad".</items><items id="text">Utökat</items></items><items code="at0120"><items id="description">Verifierade tidiga resultat är tillgängliga, men inte alla resultat är slutgiltiga. Detta är en underkategori av status "Partiell".</items><items id="text">Preliminär</items></items><items code="at0121"><items id="comment">Kodning med en terminologi är önskvärt där det är möjligt.</items><items id="description">Beskrivning av den metod som använts för att utföra undersökningen eller analysen.</items><items id="text">Undersökningsmetod</items></items><items code="at0122"><items id="comment">Exempelvis patologisk anatomisk diagnos bestående av flera olika komponenter som morfologi, etiologi och funktion.</items><items id="description">En strukturerad eller komplex diagnos för laboratorieundersökningen.</items><items id="text">Strukturerad undersökningsdiagnos</items></items></term_definitions><term_definitions language="zh-cn"><items code="at0000"><items id="description">旨在用于记录对于从个人身上所采集的标本或者与该个人相关的标本进行检验的结果，包括结果所见/发现和实验室的解释。</items><items id="text">实验室检验结果</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">可以在模板之中或者在运行时加以明确定义的，默认的，未明示的时间点或时间区间事件。</items><items id="text">任何事件</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">检验结果可能代表的是单独一种分析物或者是一组项目/分析物，包括成套的检验项目（组套检验项目）。强烈建议采用特定的术语标准（如 LOINC 或 SNOMED CT）对“检验项目名称”加以编码。例如：“葡萄糖”、“尿素和电解质”、“拭子”、“皮质醇 （上午）”、“汗液钾离子”或“黑色素瘤组织病理学”。检验项目名称之中有时可能会包括标本类型和患者状态，如“空腹血糖”，或者是包括其他的信息，如“钾（PNA 血气）”。</items><items id="description">针对标本所进行的实验室检验项目的名称。</items><items id="text">检验项目名称</items></items><items code="at0017"><items id="comment">此槽位旨在记录关于当时接收了相应的检验申请并整体负责管理当前检验项目的报告工作的实验室的详情，即使其他实验室执行其中的特定方面。&#13;
&#13;
接收方实验室可能会自身来执行当前的检验项目，或者也可能将其转交给其他的实验室。如果其他实验室负责检测特定的分析物，则应当期望这些详情包含在群簇型实验室检验项目分析物原始型（CLUSTER.laboratory_test_analyte）里的分析物结果详情槽位“Analyte result detail”之中。</items><items id="description">关于当时接收了相应的检验申请并整体负责管理当前检验项目的报告工作的实验室的详情，即使其他实验室执行其中的特定方面。</items><items id="text">接收方实验室</items></items><items code="at0035"><items id="comment">“分发列表”仅供参考，报告的首要接收方则是意在依据当前的实验室检验结果采取行动的人员。</items><items id="description">其他那些要求获得当前实验室检验结果的临床医生或组织机构。</items><items id="text">分发列表</items></items><items code="at0037"><items id="description">当前还属于部分的（比如，初始的、暂时的或初步的）检验结果：检验结果之中的数据可能不完整或者未经核对。</items><items id="text">部分</items></items><items code="at0038"><items id="description">检验结果完整且经过授权人员的核对或者说审核。</items><items id="text">最终</items></items><items code="at0040"><items id="description">结果在达到最终状态之后已被修改，是完整的结果，经过了负责的病理学工作人员的核对，且已经更改了结果数据。</items><items id="text">经过修正</items></items><items code="at0057"><items id="comment">例如：“[所观察到的]模式表明存在显著的肾脏损害”。结论的内容会根据所进行的检查而有所不同。此项结论应当与编码型的检验项目诊断数据元“Test diagnosis”保持一致。</items><items id="description">关于关键所见/发现的文字叙述型描述。</items><items id="fhir_mapping">*DiagnosticReport.conclusion(en)</items><items id="text">结论</items></items><items code="at0062"><items id="comment">等价于HL7申请方医嘱标识符（ Placer Order Identifier）。</items><items id="description">申请方临床系统所赋予当前检验项目医嘱/申请的本地标识符。</items><items id="text">申请方医嘱标识符</items></items><items code="at0063"><items id="comment">实验室信息系统（ Laboratory Information System，LIS）为检验项目医嘱/申请赋予标识符，将便于实现对于申请进展情况的跟踪以及结果与相应医嘱/申请的链接。同时，这也是有助于查询的一种参考信息（reference），且通常等价于HL7执行方医嘱标识符（Filler Order Identifier）。</items><items id="description">医嘱执行方赋予当前检验项目医嘱/申请的本地标识符。其中，医嘱执行方通常为实验室信息系统（ Laboratory Information System，LIS）。</items><items id="text">接收方医嘱标识符</items></items><items code="at0065"><items id="comment">如果利用检验项目名称之中的代码可以充分明确相应的标本类型，则不需要此项附加的数据。可以采用群簇型标本原始型（CLUSTER.specimen）和各种的群簇型结果原始型之中的标本标识符元素“Specimen identifier”元素来记录关于将结果链接到特定标本的信息。</items><items id="description">关于所已经分析的物质的详情。</items><items id="text">标本详情</items></items><items code="at0068"><items id="comment">该标识符属于是实验室信息系统（Laboratory Information System，LIS）所分配的内部追踪编号，但并非旨在作为检验项目的名称。</items><items id="description">接收方实验室信息系统（Laboratory Information System，LIS）所分配的本地标识符，用于跟踪检验过程。</items><items id="text">实验室内部标识符</items></items><items code="at0073"><items id="comment">这些编码型取值是经过专门挑选的，以与 HL7 FHIR 诊断报告资源之中的取值相匹配，而在历史上这些取值源自 HL7v2 实践。另外，可以借助于文本型选项“choice”来使用其他的本地代码/术语。&#13;
&#13;
本数据元可以多次出现，以适应那些将结果不同方面的状态拆分成多个数据元的用例。</items><items id="description">当前的实验室检验项目作为整体的状态</items><items id="text">检验项目总体状态</items></items><items code="at0074"><items id="description">当前结果不可用，因为该检验项目并未开始或者并未完成（有时又称为“取消”、“已中止”或“已放弃”）。</items><items id="text">已撤销</items></items><items code="at0075"><items id="description">发布检验项目总体状态时的日期和/或时间。</items><items id="text">检验项目总体状态时间戳</items></items><items code="at0077"><items id="comment">本数据元旨在进行一般的分类，而并非旨在记录实验室的组织结构名称。例如：解剖病理学、免疫学、输血医学、医学微生物学、临床药理学、医学遗传学、医学生物化学。或者，还可以采用粒度更精细的子类别或子学科，如内分泌学、血液学和变态反应学服务。此项数据可能有助于临床医生在结果类别之间进行筛选。最好尽可能采用特定的术语标准加以编码。</items><items id="description">负责当前实验室检验结果的诊断服务或学科。</items><items id="text">诊断服务类别</items></items><items code="at0090"><items id="description">关于申请当前实验室检验项目（结果）的临床医生或组织机构的详情。</items><items id="text">申请方</items></items><items code="at0094"><items id="comment">在大多数情况下，每份检验请求分别会有相应的单独一项检验结果。不过，这个可重复的群簇允许存在检验结果只有一份[报告]而报告所针对的却是多份检验请求的情况。&#13;
&#13;
例如：医生在一份申请当中要求检测血糖，而在另一份申请中则要求检测尿素/电解质，而实验室分的析仪则会同时处理这两份申请，并且实验室希望将二者一并加以报告。</items><items id="description">关于检验申请的详情。</items><items id="text">检验申请详情</items></items><items code="at0097"><items id="comment">此槽位之中可以包含的是单个的分析物、多个分析物所构成的组合或组套，或者是更为复杂的特定结构。</items><items id="description">针对标本所进行的检验项目的结果。</items><items id="text">检验结果</items></items><items code="at0098"><items id="comment">例如：“严重肝脏损害”、“沙门菌污染”。强烈建议尽可能采用特定的术语标准对此项诊断加以编码。此项诊断应当与结论数据元“Conclusion”之中的文字叙述保持一致。</items><items id="description">代表实验室测试结果的临床含义和意义/重要性的单词、短语或简短描述。</items><items id="text">检验项目诊断</items></items><items code="at0100"><items id="comment">本数据元之中可以包含指向相应检验项目申请之中所提供的原始临床信息的链接。</items><items id="description">关于解释结果时可用的临床信息的描述。</items><items id="fhir_mapping">*DiagnosticReport.requestDetail.clinicalNotes(en)</items><items id="text">已提供的临床信息</items></items><items code="at0101"><items id="description">关于其他字段之中并未采集/记录的，关于当前检验结果的其他文字叙述型内容。</items><items id="text">注释</items></items><items code="at0106"><items id="comment">当所申请的检验项目与实验室实际执行的检验项目不同时，应当会用到本数据元。</items><items id="description">所申请的原始实验室检验项目的名称。</items><items id="text">原始申请检验项目名称</items></items><items code="at0107"><items id="description">表示当前检验项目的存在情况已在实验室信息系统之中进行了登记，但目前尚无任何可用的信息。</items><items id="text">已登记</items></items><items code="at0110"><items id="comment">例如：关于ELISA/散射比浊法的详情。</items><items id="description">关于所采用的分析方法、仪器设备或解释的结构化详情。</items><items id="text">检验详情</items></items><items code="at0111"><items id="comment">如果当前的检验项目是在是床旁（Point-of-Care，POCT）直接进行的，则取值为真（True）。</items><items id="description">此项数据元旨在表明当前的检验项目究竟是床旁（Point-of-Care，POCT）直接进行的检验项目，而不是实验室或其他服务机构/部门/科室所提供的正式结果。</items><items id="text">床旁检验项目</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">应当将混杂因素数据元“”保留用于那些可能影响结果解释的，患者状态/生理[机能]的未加控制/意外的问题，如 '近期的锻炼' 或 '近期的吸烟'。&#13;
&#13;
对于已知或所需的前提条件，如“禁食”，应当采用群簇型标本原始型（CLUSTER.specimen）之中的采样条件数据元'Sampling conditions' 来加以记录。在某些情况下，可能会将前提条件作为检验项目名称的一部分来加以记录，如 '空腹血糖'。&#13;
&#13;
对于标本采集或处理方面的已知问题，如“止血带使用时间过长”或“标本溶血”，应当采用群簇型标本原始型（CLUSTER.specimen）之中的标本质量数据元'Sampling conditions'元素来加以记录。&#13;
&#13;
最好尽可能采用特定的术语标准来加以编码。</items><items id="description">影响当前监测/测量结果或检验结果准确解释的问题或情况。</items><items id="text">混杂因素</items></items><items code="at0114"><items id="comment">例如：最后一次正常的月经周期 (Last Normal Menstrual Period，LNMP)。</items><items id="description">关于那些影响检测/测量结果或检验结果准确解释的问题或情况的详情。</items><items id="text">结构化混杂因素</items></items><items code="at0115"><items id="description">结果在达到最终状态之后已被修改，是完整的结果，经过了负责的病理学工作人员的核对。这是“经过修正”类别的一个子类别。</items><items id="text">经过更正</items></items><items code="at0116"><items id="description">当前检验结果在此前最终发布之后已被撤销。</items><items id="text">错误录入</items></items><items code="at0117"><items id="comment">例如：旨在实现与FHIR或CIMI等效项进行协调统一的，本地信息需求或额外的元数据。</items><items id="description">采集本地内容或者实现与其他参考模型/形式化体系之间进行协调统一所额外需的其他信息。</items><items id="text">扩展</items></items><items code="at0118"><items id="comment">允许采用多种的格式，但它们应当都表现的是等价的临床内容。</items><items id="description">表现当前检验结果的数字图像、视频或图表。</items><items id="fhir_mapping">*DiagnosticReport.presentedForm(en)</items><items id="text">多媒体表现</items></items><items code="at0119"><items id="description">在达到最终状态之后，因为添加新的内容而造成报告的修改。已有的内容并未发生变更。这是“经过修正”类别的一个子类别。</items><items id="text">经过追加</items></items><items code="at0120"><items id="description">已有经过核对的早期/初步结果可用，但并非所有的结果都属于是最终结果。这是“部分”类别的一个子类别。</items><items id="text">初步</items></items><items code="at0121"><items id="comment">最好尽可能采用特定的术语标准来加以编码。</items><items id="description">关于进行当前检验项目时所采用的方法的描述。</items><items id="text">检验方法</items></items><items code="at0122"><items id="comment">例如：由多个不同的轴（如形态学、病因学和功能）所组成的解剖病理学诊断。</items><items id="description">当前实验室检验项目的结构化诊断或复杂诊断。</items><items id="text">结构化检验项目诊断</items></items></term_definitions></component_ontologies></template>