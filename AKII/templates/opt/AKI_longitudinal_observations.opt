nitions><term_definitions code="at0028"><items id="comment">For example: Urinary drainage bag.</items><items id="description">Details of the device used to measure the fluid output.</items><items id="text">Measurement device</items></term_definitions><term_definitions code="at0031"><items id="description">The approach used to quantify the volume of fluid.</items><items id="text">Method</items></term_definitions><term_definitions code="at0032"><items id="description">Additional narrative about the fluid output not captured in other fields.</items><items id="text">Comment</items></term_definitions><term_definitions code="at0033"><items id="comment">For example: a urinary catheter or a drain tube.</items><items id="description">Details of the device that was used to collect the fluid.</items><items id="text">Output device</items></term_definitions><term_definitions code="at0035"><items id="comment">If absorbant material, such as diapers and dressings, are weighed as part of managing fluid loss estimates, the weight will need to be converted to a volume for recording.</items><items id="description">The volume of fluid.</items><items id="text">Volume</items></term_definitions><term_definitions code="at0036"><items id="comment">For example: urine or vomit. Coding of fluid name with a terminology is preferred, if possible.</items><items id="description">Identification of the fluid lost or excreted.</items><items id="text">Fluid name</items></term_definitions><term_definitions code="at0038"><items id="comment">For example: the colour of the urine.&#13;
</items><items id="description">Additional details about the fluid, including macroscopic appearance or other tests not currently captured in the structured data.</items><items id="text">Fluid details</items></term_definitions><term_definitions code="at0040"><items id="comment">e.g. Local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></term_definitions><term_definitions code="at0041"><items id="comment">For example: drain tube; urinary catheter or nasopharyngal tube. In a clinical application, if the same type of fluid is being observed from two or more sources such as multiple drains from the same wound, the source may be described as “Drain tube 1” and “Drain tube 2”. Coding of the source with a terminology is preferred, where possible.</items><items id="description">The source from which the fluid is lost or excreted.</items><items id="text">Source</items></term_definitions></children><children xsi:type="C_ARCHETYPE_ROOT"><rm_type_name>OBSERVATION</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences><node_id>at0000</node_id><attributes xsi:type="C_SINGLE_ATTRIBUTE"><rm_attribute_name>data</rm_attribute_name><existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>HISTORY</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1<