cluded>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>0</upper></occurrences><node_id>at0020</node_id></children><children xsi:type="C_COMPLEX_OBJECT"><rm_type_name>CLUSTER</rm_type_name><occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>0</upper></occurrences><node_id>at0027</node_id></children><cardinality><is_ordered>true</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></interval></cardinality></attributes></children></attributes><archetype_id><value>openEHR-EHR-OBSERVATION.body_weight.v2</value></archetype_id><term_definitions code="at0000"><items id="description">Measurement of the body weight of an individual.</items><items id="text">Body weight</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></term_definitions><term_definitions code="at0002"><items id="description">@ internal @</items><items id="text">history</items></term_definitions><term_definitions code="at0003"><items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items><items id="text">Any event</items></term_definitions><term_definitions code="at0004"><items id="description">The weight of the individual.</items><items id="text">Weight</items></term_definitions><term_definitions code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></term_definitions><term_definitions code="at0009"><items id="description">Description of the state of dress of the person at the time of weighing.</items><items id="text">State of dress</items></term_definitions><term_definitions code="at0010"><items id="description">Clothing which may add significantly to weight, including shoes.</items><items id="text">Fully clothed, including shoes</items></term_definitions><term_definitions code="at0011"><items id="description">Clothing which will not add to weight significantly.</items><items id="text">Lightly clothed/underwear</items></term_definitions><term_definitions code="at0013"><items id="description">Without any clothes.</items><items id="text">Naked</items></term_definitions><term_definitions code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></term_definitions><term_definitions code="at0017"><items id="description">Wearing only a nappy - which may add significantly to weight.</items><items id="text">Nappy/diaper</items></term_definitions><term_definitions code="at0020"><items id="description">Details about the weighing device.</items><items id="text">Device</items></term_definitions><term_definitions code="at0024"><items id="description">Additional narrative about the measurement of Body weight, not captured in other fields.</items><items id="text">Comment</items></term_definitions><term_definitions code="at0025"><items id="description">Record any issues or factors that may impact on the measurement of body weight eg timing in menstrual cycle, timing of recent bowel motion or noting of amputation.</items><items id="text">Confounding factors</items></term_definitions><term_definitions code="at0026"><items id="description">Usually the first weight, measured soon after birth. This event will only be used once per health record&#13;
.</items><items id="text">Birth</items></term_definitions><term_definitions code="at0027"><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></term_definitions><term_definitions code="at0028"><items id="description">Clothing which may add significantly to weight.</items><items id="text">Fully clothed, without shoes</items></term_definitions><term_bindings terminology="LOINC"><items code="at0004"><value><terminology_id><value>LOINC</value></terminology_id><code_string>29463-7</code_string></value></items></term_bindings></children><cardinality><is_ordered>true</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></interval></cardinality></attributes><archetype_id><value>openEHR-EHR-COMPOSITION.encounter.v1</value></archetype_id><term_definitions code="at0000"><items id="description">Interaction, contact or care event between a subject of care and healthcare provider(s).</items><items id="text">Encounter</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0002"><items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items><items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items><items id="text">Extension</items></term_definitions></definition><ontology archetype_id="openEHR-EHR-COMPOSITION.encounter.v1"><term_definitions language="ar-sy"><items code="at0000"><items id="description">*Interaction, contact or care event between a subject of care and healthcare provider(s).(en)</items><items id="text">*Encounter(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="description">Interacció, contacte o esdeveniment d’atenció entre un pacient i un o més professionals d'atenció sanitària.</items><items id="text">Encontre</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensió</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="description">Interaktion, Kontakt oder Versorgungsereignis, zwischen einem Versorgungsempfänger und einem Gesundheitsdienstleister.</items><items id="text">Kontakt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Erweiterung</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">Interaction, contact or care event between a subject of care and healthcare provider(s).</items><items id="text">Encounter</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items><items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items><items id="text">Extension</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="description">Interacción, contacto o evento de cuidado entre un paciente y un proveedor de salud.</items><items id="text">Encuentro</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensión</items></items></term_definitions><term_definitions language="es-ar"><items code="at0000"><items id="description">Interacción, contacto o evento de cuidados entre un sujeto de cuidados y uno o más proveedores de cuidados de la salud.</items><items id="text">Encuentro</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensión</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="description">Hoitohenkilön ja terveydenhuollon tarjoajan välinen vuorovaikutus, kontakti- tai hoitotapahtuma.</items><items id="text">Kontakti</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Laajennus</items></items></term_definitions><term_definitions language="fr"><items code="at0000"><items id="description">Interaction, contact ou événement de soins entre un sujet de soins et un ou des prestataires de soins.</items><items id="text">Rencontre</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extension</items></items></term_definitions><term_definitions language="it"><items code="at0000"><items id="description">Interazione, contatto o evento di cura tra un soggetto di cura e il/i fornitore/i di assistenza sanitaria.</items><items id="text">Contatto</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Estensione</items></items></term_definitions><term_definitions language="ko"><items code="at0000"><items id="description">*Interaction, contact or care event between a subject of care and healthcare provider(s).(en)</items><items id="text">*Encounter(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">*Extension(en)</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">Interaksjon, kontakt eller omsorgshendelse mellom et individ og helsepersonell.</items><items id="text">Klinisk kontakt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Utvidelse</items></items></term_definitions><term_definitions language="nl"><items code="at0000"><items id="description">Interactie, contact of zorggebeurtenis tussen een onderwerp van zorg en zorgverlener(s).</items><items id="text">Contact</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensie</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="description">Interação, contato ou cuidado entre o sujeito do cuidado e profissional(is) de saúde.</items><items id="text">Encontro</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensão</items></items></term_definitions><term_definitions language="pt-pt"><items code="at0000"><items id="description">Interação, contato ou evento de cuidados entre um sujeito e um provedor de saúde.</items><items id="text">Encontro</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">*For example: local information requirements; or additional metadata to align with FHIR. (en)</items><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensão</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="description">Kontakt mellan patient och vårdgivare, eller vårdhändelse inom hälso- och sjukvården.</items><items id="text">Vårdkontakt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0002"><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items><items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="text">Tilläggsinformation</items></items></term_definitions></ontology><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.blood_pressure.v2"><term_definitions language="ar-sy"><items code="at0000"><items id="description">قياس موضعي لضغط الدم الشرياني و الذي يحل محل الضغط الشرياني في الدورة الدموية الجهازية. &#13;
و عادة ما يستخدم مصطلح "ضغط الدم" لللإشارة إلى قياس ضغط دم الشريان العضُدي في أعلى الذراع.</items><items id="text">ضغط الدم</items></items><items code="at0001"><items id="description">العقدة التركيبية للتاريخ</items><items id="text">التاريخ</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">ذروة ضغط الدم الشرياني الجهازي - يتم قياسه في طور الانقباض من دورة القلب</items><items id="text">الانقباضي</items></items><items code="at0005"><items id="description">الحد الأدني لضغط الدم الشرياني الجهازي - يتم قياسها في طور الانبساط - الارتخاء من دورة القلب</items><items id="text">الانبساطي</items></items><items code="at0006"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">موضع الشخص في وقت القياس</items><items id="text">الموضع</items></items><items code="at0011"><items id="description">تركيب القائمة</items><items id="text">تركيب القائمة</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470. </items><items id="description">حجم الكُفَّة المستخدمة في قياس ضغط الدم</items><items id="text">حجم الكُفَّة</items></items><items code="at0014"><items id="description">*Simple body site where blood pressure was measured.(en)</items><items id="text">*Location of measurement(en)</items></items><items code="at0015"><items id="description">كفة تستخدم لفخذ البالغ - مثانة/ كيسة من 20 سينتيمتر * 42 سينتيمتر تقريبا</items><items id="text">فخذ البالغ</items></items><items code="at0016"><items id="description">كفة للبالغين ذوي الأذرع الكبيرة - المثانة/ الكيسة 16 سينتيمتر * 38 سينتيمتر تقريبا</items><items id="text">بالغ كبير</items></items><items code="at0017"><items id="description">كفة عيارية للبالغين - مثانة من 13 سينتيمتر * 30 سينتيمتر تقريبا</items><items id="text">البالغ</items></items><items code="at0025"><items id="description">الذراع الأيمن للشخص</items><items id="text">الذراع الأيمن</items></items><items code="at0026"><items id="description">الذراع الأيسر للشخص</items><items id="text">الذراع الأيسر</items></items><items code="at0027"><items id="description">الفخذ الأيمن للشخص</items><items id="text">الفخذ الأيمن</items></items><items code="at0028"><items id="description">الفخذ الأيسر للشخص</items><items id="text">الفخذ الأيسر</items></items><items code="at0033"><items id="description">*Additional narrative about the measurement, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at1000"><items id="description">الشخص واقف عند القيام بقياس ضغط الدم</items><items id="text">واقف</items></items><items code="at1001"><items id="description">الشخص جالس (مثلا على سرير أو كرسي) عند القيام بقياس ضغط الدم</items><items id="text">جالس</items></items><items code="at1002"><items id="description">الشخص مضطجع عند القيام بقياس ضغط الدم</items><items id="text">مضطجع</items></items><items code="at1003"><items id="description">الشخص مستلقٍ بشكل مستوٍ عند القيام بقياس ضغط الدم</items><items id="text">مستلقٍ</items></items><items code="at1005"><items id="comment">*PLEASE NOTE: '°' is a valid UCUM unit. Please use 'deg' as the correct unit.(en)</items><items id="description">*The craniocaudal tilt of the surface on which the person is lying at the time of measurement.(en)</items><items id="text">*Tilt(en)</items></items><items code="at1006"><items id="description">متوسط الضغط الشرياني الذي يحدث خلال جميع أطوار دورة القلب الواحدة من انقباض و انبساط/ ارتخاء</items><items id="text">متوسط الضغط الشرياني</items></items><items code="at1007"><items id="description">الفرق بين ضغط الدم الانقباضي و الانبساطي</items><items id="text">الضغط عند النبض</items></items><items code="at1008"><items id="description">كفة تستخدم للبالغ الصغير - مثانة/ كيسة من 10 سينتيمتر * 24 سينتيمتر تقريبا</items><items id="text">البالغ الصغير</items></items><items code="at1009"><items id="description">كفة تستخدم للطفل أو البالغ ذي الذراع الرفيعة - من 8 سينتيمتر * 21 سينتيمتر تقريبا</items><items id="text">طفل</items></items><items code="at1010"><items id="description">تستخدم أصوات كورتكوف لتحديد ضغط الدم الانبساطي باستخدام طريقة التسمُّع</items><items id="text">النقطة النهائية الانبساطية/ الارتخائية</items></items><items code="at1011"><items id="description">يتم التعرف على صوت كورتكوف الرابع على أنه تخفيت منفصل</items><items id="text">الطور الرابع</items></items><items code="at1012"><items id="description">يتم التعرف على صوت كورتكوف الخامس بغياب الأصوات حيث ينخفض ضغط الكفة تحت ضغط الدم الانبساطي</items><items id="text">الطور الخامس</items></items><items code="at1014"><items id="description">الشخص مستلق بشكل مستو مع ميل جانبي بزاوية تجاه جانبه الأيسر. عادة ما يُحتاج إلى هذا الوضع في الأثلوث الأخير من الحمل لتخفيف الانضغاط الأبهري الجوفي</items><items id="text">مستلق و مائل لجانبه الأيسر</items></items><items code="at1018"><items id="description">كفة تستخدم للرضيع - مثانة/ كيسة من 5 سينتيمتر * 15 سينتيمتر تقريبا</items><items id="text">رضيع</items></items><items code="at1019"><items id="description">الكفة المستخدمة لحديثي الولادة, على افتراض أن الكفة مناسبة للحجم و النضج و الوزن عند ولادة الطفل</items><items id="text">حديث الولادة</items></items><items code="at1020"><items id="description">الساعد الأيمن للشخص</items><items id="text">الساعد الأيمن</items></items><items code="at1021"><items id="description">الساعد الأيسر للشخص</items><items id="text">الساعد الأيسر</items></items><items code="at1025"><items id="description">تفاصيل حول جهاز ضغط الدم الزئبقي أو جهيزة أخرى تستخدم لقياس ضغط الدم</items><items id="text">الجهيزة</items></items><items code="at1026"><items id="description">الكاحل الأيمن للشخص</items><items id="text">الكاحل الأيمن</items></items><items code="at1030"><items id="description">تفاصيل حول النشاط البدني الذي يتم القيام به في وقت قياس ضغط الدم.</items><items id="text">المجهود</items></items><items code="at1031"><items id="description">الكاحل الأيسر للشخص</items><items id="text">الكاحل الأيسر</items></items><items code="at1032"><items id="description">*A finger of the individual.(en)</items><items id="text">*Finger(en)</items></items><items code="at1035"><items id="description">طريقة قياس ضغط الدم</items><items id="text">الطريقة</items></items><items code="at1036"><items id="description">طريقة خارجية لقياس ضغط الدم, باستخدام سماعة طبيب أو أصوات كوروتكوف</items><items id="text">التسمع</items></items><items code="at1037"><items id="description">طريقة خارجية لقياس ضغط الدم, باستخدام الجس - عادةً الشرايين الذراعية و الكعبري</items><items id="text">الجس</items></items><items code="at1038"><items id="description">الصيغة المستخدمة لقياس متوسط الضغط الشرياني - إذا تم تسجيل بياناتها</items><items id="text">صيغة متوسط الضغط الشرياني</items></items><items code="at1039"><items id="description">طريقة خارجية لقياس ضغط الدم بالستخدام آلة قياس ضغط الدم</items><items id="text">الآلة</items></items><items code="at1040"><items id="description">طريقة داخلية لقيسا ضغط الدم, و ذلك يعني اختراق الجلد/ البشرة داخل الأوعية الدموية</items><items id="text">باضع</items></items><items code="at1042"><items id="description">تقدير متوسط ضغط الدم خلال فترة من 24 ساعة</items><items id="text">المتوسط خلال 24 ساعة</items></items><items code="at1043"><items id="description">حالة النوم - تدعم تفسير قياسات ضغط الدم المِسيارية خلال 24 ساعة</items><items id="text">حالة النوم</items></items><items code="at1044"><items id="description">الشخص واعٍ بشكل كامل</items><items id="text">متنبه و يقظ</items></items><items code="at1045"><items id="description">الشخص في الحالة الطبيعية الخاصة بالراحة الجسدية</items><items id="text">نائم</items></items><items code="at1051"><items id="description">*A toe of the individual.(en)</items><items id="text">*Toe(en)</items></items><items code="at1052"><items id="description">تعليق حول و تسجيل للعوامل الطارئة التي قد تسهم في قياس ضغط الدم. مثلا, مستوى القلق أو متلازمة البالطو الأبيض أو الألم أو الحمى أو التغييرات في الضغط الجوي,, إلى آخره</items><items id="text">العوامل المربكة</items></items><items code="at1053"><items id="description">*Invasive measurement via transducer access line within an artery.(en)</items><items id="text">*Intra-arterial(en)</items></items><items code="at1054"><items id="description">*Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Systolic pressure formula(en)</items></items><items code="at1055"><items id="description">*Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Diastolic pressure formula(en)</items></items><items code="at1056"><items id="description">**(en)</items><items id="text">*Dorsum of foot(en)</items></items><items code="at1057"><items id="description">*Structured anatomical location of where the measurement was taken.(en)</items><items id="text">*Structured measurement location(en)</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">**(en)</items><items id="text">*New element(en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="comment">Majoritàriament, l'ús del terme «pressió arterial» fa referència a la mesura de la pressió de l'artèria braquial a la part superior del braç.</items><items id="description">La mesura local de la pressió arterial, que és una substituta de la pressió arterial a la circulació sistèmica.</items><items id="text">Pressió arterial</items></items><items code="at0001"><items id="description">Node estructural dels antecedents.</items><items id="text">Antecedents</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">blood pressure</items></items><items code="at0004"><items id="description">Pressió arterial sistemàtica màxima - mesurada en la fase sistòlica o de contracció del cicle cardíac.</items><items id="text">Sistòlica</items></items><items code="at0005"><items id="description">Pressió arterial sistemàtica mínima - mesurada en la fase diastòlica o de relaxació del cicle cardíac.</items><items id="text">Diastòlica</items></items><items code="at0006"><items id="description">Esdeveniment predeterminat i no especificat d’un moment específic o interval que es pot definir clarament en una plantilla o en temps d’execució.</items><items id="text">Qualsevol esdeveniment</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">Posició del pacient al moment de la mesura.</items><items id="text">Posició</items></items><items code="at0011"><items id="description">Llistat.</items><items id="text">Esquema</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">Grandària del maneguet utilitzat per a mesurar la pressió arterial.</items><items id="text">Grandària del maneguet</items></items><items code="at0014"><items id="description">Zona del cos on es va mesurar la pressió arterial.</items><items id="text">Zona del mesurament</items></items><items code="at0015"><items id="description">Maneguet utilitzat per a una cuixa adulta (20 cm x 42 cm aprox.).</items><items id="text">Cuixa d'un adult</items></items><items code="at0016"><items id="description">Maneguet utilitzat per a un adult amb braços grans (16 cm x 38 cm aprox.).</items><items id="text">Adult gran</items></items><items code="at0017"><items id="description">Maneguet estàndard per a un adult (13 cm x 30 cm aprox.).</items><items id="text">Adult</items></items><items code="at0025"><items id="description">Braç dret del pacient.</items><items id="text">Braç dret</items></items><items code="at0026"><items id="description">Braç esquerre del pacient.</items><items id="text">Braç esquerre</items></items><items code="at0027"><items id="description">Cuixa dreta del pacient.</items><items id="text">Cuixa dreta</items></items><items code="at0028"><items id="description">Cuixa esquerra del pacient.</items><items id="text">Cuixa esquerra</items></items><items code="at0033"><items id="description">Informació addicional sobre la mesura, no recollida en altres caselles.</items><items id="text">Observacions</items></items><items code="at1000"><items id="description">Persona de peu al moment de la mesura de la pressió arterial.</items><items id="text">Dret</items></items><items code="at1001"><items id="description">Persona asseguda (per exemple, al llit o en una cadira) al moment de la mesura de la pressió arterial.</items><items id="text">Assegut</items></items><items code="at1002"><items id="description">Persona reclinada al moment de la mesura de la pressió arterial.</items><items id="text">Reclinat</items></items><items code="at1003"><items id="description">Persona ajaguda en posició horitzontal al moment de la mesura de la pressió arterial.</items><items id="text">Ajagut</items></items><items code="at1005"><items id="description">La inclinació craniocaudal de la superfície on la persona es ajeu al moment de la mesura.</items><items id="text">Inclinació</items></items><items code="at1006"><items id="description">La mitjana de la pressió arterial que ocorre durant el cicle complet de contracció i relaxació del cor.</items><items id="text">Pressió arterial mitjana</items></items><items code="at1007"><items id="description">Diferència entre la pressió sistòlica i la diastòlica.</items><items id="text">Pressió de pols</items></items><items code="at1008"><items id="description">Maneguet utilitzat per a un adult petit (10 cm x 24 cm aprox.).</items><items id="text">Adult petit</items></items><items code="at1009"><items id="description">Maneguet apropiat per a un infant o adult amb un braç petit (8 cm x 21 cm aprox.).</items><items id="text">Pediàtric/Infants</items></items><items code="at1010"><items id="description">Registra quin so de Korotkoff s'utilitza per a determinar la pressió diastòlica mitjançant el mètode d'auscultació.</items><items id="text">Punt final diastòlic</items></items><items code="at1011"><items id="description">El quart so Korotkoff s'identifica com un amortiment abrupte de sons.</items><items id="text">Fase IV</items></items><items code="at1012"><items id="description">El cinquè so de Korotkoff s'identifica per l'absència de sons quan la pressió del maneguet cau per sota de la pressió arterial diastòlica.</items><items id="text">Fase V</items></items><items code="at1014"><items id="description">Persona ajaguda amb una certa inclinació lateral, generalment en angle cap al costat esquerre. Es requereix normalment durant l'últim trimestre d'embaràs per alleujar la compressió aortocava.</items><items id="text">Ajagut cap a l'esquerra</items></items><items code="at1018"><items id="description">Maneguet utilitzat per a nadons (5 cm x 15 cm aprox.).</items><items id="text">Nadó</items></items><items code="at1019"><items id="description">Maneguet utilitzat per nounats, suposant que el maneguet sigui de la mida adequada per a la maduresa i pes del nounat.</items><items id="text">Nounat</items></items><items code="at1020"><items id="description">Canell dret del pacient.</items><items id="text">Canell dret</items></items><items code="at1021"><items id="description">Canell esquerre del pacient.</items><items id="text">Canell esquerre</items></items><items code="at1025"><items id="description">Dades sobre el tensiòmetre o altre dispositiu utilitzat per a mesurar la pressió arterial.</items><items id="text">Dispositiu</items></items><items code="at1026"><items id="description">Turmell dret del pacient.</items><items id="text">Turmell dret</items></items><items code="at1030"><items id="description">Dades sobre l'activitat física realitzada al moment de la mesura de la pressió arterial.</items><items id="text">Esforç</items></items><items code="at1031"><items id="description">Turmell esquerre del pacient.</items><items id="text">Turmell esquerre</items></items><items code="at1032"><items id="description">Un dit de la mà del pacient.</items><items id="text">Dit de la mà</items></items><items code="at1035"><items id="description">Mètode de la mesura de la pressió arterial.</items><items id="text">Mètode</items></items><items code="at1036"><items id="description">Mètode extern de mesura de la pressió arterial, utilitzant un estetoscopi i sons de Korotkoff.</items><items id="text">Auscultació</items></items><items code="at1037"><items id="description">Mètode extern de mesura de la pressió arterial, utilitzant la palpació, en general de l'artèria braquial o artèries radials.</items><items id="text">Palpació</items></items><items code="at1038"><items id="description">Fórmula utilitzada per a calcular la Pressió Arterial Mitjana (en cas de registrar aquesta dada).</items><items id="text">Fórmula de la pressió arterial mitjana</items></items><items code="at1039"><items id="description">Mètode extern de mesura de la pressió arterial, utilitzant un dispositiu o màquina.</items><items id="text">Màquina</items></items><items code="at1040"><items id="description">Mètode intern de mesura de la pressió arterial que involucra la penetració de la pell i mesurar dins dels vasos sanguinis.</items><items id="text">Invasiu</items></items><items code="at1042"><items id="description">Estimació de la pressió arterial mitjana durant un període de 24 hores.</items><items id="text">Mitjana de 24 hores</items></items><items code="at1043"><items id="description">Estat del son - ajuda a la interpretació dels registres de la pressió arterial ambulatòria de 24 hores.</items><items id="text">Estat del son</items></items><items code="at1044"><items id="description">La persona es troba totalment conscient.</items><items id="text">Despert</items></items><items code="at1045"><items id="description">La persona es troba en un estat natural de repòs corporal.</items><items id="text">Dormit</items></items><items code="at1051"><items id="description">Un dit del peu del pacient.</items><items id="text">Dit del peu</items></items><items code="at1052"><items id="description">Comentar i registrar altres factors incidentals que puguin estar afectant a la mesura de la pressió arterial. Per exemple, nivell d'ansietat o «hipertensió de bata blanca»; dolor o febre; canvis en la pressió atmosfèrica, etc.</items><items id="text">Factors de confusió</items></items><items code="at1053"><items id="description">Mesura invasiva mitjançant un transductor dins d'una artèria.</items><items id="text">Intraarterial</items></items><items code="at1054"><items id="description">Fórmula utilitzada per a calcular la pressió sistòlica a partir de la pressió arterial mitjana (en cas de registrar aquesta dada).</items><items id="text">Fórmula de pressió sistòlica</items></items><items code="at1055"><items id="description">Fórmula utilitzada per a calcular la pressió diastòlica a partir de la pressió arterial mitjana (en cas de registrar aquesta dada).</items><items id="text">Fórmula de pressió diastòlica</items></items><items code="at1056"><items id="description">Dors del peu del pacient.</items><items id="text">Dors del peu</items></items><items code="at1057"><items id="description">Zona anatòmica estructurada d'on es va prendre el mesurament.</items><items id="text">Zona estructurada del mesurament</items></items><items code="at1058"><items id="comment">Per exemple: informació departamental de l'hospital local o metadades addicionals per alinear-se amb equivalents FHIR o CIMI.</items><items id="description">Informació addicional requerida per a capturar el contingut local o per alinear-se amb altres models/formalismes de referència.</items><items id="text">Extensió</items></items><items code="at1059"><items id="description">Una sola paraula, frase o descripció breu que representi el significat clínic i la importància de la mesura de la pressió arterial.</items><items id="text">Interpretació clínica</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="comment">Häufig wird der Ausdruck 'Blutdruck' zur Bezeichung der Messung des brachialen Ateriendrucks im Oberarm verwendet.</items><items id="description">Die lokale Messung des arteriellen Blutdrucks als Surrogat für den arteriellen Druck in der systemischen Zirkulation.</items><items id="text">Blutdruck</items></items><items code="at0001"><items id="description">Historie</items><items id="text">Historie</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Blutdruck</items></items><items code="at0004"><items id="description">Der höchste arterielle Blutdruck eines Zyklus - gemessen in der systolischen oder Kontraktionsphase des Herzens.</items><items id="text">Systolisch</items></items><items code="at0005"><items id="description">Der minimale systemische arterielle Blutdruck eines Zyklus - gemessen in der diastolischen oder Entspannungsphase des Herzens.</items><items id="text">Diastolisch</items></items><items code="at0006"><items id="description">Standardmäßiger, nicht näher beschriebener Zeitpunkt oder Intervall Ereignis welches in einem Template oder bei der Anwendung genauer definiert werden kann.</items><items id="text">Beliebiges Ereignis</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">Die Position der untersuchten Person während der Messung.</items><items id="text">Position</items></items><items code="at0011"><items id="description">Listenstruktur</items><items id="text">Listenstruktur</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">Die Größe der Manschette, die zur Blutdruckmessung benutzt wurde.</items><items id="text">Manschettengröße</items></items><items code="at0014"><items id="description">Einfache Körperstelle an der der Blutdruck gemessen wurde.</items><items id="text">Stelle der Messung</items></items><items code="at0015"><items id="description">Eine Manschette für den Oberschenkel eines Erwachsenen - ca. 20cm x 42cm.</items><items id="text">Oberschenkel eines Erwachsenen</items></items><items code="at0016"><items id="description">Eine Manschette für Erwachsene mit größeren Armen - ca. 16cm x 38cm.</items><items id="text">Großer Erwachsener</items></items><items code="at0017"><items id="description">Eine Standard-Manschette für einen Erwachsenen - ca. 13cm x 30cm.</items><items id="text">Erwachsener</items></items><items code="at0025"><items id="description">Der rechte Arm der Person.</items><items id="text">Rechter Arm</items></items><items code="at0026"><items id="description">Der linke Arm der Person.</items><items id="text">Linker Arm</items></items><items code="at0027"><items id="description">Der rechte Oberschenkel der Person.</items><items id="text">Rechter Oberschenkel</items></items><items code="at0028"><items id="description">Der linke Oberschenkel der Person.</items><items id="text">Linker Oberschenkel</items></items><items code="at0033"><items id="description">Zusätzlicher Freitext über die Messung, der nicht in anderen Felder erfasst werden konnte.</items><items id="text">Kommentar</items></items><items code="at1000"><items id="description">Stehend zum Zeitpunkt der Blutdruckmessung.</items><items id="text">Stehend</items></items><items code="at1001"><items id="description">Sitzend zum Zeitpunkt der Blutdruckmessung (z.B. auf einem Bett oder Stuhl).</items><items id="text">Sitzend</items></items><items code="at1002"><items id="description">Patient zurückgelehnt zum Zeitpunkt der Blutdruckmessung.</items><items id="text">Zurückgelehnt</items></items><items code="at1003"><items id="description">Flach liegend zum Zeitpunkt der Blutdruckmessung.</items><items id="text">Liegend</items></items><items code="at1005"><items id="description">Die kraniokaudale Neigung der Oberfläche auf der die Person zum Zeitpunkt der Messung liegt.</items><items id="text">Neigung</items></items><items code="at1006"><items id="description">Der mittlerer arterielle Druck über den gesamten Verlauf der Konktraktions- und Entspannungsphase des Herzens.</items><items id="text">Mittlerer arterieller Druck</items></items><items code="at1007"><items id="description">Der Abstand zwischen dem systolischen und dem diastolischen Blutdruckwert.</items><items id="text">Pulsdruck</items></items><items code="at1008"><items id="description">Eine Manschette für einen kleinen Erwachsenen - ca. 10cm x 24cm.</items><items id="text">Kleiner Erwachsener</items></items><items code="at1009"><items id="description">Eine Manschette für ein Kind oder auch einen Erwachsenen mit einem schmalen Arm - 8cm x 21cm.</items><items id="text">Pädiatrisch/Kind</items></items><items code="at1010"><items id="description">Dient der Dokumentation des Korotkoff-Geräusches, das verwendet wird, um bei auskultarischer Messung den diastolischen Blutdruck zu bestimmen.</items><items id="text">Diastolischer Endpunkt</items></items><items code="at1011"><items id="description">Das 4. Korotkoff-Geräusch - Die Geräusche klingen plätzlich gedämpft.</items><items id="text">Phase IV</items></items><items code="at1012"><items id="description">Das 5. Korotkoff-Geräusch - die Geräusche verschwinden völlig während der Manschettendruck unter den diastolischen Blutdruck fällt.</items><items id="text">Phase V</items></items><items code="at1014"><items id="description">Flach liegend mit seitlicher Neigung, normalerweise zur linken Seite. Häufig verwendet im letzten Drittel eine Schwangerschaft, um aorto-cavale Kompression zu vermeiden.</items><items id="text">Nach links geneigt liegend</items></items><items code="at1018"><items id="description">Eine Manschette für Kleinkinder und Säuglinge - ca. 5cm x 15cm.</items><items id="text">Kleinkind</items></items><items code="at1019"><items id="description">Eine Manschette für Neugeborene mit passender Größe für die Reife und das Geburtsgewicht des Neugeborenen.</items><items id="text">Neonatal</items></items><items code="at1020"><items id="description">Das rechte Handgelenk der Person.</items><items id="text">Rechtes Handgelenk</items></items><items code="at1021"><items id="description">Das linke Handgelenk der Person.</items><items id="text">Linkes Handgelenk</items></items><items code="at1025"><items id="description">Details über das Sphygmomanometer oder ein anderes Gerät, dass zur Blutdruckmessung verwendet wird.</items><items id="text">Gerät</items></items><items code="at1026"><items id="description">Das rechte Fußgelenk der Person.</items><items id="text">Rechtes Fußgelenk</items></items><items code="at1030"><items id="description">Details über physische Aktivitäten zur Zeit der Blutdruckmessung.</items><items id="text">Anstrengung</items></items><items code="at1031"><items id="description">Das linke Fußgelenk der Person</items><items id="text">Linkes Fußgelenk</items></items><items code="at1032"><items id="description">Ein Finger des Individuums.</items><items id="text">Finger</items></items><items code="at1035"><items id="description">Methode der Messung des Blutdrucks.</items><items id="text">Methode</items></items><items code="at1036"><items id="description">Auskulatorische Messung unter Benutzung eines Stethoskops und der Korotkoff-Geräusche.</items><items id="text">Auskultation</items></items><items code="at1037"><items id="description">Palpatorische Messung, normalerweise an den brachialen oder radialen Arterien.</items><items id="text">Palpation</items></items><items code="at1038"><items id="description">Die Formel die ggf. verwendet wurde, um den mittleren arteriellen Druck zu berechnen.</items><items id="text">Formel für mittleren arterieller Druck</items></items><items code="at1039"><items id="description">Messung durch eine Blutdruckmaschine.</items><items id="text">Machine</items></items><items code="at1040"><items id="description">Invasive Messung des Blutdrucks innerhalb eines Gefäßes.</items><items id="text">Invasiv</items></items><items code="at1042"><items id="description">Schätzung des durchschnittlichen Blutdrucks über einen 24-stündigen Zeitraum.</items><items id="text">24 Stunden Durchschnitt</items></items><items code="at1043"><items id="description">Schlafzustand - unterstützt die Auswertung von 24-stündigen ambulanten Aufzeichnungen des Blutdrucks.</items><items id="text">Schlafzustand</items></items><items code="at1044"><items id="description">Die untersuchte Person ist bei vollem Bewusstsein.</items><items id="text">Aufmerksam und wach</items></items><items code="at1045"><items id="description">Die untersuchte Person schläft.</items><items id="text">Schlafend</items></items><items code="at1051"><items id="description">Ein Zeh des Individuums.</items><items id="text">Zeh</items></items><items code="at1052"><items id="description">Kommentar und Aufzeichung anderer Faktoren die ggf. zu dem Ergebnis der Blutdruckmessung beitragen können. Die kann z.B. bei belastenden Situationen der Fall sein (z.B. sog. Weißkittelhypertonie, Schmerzen, Fieber, Änderungen im atmosphärischen Druck).</items><items id="text">Einflussfaktoren</items></items><items code="at1053"><items id="description">Invasive Messung mittels Transducer über einen arteriellen Zugang.</items><items id="text">Intraarteriell</items></items><items code="at1054"><items id="description">Formel, die benutzt wurde, um den systolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).</items><items id="text">Formel für systolischen Druck</items></items><items code="at1055"><items id="description">Formel, die benutzt wurde, um den distolischen Druck vom mittleren arteriellen Druck zu berechnen (wenn erfasst).</items><items id="text">Formel für diastolischen Druck</items></items><items code="at1056"><items id="description">Fußrücken des Individuums.</items><items id="text">Fußrücken</items></items><items code="at1057"><items id="description">Strukturierte Körperstelle an der der Blutdruck gemessen wurde.</items><items id="text">Strukturierte Stelle der Messung</items></items><items code="at1058"><items id="comment">Zum Beispiel: Informationen bzgl. der lokalen Krankenhausabteilung oder zusätzliche Metadata zur Anpassung an entsprechende FHIR oder CIMI Gegenstücke.</items><items id="description">Zusätzliche Information, die für die Erfassung des lokalen Kontexts oder für die Anpassung an andere Referenzmodelle/Formalismen benötigt wird.</items><items id="text">Erweiterung</items></items><items code="at1059"><items id="description">Einzelnes Wort, Ausdruck oder Kurzbeschreibung der klinischen Bedeutung und Aussagekraft der Blutdruckmessung.</items><items id="text">Klinische Interpretation</items></items></term_definitions><term_definitions language="el"><items code="at0000"><items id="comment">Συνηθέστερα, η χρήση του όρου «αρτηριακή πίεση» αναφέρεται στη μέτρηση της πίεσης της βραχιόνιας αρτηρίας στο άνω μέρος του βραχίονα.</items><items id="description">Η τοπική μέτρηση της αρτηριακής πίεσης που είναι υποκατάστατο της αρτηριακής πίεσης στη συστηματική κυκλοφορία.</items><items id="text">Πίεση αίματος</items></items><items code="at0001"><items id="description">*History Structural node.(en)</items><items id="text">Ιστορικό</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">blood pressure</items></items><items code="at0004"><items id="description">Μέγιστη συστηματική αρτηριακή πίεση - μετρούμενη σε φάση συστολής ή συστολής του καρδιακού κύκλου.</items><items id="text">Συστολική</items></items><items code="at0005"><items id="description">Ελάχιστη συστηματική αρτηριακή πίεση - μετρούμενη στη διαστολική φάση ή στη φάση χαλάρωσης του καρδιακού κύκλου.</items><items id="text">Διαστολική</items></items><items code="at0006"><items id="description">Προεπιλεγμένο, απροσδιόριστο χρονικό σημείο ή συμβάν διαστήματος που μπορεί να ορίζεται ρητά σε ένα πρότυπο ή κατά το χρόνο εκτέλεσης.</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">Η θέση του ατόμου κατά τη στιγμή της μέτρησης.</items><items id="text">Θέση</items></items><items code="at0011"><items id="description">Δομή λίστας.</items><items id="text">Δομή λίστας</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Προσδιορισμός της ανθρώπινης αρτηριακής πίεσης με σφυγμομανομετρία. Κυκλοφορία 1993; 88;2460-2470.</items><items id="description">Το μέγεθος του περιβραχιονίου που χρησιμοποιείται για τη μέτρηση της αρτηριακής πίεσης.</items><items id="text">Mέγεθος περιβραχιονίου</items></items><items code="at0014"><items id="description">Απλό σημείο του σώματος όπου μετρήθηκε η αρτηριακή πίεση.</items><items id="text">Θέση μέτρησης</items></items><items code="at0015"><items id="description">Ένα περιβραχιόνιο που χρησιμοποιείται για έναν μηρό ενηλίκων.</items><items id="text">Μηρός ενηλίκων</items></items><items code="at0016"><items id="description">Ένα περιβραχιόνιο για ενήλικες με μεγαλύτερα χέρια.</items><items id="text">Μεγάλος ενήλικας</items></items><items code="at0017"><items id="description">Ένα περιβραχιόνιο που είναι στάνταρ για έναν ενήλικα.</items><items id="text">Ενήλικας</items></items><items code="at0025"><items id="description">Το δεξί χέρι του ατόμου.</items><items id="text">Δεξιός βραχίωνας</items></items><items code="at0026"><items id="description">Ο αριστερός βραχίονας του ατόμου.</items><items id="text">Αριστερός βραχίωνας</items></items><items code="at0027"><items id="description">Ο δεξιός μηρός του ατόμου.</items><items id="text">Δεξιός μηρός</items></items><items code="at0028"><items id="description">Ο αριστερός μηρός του ατόμου.</items><items id="text">Αριστερός μηρός</items></items><items code="at0033"><items id="description">Πρόσθετη αφήγηση σχετικά με τη μέτρηση, που δεν αποτυπώνεται σε άλλα πεδία.</items><items id="text">Σχόλιο</items></items><items code="at1000"><items id="description">Στέκεται κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.</items><items id="text">Ορθοστασία</items></items><items code="at1001"><items id="description">Καθιστή θέση (για παράδειγμα στο κρεβάτι ή την καρέκλα) κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.</items><items id="text">Καθιστή θέση</items></items><items code="at1002"><items id="description">Ανάκλιση κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.</items><items id="text">Ανακλινομενη θέση</items></items><items code="at1003"><items id="description">Ξαπλωμένη κατά τη στιγμή της μέτρησης της αρτηριακής πίεσης.</items><items id="text">Ξαπλωμένη θέση</items></items><items code="at1005"><items id="description">Η κρανιοουραία κλίση της επιφάνειας στην οποία βρίσκεται το άτομο κατά τη στιγμή της μέτρησης.</items><items id="text">Σε κλίση</items></items><items code="at1006"><items id="description">Η μέση αρτηριακή πίεση που εμφανίζεται καθ 'όλη τη διάρκεια του κύκλου συστολής και χαλάρωσης της καρδιάς.</items><items id="text">Μέση αρτηριακή πίεση</items></items><items code="at1007"><items id="description">Η διαφορά μεταξύ της συστολικής και της διαστολικής πίεσης.</items><items id="text">Παλμική πίεση</items></items><items code="at1008"><items id="description">Ένα περιβραχιόνιο που χρησιμοποιείται για έναν μικρό ενήλικα.</items><items id="text">Μικρός ενήλικας</items></items><items code="at1009"><items id="description">Ένα περιβραχιόνιο που είναι κατάλληλη για παιδί ή ενήλικα με λεπτό χέρι.</items><items id="text">Παιδικό</items></items><items code="at1010"><items id="description">Καταγράψτε ποιος ήχος Korotkoff χρησιμοποιείται για τον προσδιορισμό της διαστολικής πίεσης χρησιμοποιώντας ακουστική μέθοδο.</items><items id="text">Διαστολικό καταληκτικό σημείο</items></items><items code="at1011"><items id="description">Ο τέταρτος ήχος Korotkoff αναγνωρίζεται ως ένα απότομο σιγαστήρα ήχων.</items><items id="text">Phase IV</items></items><items code="at1012"><items id="description">Ο πέμπτος ήχος Korotkoff αναγνωρίζεται από την απουσία ήχων καθώς η πίεση της μανσέτας πέφτει κάτω από τη διαστολική αρτηριακή πίεση.</items><items id="text">Phase V</items></items><items code="at1014"><items id="description">Ξαπλωμένη επίπεδη με κάποια πλευρική κλίση, συνήθως υπό γωνία προς την αριστερή πλευρά. Συνήθως απαιτείται στο τελευταίο τρίμηνο της εγκυμοσύνης για την ανακούφιση της συμπίεσης της αορτοκαβάλης.</items><items id="text">Ξαπλωμένη με κλίση προς τα αριστερά</items></items><items code="at1018"><items id="description">Ένα περιβραχιόνιο για βρέφη</items><items id="text">Βρέφη</items></items><items code="at1019"><items id="description">Ένα περιβραχιόνιο που χρησιμοποιείται για νεογνά</items><items id="text">Νεογνά</items></items><items code="at1020"><items id="description">Ο δεξιός καρπός του ατόμου.</items><items id="text">Δεξιός καρπός</items></items><items code="at1021"><items id="description">Ο αριστερός καρπός του ατόμου.</items><items id="text">Αριστερός καρπός</items></items><items code="at1025"><items id="description">Λεπτομέρειες σχετικά με το σφυγμομανόμετρο ή άλλη συσκευή που χρησιμοποιείται για τη μέτρηση της αρτηριακής πίεσης.</items><items id="text">Συσκευή</items></items><items code="at1026"><items id="description">Ο δεξιός αστράγαλος του ατόμου.</items><items id="text">Δεξιός αστράγαλος</items></items><items code="at1030"><items id="description">*Details about physical activity undertaken at the time of blood pressure measurement.(en)</items><items id="text">*Exertion(en)</items></items><items code="at1031"><items id="description">Ο αριστερός αστράγαλος του ατόμου.</items><items id="text">Αριστερός αστράγαλος</items></items><items code="at1032"><items id="description">Ένα δάχτυλο του ατόμου.</items><items id="text">Δάχτυλο</items></items><items code="at1035"><items id="description">Μέθοδος μέτρησης της αρτηριακής πίεσης.</items><items id="text">Μέθοδος</items></items><items code="at1036"><items id="description">Μέθοδος μέτρησης της αρτηριακής πίεσης εξωτερικά, χρησιμοποιώντας στηθοσκόπιο και ήχους Korotkoff</items><items id="text">Ακρόαση</items></items><items code="at1037"><items id="description">Μέθοδος μέτρησης της αρτηριακής πίεσης εξωτερικά, χρησιμοποιώντας ψηλάφηση (συνήθως των βραχιονίων ή ακτινωτών αρτηριών).</items><items id="text">Ψηλάφιση</items></items><items code="at1038"><items id="description">Τύπος που χρησιμοποιείται για τον υπολογισμό της μέσης αρτηριακής πίεσης (εάν καταγράφεται στα δεδομένα).</items><items id="text">Τύπος μέσης αρτηριακής πίεσης</items></items><items code="at1039"><items id="description">Μέθοδος μέτρησης της αρτηριακής πίεσης εξωτερικά, χρησιμοποιώντας μια μηχανή αρτηριακής πίεσης.</items><items id="text">Μηχανή</items></items><items code="at1040"><items id="description">Μέθοδος μέτρησης της αρτηριακής πίεσης εσωτερικά, δηλαδή περιλαμβάνει διείσδυση του δέρματος και μέτρηση μέσα στα αιμοφόρα αγγεία.</items><items id="text">Επεμβατική</items></items><items code="at1042"><items id="description">Εκτίμηση της μέσης αρτηριακής πίεσης σε μια περίοδο 24 ωρών.</items><items id="text">24ωρος μέσος όρος</items></items><items code="at1043"><items id="description">Κατάσταση ύπνου - υποστηρίζει την ερμηνεία των 24ωρων περιπατητικών αρχείων αρτηριακής πίεσης</items><items id="text">Κατάσταση ύπνου</items></items><items code="at1044"><items id="description">Το άτομο έχει πλήρη συνείδηση.</items><items id="text">Ξύπνια</items></items><items code="at1045"><items id="description">Το άτομο βρίσκεται στη φυσική κατάσταση της σωματικής ανάπαυσης.</items><items id="text">Aνάπαυσης</items></items><items code="at1051"><items id="description">Ένα δάχτυλο του ατόμου.</items><items id="text">Δάχτυλο ποδιού</items></items><items code="at1052"><items id="description">Σχολιάστε και καταγράψτε άλλους τυχαίους παράγοντες που μπορεί να συμβάλλουν στη μέτρηση της αρτηριακής πίεσης. Για παράδειγμα, επίπεδο άγχους ή «σύνδρομο λευκού τριχώματος». πόνος ή πυρετός. αλλαγές στην ατμοσφαιρική πίεση κ. λπ.</items><items id="text">Συγχυτικοί παράγοντες</items></items><items code="at1053"><items id="description">Επεμβατική μέτρηση μέσω γραμμής πρόσβασης μορφοτροπέα εντός μιας αρτηρίας.</items><items id="text">Ενδοαρτηριακή</items></items><items code="at1054"><items id="description">Τύπος που χρησιμοποιείται για τον υπολογισμό της συστολικής πίεσης από τη μέση αρτηριακή πίεση (εάν καταγράφεται στα δεδομένα).</items><items id="text">Τύπος συστολικής πίεσης</items></items><items code="at1055"><items id="description">Τύπος που χρησιμοποιείται για τον υπολογισμό της διαστολικής πίεσης από τη μέση αρτηριακή πίεση (εάν καταγράφεται στα δεδομένα).</items><items id="text">Τύπος διαστολικής πίεσης</items></items><items code="at1056"><items id="description">Η ράχη του ατόμου του ποδιού.</items><items id="text">Ράχη ποδιού</items></items><items code="at1057"><items id="description">Δομημένη ανατομική θέση του σημείου όπου έγινε η μέτρηση.</items><items id="text">Δομημένη τοποθεσία μέτρησης</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">Μία λέξη, φράση ή σύντομη περιγραφή που αντιπροσωπεύει την κλινική έννοια και σημασία της μέτρησης της αρτηριακής πίεσης.</items><items id="text">Κλινική ερμηνεία</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="comment">Most commonly, use of the term 'blood pressure' refers to measurement of brachial artery pressure in the upper arm.</items><items id="description">The local measurement of arterial blood pressure which is a surrogate for arterial pressure in the systemic circulation.</items><items id="text">Blood pressure</items></items><items code="at0001"><items id="description">History Structural node.</items><items id="text">History</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">blood pressure</items></items><items code="at0004"><items id="description">Peak systemic arterial blood pressure  - measured in systolic or contraction phase of the heart cycle.</items><items id="text">Systolic</items></items><items code="at0005"><items id="description">Minimum systemic arterial blood pressure - measured in the diastolic or relaxation phase of the heart cycle.</items><items id="text">Diastolic</items></items><items code="at0006"><items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items><items id="text">Any event</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">The position of the individual at the time of measurement.</items><items id="text">Position</items></items><items code="at0011"><items id="description">List structure.</items><items id="text">Tree</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470. </items><items id="description">The size of the cuff used for blood pressure measurement.</items><items id="text">Cuff size</items></items><items code="at0014"><items id="description">Simple body site where blood pressure was measured.</items><items id="text">Location of measurement</items></items><items code="at0015"><items id="description">A cuff used for an adult thigh.</items><items id="text">Adult Thigh</items></items><items code="at0016"><items id="description">A cuff for adults with larger arms.</items><items id="text">Large Adult</items></items><items code="at0017"><items id="description">A cuff that is standard for an adult.</items><items id="text">Adult</items></items><items code="at0025"><items id="description">The right arm of the person.</items><items id="text">Right arm</items></items><items code="at0026"><items id="description">The left arm of the person.</items><items id="text">Left arm</items></items><items code="at0027"><items id="description">The right thigh of the person.</items><items id="text">Right thigh</items></items><items code="at0028"><items id="description">The left thigh of the person.</items><items id="text">Left thigh</items></items><items code="at0033"><items id="description">Additional narrative about the measurement, not captured in other fields.</items><items id="text">Comment</items></items><items code="at1000"><items id="description">Standing at the time of blood pressure measurement.</items><items id="text">Standing</items></items><items code="at1001"><items id="description">Sitting (for example on bed or chair) at the time of blood pressure measurement.</items><items id="text">Sitting</items></items><items code="at1002"><items id="description">Reclining at the time of blood pressure measurement.</items><items id="text">Reclining</items></items><items code="at1003"><items id="description">Lying flat at the time of blood pressure measurement.</items><items id="text">Lying</items></items><items code="at1005"><items id="description">The craniocaudal tilt of the surface on which the person is lying at the time of measurement.</items><items id="text">Tilt</items></items><items code="at1006"><items id="description">The average arterial pressure that occurs over the entire course of the heart contraction and relaxation cycle.</items><items id="text">Mean arterial pressure</items></items><items code="at1007"><items id="description">The difference between the systolic and diastolic pressure.</items><items id="text">Pulse pressure</items></items><items code="at1008"><items id="description">A cuff used for a small adult.</items><items id="text">Small Adult</items></items><items code="at1009"><items id="description">A cuff that is appropriate for a child or adult with a thin arm.</items><items id="text">Paediatric/Child</items></items><items code="at1010"><items id="description">Record which Korotkoff sound is used for determining diastolic pressure using auscultative method.</items><items id="text">Diastolic endpoint</items></items><items code="at1011"><items id="description">The fourth Korotkoff sound is identified as an abrupt muffling of sounds.</items><items id="text">Phase IV</items></items><items code="at1012"><items id="description">The fifth Korotkoff sound is identified by absence of sounds as the cuff pressure drops below the diastolic blood pressure.</items><items id="text">Phase V</items></items><items code="at1014"><items id="description">Lying flat with some lateral tilt, usually angled towards the left side.   Commonly required in the last trimester of pregnancy to relieve aortocaval compression.</items><items id="text">Lying with tilt to left</items></items><items code="at1018"><items id="description">A cuff used for infants.</items><items id="text">Infant</items></items><items code="at1019"><items id="description">A cuff used for a neonate, assuming cuff is the appropriate size for maturity and birthweight of the neonate.</items><items id="text">Neonatal</items></items><items code="at1020"><items id="description">The right wrist of the individual.</items><items id="text">Right wrist</items></items><items code="at1021"><items id="description">The left wrist of the individual.</items><items id="text">Left wrist</items></items><items code="at1025"><items id="description">Details about sphygmomanometer or other device used to measure the blood pressure.</items><items id="text">Device</items></items><items code="at1026"><items id="description">The right ankle of the individual.</items><items id="text">Right ankle</items></items><items code="at1030"><items id="description">Details about physical activity undertaken at the time of blood pressure measurement.</items><items id="text">Exertion</items></items><items code="at1031"><items id="description">The left ankle of the individual.</items><items id="text">Left ankle</items></items><items code="at1032"><items id="description">A finger of the individual.</items><items id="text">Finger</items></items><items code="at1035"><items id="description">Method of measurement of blood pressure.</items><items id="text">Method</items></items><items code="at1036"><items id="description">Method of measuring blood pressure externally, using a stethoscope and Korotkoff sounds.</items><items id="text">Auscultation</items></items><items code="at1037"><items id="description">Method of measuring blood pressure externally, using palpation (usually of the brachial or radial arteries).</items><items id="text">Palpation</items></items><items code="at1038"><items id="description">Formula used to calculate the Mean Arterial Pressure (if recorded in data).</items><items id="text">Mean arterial pressure formula</items></items><items code="at1039"><items id="description">Method of measuring blood pressure externally, using a blood pressure machine.</items><items id="text">Machine</items></items><items code="at1040"><items id="description">Method of measuring blood pressure internally ie involving penetration of the skin and measuring inside blood vessels.</items><items id="text">Invasive</items></items><items code="at1042"><items id="description">Estimate of the average blood pressure over a 24 hour period.</items><items id="text">24 hour average</items></items><items code="at1043"><items id="description">Sleep status - supports interpretation of 24 hour ambulatory blood pressure records.</items><items id="text">Sleep status</items></items><items code="at1044"><items id="description">The individual is fully conscious.</items><items id="text">Awake</items></items><items code="at1045"><items id="description">The individual is in the natural state of bodily rest.</items><items id="text">Sleeping</items></items><items code="at1051"><items id="description">A toe of the individual.</items><items id="text">Toe</items></items><items code="at1052"><items id="description">Comment on and record other incidental factors that may be contributing to the blood pressure measurement.  For example, level of anxiety or 'white coat syndrome'; pain or fever; changes in atmospheric pressure etc.</items><items id="text">Confounding factors</items></items><items code="at1053"><items id="description">Invasive measurement via transducer access line within an artery.</items><items id="text">Intra-arterial</items></items><items code="at1054"><items id="description">Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).</items><items id="text">Systolic pressure formula</items></items><items code="at1055"><items id="description">Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).</items><items id="text">Diastolic pressure formula</items></items><items code="at1056"><items id="description">The individual's dorsum of the foot.</items><items id="text">Dorsum of foot</items></items><items code="at1057"><items id="description">Structured anatomical location of where the measurement was taken.</items><items id="text">Structured measurement location</items></items><items code="at1058"><items id="comment">For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local context or to align with other reference models/formalisms.</items><items id="text">Extension</items></items><items code="at1059"><items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the blood pressure measurement.</items><items id="text">Clinical interpretation</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="comment">Por lo general, el término «presión arterial» se refiere a la medición de la presión en la arteria braquial, situada en la parte superior del brazo.</items><items id="description">La medición local de la presión arterial, que es un sustituto de la presión arterial en la circulación sistémica.</items><items id="text">Presión arterial</items></items><items code="at0001"><items id="description">Nodo estructural de historia.</items><items id="text">Historia</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">blood pressure</items></items><items code="at0004"><items id="description">Presión arterial sistémica máxima - medida en la fase sistólica o de contracción del ciclo cardíaco.</items><items id="text">Sistólica</items></items><items code="at0005"><items id="description">Presión arterial sistémica mínima - medida en la fase diastólica o de relajación del ciclo cardíaco.</items><items id="text">Diastólica</items></items><items code="at0006"><items id="description">Evento predeterminado, sin especificar en el tiempo o intervalo, que puede definirse explícitamente en una plantilla o en tiempo de ejecución.</items><items id="text">Cualquier evento</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">La posición del individuo en el momento de la medición.</items><items id="text">Posición</items></items><items code="at0011"><items id="description">Estructura de la lista.</items><items id="text">Árbol</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">El tamaño del manguito utilizado para medir la presión arterial.</items><items id="text">Tamaño del manguito</items></items><items code="at0014"><items id="description">Zona del cuerpo donde se midió la presión arterial.</items><items id="text">Localización de la medición</items></items><items code="at0015"><items id="description">Un manguito utilizado para el muslo de un adulto.</items><items id="text">Muslo Adulto</items></items><items code="at0016"><items id="description">Un manguito para adultos con brazos más grandes.</items><items id="text">Adulto Grande</items></items><items code="at0017"><items id="description">Un manguito estándar para adultos.</items><items id="text">Adulto</items></items><items code="at0025"><items id="description">El brazo derecho de la persona.</items><items id="text">Brazo derecho</items></items><items code="at0026"><items id="description">El brazo izquierdo de la persona.</items><items id="text">Brazo izquierdo</items></items><items code="at0027"><items id="description">El muslo derecho de la persona.</items><items id="text">Muslo derecho</items></items><items code="at0028"><items id="description">Muslo izquierdo del paciente</items><items id="text">Muslo izquierdo</items></items><items code="at0033"><items id="description">Información adicional sobre la medición que no se recoge en otros campos.</items><items id="text">Comentario</items></items><items code="at1000"><items id="description">De pie en el momento de la medición de la presión arterial.</items><items id="text">De pie</items></items><items code="at1001"><items id="description">Sentado (por ejemplo, en la cama o en una silla) en el momento de la medición de la presión arterial.</items><items id="text">Sentado</items></items><items code="at1002"><items id="description">Reclinado en el momento de la medición de la presión arterial.</items><items id="text">Reclinado</items></items><items code="at1003"><items id="description">Acostado en el momento de la medición de la presión arterial.</items><items id="text">Acostado</items></items><items code="at1005"><items id="comment">NOTA: "°" es una unidad válida en UCUM. Utilice "deg" como unidad correcta.</items><items id="description">La inclinación craneocaudal de la superficie sobre la que se encuentra la persona en el momento de la medición.</items><items id="text">Inclinación</items></items><items code="at1006"><items id="description">La presión arterial media que se produce a lo largo de todo el ciclo de contracción y relajación del corazón.</items><items id="text">Presión arterial media</items></items><items code="at1007"><items id="description">La diferencia entre la presión sistólica y la presión diastólica.</items><items id="text">Presión del pulso</items></items><items code="at1008"><items id="description">Un manguito utilizado para adultos de complexión pequeña.</items><items id="text">Adulto Pequeño</items></items><items code="at1009"><items id="description">Un manguito adecuado para niños o adultos con brazos delgados.</items><items id="text">Pediátrico/Niños</items></items><items code="at1010"><items id="description">Registre qué sonido de Korotkoff se utiliza para determinar la presión diastólica mediante el método auscultativo.</items><items id="text">Punto final diastólico</items></items><items code="at1011"><items id="description">El cuarto sonido de Korotkoff se identifica como un abrupto amortiguamiento de los sonidos.</items><items id="text">Fase IV</items></items><items code="at1012"><items id="description">El quinto sonido de Korotkoff se identifica por la ausencia de sonidos cuando la presión del manguito desciende por debajo de la presión arterial diastólica.</items><items id="text">Fase V</items></items><items code="at1014"><items id="description">Acostada boca arriba con cierta inclinación lateral, normalmente hacia el lado izquierdo. Se suele requerir en el último trimestre del embarazo para aliviar la compresión aortocava.</items><items id="text">Tumbado con inclinación hacia la izquierda</items></items><items code="at1018"><items id="description">Un manguito utilizado para bebés.</items><items id="text">Bebé</items></items><items code="at1019"><items id="description">Un manguito utilizado para un recién nacido, suponiendo que el manguito sea del tamaño adecuado para la madurez y el peso al nacer del recién nacido.</items><items id="text">Neonatal</items></items><items code="at1020"><items id="description">La muñeca derecha de la persona.</items><items id="text">Muñeca derecha</items></items><items code="at1021"><items id="description">La muñeca izquierda de la persona.</items><items id="text">Muñeca izquierda</items></items><items code="at1025"><items id="description">Detalles sobre el esfigmomanómetro u otro dispositivo utilizado para medir la presión arterial.</items><items id="text">Dispositivo</items></items><items code="at1026"><items id="description">El tobillo derecho de la persona.</items><items id="text">Tobillo derecho</items></items><items code="at1030"><items id="description">Detalles sobre la actividad física realizada en el momento de la medición de la presión arterial.</items><items id="text">Esfuerzo</items></items><items code="at1031"><items id="description">El tobillo izquierdo de la persona.</items><items id="text">Tobillo izquierdo</items></items><items code="at1032"><items id="description">Un dedo de la mano de la persona.</items><items id="text">Dedo de la mano</items></items><items code="at1035"><items id="description">Método de medición de la presión arterial.</items><items id="text">Método</items></items><items code="at1036"><items id="description">Método para medir la presión arterial de forma externa, utilizando un estetoscopio y los sonidos de Korotkoff.</items><items id="text">Auscultación</items></items><items code="at1037"><items id="description">Método para medir la presión arterial de forma externa, mediante palpación (normalmente de las arterias braquial o radial).</items><items id="text">Palpación</items></items><items code="at1038"><items id="description">Fórmula utilizada para calcular la presión arterial media (si se registra en los datos).</items><items id="text">Fórmula de la presión arterial media</items></items><items code="at1039"><items id="description">Método para medir la presión arterial de forma externa, utilizando un tensiómetro.</items><items id="text">Aparato</items></items><items code="at1040"><items id="description">Método para medir la presión arterial internamente, es decir, mediante la penetración de la piel y la medición dentro de los vasos sanguíneos.</items><items id="text">Invasivo</items></items><items code="at1042"><items id="description">Estimación de la presión arterial media durante un periodo de 24 horas.</items><items id="text">Promedio de 24 horas</items></items><items code="at1043"><items id="description">Estado del sueño - permite interpretar los registros de presión arterial ambulatoria de 24 horas.</items><items id="text">Estado del sueño</items></items><items code="at1044"><items id="description">El individuo está plenamente consciente.</items><items id="text">Despierto</items></items><items code="at1045"><items id="description">El individuo se encuentra en un estado natural de reposo corporal.</items><items id="text">Durmiendo</items></items><items code="at1051"><items id="description">Un dedo del pie de la persona.</items><items id="text">Dedo del pie</items></items><items code="at1052"><items id="description">Comente y registre otros factores incidentales que puedan estar contribuyendo a la medición de la presión arterial. Por ejemplo, el nivel de ansiedad o el «síndrome de la bata blanca», dolor o fiebre, cambios en la presión atmosférica, etc.</items><items id="text">Factores de confusión</items></items><items code="at1053"><items id="description">Medición invasiva mediante una línea de acceso al transductor dentro de una arteria.</items><items id="text">Intraarterial</items></items><items code="at1054"><items id="description">Fórmula utilizada para calcular la presión sistólica a partir de la presión arterial media (si se registra en los datos).</items><items id="text">Fórmula de la presión sistólica</items></items><items code="at1055"><items id="description">Fórmula utilizada para calcular la presión diastólica a partir de la presión arterial media (si se registra en los datos).</items><items id="text">Fórmula de la presión diastólica</items></items><items code="at1056"><items id="description">El dorso del pie de la persona.</items><items id="text">Dorso del pie</items></items><items code="at1057"><items id="description">Localización anatómica estructurada del lugar donde se tomó la medida.</items><items id="text">Lugar de medición estructurado</items></items><items code="at1058"><items id="comment">Por ejemplo: información departamental de hospitales locales o metadatos adicionales para alinearse con los equivalentes FHIR o CIMI.</items><items id="description">Información adicional necesaria para captar el contexto local o para alinearse con otros modelos de referencia/formalismos.</items><items id="text">Extensión</items></items><items code="at1059"><items id="description">Palabra, frase o breve descripción que representa el significado clínico y la importancia de la medición de la presión arterial.</items><items id="text">Interpretación clínica</items></items></term_definitions><term_definitions language="es-ar"><items code="at0000"><items id="description">La medición local de la tensión arterial que deriva de la medida de la presión arterial en la circulación sistémica. Comúnmente el uso de 'presión arterial' se refiere a la medida de la presión de la arteria braquial por encima del pliegue del codo.</items><items id="text">Presión Arterial</items></items><items code="at0001"><items id="description">historia Nodo estructural</items><items id="text">historia</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">Presión arterial sistólica pico - medido en sístole o la fase de contracción del ciclo cardíaco</items><items id="text">Sistólica</items></items><items code="at0005"><items id="description">Presión arterial sistémica mínima - medido durante la diástole o fase de relajación del ciclo cardíaco.</items><items id="text">Diástole</items></items><items code="at0006"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">La posición del individuo en el momento del registro.</items><items id="text">Posición</items></items><items code="at0011"><items id="description">estructura tipo lista</items><items id="text">estructura de lista</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Presión arterial humana determinado por esfingomanómetro. Circulation 1993;88;2460-2470.</items><items id="description">El tamaño del manguito usado para la toma de la presión arterial</items><items id="text">Tamaño del manguito</items></items><items code="at0014"><items id="description">*Simple body site where blood pressure was measured.(en)</items><items id="text">*Location of measurement(en)</items></items><items code="at0015"><items id="description">Un manguito usado para el muslo del adulto - cámara de caucho aproximadamente de 20cm x 42 cm</items><items id="text">Muslo Adulto</items></items><items code="at0016"><items id="description">Un manguito para adultos con brazos mas grandes - cámara de caucho aproximadamente de 16cm x 38cm.</items><items id="text">Adulto grande</items></items><items code="at0017"><items id="description">Un manguito estándar para adulto - cámara de caucho approximadamente de 13cm x 30cm.</items><items id="text">Adulto</items></items><items code="at0025"><items id="description">El brazo derecho del individuo</items><items id="text">Brazo derecho</items></items><items code="at0026"><items id="description">El brazo izquierdo del individuo</items><items id="text">Brazo izquierdo</items></items><items code="at0027"><items id="description">El muslo derecho del individuo</items><items id="text">Muslo derecho</items></items><items code="at0028"><items id="description">El muslo izquierdo del individuo</items><items id="text">Muslo izquierdo</items></items><items code="at0033"><items id="description">*Additional narrative about the measurement, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at1000"><items id="description">De pie al momento de la medición de la tensión arterial.</items><items id="text">De pie</items></items><items code="at1001"><items id="description">Sentado (en la cama o en una silla) durante el registro de la presión arterial </items><items id="text">Sentado</items></items><items code="at1002"><items id="description">Reclinado (semisentado) durante el registro de la presión arterial</items><items id="text">Reclinado</items></items><items code="at1003"><items id="description">Acostado horizontal durante la medición de la presión arterial</items><items id="text">Acostado</items></items><items code="at1005"><items id="comment">*PLEASE NOTE: '°' is a valid UCUM unit. Please use 'deg' as the correct unit.(en)</items><items id="description">*The craniocaudal tilt of the surface on which the person is lying at the time of measurement.(en)</items><items id="text">*Tilt(en)</items></items><items code="at1006"><items id="description">La presión arterial promedio que ocurre durante el ciclo entero de la contracción y relajación del corazon</items><items id="text">Presión Arterial Media</items></items><items code="at1007"><items id="description">La diferencia entre la presión sistólica y la presión diastólica</items><items id="text">Presión de Pulso</items></items><items code="at1008"><items id="description">Un manguito usado para adulto pequeño - cámara de caucho approximadamente de 10cm x 24cm.</items><items id="text">Adulto pequeño</items></items><items code="at1009"><items id="description">Un manguito que es apropiado para un niño o un adulto con brazos delgados - cámara de caucho approximadamente 8cm x 21cm.</items><items id="text">Pediátrico/Niño</items></items><items code="at1010"><items id="description">Registro usando los sonidos de Korotkoff para determinar la presión diastólica</items><items id="text">Punto final diastólica</items></items><items code="at1011"><items id="description">El cuarto sonido de Korotkoff se identifica como una abrupta amortiguación de sonidos.</items><items id="text">Fase IV</items></items><items code="at1012"><items id="description">El quinto sonido de Korotkoff se identifica como la ausencia de sonidos a medida que la presión del manguito insuflado cae por debajo de la presión arterial diastólica.</items><items id="text">Fase V</items></items><items code="at1014"><items id="description">Acostado horizontal e inclinado levemente sobre su costado izquierdo. Comúnmente se requiere durante el último trimestre del embarazo para aliviar la compresión aortocava.</items><items id="text">Acostado e inclinado levemente sobre su costado izquierdo</items></items><items code="at1018"><items id="description">Un manguito usado para infantes - cámara de caucho approximadamente de 5cm x 15cm.</items><items id="text">Infantil</items></items><items code="at1019"><items id="description">Un manguito usado para neonatos, asumiendo que es del tamaño adecuado para la madurez y el peso corporal del neonato.</items><items id="text">Neonatal</items></items><items code="at1020"><items id="description">La muñeca derecha del individuo.</items><items id="text">Muñeca derecha</items></items><items code="at1021"><items id="description">La muñeca inquierda del individuo.</items><items id="text">Muñeca izquierda</items></items><items code="at1025"><items id="description">Detalles del esfingomanómetro u otro dispositivo usado para medir la presión arterial.</items><items id="text">Dispositivo</items></items><items code="at1026"><items id="description">El tobillo derecho del individuo.</items><items id="text">Tobillo derecho</items></items><items code="at1030"><items id="description">Detalles de la actividad física realizados durante la medición de la presión arterial </items><items id="text">Ejercicio</items></items><items code="at1031"><items id="description">El tobillo izquierdo del individuo</items><items id="text">Tobillo izquierdo</items></items><items code="at1032"><items id="description">*A finger of the individual.(en)</items><items id="text">*Finger(en)</items></items><items code="at1035"><items id="description">Método de la medición de la presión arterial</items><items id="text">Método</items></items><items code="at1036"><items id="description">Método de la medición de la presión arterial externa, usando un estetoscopio y los sonidos de Korotkoff</items><items id="text">Auscultación</items></items><items code="at1037"><items id="description">Método de medición de la presión arterial externa, usando palpación (normalmente de la arteria humeral o radial).</items><items id="text">Palpación</items></items><items code="at1038"><items id="description">Fórmula usada para calcular la PAM (si se registra en el campo data)</items><items id="text">Fórmula de la Presión Arterial Media (PAM)</items></items><items code="at1039"><items id="description">Método de medición de la presión arterial externa, utilizando un monitor automático (mecánico) de presión arterial</items><items id="text">Máquina</items></items><items code="at1040"><items id="description">Método de medición de la presión arterial interna o sea invasiva: punción de la piel y la introducción de un cateter para medir dentro de un vaso sanguíneo.</items><items id="text">Invasivo</items></items><items code="at1042"><items id="description">Estimativo de la media de la presión arterial sobre un período de 24 horas</items><items id="text">Promedio de 24 horas</items></items><items code="at1043"><items id="description">Estado del sueño - soporta la interpretación de los registros de presión arterial ambulatorios de 24 horas</items><items id="text">Estado del sueño</items></items><items code="at1044"><items id="description">El sujeto esta plenamente consciente</items><items id="text">Alerta y despierto</items></items><items code="at1045"><items id="description">El sujeto esta en un estado natural de sueño corporal</items><items id="text">Dormido</items></items><items code="at1051"><items id="description">*A toe of the individual.(en)</items><items id="text">*Toe(en)</items></items><items code="at1052"><items id="description">Comentario y registro sobre otros factores que pueden incidir sobre la medición de la presión arterial. Por ejemplo: nivel de ansiedad o "síndrome del guardapolvo blanco"; dolor o fiebre; cambios en la presión atmosférica etc.</items><items id="text">Factores confluentes</items></items><items code="at1053"><items id="description">*Invasive measurement via transducer access line within an artery.(en)</items><items id="text">*Intra-arterial(en)</items></items><items code="at1054"><items id="description">*Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Systolic pressure formula(en)</items></items><items code="at1055"><items id="description">*Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Diastolic pressure formula(en)</items></items><items code="at1056"><items id="description">**(en)</items><items id="text">*Dorsum of foot(en)</items></items><items code="at1057"><items id="description">*Structured anatomical location of where the measurement was taken.(en)</items><items id="text">*Structured measurement location(en)</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">**(en)</items><items id="text">*New element(en)</items></items></term_definitions><term_definitions language="fa"><items code="at0000"><items id="description">اندازه گیری موضعی فشار خون وریدی، که جایگزینی برای فشار وریدی در گردش خون کلی است.&#13;
معمولا واژه "فشار خون" به اندازه گیری فشار ورید بازویی در روی بازو گفته می شود</items><items id="text">فشار خون</items></items><items code="at0001"><items id="description">گره ساختاری تاریخچه </items><items id="text">تاریخچه</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">اوج فشار خون وریدی کلی که در سیستولیک یا فاز انقباضی چرخه گردش خون اندازه گیری می شود </items><items id="text">سیستولیک</items></items><items code="at0005"><items id="description">حداقل فشار خون وریدی کلی که در دیاستولیک یا فاز انبساطی چرخه گردش خون اندازه گیری می شود</items><items id="text">دیاستولیک</items></items><items code="at0006"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">موقعیت فرد در زمان اندازه گیری </items><items id="text">موقعیت</items></items><items code="at0011"><items id="description">ساختار لیست </items><items id="text">ساختار لیست</items></items><items code="at0013"><items id="description">اندازه کاف استفاده شده برای اندازه گیری فشار خون</items><items id="text">اندازه کاف</items></items><items code="at0014"><items id="description">*Simple body site where blood pressure was measured.(en)</items><items id="text">*Location of measurement(en)</items></items><items code="at0015"><items id="description">کاف استفاده شده در ران بزرگسال -اندازه مثانه 20 سانتی متر در 42 سانتی متر</items><items id="text">ران بزرگسال</items></items><items code="at0016"><items id="description">کاف بزرگسالان با برآمدگی بازوی بزرگتر در حدود 16 در 38 سانتیمتر</items><items id="text">بزرگسال درشت</items></items><items code="at0017"><items id="description">*A cuff that is standard for an adult - bladder approx 13cm x 30cm.(en)</items><items id="text">*Adult(en)</items></items><items code="at0025"><items id="description">*The right arm of the person.(en)</items><items id="text">*Right arm(en)</items></items><items code="at0026"><items id="description">*The left arm of the person.(en)</items><items id="text">*Left arm(en)</items></items><items code="at0027"><items id="description">*The right thigh of the person.(en)</items><items id="text">*Right thigh(en)</items></items><items code="at0028"><items id="description">*The left thigh of the person.(en)</items><items id="text">*Left thigh(en)</items></items><items code="at0033"><items id="description">*Additional narrative about the measurement, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at1000"><items id="description">ایستاده در زمان اندازه گیری فشار خون</items><items id="text">ایستاده</items></items><items code="at1001"><items id="description">نشسته ( به عنوان مثال روی تخت یا صندلی) در زمان اندازه گیری فشار خون</items><items id="text">نشسته</items></items><items code="at1002"><items id="description">خمیده در زمان اندازه گیری فشار خون</items><items id="text">خمیده</items></items><items code="at1003"><items id="description">خوابیده در زمان اندازه گیری فشار خون</items><items id="text">خوابیده</items></items><items code="at1005"><items id="comment">*PLEASE NOTE: '°' is a valid UCUM unit. Please use 'deg' as the correct unit.(en)</items><items id="description">*The craniocaudal tilt of the surface on which the person is lying at the time of measurement.(en)</items><items id="text">*Tilt(en)</items></items><items code="at1006"><items id="description">متوسط فشار خون وریدی که در کل دوره انقباظ و انبساط قلبی رخ می دهد</items><items id="text">میانگین فشار وریدی</items></items><items code="at1007"><items id="description">تفاوت بین فشار سیستولیک و دیاستولیک</items><items id="text">فشار نبضی</items></items><items code="at1008"><items id="description">*A cuff used for a small adult - bladder approx 10cm x 24cm.(en)</items><items id="text">*Small Adult(en)</items></items><items code="at1009"><items id="description">*A cuff that is appropriate for a child or adult with a thin arm - bladder approx 8cm x 21cm.(en)</items><items id="text">*Paediatric/Child(en)</items></items><items code="at1010"><items id="description">*Record which Korotkoff sound is used for determining diastolic pressure using auscultative method.(en)</items><items id="text">*Diastolic endpoint(en)</items></items><items code="at1011"><items id="description">*The fourth Korotkoff sound is identified as an abrupt muffling of sounds.(en)</items><items id="text">*Phase IV(en)</items></items><items code="at1012"><items id="description">*The fifth Korotkoff sound is identified by absence of sounds as the cuff pressure drops below the diastolic blood pressure.(en)</items><items id="text">*Phase V(en)</items></items><items code="at1014"><items id="description">خوابیدن صاف با کمی تمایل به یک سمت، معمولا به جهت چپ میل کرده و عموما در سه ماهه آخر حاملگی برای تسکین فشار آئورت نیاز به آن است</items><items id="text">خوابیده  به چپ</items></items><items code="at1018"><items id="description">*A cuff used for infants - bladder approx 5cm x 15cm.(en)</items><items id="text">*Infant(en)</items></items><items code="at1019"><items id="description">*A cuff used for a neonate, assuming cuff is the appropriate size for maturity and birthweight of the neonate.(en)</items><items id="text">*Neonatal(en)</items></items><items code="at1020"><items id="description">*The right wrist of the individual.(en)</items><items id="text">*Right wrist(en)</items></items><items code="at1021"><items id="description">*The left wrist of the individual.(en)</items><items id="text">*Left wrist(en)</items></items><items code="at1025"><items id="description">*Details about sphygmomanometer or other device used to measure the blood pressure.(en)</items><items id="text">*Device(en)</items></items><items code="at1026"><items id="description">*The right ankle of the individual.(en)</items><items id="text">*Right ankle(en)</items></items><items code="at1030"><items id="description">جزییاتی درباره فعالیت فیزیکی انجام شده در زمان اندازه گیری فشار خون </items><items id="text">تقلا</items></items><items code="at1031"><items id="description">*The left ankle of the individual.(en)</items><items id="text">*Left ankle(en)</items></items><items code="at1032"><items id="description">*A finger of the individual.(en)</items><items id="text">*Finger(en)</items></items><items code="at1035"><items id="description">*Method of measurement of blood pressure.(en)</items><items id="text">*Method(en)</items></items><items code="at1036"><items id="description">*Method of measuring blood pressure externally, using a stethoscope and Korotkoff sounds.(en)</items><items id="text">*Auscultation(en)</items></items><items code="at1037"><items id="description">*Method of measuring blood pressure externally, using palpation (usually of the brachial or radial arteries).(en)</items><items id="text">*Palpation(en)</items></items><items code="at1038"><items id="description">*Formula used to calculate the MAP (if recorded in data).(en)</items><items id="text">*Mean Arterial Pressure Formula(en)</items></items><items code="at1039"><items id="description">*Method of measuring blood pressure externally, using a blood pressure machine.(en)</items><items id="text">*Machine(en)</items></items><items code="at1040"><items id="description">*Method of measuring blood pressure internally ie involving penetration of the skin and measuring inside blood vessels.(en)</items><items id="text">*Invasive(en)</items></items><items code="at1042"><items id="description">برآورد میانگین فشار خون در دوره زمانی 24 ساعته</items><items id="text">میانگین 24 ساعته</items></items><items code="at1043"><items id="description">وضعیت خواب- به تفسیر ثبتهای صورت گرفته از فشار خون در خانه در طول 24 ساعت کمک می کند </items><items id="text">وضعیت خواب</items></items><items code="at1044"><items id="description">فرد کاملا به هوش است </items><items id="text">هشیار و بیدار</items></items><items code="at1045"><items id="description">فرد در حالت طبیعی استراحت بدنی است</items><items id="text">خوابیده</items></items><items code="at1051"><items id="description">*A toe of the individual.(en)</items><items id="text">*Toe(en)</items></items><items code="at1052"><items id="description">نظردهی و ثبت سایر عوامل ضمنی که ممکن است به اندازه گیری فشار خون کمک کنند . به عنوان مثال سطح اضطراب یا "سندرم روپوش سفید"، درد یا تب ، تغییرات فشار جوی و غیره </items><items id="text">عوامل مبهم</items></items><items code="at1053"><items id="description">*Invasive measurement via transducer access line within an artery.(en)</items><items id="text">*Intra-arterial(en)</items></items><items code="at1054"><items id="description">*Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Systolic pressure formula(en)</items></items><items code="at1055"><items id="description">*Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Diastolic pressure formula(en)</items></items><items code="at1056"><items id="description">**(en)</items><items id="text">*Dorsum of foot(en)</items></items><items code="at1057"><items id="description">*Structured anatomical location of where the measurement was taken.(en)</items><items id="text">*Structured measurement location(en)</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">**(en)</items><items id="text">*New element(en)</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="comment">Yleisimmin termi "verenpaine" viittaa olkavarsivaltimon paineen mittaamiseen yläraajasta.</items><items id="description">Paikallisen valtimopaineen mittaustulos, joka toimii korvikkeena systeemisen verenkierron valtimopaineelle. Termillä "verenpaine" viitataan yleensä olkavarresta tehtävään olkavarsivaltimon paineen mittaustulokseen.</items><items id="text">Verenpaine</items></items><items code="at0001"><items id="description">Historia-rakennesolmu.</items><items id="text">Historia</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">blood pressure</items></items><items code="at0004"><items id="description">Systeemisen verenkierron valtimoverenpaineen huippuarvo – mitataan sydämen supistumisvaiheessa.</items><items id="text">Systolinen</items></items><items code="at0005"><items id="description">Systeemisen verenkierron valtimoverenpaineen pienin arvo – mitataan sydämen lepovaiheessa.</items><items id="text">Diastolinen</items></items><items code="at0006"><items id="description">Oletusarvo, määrittämätön ajanhetki tai aikaväli, joka voidaan nimenomaisesti määritellä templaatilla tai suorituksen aikana.</items><items id="text">Mikä tahansa tapahtuma</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0008"><items id="description">Henkilön asento mittaushetkellä.</items><items id="text">Asento</items></items><items code="at0011"><items id="description">Luettelon rakenne.</items><items id="text">Puu</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">Verenpaineen mittauksessa käytetyn mansetin koko.</items><items id="text">Mansetin koko</items></items><items code="at0014"><items id="description">Kehon yksinkertaisesti ilmaistu kohta, josta verenpaine mitattiin.</items><items id="text">Mittauskohta</items></items><items code="at0015"><items id="description">Aikuisen reidessä käytettävä mansetti.</items><items id="text">Aikuisen reisi</items></items><items code="at0016"><items id="description">Mansetti aikuisille, joilla on paksut käsivarret.</items><items id="text">Aikuiset, suuri</items></items><items code="at0017"><items id="description">Standardikokoinen mansetti aikuisille.</items><items id="text">Aikuinen</items></items><items code="at0025"><items id="description">Henkilön oikea käsivarsi.</items><items id="text">Oikea käsivarsi</items></items><items code="at0026"><items id="description">Henkilön vasen käsivarsi.</items><items id="text">Vasen käsivarsi</items></items><items code="at0027"><items id="description">Henkilön oikea reisi.</items><items id="text">Oikea reisi</items></items><items code="at0028"><items id="description">Henkilön vasen reisi.</items><items id="text">Vasen reisi</items></items><items code="at0033"><items id="description">Mittauksen kertomusmuodossa olevat lisätiedot, joita ei voida ilmoittaa muissa kentissä.</items><items id="text">Kommentti</items></items><items code="at1000"><items id="description">Verenpaine mitataan henkilön seistessä.</items><items id="text">Seisten</items></items><items code="at1001"><items id="description">Verenpaine mitataan henkilön istuessa (esimerkiksi vuoteella tai tuolissa).</items><items id="text">Istuen</items></items><items code="at1002"><items id="description">Verenpaine mitataan henkilön nojatessa taaksepäin.</items><items id="text">Taaksepäin nojaten</items></items><items code="at1003"><items id="description">Verenpaine mitataan henkilön maatessa.</items><items id="text">Makuulla</items></items><items code="at1005"><items id="description">Kraniokaudaalinen kallistuma alustalla, jolla henkilö makaa mittauksen aikana.</items><items id="text">Kallistuma</items></items><items code="at1006"><items id="description">Keskiarvo valtimopaineesta, joka ilmenee sydämen supistumis- ja rentoutumissyklin aikana.</items><items id="text">Keskivaltimopaine</items></items><items code="at1007"><items id="description">Systolisen ja diastolisen paineen erotus.</items><items id="text">Pulssipaine</items></items><items code="at1008"><items id="description">Pienikokoiselle aikuiselle käytettävä mansetti.</items><items id="text">Aikuiset, pieni</items></items><items code="at1009"><items id="description">Mansetti, joka sopii lapselle tai ohutkäsivartiselle aikuiselle.</items><items id="text">Pediatrinen/lapsi</items></items><items code="at1010"><items id="description">Tieto siitä, minkä Korotkoffin äänen perusteella diastolinen paine määritetään auskultoitaessa.</items><items id="text">Diastolinen päätetapahtuma</items></items><items code="at1011"><items id="description">Neljäs Korotkoffin ääni määrittään äänien äkilliseksi heikkenemiseksi.</items><items id="text">Vaihe IV</items></items><items code="at1012"><items id="description">Viides Korotkoffin ääni määritetään äänien kuulumisen lakkaamiseksi, kun mansetin paine laskee diastolisen verenpaineen alapuolelle.</items><items id="text">Vaihe V</items></items><items code="at1014"><items id="description">Makuulla, hiukan kallellaan kyljen suunnassa, yleensä vasemmalle. Tarvitaan yleensä viimeisellä raskauskolmanneksella supiinioireyhtymän helpottamiseksi.</items><items id="text">Makuulla vasemmalle kallellaan</items></items><items code="at1018"><items id="description">Vauvoille käytettävä mansetti.</items><items id="text">Vauva</items></items><items code="at1019"><items id="description">Vastasyntyneille käytettävä mansetti, mikäli mansetti on oikean kokoinen vastasyntyneen kokoon ja kehitystasoon nähden.</items><items id="text">Vastasyntynyt</items></items><items code="at1020"><items id="description">Tutkittavan oikea ranne.</items><items id="text">Oikea ranne</items></items><items code="at1021"><items id="description">Tutkittavan vasen ranne.</items><items id="text">Vasen ranne</items></items><items code="at1025"><items id="description">Tiedot sfygmomanometrista tai muusta laitteesta, jolla verenpaine mitataan.</items><items id="text">Laite</items></items><items code="at1026"><items id="description">Tutkittavan oikea nilkka.</items><items id="text">Oikea nilkka</items></items><items code="at1030"><items id="description">Tiedot fyysisestä rasituksesta, jolle tutkittava altistettiin verenpaineen mittauksen aikana.</items><items id="text">Rasitus</items></items><items code="at1031"><items id="description">Tutkittavan vasen nilkka.</items><items id="text">Vasen nilkka</items></items><items code="at1032"><items id="description">Tutkittavan sormi.</items><items id="text">Sormi</items></items><items code="at1035"><items id="description">Verenpaineen mittausmenetelmä.</items><items id="text">Menetelmä</items></items><items code="at1036"><items id="description">Menetelmä, jolla verenpaine mitataan ulkoisesti käyttämällä stetoskooppia ja Korotkoffin ääniä.</items><items id="text">Auskultaatio</items></items><items code="at1037"><items id="description">Menetelmä, jolla verenpaine mitataan ulkoisesti palpoimalla (yleensä olkavarsi- tai värttinävaltimosta).</items><items id="text">Palpaatio</items></items><items code="at1038"><items id="description">Keskivaltimopaineen laskennassa käytettävä kaava (jos kirjattu tietoihin).</items><items id="text">Keskivaltimopaineen kaava</items></items><items code="at1039"><items id="description">Menetelmä, jolla verenpaine mitataan ulkoisesti koneella.</items><items id="text">Kone</items></items><items code="at1040"><items id="description">Menetelmä, jolla verenpaine mitataan sisäisesti, eli ihon läpi tunkeutuen ja verisuonen sisältä.</items><items id="text">Invasiivinen</items></items><items code="at1042"><items id="description">Arvio verenpaineen keskiarvosta 24 tunnin ajanjaksona.</items><items id="text">24 tunnin keskiarvo</items></items><items code="at1043"><items id="description">Unitila – tukee 24 tunnin ambulatorisen verenpainemittauksen tulosten tulkintaa.</items><items id="text">Unitila</items></items><items code="at1044"><items id="description">Tutkittava on täysin tajuissaan.</items><items id="text">Valpas ja hereillä</items></items><items code="at1045"><items id="description">Tutkittavan keho on luonnollisessa lepotilassa.</items><items id="text">Nukkuu</items></items><items code="at1051"><items id="description">Tutkittavan varvas.</items><items id="text">Varvas</items></items><items code="at1052"><items id="description">Kommentoi ja kirjaa muita satunnaistekijöitä, jotka saattavat vaikuttaa verenpaineen mittaukseen. Esimerkiksi ahdistuneisuus tai "valkotakkiverenpaine", kipu tai kuume; ilmanpaineen muutokset, jne.</items><items id="text">Sekoittavat tekijät</items></items><items code="at1053"><items id="description">Invasiivinen mittaus valtimoon sijoitetulla katetrinpääanturilla.</items><items id="text">Valtimonsisäinen</items></items><items code="at1054"><items id="description">Kaava jota käytetään systolisen paineen laskemiseen keskivaltimopaineesta (jos kirjattu tietoihin).</items><items id="text">Systolisen paineen kaava</items></items><items code="at1055"><items id="description">Kaava jota käytetään diastolisen paineen laskemiseen keskivaltimopaineesta (jos kirjattu tietoihin).</items><items id="text">Diastolisen paineen kaava</items></items><items code="at1056"><items id="description">Tutkittavan jalanselkä.</items><items id="text">Jalanselkä</items></items><items code="at1057"><items id="description">Rakenteellinen anatominen kohta, josta mittaus tehtiin.</items><items id="text">Rakenteellinen mittauskohta</items></items><items code="at1058"><items id="comment">Esimerkiksi: Paikallisen sairaalan osaston tiedot tai metatiedot FHIR- tai CIMI-vastineiden mukaisiksi.</items><items id="description">Lisätiedot, joita tarvitaan paikallisen asiayhteyden kirjaamiseksi tai yhtenäistämiseksi muiden viitemallien tai formalismien kanssa.</items><items id="text">Laajennus</items></items><items code="at1059"><items id="description">Yksittäinen sana, lause tai lyhyt kuvaus, joka edustaa verenpaineen mittauksen kliinistä merkitystä.</items><items id="text">Kliininen tulkinta</items></items></term_definitions><term_definitions language="ja"><items code="at0000"><items id="comment">ごく一般的には「血圧」という用語は上腕で計測される上腕動脈の圧を示している。</items><items id="description">全身を循環する動脈圧の指標として，局所で測定される血圧。一般的には「血圧」とは上腕で上腕動脈圧を測定したものをさすことが多い。</items><items id="text">血圧</items></items><items code="at0001"><items id="description">履歴構造ノード</items><items id="text">履歴</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">血圧</items></items><items code="at0004"><items id="description">全身の動脈血圧での最高値 - 心機図の収縮期で測定される</items><items id="text">収縮期</items></items><items code="at0005"><items id="description">全身の動脈血圧での最低値 - 心機図の拡張期で測定される</items><items id="text">拡張期</items></items><items code="at0006"><items id="description">デフォルトで、テンプレートや実行時に明示的に定義されていない任意の時点や間隔を示す。</items><items id="text">任意のイベント</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">計測のときの対象者の体位</items><items id="text">体位</items></items><items code="at0011"><items id="description">リスト構造</items><items id="text">ツリー</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">血圧測定のために使われるカフの大きさ.</items><items id="text">カフサイズ</items></items><items code="at0014"><items id="description">血圧が測定された一つの身体部位</items><items id="text">測定部位</items></items><items code="at0015"><items id="description">成人の大腿で血圧を測定するためのカフ。</items><items id="text">成人大腿</items></items><items code="at0016"><items id="description">大柄な成人の腕で測定するためのカフ。</items><items id="text">大柄な成人</items></items><items code="at0017"><items id="description">一般成人のためのカフ</items><items id="text">成人</items></items><items code="at0025"><items id="description">測定対象者の右腕</items><items id="text">右腕</items></items><items code="at0026"><items id="description">測定対象者の左腕</items><items id="text">左腕</items></items><items code="at0027"><items id="description">測定対象者の右大腿</items><items id="text">右大腿</items></items><items code="at0028"><items id="description">測定対象者の左大腿</items><items id="text">左大腿</items></items><items code="at0033"><items id="description">この計測について他に項目に該当しない追加記録</items><items id="text">コメント</items></items><items code="at1000"><items id="description">血圧測定時に立位</items><items id="text">立位</items></items><items code="at1001"><items id="description">血圧測定時に（たとえば、ベッドやイスの上で）坐位</items><items id="text">座位</items></items><items code="at1002"><items id="description">血圧測定時に斜位</items><items id="text">斜位</items></items><items code="at1003"><items id="description">血圧測定時に臥位</items><items id="text">臥位</items></items><items code="at1005"><items id="comment">注意： '°' は適切なUCUM単位である。正しい単位として'deg'(度）を使うこと。</items><items id="description">測定時に対象者が臥床している台の頭尾方向の傾き</items><items id="text">ティルト</items></items><items code="at1006"><items id="description">心臓の収縮拡張サイクルのすべての過程を通した動脈血圧の平均値.</items><items id="text">平均動脈圧</items></items><items code="at1007"><items id="description">1回の収縮サイクルでの血圧の変動</items><items id="text">脈圧</items></items><items code="at1008"><items id="description">小柄な成人のためのカフ</items><items id="text">小柄な成人</items></items><items code="at1009"><items id="description">小児あるいは痩せた成人のためのカフ</items><items id="text">幼児/小児</items></items><items code="at1010"><items id="description">拡張期圧を決めるためにどのコロトコフ音が使用されたかについて記録.</items><items id="text">拡張期終末</items></items><items code="at1011"><items id="description">コロトコフの4音。急速に減弱する時期.</items><items id="text">4期</items></items><items code="at1012"><items id="description">コロトコフの5音が聴取される時期。カフ圧が拡張期圧を下回り音が聴取されなくなる時期</items><items id="text">5期</items></items><items code="at1014"><items id="description">通常は頭から足までを水平にしてから左側に傾けられた状態。一般的には妊娠の第3トリメスターで大動脈・静脈を圧排から解放するために求められる体位である。</items><items id="text">左側臥位</items></items><items code="at1018"><items id="description">幼児のために使われるカフ</items><items id="text">幼児</items></items><items code="at1019"><items id="description">新生児用のカフ 想定されるカフは新生児の生下時体重と成熟度に応じて適切なものであること.</items><items id="text">新生児</items></items><items code="at1020"><items id="description">測定対象者の右手首</items><items id="text">右手首</items></items><items code="at1021"><items id="description">測定対象者の左手首</items><items id="text">左手首</items></items><items code="at1025"><items id="description">水銀血圧計あるいはそのほかの血圧を測定するために使われる機器.</items><items id="text">測定機器</items></items><items code="at1026"><items id="description">測定対象者の右足首</items><items id="text">右足首</items></items><items code="at1030"><items id="description">血圧測定時に行われた肉体的運動についての詳細。</items><items id="text">労作</items></items><items code="at1031"><items id="description">測定対象者の左足首</items><items id="text">左足首</items></items><items code="at1032"><items id="description">測定対象者の手指</items><items id="text">手指</items></items><items code="at1035"><items id="description">血圧の測方法。</items><items id="text">方法</items></items><items code="at1036"><items id="description">聴診器を使いコロトコフ音で外部から血圧を測定する方法.</items><items id="text">聴診</items></items><items code="at1037"><items id="description">脈拍(通常は上腕動脈あるいは橈骨動脈）を触診することにより外部から血圧を測定する方法</items><items id="text">触診</items></items><items code="at1038"><items id="description">平均動脈圧を計算するために使われた式（もしデータに記録されていれば）</items><items id="text">平均動脈圧の計算式</items></items><items code="at1039"><items id="description">血圧測定器を使って外部から血圧を測定する方法.</items><items id="text">機械</items></items><items code="at1040"><items id="description">経皮的に動脈を穿刺し，血管内部から血圧を測定する方法.</items><items id="text">侵襲的</items></items><items code="at1042"><items id="description">24時間での推定平均血圧</items><items id="text">24時間平均</items></items><items code="at1043"><items id="description">睡眠状況 24時間外来血圧記録の解釈を助けるため</items><items id="text">睡眠状況</items></items><items code="at1044"><items id="description">対象の意識は清明である。</items><items id="text">覚醒</items></items><items code="at1045"><items id="description">対象は自然な入眠状態にある</items><items id="text">睡眠中</items></items><items code="at1051"><items id="description">対象者の足尖部</items><items id="text">足尖</items></items><items code="at1052"><items id="description">血圧測定に寄与しうるその他の偶発的な要素についてのコメント。たとえば、不安の程度や「白衣性高血圧」、痛みや発熱、大気圧の変化など。</items><items id="text">交絡因子</items></items><items code="at1053"><items id="description">動脈内に観血的方法で留置したトランスデューサからAラインを経由して測定</items><items id="text">動脈内</items></items><items code="at1054"><items id="description">（もしデータが記録されていれば）平均動脈圧から収縮期血圧を計算した式</items><items id="text">収縮期圧計算式</items></items><items code="at1055"><items id="description">平均動脈圧から拡張期血圧を計算するために使われた式（もしデータに記録されていれば）</items><items id="text">拡張期圧計算式</items></items><items code="at1056"><items id="description">対象者の足背</items><items id="text">足背</items></items><items code="at1057"><items id="description">測定が行われた部位の解剖学的位置について構造化された表現</items><items id="text">構造化された測定部位</items></items><items code="at1058"><items id="comment">例：FHIRやCIMIなどと連携するために病院内で独自に追加して利用されるメターデータ。</items><items id="description">測定時の背景を収集したり、その他の参照モデルや形式と連携するために必要となる追加情報</items><items id="text">拡張領域</items></items><items code="at1059"><items id="description">血圧測定の臨床的意義や重要性についての一言あるいは一文の簡潔な表現。</items><items id="text">臨床的解釈</items></items></term_definitions><term_definitions language="ko"><items code="at0000"><items id="description">체순환에서 동맥압을 대신하는 동맥혈압의 국소 측정. 보통은 '혈압'이라는 용어의 사용은 상완에서 상완동맥의 측정을 의미함.</items><items id="text">혈압</items></items><items code="at0001"><items id="description">*History Structural node.(en)</items><items id="text">*history(en)</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">최대 체동맥 혈압 - 심장 싸이클의 수축기에서 측정.</items><items id="text">수축기</items></items><items code="at0005"><items id="description">최소 체동맥 혈압 - 심장 싸이클의 이완기에서 측정됨.</items><items id="text">이완기</items></items><items code="at0006"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">측정 시에 대상의 자세</items><items id="text">자세</items></items><items code="at0011"><items id="description">*List structure.(en)</items><items id="text">*Tree(en)</items></items><items code="at0013"><items id="description">혈압 측정을 위해 사용되는 cuff의 크기.</items><items id="text">Cuff 크기</items></items><items code="at0014"><items id="description">*Simple body site where blood pressure was measured.(en)</items><items id="text">*Location of measurement(en)</items></items><items code="at0015"><items id="description">성인 허벅지을 위한 cuff - bladder가 약 20cm x 42cm.</items><items id="text">성인 허벅지</items></items><items code="at0016"><items id="description">*큰 팔을 가진 성인을 위한 cuff - bladder가 약 16cm x 38cm.(ko)</items><items id="text">*큰 성인(ko)</items></items><items code="at0017"><items id="description">*성인을 위한 표준인 cuff - bladder가 약 13cm x 30cm.(ko)</items><items id="text">*성인(ko)</items></items><items code="at0025"><items id="description">*사람의 우측 팔.(ko)</items><items id="text">*우측 팔(ko)</items></items><items code="at0026"><items id="description">*사람의 좌측 팔.(ko)</items><items id="text">*좌측 팔(ko)</items></items><items code="at0027"><items id="description">*사람의 우측 허벅지.(ko)</items><items id="text">*우측 허벅지(ko)</items></items><items code="at0028"><items id="description">*사람의 좌측 허벅지.(ko)</items><items id="text">*좌측 허벅지(ko)</items></items><items code="at0033"><items id="description">*Additional narrative about the measurement, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at1000"><items id="description">혈압측정 시에 서있는 자세.</items><items id="text">선 자세</items></items><items code="at1001"><items id="description">혈압 측정시에 앉은 자세(침대 또는 의자).</items><items id="text">앉은 자세</items></items><items code="at1002"><items id="description">혈압 측정시에 비스듬한 자세(reclining).</items><items id="text">비스듬한 자세</items></items><items code="at1003"><items id="description">혈압 측정시에 바로 누운 자세.</items><items id="text">누운 자세</items></items><items code="at1005"><items id="comment">*PLEASE NOTE: '°' is a valid UCUM unit. Please use 'deg' as the correct unit.(en)</items><items id="description">*The craniocaudal tilt of the surface on which the person is lying at the time of measurement.(en)</items><items id="text">*Tilt(en)</items></items><items code="at1006"><items id="description">심장의 수축과 이완 싸이클 전체과정 동안에 발생하는 평균 동맥압.</items><items id="text">평균 동맥압</items></items><items code="at1007"><items id="description">수축기와 이완기 혈압 간의 차이.</items><items id="text">맥압</items></items><items code="at1008"><items id="description">*작은 성인을 위해 사용되는 cuff - bladder가 약 10cm x 24cm.(ko)</items><items id="text">*작은 성인(ko)</items></items><items code="at1009"><items id="description">*아동이나 얋은 팔을 가진 성인에게 적합한 cuff - bladder가 약 8cm x 21cm.(ko)</items><items id="text">*소아/아동(ko)</items></items><items code="at1010"><items id="description">*청진법을 이용하여 이완기 압력을 결정하는데 사용되는 Korotkoff sound를 기록.(ko)</items><items id="text">*이완기 종점(ko)</items></items><items code="at1011"><items id="description">*4번째 Korotkoff sound가 갑작스런 약해지는 소리로 확인된다.(ko)</items><items id="text">*Phase IV(en)</items></items><items code="at1012"><items id="description">*5번째 Korotkoff sound는 cuff 압력이 이완기 혈압 아래로 떨어져 소리가 없어짐으로써 확인된다.(ko)&#13;
&#13;
</items><items id="text">*Phase V(en)</items></items><items code="at1014"><items id="description">보통 왼쪽으로 기울린, 옆쪽으로 기울여 누운 자세. 보통 임신 3기에 동정맥압력을 완화하기위해 필요함.</items><items id="text">왼쪽으로 누운 자세</items></items><items code="at1018"><items id="description">*영아을 위해 사용되는 cuff - bladder가 약 5cm x 15cm.(ko)</items><items id="text">*영아(ko)</items></items><items code="at1019"><items id="description">*신생아를 위해 사용되는 cuff, cuff는 신생아의 성숙도와 몸무게에 대한 적절한 크기가 가정됨.(ko)</items><items id="text">*신생아(ko)</items></items><items code="at1020"><items id="description">*대상의 우측 손목.(ko)</items><items id="text">*우측 손목(ko)</items></items><items code="at1021"><items id="description">*대상의 좌측 손목.(ko)</items><items id="text">*좌측 손목(ko)</items></items><items code="at1025"><items id="description">*혈압을 측정하는데 사용되는 혈압계 또는 기타 장비에 대한 상세내용.(ko)</items><items id="text">*장비(ko)</items></items><items code="at1026"><items id="description">*대상의 우측 발목.(ko)</items><items id="text">*우측 발목(ko)</items></items><items code="at1030"><items id="description">혈압 측정시에 수행 중인 육체활동에 대한 상세내용.</items><items id="text">노력</items></items><items code="at1031"><items id="description">**대상의 좌측 발목.(ko)</items><items id="text">*좌측 발목(ko)</items></items><items code="at1032"><items id="description">*A finger of the individual.(en)</items><items id="text">*Finger(en)</items></items><items code="at1035"><items id="description">*혈압 측정의 방법.(ko)</items><items id="text">*측정 방법(ko)</items></items><items code="at1036"><items id="description">*청진기와 Korotkoff sounds을 사용하여 외부에서 혈압을 측정하는 방법.(ko)</items><items id="text">*청진(ko)</items></items><items code="at1037"><items id="description">*(보통 상완 또는 요골동맥의) 타진을 사용하여 외부에서 혈압을 측정하는 방법.(ko)</items><items id="text">*타진(ko)</items></items><items code="at1038"><items id="description">*(데이터 내에 기록되어 있다면) MAP를 계산하는데 사용되는 공식.(ko)</items><items id="text">*평균 동맥압 공식(ko)</items></items><items code="at1039"><items id="description">*혈압 측정 장비를 사용하여 외부에서 혈압을 측정하는 방법.(ko)</items><items id="text">*장비(ko)</items></items><items code="at1040"><items id="description">*내부에서 즉 피부를 통과하여 혈관 내에서 혈압을 측정하는 방법.(ko)</items><items id="text">*침습적 방법(ko)</items></items><items code="at1042"><items id="description">24시간 동안의 평균 혈압의 추정.</items><items id="text">24시간 평균</items></items><items code="at1043"><items id="description">수면 상태 - 24시간 활동 혈압기록에 대한 해석 지원.</items><items id="text">수면 상태</items></items><items code="at1044"><items id="description">대상은 완전한 의식이 있다.</items><items id="text">각성과 기상 상태</items></items><items code="at1045"><items id="description">대상은 신체적으로 자연적인 휴식 상태에 있다.</items><items id="text">수면 상태</items></items><items code="at1051"><items id="description">*A toe of the individual.(en)</items><items id="text">*Toe(en)</items></items><items code="at1052"><items id="description">혈압측정에 영향을 줄 수 있는 기타 우연한 변수들에 대한 코멘트와 기록. 예를 들어, 불안 또는 '백의신드롬'의 레벨; 통증 또는 발열; 대기압의 변화 등.</items><items id="text">혼란변수</items></items><items code="at1053"><items id="description">*Invasive measurement via transducer access line within an artery.(en)</items><items id="text">*Intra-arterial(en)</items></items><items code="at1054"><items id="description">*Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Systolic pressure formula(en)</items></items><items code="at1055"><items id="description">*Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Diastolic pressure formula(en)</items></items><items code="at1056"><items id="description">**(en)</items><items id="text">*Dorsum of foot(en)</items></items><items code="at1057"><items id="description">*Structured anatomical location of where the measurement was taken.(en)</items><items id="text">*Structured measurement location(en)</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">**(en)</items><items id="text">*New element(en)</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="comment">Vanligvis brukes begrepet "blodtrykk" om måling av brakialt arterietrykk i overarmen.</items><items id="description">Måling av blodtrykket som uttrykk for det arterielle blodtrykk i det systemiske kretsløp.</items><items id="text">Blodtrykk</items></items><items code="at0001"><items id="description">History Structural node.</items><items id="text">Historikk</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">Maksimalt systemisk arterielt blodtrykk - målt i systolen, det vil si i hjertets kontraksjonsfase.</items><items id="text">Systolisk</items></items><items code="at0005"><items id="description">Laveste systemiske arterielle blodtrykk - målt i diastolen, det vil si under hjertets relaksasjonsfase.</items><items id="text">Diastolisk</items></items><items code="at0006"><items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.</items><items id="text">Uspesifisert hendelse</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">Individets posisjon ved tidspunktet for målingen.</items><items id="text">Stilling</items></items><items code="at0011"><items id="description">Struktur liste</items><items id="text">Tre</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">Størrelse på blodtrykkmansjetten som anvendes til måling av blodtrykket. (Cuffstørrelse)</items><items id="text">Mansjettstørrelse</items></items><items code="at0014"><items id="description">Anatomisk sted hvor blodtrykket måles. Bruk listen over interne koder for valg av vanlige målesteder. Bruk fri eller kodet tekst for registrering av mer spesifikke detaljer eller et målested som ikke inngår i listen over vanlige steder. Henvis eventuelt til ekstern terminologi.</items><items id="text">Målested</items></items><items code="at0015"><items id="description">Mansjett for bruk rundt låret til voksne individer.</items><items id="text">Lår voksne</items></items><items code="at0016"><items id="description">En blodtrykksmansjett for voksne med store armer.</items><items id="text">Store voksne</items></items><items code="at0017"><items id="description">En standard blodtrykksmansjett til voksne.</items><items id="text">Voksne</items></items><items code="at0025"><items id="description">Individets høyre overarm.</items><items id="text">Overarm, høyre</items></items><items code="at0026"><items id="description">Individets venstre overarm.</items><items id="text">Overarm, venstre</items></items><items code="at0027"><items id="description">Individets høyre lår.</items><items id="text">Lår, høyre</items></items><items code="at0028"><items id="description">Individets venstre lår.</items><items id="text">Lår, venstre</items></items><items code="at0033"><items id="description">Ytterligere fritekst om målingen, som ikke omfattes av andre felt.</items><items id="text">Kommentar</items></items><items code="at1000"><items id="description">Stående ved tidspunktet for målingen.</items><items id="text">Stående</items></items><items code="at1001"><items id="description">Sittende (for eksempel på en stol eller på en seng med føttene på gulvet) på tidspunkt for blodtrykksmålingen.</items><items id="text">Sittende</items></items><items code="at1002"><items id="description">Sittende tilbakelent ca 45º og med beina hevet til samme høyde som hoften på tidspunkt for blodtrykksmålingen.</items><items id="text">Tilbakelent</items></items><items code="at1003"><items id="description">Liggende flatt på tidspunkt for blodtrykksmålingen.</items><items id="text">Liggende</items></items><items code="at1005"><items id="comment">Negative verdier betegner posisjoner med hodet ned.</items><items id="description">Kranio-caudal tilt av overflaten som individet ligger på på tidspunkt for blodtrykksmåling.</items><items id="text">Tilt</items></items><items code="at1006"><items id="description">Det gjennomsnittlige trykket mot arterieveggen gjennom en enkelt hjertesyklus. Middeltrykk/MAP måles direkte eller beregnes ut fra systolisk og diastolisk trykk ved hjelp av en matematisk formel.</items><items id="text">Middelarterietrykk</items></items><items code="at1007"><items id="description">Differansen mellom det systoliske og diastoliske arterielle blodtrykket.</items><items id="text">Pulstrykk</items></items><items code="at1008"><items id="description">En blodtrykksmansjett for små voksne.</items><items id="text">Små voksne</items></items><items code="at1009"><items id="description">En blodtrykksmansjett til barn eller små voksne med tynne armer.</items><items id="text">Barn</items></items><items code="at1010"><items id="description">Registrering av hvilken av Korotkofflydene som brukes for å bestemme det diastoliske blodtrykket ved hjelp av auskultasjon.</items><items id="text">Diastolisk endepunkt</items></items><items code="at1011"><items id="description">Den fjerde Korotkoff lyd som identifieres som en brå demping av lydene.</items><items id="text">Fase IV</items></items><items code="at1012"><items id="description">Den femte Korotkoff lyd som identifiseres som fraværet av lyder idet mansjettrykket faller under det diastoliske blodtrykket.</items><items id="text">Fase V</items></items><items code="at1014"><items id="description">Liggende flatt med noe lateral tilt, vanligvis vinklet mot venstre side. Vanligvis nødvendig i siste trimester av svangerskapet for å avlaste aortocaval komprimering.</items><items id="text">Liggende lent mot venstre</items></items><items code="at1018"><items id="description">En blodtrykksmansjett til bruk for spedbarn.</items><items id="text">Spedbarn</items></items><items code="at1019"><items id="description">En blodtrykksmansjett til bruk for neonatale, forutsatt at blodtrykksmansjetten er tilpasset i størrelse for modenhet og fødselsvekt.</items><items id="text">Neonatale</items></items><items code="at1020"><items id="description">Individets høyre håndledd.</items><items id="text">Håndledd, høyre</items></items><items code="at1021"><items id="description">Individets venstre håndledd.</items><items id="text">Håndledd, venstre</items></items><items code="at1025"><items id="description">Detaljer om sfygmomanometeret eller annet måleapparat brukt til blodtrykksmåling.</items><items id="text">Måleapparat</items></items><items code="at1026"><items id="description">Individets høyre ankel.</items><items id="text">Ankel, høyre</items></items><items code="at1030"><items id="description">Detaljer om fysisk aktivitet på tidspunkt for blodtrykksmåling.</items><items id="text">Fysisk anstrengelse</items></items><items code="at1031"><items id="description">Individets venstre ankel.</items><items id="text">Ankel, venstre</items></items><items code="at1032"><items id="description">Individets finger. Dersom identifikasjon av den spesifikke fingeren er nødvendig, kan dette legges inn ved hjelp av feltet med fri eller kodet tekst.</items><items id="text">Finger</items></items><items code="at1035"><items id="description">Metode for måling av blodtrykket.</items><items id="text">Målemetode</items></items><items code="at1036"><items id="description">Metode for måling av blodtrykk eksternt, ved hjelp av stetoskop og Korotkofflyder.</items><items id="text">Auskultasjon</items></items><items code="at1037"><items id="description">Metode for måling av blodtrykket eksternt, ved hjelp av palpasjon (vanligvis av arteriene brachialis eller radialis).</items><items id="text">Palpasjon</items></items><items code="at1038"><items id="description">Eventuell formel som er anvendt til beregning av middeltrykket (MAP).</items><items id="text">Formel for beregning av MAP</items></items><items code="at1039"><items id="description">Metode for non-invasiv måling av blodtrykket ved hjelp av en maskin som automatisk måler blodtrykket, for eksempel et måleapparat eller en blodtrykksmåler for hjemmebruk.</items><items id="text">Automatisk, non-invasivt</items></items><items code="at1040"><items id="description">Metode for måling av blodtrykket invasivt med innleggelse av intravasalkateter i en blodåre.</items><items id="text">Automatisk, invasivt</items></items><items code="at1042"><items id="description">Estimert gjennomsnittsblodtrykk over en 24-timers periode.</items><items id="text">24-timers gjennomsnitt</items></items><items code="at1043"><items id="description">Søvnstatus - understøtter tolkning av 24 timers ambulant blodtrykksmåling.</items><items id="text">Søvnstatus</items></items><items code="at1044"><items id="description">Individet er ved full bevissthet.</items><items id="text">Våken</items></items><items code="at1045"><items id="description">Individet er i den naturlige tilstand av kroppslig hvile.</items><items id="text">Sovende</items></items><items code="at1051"><items id="description">Individets tå. Dersom identifikasjon av den spesifikke tåen er nødvendig, kan dette legges inn ved hjelp av feltet med fri eller kodet tekst.</items><items id="text">Tå</items></items><items code="at1052"><items id="description">Kommentar til og registrering av andre faktorer som kan påvirke blodtrykksmålingen. For eksempel angst eller "hvit frakk syndrom", smerter eller feber, endringer i atmosfærisk trykk osv.</items><items id="text">Konfunderende faktorer</items></items><items code="at1053"><items id="description">Invasiv måling i en artiere via en transducer.</items><items id="text">Intra-arterielt</items></items><items code="at1054"><items id="description">Formelen som anvendes til beregning av systolisk blodtrykk dersom det benyttes en maskin som måler middeltrykket og beregner systolisk og diastolisk trykk.</items><items id="text">Formel for beregning av systolisk trykk</items></items><items code="at1055"><items id="description">Formelen som anvendes til beregning av diastolisk blodtrykk dersom det benyttes en maskin som måler middeltrykket og beregner systolisk og diastolisk trykk.</items><items id="text">Formel for beregning av diastolisk trykk</items></items><items code="at1056"><items id="description">Individets fotrygg.</items><items id="text">Fotrygg</items></items><items code="at1057"><items id="description">Strukturert anatomisk lokalisering av stedet målingen ble gjort.</items><items id="text">Strukturert målested</items></items><items code="at1058"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at1059"><items id="description">Enkeltord, frase eller kort beskrivelse som representerer den kliniske betydningen og signifikansen av blodtrykksmålingen.</items><items id="text">Klinisk tolkning</items></items></term_definitions><term_definitions language="nl"><items code="at0000"><items id="comment">Meest gebruikelijk is dat de term 'bloeddruk' refereert aan de meting van de bloeddruk van de arterie brachialis in de bovenarm.</items><items id="description">De lokale meting van de arteriële bloeddruk, welke surrogaat is voor de arteriële druk in de systemische circulatie.</items><items id="text">Bloeddruk</items></items><items code="at0001"><items id="description">Gestructureerde geschiedenismap.</items><items id="text">Geschiedenis</items></items><items code="at0003"><items id="description">*@ internal @</items><items id="text">*Bloeddruk</items></items><items code="at0004"><items id="description">De hoogste (piek) systemische arteriële bloeddruk - gemeten in de systolische of samentrekkingsfase van de hartslag.</items><items id="text">Systolisch</items></items><items code="at0005"><items id="description">De laagste systemische arteriële bloeddruk - gemeten in de diastolische of ontspanningsfase van de hartslag.</items><items id="text">Diastolisch</items></items><items code="at0006"><items id="description">Standaard, niet-gespecificeerd tijdstip of interval gebeurtenis die expliciet in een template of tijdens uitvoering kan worden gedefinieerd.</items><items id="text">Elke gebeurtenis</items></items><items code="at0007"><items id="description">*@ internal @</items><items id="text">*state structure</items></items><items code="at0008"><items id="description">De houding van het individu op het moment van de meting.</items><items id="text">Houding</items></items><items code="at0011"><items id="description">Lijst structuur.</items><items id="text">Structuur</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">De grootte van de manchet gebruikt bij de meting.</items><items id="text">Manchet grootte</items></items><items code="at0014"><items id="description">Lichaamslocatie waar de bloeddruk is gemeten.</items><items id="text">Lichaamslocatie van de meting</items></items><items code="at0015"><items id="description">Een manchet voor een volwassen dijbeen.</items><items id="text">Volwassen dijbeen</items></items><items code="at0016"><items id="description">Een manchet voor volwassenen met grotere armen.</items><items id="text">Grote volwassene</items></items><items code="at0017"><items id="description">De standaard manchet voor een volwassene.</items><items id="text">Volwassene</items></items><items code="at0025"><items id="description">De rechterarm van de persoon.</items><items id="text">Rechterarm</items></items><items code="at0026"><items id="description">De linkerarm van de persoon.</items><items id="text">Linkerarm</items></items><items code="at0027"><items id="description">Het rechterdijbeen van de persoon.</items><items id="text">Rechterdijbeen</items></items><items code="at0028"><items id="description">De linkerdijbeen van de persoon.</items><items id="text">Linkerdijbeen</items></items><items code="at0033"><items id="description">Aanvullend opmerkingen over de meting, niet vastgelegd in andere velden.</items><items id="text">Opmerking</items></items><items code="at1000"><items id="description">Bloeddrukmeting bij staand individu.</items><items id="text">Staand</items></items><items code="at1001"><items id="description">Bloeddrukmeting bij zittend (b.v. op bed of in stoel) individu.</items><items id="text">Zittend</items></items><items code="at1002"><items id="description">Halfzittend op het moment van de bloeddrukmeting.</items><items id="text">Halfzittend</items></items><items code="at1003"><items id="description">Platliggend op het moment van de bloeddrukmeting.</items><items id="text">Liggend</items></items><items code="at1005"><items id="description">De craniaal-caudale kanteling van het oppervlak waarop het individu ligt op het moment van de meting.</items><items id="text">Kanteling</items></items><items code="at1006"><items id="description">De gemiddelde bloeddruk gedurende één cyclus van samentrekken en ontspannen van het hart.</items><items id="text">Gemiddelde arteriële druk</items></items><items code="at1007"><items id="description">Het verschil tussen de systolische en diastolische bloeddruk.</items><items id="text">Polsdruk</items></items><items code="at1008"><items id="description">Een manchet voor een kleine volwassene.</items><items id="text">Kleine volwassene</items></items><items code="at1009"><items id="description">Een manchet voor een kind of volwassene met een dunne arm.</items><items id="text">Pediatrie/kinder</items></items><items code="at1010"><items id="description">Om te registreren welk Korotkoff geluid gebruikt is om de diastolische druk te meten door de auscultatieve methode.</items><items id="text">Diastolisch eindpunt</items></items><items code="at1011"><items id="description">Het vierde Korotkoff geluid wordt gedefinieerd als een abrupte vermindering van geluid.</items><items id="text">Fase IV</items></items><items code="at1012"><items id="description">Het vijfde Korotkoff geluid is geïdentificeerd door afwezigheid van geluiden als de manchetdruk onder diastolische bloeddruk komt.</items><items id="text">Fase V</items></items><items code="at1014"><items id="description">Platliggend met enige laterale kanteling, meestal gekanteld naar de linkerzijde. Gebruikelijk benodigd in het laatste trimester van de zwangerschap om aortacavale compressie te verlichten.</items><items id="text">Liggend met kanteling naar linkerzijde</items></items><items code="at1018"><items id="description">Een manchet voor zuigelingen.</items><items id="text">Zuigeling</items></items><items code="at1019"><items id="description">Een manchet voor een neonaat, er van uitgaande dat de manchet de juiste maat is voor volgroeidheid en geboortegewicht van de neonaat.</items><items id="text">Neonaat</items></items><items code="at1020"><items id="description">De rechterpols van de persoon</items><items id="text">Rechterpols</items></items><items code="at1021"><items id="description">De linkerpols van de persoon.</items><items id="text">Linkerpols</items></items><items code="at1025"><items id="description">Details over sphygmomanometerof ander apparaat om de bloeddruk te meten.</items><items id="text">Apparaat</items></items><items code="at1026"><items id="description">De rechterenkel van de persoon</items><items id="text">Rechterenkel</items></items><items code="at1030"><items id="description">Details over de lichamelijke inspanning die ondernomen wordt op het moment van de bloeddrukmeting.</items><items id="text">Inspanning</items></items><items code="at1031"><items id="description">De linkerenkel van de persoon.</items><items id="text">Linkerenkel</items></items><items code="at1032"><items id="description">Een vinger van de persoon.</items><items id="text">Vinger</items></items><items code="at1035"><items id="description">De methode van de meting van de bloeddruk.</items><items id="text">Methodiek</items></items><items code="at1036"><items id="description">Uitwendige meting van de bloeddruk, met gebruikmaking van een stethoscoop en Korotkoff geluiden.</items><items id="text">Auscultatie</items></items><items code="at1037"><items id="description">Uitwendige meting van de bloeddruk, met gebruikmaking van palpatie (meestal de arterie brachialis of radialis).</items><items id="text">Palpatie</items></items><items code="at1038"><items id="description">Formule om de MAP (mean arterial pressure=gemiddelde arteriële druk) te berekenen (als deze data opgeslagen wordt).</items><items id="text">Gemiddelde arteriële druk formule</items></items><items code="at1039"><items id="description">Uitwendige meting van de bloeddruk, met gebruikmaking van een mechanische bloeddrukmeter.</items><items id="text">Machinaal</items></items><items code="at1040"><items id="description">Inwendige meting van de bloeddruk, inclusief penetratie van de huid en meting in het bloedvat.</items><items id="text">Invasief</items></items><items code="at1042"><items id="description">Inschatting van de gemiddelde bloeddruk over een periode van 24 uur.</items><items id="text">24 uur gemiddelde</items></items><items code="at1043"><items id="description">Slaap/waak toestand, ondersteunt de interpretatie van de 24-uurs bloeddrukmeting.</items><items id="text">Slaap/waak toestand</items></items><items code="at1044"><items id="description">Individu is volledig bij bewustzijn.</items><items id="text">Alert en wakker</items></items><items code="at1045"><items id="description">Individu is in de natuurlijke slaap.</items><items id="text">Slapend</items></items><items code="at1051"><items id="description">Een teen van de persoon.</items><items id="text">Teen</items></items><items code="at1052"><items id="description">Opmerking over en vastleggen van andere incidentele factoren die de bloeddrukmeting zouden kunnen beïnvloeden. Bijvoorbeeld, mate van angst, of 'witte jas syndroom'; pijn of koorts; veranderingen in atmosferische druk etc.</items><items id="text">Beïnvloedende factoren</items></items><items code="at1053"><items id="description">Invasieve meting via een druktransducer in de arterielijn.</items><items id="text">Intra-arterieel</items></items><items code="at1054"><items id="description">Formule om de systolische druk van de MAP (mean arterial pressure=gemiddelde arteriële druk) te berekenen (als deze data opgeslagen wordt).</items><items id="text">Systolische druk formule</items></items><items code="at1055"><items id="description">Formule om de diastolische druk van de MAP (mean arterial pressure=gemiddelde arteriële druk) te berekenen (als deze data opgeslagen wordt).</items><items id="text">Diastolische druk formule</items></items><items code="at1056"><items id="description">De voetzool van de persoon.</items><items id="text">Voetzool</items></items><items code="at1057"><items id="description">Gestructureerde anatomische locatie waar de bloeddruk is gemeten.</items><items id="text">Gestructureerde lichaamslocatie van de meting</items></items><items code="at1058"><items id="comment">Bijvoorbeeld: lokale ziekenhuis of zorginstelling afdelingsinformatie of aanvullende metadata om uit te lijnen met FHIR- of CIMI-equivalenten.</items><items id="description">Aanvullende informatie die vereist is om de lokale context vast te leggen of uit te lijnen met andere referentiemodellen/formalismen.</items><items id="text">Extensie</items></items><items code="at1059"><items id="description">Eén woord, zin of korte beschrijving die de klinische betekenis van de bloeddrukmeting weergeeft.</items><items id="text">Klinische interpretatie</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="comment">*Most commonly, use of the term 'blood pressure' refers to measurement of brachial artery pressure in the upper arm.(en)</items><items id="description">A medida local da pressão sanguínea arterial, a qual é uma substituta da pressão arterial na circulação arterial sistêmica. Mais comumente o uso do termo pressão arterial se refere à medida da pressão da artéria braquial no antebraço.</items><items id="text">Pressão Arterial</items></items><items code="at0001"><items id="description">nodo Estrutural história</items><items id="text">história</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">Pressão arterial sistêmica máxima - medida na fase sistólica ou de contração do ciclo cardíaco.</items><items id="text">Sistólica</items></items><items code="at0005"><items id="description">Pressão arterial sistêmica mínima - medida na fase diastólica ou de dilatação do ciclo cardíaco.</items><items id="text">Diastólica</items></items><items code="at0006"><items id="description">Padrão, ponto especificado no tempo ou evento de intervalo que pode ser explicitamente definido em um modelo ou em tempo de execução.</items><items id="text">Qualquer evento</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">A posição do sujeito na hora da medida.</items><items id="text">Posição</items></items><items code="at0011"><items id="description">estrutura de lista</items><items id="text">estrutura de lista</items></items><items code="at0013"><items id="comment">Sem comentários</items><items id="description">Tamanho da braçadeira usada para medir a pressão arterial.</items><items id="text">Tamanho da braçadeira</items></items><items code="at0014"><items id="description">Local do corpo simples em que a pressão arterial foi medida.</items><items id="text">Localização da medição</items></items><items code="at0015"><items id="description">Uma braçadeira usada na coxa de um aduto - manguito de aproximadamente 20cm x 42cm.</items><items id="text">Coxa de adulto</items></items><items code="at0016"><items id="description">Uma braçadeira para adultos com braço largo - manguito de aproximadamente 16cm x 38cm.</items><items id="text">Adulto Grande</items></items><items code="at0017"><items id="description">Uma braçadeira padrão para adultos - manguito de aproximadamente 13cm x 30cm.</items><items id="text">Adulto</items></items><items code="at0025"><items id="description">O braço direito da pessoa.</items><items id="text">Braço direito</items></items><items code="at0026"><items id="description">O braço esquerdo da pessoa.</items><items id="text">Braço esquerdo</items></items><items code="at0027"><items id="description">A coxa direita da pessoa.</items><items id="text">Coxa direita</items></items><items code="at0028"><items id="description">A coxa esquerda da pessoa.</items><items id="text">Coxa esquerda</items></items><items code="at0033"><items id="description">Narrativa adicional sobre a medição, não capturada em outros campos.</items><items id="text">Comentário</items></items><items code="at1000"><items id="description">Em pé na hora da medida da pressão arterial.</items><items id="text">Em pé</items></items><items code="at1001"><items id="description">Sentado (por exemplo na cama ou em uma cadeira) na hora da medida da pressão arterial.</items><items id="text">Sentado</items></items><items code="at1002"><items id="description">Reclinado na hora da medida da pressão arterial.</items><items id="text">Reclinado</items></items><items code="at1003"><items id="description">Deitado sem reclinação hora da medida da pressão arterial.</items><items id="text">Deitado</items></items><items code="at1005"><items id="comment">* ATENÇÃO: '°' é uma unidade UCUM válida. Por favor, use 'graus' como a unidade correta.</items><items id="description">A inclinação craniocaudal da superfície na qual a pessoa está deitada no momento da medição.</items><items id="text">Inclinado</items></items><items code="at1006"><items id="description">A pressão arterial média que ocorrre ao longo de todo o ciclo de contração e dilatação do coração.</items><items id="text">Pressão arterial Média</items></items><items code="at1007"><items id="description">A diferença entre a pressão sistólica e diastólica.</items><items id="text">Pressão de Pulso</items></items><items code="at1008"><items id="description">Uma braçadeira usada para adultos pequenos -manguito de aproximadamente 10cm x 24cm.</items><items id="text">Adulto pequeno</items></items><items code="at1009"><items id="description">Manguito apropriao para uma criança ou um adulto com um braço fino - bolsa de aproximadamente 8cm x 21cm.</items><items id="text">Criança/Pediátrico</items></items><items code="at1010"><items id="description">Registro do som Korotkoff usado para determinar a pressão arterial diastólica, usando o método auscultativo.</items><items id="text">Final da diástole</items></items><items code="at1011"><items id="description">O quarto som de Korotkoff é identificado como um súbito abafamento dos sons.</items><items id="text">Fhase IV.</items></items><items code="at1012"><items id="description">O quinto som de Korotkoff é identificado pela ausência de sons, pois a pressão da braçadeira cai abaixo da pressão diastólica do sangue.</items><items id="text">Phase V</items></items><items code="at1014"><items id="description">Deitado sem reclinação com alguma inclinação lateral, usualmente com angulação para o lado esquerdo. Comumente requerido no último trimestre da gravidez para aliviar a compressão aortocaval.</items><items id="text">Deitado com inclinação para esquerda</items></items><items code="at1018"><items id="description">Uma braçadeira utilizada em crianças pequenas - manguito de aproximadamente 5cm x 15cm.</items><items id="text">Criança pequena</items></items><items code="at1019"><items id="description">Uma braçadeira usada para um recém-nascido, supondo que o tamanho é apropriado para a maturidade e o peso ao nascer do neonato.</items><items id="text">Neonatal</items></items><items code="at1020"><items id="description">O pulso direito da pessoa.</items><items id="text">Pulso direito</items></items><items code="at1021"><items id="description">O pulso esquerdo da pessoa.</items><items id="text">Pulso esquerdo</items></items><items code="at1025"><items id="description">Detalhes sobre o esfigmomanômetro ou outro aparelho utilizado para medir a pressão sanguínea.</items><items id="text">Aparelho</items></items><items code="at1026"><items id="description">O tornozelo direito da pessoa.</items><items id="text">Tornozelo direito</items></items><items code="at1030"><items id="description">Detalhes sobre atividade física realizada na hora da medida da pressão arterial.</items><items id="text">Esforço físico</items></items><items code="at1031"><items id="description">O tornozelo esquerdo da pessoa.</items><items id="text">Tornozelo esquerdo</items></items><items code="at1032"><items id="description">Um dedo do indivíduo.</items><items id="text">Dedo</items></items><items code="at1035"><items id="description">Método de medida da pressão arterial.</items><items id="text">Método</items></items><items code="at1036"><items id="description">Método de medir a pressão externamente, usando o estetoscópiso e os sons Korotkoff.</items><items id="text">Ausculta</items></items><items code="at1037"><items id="description">Método de medir a pressão arterial externamente, usando a palpação (geralmente artérias braquiais ou radiais).</items><items id="text">Palpação</items></items><items code="at1038"><items id="description">Fórmula usada para calcular a pressão arterial média (PAM), se registrada em dados.</items><items id="text">Fórmula de Pressão Arterial Média</items></items><items code="at1039"><items id="description">Método de medir a pressão arterial externamente, usando o aparelho de pressão arterial.</items><items id="text">Aparelho de pressão</items></items><items code="at1040"><items id="description">Método de medir a pressão arterial internamente, isto é, envolvendo a penetração da pele e a medida interior dos vasos sanguíneos.</items><items id="text">Invasivo</items></items><items code="at1042"><items id="description">Estimativa da pressão arterial média em um período de 24 horas.</items><items id="text">Media de 24 horas</items></items><items code="at1043"><items id="description">Status do sono - apóia a interpretação do registro do mapa de pressão arterial (ambulatorial de 24 horas).</items><items id="text">Status do sono</items></items><items code="at1044"><items id="description">Sujeito está totalmente consciente.</items><items id="text">Alerta e acordado</items></items><items code="at1045"><items id="description">Sujeito está no estado natural de descanso corporal.</items><items id="text">Dormindo</items></items><items code="at1051"><items id="description">Um dedo do pé do indivíduo.</items><items id="text">Dedo do pé</items></items><items code="at1052"><items id="description">Comentários sobre e registros de outros fatores incidentais que possam estar contribuindo na medida da pressão sanguínea. Por exemplo, nível de ansiedade ou "síndrome do jaleco branco"; dor ou febre; mudanças na pressão atmosférica, etc.</items><items id="text">Fatores confundidores</items></items><items code="at1053"><items id="description">Medição invasiva via linha de acesso do transdutor dentro de uma artéria.</items><items id="text">Intra-arterial</items></items><items code="at1054"><items id="description">Fórmula utilizada para calcular a pressão sistólica a partir da pressão arterial média (se registrada nos dados).</items><items id="text">Fórmula de pressão sistólica</items></items><items code="at1055"><items id="description">Fórmula utilizada para calcular a pressão diastólica da pressão arterial média (se registrada nos dados).</items><items id="text">Fórmula da pressão diastólica</items></items><items code="at1056"><items id="description">O dorso do pé do indivíduo.</items><items id="text">Dorso do pé</items></items><items code="at1057"><items id="description">Localização anatômica estruturada de onde a medição foi feita.</items><items id="text">Localização de medição estruturada</items></items><items code="at1058"><items id="comment">Por exemplo: Informações locais de departamentos de hospitais ou metadados adicionais para alinhar a equivalentes FHIR ou CIMI</items><items id="description">Informações adicionais necessárias para capturar o contexto local ou para alinhar com outros modelos / formalismos de referência.</items><items id="text">Extensão</items></items><items code="at1059"><items id="description">Palavra única, frase ou breve descrição que representa o significado clínico e o significado da medida da pressão arterial.</items><items id="text">Interpretação clínica</items></items></term_definitions><term_definitions language="ru"><items code="at0000"><items id="comment">*Most commonly, use of the term 'blood pressure' refers to measurement of brachial artery pressure in the upper arm.(en)</items><items id="description">Локальное измерение артериального давления, которое является суррогатом артериального давления в системном кровотоке. Как правило, термин относится к давления плечевой артерии на предплечье.&#13;
</items><items id="text">АД</items></items><items code="at0001"><items id="description">*History Structural node.(en)</items><items id="text">*History(en)</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*blood pressure(en)</items></items><items code="at0004"><items id="description">Пик системного артериального давления - измеряется в систолиу или в фазу сокращения сердца</items><items id="text">Систолическое</items></items><items code="at0005"><items id="description">Минимальное системное артериальное давление - измеряется в диастолу или в фазу релаксации сердца.</items><items id="text">Диастолическое</items></items><items code="at0006"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">Поза пациента во время измерения давления.</items><items id="text">Поза</items></items><items code="at0011"><items id="description">*List structure.(en)</items><items id="text">*Tree(en)</items></items><items code="at0013"><items id="comment">*Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470. (en)</items><items id="description">Размер манжеты для измерения кровяного давления.</items><items id="text">Размер манжеты(ru)</items></items><items code="at0014"><items id="description">*Simple body site where blood pressure was measured.(en)</items><items id="text">*Location of measurement(en)</items></items><items code="at0015"><items id="description">Манжеты для бедра  взрослого- пузырь приблизительно 20см х 42см.</items><items id="text">Взрослая для бедра</items></items><items code="at0016"><items id="description">Манжета для руки взрослого, увеличенного объёма -  пузырь приблизительно 16cm x 38cm.</items><items id="text">Взрослая большая</items></items><items code="at0017"><items id="description">Манжета стандартная для взрослого - пузырь приблизительно 13 х 30cm.</items><items id="text">Взрослая</items></items><items code="at0025"><items id="description">Правая рука пациента.</items><items id="text">Правая рука</items></items><items code="at0026"><items id="description">Левая рука пациента.</items><items id="text">Левая рука</items></items><items code="at0027"><items id="description">Правое бедро пациента.</items><items id="text">Правое бедро</items></items><items code="at0028"><items id="description">Левое бедро пациента.</items><items id="text">Левое бедро</items></items><items code="at0033"><items id="description">*Additional narrative about the measurement, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at1000"><items id="description">Пациент стоит во время измерения АД.</items><items id="text">Стоя</items></items><items code="at1001"><items id="description">Пациент сидит во время измерения АД (на стуле, кровати или кресле).</items><items id="text">Сидя</items></items><items code="at1002"><items id="description">Пациент лежит в вынужденной неизменной позе (на реклинации)во время измерения АД.</items><items id="text">Реклинация</items></items><items code="at1003"><items id="description">Пациент лежит во время измерения АД.</items><items id="text">Лёжа</items></items><items code="at1005"><items id="comment">*PLEASE NOTE: '°' is a valid UCUM unit. Please use 'deg' as the correct unit.(en)</items><items id="description">*The craniocaudal tilt of the surface on which the person is lying at the time of measurement.(en)</items><items id="text">*Tilt(en)</items></items><items code="at1006"><items id="description">Среднее артериальное давление на всём протяжении цикла сокращения и релаксации сердца.</items><items id="text">Среднего артериального давления крови</items></items><items code="at1007"><items id="description">Разница между систолическим и диастолическим давлением.</items><items id="text">Пульсовое давление</items></items><items code="at1008"><items id="description">Манжета взрослая малая - пузырь приблизительно 10 x 24cm.</items><items id="text">Взрослая малая</items></items><items code="at1009"><items id="description">Манжета для детей или взрослых с тонкой рукой - пузырь примерно 8см x 21cm.</items><items id="text">Педиатрическая(детская)</items></items><items code="at1010"><items id="description">Запись звука Короткова который используют для определения диастолического давления с помощью метода аускультации.</items><items id="text">Диастолическая конечная точка</items></items><items code="at1011"><items id="description">Четвёртый звук Короткова, определяющийся как резкое приглушение звуков.</items><items id="text">Фаза 4</items></items><items code="at1012"><items id="description">Пятый звук Короткова определяется отсутствием звуков, так как давление в манжете падает ниже диастолического артериального давления.</items><items id="text">Фаза 5</items></items><items code="at1014"><items id="description">Лёжа на плоской поверхности с боковым наклоном, как правило, под углом по направлению с левой стороны. Обычно требуется в последнем триместре беременности, чтобы облегчить сдавление нижней полой вены.</items><items id="text">Лёжа с наклоном влево</items></items><items code="at1018"><items id="description">Манжета для младенцев - пузырь приблизительно 5см x 15cm.</items><items id="text">Для младенцев</items></items><items code="at1019"><items id="description">Манжета для новорожденных, используется в соответствии с весом новорожденного.</items><items id="text">Для новорожденных</items></items><items code="at1020"><items id="description">Правое запястье пациента.</items><items id="text">Правое запястье</items></items><items code="at1021"><items id="description">Левое запястье пациента.</items><items id="text">Левое запястье</items></items><items code="at1025"><items id="description">Информация о сфигмоманометре или другом устройстве, используемом для измерения АД.</items><items id="text">Устройство</items></items><items code="at1026"><items id="description">Правая лодыжка пациента.</items><items id="text">Правая лодыжка</items></items><items code="at1030"><items id="description">Подробная информация о физической деятельности, осуществляемой во время измерения АД.</items><items id="text">Нагрузка</items></items><items code="at1031"><items id="description">Левая лодыжка пациента</items><items id="text">Левая лодыжка</items></items><items code="at1032"><items id="description">*A finger of the individual.(en)</items><items id="text">*Finger(en)</items></items><items code="at1035"><items id="description">Метод измерения кровяного давления.</items><items id="text">Метод</items></items><items code="at1036"><items id="description">Неинвазивный метод измерения АД с использованием стетоскопа и звуков Короткова.</items><items id="text">Аускультация</items></items><items code="at1037"><items id="description">Неинвазивный метод измерения АД с использованием пальпации (обычно плечевой или лучевой артерии).</items><items id="text">Пальпация</items></items><items code="at1038"><items id="description">Формула, используемая для вычисления СрАД (если требуется записывать).</items><items id="text">Формула среднего артериального давления</items></items><items code="at1039"><items id="description">Неинвазивный метод измерения АД с помощью автоматического тонометра.</items><items id="text">Автоматический тонометр</items></items><items code="at1040"><items id="description">Инвазивный метод измерения АД, с помещением датчика внутри кровеносного сосуда.</items><items id="text">Инвазивный</items></items><items code="at1042"><items id="description">Оценка среднего АД за период в 24 часа.</items><items id="text">Среднее за 24 часа</items></items><items code="at1043"><items id="description">Стадия сна - для интерпретации записи амбулаторного измерения АД в течение 42 часов.</items><items id="text">Стадия сна(ru)</items></items><items code="at1044"><items id="description">Пациент полностью в сознании.</items><items id="text">Пробуждение и подъём</items></items><items code="at1045"><items id="description">Пациент находится в состоянии естественного покоя, тело расслаблено.</items><items id="text">Сон</items></items><items code="at1051"><items id="description">*A toe of the individual.(en)</items><items id="text">*Toe(en)</items></items><items code="at1052"><items id="description">Комментарий и записи других случайных факторов, которые могут способствовать измерению артериального давления. Например,"боязнь белого халата" или боль и жар, изменения атмосферного давления т.д.</items><items id="text">Стохастические факторы(ru)</items></items><items code="at1053"><items id="description">*Invasive measurement via transducer access line within an artery.(en)</items><items id="text">*Intra-arterial(en)</items></items><items code="at1054"><items id="description">*Formula used to calculate the systolic pressure from from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Systolic pressure formula(en)</items></items><items code="at1055"><items id="description">*Formula used to calculate the diastolic pressure from mean arterial pressure (if recorded in data).(en)</items><items id="text">*Diastolic pressure formula(en)</items></items><items code="at1056"><items id="description">*The individual's dorsum of the foot.(en)</items><items id="text">*Dorsum of foot(en)</items></items><items code="at1057"><items id="description">*Structured anatomical location of where the measurement was taken.(en)</items><items id="text">*Structured measurement location(en)</items></items><items code="at1058"><items id="comment">*For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local context or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at1059"><items id="description">*Single word, phrase or brief description that represents the clinical meaning and significance of the blood pressure measurement.(en)</items><items id="text">*Clinical interpretation(en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="comment">Vanligtvis refererar användningen av termen blodtryck till mätningen av brakialartärtrycket i överarmen.</items><items id="description">Den lokala mätningen av artärblodtrycket som är ett substitut för artärtryck i den systemiska cirkulationen.</items><items id="text">Blodtryck</items></items><items code="at0001"><items id="description">Strukturerad anamnes.</items><items id="text">Anamnes</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">Det högsta värdet på systemartärtrycket under systole, det vill säga under sammandragningsfasen av hjärtcykeln.</items><items id="text">Systoliskt</items></items><items code="at0005"><items id="description">Det minsta värdet på systemartärtrycket under diastole, det vill säga under avslappningsfasen av hjärtcykeln.</items><items id="text">Diastoliskt</items></items><items code="at0006"><items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en template eller genereras automatiskt av vissa IT-system.</items><items id="text">Ospecificerad händelse</items></items><items code="at0007"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0008"><items id="description">Individens kroppsställning under mätningen.</items><items id="text">Ställning</items></items><items code="at0011"><items id="description">Liststruktur</items><items id="text">Träd</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">Storleken på manschetten som används för blodtrycksmätning.</items><items id="text">Manschettstorlek</items></items><items code="at0014"><items id="description">Beskrivning av anatomiskt ställe där blodtrycket mäts.</items><items id="text">Mätställe</items></items><items code="at0015"><items id="description">En lårmanschett för vuxna.</items><items id="text">Vuxet lår</items></items><items code="at0016"><items id="description">En manschett för vuxna med kraftigare armar.</items><items id="text">Stor vuxen</items></items><items code="at0017"><items id="description">En standardmanschett för vuxna.</items><items id="text">Vuxen</items></items><items code="at0025"><items id="description">Individens högra arm.</items><items id="text">Höger arm</items></items><items code="at0026"><items id="description">Individens vänstra arm.</items><items id="text">Vänster arm</items></items><items code="at0027"><items id="description">Individens högra lår.</items><items id="text">Höger lår</items></items><items code="at0028"><items id="description">Individens vänstra lår.</items><items id="text">Vänster lår</items></items><items code="at0033"><items id="description">Ytterligare beskrivning av mätningen som inte beskrivits i andra fält.</items><items id="text">Kommentar</items></items><items code="at1000"><items id="description">Stående upprätt under blodtrycksmätningen.</items><items id="text">Stående</items></items><items code="at1001"><items id="description">Sittande ställning under blodtrycksmätningen, exempelvis på en säng eller stol.</items><items id="text">Sittande</items></items><items code="at1002"><items id="description">Halvliggande ställning under blodtrycksmätningen.</items><items id="text">Halvliggande</items></items><items code="at1003"><items id="description">Liggande raklång under blodtrycksmätningen.</items><items id="text">Liggande</items></items><items code="at1005"><items id="description">Lutning vid huvudet på ytan som individen ligger på vid tidpunkten för mätningen.</items><items id="text">Lutning</items></items><items code="at1006"><items id="description">Det genomsnittliga systemartärtrycket under hela hjärtcykeln, det vill säga under både sammandragningsfas och avslappningsfas.</items><items id="text">Medelartärtryck</items></items><items code="at1007"><items id="description">Differensen mellan systoliskt och diastoliskt blodtryck.</items><items id="text">Pulstryck</items></items><items code="at1008"><items id="description">En manschett för vuxna med smalare armar.</items><items id="text">Liten Vuxen</items></items><items code="at1009"><items id="description">En manschett för barn eller vuxna med smala armar.</items><items id="text">Pediatrisk/Barn</items></items><items code="at1010"><items id="description">Registrerat Korotkoff-ljud som används för att avgöra diastoliskt tryck med hjälp av auskultatorisk metod.</items><items id="text">Diastoliskt effektmått</items></items><items code="at1011"><items id="description">Det fjärde Korotkoff-ljudet identifieras som en plötslig ljuddämpning.</items><items id="text">Fas IV</items></items><items code="at1012"><items id="description">Det femte Korotkoff-ljudet identifieras genom avsaknad av ljud då manschettrycket sjunker under det diastoliska blodtrycket.</items><items id="text">Fas V</items></items><items code="at1014"><items id="description">Liggande raklång med viss lateral lutning, vanligtvis mot vänster sida. Det krävs vanligtvis i graviditetens sista trimester för att lindra aortokaval kompression.</items><items id="text">Liggande i vänster sidoläge</items></items><items code="at1018"><items id="description">En manschett för spädbarn.</items><items id="text">Spädbarn</items></items><items code="at1019"><items id="description">En manschett för nyfödda.</items><items id="text">Nyfödd</items></items><items code="at1020"><items id="description">Individens högra handled.</items><items id="text">Höger handled</items></items><items code="at1021"><items id="description">Individens vänstra handled.</items><items id="text">Vänster handled</items></items><items code="at1025"><items id="description">Detaljer om sfygmomanometer eller annan utrustning som används för att mäta blodtrycket.</items><items id="text">Utrustning</items></items><items code="at1026"><items id="description">Individens högra ankel.</items><items id="text">Höger ankel</items></items><items code="at1030"><items id="description">Detaljer om den fysiska aktiviteten som utförts vid tidpunkten av blodtrycksmätningen.</items><items id="text">Ansträngning</items></items><items code="at1031"><items id="description">Individens vänstra ankel.</items><items id="text">Vänster ankel</items></items><items code="at1032"><items id="description">Individens finger.</items><items id="text">Finger</items></items><items code="at1035"><items id="description">Metod för mätning av blodtryck.</items><items id="text">Metod</items></items><items code="at1036"><items id="description">Metod för icke-invasiv mätning av blodtryck med hjälp av sfygmomanometri, såsom manschett, stetoskop, Korotkoff-ljud.</items><items id="text">Auskultation</items></items><items code="at1037"><items id="description">Metod för att mäta det systoliska blodtrycket med hjälp av palpation, vanligtvis av brakiala eller radiella artärer.</items><items id="text">Palpation</items></items><items code="at1038"><items id="description">Formel som används för att beräkna medelartärtrycket (om det finns registrerat).</items><items id="text">Formel för medelartärtryck</items></items><items code="at1039"><items id="description">Icke-invasiv blodtrycksmätning med hjälp av oscillometri i en halvautomatisk blodtrycksmätare.</items><items id="text">Blodtrycksmaskin</items></items><items code="at1040"><items id="description">Metod för att mäta blodtrycket intravenöst, dvs. genom att penetrera huden och mäta inuti blodkärlen.</items><items id="text">Invasiv</items></items><items code="at1042"><items id="description">Beräkning av det genomsnittliga blodtrycket under en 24-timmarsperiod.</items><items id="text">24 timmars blodtrycksmätning</items></items><items code="at1043"><items id="description">Sömnstatus som stöder tolkningen av 24-timmars ambulatoriska blodtrycksmätningar.</items><items id="text">Sömnstatus</items></items><items code="at1044"><items id="description">Patienten är vid fullt medvetande.</items><items id="text">Alert och vaken</items></items><items code="at1045"><items id="description">Patienten är i det naturliga tillståndet av kroppslig vila.</items><items id="text">Sover</items></items><items code="at1051"><items id="description">Individens tå.</items><items id="text">Tå</items></items><items code="at1052"><items id="description">Andra faktorer som kan påverka blodtrycksmätningen, exempelvis grad av oro, "vitrockseffekt", smärta, feber eller förändringar i lufttryck.</items><items id="text">Möjliga felkällor</items></items><items code="at1053"><items id="description">Invasiv mätning via artärkateter.</items><items id="text">Intraarteriell</items></items><items code="at1054"><items id="description">Formel som används för att beräkna det systoliska trycket från medelartärtrycket (om det finns registrerat).</items><items id="text">Formel för systoliskt tryck</items></items><items code="at1055"><items id="description">Formel som används för att beräkna det diastoliska trycket från medelartärtrycket (om det finns registrerat).</items><items id="text">Formel för diastoliskt tryck</items></items><items code="at1056"><items id="description">Individens fotrygg.</items><items id="text">Fotryggen</items></items><items code="at1057"><items id="description">Strukturerat anatomiskt ställe där mätningen gjordes.</items><items id="text">Strukturerat mätställe</items></items><items code="at1058"><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items><items id="description">Plats för tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="text">Tilläggsinformation</items></items><items code="at1059"><items id="description">Ord, fras eller kort beskrivning som representerar den kliniska betydelsen och signifikansen av blodtrycksmätningen.</items><items id="text">Klinisk tolkning</items></items></term_definitions><term_definitions language="zh-cn"><items code="at0000"><items id="comment">最为常见的情况下是，利用术语“血压”来指称上臂肱动脉压的测量结果。</items><items id="description">代表体循环动脉压的动脉血压的局部测量。</items><items id="text">血压</items></items><items code="at0001"><items id="description">历史结构节点</items><items id="text">历史</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">血压</items></items><items code="at0004"><items id="description">在心动周期的收缩期所测量到的体循环动脉血压峰值。</items><items id="text">收缩压</items></items><items code="at0005"><items id="description">在心动周期的舒张期所测量到的体循环动脉血压最低值（谷值，最小值）。</items><items id="text">舒张压</items></items><items code="at0006"><items id="description">默认，在某一模板之中或在运行时所可能明确定义的未加详细说明的时间点或时段事件。</items><items id="text">任何事件</items></items><items code="at0007"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0008"><items id="description">测量时受检对象的体位或者说身体姿势。</items><items id="text">体位</items></items><items code="at0011"><items id="description">列表结构</items><items id="text">树状结构</items></items><items code="at0013"><items id="comment">Perloff D, Grim C, Flack J, Frohlich ED, Hill M, McDonald M, Morgenstern BZ. Human blood pressure determination by sphygmomanometry. Circulation 1993;88;2460-2470.</items><items id="description">用于血压测量的袖带（臂带，袖套，臂围）的大小或者说尺寸。</items><items id="text">袖带尺寸</items></items><items code="at0014"><items id="description">测量血压时所采用的简单身体部位。</items><items id="text">测量位置</items></items><items code="at0015"><items id="description">适用于成年人大腿的袖带（臂带，袖套，臂围） - 气囊尺寸约为 20cm x 42cm。</items><items id="text">成年人大腿型</items></items><items code="at0016"><items id="description">适用于上肢较为粗大的成年人的袖带（臂带，袖套，臂围） - 气囊尺寸约为16cm x 38cm。</items><items id="text">成年人粗大型</items></items><items code="at0017"><items id="description">适用于成年人的标准袖带（臂带，袖套，臂围） - 气囊尺寸约为13cm x 30cm。</items><items id="text">成年人标准型</items></items><items code="at0025"><items id="description">受检对象的右臂。</items><items id="text">右臂</items></items><items code="at0026"><items id="description">受检对象的左臂。</items><items id="text">左臂</items></items><items code="at0027"><items id="description">受检对象的右腿。</items><items id="text">右腿</items></items><items code="at0028"><items id="description">受检对象的左腿。</items><items id="text">左腿</items></items><items code="at0033"><items id="description">其他字段并未予以记录的，关于当前检测过程的附加文字叙述。</items><items id="text">注释</items></items><items code="at1000"><items id="description">测量血压时身体处于站立体位</items><items id="text">立位</items></items><items code="at1001"><items id="description">测量血压时身体处于坐位，又称为“坐姿”。</items><items id="text">坐位</items></items><items code="at1002"><items id="description">测量血压时身体处于45度角侧卧位或者说采取的是斜靠的姿势。</items><items id="text">侧卧位</items></items><items code="at1003"><items id="description">测量血压时受检者采取的是平躺或者说平卧的姿势，又称为“仰卧位”。</items><items id="text">平卧位</items></items><items code="at1005"><items id="comment">请注意：“°”属于无效的UCUM单位。请采用正确的单位“deg”（度）。</items><items id="description">测量时该人员所卧于的表面的颅尾（头尾）倾角（倾斜角度）。</items><items id="text">倾角</items></items><items code="at1006"><items id="description">又称为“平均动脉血压”，指的是在整个心脏收缩与舒张周期过程中出现的动脉压均值（平均动脉压）。</items><items id="text">平均动脉压</items></items><items code="at1007"><items id="description">收缩压与舒张压之间的差值，又称为“脉压差”或“脉搏压”。</items><items id="text">脉压</items></items><items code="at1008"><items id="description">适用于体型瘦小的成年人的袖带（臂带，袖套，臂围） - 气囊尺寸约为10cm x 24cm。</items><items id="text">成年人细小型</items></items><items code="at1009"><items id="description">适用于儿童或上肢较瘦成年人的袖带（臂带，袖套，臂围） - 气囊尺寸约为8cm x 21cm。</items><items id="text">儿科型/儿童型</items></items><items code="at1010"><items id="description">旨在记录当确定舒张压时所采用的究竟是哪种柯氏音。</items><items id="text">舒张期终点</items></items><items code="at1011"><items id="description">将声音的突然减弱（消音，捂住，低沉）或者说其向捂音的突然转变确定为第IV柯氏音，即柯氏音的第IV时相（变音）。</items><items id="text">第IV时相</items></items><items code="at1012"><items id="description">将声音随着袖带压力降至舒张压以下时声音的消失确定为第V柯氏音，即柯氏音的第V时相。</items><items id="text">第V时相</items></items><items code="at1014"><items id="description">测量血压时受检者采取的是平躺或者说平卧姿势，且有向侧位一定程度的倾斜，通常是斜向左侧。在妊娠晚期，为了缓解主腔静脉压迫（aortocaval compression），常常需要采取这种体位。</items><items id="text">左斜卧位</items></items><items code="at1018"><items id="description">适用于婴幼儿的袖带（臂带，袖套，臂围） - 气囊尺寸约为5cm x 15cm。</items><items id="text">婴幼儿型</items></items><items code="at1019"><items id="description">适用于新生儿的袖带（臂带，袖套，臂围），且假定袖带尺寸适合于新生儿的成熟度和出生体重。</items><items id="text">新生儿型</items></items><items code="at1020"><items id="description">受检对象的右手腕。</items><items id="text">右手腕</items></items><items code="at1021"><items id="description">受检对象的左手腕。</items><items id="text">左手腕</items></items><items code="at1025"><items id="description">关于用于测量血压的血压计或其他装置（仪器，设备）的详情。</items><items id="text">装置</items></items><items code="at1026"><items id="description">受检对象的右踝。</items><items id="text">右踝</items></items><items code="at1030"><items id="description">关于血压测量时所从事的体力活动或者说身体活动的详情。</items><items id="text">体力活动</items></items><items code="at1031"><items id="description">受检对象的左踝。</items><items id="text">左踝</items></items><items code="at1032"><items id="description">检查对象的某一手指。</items><items id="text">手指</items></items><items code="at1035"><items id="description">血压测量方法。</items><items id="text">方法</items></items><items code="at1036"><items id="description">利用听诊器和柯氏音（Korotkoff sounds）在身体外部测量血压的方法。</items><items id="text">听诊法</items></items><items code="at1037"><items id="description">利用触诊（扪诊）在身体外部测量血压的方法（通常采用的是对肱动脉或桡动脉的触诊）。</items><items id="text">触诊法</items></items><items code="at1038"><items id="description">用于计算平均动脉压（Mean Arterial Pressure，MAP，平均动脉血压）的公式（如果在数据之中加以记录的话）。</items><items id="text">平均动脉压公式</items></items><items code="at1039"><items id="description">利用血压测量设备（仪器，装置）在身体外部测量血压的方法。</items><items id="text">仪器法</items></items><items code="at1040"><items id="description">在身体内部测量血压的方法，也就是说涉及到皮肤穿刺和在血管内进行测量。</items><items id="text">有创法</items></items><items code="at1042"><items id="description">24小时期间血压均值的估计</items><items id="text">24小时均值</items></items><items code="at1043"><items id="description">睡眠状态 - 旨在支持对于24小时流动式/门诊血压记录的解释。</items><items id="text">睡眠状态</items></items><items code="at1044"><items id="description">受检对象意识完全清楚。</items><items id="text">警觉且清醒</items></items><items code="at1045"><items id="description">受检对象处在全身休息的自然状态下。</items><items id="text">睡眠状态</items></items><items code="at1051"><items id="description">检查对象的某一脚趾。</items><items id="text">脚趾</items></items><items code="at1052"><items id="description">旨在记录和说明可能影响血压测量结果的偶然因素。例如，焦虑/进展程度或“白大褂综合征（white coat syndrome）”、疼痛、发热、大气压变化等等。</items><items id="text">干扰因素</items></items><items code="at1053"><items id="description">利用位于动脉内的传感器接入通路来进行有创性测量。</items><items id="text">动脉内</items></items><items code="at1054"><items id="description">用于依据平均动脉压（数据之中已有相应记录时）来计算收缩压的公式。</items><items id="text">收缩压公式</items></items><items code="at1055"><items id="description">用于依据平均动脉压（数据之中已有相应记录时）来计算舒张压的公式。</items><items id="text">舒张压公式</items></items><items code="at1056"><items id="description">患者脚部的背面。</items><items id="text">足背</items></items><items code="at1057"><items id="description">进行当前测量时所采用的结构化解剖学位置。</items><items id="text">结构化测量位置</items></items><items code="at1058"><items id="comment">例如：用于与FHIR或CIMI的等价工件进行匹配统一时所需的本地医院科室信息或附加的元数据。</items><items id="description">采集/记录本地语境或者与其他参考模型/形式化体系进行匹配统一时所需的附加信息。</items><items id="text">扩展</items></items><items code="at1059"><items id="description">单个词语、短语或者简要的描述，用于表达当前血压测量结果的临床含义和意义。</items><items id="text">临床解释</items></items></term_definitions><term_bindings terminology="SNOMED-CT"><items code="at0000"><value><terminology_id><value>SNOMED-CT(2003)</value></terminology_id><code_string>364090009</code_string></value></items><items code="at0004"><value><terminology_id><value>SNOMED-CT(2003)</value></terminology_id><code_string>271649006</code_string></value></items><items code="at0005"><value><terminology_id><value>SNOMED-CT(2003)</value></terminology_id><code_string>271650006</code_string></value></items><items code="at0013"><value><terminology_id><value>SNOMED-CT(2003)</value></terminology_id><code_string>246153002</code_string></value></items></term_bindings></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.body_weight.v2"><term_definitions language="ar-sy"><items code="at0000"><items id="description">قياس وزن الجسم للشخص</items><items id="text">وزن الجسم</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0004"><items id="description">وزن الشخص</items><items id="text">الوزن</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">*Description of the state of dress of the person at the time of weighing.(en)</items><items id="text">*State of dress(en)</items></items><items code="at0010"><items id="description">الشخص يرتدي ملابس قد تزيد الوزن بشكل مؤثر, بما في ذلك الأحذية.</items><items id="text">ملابس كاملة, بما في ذلك الأحذية</items></items><items code="at0011"><items id="description">ملابس لا تزيد الوزن بشكل مؤثر</items><items id="text">ملابس خفيفة/ ملابس داخلية</items></items><items code="at0013"><items id="description">لا يرتدي أي ملابس</items><items id="text">مُعَرَّى</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">الشخص يرتدي حفاظة فقط - و قد يزيد ذلك من الوزن بشكل مؤثر</items><items id="text">حفاظة</items></items><items code="at0020"><items id="description">تفاصيل حول الجهيزة المستخدمة في القياس</items><items id="text">الجهيزة</items></items><items code="at0024"><items id="description">*Additional narrative about the measurement of Body weight, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="description">*Record any issues or factors that may impact on the measurement of body weight eg timing in menstrual cycle, timing of recent bowel motion or noting of amputation.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0026"><items id="description">*Usually the first weight, measured soon after birth. This event will only be used once per health record&#13;
.(en)</items><items id="text">*Birth(en)</items></items><items code="at0027"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0028"><items id="description">*Clothing which may add significantly to weight. (en)</items><items id="text">*Fully clothed, without shoes (en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="description">Mesura del pes corporal d'un pacient.</items><items id="text">Pes corporal</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Esdeveniment predeterminat i no especificat d’un moment donat específic o interval que es pot definir explícitament en una plantilla o en temps d’execució.</items><items id="text">Qualsevol esdeveniment</items></items><items code="at0004"><items id="description">Pes del pacient.</items><items id="text">Pes</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Descripció de la vestimenta del pacient al moment de la mesura del pes corporal.</items><items id="text">Vestimenta</items></items><items code="at0010"><items id="description">La indumentària, incloent-hi calçat, que pot incrementar significativament el pes.</items><items id="text">Totalment vestit/da, incloent calçat</items></items><items code="at0011"><items id="description">Vestimenta que no incrementa significativament el pes.</items><items id="text">Indumentària lleugera/Roba interior</items></items><items code="at0013"><items id="description">Sense roba.</items><items id="text">Nu/a</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Únicament amb bolquers, la qual cosa pot incrementar significativament el pes.</items><items id="text">Bolquers</items></items><items code="at0020"><items id="description">Detalls sobre el dispositiu de pesatge.</items><items id="text">Dispositiu</items></items><items code="at0024"><items id="description">Informació addicional sobre la mesura del Pes corporal, no recollida en altres caselles.</items><items id="text">Observacions</items></items><items code="at0025"><items id="description">Registrar qualsevol problema o factor que pugui afectar la mesura del pes corporal; per exemple, en el cicle menstrual, moviment intestinal recent o registre d'una amputació.</items><items id="text">Factors de confusió</items></items><items code="at0026"><items id="description">Generalment, la primera mesura de pes corporal, presa poc després del naixement. Aquest esdeveniment només es farà servir una vegada per registre mèdic.</items><items id="text">Naixement</items></items><items code="at0027"><items id="comment">Per exemple: requisits locals d'informació o metadades addicionals per alinear-se amb equivalents de FHIR o CIMI.</items><items id="description">Informació addicional necessària per a recollir el contingut local o per alinear-se amb altres models/formalismes de referència.</items><items id="text">Extensió</items></items><items code="at0028"><items id="description">La vestimenta, sense calçat, que pot incrementar significativament el pes.</items><items id="text">Totalment vestit/da, sense calçat</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="description">Messung des Körpergewichts eines Individuums.</items><items id="text">Körpergewicht</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">History</items></items><items code="at0003"><items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items><items id="text">Beliebiges Ereignis</items></items><items code="at0004"><items id="description">Das Gewicht eines Individuums.</items><items id="text">Gewicht</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">State structure</items></items><items code="at0009"><items id="description">Beschreibung des Kleidungszustands der Person zum Zeitpunkt des Wiegens.</items><items id="text">Status der Bekleidung</items></items><items code="at0010"><items id="description">Bekleidung, die signifikant zum Gewicht beiträgt, mit Schuhen.</items><items id="text">Voll bekleidet, mit Schuhen</items></items><items code="at0011"><items id="description">Bekleidung, die nicht signifikant zum Gewicht beiträgt.</items><items id="text">Leicht bekleidet / Unterwäsche</items></items><items code="at0013"><items id="description">Ohne Kleidung.</items><items id="text">Unbekleidet</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">Protocol structure</items></items><items code="at0017"><items id="description">Trägt Windel; kann signifikant zum Gewicht beitragen.</items><items id="text">Windel</items></items><items code="at0020"><items id="description">Details über die benutzte Waage.</items><items id="text">Gerät</items></items><items code="at0024"><items id="description">Zusätzliche Darstellung der Messung des Körpergewichts, die in anderen Bereichen nicht erfasst wurde.&#13;
	</items><items id="text">Kommentar</items></items><items code="at0025"><items id="description">Beschreibung aller Probleme oder Faktoren, die sich auf die Messung des Körpergewichts auswirken können, z. B. das Timing im Menstruationszyklus, das Timing des letzten Stuhlgangs oder das Feststellen einer Amputation.</items><items id="text">Einflussfaktoren</items></items><items code="at0026"><items id="description">Normalerweise das erste Gewicht, gemessen kurz nach der Geburt. Dieses Ereignis wird nur einmal pro Gesundheitsakte verwendet.</items><items id="text">Geburt</items></items><items code="at0027"><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="text">Erweiterung</items></items><items code="at0028"><items id="description">Bekleidung, die signifikant zum Gewicht beiträgt.</items><items id="text">Voll bekleidet, ohne Schuhen</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">Measurement of the body weight of an individual.</items><items id="text">Body weight</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items><items id="text">Any event</items></items><items code="at0004"><items id="description">The weight of the individual.</items><items id="text">Weight</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Description of the state of dress of the person at the time of weighing.</items><items id="text">State of dress</items></items><items code="at0010"><items id="description">Clothing which may add significantly to weight, including shoes.</items><items id="text">Fully clothed, including shoes</items></items><items code="at0011"><items id="description">Clothing which will not add to weight significantly.</items><items id="text">Lightly clothed/underwear</items></items><items code="at0013"><items id="description">Without any clothes.</items><items id="text">Naked</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Wearing only a nappy - which may add significantly to weight.</items><items id="text">Nappy/diaper</items></items><items code="at0020"><items id="description">Details about the weighing device.</items><items id="text">Device</items></items><items code="at0024"><items id="description">Additional narrative about the measurement of Body weight, not captured in other fields.</items><items id="text">Comment</items></items><items code="at0025"><items id="description">Record any issues or factors that may impact on the measurement of body weight eg timing in menstrual cycle, timing of recent bowel motion or noting of amputation.</items><items id="text">Confounding factors</items></items><items code="at0026"><items id="description">Usually the first weight, measured soon after birth. This event will only be used once per health record&#13;
.</items><items id="text">Birth</items></items><items code="at0027"><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></items><items code="at0028"><items id="description">Clothing which may add significantly to weight.</items><items id="text">Fully clothed, without shoes</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="description">Medición del peso corporal de un individuo.</items><items id="text">Peso corporal</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Simple(en)</items></items><items code="at0002"><items id="description">*@ internal @(en)</items><items id="text">*history(en)</items></items><items code="at0003"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0004"><items id="description">Peso del individuo.</items><items id="text">Peso</items></items><items code="at0008"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0009"><items id="description">*Description of the state of dress of the person at the time of weighing.(en)</items><items id="text">*State of dress(en)</items></items><items code="at0010"><items id="description">La indumentaria, incluyendo calzado, puede incrementar el peso de forma significativa.</items><items id="text">Totalmente vestido incluyendo calzado</items></items><items code="at0011"><items id="description">La indumentaria no genera un incremento significativo del peso.</items><items id="text">Indumentaria ligera/Ropa interior</items></items><items code="at0013"><items id="description">Sin ropa.</items><items id="text">Desnudo</items></items><items code="at0015"><items id="description">*@ internal @(en)</items><items id="text">*protocol structure(en)</items></items><items code="at0017"><items id="description">Únicamente con un pañal. Puede incrementar el peso de forma significativa.</items><items id="text">Pañales</items></items><items code="at0020"><items id="description">Detalles acerca del dispositivo de pesada.</items><items id="text">Dispositivo</items></items><items code="at0024"><items id="description">*Additional narrative about the measurement of Body weight, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="description">*Record any issues or factors that may impact on the measurement of body weight eg timing in menstrual cycle, timing of recent bowel motion or noting of amputation.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0026"><items id="description">*Usually the first weight, measured soon after birth. This event will only be used once per health record&#13;
.(en)</items><items id="text">*Birth(en)</items></items><items code="at0027"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0028"><items id="description">*Clothing which may add significantly to weight. (en)</items><items id="text">*Fully clothed, without shoes (en)</items></items></term_definitions><term_definitions language="fa"><items code="at0000"><items id="description">اندازه گیری وزن بدن فرد</items><items id="text">وزن بدن</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0004"><items id="description">وزن فرد</items><items id="text">وزن</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">*Description of the state of dress of the person at the time of weighing.(en)</items><items id="text">*State of dress(en)</items></items><items code="at0010"><items id="description">لباسی که ممکن است بطور قابل توجهی به وزن بیافزاید شامل کفش ها</items><items id="text">کاملا لباس پوشیده ، از جمله کفش</items></items><items code="at0011"><items id="description">لباسی که بطور قابل توجهی وزن را افزایش ندهد</items><items id="text">لباس سبک یا لباس زیر</items></items><items code="at0013"><items id="description">بدون هر گونه لباس</items><items id="text">لخت</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">پوشیدن فقط یک پوشک که می تواند وزن را بطور قابل توجهی افزایش دهد</items><items id="text">کهنه بچه یا پوشک</items></items><items code="at0020"><items id="description">توصیف تجهیز استفاده شده برای اندازه گیری وزن</items><items id="text">تجهیز</items></items><items code="at0024"><items id="description">*Additional narrative about the measurement of Body weight, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="description">*Record any issues or factors that may impact on the measurement of body weight eg timing in menstrual cycle, timing of recent bowel motion or noting of amputation.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0026"><items id="description">*Usually the first weight, measured soon after birth. This event will only be used once per health record&#13;
.(en)</items><items id="text">*Birth(en)</items></items><items code="at0027"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0028"><items id="description">*Clothing which may add significantly to weight. (en)</items><items id="text">*Fully clothed, without shoes (en)</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="description">Henkilön painon mittaustulos.</items><items id="text">Paino</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Oletusarvo, määrittämätön ajanhetki tai aikaväli, joka voidaan nimenomaisesti määritellä templaatilla tai suorituksen aikana.</items><items id="text">Mikä tahansa tapahtuma</items></items><items code="at0004"><items id="description">Henkilön paino.</items><items id="text">Paino</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Kuvaus henkilön vaatetuksesta painon mittaushetkellä.</items><items id="text">Vaatetus</items></items><items code="at0010"><items id="description">Vaatetus, joka voi merkittävästi lisätä painoa, sisältäen kengät.</items><items id="text">Vaatteet päällä, kengät jalassa</items></items><items code="at0011"><items id="description">Vaatetus, joka ei merkittävästi lisää painoa.</items><items id="text">Kevyt vaatetus/alusvaatteet</items></items><items code="at0013"><items id="description">Ilman vaatteita.</items><items id="text">Alasti</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Päällä ainoastaan vaippa - voi lisätä merkittävästi painoa.</items><items id="text">Vaippa</items></items><items code="at0020"><items id="description">Lisätietoja käytetystä mittalaitteesta.</items><items id="text">Laite</items></items><items code="at0024"><items id="description">Lisätietoa liittyen Painon mittaamiseen, jota ei ole tallennettu muissa kentissä.</items><items id="text">Kommentti</items></items><items code="at0025"><items id="description">Kirjaa tekijät, jotka voivat vaikuttaa painon mittaustulokseen. Esimerkiksi kuukautiskierron vaihe, suolen toiminnan edellinen ajankohta tai amputaation huomioiminen.</items><items id="text">Sekoittavat tekijät</items></items><items code="at0026"><items id="description">Ensimmäinen painotieto, joka on mitattu pian syntymän jälkeen. Kyseinen tieto kirjataan vain yhden kerran henkilön terveystietoihin.</items><items id="text">Syntymä</items></items><items code="at0027"><items id="comment">Esimerkki: paikallisia tietovaatimuksia tai metadataa yhdistettäväksi FHIR tai CIMI tietomalleihin.</items><items id="description">Lisätietoja joita on tarvittu mittaustuloksen tallentamiseen tai yhdistämiseen toisiin referenssimalleihin.</items><items id="text">Laajennus</items></items><items code="at0028"><items id="description">Vaatetus, joka voi merkittävästi lisätä painoa.</items><items id="text">Vaatteet päällä, ilman kenkiä.</items></items></term_definitions><term_definitions language="fr"><items code="at0000"><items id="description">Mesure du poids corporel d'un individu.</items><items id="text">Poids corporel</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Événement par défaut, à un moment ou à un intervalle non spécifié, qui peut être explicitement défini dans un modèle ou au moment de l'exécution.</items><items id="text">*Any event(en)</items></items><items code="at0004"><items id="description">Le poids de l'individu.</items><items id="text">Poids</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Description de l'état vestimentaire de la personne au moment de la pesée.</items><items id="text">État de la tenue vestimentaire</items></items><items code="at0010"><items id="description">Les vêtements qui peuvent augmenter considérablement le poids, y compris les chaussures.</items><items id="text">Entièrement habillé, y compris les chaussures</items></items><items code="at0011"><items id="description">Des vêtements qui n'augmentent pas le poids de manière significative.</items><items id="text">Légèrement vêtu/en sous-vêtement</items></items><items code="at0013"><items id="description">Sans vêtements.</items><items id="text">Nu</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Ne porter qu'une couche - ce qui peut augmenter considérablement le poids.</items><items id="text">Couche-culotte</items></items><items code="at0020"><items id="description">Détails sur le dispositif de pesage.</items><items id="text">Dispositif</items></items><items code="at0024"><items id="description">Narration supplémentaire sur la mesure du poids corporel, non saisie dans d'autres domaines.</items><items id="text">Commentaire</items></items><items code="at0025"><items id="description">Enregistrez toutes les questions ou facteurs qui peuvent avoir un impact sur la mesure du poids corporel, par exemple le moment du cycle menstruel, le moment de la défécation récente ou la constatation d'une amputation.</items><items id="text">Facteurs de confusion</items></items><items code="at0026"><items id="description">Habituellement, le premier poids, mesuré peu après la naissance. Cet événement ne sera utilisé qu'une seule fois par dossier de santé</items><items id="text">Naissance</items></items><items code="at0027"><items id="comment">Par exemple : exigences locales en matière d'information ou métadonnées supplémentaires à aligner sur les équivalents FHIR ou CIMI.</items><items id="description">Informations supplémentaires requises pour saisir le contenu local ou pour s'aligner sur d'autres modèles/formalismes de référence.</items><items id="text">Extension</items></items><items code="at0028"><items id="description">Les vêtements qui peuvent augmenter considérablement le poids.</items><items id="text">Entièrement vêtu, sans chaussures</items></items></term_definitions><term_definitions language="ja"><items code="at0000"><items id="description">個人の体重を測定したもの</items><items id="text">体重</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Simple(en)</items></items><items code="at0002"><items id="description">*@ internal @(en)</items><items id="text">*history(en)</items></items><items code="at0003"><items id="description">デフォルトではテンプレートや実行時に明示的に定義される特定されていない時点あるいは間隔でのイベント</items><items id="text">任意のイベント</items></items><items code="at0004"><items id="description">個人の重量</items><items id="text">重量</items></items><items code="at0008"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0009"><items id="description">体重測定時の着衣状態についての記述￥</items><items id="text">着衣状態</items></items><items code="at0010"><items id="description">靴を含めて、体重測定に大きく関与するような着衣状態</items><items id="text">靴も履いている着衣状態</items></items><items code="at0011"><items id="description">体重測定にあまり寄与しない着衣</items><items id="text">軽装／下着</items></items><items code="at0013"><items id="description">何も着衣していない</items><items id="text">全裸</items></items><items code="at0015"><items id="description">*@ internal @(en)</items><items id="text">*protocol structure(en)</items></items><items code="at0017"><items id="description">おむつだけをはいている状態。体重測定に関与しうる。</items><items id="text">おむつを付けている状態</items></items><items code="at0020"><items id="description">測定に使用された機器についての詳細な記録</items><items id="text">測定機器</items></items><items code="at0024"><items id="description">他のフィールドには記載されない体重の計測についての叙述的記録</items><items id="text">コメント</items></items><items code="at0025"><items id="description">体重計測に影響を与えうるすべての要素や問題。例えば、月経周期や直近の排便時、四肢切断の有無。</items><items id="text">交絡因子</items></items><items code="at0026"><items id="description">一般的には誕生後最初に計測される体重。このイベントは一生に1回だけ記録される。</items><items id="text">生下時</items></items><items code="at0027"><items id="comment">例えば、FHIRやCIMIと同等に割り当てられるメタデータやローカルの情報要件</items><items id="description">ローカルの内容や他の参照モデル、形式に割り当ててデータを取得する追加情報</items><items id="text">拡張領域</items></items><items code="at0028"><items id="description">体重計測に影響を与えうる着衣状態</items><items id="text">靴を脱いだ着衣状態</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">Individets kroppsvekt.</items><items id="text">Kroppsvekt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i et templat eller i en applikasjon.</items><items id="text">Uspesifisert hendelse</items></items><items code="at0004"><items id="description">Et individs totale kroppsmasse.</items><items id="text">Kroppsvekt</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Beskrivelse av personens påkledning på måletidspunktet.</items><items id="text">Påkledning</items></items><items code="at0010"><items id="description">Påkledning som kan øke vekten signifikant, inklusive sko.</items><items id="text">Fullt påkledt inklusive sko</items></items><items code="at0011"><items id="description">Påkledning som ikke endrer vekten signifikant.</items><items id="text">Lette klær / undertøy</items></items><items code="at0013"><items id="description">Uten klær.</items><items id="text">Naken</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Bare ikledt bleie - kan legge til signifikant vekt.</items><items id="text">Bleie</items></items><items code="at0020"><items id="description">Detaljer om måleapparatet brukt til vektmålingen.</items><items id="text">Måleapparat</items></items><items code="at0024"><items id="description">Ytterligere beskrivelse av målingen av kroppsvekt som ikke dekkes i andre felt.</items><items id="text">Kommentar</items></items><items code="at0025"><items id="description">Registering av emner eller faktorer som kan ha betydning for måling av kroppsvekten, f.eks. inntak av mat og drikke, stort saltinntak, menstruasjonssyklus, tidspunkt for avføring, ødem eller uke av graviditet.</items><items id="text">Konfunderende faktorer</items></items><items code="at0026"><items id="description">Den første vekten målt etter fødselen. Denne hendelsen skal kun benyttes én gang per journal.</items><items id="text">Fødsel</items></items><items code="at0027"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at0028"><items id="description">Påkledning som kan øke vekten signifikant.</items><items id="text">Fullt påkledt, uten sko</items></items></term_definitions><term_definitions language="nl"><items code="at0000"><items id="description">Meting van het lichaamsgewicht van een individu.</items><items id="text">Lichaamsgewicht</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Simple(en)</items></items><items code="at0002"><items id="description">*@ internal @(en)</items><items id="text">*history(en)</items></items><items code="at0003"><items id="description">Standaard, ongespecificeerd moment in de tijd of een interval dat expliciet vastgelegd kan worden in een template terwijl de applicatie draait.</items><items id="text">Elke gebeurtenis</items></items><items code="at0004"><items id="description">Het gewicht van het individu.</items><items id="text">Gewicht</items></items><items code="at0008"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0009"><items id="description">Beschrijving van de kleding die de persoon draagt op het moment van wegen.</items><items id="text">Kleding</items></items><items code="at0010"><items id="description">Kleren die een significante bijdrage hebben aan het gewicht, inclusief schoenen.</items><items id="text">Volledig gekleed, inclusief schoenen</items></items><items code="at0011"><items id="description">Kleding die niet significant het gewicht beïnvloedt.</items><items id="text">Lichte kleding/ondergoed</items></items><items code="at0013"><items id="description">Zonder kleding.</items><items id="text">Naakt</items></items><items code="at0015"><items id="description">*@ internal @(en)</items><items id="text">*protocol structure(en)</items></items><items code="at0017"><items id="description">Individu draagt alleen een luier - die significant aan het gewicht kan bijdragen.</items><items id="text">Luier</items></items><items code="at0020"><items id="description">Details over het apparaat waarmee gewogen is.</items><items id="text">Apparaat</items></items><items code="at0024"><items id="description">Extra informatie over de meting van het lichaamsgewicht, die niet past binnen andere velden.</items><items id="text">Opmerking</items></items><items code="at0025"><items id="description">Leg elke gegeven of factor vast die invloed heeft op de meting van het lichaamsgewicht, bijvoorbeeld moment in de menstruele cyclus, tijd sinds recente ontlasting of een amputatie.</items><items id="text">Beïnvloedende factoren.</items></items><items code="at0026"><items id="description">Normaal het eerste gewicht na geboorte. Deze waarde slechts eenmalig worden vastgelegd per elektronisch dossier.</items><items id="text">Geboorte</items></items><items code="at0027"><items id="comment">Bijvoorbeeld: lokale informatie eisen of extra metadata om te verbinden met FHIR of CIMI vergelijkbare systemen.</items><items id="description">Extra informatie die nodig is om lokale informatie vast te leggen of om te verbinden met andere referentiemodulen.</items><items id="text">Uitbreiding</items></items><items code="at0028"><items id="description">Kleding die het gewicht significant beïnvloedt.</items><items id="text">Volledig gekleed maar, zonder schoenen.</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="description">A medição do peso corporal de um indivíduo.</items><items id="text">Peso corporal</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Padrão, ponto específico no tempo ou intervalo que pode ser explicitamente definido em template ou em tempo de execução.</items><items id="text">Qualquer evento</items></items><items code="at0004"><items id="description">O peso do indivíduo.</items><items id="text">Peso</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Descrição da situação do vestuário do indivíduo no momento da pesagem.</items><items id="text">Situação do vestuário</items></items><items code="at0010"><items id="description">Roupas que podem aumentar significativamente o peso, incluindo sapatos.</items><items id="text">Totalmente vestida, incluindo sapatos</items></items><items code="at0011"><items id="description">Roupas que não irão acrescentar ao peso de forma significativa.</items><items id="text">Levemente vestido / roupa íntimas</items></items><items code="at0013"><items id="description">Sem nenhuma roupa.</items><items id="text">Despido</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Vestindo apenas uma fralda - pode adicionar peso significativo.</items><items id="text">Fralda</items></items><items code="at0020"><items id="description">Detalhes sobre o dispositivo de pesagem.</items><items id="text">Dispositivo</items></items><items code="at0024"><items id="description">Narrativa adicional sobre a medida de peso corporal, não capturado em outros campos.</items><items id="text">Comentário</items></items><items code="at0025"><items id="description">Registra qualquer problemas ou fatores que impactam na medida do peso corporal pe período menstrual, período recente de movimento peristáltico e observação de amputação.</items><items id="text">Fatores de confundimento</items></items><items code="at0026"><items id="description">Normalmente o primeiro peso, medido ao nascer.</items><items id="text">Nascimento</items></items><items code="at0027"><items id="comment">Por exemplo: informações locais necessárias ou metadados adicionais para alinhamento ao FHIR ou outras iniciativas equivalentes de modelagem do conhecimento clínico.</items><items id="description">Informação adicional requerida para capturar conteúdo local ou para alinhar a outros modelos de referência/formalismos.</items><items id="text">Extensão</items></items><items code="at0028"><items id="description">Roupas que podem aumentar significativamente o peso.</items><items id="text">Totalmente vestida, sem sapatos</items></items></term_definitions><term_definitions language="ru"><items code="at0000"><items id="description">Измерение актуальной массы тела человека.</items><items id="text">Масса тела</items></items><items code="at0001"><items id="description">Bнутренний элемент.</items><items id="text">Простой</items></items><items code="at0002"><items id="description">Bнутренний элемент.</items><items id="text">История</items></items><items code="at0003"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0004"><items id="description">Актуальный вес человека.</items><items id="text">Вес</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">*Description of the state of dress of the person at the time of weighing.(en)</items><items id="text">*State of dress(en)</items></items><items code="at0010"><items id="description">Одежда может добавить значительный вес.</items><items id="text">В одежде без обуви</items></items><items code="at0011"><items id="description">Одежда, не добавляющая значительный вес.</items><items id="text">В лёгкой одежде или раздевшись до белья</items></items><items code="at0013"><items id="description">Без какой-либо одежды и белья.</items><items id="text">Обнажен</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Одет(а) только в памперс - может добавить значительный вес.</items><items id="text">В памперсе</items></items><items code="at0020"><items id="description">Весы (устройство, на котором производилось взвешивание): информация.</items><items id="text">Устройство</items></items><items code="at0024"><items id="description">*Additional narrative about the measurement of Body weight, not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0025"><items id="description">*Record any issues or factors that may impact on the measurement of body weight eg timing in menstrual cycle, timing of recent bowel motion or noting of amputation.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0026"><items id="description">*Usually the first weight, measured soon after birth. This event will only be used once per health record&#13;
.(en)</items><items id="text">*Birth(en)</items></items><items code="at0027"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0028"><items id="description">*Clothing which may add significantly to weight. (en)</items><items id="text">*Fully clothed, without shoes (en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="description">Mätning av en individs kroppsvikt.</items><items id="text">Kroppsvikt</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Simple</items></items><items code="at0002"><items id="description">@ internal @</items><items id="text">history</items></items><items code="at0003"><items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items><items id="text">Ospecificerad händelse</items></items><items code="at0004"><items id="description">Individens vikt.</items><items id="text">Vikt</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">state structure</items></items><items code="at0009"><items id="description">Beskrivning av individens klädsel vid tidpunkten för vägning.</items><items id="text">Klädsel</items></items><items code="at0010"><items id="description">Kläder, inklusive skor, som kan öka vikten avsevärt.</items><items id="text">Fullt påklädd, inklusive skor</items></items><items code="at0011"><items id="description">Kläder som inte ökar vikten avsevärt.</items><items id="text">Lätt klädd/underkläder</items></items><items code="at0013"><items id="description">Inga kläder alls.</items><items id="text">Naken</items></items><items code="at0015"><items id="description">@ internal @</items><items id="text">protocol structure</items></items><items code="at0017"><items id="description">Iklädd endast blöja, som kan öka vikten avsevärt.</items><items id="text">Blöja</items></items><items code="at0020"><items id="description">Detaljer om den utrustning som används för att mäta vikten.</items><items id="text">Utrustning</items></items><items code="at0024"><items id="description">Kommentarer avseende mätningen av kroppsvikt, som inte beskrivs i övriga datafält.</items><items id="text">Kommentar</items></items><items code="at0025"><items id="description">Beskrivning av faktorer och felkällor som kan påverka mätningen av kroppsvikt, exempelvis tidpunkt i menstruationscykeln, tid sedan senaste tarmtömning eller amputation.</items><items id="text">Möjliga felkällor</items></items><items code="at0026"><items id="description">Vanligtvis den första vägningen av barnet, strax efter födseln. Den här händelsen registreras endast en gång per patientjournal.</items><items id="text">Födelse</items></items><items code="at0027"><items id="comment">Exempelvis lokala informationskrav eller metadata för anpassning till FHIR.</items><items id="description">Plats för att infoga tilläggsinformation som krävs för lokala anpassningar eller anpassning till andra referensmodeller eller formella krav.</items><items id="text">Tilläggsinformation</items></items><items code="at0028"><items id="description">Kläder som kan öka vikten avsevärt.</items><items id="text">Fullt påklädd, utan skor</items></items></term_definitions><term_definitions language="zh-cn"><items code="at0000"><items id="description">个人体重（身体重量）的测量。</items><items id="text">体重</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Simple(en)</items></items><items code="at0002"><items id="description">*@ internal @(en)</items><items id="text">*history(en)</items></items><items code="at0003"><items id="description">任何事件。</items><items id="text">任何事件</items></items><items code="at0004"><items id="description">个人的身体重量。</items><items id="text">重量</items></items><items code="at0008"><items id="description">*@ internal @(en)</items><items id="text">*state structure(en)</items></items><items code="at0009"><items id="description">关于称重时受检人员的衣着状态</items><items id="text">衣着状态</items></items><items code="at0010"><items id="description">包括鞋子在内，所穿着衣物可能显著增加重量。</items><items id="text">衣着整齐，包括鞋子</items></items><items code="at0011"><items id="description">所穿着衣物并不会显著增加重量。</items><items id="text">衣着轻便/仅内衣</items></items><items code="at0013"><items id="description">没有穿着任何衣物。</items><items id="text">裸体</items></items><items code="at0015"><items id="description">*@ internal @(en)</items><items id="text">*protocol structure(en)</items></items><items code="at0017"><items id="description">仅有尿布/尿不湿 - 有可能显著增加重量。</items><items id="text">尿布/尿不湿</items></items><items code="at0020"><items id="description">关于称重装置的详细信息。</items><items id="text">装置</items></items><items code="at0024"><items id="description">其他字段之中并未记录的，额外关于体重测量指标的叙述型文本。</items><items id="text">备注</items></items><items code="at0025"><items id="description">用于记录任何可能对体重测量造成影响的问题或因素，如月经周期所处时间阶段、最近排便的时间安排情况或者截肢情况说明。</items><items id="text">干扰因素</items></items><items code="at0026"><items id="description">通常为出生之后短时间内所首次测量的体重。在每份健康档案当中将仅仅使用一次该事件。</items><items id="text">出生</items></items><items code="at0027"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)&#13;
例如，与FHIR或CIMI对等要素进行协调统一时所需的本地信息需求或附加的元数据。</items><items id="description">记录本地内容时或者是与其他的参考模型/形式化体系进行协调统一时所需的附加信息。</items><items id="text">扩展</items></items><items code="at0028"><items id="description">可能会显著增加重量的衣物。</items><items id="text">衣着整齐，不包括鞋子</items></items></term_definitions><term_bindings terminology="LOINC"><items code="at0004"><value><terminology_id><value>LOINC</value></terminology_id><code_string>29463-7</code_string></value></items></term_bindings></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.fluid_output.v1"><term_definitions language="de"><items code="at0000"><items id="description">Die Messung von Flüssigkeit, die über einen beliebigen Mechanismus aus dem Körper verloren geht oder ausgeschieden wird.</items><items id="text">Flüssigkeitsausscheidung</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Standardwert, ein undefinierter/s Zeitpunkt oder Intervallereignis, das explizit im Template oder zur Laufzeit der Anwendung definiert werden kann.</items><items id="text">Beliebiges Ereignis</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">Die Flüssigkeitsmenge wurde geschätzt.</items><items id="text">Geschätzt</items></items><items code="at0019"><items id="description">Die Flüssigkeitsmenge wurde direkt gemessen.</items><items id="text">Gemessen</items></items><items code="at0028"><items id="comment">Zum Beispiel: Harnableitungsbeutel.</items><items id="description">Details des Geräts zur Messung des Flüssigkeitsabgangs.</items><items id="text">Messgerät</items></items><items code="at0031"><items id="description">Die angewendete Vorgehensweise zur Quantifizierung der Flüssigkeitsmenge.</items><items id="text">Methode</items></items><items code="at0032"><items id="description">Zusätzliche Informationen über die Flüssigkeit, die nicht in anderen Bereichen dargestellt wurden.</items><items id="text">Kommentar</items></items><items code="at0033"><items id="comment">Zum Beispiel: ein Harnkatheter oder eine Kanüle.</items><items id="description">Details der Vorrichtung, mit der die Flüssigkeit gesammelt wurde.</items><items id="text">Ablaufvorrichtung</items></items><items code="at0035"><items id="comment">Wenn absorbierendes Material wie Windeln und Verbände im Rahmen des Managements der Schätzungen des Flüssigkeitsverlusts gewogen werden, muss zur Erfassung das Gewicht in die Menge umgerechnet werden.</items><items id="description">Die Menge der Flüssigkeit.</items><items id="text">Menge</items></items><items code="at0036"><items id="comment">Zum Beispiel: Urin oder Erbrechen. Wenn möglich, wird die Codierung des Flüssigkeitsnamens mit einer Terminologie bevorzugt.</items><items id="description">Identifizierung der verlorenen oder ausgeschiedenen Flüssigkeit.</items><items id="text">Bezeichnung der Flüssigkeit</items></items><items code="at0038"><items id="comment">Zum Beispiel: die Farbe des Urins.</items><items id="description">Zusätzliche detaillierte Angaben zur Flüssigkeit, einschließlich des makroskopischen Erscheinungsbilds oder anderer Prüfungen, die derzeit nicht in den strukturierten Daten erfasst sind.</items><items id="text">Flüssigkeitsdetails</items></items><items code="at0040"><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten zur Anpassung an FHIR-Ressourcen oder CIMI-Modelle.</items><items id="description">Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle/Formalismen.</items><items id="text">Erweiterung</items></items><items code="at0041"><items id="comment">Zum Beispiel: Kanüle; Harnkatheter oder Nasopharyngalschlauch. Wenn in einer klinischen Anwendung dieselbe Art von Flüssigkeit aus zwei oder mehr Quellen wie mehreren Abflüssen aus derselben Wunde beobachtet wird, kann die Quelle als "Kanüle 1" und "Kanüle 2" beschrieben werden. Wenn möglich, wird die Codierung der Quelle mit einer Terminologie bevorzugt.</items><items id="description">Die Quelle, aus der die Flüssigkeit verloren geht oder ausgeschieden wird.</items><items id="text">Quelle</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">The measurement of fluid lost or excreted from the body via any mechanism.</items><items id="text">Fluid output</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items><items id="text">Any event</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">The fluid volume has been estimated.</items><items id="text">Estimated</items></items><items code="at0019"><items id="description">The fluid volume has been directly measured.</items><items id="text">Measured</items></items><items code="at0028"><items id="comment">For example: Urinary drainage bag.</items><items id="description">Details of the device used to measure the fluid output.</items><items id="text">Measurement device</items></items><items code="at0031"><items id="description">The approach used to quantify the volume of fluid.</items><items id="text">Method</items></items><items code="at0032"><items id="description">Additional narrative about the fluid output not captured in other fields.</items><items id="text">Comment</items></items><items code="at0033"><items id="comment">For example: a urinary catheter or a drain tube.</items><items id="description">Details of the device that was used to collect the fluid.</items><items id="text">Output device</items></items><items code="at0035"><items id="comment">If absorbant material, such as diapers and dressings, are weighed as part of managing fluid loss estimates, the weight will need to be converted to a volume for recording.</items><items id="description">The volume of fluid.</items><items id="text">Volume</items></items><items code="at0036"><items id="comment">For example: urine or vomit. Coding of fluid name with a terminology is preferred, if possible.</items><items id="description">Identification of the fluid lost or excreted.</items><items id="text">Fluid name</items></items><items code="at0038"><items id="comment">For example: the colour of the urine.&#13;
</items><items id="description">Additional details about the fluid, including macroscopic appearance or other tests not currently captured in the structured data.</items><items id="text">Fluid details</items></items><items code="at0040"><items id="comment">e.g. Local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></items><items code="at0041"><items id="comment">For example: drain tube; urinary catheter or nasopharyngal tube. In a clinical application, if the same type of fluid is being observed from two or more sources such as multiple drains from the same wound, the source may be described as “Drain tube 1” and “Drain tube 2”. Coding of the source with a terminology is preferred, where possible.</items><items id="description">The source from which the fluid is lost or excreted.</items><items id="text">Source</items></items></term_definitions><term_definitions language="es-ar"><items code="at0000"><items id="description">La medición del fluido perdido o excretados del cuerpo por cualquier mecanismo.</items><items id="text">Egreso de fluido</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Punto en el tiempo o intervalo de un evento que puede ser explícitamente definido en una plantilla o en tiempo de ejecución, por defecto.</items><items id="text">Cualquier evento</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">El volumen del fluido ha sido estimado.</items><items id="text">Estimado</items></items><items code="at0019"><items id="description">El volumen del fluido ha sido medido directamente.</items><items id="text">Medido</items></items><items code="at0028"><items id="comment">Por ejemplo: bolsa de orina.</items><items id="description">El dispositivo utilizado para medir el volumen del fluido.</items><items id="text">Dispositivo de medición</items></items><items code="at0031"><items id="description">El enfoque utilizado para cuantificar el volumen del fluido.</items><items id="text">Método</items></items><items code="at0032"><items id="description">Narrativa adicional acerca del egreso de fluido que no haya sido capturada en otros campos.</items><items id="text">Comentario</items></items><items code="at0033"><items id="comment">Por ejemplo: un catéter urinario o un tubo de drenaje.</items><items id="description">Detalles del dispositivo utilizado para recolectar el líquido.</items><items id="text">Dispositivo de egreso</items></items><items code="at0035"><items id="comment">Si se trata de un material absorbente como pañales o apósitos, se los pesa como parte de la estimación de la perdida del fluido y el peso debe ser convertido a volumen para su registro.</items><items id="description">El volumen del fluido.</items><items id="text">Volumen</items></items><items code="at0036"><items id="comment">Por ejemplo: orina o vómito. Se prefiere la codificación del fluido mediante una terminología si esto es posible.</items><items id="description">Identificación del fluido eliminado o excretado.</items><items id="text">Denominación del fluido</items></items><items code="at0038"><items id="comment">Por ejemplo: el color de la orina.</items><items id="description">Detalles adicionales del fluido, incluyendo el aspecto macroscópico u otros exámenes no registrados mediante datos estructurados.</items><items id="text">Detalles del fluido</items></items><items code="at0040"><items id="comment">Ej.: Requerimientos locales de información o metadatos adicionales para el alineamiento con FHIR, CIMI o equivalentes.</items><items id="description">Información adicional requerida para la captura de contenido locales o el alineamiento con otros modelos o formalismos de referencia.</items><items id="text">Extensión</items></items><items code="at0041"><items id="comment">Por ejemplo: tubo de drenaje; catéter urinario o nasofaringeo. En una aplicación clínica, si el mismo tipo de fluido esta siendo observado a partir de dos o mas fuentes, como en el caso de drenajes múltiples de una misma herida, la fuente será descrita como "tubo de drenaje 1" y "tubo de drenaje 2". Se codificará la fuente mediante una terminología si esto es posible.</items><items id="description">La fuente de pérdida o excreción del fluido.</items><items id="text">Fuente</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="description">Kehon millä tahansa tavalla menettämien tai erittämien nesteiden mittaaminen.</items><items id="text">Nesteiden menetys</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Oletusarvoinen, määrittämättömänä ajanhetkenä tai ajanjaksolla ilmenevä tapahtuma, joka voi olla määritetty tarkasti jossakin mallissa tai suorituksen aikana.</items><items id="text">Mikä tahansa tapahtuma</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">Nesteiden tilavuus on arvioitu.</items><items id="text">Arvio</items></items><items code="at0019"><items id="description">Nesteiden tilavuus on mitattu suoraan.</items><items id="text">Mitattu</items></items><items code="at0028"><items id="comment">For example: Urinary drainage bag.</items><items id="description">Nesteiden menetyksen mittaamiseen käytettävän laitteen tiedot.</items><items id="text">Mittalaite</items></items><items code="at0031"><items id="description">Nesteen tilavuuden mittaamiseen käytettävä menetelmä.</items><items id="text">Menetelmä</items></items><items code="at0032"><items id="description">Nesteiden menetykseen liittyvät kertomusmuodossa olevat lisätiedot, joita ei voida ilmoittaa muissa kentissä.</items><items id="text">Kommentti</items></items><items code="at0033"><items id="comment">For example: a urinary catheter or a drain tube.</items><items id="description">Tiedot nesteen keräämiseen käytetystä laitteesta.</items><items id="text">Erityksen keruulaite</items></items><items code="at0035"><items id="comment">If absorbant material, such as diapers and dressings, are weighed as part of managing fluid loss estimates, the weight will need to be converted to a volume for recording.</items><items id="description">Nesteen tilavuus.</items><items id="text">Tilavuus</items></items><items code="at0036"><items id="comment">For example: urine or vomit. Coding of fluid name with a terminology is preferred, if possible.</items><items id="description">Menetetyn tai eritetyn nesteen nimi.</items><items id="text">Nesteen nimi</items></items><items code="at0038"><items id="comment">For example: the colour of the urine.&#13;
</items><items id="description">Lisätietoja nesteestä, mukaan lukien paljaalla silmällä näkyvä ulkoasu tai muita kokeita, joita ei tällä hetkellä voida kirjata rakenteisiin tietoihin.</items><items id="text">Nesteen lisätiedot</items></items><items code="at0040"><items id="comment">e.g. Local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Lisätiedot, joita tarvitaan paikallisen sisällön kirjaamiseksi tai yhtenäistämiseksi muiden viitemallien tai formalismien kanssa.</items><items id="text">Laajennus</items></items><items code="at0041"><items id="comment">For example: drain tube; urinary catheter or nasopharyngal tube. In a clinical application, if the same type of fluid is being observed from two or more sources such as multiple drains from the same wound, the source may be described as “Drain tube 1” and “Drain tube 2”. Coding of the source with a terminology is preferred, where possible.</items><items id="description">Lähde, josta neste menetetään tai eritetään.</items><items id="text">Lähde</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">Målingen av væske som er utskilt eller utsondret fra kroppen, uavhengig av mekanisme.</items><items id="text">Væsketap</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en template eller i en applikasjon.</items><items id="text">Uspesifisert hendelse</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">Mengden væsketap er estimert.</items><items id="text">Estimert</items></items><items code="at0019"><items id="description">Mengden væsketap er direkte observert og målt.</items><items id="text">Målt</items></items><items code="at0028"><items id="comment">For eksempel drenpose, timediuresesett, urinflaske eller vekt.</items><items id="description">Detaljer om måleutstyret som er brukt for å måle væsketapet.</items><items id="text">Måleutstyr</items></items><items code="at0031"><items id="description">Metoden man har brukt til å kvantifisere mengden av væske.</items><items id="text">Målemetode</items></items><items code="at0032"><items id="description">Ytterligere fritekst om væsketapet som ikke er registrert i andre felt.</items><items id="text">Kommentar</items></items><items code="at0033"><items id="comment">For eksempel urinkateter, sårdren, absorpsjonskompress eller bleie.</items><items id="description">Detaljer om utstyret man har brukt til å samle væsken.</items><items id="text">Utstyr</items></items><items code="at0035"><items id="comment">Dersom man veier et absorberende materiale, som bleie eller kompress for å anslå mengden væske, må man konvertere fra vektenhet til væskeenhet ved registrering.</items><items id="description">Mengden væske som er utskilt.</items><items id="text">Mengde</items></items><items code="at0036"><items id="comment">For eksempel urin eller oppkast. Væskenavn bør kodes med en terminologi om mulig.</items><items id="description">Identifisering av væsken som er utskilt.</items><items id="text">Navn på væsken</items></items><items code="at0038"><items id="comment">For eksempel fargen på urin.</items><items id="description">Ytterligere data om væsken, inkludert utseende eller annet som ikke fremkommer strukturert i andre elementer.</items><items id="text">Ytterligere detaljer om væsken</items></items><items code="at0040"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at0041"><items id="comment">For eksempel dren, urinkateter eller ventrikkelsonde. Hvis samme type væske blir observert fra flere kilder - som flere dren fra samme sår, kan en i et klinisk system kalle kilden "Dren 1" og "Dren 2". Koding med en terminologi er ønskelig, der det er mulig.</items><items id="description">Kilden væsken kommer fra.</items><items id="text">Kilde</items></items></term_definitions><term_definitions language="sl"><items code="at0000"><items id="description">*The measurement of fluid lost or excreted from the body via any mechanism.(en)</items><items id="text">*Fluid output(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Event Series(en)</items></items><items code="at0002"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*List(en)</items></items><items code="at0008"><items id="description">*@ internal @(en)</items><items id="text">*List(en)</items></items><items code="at0018"><items id="description">*The fluid volume has been estimated.(en)</items><items id="text">*Estimated(en)</items></items><items code="at0019"><items id="description">*The fluid volume has been directly measured.(en)</items><items id="text">*Measured(en)</items></items><items code="at0028"><items id="comment">*For example: Urinary drainage bag.(en)</items><items id="description">*Details of device used to measure the fluid output.(en)</items><items id="text">*Measurement device(en)</items></items><items code="at0031"><items id="description">*The approach used to quantify the volume of fluid.(en)</items><items id="text">*Method(en)</items></items><items code="at0032"><items id="description">*Additional narrative about the fluid output not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0033"><items id="comment">*For example: a urinary catheter or a drain tube.(en)</items><items id="description">*Details of the device that was used to collect the fluid.(en)</items><items id="text">*Output device(en)</items></items><items code="at0035"><items id="comment">*If absorbant material, such as diapers and dressings, are weighed as part of managing fluid loss estimates, the weight will need to be converted to a volume for recording.(en)</items><items id="description">*The volume of fluid.(en)</items><items id="text">*Volume(en)</items></items><items code="at0036"><items id="comment">*For example: urine or vomit.(en)</items><items id="description">*Identification of the fluid lost or excreted.(en)</items><items id="text">*Fluid name(en)</items></items><items code="at0038"><items id="comment">*For example: the colour of the urine.&#13;
(en)</items><items id="description">*Additional details about the fluid, including macroscopic appearance or other tests not currently captured in the structured data.(en)</items><items id="text">*Fluid details(en)</items></items><items code="at0040"><items id="description">**(en)</items><items id="text">*Cluster(en)</items></items><items code="at0041"><items id="comment">*For example: drain tube; urinary catheter or nasopharyngal tube. In a clinical application, if the same type of fluid is being observed from two or more sources such as multiple drains from the same wound, the source may be described as “Drain tube 1” and “Drain tube 2”. Coding of the source with a terminology is preferred, where possible. (en)</items><items id="description">*The source from which the fluid is lost or excreted.(en)</items><items id="text">*Source(en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="description">Mätning av vätska som förloras eller utsöndras från kroppen via någon mekanism.</items><items id="text">Vätskeutsöndring</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Standardval, händelse i ospecificerad tidpunkt eller intervall som explicit kan definieras i en mall eller vid körning av program.</items><items id="text">Ospecificerad händelse</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0008"><items id="description">@ internal @</items><items id="text">List</items></items><items code="at0018"><items id="description">Vätskevolymen är uppskattad.</items><items id="text">Uppskattad</items></items><items code="at0019"><items id="description">Vätskevolymen har uppmätts direkt.</items><items id="text">Uppmätt</items></items><items code="at0028"><items id="comment">Exempelvis: Dräneringspåse för urin.</items><items id="description">Information om den utrustning som används för att mäta vätskeutsöndringen.</items><items id="text">Mätutrustning</items></items><items code="at0031"><items id="description">Den metod som används för att mäta volymen av vätska.</items><items id="text">Metod</items></items><items code="at0032"><items id="description">Ytterligare beskrivning om vätskeproduktionen som inte tagits med i andra fält.</items><items id="text">Kommentar</items></items><items code="at0033"><items id="comment">Exempelvis: en urinkateter eller ett dränrör.</items><items id="description">Information om den utrustning som användes för att samla ihop vätskan.</items><items id="text">Utsöndringsutrustning</items></items><items code="at0035"><items id="comment">Om absorberande material, såsom blöjor och omslag, vägs som en del i hanteraringen av vätskeförlust-beräkningar, kommer vikten att behöva omvandlas till en volym för registrering.</items><items id="description">Vätskans volym.</items><items id="text">Volym</items></items><items code="at0036"><items id="comment">Exempelvis: urin eller kräkning. Kodning av vätskenamn med en terminologi är att föredra, om möjligt.</items><items id="description">Identifiering av den vätska som försvinner eller utsöndras.</items><items id="text">Vätskenamn</items></items><items code="at0038"><items id="comment">Exempelvis: färgen på urinen.</items><items id="description">Ytterligare information om vätskan, inklusive makroskopiskt utseende eller andra tester som för närvarande inte inkluderats i strukturerade data.</items><items id="text">Vätskedetaljer</items></items><items code="at0040"><items id="comment">Exempelvis lokala informationskrav eller ytterligare metadata för anpassning till FHIR- eller CIMI-motsvarigheter.</items><items id="description">Ytterligare information som krävs för att samla in lokalt innehåll eller för anpassning till andra referens modeller och formalismer.</items><items id="text">Extra information</items></items><items code="at0041"><items id="comment">Exempelvis: dränrör, urinkateter eller *nasofaryngeal-rör*. I klinisk tillämpning, om samma typ av vätska observeras från två eller flera källor såsom flera dränage från samma sår, kan källan beskrivas som "Dränrör 1" och "Dranrör 2". Kodning av källa med en terminologi föredras där det är möjligt.</items><items id="description">Källan från vilken vätskan försvinner eller utsöndras. &#13;
</items><items id="text">Källa</items></items></term_definitions></component_ontologies><component_ontologies archetype_id="openEHR-EHR-OBSERVATION.laboratory_test_result.v1"><term_definitions language="ar-sy"><items code="at0000"><items id="description">*The result, including findings and interpretation, of a laboratory investigation performed on specimens from individuals or related materials(en)</items><items id="text">*Laboratory test result(en)</items></items><items code="at0001"><items id="description">*@ internal @(en)</items><items id="text">*Event Series(en)</items></items><items code="at0002"><items id="description">إحدى الوقائع</items><items id="text">إحدى الوقائع</items></items><items code="at0003"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0004"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0005"><items id="comment">*A test result may be for a single analyte, or a group of items, including panel tests. It is strongly recommended that 'Test name' be coded with a terminology, for example LOINC or SNOMED CT. For example: 'Glucose', 'Urea and Electrolytes', 'Swab', 'Cortisol (am)', 'Potassium in perspiration' or 'Melanoma histopathology'. The name may sometimes include specimen type and patient state, for example 'Fasting blood glucose' or include other information, as 'Potassium (PNA blood gas)'. (en)</items><items id="description">*Name of the laboratory investigation performed on the specimen(s). (en)</items><items id="text">*Test name(en)</items></items><items code="at0017"><items id="comment">*This slot is intended to carry details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.&#13;
&#13;
The receiving laboratory may either perform the test or refer it to another laboratory. Where a different laboratory is responsible for performing the testing on specific analytes, it would be expected that these details would be carried in the 'Analyte result detail' SLOT within the CLUSTER.laboratory_test_analyte archetype.&#13;
&#13;
 (en)</items><items id="description">*Details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.(en)</items><items id="text">*Receiving laboratory(en)</items></items><items code="at0035"><items id="comment">*The 'Distribution list' is for information-only, and that the primary recipient of the report is the person intended to act on the information.(en)</items><items id="description">*Details of additional clinicians or organisations who require a copy of the test result.(en)</items><items id="text">*Distribution list(en)</items></items><items code="at0037"><items id="description">*This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.(en)</items><items id="text">*Partial(en)</items></items><items code="at0038"><items id="description">*The Test result is complete and verified by an authorised person.(en)</items><items id="text">*Final(en)</items></items><items code="at0040"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist, and result data has been changed.(en)</items><items id="text">*Amended(en)</items></items><items code="at0057"><items id="comment">*For example: 'Pattern suggests significant renal impairment'. The content of the conclusion will vary, depending on the investigation performed. This conclusion should be aligned with the coded 'Test diagnosis'. (en)</items><items id="description">*Narrative description of the key findings. (en)</items><items id="fhir_mapping">*DiagnosticReport.conclusion(en)</items><items id="text">*Conclusion(en)</items></items><items code="at0062"><items id="comment">*Equivalent to the HL7 Placer Order Identifier.(en)</items><items id="description">*The local ID assigned to the test order by the order requester.(en)</items><items id="text">*Requester Order Identifier(en)</items></items><items code="at0063"><items id="comment">*Assigning an identifier to a request by the Laboratory lnformation System (LIS) enables tracking progress of the request and enables linking results to requests. It also provides a reference to assist with enquiries and it is usually equivalent to the HL7 Filler Order Identifier.(en)</items><items id="description">*The local ID assigned to the test order by the order filler, usually by the Laboratory Information System (LIS).(en)</items><items id="text">*Receiver Order Identifier(en)</items></items><items code="at0065"><items id="comment">*If the specimen type is sufficiently specified with a code in the Test name, then this additional data is not required. If there are multiple specimens, these may be represented per 'Result group'.(en)</items><items id="description">*Details about the physical substance that has been analysed, in the situation where all results in this test are derived from the same specimen.(en)</items><items id="text">*Specimen detail(en)</items></items><items code="at0068"><items id="comment">*This identifier is an internal tracking number assigned by the LIS, and it not intended to be the name of the test. (en)</items><items id="description">*A local identifier assigned by the receiving Laboratory Information System (LIS) to track the test process. (en)</items><items id="text">*Laboratory internal identifier(en)</items></items><items code="at0073"><items id="comment">*The values have been specifically chosen to match those in the HL7 FHIR Diagnostic report, historically derived from HL7v2 practice. Other local codes/terms can be used via the Text 'choice'.&#13;
&#13;
This element is multiple occurrence to cater for the use cases where statuses for different aspects of the result have been split into several elements. (en)</items><items id="description">*The status of the laboratory test result as a whole.(en)</items><items id="text">*Overall test status(en)</items></items><items code="at0074"><items id="description">*The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').(en)</items><items id="text">*Cancelled(en)</items></items><items code="at0075"><items id="description">*The date and/or time that ‘Overall test status’ was issued.(en)</items><items id="text">*Overall test status timestamp(en)</items></items><items code="at0077"><items id="comment">*This is intended to be a general categorisation and not to capture the organisational name of the laboratory. For example: anatomical pathology, immunology and transfusion medicine, medical microbiology, clinical pharmacology, medical genetics, medical biochemistry. Alternatively more granular sub categories or sub disciplines, such as endocrinology, haematology, and allergology services, may be used. This may assist clinicians in filtering between categories of results. Coding with a terminology is desirable, where possible.  (en)</items><items id="description">*The diagnostic service or discipline that is responsible for the laboratory test result. (en)</items><items id="text">*Diagnostic service category(en)</items></items><items code="at0090"><items id="description">*Details of the clinician or organisation requesting the laboratory test result.(en)</items><items id="text">*Requester(en)</items></items><items code="at0094"><items id="comment">*In most situations there is one test request and a single corresponding test result, however this repeating cluster allows for the situation where there may be multiple test requests reported using a single test result. As an example: 'a clinician asks for blood glucose in one request and Urea/electrolytes in a second request, but the lab analyser does both and the lab wishes to report these together'.(en)</items><items id="description">*Details about the test request.(en)</items><items id="text">*Test request details(en)</items></items><items code="at0097"><items id="comment">*This SLOT may carry an individual analyte, a group, panel or battery of multiple analytes, or a more complex and specific structure. (en)</items><items id="description">*Results of the test performed on the specimen(s). (en)</items><items id="text">*Test result (en)</items></items><items code="at0098"><items id="comment">*For example: 'Severe hepatic impairment', 'Salmonella contamination'. Coding of the diagnosis with a terminology is strongly recommended, where possible. This diagnosis should be aligned with the narrative in the 'Conclusion'. (en)</items><items id="description">*Single word, phrase or brief description that represents the clinical meaning and significance of the laboratory test result. (en)</items><items id="text">*Test diagnosis(en)</items></items><items code="at0100"><items id="comment">*This data element may include a link to the original clinical information provided in the test request.(en)</items><items id="description">*Description of clinical information available at the time of interpretation of results.(en)</items><items id="fhir_mapping">*DiagnosticReport.requestDetail.clinicalNotes(en)</items><items id="text">*Clinical information provided(en)</items></items><items code="at0101"><items id="description">*Additional narrative about the test result not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0106"><items id="comment">*This data element is to be used when the test requested differs from the test actually performed by the laboratory. (en)</items><items id="description">*Name of the original laboratory test requested. (en)</items><items id="text">*Original test requested name(en)</items></items><items code="at0107"><items id="description">*The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.(en)</items><items id="text">*Registered(en)</items></items><items code="at0110"><items id="comment">*For example: 'details of ELISA/nephelometry'.(en)</items><items id="description">*Structured details about the method of analysis, device or interpretation used.(en)</items><items id="text">*Testing details (en)</items></items><items code="at0111"><items id="comment">*True if the test was performed directly at Point-of-Care (POCT).(en)</items><items id="description">*This indicates whether the test was performed directly at Point-of-Care (POCT) as opposed to a formal result from a laboratory or other service delivery organisation.(en)</items><items id="text">*Point-of-care test(en)</items></items><items code="at0112"><items id="description">*@ internal @(en)</items><items id="text">*Tree(en)</items></items><items code="at0113"><items id="comment">*'Confounding factors' should be reserved for uncontrolled/unplanned issues of patient state/physiology that might affect interpretation, for example 'recent exercise' or 'recent tobacco smoking'.&#13;
&#13;
Known or required preconditions, such as 'fasting' should be carried in the 'Sampling conditions' element within the CLUSTER.specimen archetype . In some cases preconditions are captured as part of the test name, for example 'Fasting blood glucose'.&#13;
&#13;
Known issues with specimen collection or handling, such as 'prolonged use of tourniquet' or 'sample haemolysed', should be carried in the 'Specimen quality' elements within CLUSTER.specimen archetype.&#13;
&#13;
Coding with a terminology is desirable, where possible.  (en)</items><items id="description">*Issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0114"><items id="comment">*For example: Last Normal Menstrual Period (LNMP). (en)</items><items id="description">*Details of patient state that may alter interpretation of the laboratory test.(en)</items><items id="text">*Structured confounding factors (en)</items></items><items code="at0115"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist. This is a sub-category of 'Amended'.(en)</items><items id="text">*Corrected(en)</items></items><items code="at0116"><items id="description">*The Test Result has been withdrawn following previous Final release.(en)</items><items id="text">*Entered in error(en)</items></items><items code="at0117"><items id="description">*Slot to allow extension to support localisation or alignment with other standards/ reference models.(en)</items><items id="text">*Extension(en)</items></items><items code="at0118"><items id="comment">*Multiple formats are allowed but they should represent equivalent clinical content.(en)</items><items id="description">*Digital image, video or diagram representing the test result.(en)</items><items id="fhir_mapping">*DiagnosticReport.presentedForm(en)</items><items id="text">*Multimedia representation(en)</items></items><items code="at0119"><items id="description">*Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.(en)</items><items id="text">*Appended(en)</items></items><items code="at0120"><items id="description">*Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.(en)</items><items id="text">*Preliminary(en)</items></items><items code="at0121"><items id="comment">*Coding with a terminology is desirable, where possible.  (en)</items><items id="description">*</items><items id="text">*Test method (en)</items></items><items code="at0122"><items id="comment">*For example: Anatomical pathology diagnoses consisting of several different axes such as morphology, etiology and function. (en)</items><items id="description">*A structured or complex diagnosis for the laboratory test. (en)</items><items id="text">*Structured test diagnosis (en)</items></items></term_definitions><term_definitions language="ca"><items code="at0000"><items id="description">El resultat, incloses les conclusions i la interpretació del laboratori, d'una investigació realitzada amb mostres recollides o relacionades amb una persona.</items><items id="text">Resultat de proves de laboratori</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Esdeveniment predeterminat, no especificat, en un punt del temps o interval que es pot definir explícitament en una plantilla o en temps d'execució.</items><items id="text">Qualsevol esdeveniment</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">El resultat d'una prova pot correspondre a un únic analit o grup d'elements, incloses les proves de panell. Es recomana que "Nom de la prova" es codifiqui amb una terminologia, per exemple LOINC o SNOMED CT. Per exemple: "Glucosa", "Urea i electròlits", "Hisop", "Cortisol (am)", "Potasi en la transpiració" o "Histopatologia del melanoma". El nom pot incloure de vegades el tipus de mostra i l'estat del pacient, per exemple 'Glucosa en sang en dejú' o incloure una altra informació, com 'Potasi (gasometria PNA)'.</items><items id="description">Nom de la investigació de laboratori realitzada a la(es) mostra(s).</items><items id="text">Nom de la prova</items></items><items code="at0017"><items id="comment">Aquest slot està destinat a portar les dades del laboratori que va rebre la sol·licitud i té la responsabilitat general de gestionar la notificació de la prova, encara que altres laboratoris facin aspectes específics.&#13;
&#13;
El laboratori receptor pot fer la prova o remetre-la a un altre laboratori. En cas que un laboratori diferent sigui responsable de fer les proves d'analits específics, s'espera que aquestes dades s'incloguin a l'slot "Detall del resultat de l'analit" de l'arquetip CLUSTER.laboratory_test_analyte.</items><items id="description">Dades del laboratori que ha rebut la sol·licitud i té la responsabilitat general de gestionar la notificació de la prova, encara que altres laboratoris facin aspectes específics.</items><items id="text">Laboratori receptor</items></items><items code="at0035"><items id="comment">La "Llista de distribució" és merament informativa i el destinatari principal de l'informe és la persona destinada a actuar en funció de la informació.</items><items id="description">Detalls de metges o organitzacions addicionals que requereixen una còpia del resultat de la prova.</items><items id="text">Llista de distribució</items></items><items code="at0037"><items id="description">És un resultat parcial (per exemple, inicial, provisional o preliminar): les dades del resultat poden estar incomplets o sense verificar.</items><items id="text">Parcial</items></items><items code="at0038"><items id="description">El resultat de la prova és complet i ha estat verificat per una persona autoritzada.</items><items id="text">Definitiu</items></items><items code="at0040"><items id="description">El resultat ha estat modificat amb posterioritat a ser definitiu, i està complet i verificat pel patòleg responsable, i les dades del resultat han estat modificades.</items><items id="text">Modificat</items></items><items code="at0057"><items id="comment">Per exemple: “El patró suggereix una insuficiència renal significativa”. El contingut de la conclusió variarà en funció de la investigació realitzada. Aquesta conclusió ha de coincidir amb el “Diagnòstic de la prova” codificat.</items><items id="description">Descripció narrativa de les conclusions principals.</items><items id="text">Conclusió</items></items><items code="at0062"><items id="comment">Equivalent al Dipòsit d'identificador d'ordre d'HL7.</items><items id="description">L'identificador local assignat pel sistema clínic sol·licitant.</items><items id="text">Identificador de la comanda del sol·licitant</items></items><items code="at0063"><items id="comment">L'assignació d'un identificador a una sol·licitud per part del Sistema d'Informació de Laboratori (SIL) permet seguir el progrés de la sol·licitud i relacionar els resultats amb les sol·licituds. També proporciona una referència per ajudar amb les consultes i sol ser equivalent a l'identificador HL7 Filler Order Identifier.</items><items id="description">L'identificador local assignat a l'ordre de prova per l'emplenador de l'ordre, normalment pel Sistema d'Informació del Laboratori (SIL).</items><items id="text">Identificador de l'ordre del receptor</items></items><items code="at0065"><items id="comment">Si el tipus de mostra està suficientment especificat amb un codi al nom de la prova, aquestes dades addicionals no són necessàries. La vinculació dels resultats a mostres específiques es pot registrar utilitzant elements de "Identificador de mostra" tant a CLUSTER.specimen com als diferents arquetips CLUSTER de resultats.</items><items id="description">Detalls sobre la substància física analitzada.</items><items id="text">Detalls de la mostra</items></items><items code="at0068"><items id="comment">Aquest identificador és un número de seguiment intern assignat pel SIL, i no vol ser el nom de la prova.</items><items id="description">Identificador local assignat pel sistema d'informació del laboratori receptor (SIL) per seguir el procés de la prova.</items><items id="text">Identificador intern del laboratori</items></items><items code="at0073"><items id="comment">Els valors han estat escollits específicament perquè coincideixin amb els de l'informe HL7 FHIR Diagnostic, derivats històricament de la pràctica HL7v2. Poden utilitzar altres codis/termes locals mitjançant el text "choice".&#13;
&#13;
Aquest element és de ocurrència múltiple per atendre els casos d'ús en què els estats per a diferents aspectes del resultat s'han dividit en diversos elements.</items><items id="description">L'estat del resultat de la prova de laboratori en conjunt.</items><items id="text">Estat general de les proves</items></items><items code="at0074"><items id="description">El resultat no està disponible perquè la prova no s'ha iniciat o no s'ha completat (de vegades també s'anomena “avortada”).</items><items id="text">Cancel·lat</items></items><items code="at0075"><items id="description">La data i/o hora en què es va emetre l'estat general de les proves.</items><items id="text">Registre de temps de l'estat general de la prova</items></items><items code="at0077"><items id="comment">És una categorització general i no del nom organitzatiu del laboratori. Per exemple: anatomia patològica, immunologia i medicina transfusional, microbiologia mèdica, farmacologia clínica, genètica mèdica, bioquímica mèdica. També es poden utilitzar subcategories o subdisciplines més granulars, com ara endocrinologia, hematologia i serveis d'al·lergologia. Això pot ajudar els clínics a filtrar entre categories de resultats. Sempre que sigui possible, és desitjable codificar amb una terminologia.</items><items id="description">El servei o la disciplina de diagnòstic responsable del resultat de la prova de laboratori.</items><items id="text">Especialitat mèdica/clínica</items></items><items code="at0090"><items id="description">Detalls del metge o organització que sol·licita el resultat de la prova de laboratori.</items><items id="text">Sol·licitant</items></items><items code="at0094"><items id="comment">En la majoria de situacions hi ha una sol·licitud de prova i un únic resultat de prova corresponent, però, aquest grup de repetició permet la situació en què hi pot haver diverses sol·licituds de prova notificades utilitzant un únic resultat de prova.&#13;
&#13;
Per exemple: "un clínic sol·licita glucosa en sang en una petició i urea/electròlits en una segona petició, però el tècnic del laboratori realitza totes dues i el laboratori vol notificar-les juntes".</items><items id="description">Detalls sobre la sol·licitud de la prova.</items><items id="text">Detalls de la sol·licitud de la prova</items></items><items code="at0097"><items id="comment">Aquest SLOT pot transportar un analit individual, un grup, panell o bateria de múltiples analits, o una estructura més complexa i específica.</items><items id="description">Resultats de la prova realitzada a la(es) mostra(s).</items><items id="text">Resultat de la prova</items></items><items code="at0098"><items id="comment">Per exemple: 'Insuficiència hepàtica greu', 'Contaminació per Salmonella'. Es recomana encaridament codificar el diagnòstic amb una terminologia, sempre que sigui possible. Aquest diagnòstic ha d'estar alineat amb la informació registrada a la 'Conclusió'.</items><items id="description">Paraula única, frase o breu descripció que representa el significat clínic i la importància del resultat de la prova de laboratori.</items><items id="text">Dignòstic de la prova</items></items><items code="at0100"><items id="comment">Aquest element de dades pot incloure un enllaç a la informació clínica original facilitada a la sol·licitud de prova.</items><items id="description">Descripció de la informació clínica disponible al moment de la interpretació dels resultats.</items><items id="text">Informació clínica facilitada</items></items><items code="at0101"><items id="description">Informació addicional sobre el resultat de la prova no recollida a altres camps.</items><items id="text">Comentaris</items></items><items code="at0106"><items id="comment">Aquesta dada s'utilitza quan la prova sol·licitada difereixi de la prova realment realitzada pel laboratori.</items><items id="description">Nom de la prova de laboratori original sol·licitada.</items><items id="text">Nom de la prova original sol·licitada</items></items><items code="at0107"><items id="description">L'existència de la prova està registrada al Sistema d'Informació del Laboratori, però encara no hi ha res disponible.</items><items id="text">Registrat</items></items><items code="at0110"><items id="comment">Per exemple: 'detalls d'ELISA/nefelometria'.</items><items id="description">Detalls estructurats sobre el mètode danàlisi, dispositiu o interpretació utilitzat.</items><items id="text">Detalls de la prova</items></items><items code="at0111"><items id="comment">'Verdadero' si la prova es va realitzar directament al punt d'atenció.</items><items id="description">Indica si la prova es va fer directament al punt d'atenció (POCT), en contraposició a un resultat formal d'un laboratori o una altra organització de prestació de serveis.</items><items id="text">Prova al punt d'atenció sanitària</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">Els "factors de confusió" s'han de reservar per a qüestions no controlades/no planificades de l'estat/fisiologia del pacient que puguin afectar la interpretació, per exemple "exercici recent" o "tabaquisme recent".&#13;
&#13;
Les condicions prèvies conegudes o requerides, com "dejuni", s'han d'incloure a l'element "Condicions de mostreig" de l'arquetip CLUSTER.specimen. En alguns casos, les condicions prèvies formen part del nom de la prova, per exemple "Glucosa en sang en dejú".&#13;
&#13;
Els problemes coneguts de recollida o manipulació de mostres, com "ús prolongat de torniquet" o "mostra hemolitzada", s'han d'incloure als elements "Qualitat de la mostra" de l'arquetip CLUSTER.specimen.&#13;
&#13;
Sempre que sigui possible, és desitjable codificar amb una terminologia.</items><items id="description">Qüestions o circumstàncies que influeixen en la interpretació exacta del mesurament o del resultat de la prova.</items><items id="text">Factors de confusió</items></items><items code="at0114"><items id="comment">Per exemple: Última menstruació normal (LNMP).</items><items id="description">Detalls dels problemes o circumstàncies que influeixen en la interpretació exacta de la mesura o del resultat de l'assaig.</items><items id="text">Factors de confusió estructurats</items></items><items code="at0115"><items id="description">El resultat ha estat modificat amb posterioritat a ser definitiu, i està complet i verificat pel patòleg responsable. Es tracta d'una subcategoria de "modificat".</items><items id="text">Corregit</items></items><items code="at0116"><items id="description">El resultat de la prova ha estat retirat després de la publicació final anterior.</items><items id="text">Afegit per error</items></items><items code="at0117"><items id="comment">Per exemple: requisits locals d'informació o metadades addicionals per alinear-se amb els equivalents de FHIR o CIMI.</items><items id="description">Informació addicional necessària per captar el contingut local o per alinear-se amb altres models/formalismes de referència.</items><items id="text">Ampliació</items></items><items code="at0118"><items id="comment">Es permeten múltiples formats, però han de representar continguts clínics equivalents.</items><items id="description">Imatge digital, vídeo o diagrama que representa el resultat de la prova.</items><items id="text">Representació multimèdia</items></items><items code="at0119"><items id="description">Després de ser definitiu, l'informe s'ha modificat afegint-hi continguts nous. No s'ha modificat el contingut existent. Es tracta d'una subcategoria de "modificat".</items><items id="text">Annex</items></items><items code="at0120"><items id="description">Es disposen de resultats preliminars verificats, però no tots els resultats són definitius. Es tracta d'una subcategoria de “Parcial”.</items><items id="text">Preliminar</items></items><items code="at0121"><items id="comment">Sempre que sigui possible, és desitjable codificar amb una terminologia.</items><items id="description">Descripció sobre el mètode utilitzat per fer la prova.</items><items id="text">Mètode de prova</items></items><items code="at0122"><items id="comment">Per exemple: Diagnòstics anatomopatològics que consten de diversos eixos diferents, com ara la morfologia, l'etiologia i la funció.</items><items id="description">Un diagnòstic estructurat o complex per a la prova de laboratori.</items><items id="text">Diagnòstic de prova estructurat</items></items></term_definitions><term_definitions language="de"><items code="at0000"><items id="description">Das Ergebnis - einschließlich der Befunde und der Interpretation des Labors - einer Untersuchung, die an Proben durchgeführt wurde, die von einer Einzelperson stammen oder mit dieser Person zusammenhängen.</items><items id="text">Laborergebnis</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Jeder Zeitpunkt oder jedes Intervall, das in einem Template oder zur Laufzeit definiert werden kann.</items><items id="text">Jedes Ereignis</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">Ein Laborergebnis kann sich auf ein einzelnes Analyt oder eine Analytgruppe beziehen. Dazu zählen auch komplette Panel an Parametern. &#13;
Es wird dringend empfohlen, die "Labortest-Bezeichnung" anhand einer Terminologie zu kodiereren, wie zum Beispiel LOINC oder SNOMED CT. Beispiel: "Glukose", "Harnstoff", "Abstrich", "Cortisol", "Leberbiopsie". Der Name kann u.U. auch das Probenmaterial oder den Patientenstatus (z.B. "Blutzuckerspiegel nüchtern") oder andere Informationen beinhalten wie "Kalium (Blutgas)".</items><items id="description">Name der Laboruntersuchung, die an der/den Probe(n) durchgeführt wurde.</items><items id="text">Labortest-Bezeichnung</items></items><items code="at0017"><items id="comment">Dieser Slot gibt die Details des Labors an, dass die Anforderung erhalten hat und die Gesamtverantwortung für die Berichterstellung des Tests trägt, selbst wenn andere Labore bestimmte Aspekte ausführen.&#13;
&#13;
Das Empfangslabor kann den Test entweder durchführen oder an ein anderes Labor verweisen. Wenn ein anderes Labor für die Durchführung der Tests mit bestimmten Analyten zuständig ist, ist zu erwarten, dass diese Details im SLOT 'Analyte result detail' innerhalb des Archetyps CLUSTER.laboratory_test_analyte enthalten sind.</items><items id="description">Angaben zu dem Labor, das die Anfrage erhalten hat und die Hauptverantwortung für die Verwaltung der Berichterstattung über den Test trägt, auch wenn andere Labore bestimmte Aspekte ausführen.</items><items id="text">Labor, welches den Untersuchungsauftrag annimmt</items></items><items code="at0035"><items id="comment">Die "Verteilerliste" dient nur zu Informationszwecken. Der Hauptempfänger des Berichts ist die Person, die dazu bestimmt ist, auf die Information zu reagieren.</items><items id="description">Details über weitere Kliniker oder Organisationen, die eine Kopie der Analyseergebnisse benötigen.</items><items id="text">Verteilerliste</items></items><items code="at0037"><items id="description">Das Testergebnis ist als ein Teilergebnis (z.B. Initial, vorübergehend oder vorläufig) bestätigt: Daten im Testergebnis können unvollständig oder nicht verifiziert sein.</items><items id="text">Teilweise</items></items><items code="at0038"><items id="description">Das Testergebnis ist vollständig und durch eine autorisierte Person bestätigt.</items><items id="text">Final</items></items><items code="at0040"><items id="description">Das Ergebnis wurde nach der Finalisierung modifiziert und ist vollständig von dem verantwortlichen Untersucher verifiziert. Die Ergebnisdaten wurden geändert.</items><items id="text">Abgeändert</items></items><items code="at0057"><items id="comment">Zum Beispiel: "Das Muster lässt auf eine erhebliche Nierenfunktionsstörung schließen". Der Inhalt der Zusammenfassung unterscheidet sich je nach durchgeführter Untersuchung. Diese Zusammenfassung sollte mit der kodierten "Testdiagnose" übereinstimmen.</items><items id="description">Beschreibung der wichtigsten Ergebnisse.</items><items id="text">Schlussfolgerung</items></items><items code="at0062"><items id="comment">Äquivalent zur "HL7 Placer Order Identifier".</items><items id="description">Lokale Auftrags-ID des anfordernden/einsendenden Systems.</items><items id="text">Auftrags-ID des anfordernden/einsendenden Systems</items></items><items code="at0063"><items id="comment">Die Vergabe einer solchen ID ermöglicht das Nachverfolgen des Auftragsstatus und das Verlinken der Ergebnisse zum Auftrag. Es erlaubt auch das Verwalten von weiteren Erkundigungen und Nachfragen und ist äquivalent zum "HL7 Filler Order Identifier".</items><items id="description">Lokale Auftrags-ID, die vom auftragsempfangendem System, gewöhnlich dem Laborinformationssystem (LIS) zugewiesen wird.</items><items id="text">Auftrags-ID (Empfänger)</items></items><items code="at0065"><items id="comment">Wenn der Probentyp mit einem Code in der Testbezeichnung ausreichend spezifiziert ist, sind diese zusätzlichen Daten nicht erforderlich. Die Verknüpfung von Ergebnissen mit bestimmten Proben kann sowohl in einem CLUSTER.Probe als auch in den verschiedenen CLUSTER Archetypen mit Hilfe von Elementen mit der Bezeichnung "Probe" dokumentiert werden.&#13;
</items><items id="description">Angaben über die Beschaffenheit der analysierten Probe.</items><items id="text">Probendetail</items></items><items code="at0068"><items id="comment">Diese Kennung ist eine vom LIS vergebene interne Trackingnummer und ist nicht als Bezeichnung für den Test gedacht.</items><items id="description">Eine lokale Kennung, die vom empfangenden Laborinformationssystem (LIS) vergeben wird, um den Testvorgang zu verfolgen.</items><items id="text">Laborinterne Kennzeichnung</items></items><items code="at0073"><items id="comment">Die Werte wurden so ausgewählt, dass sie mit denen im HL7 FHIR Diagnosebericht übereinstimmen, der historisch aus der HL7v2Praxis stammt. Andere lokale Codes/Begriffe können über den Text "Auswahl" verwendet werden. &#13;
&#13;
Dieses Element kann mehrfach vorkommen, um Fälle abzudecken, bei denen der Status für verschiedene Aspekte des Ergebnisses in mehrere Elemente unterteilt wurde.&#13;
</items><items id="description">Der Status des gesamten Laborprüfergebnisses.</items><items id="text">Gesamtteststatus</items></items><items code="at0074"><items id="description">Das Ergebnis ist nicht verfügbar, weil der Test nicht gestartet oder nicht abgeschlossen wurde (manchmal auch als "gescheitert" bezeichnet).</items><items id="text">Abgebrochen</items></items><items code="at0075"><items id="description">Zeitpunkt an dem das Ergebnis für den oben genannten "Gesamtteststatus" ausgegeben wurde.</items><items id="text">Zeitstempel des gesamten Teststatus</items></items><items code="at0077"><items id="comment">Dies soll eine allgemeine Kategorisierung sein und nicht den organisatorischen Namen des Labors erfassen. Zum Beispiel anatomische Pathologie, Immunologie und Transfusionsmedizin, medizinische Mikrobiologie, klinische Pharmakologie, medizinische Genetik, medizinische Biochemie. Alternativ noch granuläre Subkategorien, wie z.B. Hormone/Endokrinologie, Hämatologie, Autoantikörper, Allergologie. Diese Datenelemente helfen bei der Filterung nach breiten Kategorien von Ergebnissen gemäß den lokalen Gegebenheiten. Dieses Datenelement sollte, wenn möglich, mit einer Terminologie kodiert werden.</items><items id="description">Die diagnostische Organisationseinheit oder die Labordisziplin, die für das Laborergebnis verantwortlich ist.</items><items id="text">Diagnostische Organisationseinheit</items></items><items code="at0090"><items id="description">Details über den Kliniker oder die Abteilung, die das Labortestergebnis angefordert hat.</items><items id="text">Einsender</items></items><items code="at0094"><items id="comment">In den meisten Fällen gibt es eine Testanfrage und ein einzelnes entsprechendes Testergebnis. Jedoch ermöglicht dieser wiederholte Cluster die Situation, dass mehrere Testanfragen mit einem einzigen Testergebnis gemeldet werden können.&#13;
&#13;
Als Beispiel: "Ein Arzt fordert in einer Anfrage Blutzucker und in einer zweiten Anfrage Harnstoff/Elektrolyte an, aber das Laboranalysegerät führt beides durch und das Labor möchte diese zusammen melden".</items><items id="description">Details zur Testanforderung.</items><items id="text">Details der Testanforderung</items></items><items code="at0097"><items id="comment">Dieser SLOT kann einen einzelnen Analyt, eine Gruppe, ein Panel oder eine Reihe von mehreren Analyten oder eine komplexere und spezifischere Struktur tragen.</items><items id="description">Ergebnisse der durchgeführten Untersuchungen an der/den Probe(n).</items><items id="text">Testergebnis</items></items><items code="at0098"><items id="comment">Zum Beispiel: "Schwere hepatische Beeinträchtigung", "Salmonellenbefall". Die Kodierung der Diagnose mit einer Terminologie, wird nach Möglichkeit dringend empfohlen. Die Diagnose soll zu der Beschreibung im Datenelement "Zusammenfassung" passen.</items><items id="description">Kurze Beschreibung der klinischen Bedeutung und der Aussagekraft des Laborergebnisses.</items><items id="text">Testdiagnose</items></items><items code="at0100"><items id="comment">Dieses Datenelement kann einen Link zu den ursprünglichen klinischen Informationen enthalten, die in der Testanforderung angegeben sind.</items><items id="description">Beschreibung der klinischen Informationen, die zum Zeitpunkt der Auswertung der Ergebnisse verfügbar sind.</items><items id="text">Vorhandene klinische Information</items></items><items code="at0101"><items id="description">Weitere Informationen über das Laborergebnis, welche bisher nicht in den anderen Feldern erfasst wurden.</items><items id="text">Kommentar</items></items><items code="at0106"><items id="comment">Dieses Datenelement ist zu verwenden, wenn die angeforderte Testung von der tatsächlich vom Labor durchgeführten Testung abweicht.</items><items id="description">Name des ursprünglich angeforderten Tests.</items><items id="text">Originaler Name der angeforderten Testung</items></items><items code="at0107"><items id="description">Der Labortest wurde im Laborinformationssystem registriert, aber es ist derzeit noch nichts verfügbar.</items><items id="text">Registriert</items></items><items code="at0110"><items id="comment">Zum Beispiel: "Details der ELISA/Nephelometrie".</items><items id="description">Strukturierte Details über die beim Labortest verwendete Methodik, das Gerät oder die Auswertung.</items><items id="text">Test Details</items></items><items code="at0111"><items id="comment">Wahr, wenn der Test direkt am Point-of-Care (POCT) durchgeführt wurde.</items><items id="description">Dies gibt an, ob der Test direkt am Point-of-Care (POCT) durchgeführt wurde, im Gegensatz zu einem formalen Ergebnis eines Labors oder einer anderen Dienstleistungsorganisation.</items><items id="text">Point-of-care Test</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">"Störfaktoren", die die Interpretation beeinflussen könnten wie z.B. "kürzliches Training" oder "neuer Tabakkonsum" sollten für unkontrollierte/ungeplante Probleme des Patientenzustands/ der Physiologie vorgesehen werden.&#13;
&#13;
Bekannte oder erforderliche Voraussetzungen, wie z.B. "Fasten", sollten im Element "Probenbedingungen" innerhalb des CLUSTER.Probe-Archetyps aufgeführt werden. In einigen Fällen werden Voraussetzungen als Teil des Testnamens erfasst, z.B. "Nüchternblutzucker".&#13;
&#13;
Bekannte Schwierigkeiten bei der Probenentnahme oder -behandlung, wie z.B. die "verlängerte Anwendung von Tourniquet" oder "hämolysierte Probe", sollten in den Elementen "Probenqualität" innerhalb des CLUSTER.Probe-Archetyps aufgeführt werden.</items><items id="description">Probleme oder Umstände, die sich auf die genaue Interpretation der Messung oder des Testergebnisses auswirken.</items><items id="text">Störfaktoren</items></items><items code="at0114"><items id="comment">Zum Beispiel: Letzte normale Menstruationsperiode (LNMP).</items><items id="description">Einzelheiten zu Problemen oder Umständen, die sich auf die genaue Interpretation der Messung oder des Prüfergebnisses auswirken.</items><items id="text">Strukturierte Erfassung der Störfaktoren</items></items><items code="at0115"><items id="description">Das Ergebnis wurde nach der Finalisierung modifiziert und ist vollständig vom verantwortlichen Untersucher verifiziert. Dies ist eine Unterkategorie von "Abgeändert".</items><items id="text">Korrigiert</items></items><items code="at0116"><items id="description">Das Testergebnis wurde nach der vorherigen Endfreigabe zurückgezogen.</items><items id="text">Irrtümlich eingegeben</items></items><items code="at0117"><items id="comment">Zum Beispiel: Lokaler Informationsbedarf oder zusätzliche Metadaten, um ein Mapping auf FHIR oder CIMI Modelle zu ermöglichen.</items><items id="description">Weitere Informationen, die erforderlich sind, um lokale Inhalte abzubilden oder das Modell an andere Referenzmodelle anzupassen.</items><items id="text">Erweiterung</items></items><items code="at0118"><items id="comment">Mehrere Formate sind erlaubt - diese sollten aber einen äquivalenten klinischen Inhalt darstellen.</items><items id="description">Bild, Video oder Diagramm zur Visualisierung des Testergebnisses.</items><items id="text">Multimedia-Darstellung</items></items><items code="at0119"><items id="description">Nach der endgültigen Fassung wurde der Bericht durch Hinzufügen neuer Inhalte aktualisiert. Der bestehende Inhalt bleibt unverändert. Dies ist eine Unterkategorie von "Abgeändert".</items><items id="text">Hinzugefügt</items></items><items code="at0120"><items id="description">Es sind erste, bestätigte Ergebnisse verfügbar, aber nicht alle Ergebnisse sind final. Dies ist eine Unterkategorie von "Teilweise".</items><items id="text">Vorläufig</items></items><items code="at0121"><items id="comment">Wenn möglich, ist eine Kodierung mit einer Terminologie wünschenswert.</items><items id="description">Die Beschreibung der Methode, mit dem der Test durchgeführt wurde.</items><items id="text">Testmethode</items></items><items code="at0122"><items id="comment">Zum Beispiel: Anatomische Pathologiediagnosen, die aus mehreren verschiedenen Schwerpunkten wie Morphologie, Ätiologie und Funktion zusammengesetzt sind.</items><items id="description">Eine strukturierte oder komplexe Diagnose für die Laboruntersuchung.</items><items id="text">Strukturierte Testdiagnostik</items></items></term_definitions><term_definitions language="en"><items code="at0000"><items id="description">The result, including findings and the laboratory's interpretation, of an investigation performed on specimens collected from an individual or related to that individual.</items><items id="text">Laboratory test result</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items><items id="text">Any event</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">A test result may be for a single analyte, or a group of items, including panel tests. It is strongly recommended that 'Test name' be coded with a terminology, for example LOINC or SNOMED CT. For example: 'Glucose', 'Urea and Electrolytes', 'Swab', 'Cortisol (am)', 'Potassium in perspiration' or 'Melanoma histopathology'. The name may sometimes include specimen type and patient state, for example 'Fasting blood glucose' or include other information, as 'Potassium (PNA blood gas)'.</items><items id="description">Name of the laboratory investigation performed on the specimen(s).</items><items id="text">Test name</items></items><items code="at0017"><items id="comment">This slot is intended to carry details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.&#13;
&#13;
The receiving laboratory may either perform the test or refer it to another laboratory. Where a different laboratory is responsible for performing the testing on specific analytes, it would be expected that these details would be carried in the 'Analyte result detail' SLOT within the CLUSTER.laboratory_test_analyte archetype.&#13;
&#13;
</items><items id="description">Details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.</items><items id="text">Receiving laboratory</items></items><items code="at0035"><items id="comment">The 'Distribution list' is for information-only, and that the primary recipient of the report is the person intended to act on the information.</items><items id="description">Details of additional clinicians or organisations who require a copy of the test result.</items><items id="text">Distribution list</items></items><items code="at0037"><items id="description">This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.</items><items id="text">Partial</items></items><items code="at0038"><items id="description">The Test result is complete and verified by an authorised person.</items><items id="text">Final</items></items><items code="at0040"><items id="description">The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist, and result data has been changed.</items><items id="text">Amended</items></items><items code="at0057"><items id="comment">For example: 'Pattern suggests significant renal impairment'. The content of the conclusion will vary, depending on the investigation performed. This conclusion should be aligned with the coded 'Test diagnosis'.</items><items id="description">Narrative description of the key findings.</items><items id="text">Conclusion</items></items><items code="at0062"><items id="comment">Equivalent to the HL7 Placer Order Identifier.</items><items id="description">The local identifier assigned by the requesting clinical system.</items><items id="text">Requester order identifier</items></items><items code="at0063"><items id="comment">Assigning an identifier to a request by the Laboratory lnformation System (LIS) enables tracking progress of the request and enables linking results to requests. It also provides a reference to assist with enquiries and it is usually equivalent to the HL7 Filler Order Identifier.</items><items id="description">The local identifier assigned to the test order by the order filler, usually by the Laboratory Information System (LIS).</items><items id="text">Receiver order identifier</items></items><items code="at0065"><items id="comment">If the specimen type is sufficiently specified with a code in the Test name, then this additional data is not required. Linking results to specific specimens may be recorded using 'Specimen identifier' elements in both the CLUSTER.specimen and the various results CLUSTER archetypes.</items><items id="description">Details about the physical substance that has been analysed.</items><items id="text">Specimen detail</items></items><items code="at0068"><items id="comment">This identifier is an internal tracking number assigned by the LIS, and it not intended to be the name of the test.</items><items id="description">A local identifier assigned by the receiving Laboratory Information System (LIS) to track the test process.</items><items id="text">Laboratory internal identifier</items></items><items code="at0073"><items id="comment">The values have been specifically chosen to match those in the HL7 FHIR Diagnostic report, historically derived from HL7v2 practice. Other local codes/terms can be used via the Text 'choice'.&#13;
&#13;
This element is multiple occurrence to cater for the use cases where statuses for different aspects of the result have been split into several elements.</items><items id="description">The status of the laboratory test result as a whole.</items><items id="text">Overall test status</items></items><items code="at0074"><items id="description">The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').</items><items id="text">Cancelled</items></items><items code="at0075"><items id="description">The date and/or time that ‘Overall test status’ was issued.</items><items id="text">Overall test status timestamp</items></items><items code="at0077"><items id="comment">This is intended to be a general categorisation and not to capture the organisational name of the laboratory. For example: anatomical pathology, immunology and transfusion medicine, medical microbiology, clinical pharmacology, medical genetics, medical biochemistry. Alternatively more granular sub categories or sub disciplines, such as endocrinology, haematology, and allergology services, may be used. This may assist clinicians in filtering between categories of results. Coding with a terminology is desirable, where possible.</items><items id="description">The diagnostic service or discipline that is responsible for the laboratory test result.</items><items id="text">Diagnostic service category</items></items><items code="at0090"><items id="description">Details of the clinician or organisation requesting the laboratory test result.</items><items id="text">Requester</items></items><items code="at0094"><items id="comment">In most situations there is one test request and a single corresponding test result, however this repeating cluster allows for the situation where there may be multiple test requests reported using a single test result.&#13;
&#13;
As an example: 'a clinician asks for blood glucose in one request and Urea/electrolytes in a second request, but the lab analyser does both and the lab wishes to report these together'.</items><items id="description">Details about the test request.</items><items id="text">Test request details</items></items><items code="at0097"><items id="comment">This SLOT may carry an individual analyte, a group, panel or battery of multiple analytes, or a more complex and specific structure.</items><items id="description">Results of the test performed on the specimen(s).</items><items id="text">Test result</items></items><items code="at0098"><items id="comment">For example: 'Severe hepatic impairment', 'Salmonella contamination'. Coding of the diagnosis with a terminology is strongly recommended, where possible. This diagnosis should be aligned with the narrative in the 'Conclusion'.</items><items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the laboratory test result.</items><items id="text">Test diagnosis</items></items><items code="at0100"><items id="comment">This data element may include a link to the original clinical information provided in the test request.</items><items id="description">Description of clinical information available at the time of interpretation of results.</items><items id="text">Clinical information provided</items></items><items code="at0101"><items id="description">Additional narrative about the test result not captured in other fields.</items><items id="text">Comment</items></items><items code="at0106"><items id="comment">This data element is to be used when the test requested differs from the test actually performed by the laboratory.</items><items id="description">Name of the original laboratory test requested.</items><items id="text">Original test requested name</items></items><items code="at0107"><items id="description">The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.</items><items id="text">Registered</items></items><items code="at0110"><items id="comment">For example: 'details of ELISA/nephelometry'.</items><items id="description">Structured details about the method of analysis, device or interpretation used.</items><items id="text">Testing details</items></items><items code="at0111"><items id="comment">True if the test was performed directly at Point-of-Care (POCT).</items><items id="description">This indicates whether the test was performed directly at Point-of-Care (POCT) as opposed to a formal result from a laboratory or other service delivery organisation.</items><items id="text">Point-of-care test</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">'Confounding factors' should be reserved for uncontrolled/unplanned issues of patient state/physiology that might affect interpretation, for example 'recent exercise' or 'recent tobacco smoking'.&#13;
&#13;
Known or required preconditions, such as 'fasting' should be carried in the 'Sampling conditions' element within the CLUSTER.specimen archetype . In some cases preconditions are captured as part of the test name, for example 'Fasting blood glucose'.&#13;
&#13;
Known issues with specimen collection or handling, such as 'prolonged use of tourniquet' or 'sample haemolysed', should be carried in the 'Specimen quality' elements within CLUSTER.specimen archetype.&#13;
&#13;
Coding with a terminology is desirable, where possible.</items><items id="description">Issues or circumstances that impact on the accurate interpretation of the measurement or test result.</items><items id="text">Confounding factors</items></items><items code="at0114"><items id="comment">For example: Last Normal Menstrual Period (LNMP).</items><items id="description">Details of issues or circumstances that impact on the accurate interpretation of the measurement or test result.</items><items id="text">Structured confounding factors</items></items><items code="at0115"><items id="description">The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist. This is a sub-category of 'Amended'.</items><items id="text">Corrected</items></items><items code="at0116"><items id="description">The Test Result has been withdrawn following previous Final release.</items><items id="text">Entered in error</items></items><items code="at0117"><items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items><items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items><items id="text">Extension</items></items><items code="at0118"><items id="comment">Multiple formats are allowed but they should represent equivalent clinical content.</items><items id="description">Digital image, video or diagram representing the test result.</items><items id="text">Multimedia representation</items></items><items code="at0119"><items id="description">Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.</items><items id="text">Appended</items></items><items code="at0120"><items id="description">Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.</items><items id="text">Preliminary</items></items><items code="at0121"><items id="comment">Coding with a terminology is desirable, where possible.</items><items id="description">Description about the method used to perform the test.</items><items id="text">Test method</items></items><items code="at0122"><items id="comment">For example: Anatomical pathology diagnoses consisting of several different axes such as morphology, etiology and function.</items><items id="description">A structured or complex diagnosis for the laboratory test.</items><items id="text">Structured test diagnosis</items></items></term_definitions><term_definitions language="es"><items code="at0000"><items id="description">El resultado, incluidas las conclusiones y la interpretación del laboratorio, de una investigación realizada con muestras recogidas de una persona o relacionadas con ella.</items><items id="text">Resultado de pruebas de laboratorio</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Evento predeterminado, no especificado, en un punto del tiempo o intervalo que puede definirse explícitamente en una plantilla o en tiempo de ejecución.</items><items id="text">Cualquier evento</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">El resultado de una prueba puede corresponder a un único analito o a un grupo de elementos, incluidas las pruebas de panel. Se recomienda encarecidamente que "Nombre de la prueba" se codifique con una terminología, por ejemplo LOINC o SNOMED CT. Por ejemplo: "Glucosa", "Urea y electrolitos", "Hisopo", "Cortisol (am)", "Potasio en la transpiración" o "Histopatología del melanoma". El nombre puede incluir a veces el tipo de muestra y el estado del paciente, por ejemplo 'Glucosa en sangre en ayunas' o incluir otra información, como 'Potasio (gasometría PNA)'.</items><items id="description">Nombre de la investigación de laboratorio realizada en la(s) muestra(s).</items><items id="text">Nombre de la prueba</items></items><items code="at0017"><items id="comment">Este slot está destinado a llevar los datos del laboratorio que recibió la solicitud y tiene la responsabilidad general de gestionar la notificación de la prueba, aunque otros laboratorios realicen aspectos específicos.&#13;
&#13;
El laboratorio receptor puede realizar la prueba o remitirla a otro laboratorio. En caso de que un laboratorio diferente sea responsable de realizar las pruebas de analitos específicos, se espera que estos datos se incluyan en el slot "Detalle del resultado del analito" del arquetipo CLUSTER.laboratory_test_analyte.</items><items id="description">Datos del laboratorio que ha recibido la solicitud y tiene la responsabilidad general de gestionar la notificación de la prueba, aunque otros laboratorios realicen aspectos específicos.</items><items id="text">Laboratorio receptor</items></items><items code="at0035"><items id="comment">La "Lista de distribución" es meramente informativa, y el destinatario principal del informe es la persona destinada a actuar en función de la información.</items><items id="description">Datos de otros médicos u organizaciones que necesiten una copia del resultado de la prueba.</items><items id="text">Lista de distribución</items></items><items code="at0037"><items id="description">Se trata de un resultado parcial (por ejemplo, inicial, provisional o preliminar): los datos del resultado pueden estar incompletos o sin verificar.</items><items id="text">Parcial</items></items><items code="at0038"><items id="description">El resultado de la prueba está completo y ha sido verificado por una persona autorizada.</items><items id="text">Definitivo</items></items><items code="at0040"><items id="description">El resultado ha sido modificado con posterioridad a ser Definitivo, y está completo y verificado por el patólogo responsable, y los datos del resultado han sido modificados.</items><items id="text">Modificado</items></items><items code="at0057"><items id="comment">Por ejemplo: "El patrón sugiere una insuficiencia renal significativa". El contenido de la conclusión variará en función de la investigación realizada. Esta conclusión debe coincidir con el "Diagnóstico de la prueba" codificado.</items><items id="description">Descripción narrativa de las principales conclusiones.</items><items id="text">Conclusión</items></items><items code="at0062"><items id="comment">Equivalente al Depósito de Identificador de Orden de HL7.</items><items id="description">El identificador local asignado por el sistema clínico solicitante.</items><items id="text">Identificador del pedido del solicitante</items></items><items code="at0063"><items id="comment">La asignación de un identificador a una solicitud por parte del Sistema de Información de Laboratorio (SIL) permite seguir el progreso de la solicitud y relacionar los resultados con las solicitudes. También proporciona una referencia para ayudar con las consultas y suele ser equivalente al identificador HL7 Filler Order Identifier.</items><items id="description">El identificador local asignado a la orden de prueba por el cumplimentador de la orden, normalmente por el Sistema de Información del Laboratorio (SIL).</items><items id="text">Identificador de la orden del receptor</items></items><items code="at0065"><items id="comment">Si el tipo de muestra está suficientemente especificado con un código en el nombre de la prueba, estos datos adicionales no son necesarios. La vinculación de los resultados a muestras específicas puede registrarse utilizando elementos de "Identificador de muestra" tanto en CLUSTER.specimen como en los distintos arquetipos CLUSTER de resultados.</items><items id="description">Datos sobre la sustancia física analizada.</items><items id="text">Detalles de la muestra</items></items><items code="at0068"><items id="comment">Este identificador es un número de seguimiento interno asignado por el SIL, y no pretende ser el nombre de la prueba.</items><items id="description">Identificador local asignado por el Sistema de Información del Laboratorio receptor (SIL) para seguir el proceso de la prueba.</items><items id="text">Identificador interno del laboratorio</items></items><items code="at0073"><items id="comment">&#13;
Los valores se han elegido específicamente para que coincidan con los del informe HL7 FHIR Diagnostic, derivados históricamente de la práctica HL7v2. Pueden utilizarse otros códigos/términos locales mediante el texto "choice".&#13;
&#13;
Este elemento es de ocurrencia múltiple para atender a los casos de uso en los que los estados para diferentes aspectos del resultado se han dividido en varios elementos.</items><items id="description">El estado del resultado de la prueba de laboratorio en su conjunto.</items><items id="text">Estado general de las pruebas</items></items><items code="at0074"><items id="description">El resultado no está disponible porque la prueba no se ha iniciado o no se ha completado (a veces también se denomina "abortada").</items><items id="text">Cancelado</items></items><items code="at0075"><items id="description">La fecha y/o la hora en que se emitió el "Estado general de las pruebas".</items><items id="text">Registro de tiempo del estado general de la prueba</items></items><items code="at0077"><items id="comment">Se trata de una categorización general y no del nombre organizativo del laboratorio. Por ejemplo: anatomía patológica, inmunología y medicina transfusional, microbiología médica, farmacología clínica, genética médica, bioquímica médica. También pueden utilizarse subcategorías o subdisciplinas más granulares, como endocrinología, hematología y servicios de alergología. Esto puede ayudar a los clínicos a filtrar entre categorías de resultados. Siempre que sea posible, es deseable codificar con una terminología.</items><items id="description">El servicio o disciplina de diagnóstico responsable del resultado de la prueba de laboratorio.</items><items id="text">Especialidad médica/clínica</items></items><items code="at0090"><items id="description">Datos del clínico u organización que solicita el resultado de la prueba de laboratorio.</items><items id="text">Solicitante</items></items><items code="at0094"><items id="comment">En la mayoría de las situaciones hay una solicitud de prueba y un único resultado de prueba correspondiente, sin embargo, este grupo de repetición permite la situación en la que puede haber varias solicitudes de prueba notificadas utilizando un único resultado de prueba.&#13;
&#13;
Por ejemplo: "un clínico solicita glucosa en sangre en una petición y urea/electrolitos en una segunda petición, pero el técnico del laboratorio realiza ambas y el laboratorio desea notificarlas juntas".</items><items id="description">Detalles sobre la solicitud de la prueba.</items><items id="text">Detalles de la solicitud de la prueba</items></items><items code="at0097"><items id="comment">Este SLOT puede transportar un analito individual, un grupo, panel o batería de múltiples analitos, o una estructura más compleja y específica.</items><items id="description">Resultados de la prueba realizada en la(s) muestra(s).</items><items id="text">Resultado de la prueba</items></items><items code="at0098"><items id="comment">Por ejemplo: 'Insuficiencia hepática grave', 'Contaminación por Salmonella'. Se recomienda encarecidamente codificar el diagnóstico con una terminología, siempre que sea posible. Este diagnóstico debe estar alineado con la información registrada en la 'Conclusión'.</items><items id="description">Palabra única, frase o breve descripción que representa el significado clínico y la importancia del resultado de la prueba de laboratorio.</items><items id="text">Dignóstico de la prueba</items></items><items code="at0100"><items id="comment">Este elemento de datos puede incluir un enlace a la información clínica original facilitada en la solicitud de prueba.</items><items id="description">Descripción de la información clínica disponible en el momento de la interpretación de los resultados.</items><items id="text">Información clínica facilitada</items></items><items code="at0101"><items id="description">Información adicional sobre el resultado de la prueba no recogida en otros campos.</items><items id="text">Comentarios</items></items><items code="at0106"><items id="comment">Este dato se utilizará cuando la prueba solicitada difiera de la prueba realmente realizada por el laboratorio.</items><items id="description">Nombre de la prueba de laboratorio original solicitada.</items><items id="text">Nombre de la prueba original solicitada</items></items><items code="at0107"><items id="description">La existencia de la prueba está registrada en el Sistema de Información del Laboratorio, pero aún no hay nada disponible.</items><items id="text">Registrado</items></items><items code="at0110"><items id="comment">Por ejemplo: 'detalles de ELISA/nefelometría'.</items><items id="description">Detalles estructurados sobre el método de análisis, dispositivo o interpretación utilizado.</items><items id="text">Detalles de la prueba</items></items><items code="at0111"><items id="comment">Verdadero si la prueba se realizó directamente en el punto de atención (POCT).</items><items id="description">Indica si la prueba se realizó directamente en el punto de atención (POCT), en contraposición a un resultado formal de un laboratorio u otra organización de prestación de servicios.</items><items id="text">Prueba en el punto de atención sanitaria</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">Los "factores de confusión" deben reservarse para cuestiones no controladas/no planificadas del estado/fisiología del paciente que puedan afectar a la interpretación, por ejemplo "ejercicio reciente" o "tabaquismo reciente".&#13;
&#13;
Las condiciones previas conocidas o requeridas, como "ayuno", deben incluirse en el elemento "Condiciones de muestreo" del arquetipo CLUSTER.specimen. En algunos casos, las condiciones previas forman parte del nombre de la prueba, por ejemplo "Glucosa en sangre en ayunas".&#13;
&#13;
Los problemas conocidos de recogida o manipulación de muestras, como "uso prolongado de torniquete" o "muestra hemolizada", deben incluirse en los elementos "Calidad de la muestra" del arquetipo CLUSTER.specimen.&#13;
&#13;
Siempre que sea posible, es deseable codificar con una terminología.</items><items id="description">Cuestiones o circunstancias que influyen en la interpretación exacta de la medición o del resultado de la prueba.</items><items id="text">Factores de confusión</items></items><items code="at0114"><items id="comment">Por ejemplo: Última menstruación normal (LNMP).</items><items id="description">Detalles de los problemas o circunstancias que influyen en la interpretación exacta de la medición o del resultado del ensayo.</items><items id="text">Factores de confusión estructurados</items></items><items code="at0115"><items id="description">El resultado ha sido modificado con posterioridad a ser Definitivo, y está completo y verificado por el patólogo responsable. Se trata de una subcategoría de "Modificado".</items><items id="text">Corregida</items></items><items code="at0116"><items id="description">El resultado de la prueba se ha retirado tras la publicación final anterior.</items><items id="text">Añadido por error</items></items><items code="at0117"><items id="comment">Por ejemplo: requisitos locales de información o metadatos adicionales para alinearse con los equivalentes de FHIR o CIMI.</items><items id="description">Información adicional necesaria para captar el contenido local o para alinearse con otros modelos/formalismos de referencia.</items><items id="text">Ampliación</items></items><items code="at0118"><items id="comment">Se permiten múltiples formatos, pero deben representar contenidos clínicos equivalentes.</items><items id="description">Imagen digital, vídeo o diagrama que representa el resultado de la prueba.</items><items id="text">Representación multimedia</items></items><items code="at0119"><items id="description">Tras ser definitivo, el informe se ha modificado añadiendo nuevos contenidos. El contenido existente no se ha modificado. Se trata de una subcategoría de "Modificado".</items><items id="text">Anexo</items></items><items code="at0120"><items id="description">Se dispone de resultados preliminares verificados, pero no todos los resultados son definitivos. Se trata de una subcategoría de "Parcial".</items><items id="text">Preliminar</items></items><items code="at0121"><items id="comment">En la medida de lo posible, es deseable codificar con una terminología.</items><items id="description">Descripción del método utilizado para realizar la prueba.</items><items id="text">Método de prueba</items></items><items code="at0122"><items id="comment">Por ejemplo: Diagnósticos anatomopatológicos que constan de varios ejes diferentes, como la morfología, la etiología y la función.</items><items id="description">Un diagnóstico estructurado o complejo para la prueba de laboratorio.</items><items id="text">Diagnóstico de prueba estructurado</items></items></term_definitions><term_definitions language="fi"><items code="at0000"><items id="description">*The result, including findings and the laboratory's interpretation, of an investigation performed on specimens collected from an individual or related to that individual.(en)</items><items id="text">Laboratoriokokeen tulos</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">Mikä tahansa tapahtuma</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">*A test result may be for a single analyte, or a group of items, including panel tests. It is strongly recommended that 'Test name' be coded with a terminology, for example LOINC or SNOMED CT. For example: 'Glucose', 'Urea and Electrolytes', 'Swab', 'Cortisol (am)', 'Potassium in perspiration' or 'Melanoma histopathology'. The name may sometimes include specimen type and patient state, for example 'Fasting blood glucose' or include other information, as 'Potassium (PNA blood gas)'.(en)</items><items id="description">*Name of the laboratory investigation performed on the specimen(s).(en)</items><items id="text">Tutkimusnimi</items></items><items code="at0017"><items id="comment">*This slot is intended to carry details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.&#13;
&#13;
The receiving laboratory may either perform the test or refer it to another laboratory. Where a different laboratory is responsible for performing the testing on specific analytes, it would be expected that these details would be carried in the 'Analyte result detail' SLOT within the CLUSTER.laboratory_test_analyte archetype.&#13;
&#13;
(en)</items><items id="description">*Details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.(en)</items><items id="text">*Receiving laboratory(en)</items></items><items code="at0035"><items id="comment">*The 'Distribution list' is for information-only, and that the primary recipient of the report is the person intended to act on the information.(en)</items><items id="description">*Details of additional clinicians or organisations who require a copy of the test result.(en)</items><items id="text">*Distribution list(en)</items></items><items code="at0037"><items id="description">*This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.(en)</items><items id="text">*Partial(en)</items></items><items code="at0038"><items id="description">*The Test result is complete and verified by an authorised person.(en)</items><items id="text">*Final(en)</items></items><items code="at0040"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist, and result data has been changed.(en)</items><items id="text">*Amended(en)</items></items><items code="at0057"><items id="comment">*For example: 'Pattern suggests significant renal impairment'. The content of the conclusion will vary, depending on the investigation performed. This conclusion should be aligned with the coded 'Test diagnosis'.(en)</items><items id="description">*Narrative description of the key findings.(en)</items><items id="text">*Conclusion(en)</items></items><items code="at0062"><items id="comment">*Equivalent to the HL7 Placer Order Identifier.(en)</items><items id="description">*The local identifier assigned by the requesting clinical system.(en)</items><items id="text">*Requester order identifier(en)</items></items><items code="at0063"><items id="comment">*Assigning an identifier to a request by the Laboratory lnformation System (LIS) enables tracking progress of the request and enables linking results to requests. It also provides a reference to assist with enquiries and it is usually equivalent to the HL7 Filler Order Identifier.(en)</items><items id="description">*The local identifier assigned to the test order by the order filler, usually by the Laboratory Information System (LIS).(en)</items><items id="text">*Receiver order identifier(en)</items></items><items code="at0065"><items id="comment">*If the specimen type is sufficiently specified with a code in the Test name, then this additional data is not required. Linking results to specific specimens may be recorded using 'Specimen identifier' elements in both the CLUSTER.specimen and the various results CLUSTER archetypes.(en)</items><items id="description">*Details about the physical substance that has been analysed.(en)</items><items id="text">*Specimen detail(en)</items></items><items code="at0068"><items id="comment">*This identifier is an internal tracking number assigned by the LIS, and it not intended to be the name of the test.(en)</items><items id="description">*A local identifier assigned by the receiving Laboratory Information System (LIS) to track the test process.(en)</items><items id="text">*Laboratory internal identifier(en)</items></items><items code="at0073"><items id="comment">*The values have been specifically chosen to match those in the HL7 FHIR Diagnostic report, historically derived from HL7v2 practice. Other local codes/terms can be used via the Text 'choice'.&#13;
&#13;
This element is multiple occurrence to cater for the use cases where statuses for different aspects of the result have been split into several elements.(en)</items><items id="description">*The status of the laboratory test result as a whole.(en)</items><items id="text">*Overall test status(en)</items></items><items code="at0074"><items id="description">*The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').(en)</items><items id="text">*Cancelled(en)</items></items><items code="at0075"><items id="description">*The date and/or time that ‘Overall test status’ was issued.(en)</items><items id="text">*Overall test status timestamp(en)</items></items><items code="at0077"><items id="comment">*This is intended to be a general categorisation and not to capture the organisational name of the laboratory. For example: anatomical pathology, immunology and transfusion medicine, medical microbiology, clinical pharmacology, medical genetics, medical biochemistry. Alternatively more granular sub categories or sub disciplines, such as endocrinology, haematology, and allergology services, may be used. This may assist clinicians in filtering between categories of results. Coding with a terminology is desirable, where possible.(en)</items><items id="description">*The diagnostic service or discipline that is responsible for the laboratory test result.(en)</items><items id="text">*Diagnostic service category(en)</items></items><items code="at0090"><items id="description">*Details of the clinician or organisation requesting the laboratory test result.(en)</items><items id="text">*Requester(en)</items></items><items code="at0094"><items id="comment">*In most situations there is one test request and a single corresponding test result, however this repeating cluster allows for the situation where there may be multiple test requests reported using a single test result.&#13;
&#13;
As an example: 'a clinician asks for blood glucose in one request and Urea/electrolytes in a second request, but the lab analyser does both and the lab wishes to report these together'.(en)</items><items id="description">*Details about the test request.(en)</items><items id="text">*Test request details(en)</items></items><items code="at0097"><items id="comment">*This SLOT may carry an individual analyte, a group, panel or battery of multiple analytes, or a more complex and specific structure.(en)</items><items id="description">*Results of the test performed on the specimen(s).(en)</items><items id="text">Tutkimustulos</items></items><items code="at0098"><items id="comment">*For example: 'Severe hepatic impairment', 'Salmonella contamination'. Coding of the diagnosis with a terminology is strongly recommended, where possible. This diagnosis should be aligned with the narrative in the 'Conclusion'.(en)</items><items id="description">*Single word, phrase or brief description that represents the clinical meaning and significance of the laboratory test result.(en)</items><items id="text">*Test diagnosis(en)</items></items><items code="at0100"><items id="comment">*This data element may include a link to the original clinical information provided in the test request.(en)</items><items id="description">*Description of clinical information available at the time of interpretation of results.(en)</items><items id="text">*Clinical information provided(en)</items></items><items code="at0101"><items id="description">*Additional narrative about the test result not captured in other fields.(en)</items><items id="text">Kommentti</items></items><items code="at0106"><items id="comment">*This data element is to be used when the test requested differs from the test actually performed by the laboratory.(en)</items><items id="description">*Name of the original laboratory test requested.(en)</items><items id="text">*Original test requested name(en)</items></items><items code="at0107"><items id="description">*The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.(en)</items><items id="text">*Registered(en)</items></items><items code="at0110"><items id="comment">*For example: 'details of ELISA/nephelometry'.(en)</items><items id="description">*Structured details about the method of analysis, device or interpretation used.(en)</items><items id="text">*Testing details(en)</items></items><items code="at0111"><items id="comment">*True if the test was performed directly at Point-of-Care (POCT).(en)</items><items id="description">*This indicates whether the test was performed directly at Point-of-Care (POCT) as opposed to a formal result from a laboratory or other service delivery organisation.(en)</items><items id="text">*Point-of-care test(en)</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">*'Confounding factors' should be reserved for uncontrolled/unplanned issues of patient state/physiology that might affect interpretation, for example 'recent exercise' or 'recent tobacco smoking'.&#13;
&#13;
Known or required preconditions, such as 'fasting' should be carried in the 'Sampling conditions' element within the CLUSTER.specimen archetype . In some cases preconditions are captured as part of the test name, for example 'Fasting blood glucose'.&#13;
&#13;
Known issues with specimen collection or handling, such as 'prolonged use of tourniquet' or 'sample haemolysed', should be carried in the 'Specimen quality' elements within CLUSTER.specimen archetype.&#13;
&#13;
Coding with a terminology is desirable, where possible.(en)</items><items id="description">*Issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">Haittaavat tekijät</items></items><items code="at0114"><items id="comment">*For example: Last Normal Menstrual Period (LNMP).(en)</items><items id="description">*Details of issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Structured confounding factors(en)</items></items><items code="at0115"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist. This is a sub-category of 'Amended'.(en)</items><items id="text">*Corrected(en)</items></items><items code="at0116"><items id="description">*The Test Result has been withdrawn following previous Final release.(en)</items><items id="text">*Entered in error(en)</items></items><items code="at0117"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0118"><items id="comment">*Multiple formats are allowed but they should represent equivalent clinical content.(en)</items><items id="description">*Digital image, video or diagram representing the test result.(en)</items><items id="text">*Multimedia representation(en)</items></items><items code="at0119"><items id="description">*Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.(en)</items><items id="text">*Appended(en)</items></items><items code="at0120"><items id="description">*Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.(en)</items><items id="text">*Preliminary(en)</items></items><items code="at0121"><items id="comment">*Coding with a terminology is desirable, where possible.(en)</items><items id="description">*Description about the method used to perform the test.(en)</items><items id="text">*Test method(en)</items></items><items code="at0122"><items id="comment">*For example: Anatomical pathology diagnoses consisting of several different axes such as morphology, etiology and function.(en)</items><items id="description">*A structured or complex diagnosis for the laboratory test.(en)</items><items id="text">*Structured test diagnosis(en)</items></items></term_definitions><term_definitions language="fr"><items code="at0000"><items id="description">Le résultat, y compris les conclusions et l'interprétation du laboratoire, d'un examen réalisé sur des échantillons prélevés sur une personne ou liés à celle-ci.</items><items id="text">Résultat d'un examen de laboratoire</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Par défaut, événement ponctuel ou d’intervalle non spécifié, pouvant être défini explicitement dans un template ou au moment de l’exécution.</items><items id="text">Tout événement</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">Un résultat d’analyse peut concerner un seul analyte ou un ensemble d’éléments, y compris des panels d’analyses. Il est fortement recommandé de coder le « nom de l’analyse » à l’aide d’une terminologie, par exemple LOINC ou SNOMED CT. Par exemple : « Glucose », « Urée et électrolytes », « Prélèvement par écouvillon », « Cortisol (matin) », « Potassium dans la transpiration » ou « Histopathologie du mélanome ». Le nom peut parfois inclure le type d’échantillon et l’état du patient, par exemple « Glycémie à jeun », ou comporter d’autres informations, comme « Potassium (gaz sanguin PNA) ».</items><items id="description">Nom de l'examen de laboratoire effectué sur le ou les échantillons.</items><items id="text">Nom de l'analyse</items></items><items code="at0017"><items id="comment">Ce slot est destiné à contenir les coordonnées du laboratoire qui a reçu la demande et qui assume la responsabilité globale de la gestion de la communication des résultats de l'analyse, même si d'autres laboratoires se chargent de certains aspects spécifiques.&#13;
&#13;
Le laboratoire destinataire peut soit réaliser l’examen lui-même, soit le transmettre à un autre laboratoire. Lorsqu’un autre laboratoire est chargé de réaliser les analyses portant sur des analytes spécifiques, ces informations devraient figurer dans le slot « Détails du résultat de l’analyte » de l’archétype CLUSTER.laboratory_test_analyte.</items><items id="description">Coordonnées du laboratoire qui a reçu la demande et qui assume la responsabilité globale de la gestion de la communication des résultats de l'examen, même si d'autres laboratoires se chargent de certains aspects spécifiques.</items><items id="text">Laboratoire destinataire</items></items><items code="at0035"><items id="comment">La « liste de diffusion » est fournie à titre indicatif uniquement, et le destinataire principal du rapport est la personne censée donner suite à ces informations.</items><items id="description">Coordonnées des autres professionnels de santé ou organismes devant recevoir une copie du résultat de l'examen.</items><items id="text">Liste de diffusion</items></items><items code="at0037"><items id="description">Il s'agit d'un résultat d'analyse partiel (par exemple, initial, intermédiaire ou préliminaire) : les données figurant dans ce résultat d'analyse peuvent être incomplètes ou non vérifiées.</items><items id="text">Partiel</items></items><items code="at0038"><items id="description">Le résultat de l'examen est complet et a été vérifié par une personne autorisée.</items><items id="text">Final</items></items><items code="at0040"><items id="description">Le résultat a été modifié après avoir été déclaré « définitif » ; il est complet et a été vérifié par le pathologue responsable, et les données du résultat ont été modifiées.</items><items id="text">Modifié</items></items><items code="at0057"><items id="comment">Par exemple : « Les résultats suggèrent une insuffisance rénale significative ». Le contenu de la conclusion variera en fonction de l'examen réalisé. Cette conclusion doit correspondre au « diagnostic d'examen » codé.</items><items id="description">Description narrative des principaux résultats.</items><items id="text">Conclusion</items></items><items code="at0062"><items id="comment">Équivalent à l'identifiant de demande « Placer » de la norme HL7.</items><items id="description">L'identifiant local attribué par le système clinique demandeur.</items><items id="text">Identifiant de la demande</items></items><items code="at0063"><items id="comment">L'attribution d'un identifiant à une demande par le système d'information de laboratoire (LIS) permet de suivre l'avancement de la demande et d'associer les résultats aux demandes. Il sert également de référence pour faciliter les demandes de renseignements et correspond généralement à l'identifiant de demande HL7 (Filler Order Identifier).</items><items id="description">Identifiant local attribué à la demande d'analyse par le responsable du traitement des demandes, généralement par le système d'information de laboratoire (LIS).</items><items id="text">Identifiant de la demande du destinataire</items></items><items code="at0065"><items id="comment">Si le type d’échantillon est suffisamment précisé par un code dans le nom de l'analyse, ces données supplémentaires ne sont pas requises. L’association des résultats à des échantillons spécifiques peut être enregistrée à l’aide des éléments « Identifiant de l’échantillon » tant dans l’archétype CLUSTER.specimen que dans les différents archétypes CLUSTER relatifs aux résultats.</items><items id="description">Informations détaillées sur la substance physique qui a été analysée.</items><items id="text">Détails de l'échantillon</items></items><items code="at0068"><items id="comment">Cet identifiant est un numéro de suivi interne attribué par le LIS ; il ne s'agit pas du nom de l'analyse.</items><items id="description">Identifiant local attribué par le système d'information de laboratoire (LIS) destinataire afin d'assurer le suivi du processus d'analyse.</items><items id="text">Identifiant interne du laboratoire</items></items><items code="at0073"><items id="comment">Les valeurs ont été spécifiquement choisies pour correspondre à celles du rapport diagnostique HL7 FHIR, issues historiquement de la norme HL7v2. D’autres codes ou termes locaux peuvent être utilisés via l’option « Texte ».&#13;
&#13;
Cet élément peut apparaître plusieurs fois afin de répondre aux cas d’utilisation où les statuts relatifs à différents aspects du résultat ont été répartis en plusieurs éléments.</items><items id="description">Statut global du résultat de l'analyse de laboratoire.</items><items id="text">Statut global de l'analyse</items></items><items code="at0074"><items id="description">Le résultat n'est pas disponible car le test n'a pas été lancé ou n'a pas été mené à terme (ce que l'on appelle parfois « test interrompu »).</items><items id="text">Annulé</items></items><items code="at0075"><items id="description">Date et/ou heure à laquelle le « Statut global de l'analyse » a été établi.</items><items id="text">Horodatage du statut global de l'analyse</items></items><items code="at0077"><items id="comment">Il s’agit d’une classification générale qui ne vise pas à mentionner le nom de l’organisation gestionnaire du laboratoire. Par exemple : anatomopathologie, immunologie et médecine transfusionnelle, microbiologie médicale, pharmacologie clinique, génétique médicale, biochimie médicale. Il est également possible d’utiliser des sous-catégories ou des sous-disciplines plus précises, telles que les services d’endocrinologie, d’hématologie et d’allergologie. Cela peut aider les cliniciens à filtrer les résultats par catégorie. Dans la mesure du possible, il est souhaitable d’utiliser une terminologie spécifique pour le codage.</items><items id="description">Le service ou la discipline de diagnostic responsable du résultat de l'examen de laboratoire.</items><items id="text">Catégorie du service de diagnostic</items></items><items code="at0090"><items id="description">Coordonnées du clinicien ou de l'organisation ayant demandé le résultat de l'analyse de laboratoire.</items><items id="text">Demandeur</items></items><items code="at0094"><items id="comment">Dans la plupart des cas, il y a une seule demande d’analyse et un seul résultat correspondant ; toutefois, ce groupe répétitif permet de prendre en compte les situations où plusieurs demandes d’analyse peuvent être rapportées à l’aide d’un seul résultat d’analyse.&#13;
&#13;
Par exemple : « un clinicien demande une glycémie dans une première demande et un dosage de l’urée et des électrolytes dans une deuxième demande, mais l’analyseur du laboratoire effectue les deux analyses et le laboratoire souhaite les rapporter ensemble ».</items><items id="description">Détails concernant la demande d'examen.</items><items id="text">Détails de la demande d'analyse</items></items><items code="at0097"><items id="comment">Ce slot peut porter sur un analyte individuel, un groupe, un panel ou une batterie de plusieurs analytes, ou encore une structure plus complexe et spécifique.</items><items id="description">Résultats de l'examen réalisé sur le ou les échantillons.</items><items id="text">Résultat de l'analyse</items></items><items code="at0098"><items id="comment">Par exemple : « Insuffisance hépatique sévère », « Contamination par Salmonella ». Il est fortement recommandé, dans la mesure du possible, de coder le diagnostic à l’aide d’une terminologie. Ce diagnostic doit correspondre au texte figurant dans la rubrique « Conclusion ».</items><items id="description">Mot, expression ou brève description représentant la signification et l'importance cliniques du résultat d'un examen de laboratoire.</items><items id="text">Diagnostic de l'analyse</items></items><items code="at0100"><items id="comment">Cet élément de données peut inclure un lien vers les informations cliniques d'origine fournies dans la demande d'analyse.</items><items id="description">Description des informations cliniques disponibles au moment de l'interprétation des résultats.</items><items id="text">Informations cliniques fournies</items></items><items code="at0101"><items id="description">Commentaire supplémentaire concernant le résultat de l'examen qui n'est pas renseigné dans d'autres champs.</items><items id="text">Remarque</items></items><items code="at0106"><items id="comment">Cet élément de données doit être utilisé lorsque l'examen demandé diffère de celui effectivement réalisé par le laboratoire.</items><items id="description">Nom de l'examen de laboratoire initial demandé.</items><items id="text">Nom initial de l'examen demandé</items></items><items code="at0107"><items id="description">L'existence de l'examen est enregistrée dans le système d'information du laboratoire, mais aucun résultat n'est encore disponible.</items><items id="text">Enregistré</items></items><items code="at0110"><items id="comment">Par exemple : « détails du test ELISA/néphélométrie ».</items><items id="description">Informations structurées concernant la méthode d'analyse, le dispositif ou l'interprétation utilisés.</items><items id="text">Détails de l'analyse</items></items><items code="at0111"><items id="comment">Vrai si le test a été réalisé directement au point de soins (POCT).</items><items id="description">Cela permet d’indiquer si l'analyse a été réalisé directement au point de soins (POCT), par opposition à un résultat officiel provenant d’un laboratoire ou d’un autre prestataire de services.</items><items id="text">Analyse au chevet du patient</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">Le terme « facteurs de confusion » doit être réservé aux éléments non contrôlés ou imprévus liés à l’état ou à la physiologie du patient susceptibles d’influencer l’interprétation, par exemple « effort physique récent » ou « consommation récente de tabac ».&#13;
&#13;
Les conditions préalables connues ou requises, telles que « à jeun », doivent être indiquées dans l’élément « Conditions de prélèvement » de l’archétype CLUSTER.specimen. Dans certains cas, les conditions préalables sont intégrées au nom de  l'analyse, par exemple « glycémie à jeun ».&#13;
&#13;
Les problèmes connus liés au prélèvement ou à la manipulation de l’échantillon, tels que « utilisation prolongée d’un garrot » ou « échantillon hémolysé », doivent être indiqués dans les éléments « Problèmes de qualité de l'échantillon » de l’archétype CLUSTER.specimen.&#13;
&#13;
Dans la mesure du possible, il est souhaitable d’utiliser une terminologie standardisée pour le codage.</items><items id="description">Problèmes ou circonstances ayant une incidence sur l'interprétation exacte de la mesure ou du résultat de l'analyse.</items><items id="text">Facteurs de confusion</items></items><items code="at0114"><items id="comment">Par exemple : date des dernières règles (LNMP).</items><items id="description">Détails des problèmes ou circonstances ayant une incidence sur l'interprétation précise de la mesure ou du résultat de l'analyse.</items><items id="text">Facteurs de confusion structurés</items></items><items code="at0115"><items id="description">Le résultat a été modifié après avoir été déclaré « définitif » ; il est complet et a été vérifié par le pathologue responsable. Il s'agit d'une sous-catégorie de « Modifié ».</items><items id="text">Corrigé</items></items><items code="at0116"><items id="description">Le résultat de l'analyse a été retiré après sa publication définitive.</items><items id="text">Saisi par erreur</items></items><items code="at0117"><items id="comment">Par exemple: exigences d’information locales ou métadonnées supplémentaires permettant l’alignement avec des équivalents FHIR ou CIMI.</items><items id="description">Informations supplémentaires nécessaires pour représenter un contenu local ou pour assurer l’alignement avec d’autres modèles de référence ou formalismes.</items><items id="text">Extension</items></items><items code="at0118"><items id="comment">Plusieurs formats sont autorisés, mais ils doivent présenter un contenu clinique équivalent.</items><items id="description">Image numérique, vidéo ou schéma représentant le résultat de l'analyse.</items><items id="text">Représentation multimédia</items></items><items code="at0119"><items id="description">Après avoir été finalisé, le rapport a été modifié par l'ajout de nouveaux éléments. Le contenu existant reste inchangé. Il s'agit d'une sous-catégorie de « Modifié ».</items><items id="text">Ajouté</items></items><items code="at0120"><items id="description">Des résultats préliminaires vérifiés sont disponibles, mais tous les résultats ne sont pas définitifs. Il s'agit d'une sous-catégorie de « Partiel ».</items><items id="text">Preliminaire</items></items><items code="at0121"><items id="comment">Dans la mesure du possible, il est souhaitable d'utiliser une terminologie de codage.</items><items id="description">Description de la méthode utilisée pour réaliser le test.</items><items id="text">Méthode d'analyse</items></items><items code="at0122"><items id="comment">Par exemple : les diagnostics de pathologie anatomique comprenant plusieurs aspects différents, tels que la morphologie, l’étiologie et la fonction.</items><items id="description">Diagnostic structuré ou complexe issu de l'examen de laboratoire.</items><items id="text">Diagnostic par test structuré</items></items></term_definitions><term_definitions language="it"><items code="at0000"><items id="description">L'esito, inclusi i risultati e l'interpretazione, di una indagine di laboratorio effettuata su campioni provenienti da individui o relativi materiali.</items><items id="text">Risultato di esame di laboratorio</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Predefinito, non specificato istante o intervallo di tempo, che può essere esplicitamente dettagliato in un template o in esecuzione (tempo reale)</items><items id="text">Qualunque evento</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">Il risultato di un esame può essere relativo ad un singolo analita, oppure and un gruppo di elementi, inclusi i panel test. Si raccomanda vivamente di codificare il nome dell'esame tramite utilizzo di una terminologia, come ad esempio LOINC o SNOMED CT. Ad esempio: 'Glucosio', 'Urea ed elettroliti', 'Tampone', 'Cortisolo (am)', 'Potassio nella traspirazione' o 'Istopatologia del melanoma'. Il nome può talvolta includere il tipo di campione e lo stato del paziente, ad esempio 'Glucosio a digiuno' o includere altre informazioni, come 'Potassio (gas sanguigni PNA).</items><items id="description">Nome dell' indagine di laboratorio effettuata sul campione/i.</items><items id="text">Nome dell'esame</items></items><items code="at0017"><items id="comment">Questo campo viene utilizzato per indicare i dettagli riguardanti il laboratorio che ha ricevuto la richiesta ed ha la piena responsabilità di gestione del risultato dell'esame, anche nel caso  in cui altri laboratori ne abbiano eseguito delle specifiche parti. Il laboratorio ricevente potrebbe sia effettuare l'esame, oppure delegarlo verso un altro laboratorio. Quando un altro laboratorio è responsabile dell'esecuzione del test su degli specifici analiti, ci si aspetta che  i relativi dettagli vengano riportati nello SLOT "Dettagli del risultato dell'analita", all'interno dell'archetipo CLUSTER.laboratory_test_analyte.</items><items id="description">Dettagli riguardanti il laboratorio che ha ricevuto la richiesta ed ha la piena responsabilità di gestione del risultato dell'esame, anche nel caso in cui altri laboratori abbiano  eseguito specifiche parti.</items><items id="text">Laboratorio ricevente</items></items><items code="at0035"><items id="comment">La "Lista di distribuzione" ha soltanto scopo informativo, ed il destinatario principale della lista è la persona ritenuta quella preposta ad agire sulle informazioni.</items><items id="description">Dettagli su eventuale altro personale sanitario o organismi che hanno richiesto una copia del risultato dell'esame. </items><items id="text">Lista di distribuzione</items></items><items code="at0037"><items id="description">E' un risltato parziale(iniziale, provvisorio o preliminare) dell'esame: la data nel risultato dell'esame potrebbe essere incompleta, oppure non verificata.</items><items id="text">Parziale</items></items><items code="at0038"><items id="description">Il risultato dell'esame è completo ed è stato verificato da una persona autorizzata. </items><items id="text">Definitivo</items></items><items code="at0040"><items id="description">Il risultato è stato modificato dopo essere stato dichiarato come Definitivo, ed è completo e verificato dal patologo responsabile e data dell'esito è stata cambiata. </items><items id="text">Modificato</items></items><items code="at0057"><items id="comment">Per esempio: "l'esito indica una significativa compromissione renale". Il contenuto delle conclusioni può variare, a seconda dell'indagine effettuata. Queste conclusioni dovrebbero essere allineate con quanto riportato nel campo "Diagnosi dell'esame".</items><items id="description">Descrizione relativa agli esiti principali. </items><items id="text">Conclusioni</items></items><items code="at0062"><items id="comment">E' equivalente al campo HL7 "Placer Order Identifier"</items><items id="description">ID locale assegnato all'ordine dell'esame dal sistema che lo ha richiesto </items><items id="text">Identificativo del richiedente l'ordine</items></items><items code="at0063"><items id="comment">L'identificativo assegnato alla richiesta dal Sistema Informativo di Laboratorio (LIS) permette di tracciare lo stato di avanzamento della richiesta e di associare i risultati alle richieste. Fornisce anche un riferimento utile nelle indagini e di solito è equivalente al campo HL7 "Filler Order Identifier".</items><items id="description">Identificativo locale assegnato all'ordine dell'esame dall'order filler, solitamente dal Sistema Informativo di Laboratorio (LIS).</items><items id="text">Identificativo del ricevente l'ordine</items></items><items code="at0065"><items id="comment">Se il tipo del campione è specificato in maniera esaustiva all'interno del nome dell'esame, allora non è richiesto alcun dettaglio. Nel caso di campioni multipli, questi possono essere rappresentati mediante "gruppo di risultati" ("Result group").</items><items id="description">Dettagli sulla sostanza fisica che è stata analizzata. </items><items id="text">Dettagli sul campione</items></items><items code="at0068"><items id="comment">Questo identivicativo è un numero di tracciabilità interno assegnato dal LIS, e non il nome dell'esame. </items><items id="description">Identificativo locale assegnato dal Sistema Informativo di Laboratorio (LIS) ricevente, allo scopo di tracciare il processo dell'esame. </items><items id="text">Identificativo interno del laboratorio</items></items><items code="at0073"><items id="comment">I valori sono stati specificatamente scelti in moto tale da corrispondere a quelli del "FHIR Diagnostic Report" di HL7, a loro volta storicamente derivanti dal HL7 v2. Altre codifiche/terminologie locali possono essere utilizzare tramite la scelta "Text". Questo elemento ha occorrenze multiple al fine di soddisfare le esigenze di quegli use case in cui gli stati relativi a differenti aspetti del risultato sono stati divisi in più componenti.</items><items id="description">Lo stato relativo all'esame di laboratorio nel suo complesso. </items><items id="text">Stato complessivo dell'esame</items></items><items code="at0074"><items id="description">Il risultato non è disponibile perché il test non è stato avviato o non è stato completato (talvolta chiamato anche 'abortito').</items><items id="text">Cancellato</items></items><items code="at0075"><items id="description">La data e/o l'ora in cui è stato rilasciato lo "Stato complessivo dell'esame". </items><items id="text">Timestamp dello stato generale del test</items></items><items code="at0077"><items id="comment">Questa vuole essere una categorizzazione generale e non registrare il nome organizzativo del laboratorio. Per esempio: anatomia patologica, immunologia e medicina trasfusionale, microbiologia medica, farmacologia clinica, genetica medica, biochimica medica. In alternativa possono essere utilizzate sottocategorie o sottodiscipline più granulari, come endocrinologia, ematologia e servizi di allergologia. Questo può aiutare i medici a filtrare tra le categorie di risultati. La codifica con una terminologia è auspicabile, ove possibile.</items><items id="description">Il servizio diagnostico o la disciplina che è responsabile del risultato del test di laboratorio.</items><items id="text">Categoria di servizio diagnostico</items></items><items code="at0090"><items id="description">Dettagli del clinico o dell'organizzazione che richiede il risultato dell'esame di laboratorio.</items><items id="text">Richiedente</items></items><items code="at0094"><items id="comment">Nella maggior parte delle situazioni c'è una richiesta di test e un singolo risultato di test corrispondente, tuttavia questo cluster di ripetizione permette la situazione in cui ci possano essere richieste di test multipli segnalati utilizzando un singolo risultato di test.&#13;
&#13;
Come esempio: "un clinico chiede il glucosio nel sangue in una richiesta e gli urei/elettroliti in una seconda richiesta, ma l'analizzatore di laboratorio fa entrambe le cose e il laboratorio desidera riportare queste richieste insieme".</items><items id="description">Dettagli sulla richiesta di test.</items><items id="text">Dettagli della richiesta di test</items></items><items code="at0097"><items id="comment">Questo SLOT può riportare un singolo analita, un gruppo, un pannello o una batteria di più analiti, o una struttura più complessa e specifica.</items><items id="description">Risultati del test eseguito sul campione o sui campioni.</items><items id="text">Risultati del test</items></items><items code="at0098"><items id="comment">Per esempio: 'Grave insufficienza epatica', 'Contaminazione da Salmonella'. Si raccomanda vivamente, ove possibile, di codificare la diagnosi con una terminologia. Questa diagnosi dovrebbe essere allineata con la narrazione nella 'Conclusione'.</items><items id="description">Singola parola, frase o breve descrizione che rappresenta il significato clinico e la significatività del risultato del test di laboratorio.</items><items id="text">Diagnosi del test</items></items><items code="at0100"><items id="comment">Questo elemento di dati può includere un link alle informazioni cliniche originali fornite nella richiesta di test.</items><items id="description">Descrizione delle informazioni cliniche disponibili al momento dell'interpretazione dei risultati.</items><items id="text">Informazioni cliniche fornite</items></items><items code="at0101"><items id="description">Narrativa aggiuntiva sul risultato del test non catturato in altri campi.</items><items id="text">Commento</items></items><items code="at0106"><items id="comment">Questo elemento deve essere utilizzato quando il test richiesto differisce da quello effettivamente eseguito dal laboratorio.</items><items id="description">Nome del test di laboratorio originale richiesto.</items><items id="text">Nome del test originale richiesto</items></items><items code="at0107"><items id="description">L'esistenza del test è registrata nel Sistema Informativo di Laboratorio, ma non c'è ancora nulla di disponibile. </items><items id="text">Registrato</items></items><items code="at0110"><items id="comment">Ad esempio: 'dettagli di ELISA/nefelometria'.</items><items id="description">Dettagli strutturati sul metodo utilizzato relativamente ad analisi, dispositivi o interpretazione. </items><items id="text">Dettagli del test</items></items><items code="at0111"><items id="comment">Vero se il test è stato eseguito direttamente al punto di assistenza (Point-of-Care, POCT).</items><items id="description">Questo elemento indica se il test è stato eseguito direttamente presso il punto di assistenza (Point-of-Care, POCT), rispetto a un risultato formale di un laboratorio o di un'altra organizzazione che fornisce servizi.</items><items id="text">Test al punto di assistenza</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">I "fattori di confusione" dovrebbero essere riservati a questioni incontrollate/non pianificate di stato del paziente/fisiologia che potrebbero influenzare l'interpretazione, ad esempio "esercizio fisico recente" o "fumo di tabacco recente".&#13;
&#13;
Le precondizioni conosciute o richieste, come ad esempio il "digiuno", dovrebbero essere riportati nell'elemento "Condizioni di campionamento" all'interno dell'archetipo CLUSTER.specimen archetype. In alcuni casi le precondizioni vengono catturate come parte del nome del test, ad esempio "Glucosio nel sangue a digiuno".&#13;
&#13;
Problemi noti di raccolta o manipolazione dei campioni, come "uso prolungato del laccio emostatico" o "campione emolizzato", devono essere riportati negli elementi "Qualità del campione" all'interno di CLUSTER.specimen archetype.&#13;
Ove possibile, è auspicabile una codifica con una terminologia.</items><items id="description">Problemi o circostanze che influiscono sull'interpretazione accurata del risultato della misurazione o del test.</items><items id="text">Fattori di confusione</items></items><items code="at0114"><items id="comment">Per esempio: Ultimo periodo mestruale normale (Last Normal Menstrual Period, LNMP).</items><items id="description">Dettagli dello stato del paziente che possono alterare l'interpretazione del test di laboratorio.</items><items id="text">Fattori di confusione strutturati</items></items><items code="at0115"><items id="description">Il risultato è stato modificato in seguito all'essere stato dichiarato definitivo, ed è completo e verificato dal patologo responsabile. Questa è una sottocategoria di "Modificato"</items><items id="text">Corretto</items></items><items code="at0116"><items id="description">Il Risultato del Test è stato ritirato dopo un precedente rilascio Finale.</items><items id="text">Inserito in errore</items></items><items code="at0117"><items id="comment">Ad esempio: requisiti informativi locali o metadati aggiuntivi per allinearsi agli equivalenti FHIR o CIMI.</items><items id="description">Informazioni aggiuntive necessarie per acquisire contenuti locali o per allinearsi con altri modelli/formalismi di riferimento.</items><items id="text">Estensione</items></items><items code="at0118"><items id="comment">Sono consentiti più formati, ma dovrebbero rappresentare un contenuto clinico equivalente.</items><items id="description">Immagine digitale, video o diagramma che rappresenta il risultato del test.</items><items id="text">Rappresentazione multimediale</items></items><items code="at0119"><items id="description">Dopo essere stato dichiarato definitivo, il rapporto è stato modificato con l'aggiunta di nuovi contenuti. Il contenuto pre-esistente è rimasto invariato. Questa è una sottocategoria di "Modificato".</items><items id="text">Addizionato</items></items><items code="at0120"><items id="description">I primi risultati verificati sono disponibili, ma non tutti i risultati sono definitivi. Questa è una sottocategoria di 'Parziale'.</items><items id="text">Preliminare</items></items><items code="at0121"><items id="comment">E' auspicabile, ove possibile, codificare con una terminologia.</items><items id="description">Descrizione del metodo utilizzato per eseguire il test.</items><items id="text">Metodo di test</items></items><items code="at0122"><items id="comment">Per esempio: Le diagnosi di anatomia patologica che consistono in molteplici assi diversi, come la morfologia, l'eziologia e la funzione. </items><items id="description">Una diagnosi strutturata o complessa per il test di laboratorio.</items><items id="text">Diagnosi strutturata per il test</items></items></term_definitions><term_definitions language="nb"><items code="at0000"><items id="description">Resultat, inkludert funn og laboratoriets tolkning, av en laboratorieundersøkelse utført på prøvemateriale fra et individ eller relatert til individet.</items><items id="text">Laboratorieresultat</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en templat eller i en applikasjon.</items><items id="text">Uspesifisert hendelse</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">Undersøkelsesnavnet kan dekke ett enkelt resultat eller en gruppe av resultater. Undersøkelsesnavnet kan kodes med medisinsk kodeverk som for eksempel NLK (Norsk laboratoriekodeverk), LOINC, SNOMED CT eller lokale laboratoriekodeverk. Eksempler kan være "Glukose", "Elektrolytter", "Blodgass", "Differensialtelling", "Dyrkning", "Kortisol (morgen)" eller "histologi melanom". Navnet kan noen ganger inneholde typen prøvemateriale og/eller pasientstatus, for eksempel "fastende blodglukose" "Kalium i svette", eller inneholde annen informasjon, som "Kalium (PNA blodgass)".</items><items id="description">Navn på laboratorieundersøkelsen som er utført på prøvematerialet.</items><items id="text">Undersøkelsesnavn</items></items><items code="at0017"><items id="comment">Dette SLOTet er ment for detaljer om laboratoriet som mottok rekvisisjonen og har det overordnede ansvaret for å sende en svarrapport, selv om andre laboratorier utfører spesifikke deler av den.&#13;
&#13;
Det ansvarlige laboratoriet kan enten utføre undersøkelsene selv, eller videresende til andre laboratorier. Hvis et annet laboratorium har utført spesifikke undersøkelser bør informasjon om dette bli beskrevet i SLOTet "Detaljer om analyseresultat" i arketypen "Analyseresultat".&#13;
&#13;
"Ansvarlig laboratorium" kalles ofte "Tjenesteyter".</items><items id="description">Detaljer om laboratoriet som mottok den opprinnelige rekvisisjonen og har det overordnede ansvaret for prøven, selv om det er andre laboratorier som utfører de enkelte analysene.</items><items id="text">Ansvarlig laboratorium</items></items><items code="at0035"><items id="comment">Personene eller organisasjonene på distribusjonslisten mottar svaret kun til informasjon, og det er hovedmottakeren av rapporten som forventes å agere på den.</items><items id="description">Detaljert informasjon knyttet til kliniker eller organisatorisk enhet som skal motta en kopi av laboratoriesvaret.</items><items id="text">Kopimottakere</items></items><items code="at0037"><items id="description">Dette er et delvis (dvs initalt, foreløpig eller preliminært) svar: Data i svaret kan være ukomplett eller ubekreftet.</items><items id="text">Ufullstendig</items></items><items code="at0038"><items id="description">Svaret er komplett og er bekreftet av ansvarlig person.</items><items id="text">Endelig</items></items><items code="at0040"><items id="description">Svaret har blitt modifisert etter å ha vært i status "Endelig", og er komplett og verifisert av ansvarlig person, og svardata er endret.</items><items id="text">Revidert</items></items><items code="at0057"><items id="comment">For eksempel "mønsteret indikerer betydelig nedsatt nyrefunksjon". Innholdet av konklusjonen vil variere, basert på hvilken undersøkelse som er utført. Konklusjonen bør være i overensstemmelse med kodene brukt i elementet "Diagnose".</items><items id="description">Fritekstbeskrivelse av de viktigste funnene.</items><items id="text">Konklusjon</items></items><items code="at0062"><items id="comment">Tilsvarende HL7 "Placer Order Identifier".</items><items id="description">Rekvirentens/bestillers lokale ID for rekvisisjonen.</items><items id="text">Rekvirentens rekvisisjonsID</items></items><items code="at0063"><items id="comment">Når Laboratorieinformasjonssystemet (LIMS) tildeler en identifikator, åpnes det for sporing av fremdriften/prosessforløpet på bestillingen av undersøkelsen/rekvisisjonen og for å koble undersøkelsesresultatet til rekvisisjonen/bestillingen. Som regel tilsvarer dette HL7 "Filler Order Identifier".&#13;
&#13;
Denne identifikatoren kalles også ofte "rekvisisjonsnummer" eller "remissenummer".</items><items id="description">Bestillingens/rekvisisjonens lokale identifikator/referansenummer tildelt av tjenesteyter/mottaker, som regel av LIMS.</items><items id="text">Rekvisisjonsmottakers rekvisisjonsID</items></items><items code="at0065"><items id="comment">Hvis prøvematerialet er tilstrekkelig spesifisert med en kode i analysenavnet er ikke dette dataelementet nødvendig. Det er mulig å koble svar med spesifikke prøver ved hjelp av elementene "ID for prøvemateriale" i både CLUSTER.specimen og de forskjellige CLUSTER-arketypene for laboratoriesvar.</items><items id="description">Detaljer om den fysiske substansen som er analysert.</items><items id="text">Prøvedetaljer</items></items><items code="at0068"><items id="comment">Denne identifikatoren er et internt sporingsnummer tildelt av LIMS, og det er ikke ment å være navnet på undersøkelsen.</items><items id="description">En lokal identifikator tildelt av det mottagende laboratoriesystemet (LIMS), for å kunne spore analyseprosessen.</items><items id="text">Laboratorieintern identifikator</items></items><items code="at0073"><items id="comment">Verdiene er valgt spesifikt for å samsvare med verdiene i HL7 FHIR-ressursen "Diagnostic report", som historisk sett kommer fra HL7 v2. Andre lokale koder eller termer kan brukes ved å bruke datatypen "Fri eller kodet tekst.&#13;
&#13;
Dette elementet kan repeteres for å understøtte bruksområdene der statuser for forskjellige aspekter av resultatet er delt opp i flere elementer. Et eksempel på dette er de norske standard labsvarmeldingene i HIS 1.4-standarden, der status for svaret og status for laboratorieprosessen håndteres separat.</items><items id="description">Den overordnede statusen for hele laboratorieresultatet/prøven.</items><items id="text">Overordnet resultatstatus</items></items><items code="at0074"><items id="description">Svaret er utilgjengelig fordi analysen ikke ble påbegynt eller ferdigstilt (også kalt "avbrutt").</items><items id="text">Kansellert</items></items><items code="at0075"><items id="description">Tidspunktet for utstedelsen av "Overordnet resultatstatus".</items><items id="text">Tidsangivelse for overordnet resultatstatus</items></items><items code="at0077"><items id="comment">Dette er ikke ment for å gjenspeile laboratoriets interne organisering, men for å angi hvilken laboratoriedisiplin analysene tilhører. For eksempel patologi, immunologi og transfusjonsmedisin, medisinsk mikrobiologi, klinisk farmakologi, medisinsk genetikk og medisinsk biokjemi. Eventuelt enda mer findelte subkategorier eller subdisipliner som f.eks. hormoner/endokrinologi, hematologi, allergologi. Dette hjelper klinikere med å filtrere mellom resultatkategorier i henhold til lokalt oppsett. Koding med en terminologi er ønskelig, der det er mulig.</items><items id="description">Laboratoriefagområdet, -disiplinen eller subdisiplinen som er ansvarlig for resultatet.</items><items id="text">Laboratoriedisiplin</items></items><items code="at0090"><items id="description">Detaljert informasjon knyttet til kliniker eller organisatorisk enhet som har rekvirert/bestilt analysen.</items><items id="text">Rekvirent</items></items><items code="at0094"><items id="comment">I de fleste situasjoner finnes det én rekvisisjon og ett korresponderende svar, men under noen omstendigheter kan flere rekvisisjoner representeres ved hjelp av en enkelt laboratorieresultat-arketype.&#13;
&#13;
For eksempel kan en kliniker bestille "glukose" i en rekvisisjon og "urea og elektrolytter" i en ytterligere rekvisisjon, mens laboratoriet utfører begge analysene og sender en samlet rapport.</items><items id="description">Detaljer knyttet til rekvisisjonen.</items><items id="text">Rekvisisjonsdetaljer</items></items><items code="at0097"><items id="comment">Dette SLOTet kan inneholde resultat for ett enkelt analyseresultat, for en gruppe analyseresultater, eller for en mer kompleks og spesifikk struktur.</items><items id="description">Resultat av undersøkelsen som er utført på prøvematerialet.</items><items id="text">Undersøkelsesresultat</items></items><items code="at0098"><items id="comment">For eksempel "Betydelig nedsatt leverfunksjon" eller "Salmonella". Koding med en terminologi foretrekkes, der det er mulig. Diagnosen bør være i overensstemmelse med teksten i "Konklusjon".</items><items id="description">Enkeltord, frase eller kort beskrivelse som representerer den kliniske betydningen og signifikansen av laboratorieresultatet.</items><items id="text">Diagnose</items></items><items code="at0100"><items id="comment">Dette dataelementet kan inkludere en lenke til den opprinnelige kliniske informasjonen som ble angitt i rekvisisjonen.</items><items id="description">Beskrivelse av klinisk informasjon som er tilgjengelig på tolkningstidspunktet.</items><items id="text">Tilgjengelig klinisk informasjon</items></items><items code="at0101"><items id="description">Tekstlig tilleggsinformasjon om analyseresultatet, som ikke er registrert i andre felt.</items><items id="text">Kommentar</items></items><items code="at0106"><items id="comment">Dette dataelementet er tenkt brukt dersom det er forskjell mellom undersøkelsen som er rekvirert og den som faktisk er utført.</items><items id="description">Navn på undersøkelsen som opprinnelig ble rekvirert.</items><items id="text">Navn på opprinnelig rekvirert analyse</items></items><items code="at0107"><items id="description">Analysen er registrert i laboratoriesystemet, men svaret er ikke tilgjengelig per nå.</items><items id="text">Registrert</items></items><items code="at0110"><items id="comment">For eksempel "detaljer om ELISA/nefelometri".</items><items id="description">Strukturert tilleggsinformasjon om hvilken analysemetode, utstyr eller tolkning som er benyttet.</items><items id="text">Undersøkelsesdetaljer</items></items><items code="at0111"><items id="comment">Sann dersom analysen ble utført ved pasientnær analysering (PNA).</items><items id="description">Dette indikerer hvorvidt analysen ble utført gjennom pasientnær analysering (PNA) i stedet for en mer formell laboratorietjeneste.</items><items id="text">Pasientnær analysering</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">"Konfunderende faktorer" bør være reservert for ukontrollerte eller uplanlagte forhold hos pasienten som kan påvirke tolkningen av laboratorieresultatet. For eksempel "nylig fysisk aktivitet", "nylig røykt tobakk". &#13;
&#13;
Kjente forutsetninger som "fastende" bør dokumenteres i elementet "Prøvetakingsforhold" i arketypen CLUSTER.specimen. I noen tilfeller er slike forutsetninger del av undersøkelsesnavnet, for eksempel "Fastende blodsukker".&#13;
&#13;
Kjente forhold knyttet til prøvetaking eller håndtering av prøven, som "langvarig stase" eller "hemolyse" (preanalytiske forhold) bør dokumenteres i elementet "Prøvekvalitet" i arketypen CLUSTER.specimen.&#13;
&#13;
Koding med en terminologi er ønskelig, der det er mulig.</items><items id="description">Forhold eller omstendigheter som påvirker tolkningen av laboratorieresultatet.</items><items id="text">Konfunderende faktorer</items></items><items code="at0114"><items id="comment">For eksempel siste normale menstruasjonsperiode.</items><items id="description">Ytterligere detaljer om forhold i tilstand eller omstendigheter som kan påvirke tolkningen av laboratorieresultatet.</items><items id="text">Strukturerte konfunderende faktorer</items></items><items code="at0115"><items id="description">Svaret har blitt modifisert etter å ha vært i status "Endelig" og er komplett og verifisert. Dette er en underkategori til "Revidert".</items><items id="text">Korrigert</items></items><items code="at0116"><items id="description">Analysesvaret har blitt trukket tilbake etter å ha vært i status "Endelig".</items><items id="text">Feilregistrert</items></items><items code="at0117"><items id="comment">For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.</items><items id="description">Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.</items><items id="text">Tilleggsinformasjon</items></items><items code="at0118"><items id="comment">Flere formater tillates, men innholdet i de forskjellige formatene må representere det samme innholdet.</items><items id="description">Digitalt bilde, video eller diagram som representerer analyseresultatet.</items><items id="text">Multimediarepresentasjon</items></items><items code="at0119"><items id="description">Etter å ha vært satt som status "Endelig", har det blitt lagt nytt innhold til rapporten. Det eksisterende innholdet er uendret. Dette er en underkategori av "Revidert".</items><items id="text">Tillegg</items></items><items code="at0120"><items id="description">Verifiserte tidlige svar er tilgjengelige, men ikke alle svar er endelige. Dette er en underkategori av "Ufullstendig".</items><items id="text">Foreløpig</items></items><items code="at0121"><items id="comment">Koding med en terminologi er ønskelig, der det er mulig.</items><items id="description">Beskrivelse av metoden som ble brukt for å utføre undersøkelsen.</items><items id="text">Undersøkelsesmetode</items></items><items code="at0122"><items id="comment">For eksempel patologidiagnoser bestående av flere forskjellige akser som morfologi, etiologi og funksjon.</items><items id="description">En strukturert eller kompleks diagnose for laboratorieundersøkelsen.</items><items id="text">Strukturert diagnose</items></items></term_definitions><term_definitions language="nl"><items code="at0000"><items id="description">*The result, including findings and the laboratory's interpretation, of an investigation performed on specimens collected from an individual or related to that individual.(en)</items><items id="text">*Laboratory test result(en)</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="description">Naam van het laboratorium onderzoek dat vericht is op het specimen.</items><items id="text">Naam van de Test</items></items><items code="at0017"><items id="description">*Details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.(en)</items><items id="text">*Receiving laboratory(en)</items></items><items code="at0035"><items id="description">*Details of additional clinicians or organisations who require a copy of the test result.(en)</items><items id="text">*Distribution list(en)</items></items><items code="at0037"><items id="description">*This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.(en)</items><items id="text">*Partial(en)</items></items><items code="at0038"><items id="description">*The Test result is complete and verified by an authorised person.(en)</items><items id="text">*Final(en)</items></items><items code="at0040"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist, and result data has been changed.(en)</items><items id="text">*Amended(en)</items></items><items code="at0057"><items id="description">*Narrative description of the key findings.(en)</items><items id="text">*Conclusion(en)</items></items><items code="at0062"><items id="description">*The local identifier assigned by the requesting clinical system.(en)</items><items id="text">*Requester order identifier(en)</items></items><items code="at0063"><items id="description">*The local identifier assigned to the test order by the order filler, usually by the Laboratory Information System (LIS).(en)</items><items id="text">*Receiver order identifier(en)</items></items><items code="at0065"><items id="description">*Details about the physical substance that has been analysed.(en)</items><items id="text">*Specimen detail(en)</items></items><items code="at0068"><items id="description">*A local identifier assigned by the receiving Laboratory Information System (LIS) to track the test process.(en)</items><items id="text">*Laboratory internal identifier(en)</items></items><items code="at0073"><items id="description">*The status of the laboratory test result as a whole.(en)</items><items id="text">*Overall test status(en)</items></items><items code="at0074"><items id="description">*The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').(en)</items><items id="text">*Cancelled(en)</items></items><items code="at0075"><items id="description">*The date and/or time that ‘Overall test status’ was issued.(en)</items><items id="text">*Overall test status timestamp(en)</items></items><items code="at0077"><items id="description">*The diagnostic service or discipline that is responsible for the laboratory test result.(en)</items><items id="text">*Diagnostic service category(en)</items></items><items code="at0090"><items id="description">*Details of the clinician or organisation requesting the laboratory test result.(en)</items><items id="text">*Requester(en)</items></items><items code="at0094"><items id="description">*Details about the test request.(en)</items><items id="text">*Test request details(en)</items></items><items code="at0097"><items id="description">*Results of the test performed on the specimen(s).(en)</items><items id="text">*Test result(en)</items></items><items code="at0098"><items id="description">*Single word, phrase or brief description that represents the clinical meaning and significance of the laboratory test result.(en)</items><items id="text">*Test diagnosis(en)</items></items><items code="at0100"><items id="description">*Description of clinical information available at the time of interpretation of results.(en)</items><items id="text">*Clinical information provided(en)</items></items><items code="at0101"><items id="description">*Additional narrative about the test result not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0106"><items id="description">*Name of the original laboratory test requested.(en)</items><items id="text">*Original test requested name(en)</items></items><items code="at0107"><items id="description">*The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.(en)</items><items id="text">*Registered(en)</items></items><items code="at0110"><items id="description">*Structured details about the method of analysis, device or interpretation used.(en)</items><items id="text">*Testing details(en)</items></items><items code="at0111"><items id="description">*This indicates whether the test was performed directly at Point-of-Care (POCT) as opposed to a formal result from a laboratory or other service delivery organisation.(en)</items><items id="text">*Point-of-care test(en)</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="description">*Issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0114"><items id="description">*Details of issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Structured confounding factors(en)</items></items><items code="at0115"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist. This is a sub-category of 'Amended'.(en)</items><items id="text">*Corrected(en)</items></items><items code="at0116"><items id="description">*The Test Result has been withdrawn following previous Final release.(en)</items><items id="text">*Entered in error(en)</items></items><items code="at0117"><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0118"><items id="description">*Digital image, video or diagram representing the test result.(en)</items><items id="text">*Multimedia representation(en)</items></items><items code="at0119"><items id="description">*Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.(en)</items><items id="text">*Appended(en)</items></items><items code="at0120"><items id="description">*Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.(en)</items><items id="text">*Preliminary(en)</items></items><items code="at0121"><items id="description">*Description about the method used to perform the test.(en)</items><items id="text">*Test method(en)</items></items><items code="at0122"><items id="description">*A structured or complex diagnosis for the laboratory test.(en)</items><items id="text">*Structured test diagnosis(en)</items></items></term_definitions><term_definitions language="pt-br"><items code="at0000"><items id="description">O resultado, incluindo achados e a interpretação do laboratório, de uma investigação realizada em amostras coletadas de um indivíduo ou relacionadas a esse indivíduo.</items><items id="text">Resultado de exame de laboratório</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</items><items id="text">*Any event(en)</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">*A test result may be for a single analyte, or a group of items, including panel tests. It is strongly recommended that 'Test name' be coded with a terminology, for example LOINC or SNOMED CT. For example: 'Glucose', 'Urea and Electrolytes', 'Swab', 'Cortisol (am)', 'Potassium in perspiration' or 'Melanoma histopathology'. The name may sometimes include specimen type and patient state, for example 'Fasting blood glucose' or include other information, as 'Potassium (PNA blood gas)'.(en)</items><items id="description">*Name of the laboratory investigation performed on the specimen(s).(en)</items><items id="text">*Test name(en)</items></items><items code="at0017"><items id="comment">*This slot is intended to carry details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.&#13;
&#13;
The receiving laboratory may either perform the test or refer it to another laboratory. Where a different laboratory is responsible for performing the testing on specific analytes, it would be expected that these details would be carried in the 'Analyte result detail' SLOT within the CLUSTER.laboratory_test_analyte archetype.&#13;
&#13;
(en)</items><items id="description">*Details of the laboratory which received the request and has overall responsibility to manage reporting of the test, even if other labs perform specific aspects.(en)</items><items id="text">*Receiving laboratory(en)</items></items><items code="at0035"><items id="comment">*The 'Distribution list' is for information-only, and that the primary recipient of the report is the person intended to act on the information.(en)</items><items id="description">*Details of additional clinicians or organisations who require a copy of the test result.(en)</items><items id="text">*Distribution list(en)</items></items><items code="at0037"><items id="description">*This is a partial (e.g. initial, interim or preliminary) Test Result: data in the Test Result may be incomplete or unverified.(en)</items><items id="text">*Partial(en)</items></items><items code="at0038"><items id="description">*The Test result is complete and verified by an authorised person.(en)</items><items id="text">*Final(en)</items></items><items code="at0040"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist, and result data has been changed.(en)</items><items id="text">*Amended(en)</items></items><items code="at0057"><items id="comment">*For example: 'Pattern suggests significant renal impairment'. The content of the conclusion will vary, depending on the investigation performed. This conclusion should be aligned with the coded 'Test diagnosis'.(en)</items><items id="description">*Narrative description of the key findings.(en)</items><items id="text">*Conclusion(en)</items></items><items code="at0062"><items id="comment">*Equivalent to the HL7 Placer Order Identifier.(en)</items><items id="description">*The local identifier assigned by the requesting clinical system.(en)</items><items id="text">*Requester order identifier(en)</items></items><items code="at0063"><items id="comment">*Assigning an identifier to a request by the Laboratory lnformation System (LIS) enables tracking progress of the request and enables linking results to requests. It also provides a reference to assist with enquiries and it is usually equivalent to the HL7 Filler Order Identifier.(en)</items><items id="description">*The local identifier assigned to the test order by the order filler, usually by the Laboratory Information System (LIS).(en)</items><items id="text">*Receiver order identifier(en)</items></items><items code="at0065"><items id="comment">*If the specimen type is sufficiently specified with a code in the Test name, then this additional data is not required. Linking results to specific specimens may be recorded using 'Specimen identifier' elements in both the CLUSTER.specimen and the various results CLUSTER archetypes.(en)</items><items id="description">*Details about the physical substance that has been analysed.(en)</items><items id="text">*Specimen detail(en)</items></items><items code="at0068"><items id="comment">*This identifier is an internal tracking number assigned by the LIS, and it not intended to be the name of the test.(en)</items><items id="description">*A local identifier assigned by the receiving Laboratory Information System (LIS) to track the test process.(en)</items><items id="text">*Laboratory internal identifier(en)</items></items><items code="at0073"><items id="comment">*The values have been specifically chosen to match those in the HL7 FHIR Diagnostic report, historically derived from HL7v2 practice. Other local codes/terms can be used via the Text 'choice'.&#13;
&#13;
This element is multiple occurrence to cater for the use cases where statuses for different aspects of the result have been split into several elements.(en)</items><items id="description">*The status of the laboratory test result as a whole.(en)</items><items id="text">*Overall test status(en)</items></items><items code="at0074"><items id="description">*The result is unavailable because the test was not started or not completed (also sometimes called 'aborted').(en)</items><items id="text">*Cancelled(en)</items></items><items code="at0075"><items id="description">*The date and/or time that ‘Overall test status’ was issued.(en)</items><items id="text">*Overall test status timestamp(en)</items></items><items code="at0077"><items id="comment">*This is intended to be a general categorisation and not to capture the organisational name of the laboratory. For example: anatomical pathology, immunology and transfusion medicine, medical microbiology, clinical pharmacology, medical genetics, medical biochemistry. Alternatively more granular sub categories or sub disciplines, such as endocrinology, haematology, and allergology services, may be used. This may assist clinicians in filtering between categories of results. Coding with a terminology is desirable, where possible.(en)</items><items id="description">*The diagnostic service or discipline that is responsible for the laboratory test result.(en)</items><items id="text">*Diagnostic service category(en)</items></items><items code="at0090"><items id="description">*Details of the clinician or organisation requesting the laboratory test result.(en)</items><items id="text">*Requester(en)</items></items><items code="at0094"><items id="comment">*In most situations there is one test request and a single corresponding test result, however this repeating cluster allows for the situation where there may be multiple test requests reported using a single test result.&#13;
&#13;
As an example: 'a clinician asks for blood glucose in one request and Urea/electrolytes in a second request, but the lab analyser does both and the lab wishes to report these together'.(en)</items><items id="description">*Details about the test request.(en)</items><items id="text">*Test request details(en)</items></items><items code="at0097"><items id="comment">*This SLOT may carry an individual analyte, a group, panel or battery of multiple analytes, or a more complex and specific structure.(en)</items><items id="description">*Results of the test performed on the specimen(s).(en)</items><items id="text">*Test result(en)</items></items><items code="at0098"><items id="comment">*For example: 'Severe hepatic impairment', 'Salmonella contamination'. Coding of the diagnosis with a terminology is strongly recommended, where possible. This diagnosis should be aligned with the narrative in the 'Conclusion'.(en)</items><items id="description">*Single word, phrase or brief description that represents the clinical meaning and significance of the laboratory test result.(en)</items><items id="text">*Test diagnosis(en)</items></items><items code="at0100"><items id="comment">*This data element may include a link to the original clinical information provided in the test request.(en)</items><items id="description">*Description of clinical information available at the time of interpretation of results.(en)</items><items id="text">*Clinical information provided(en)</items></items><items code="at0101"><items id="description">*Additional narrative about the test result not captured in other fields.(en)</items><items id="text">*Comment(en)</items></items><items code="at0106"><items id="comment">*This data element is to be used when the test requested differs from the test actually performed by the laboratory.(en)</items><items id="description">*Name of the original laboratory test requested.(en)</items><items id="text">*Original test requested name(en)</items></items><items code="at0107"><items id="description">*The existence of the test is registered in the Laboratory Information System, but there is nothing yet available.(en)</items><items id="text">*Registered(en)</items></items><items code="at0110"><items id="comment">*For example: 'details of ELISA/nephelometry'.(en)</items><items id="description">*Structured details about the method of analysis, device or interpretation used.(en)</items><items id="text">*Testing details(en)</items></items><items code="at0111"><items id="comment">*True if the test was performed directly at Point-of-Care (POCT).(en)</items><items id="description">*This indicates whether the test was performed directly at Point-of-Care (POCT) as opposed to a formal result from a laboratory or other service delivery organisation.(en)</items><items id="text">*Point-of-care test(en)</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">*'Confounding factors' should be reserved for uncontrolled/unplanned issues of patient state/physiology that might affect interpretation, for example 'recent exercise' or 'recent tobacco smoking'.&#13;
&#13;
Known or required preconditions, such as 'fasting' should be carried in the 'Sampling conditions' element within the CLUSTER.specimen archetype . In some cases preconditions are captured as part of the test name, for example 'Fasting blood glucose'.&#13;
&#13;
Known issues with specimen collection or handling, such as 'prolonged use of tourniquet' or 'sample haemolysed', should be carried in the 'Specimen quality' elements within CLUSTER.specimen archetype.&#13;
&#13;
Coding with a terminology is desirable, where possible.(en)</items><items id="description">*Issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Confounding factors(en)</items></items><items code="at0114"><items id="comment">*For example: Last Normal Menstrual Period (LNMP).(en)</items><items id="description">*Details of issues or circumstances that impact on the accurate interpretation of the measurement or test result.(en)</items><items id="text">*Structured confounding factors(en)</items></items><items code="at0115"><items id="description">*The result has been modified subsequent to being Final, and is complete and verified by the responsible pathologist. This is a sub-category of 'Amended'.(en)</items><items id="text">*Corrected(en)</items></items><items code="at0116"><items id="description">*The Test Result has been withdrawn following previous Final release.(en)</items><items id="text">*Entered in error(en)</items></items><items code="at0117"><items id="comment">*For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.(en)</items><items id="description">*Additional information required to capture local content or to align with other reference models/formalisms.(en)</items><items id="text">*Extension(en)</items></items><items code="at0118"><items id="comment">*Multiple formats are allowed but they should represent equivalent clinical content.(en)</items><items id="description">*Digital image, video or diagram representing the test result.(en)</items><items id="text">*Multimedia representation(en)</items></items><items code="at0119"><items id="description">*Subsequent to being final, the report has been modified by adding new content. The existing content is unchanged. This is a sub-category of 'Amended'.(en)</items><items id="text">*Appended(en)</items></items><items code="at0120"><items id="description">*Verified early results are available, but not all results are final. This is a sub-category of 'Partial'.(en)</items><items id="text">*Preliminary(en)</items></items><items code="at0121"><items id="comment">*Coding with a terminology is desirable, where possible.(en)</items><items id="description">*Description about the method used to perform the test.(en)</items><items id="text">*Test method(en)</items></items><items code="at0122"><items id="comment">*For example: Anatomical pathology diagnoses consisting of several different axes such as morphology, etiology and function.(en)</items><items id="description">*A structured or complex diagnosis for the laboratory test.(en)</items><items id="text">*Structured test diagnosis(en)</items></items></term_definitions><term_definitions language="sv"><items code="at0000"><items id="description">Resultatet av en undersökning, inklusive fynd och laboratoriets tolkning, utförd på provmaterial från en individ eller relaterad till individen. Exempel på provmaterial relaterat till individen kan vara fostervattenprov där provet tas från mammans kropp men provet avser fostret.</items><items id="text">Laboratorieresultat</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">Ospecificerad standardhändelse vid en tidpunkt eller inom ett tidsintervall som explicit kan definieras i en mall eller genereras automatiskt av vissa IT-system.</items><items id="text">Ospecificerad händelse</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">Undersökningsnamnet kan täcka ett enda resultat eller en grupp resultat. Analysnamnet kan kodas med medicinska kodningssystem som NPU, LOINC, SNOMED CT eller lokala laboratoriekodningssystem. Exempel kan vara "P-Glukos", "Blodgas", "Klorid i svett", "Kortisol (morgon)" eller "Histopatologi malignt melanom". Namnet kan ibland innehålla typen av provmaterial och patientstatus, såsom "fP-Glukos" eller innehålla annan information, såsom "pO2 (PNA-blodgas)".</items><items id="description">Namnet på den laboratorieundersökning eller -analys som utförts på provmaterialet.</items><items id="text">Undersökningsnamn</items></items><items code="at0017"><items id="comment">Denna SLOT är avsedd för detaljer om det laboratorium som har mottagit beställningen och som har det övergripande ansvaret för att lämna in en resultatrapport, även om andra laboratorier utför specifika delar av den.&#13;
&#13;
Det ansvariga laboratoriet kan antingen utföra undersökningarna själv eller vidarebefordra dem till andra laboratorier. Om ett annat laboratorium har utfört specifika undersökningar ska information om detta beskrivas i SLOT "Detaljer om analysresultat" i arketypen CLUSTER.laboratory_test_analyte.&#13;
</items><items id="description">Detaljer om det laboratorium som har mottagit beställningen och som har det övergripande ansvaret för att hantera rapporteringen av undersökningen, även om andra laboratorier utför specifika delar av beställningen.</items><items id="text">Ansvarigt laboratorium</items></items><items code="at0035"><items id="comment">Personerna eller organisationerna på distributionslistan får endast svaret för information, och det är huvudmottagaren av rapporten som förväntas agera på den.</items><items id="description">Detaljer om ytterligare kliniker eller organisationer som behöver en kopia av undersökningsresultatet.</items><items id="text">Distributionslista</items></items><items code="at0037"><items id="description">Detta är ett partiellt undersökningsresultat, dvs. initialt, interim eller preliminärt. Resultatdata kan vara ofullständiga eller obekräftade.</items><items id="text">Partiell</items></items><items code="at0038"><items id="description">Undersökningsresultatet är fullständigt och verifierat av ansvarig person alternativt autoverifierat maskinellt.</items><items id="text">Slutgiltig</items></items><items code="at0040"><items id="description">Det slutgiltiga undersökningsresultatet har reviderats. Denna status har underkategorierna "Rättad" och "Utökad".</items><items id="text">Reviderad</items></items><items code="at0057"><items id="comment">Till exempel "resultat indikerar signifikant nedsatt njurfunktion". Tolkningen av resultatet kommer att variera beroende på vilken undersökning som har genomförts. Slutsatsen ska vara i enlighet med de koder som används i dataelementet "Undersökningsdiagnos".</items><items id="description">Berättande textuell beskrivning av de viktigaste resultaten.</items><items id="text">Tolkning av resultat</items></items><items code="at0062"><items id="comment">Denna identifierare benämns ofta som remissidentifierare, och motsvarar HL7 "Placer Order Identifier".</items><items id="description">Den lokala identifierare som tilldelats av det begärande kliniska systemet.</items><items id="text">Beställarens beställningsidentifierare</items></items><items code="at0063"><items id="comment">Tilldelningen av en identifierare i LIS möjliggör spårning av beställningens status och länkning av resultaten till beställningen. Det tillåter också hantering av ytterligare förfrågningar och motsvarar "HL7 Filler Order Identifier".</items><items id="description">Den lokala identifierare som tilldelats beställningen av ordermottagningssystemet, vanligtvis av laboratorieinformationssystemet (LIS).</items><items id="text">Mottagarens beställningsidenitifierare</items></items><items code="at0065"><items id="comment">Om provmaterialet är tillräckligt specificerat med en kod i undersökningssnamnet är detta dataelement inte nödvändigt. Det är möjligt att länka svar till specifika prover med hjälp av dataelementen för prov-ID i både CLUSTER.Specimen och olika CLUSTER-arketyper för laboratoriesvar.</items><items id="description">Detaljer om det provmaterial som har analyserats.</items><items id="text">Detaljer om provmaterialet</items></items><items code="at0068"><items id="comment">Denna identifierare är ett internt spårningsnummer som tilldelats av LIS och är inte avsett att vara namnet på undersökningen.</items><items id="description">En lokal identifierare som tilldelats av det mottagande laboratorieinformationssystemet (LIS) för att spåra analysprocessen.</items><items id="text">Laboratoriets interna identifierare</items></items><items code="at0073"><items id="comment">Värdena har valts specifikt för att motsvara värdena i HL7 FHIR-resursen "Diagnostic Report", som historiskt kommer från HL7 v2. Andra lokala koder eller termer kan användas med datatypen "Fri eller kodad text".&#13;
&#13;
Detta element kan upprepas för att stödja applikationer där status för olika aspekter av resultatet delas in i flera element.</items><items id="description">Status för undersökningsresultaten som helhet.</items><items id="text">Status undersökningsresultat</items></items><items code="at0074"><items id="description">Resultatet är inte tillgängligt eftersom undersökningen inte har startats eller inte slutförts.</items><items id="text">Avbruten</items></items><items code="at0075"><items id="description">Datum och tid för utfärdandet av övergripande resultatstatus.</items><items id="text">Tidpunkt för status undersökningsresultat</items></items><items code="at0077"><items id="comment">Detta är tänkt att vara en allmän kategorisering och inte att fånga laboratoriets interna organisation. Till exempel: patologi, immunologi och transfusionsmedicin, medicinsk mikrobiologi, klinisk farmakologi, medicinsk genetik, medicinsk biokemi. Alternativt kan mer detaljerade underkategorier eller underdiscipliner såsom endokrinologi, hematologi och allergologitjänster användas. Detta kan hjälpa kliniker att filtrera mellan resultatkategorier. Kodning med en terminologi är önskvärd, där det är möjligt.&#13;
</items><items id="description">Den diagnostiska organisationsenhet, laboratoriedisciplin eller underdisciplin som ansvarar för laboratorieresultatet.&#13;
</items><items id="text">Laboratoriedisciplin</items></items><items code="at0090"><items id="description">Uppgifter om den kliniker eller organisation som beställt undersökningen.</items><items id="text">Beställare</items></items><items code="at0094"><items id="comment">I de flesta situationer finns det en beställning och ett motsvarande svar, men under vissa omständigheter kan flera beställningar representeras med en enda arketyp för laboratorieresultat.&#13;
&#13;
Till exempel kan en kliniker beställa "glukos" och "urea och elektrolyter" i separata beställningar och laboratoriet utför båda analyserna, men skickar endast en övergripande resultatrapport.</items><items id="description">Detaljer om beställningen.</items><items id="text">Beställningsdetaljer</items></items><items code="at0097"><items id="comment">Denna SLOT kan innehålla resultat för en enda analys, för en grupp analyser eller för en mer komplex och specifik struktur.</items><items id="description">Resultatet av den undersökning eller analys som utförts på provmaterialet.</items><items id="text">Undersökningsresultat</items></items><items code="at0098"><items id="comment">Till exempel: "Allvarligt nedsatt leverfunktion", "Akut hepatit B". Kodning med en terminologi är att föredra där det är möjligt. Undersökningsdiagnosen bör vara i enlighet med texten i "Tolkning av resultat".&#13;
&#13;
</items><items id="description">Ett ord, en fras eller en kort beskrivning som representerar den kliniska betydelsen eller konsekvensen av laboratorietestresultatet.&#13;
</items><items id="text">Undersökningsdiagnos</items></items><items code="at0100"><items id="comment">Detta dataelement kan innehålla en länk till den ursprungliga kliniska informationen i beställningen.&#13;
&#13;
</items><items id="description">Beskrivning av den kliniska information som finns tillgänglig vid tolkningen av resultaten.</items><items id="text">Tillgänglig klinisk information</items></items><items code="at0101"><items id="description">Ytterligare textuell beskrivning som inte registrerats i andra fält.</items><items id="text">Kommentar</items></items><items code="at0106"><items id="comment">Detta dataelement ska användas när den begärda undersökningen eller analysen skiljer sig från det som faktiskt har utförts av laboratoriet.&#13;
</items><items id="description">Namn på den ursprungligen beställda undersökningen eller analysen.</items><items id="text">Ursprungligt undersökningsnamn</items></items><items code="at0107"><items id="description">Undersökningen är registrerad i laboratorieinformationssystemet, men resultatet finns för närvarande inte.&#13;
&#13;
</items><items id="text">Registrerad</items></items><items code="at0110"><items id="comment">Exempelvis "detaljer om ELISA-analys".</items><items id="description">Strukturerade detaljer om undersökningsmetoden, utrustningen eller tolkningen.</items><items id="text">Detaljer om undersökningsmetod</items></items><items code="at0111"><items id="comment">Sant om analysen utfördes genom patientnära analys (PNA).</items><items id="description">Indikerar om analysen utfördes som en patientnära analys (PNA), det vill säga på vårdenhet, istället för en mer formell laboratorietjänst.</items><items id="text">Patientnära analys</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">"Möjliga felkällor" bör reserveras för okontrollerade eller oplanerade förhållanden hos patienten som kan påverka tolkningen av laboratorieresultatet. Till exempel "nyligen fysisk aktivitet", "nyligen rökt tobak".&#13;
&#13;
Kända antaganden såsom "fasta" bör dokumenteras i dataelementet "Provtagningskontext" i arketypen CLUSTER.specimen. I vissa fall är sådana antaganden en del av studiens namn, såsom "Fastande blodglukos".&#13;
&#13;
Kända förhållanden relaterade till provtagning eller hantering av provet, såsom "förlängd stas" eller "hemolys" bör dokumenteras i elementet "Provkvalitet" i arketypen CLUSTER.specimen.&#13;
&#13;
Kodning med en terminologi är önskvärt där det är möjligt.&#13;
</items><items id="description">Villkor eller omständigheter som påverkar tolkningen av laboratorieresultatet.</items><items id="text">Möjliga felkällor</items></items><items code="at0114"><items id="comment">Till exempel den sista normala menstruationsperioden.</items><items id="description">Mer information om problem eller omständigheter som kan påverka tolkningen av mätningen eller testresultatet.</items><items id="text">Strukturerade möjliga felkällor</items></items><items code="at0115"><items id="description">Det slutgiltiga undersökningsresultatet har rättats. Detta är en underkategori av "Reviderad".</items><items id="text">Rättad</items></items><items code="at0116"><items id="description">Undersökningsresultatet har dragits tillbaka efter att ha varit i status "Slutgiltig".</items><items id="text">Felregistrerad</items></items><items code="at0117"><items id="comment">Exempelvis lokala informationsbehov eller ytterligare metadata för att möjliggöra mappning till FHIR- eller CIMI-modeller.&#13;
</items><items id="description">Ytterligare information som krävs för att registrera lokalt definierat innehåll eller för anpassning till andra referensmodeller.&#13;
</items><items id="text">Ytterligare information</items></items><items code="at0118"><items id="comment">Flera format är tillåtna, men innehållet i de olika formaten måste representera samma kliniska innehåll.</items><items id="description">Digital bild, video eller diagram som representerar undersökningsresultatet.</items><items id="text">Multimedia</items></items><items code="at0119"><items id="description">Det slutgiltiga undersökningsresultatet har ändrats genom att nytt innehåll har inkluderats. Det befintliga innehållet är oförändrat. Detta är en underkategori av "Reviderad".</items><items id="text">Utökat</items></items><items code="at0120"><items id="description">Verifierade tidiga resultat är tillgängliga, men inte alla resultat är slutgiltiga. Detta är en underkategori av status "Partiell".</items><items id="text">Preliminär</items></items><items code="at0121"><items id="comment">Kodning med en terminologi är önskvärt där det är möjligt.</items><items id="description">Beskrivning av den metod som använts för att utföra undersökningen eller analysen.</items><items id="text">Undersökningsmetod</items></items><items code="at0122"><items id="comment">Exempelvis patologisk anatomisk diagnos bestående av flera olika komponenter som morfologi, etiologi och funktion.</items><items id="description">En strukturerad eller komplex diagnos för laboratorieundersökningen.</items><items id="text">Strukturerad undersökningsdiagnos</items></items></term_definitions><term_definitions language="zh-cn"><items code="at0000"><items id="description">旨在用于记录对于从个人身上所采集的标本或者与该个人相关的标本进行检验的结果，包括结果所见/发现和实验室的解释。</items><items id="text">实验室检验结果</items></items><items code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></items><items code="at0002"><items id="description">可以在模板之中或者在运行时加以明确定义的，默认的，未明示的时间点或时间区间事件。</items><items id="text">任何事件</items></items><items code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0004"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0005"><items id="comment">检验结果可能代表的是单独一种分析物或者是一组项目/分析物，包括成套的检验项目（组套检验项目）。强烈建议采用特定的术语标准（如 LOINC 或 SNOMED CT）对“检验项目名称”加以编码。例如：“葡萄糖”、“尿素和电解质”、“拭子”、“皮质醇 （上午）”、“汗液钾离子”或“黑色素瘤组织病理学”。检验项目名称之中有时可能会包括标本类型和患者状态，如“空腹血糖”，或者是包括其他的信息，如“钾（PNA 血气）”。</items><items id="description">针对标本所进行的实验室检验项目的名称。</items><items id="text">检验项目名称</items></items><items code="at0017"><items id="comment">此槽位旨在记录关于当时接收了相应的检验申请并整体负责管理当前检验项目的报告工作的实验室的详情，即使其他实验室执行其中的特定方面。&#13;
&#13;
接收方实验室可能会自身来执行当前的检验项目，或者也可能将其转交给其他的实验室。如果其他实验室负责检测特定的分析物，则应当期望这些详情包含在群簇型实验室检验项目分析物原始型（CLUSTER.laboratory_test_analyte）里的分析物结果详情槽位“Analyte result detail”之中。</items><items id="description">关于当时接收了相应的检验申请并整体负责管理当前检验项目的报告工作的实验室的详情，即使其他实验室执行其中的特定方面。</items><items id="text">接收方实验室</items></items><items code="at0035"><items id="comment">“分发列表”仅供参考，报告的首要接收方则是意在依据当前的实验室检验结果采取行动的人员。</items><items id="description">其他那些要求获得当前实验室检验结果的临床医生或组织机构。</items><items id="text">分发列表</items></items><items code="at0037"><items id="description">当前还属于部分的（比如，初始的、暂时的或初步的）检验结果：检验结果之中的数据可能不完整或者未经核对。</items><items id="text">部分</items></items><items code="at0038"><items id="description">检验结果完整且经过授权人员的核对或者说审核。</items><items id="text">最终</items></items><items code="at0040"><items id="description">结果在达到最终状态之后已被修改，是完整的结果，经过了负责的病理学工作人员的核对，且已经更改了结果数据。</items><items id="text">经过修正</items></items><items code="at0057"><items id="comment">例如：“[所观察到的]模式表明存在显著的肾脏损害”。结论的内容会根据所进行的检查而有所不同。此项结论应当与编码型的检验项目诊断数据元“Test diagnosis”保持一致。</items><items id="description">关于关键所见/发现的文字叙述型描述。</items><items id="fhir_mapping">*DiagnosticReport.conclusion(en)</items><items id="text">结论</items></items><items code="at0062"><items id="comment">等价于HL7申请方医嘱标识符（ Placer Order Identifier）。</items><items id="description">申请方临床系统所赋予当前检验项目医嘱/申请的本地标识符。</items><items id="text">申请方医嘱标识符</items></items><items code="at0063"><items id="comment">实验室信息系统（ Laboratory Information System，LIS）为检验项目医嘱/申请赋予标识符，将便于实现对于申请进展情况的跟踪以及结果与相应医嘱/申请的链接。同时，这也是有助于查询的一种参考信息（reference），且通常等价于HL7执行方医嘱标识符（Filler Order Identifier）。</items><items id="description">医嘱执行方赋予当前检验项目医嘱/申请的本地标识符。其中，医嘱执行方通常为实验室信息系统（ Laboratory Information System，LIS）。</items><items id="text">接收方医嘱标识符</items></items><items code="at0065"><items id="comment">如果利用检验项目名称之中的代码可以充分明确相应的标本类型，则不需要此项附加的数据。可以采用群簇型标本原始型（CLUSTER.specimen）和各种的群簇型结果原始型之中的标本标识符元素“Specimen identifier”元素来记录关于将结果链接到特定标本的信息。</items><items id="description">关于所已经分析的物质的详情。</items><items id="text">标本详情</items></items><items code="at0068"><items id="comment">该标识符属于是实验室信息系统（Laboratory Information System，LIS）所分配的内部追踪编号，但并非旨在作为检验项目的名称。</items><items id="description">接收方实验室信息系统（Laboratory Information System，LIS）所分配的本地标识符，用于跟踪检验过程。</items><items id="text">实验室内部标识符</items></items><items code="at0073"><items id="comment">这些编码型取值是经过专门挑选的，以与 HL7 FHIR 诊断报告资源之中的取值相匹配，而在历史上这些取值源自 HL7v2 实践。另外，可以借助于文本型选项“choice”来使用其他的本地代码/术语。&#13;
&#13;
本数据元可以多次出现，以适应那些将结果不同方面的状态拆分成多个数据元的用例。</items><items id="description">当前的实验室检验项目作为整体的状态</items><items id="text">检验项目总体状态</items></items><items code="at0074"><items id="description">当前结果不可用，因为该检验项目并未开始或者并未完成（有时又称为“取消”、“已中止”或“已放弃”）。</items><items id="text">已撤销</items></items><items code="at0075"><items id="description">发布检验项目总体状态时的日期和/或时间。</items><items id="text">检验项目总体状态时间戳</items></items><items code="at0077"><items id="comment">本数据元旨在进行一般的分类，而并非旨在记录实验室的组织结构名称。例如：解剖病理学、免疫学、输血医学、医学微生物学、临床药理学、医学遗传学、医学生物化学。或者，还可以采用粒度更精细的子类别或子学科，如内分泌学、血液学和变态反应学服务。此项数据可能有助于临床医生在结果类别之间进行筛选。最好尽可能采用特定的术语标准加以编码。</items><items id="description">负责当前实验室检验结果的诊断服务或学科。</items><items id="text">诊断服务类别</items></items><items code="at0090"><items id="description">关于申请当前实验室检验项目（结果）的临床医生或组织机构的详情。</items><items id="text">申请方</items></items><items code="at0094"><items id="comment">在大多数情况下，每份检验请求分别会有相应的单独一项检验结果。不过，这个可重复的群簇允许存在检验结果只有一份[报告]而报告所针对的却是多份检验请求的情况。&#13;
&#13;
例如：医生在一份申请当中要求检测血糖，而在另一份申请中则要求检测尿素/电解质，而实验室分的析仪则会同时处理这两份申请，并且实验室希望将二者一并加以报告。</items><items id="description">关于检验申请的详情。</items><items id="text">检验申请详情</items></items><items code="at0097"><items id="comment">此槽位之中可以包含的是单个的分析物、多个分析物所构成的组合或组套，或者是更为复杂的特定结构。</items><items id="description">针对标本所进行的检验项目的结果。</items><items id="text">检验结果</items></items><items code="at0098"><items id="comment">例如：“严重肝脏损害”、“沙门菌污染”。强烈建议尽可能采用特定的术语标准对此项诊断加以编码。此项诊断应当与结论数据元“Conclusion”之中的文字叙述保持一致。</items><items id="description">代表实验室测试结果的临床含义和意义/重要性的单词、短语或简短描述。</items><items id="text">检验项目诊断</items></items><items code="at0100"><items id="comment">本数据元之中可以包含指向相应检验项目申请之中所提供的原始临床信息的链接。</items><items id="description">关于解释结果时可用的临床信息的描述。</items><items id="fhir_mapping">*DiagnosticReport.requestDetail.clinicalNotes(en)</items><items id="text">已提供的临床信息</items></items><items code="at0101"><items id="description">关于其他字段之中并未采集/记录的，关于当前检验结果的其他文字叙述型内容。</items><items id="text">注释</items></items><items code="at0106"><items id="comment">当所申请的检验项目与实验室实际执行的检验项目不同时，应当会用到本数据元。</items><items id="description">所申请的原始实验室检验项目的名称。</items><items id="text">原始申请检验项目名称</items></items><items code="at0107"><items id="description">表示当前检验项目的存在情况已在实验室信息系统之中进行了登记，但目前尚无任何可用的信息。</items><items id="text">已登记</items></items><items code="at0110"><items id="comment">例如：关于ELISA/散射比浊法的详情。</items><items id="description">关于所采用的分析方法、仪器设备或解释的结构化详情。</items><items id="text">检验详情</items></items><items code="at0111"><items id="comment">如果当前的检验项目是在是床旁（Point-of-Care，POCT）直接进行的，则取值为真（True）。</items><items id="description">此项数据元旨在表明当前的检验项目究竟是床旁（Point-of-Care，POCT）直接进行的检验项目，而不是实验室或其他服务机构/部门/科室所提供的正式结果。</items><items id="text">床旁检验项目</items></items><items code="at0112"><items id="description">@ internal @</items><items id="text">Tree</items></items><items code="at0113"><items id="comment">应当将混杂因素数据元“”保留用于那些可能影响结果解释的，患者状态/生理[机能]的未加控制/意外的问题，如 '近期的锻炼' 或 '近期的吸烟'。&#13;
&#13;
对于已知或所需的前提条件，如“禁食”，应当采用群簇型标本原始型（CLUSTER.specimen）之中的采样条件数据元'Sampling conditions' 来加以记录。在某些情况下，可能会将前提条件作为检验项目名称的一部分来加以记录，如 '空腹血糖'。&#13;
&#13;
对于标本采集或处理方面的已知问题，如“止血带使用时间过长”或“标本溶血”，应当采用群簇型标本原始型（CLUSTER.specimen）之中的标本质量数据元'Sampling conditions'元素来加以记录。&#13;
&#13;
最好尽可能采用特定的术语标准来加以编码。</items><items id="description">影响当前监测/测量结果或检验结果准确解释的问题或情况。</items><items id="text">混杂因素</items></items><items code="at0114"><items id="comment">例如：最后一次正常的月经周期 (Last Normal Menstrual Period，LNMP)。</items><items id="description">关于那些影响检测/测量结果或检验结果准确解释的问题或情况的详情。</items><items id="text">结构化混杂因素</items></items><items code="at0115"><items id="description">结果在达到最终状态之后已被修改，是完整的结果，经过了负责的病理学工作人员的核对。这是“经过修正”类别的一个子类别。</items><items id="text">经过更正</items></items><items code="at0116"><items id="description">当前检验结果在此前最终发布之后已被撤销。</items><items id="text">错误录入</items></items><items code="at0117"><items id="comment">例如：旨在实现与FHIR或CIMI等效项进行协调统一的，本地信息需求或额外的元数据。</items><items id="description">采集本地内容或者实现与其他参考模型/形式化体系之间进行协调统一所额外需的其他信息。</items><items id="text">扩展</items></items><items code="at0118"><items id="comment">允许采用多种的格式，但它们应当都表现的是等价的临床内容。</items><items id="description">表现当前检验结果的数字图像、视频或图表。</items><items id="fhir_mapping">*DiagnosticReport.presentedForm(en)</items><items id="text">多媒体表现</items></items><items code="at0119"><items id="description">在达到最终状态之后，因为添加新的内容而造成报告的修改。已有的内容并未发生变更。这是“经过修正”类别的一个子类别。</items><items id="text">经过追加</items></items><items code="at0120"><items id="description">已有经过核对的早期/初步结果可用，但并非所有的结果都属于是最终结果。这是“部分”类别的一个子类别。</items><items id="text">初步</items></items><items code="at0121"><items id="comment">最好尽可能采用特定的术语标准来加以编码。</items><items id="description">关于进行当前检验项目时所采用的方法的描述。</items><items id="text">检验方法</items></items><items code="at0122"><items id="comment">例如：由多个不同的轴（如形态学、病因学和功能）所组成的解剖病理学诊断。</items><items id="description">当前实验室检验项目的结构化诊断或复杂诊断。</items><items id="text">结构化检验项目诊断</items></items></term_definitions></component_ontologies></template>